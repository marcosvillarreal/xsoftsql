# ===================================================================
# EMAILSENDER DLL - CONFIGURACIÓN OAUTH2 FINAL
# ===================================================================
EMAIL_USER=marcosevillarreal@gmail.com
# Gmail OAuth2 (https://console.cloud.google.com/)
# 1. Crear proyecto > Habilitar Gmail API > Credenciales OAuth2
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui

# Outlook OAuth2 (https://portal.azure.com/)
# 1. Registrar app > Permisos Mail.Send > Crear secret
MICROSOFT_CLIENT_ID=tu_client_id_aqui
MICROSOFT_CLIENT_SECRET=tu_client_secret_aqui
MICROSOFT_TENANT_ID=common

# Configuración del servidor
DLL_PORT=8081
DLL_HOST=localhost
AUTH_METHOD=oauth2
PREFER_OAUTH=True
DEFAULT_SENDER_NAME=Mi Empresa
MAX_ATTACHMENT_SIZE=25
LOG_ENABLED=True

# ===================================================================
# CONFIGURADO AUTOMÁTICAMENTE - NO CAMBIAR
AUTO_START=True
AUTO_CONFIG=True
# ===================================================================
