		*!*	Csrprodfzavta, en entorno de datos si se genera el cursor poner THIS.BufferModeOverride = 3 en el init
		
	ENDPROC

	PROCEDURE Agregaobjeto.letractacte
		PARAMETERS lidbusco
		
		LOCAL lcaliasActual
		lcaliasActual = ALIAS()
		
		WITH thisform
			.lcLetra     = this.lcletradefault
			.lcprioridad = 'ABCXHVUI078'  && factura, n.dto., n.cre., remito salida, remito entrada, receta, ticket, n.pedido, presupuesto
			IF thisform.tipoform='D'
				thisform.lcprioridad = 'CH'  && factura, n.dto., n.cre., receta, ticket, n.pedido
			ENDIF
		
			SELECT CsrCategoiva
			LOCATE FOR id=lidbusco
		
			* D= recibo H= remito I= nota pedido V= Receta 0= presupuesto
			DO CASE 
			   CASE CsrCategoiva.fiscal $ 'I'  && codigo segun cont. fiscales   RI, RLEY
			        .lcLetra = IIF(Csrcomprobante.clase$'FGDHIVW0X78',"X","A")		
			   CASE CsrCategoiva.fiscal $ 'M'   && monotributo
			        .lcLetra	= IIF(Csrcomprobante.clase$'FGDHIVW0X78',"X",.lcLetra)
			   CASE CsrCategoiva.fiscal $ 'N'   && rni
			        .lcLetra	= IIF(Csrcomprobante.clase$'FGDHIVW0X78',"X",.lcLetra)        
			   CASE CsrCategoiva.fiscal $ 'T'   && no categoriazdo
			        .lcLetra	= IIF(Csrcomprobante.clase$'FGDHIVW0X78',"X",.lcLetra)                
			   CASE CsrCategoiva.fiscal $ 'E'    && exento
			        .lcLetra	= IIF(Csrcomprobante.clase$'FGDHIVW0X78',"X",.lcLetra)
			   OTHERWISE 
			        .lcLetra     = IIF(Csrcomprobante.clase$'FGDHIVW0X78',"X",.lcLetra)
			   	    .lcprioridad = 'IABCVU0'  && n.pedido, factura, n.dto., n.cre., receta, ticket, presupuesto
			ENDCASE 
		
			* remito letra "R"
			.lcLetra = IIF(Csrcomprobante.clase$'18' and .lcletra="X","R",.lcletra)
		
			IF Csrcomprobante.clase$'I'
				.lcprioridad = 'IABCVU'  && n.pedido, factura, n.dto., n.cre., receta, ticket
			ENDIF 
		
			IF GOapp.empresatipoiva # 1    && codigo iva de la empresa # inscripto
			   .lcLetra     = "C"
			   .lcprioridad = 'ABCXHVUI'  && factura, n.dto., n.cre., rem.salida, rem.entrada, receta, ticket, n.pedido
			ENDIF 
			   
			IF .lcLetra$"A" AND This.cambioaam
				.lcLetra="M"
			ENDIF 
			IF .lcLetra$"B" AND This.cambiobam
				.lcLetra="M"
			ENDIF 
			* presupuesto/orden de venta/remito entrega "X"
			*.lcLetra = IIF(Csrcomprobante.clase$'045',"X",.lcletra)	
			
			*remito de 3ro
			IF CsrComprobante.clase$'1XH8'
				.lcletra = "R"
			ENDIF 	
		ENDWITH
		
		IF LEN(TRIM(lcaliasActual))#0
			SELECT(lcaliasActual)
		ENDIF 
		
		RETURN 
	ENDPROC

	PROCEDURE CmdBorrar.Click
		WITH thisform
			.accion = "B"
			
			IF ltRIM(CsrAuxMaopera.estado)='1'
				=Oavisar.usuario("No se anulara el comprobante"+CHR(13)+"Esta ANULADO anteriormente ",0)
				RETURN .f.
			ENDIF 
			IF LEFT(csrauxmaopera.switch,1)='1'
				=Oavisar.usuario("No se anulara el comprobante"+CHR(13)+"Esta FACTURADO ",0)
				RETURN .f.
			ENDIF
			lok = .t.
			IF .tipoform$"FPD"
				IF csrauxcabefac.rendida=1 AND csrauxcabefac.rendicaja = 0
					=Oavisar.usuario("No se anulara el comprobante"+CHR(13)+"Esta RENDIDO",0)
					RETURN .f.
				ENDIF
				IF LENTRIM(NVL(csrauxcabefac.CAE,""))<>0
					=Oavisar.usuario("No se anulara el comprobante"+CHR(13)+"Esta GENERADO CON CAE/CAEA",0)
					RETURN .f.
				ENDIF
				IF Csrauxcabefac.hojatotal#1
					=Oavisar.usuario("Esta factura esta dividida en "+ALLTRIM(STR(Csrauxcabefac.hojatotal))+" hojas asegurese de anluar todas",0)
				ENDIF 
				
				IF lentrim(CsrAuxMaopera.numcomp)<>0 AND CsrAuxMaopera.clasecomp$'ABC' &&Si tiene numero, hay que verificar el mes de trabajo
					TEXT TO lcCmd TEXTMERGE NOSHOW 
					SELECT CsrParaVario.* FROM ParaVario as CsrParaVario
					ENDTEXT 
					IF NOT CrearCursorAdapter('CsrParaVario',lccmd)
						thisform.Release
					ENDIF 
					SELECT CsrParaVario
					LOCATE FOR nombre='PFISCALPRE'
					ldpefiscal = CsrParaVario.fecha
					ldpeconfig = CTOD("01-"+RIGHT(CsrParaConfig.pefiscal,2)+"-"+LEFT(CsrParaConfig.pefiscal,4))
		
		*!*				IF (GOMONTH(ldpeconfig,-1)<ldpefiscal) OR (GOMONTH(ldpefiscal,2)<ldpeconfig)
		*!*					=Oavisar.usuario("No se anulara el comprobante"+CHR(13)+" el ultimo periodo "+LEFT(DTOs(ldpefiscal),6)+" presentado difiere en mas de un mes con el actual "+LEFT(DTOS(LDPECONFIG),6),0)
		*!*					RETURN .f.
		*!*				ENDIF 
					ldfecha = CTOD("01"+SUBSTR(DTOC(CsrAuxCabefac.fecha),3) )
		
		*!*				IF (GOMONTH(ldfecha,-1)<ldpefiscal) OR (GOMONTH(ldpefiscal,2)<ldfecha)
		*!*					=Oavisar.usuario("ERROR"+CHR(13)+"ANULACIÓN CANCELADA"+CHR(13)+" el periodo facturado es menor o igual al ultimo periodo presentado ";
		*!*					+CHR(13)+'o el periodo facturado difiere de mas de dos meses con el presentado',0)
		*!*					RETURN .f.
		*!*				ENDIF 
		
					IF ldfecha<>ldpeconfig
						=Oavisar.usuario("ERROR"+CHR(13)+"ANULACIÓN CANCELADA"+CHR(13)+"El periodo facturado difiere con el mes actual ";
						+CHR(13)+'Debe realizar una nota de credito.'+CHR(13)+'Previene inconsistencia en la contabilidad',0)
						RETURN .f.
					ENDIF 
				ENDIF 
				
			
				loObjeto = CREATEOBJECT("Custom")
				loObjeto.AddProperty('origen',"MOTANULA")
				loObjeto.AddProperty('lccaption',"MOTIVO ANULACION")
				loObjeto.AddProperty('detalle',SPACE(40))
				loObjeto.AddProperty('quetecla',0)
		   
				DO FORM pidodetalle WITH loObjeto name LobjForm linked
		
				IF lobjform.quetecla#27
				   REPLACE idmotanula WITH lobjform.idretorno IN CsrAuxmaopera
				ENDIF
		   
				loObjeto = null
				RELEASE lobjform
				IF CsrAuxmaopera.idmotanula=0
					=Oavisar.usuario("No se anulara el comprobante"+CHR(13)+"debe especificar motivo anulación",0)
					lok = .f.
				ENDIF 
				 
						
			ENDIF 
			IF lok
				.actualizar()
			ELSE
				.cmdborrar.Visible = .f.    
				.cmdimprimir.visible= .f.
				.limpiarcursor()	 		
				KEYBOARD '{ESC}'
			ENDIF 		
		ENDWITH 	  
	ENDPROC

