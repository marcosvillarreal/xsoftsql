		*!*		DO FORM SendEmail WITH lObjCorreo TO kk
		*!*		
		*!*		lObjCorreo=null
		*!*	ENDIF 
	ENDPROC

	PROCEDURE establecerconexion
		PARAMETERS lcSvrCf
		LOCAL LcLlaveCf,lmcOrigenData ,lmcSourceType ,lmcServidor ,lmcInitCatalo ,lmcUser ,lmcPwd
		lcSvrCf = IIF(PCOUNT()<1,"",lcSvrCf)
		
		lok = .t.
			
		IF LEN(LTRIM(lcSvrCf))=0
			SELECT CsrConexionCentral
			SCATTER NAME OscatterConect
			*Cargamos los valores de conexion
			LcLlaveCf = STRTRAN(OscatterConect.Servername,".","")
			LcLlaveCf = ALLTRIM(LEFT(STRTRAN(LcLlaveCf ,"\",""),8))
			
			lmcOrigenData  = TRIM(OscatterConect.origendata)
			lmcSourceType  = TRIM(OscatterConect.sourcetype)
			lmcServidor    = TRIM(OscatterConect.servername)
			lmcInitCatalo  = TRIM(OscatterConect.initCatalogo)
			lmcUser        = Desencripta(SUBSTR(OscatterConect.username,1,OScatterConect.userlen),lcLLaveCF)
			lmcPwd         = Desencripta(SUBSTR(OscatterConect.pwdname,1,OscatterConect.pwdlen),lcLLaveCF)
				
			IF LEN(TRIM(lmcServidor))#0 AND LEN(TRIM(lmcUser))#0 AND LEN(TRIM(lmcPwd))#0
				lcSvrCf = "Provider=SQLOLEDB.1;Persist Security Info=False"
			   	lcSvrCf = lcSvrCf + ";Initial Catalog="+lmcInitCatalo
			   	lcSvrCf = lcSvrCf + ";Data Source=" + lmcServidor
			   	lcSvrCf = lcSvrCf + ";User ID="+lmcUser
			   	lcSvrCf = lcSvrCf + ";pwd="+lmcPwd + ";"
			ENDIF 
		ELSE 
			LmcSourceType='ADO'
			LmcSourceType='ODBC'
		ENDIF 
		*establecemos conexion
		nRepety = 5
		lComplete = .f.
		cCadena = ""
		DO WHILE nRepety > 0 AND NOT lComplete
			TRY 
				DO case
				CASE LmcSourceType='ADO' OR LmcSourceType='ODBC'
					loConnDataSource = createobject('ADODB.Connection')
					loConnDataSource.ConnectionString = LcSvrCf
					loConnDataSource.CommandTimeout = 60
					loConnDataSource.ConnectionTimeout = 30
			    		
				    	*=Oavisar.WAITWINDOW('Prueba; conectando al servidor, tiempo de espera 30"',0)
					=Oavisar.proceso('S','Prueba; conectando al servidor, tiempo de espera 30"',0)
				    loConnDataSource.Open()
			  		lComplete = .t.
				OTHERWISE 
					 cCadena ='FALTAN DEFINIR PARAMETROS'
					lok = .F.
					lComplete = .t.
				ENDCASE
			CATCH  To loCatchErr
				*thisform.odata1.cadenaerror='FALLO PRUEBA DE CONEXION'
			    cCadena = 'Error al conectarse a PreventaMobile'+CHR(13)+loCatchErr.Details+CHR(13);
			    					+loCatchErr.Message+STR(loCatchErr.ErrorNo)
			    lok = .F.
			    nRepety = nRepety - 1 
			ENDTRY 
		ENDDO 
		
		IF NOT lok
			oavisar.usuario(cCadena)
		ENDIF 
		
		cConnStringActual = LcSvrCf
		
		RETURN lok
	ENDPROC

	PROCEDURE establecerservidor
		LPARAMETERS nCentral
		
		nCentral = IIF(PCOUNT()<1,0,nCentral)
		*==============================================
		*nCentral ( 0 ) Conectar a la central ( 1 ) Retomar conexion
		*=============================================
		LOCAL oObjConexion,lok
		lok = .t.
		TRY 
			IF nCentral = 0
				oConnOrigen	= loConnDataSource
				cConnString	= lcConectionString
				
				SELECT CsrConexionCentral
				GO TOP 
				lok = this.agregaobjeto.objconexion(@oObjConexion,1)
			
				lok = IIF(lok,this.EstablecerConexion(),lok)
			ENDIF  
			IF nCentral = 1 AND LEN(LTRIM(cConnString))#0
				loConnDataSource	= oConnOrigen
				lcConectionString	= cConnString
				lok = this.EstablecerConexion(cConnString)
			ENDIF 
		CATCH TO oerror
			cError =  loCatchErr.Details+CHR(13)+loCatchErr.Message+STR(loCatchErr.ErrorNo)
			=Grabar_Sec(cError,"ErrorConexion.txt","Aplicaciones\TempError\Pedido")
			loConnDataSource	= oConnOrigen
			lcConectionString	= cConnString
			lok = this.EstablecerConexion(cConnString)
			lok = .f.
		ENDTRY 
		oavisar.proceso('N')
		RETURN lok
		
	ENDPROC

	PROCEDURE existencpromocion		&& Controlamos la existencia de la promocion o el regalo
		&& SE CANCELO SU DESARROLLO.
		&& PROBLEMAS CON DISTRIBUCIONES DE NOTAS DE PEDIDO
		
		*!*	&&Controlamos si la promocion o el regalo cumple con existencia.
		*!*	&&Si la existencia es por el art a regalar, buscamos el art tb en el cuerpo
		*!*	&&Si es el de la promocion es solo la cantidad en el cuerpo
		PARAMETERS cTipo
		*!*	cTipo = IIF(PCOUNT()<1,"",cTipo)
		*!*	&&Si cTipo = B, la invocacion controla .loObjBonifica
		*!*	&&Otro caso ya se controla el cuerfac
		
		*!*	IF NOT .lpidoexistenc
		*!*		RETURN 
		*!*	ENDIF 
		
		*!*	LOCAL nCantCuer,nRecno,lok,OscPromo,nIDArticulo,nCantidad,lcMensaje
		*!*	lcMensaje = ""
		*!*	lok = .t.
		*!*	SELECT CsrAuxCuerfac
		*!*	SCATTER NAME OscPromo
		*!*	nRecno = RECNO()
		
		*!*	nIdArticulo = IIF(cTipo$'B',This.loObjBonifica.idproducto,OscPromo.idarticulo)
		
		*!*	SELECT CsrProdFzaVta
		*!*	LOCATE FOR id = nIdArticulo
		*!*	IF id != nIdArticulo
		*!*		oavisar.usuario('Error al tratar de calcular existencia de la promocion',0)
		*!*		lok = .f.
		*!*	ENDIF 
		*!*	
		*!*	IF lok
		*!*		nCantidad = IIF(cTipo$"B",This.loObjBonifica.entrega,OscPromo.cantidad)
		*!*		nIdArtExistenc = IIF(NVL(CsrProdFzaVta.stockregalo,0)=0,CsrProdFzaVta.idprodpromo,CsrProdFzaVta.idprodregalo)
		*!*		* existencia
		*!*		TEXT TO lcCmd TEXTMERGE NOSHOW 
		*!*		SELECT CsrExistencPromo.* from existenc as CsrExistencPromo
		*!*		where idarticulo = <<nIdArtExistenc>> and iddeposito=<<thisform.lniddeposito>>
		*!*		ENDTEXT 
		*!*		CrearCursorAdapter('CsrExistencPromo',lcCmd)
		*!*		lok = .f.
		*!*		DO CASE
		*!*		CASE RECCOUNT('CsrExistencPromo')=0
		*!*			lcmensaje ="La promocion/regalo no posee existencias"
		*!*		CASE CsrExistencPromo.existe = 0
		*!*			lcmensaje ="La promocion/regalo no posee existencias"
		*!*		CASE NVL(CsrProdFzaVta.stockregalo,0) = 0 AND CsrExistencPromo.existe < nCantidad
		*!*			&&Existencia de promocion
		*!*			lcmensaje =  "La cantidad calculada de "+STRtrim(nCantidad)+" unidades"+CHR(13)+CHR(13);
		*!*						+"Supera la existencia de "+STRtrim(CsrExistencPromo.existe)+" unidades"
		*!*		CASE NVL(CsrProdFzaVta.stockregalo,0) = 1
		*!*			&&Existencia de regalo
		*!*			lok = .t.
		*!*			SELECT CsrAuxCuerfac
		*!*			SUM cantidad FOR idarticulo = CsrProdFzaVta.idprodregalo TO nCantidad
		*!*			IF CsrExistencPromo.existe < nCantidad
		*!*				lcmensaje =  "La cantidad calculada de "+STRtrim(nCantidad)+" unidades"+CHR(13)+CHR(13);
		*!*						+"Supera la existencia de "+STRtrim(CsrExistencPromo.existe)+" unidades"
		*!*				lok = .f.
		*!*			ENDIF 
		*!*		OTHERWISE 
		*!*			lok = .t.
		*!*		ENDCASE
		
		*!*	ENDIF 
		*!*	SELECT CsrAuxCuerfac
		*!*	GO nRecno
		*!*	IF NOT lok
		*!*		oavisar.usuario(lcmensaje,0)
		*!*		WITH this
		*!*			DELETE FOR idarticulo = This.loObjBonifica.idprodpromo IN CsrAuxCuerVari	
		*!*			DELETE for idarticulo = This.loObjBonifica.idprodpromo IN CsrAuxCuerfac
		*!*			
		*!*			.loObjBonifica.idprodpromo	= 0
		*!*			.loObjBonifica.idprodregalo	= 0
		*!*			.loObjBonifica.cada			= 0
		*!*			.loObjBonifica.entrega		= 0
		*!*			
		*!*		ENDWITH 
		*!*		SKIP IN csrauxcuerfac
		*!*		IF EOF()
		*!*		   thisform.agregarcuerfac()	     	 	
		*!*		ENDIF
		
		*!*	ENDIF 
	ENDPROC

	PROCEDURE finan_totalcomproba
	ENDPROC

	PROCEDURE generarcbioplan
		&&Cargamos las variables y controles para generar el cambio de plan.
		
		cCadena = 'para cambiar hacia CTA.CTE o CONTADO P.'
		&&EL plan debe ser CCT o CP
		SELECT CsrPlanPago
		LOCATE FOR id = CsrAuxCabefac.idplanpago
		IF ! ALLTRIM(CsrPlanPago.numero) $ 'CCT-CP'
			=oavisar.usuario('El PLAN de PAGO no esta definido'+CHR(13)+cCadena)
			RETURN .t.
		ENDIF
		&&EL comprobante no puede estar rendido
		IF CsrAuxCabefac.rendida=1
			=oavisar.usuario('El comprobante se encuentra RENDIDO, no esta permitido'+CHR(13)+cCadena)
			RETURN .t.
		ENDIF 
		
		&&Buscamos la cta contable del ctacte
		this.cambiarcuenta()
		
		SELECT CsrParaConta
		LOCATE FOR numero = 2
		SELECT Csrplancue
		LOCATE FOR id=CsrParaConta.idcuenta
		nIdCtaCon = CsrPlanCue.id
		
		IF this.lcidcuentad = 0
			SELECT CsrPlanPago
			LOCATE FOR ALLTRIM(numero) $ 'CP' 
			IF ALLTRIM(numero) != 'CP' 
				=oavisar.usuario('No esta definido el plan CONTADO PENDIENTE'+CHR(13)+cCadena)
				RETURN .t.
			ELSE
				SELECT CsrValor
				LOCATE FOR id = CsrPlanPago.id
				SELECT Csrplancue
				LOCATE FOR id=CsrValor.idctaf
				&&Sino existe la cuenta del valor y la parametrizada	
				IF CsrPlanCue.id != CsrValor.idctaf AND nIdCtaCon=0
					=oavisar.usuario('No esta definido el plan CONTADO PENDIENTE'+CHR(13)+cCadena)
					RETURN .t.
				ENDIF 
			ENDIF 
		
			SELECT CsrPlanPago
			LOCATE FOR ALLTRIM(numero) = 'CCT' 
			IF ALLTRIM(numero) != 'CCT' 
				=oavisar.usuario('No esta definido el plan CTA. CTE.'+CHR(13)+cCadena)
				RETURN .t.
			ELSE
				SELECT CsrValor
				LOCATE FOR id = CsrPlanPago.id
				SELECT Csrplancue
				LOCATE FOR id=CsrValor.idctaf
				&&Sino existe la cuenta del valor y la parametrizada	
				IF CsrPlanCue.id != CsrValor.idctaf AND nIdCtaCon=0
					=oavisar.usuario('No esta definido el plan CONTADO PENDIENTE'+CHR(13)+cCadena)
					RETURN .t.
				ENDIF 
			ENDIF 
		ENDIF 
		
		 &&Comprobante afectado
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrAfeCtacte.* FROM AfeCtacte as CsrAfeCtacte WHERE CsrAfeCtacte.idmaoperad = <<CsrAuxMaopera.id>>
		ENDTEXT 
		IF !thisform.obtenerdatos("CsrAfeCtacte",lcCmd)
			thisform.Release
		ENDIF 
		IF RECCOUNT('CsrAfeCtacte')#0
			=oavisar.usuario('El comprobante esta afectado a otro,no esta permitido para hacer cambio de plan de pago'	)
			RETURN .t.
		ENDIF 
		
		 &&Otros movimientos
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrCuerpo.idmaopera FROM MovCaja as CsrCuerpo WHERE CsrCuerpo.idmaopera = <<CsrAuxMaopera.id>>
		union all 
		SELECT CsrCuerpo.idmaopera FROM MovBcocar as CsrCuerpo WHERE CsrCuerpo.idmaopera = <<CsrAuxMaopera.id>>
		union all 
		SELECT CsrCuerpo.idmaopera FROM MovTarjeta as CsrCuerpo WHERE CsrCuerpo.idmaopera = <<CsrAuxMaopera.id>>
		ENDTEXT 
		IF !CrearCursorAdapter("CsrMovimien",lcCmd)
			thisform.Release
		ENDIF 
		IF RECCOUNT('CsrMovimien')#0
			=oavisar.usuario('El comprobante esta afectado a otros valores,no esta permitido para hacer cambio de plan de pago'	)
			RETURN .t.
		ENDIF 
		
		 &&Contabilidad
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrCabeAsi.* FROM CabeAsi as CsrCabeAsi WHERE CsrCabeAsi.idmaopera = <<CsrAuxMaopera.id>>
		ENDTEXT 
		IF !thisform.obtenerdatos("CsrCabeAsi",lcCmd)
			thisform.Release
		ENDIF 
		IF RECCOUNT('CsrCabeAsi')#0
			SELECT CsrCabeAsi
			IF idejercicio != goapp.idejercicio
				=oavisar.usuario('El comprobante no pertenece al ejercicio contable,no esta permitido para hacer cambio de plan de pago'	)
				RETURN .t.
			ENDIF 
		ENDIF 
		
		thisform.accion='M'
		thisform.actualizar()
	ENDPROC

	PROCEDURE generarconsigna
		
		&&EL plan debe ser CCT o CP
		SELECT CsrPlanPago
		LOCATE FOR id = CsrAuxCabefac.idplanpago
		IF ! ALLTRIM(CsrPlanPago.numero) $ 'CCT'
			oavisar.usuario("Solo esta permitido CONSIGNAR comprobantes de CUENTA CORRIENTE.")
			RETURN 
		ENDIF 
		
		thisform.accion='C'
		thisform.actualizar()
	ENDPROC

	PROCEDURE generargs1
		DO FORM exportar_gs1 WITH CsrAuxMaopera.id
	ENDPROC

	PROCEDURE generarhojascf
		LPARAMETERS nTope
		nTope = IIF(PCOUNT()<0,0,nTope)
		LOCAL nTopeAux
		nTopeAux = Thisform.topecf
		cDNI = STRTRAN(CsrAuxCabefac.dni,".","")
		IF nTope = 0
			IF ALLTRIM(CsrCategoiva.abrevia)$'CF' AND CsrComprobante.clase$"ABC" AND lentrim(cDNI)=0 
				
				IF CsrAuxCabefac.total > thisform.topecf 
					
					SELECT CsrAuxCuerfac
					lbimpriok = this.Objimpresor.generafacturacf("F",.canlinea)
					IF NOT lbimpriok
						RETURN lbimpriok
					ENDIF 
		
					this.Objimpresor.generootroproceso = .t.
					
					SELECT CsrAuxCuerfac
					this.totalporhoja()
				ENDIF 	
			ENDIF 
		ELSE
			IF nTope#0		
				 thisform.topecf = nTope
					
				SELECT CsrAuxCuerfac
				lbimpriok = this.Objimpresor.generafacturacf("F",.canlinea)
				IF NOT lbimpriok
					RETURN lbimpriok
				ENDIF 
		
				this.Objimpresor.generootroproceso = .t.
				
				SELECT CsrAuxCuerfac
				this.totalporhoja()
				
				SELECT CsrAuxCabefac
				vista()
			
			ENDIF 
		ENDIF 
		
		Thisform.topecf = nTopeAux
		RETURN 
	ENDPROC

	PROCEDURE generarlinea		&& Genera el registro para inserccion / modificacion producto, sobre cursor Csrauxcuercbio
		LOCAL Oscatter,lcCtrlSource,lcalias,AcolOdataNavega,lcnombre,lnkeyCode,lclista
		STORE '' TO lcCtrlSource,AcolOdataNavega
		lcAlias = "CsrAuxCuerfac"
		
		
		WITH thisform
			lnLista = .containerencabeza._cbolistapre.Value
			IF lnLista > 4
				lnLista = 1 
			ENDIF 
			lclista = "prevtaf"+LTRIM(STR(lnLista ))
			
			.kitbuscarProd.controlsource01 = lclista
			
			_screen.LockScreen = .t.
		    .bindergridoff('thisform.grid2',@lcalias,@lcCtrlSource,@AcolOdataNavega)
		
			SELECT CsrAuxCuerfac
		    lcnombre = nombre
		    lnkeyCode = 13
		    SKIP 
		*!*	    IF !(EOF() .and. BOF())
		*!*	       SKIP 
		*!*	    ELSE
		*!*		    lnKeycode = 22
		*!*	    endif   
		    IF (EOF() AND BOF()) OR (EOF() AND LEN(TRIM(lcnombre))#0)
		   	   lnKeycode = 22
		    ENDIF 
			    
			IF lnKeyCode=22			&&insert
				thisform.agregarcuerfac()
			ENDIF 
			SELECT CsrAuxCuerfac
			lnrecno = RECNO('CsrAuxCuerfac') 			
			GO TOP IN CsrAuxCuerfac
		    .grid2.coLUMN3.combo1.RowSource = "UNIDAD,1,BULTO,2"
		   *thisform.grid2.column3.combo1.Enabled=.f.
		    .bindergridon('thisform.grid2',lcalias,lcCtrlSource,AcolOdataNavega)
			GO lnrecno IN CsrAuxCuerfac
			_screen.LockScreen = .f.
			
			.lhayvariedad = .f.		    
			.lcsetfocus = ""
			.lcgotfocus = ""
			.bloqueocodigo=.f.
			.grid2.column1.text1.SetFocus 
		ENDWITH 
		
	ENDPROC

	PROCEDURE grabarborrado		&& Borrar datos
		LOCAL lcidmaopera,ldfechaserver,lok,ldfechafac
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		loObjNeg       = thisform.GetRefObjneg('thisform.Odatamaopera')
		loObjTabasto   = thisform.GetRefObjneg('thisform.OdataTabasto')
		loObjTabimpu   = thisform.GetRefObjneg('thisform.OdataTabimpu')
		loObjMovCtacte = thisform.Getrefobjneg('thisform.OdataMovCtacte')
		loObjMovBcoCar = thisform.getrefobjneg('thisform.OdataMovbcoCar')
		loObjMovCaja   = thisform.getrefobjneg('thisform.odatamovcaja')
		loObjCabefac   = thisform.getrefobjneg('thisform.odatacabefac')
		loObjMovstock  = thisform.getrefobjneg('thisform.odatamovstock')
		loObjExistenc  = thisform.getrefobjneg('thisform.odataexistenc')
		loObjAfeCtacte = thisform.getrefobjneg('thisform.OdataAfectacte')
		loObjanmaopera = thisform.getrefobjneg('thisform.Odataanmaopera')
		loObjAfebcocar = thisform.getrefobjneg('thisform.OdataAfebcocar')
		loObjCabeAsi    = thisform.GetRefObjneg('thisform.OdataCabeasi')
		loObjMovBcoDEta    = thisform.GetRefObjneg('thisform.OdataMovBcoDEta')
		loObjCabeDeta = thisform.GetRefObjneg('thisform.OdataCabedeta')
		loObjAfeCabefac = thisform.GetRefObjneg('thisform.OdataAfeCabefac')
		loObjRenMaope = thisform.GetRefObjneg('thisform.OdataRenMaope')
		
		lcidmaopera  = CsrAuxMaopera.id
		
		lObjParametro = thisform.objgrabadato
		lObjParametro.lcaliasComp  = "CsrCompAux"
		lObjParametro.clasecomp    = Csrcomprobante.clase
		lObjParametro.clasetipo    = Csrcomprobante.clasetipo
		lObjparametro.compabrevia  = Csrcomprobante.cabrevia
		lObjParametro.lcintablaori = "CAFA"
		 
		WITH thisform
			SELECT CsrAuxMaopera
			SCATTER NAME Oscmaopera
			
		* operacion actual marco como anulado
			REPLACE estado WITH "1" IN Csrmaopera	
			
			OscMaopera.programa	   = UPPER(thisform.name)
		    OscMaopera.pefiscal    = Csrparaconfig.pefiscal	
			OscMaopera.idcomproba  = VAL(.idcompanulacion)
			OscMaopera.clasecomp   = 'K'
			OscMaopera.clasetipo = '00'
			OscMaopera.fechasis    = ldfechasis
			OscMaopera.fechaserver = ldfechaserver
			
			loObjNeg.agregar
			SELECT CsrMaopera
			GATHER NAME OscMaopera FIELDS EXCEPT id
		
			SCATTER NAME Oscmaopera ADDITIVE 
		
			loObjanmaopera.agregar
			REPLACE idmaopera WITH OscMaopera.id,idafecta WITH lcidmaopera,detalle WITH OscMaopera.numcomp,idmotanula WITH OscMaopera.idmotanula IN Csranmaopera
		
			SELECT CsrAuxCabefac
			SCATTER NAME OscCabefac
		
			lObjParametro.idctacte  = OscCabefac.idctacte
			lObjParametro.ctacte    = OscCabefac.ctacte
			lObjParametro.subnumero = OscCabefac.subnumero
			lObjParametro.idsubcta  = OscCabefac.idsubcta
			lObjparametro.cnombre   = OscCabefac.cnombre
			lObjparametro.idorigen  = OscMaopera.id
			lObjParametro.importe   = OscCabefac.total
			lObjParametro.total     = OscCabefac.total
			lObjParametro.fecha     = ldfechaserver
			lObjParametro.detalle	= 'Anula '+OscMaopera.detalle
			
			
			IF !.actualizafac.controlcajaactiva(OscMaopera)
				.cadenaerrores ='Se CANCELO la grabación' +CHR(13)+'Porque se CERRO LA CAJA.'
				RETURN .f.
			ENDIF 	
			&&Usamos la fecha contable para mantener la fecha de anulacion.
			lObjParametro.fecha     = FechaHoraCero(OscMaopera.fechasis) &&ldfechaserver
			
			.actualizafac.leerctacte()
			.actualizafac.cambioctacte(@lObjParametro)
			.actualizafac.borromovctacte(lcidmaopera,OscMaopera,lObjParametro)
			.actualizafac.borromovbco(lcidmaopera,OscMaopera,lObjParametro,.f.)		
			.actualizafac.borrostock(lcidmaopera,OscMaopera)
			.actualizafac.grabarexistencia()
			**&&''
			.actualizafac.borrarafelicita(lcidmaopera,OscMaopera.origen)
			
			*.actualizafac.grabarcabeasi(OscMaopera,lObjParametro)
			.actualizafac.borroasto(lcidmaopera,OscMaopera,lObjParametro)
			.actualizafac.cambioctacte(@lObjParametro,1)
			
			TEXT TO lcCmdAfe TEXTMERGE NOSHOW 
			SELECT CsrAfeCabefac.* FROM AfeCabefac as CsrAfeCabefac
			where idorigen = <<CsrAuxCabefac.id>> and idmaoperao = <<CsrAuxMaopera.id>>
			ENDTEXT 
			IF thisform.obtenerdatos('CsrAfeCabefac',lcCmdAfe)
				thisform.Release
			ENDIF 
			DELETE FROM CsrAfeCabefac		
		
			
			*Eliminamos la factura de la rendicion.	
			.oFacRendir.iniciarparametros()
			.oFacRendir.oDatos.cidmaopera = strid(lcidmaopera)
		
			llok =.oFacRendir.Grabarborrado()
			IF !llok
				.cadenaerrores = .oFacRendir.cadenaerror
			ENDIF 
			
			cCadena = ""
			IF NOT this.Actualizafac.controlasto(@cCadena)
				.cadenaerrores = cCadena
				llok = .f.
			ENDIF 
			
			IF llok
				IF !loObjNeg.Salvar('CsrMaopera')               
					llok = .f.
				   	.cadenaerrores = loObjNeg.cadenaerror
				ENDIF 
			ENDIF 
		ENDWITH
		
		loObjNeg       = null 	       
		loObjTabasto   = null 
		loObjTabimpu   = null
		loObjMovCtacte = null
		loObjMovBcoCar = null 
		loObjMovCaja   = null
		loObjCabefac   = null
		loObjMovstock  = null
		loObjExistenc  = null
		loObjAfeCtacte = null
		loObjanmaopera = null
		lObjparametro  = null
		loObjAfebcocar = null
		loObjCabeAsi    = null
		loObjMovBcoDEta = null
		loObjCabeDeta = null
		RETURN .t.
		
	ENDPROC

	PROCEDURE grabarborradodiferido		&& Borra datos diferidos
	ENDPROC

	PROCEDURE grabarborradonotapedido		&& Borra notas de pedido
		LOCAL lcidmaopera,lok
		
		loObjNeg     = thisform.GetRefObjneg('thisform.OdataNmaopera')
		loObjMovLicita     = thisform.GetRefObjneg('thisform.OdataMovLicita')
		thisform.OdataMovLicita.cobjnegpadre = "odatanmaopera"
		
		lcidmaopera  = CsrAuxMaopera.id
		 
		WITH thisform
			SELECT CsrAuxMaopera
			SCATTER NAME Oscmaopera
			
		* operacion actual marco como anulado
			REPLACE estado WITH "1",detalle WITH 'ANULA '+DTOC(DATE()) IN CsrNmaopera	
				
			
			this.actualizafac.borrarafelicita(OscMaopera.id, OscMaopera.origen)
		 
			
			llok = loObjNeg.Salvar('CsrNMaopera')
			                    
			IF !llok
			   .cadenaerrores = loObjNeg.cadenaerror
			ENDIF 
		ENDWITH
		
		thisform.OdataMovLicita.cobjnegpadre = "odatamaopera"
		
		loObjNeg       = null 	       
		loObjMovLicita	= null
		
			
		RETURN .t.
		
	ENDPROC

	PROCEDURE grabarcbiodato
		
		LOCAL ldfechaserver,lok,ldfechafac,lnidlotemaopera,lcswitchcabefac,lcError
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		loObjNeg       = thisform.GetRefObjneg('thisform.Odatamaopera')
		loObjTabasto   = thisform.GetRefObjneg('thisform.OdataTabasto')
		loObjTabimpu   = thisform.GetRefObjneg('thisform.OdataTabimpu')
		loObjMovCtacte = thisform.Getrefobjneg('thisform.OdataMovCtacte')
		loObjCtacte    = thisform.getrefobjneg('thisform.OdataCtacte')
		loObjCabefac   = thisform.getrefobjneg('thisform.odatacabefac')
		loObjAfeCtacte = thisform.getrefobjneg('thisform.OdataAfectacte')
		
		lnidlotemaopera = 0
		
		llok = .t.
		
		SELECT CsrAuxCabefac
		cidmaopera		= STRID(CsrAuxCabefac.idmaopera)
		cidcabefac		= STRID(CsrAuxCabefac.id)
		
		this.oActualizaFac.IniciarParametros()
		
		this.oActualizaFac.oDatos.idoperador = goapp.idusuario
		this.oActualizaFac.oDatos.nomopera =  ALLTRIM(goapp.nombreusuario)
		
		SELECT CsrParaConta
		LOCATE FOR numero = 2
		SELECT Csrplancue
		LOCATE FOR id=CsrParaConta.idcuenta
		nidParaConta = CsrPlanCue.id
		this.oActualizaFac.oDatos.nidctaconcp = this.lcidcuentad
		this.oActualizaFac.oDatos.nidctaconcct = this.lcidcuentad
		this.oActualizaFac.oDatos.tablaorifac = "CAFA"
		
		IF this.lcidcuentad=0
			SELECT CsrPlanPago
			LOCATE FOR ALLTRIM(numero) $ 'CP' 
			IF ALLTRIM(numero) = 'CP' 
				SELECT CsrValor
				LOCATE FOR id = CsrPlanPago.idvalor
				SELECT Csrplancue
				LOCATE FOR id=CsrValor.idctaf
				
				nIdCtaconCP = nidParaConta
				IF CsrPlanCue.id = CsrValor.idctaf
					nIdCtaconCP = CsrPlanCue.id
				ENDIF 
			ENDIF 
			SELECT CsrPlanPago
			LOCATE FOR ALLTRIM(numero) = 'CCT' 
			IF ALLTRIM(numero) = 'CCT' 
				SELECT CsrValor
				LOCATE FOR id = CsrPlanPago.idvalor
				SELECT Csrplancue
				LOCATE FOR id=CsrValor.idctaf
				
				nIdCtaconCCT = nidParaConta
				IF CsrPlanCue.id = CsrValor.idctaf
					nIdCtaconCCT = CsrPlanCue.id
				ENDIF 
			ENDIF 
			this.oActualizaFac.oDatos.nidctaconcp = nIdCtaconCP
			this.oActualizaFac.oDatos.nidctaconcct = nIdCtaconCCT
		ENDIF 
		
		**&&''
		
		this.oActualizaFac.lngeneraasto = .t.
		IF CsrAuxMaopera.clasecomp $ '1XH' &&En Generico los remitos de 3ro. En Leon incluye R.Salida
			this.oActualizaFac.lngeneraasto = .f.
		ENDIF 
		
		this.oActualizaFac.oDatos.nidmaopera = CsrAuxCabefac.idmaopera
		this.oActualizaFac.oDatos.nidcabefac = CsrAuxCabefac.id
		this.oActualizaFac.oDatos.fechavto	 = CsrAuxCabefac.vencimien
		
		IF this.oActualizaFac.grabardato()
			IF ! loObjNeg.Salvar('CsrMaopera')
				thisform.cadenaerrores = loObjNeg.cadenaerror
				llok = .f.
			ENDIF 
		ELSE
			thisform.cadenaerrores = this.oActualizaFac.cadenaerror
			llok = .f.
		ENDIF 
		                    
		loObjNeg       = null 	       
		loObjTabasto   = null 
		loObjTabimpu   = null
		loObjMovCtacte = null
		loObjCtacte    = null 
		loObjCabefac   = null
		loObjAfeCtacte = null
		loObjidasociado = null
		lObjparametro  = null
		loObjvendedor = null	
		
		RETURN llok
		
	ENDPROC

	PROCEDURE grabarconsignacion
		
		LOCAL ldfechaserver,lok,ldfechafac,lnidlotemaopera,lcswitchcabefac,lcError
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		llok = .t.
		
		SELECT CsrAuxCabefac
		cidmaopera		= STRID(CsrAuxCabefac.idmaopera)
		cidcabefac		= STRID(CsrAuxCabefac.id)
		
		
		cCmdText = "UPDATE cabefac SET consigna = 1 where idmaopera =" + cidmaopera
				  
		Oca = Ocmd
		Oca.commandtext = cCmdText
		Oca.commandtype = 1
		
		LOCAL loCatchErr As Exception
		ldebociclar = .t.
		DO WHILE ldebociclar 
		   ldebociclar = .f.
			TRY 
			  Oca.execute()
			CATCH TO loCatchErr
			  IF AERROR(laError) > 0
				  =Oavisar.usuario("Error al obtener datos:"+laError[2],0)
			  ENDIF
		 	  ldebociclar = .t.
			ENDTRY   
		ENDDO 
				
		RETURN llok
		
	ENDPROC

	PROCEDURE grabardato		&& Graba datos
		
		LOCAL ldfechaserver,lok,ldfechafac,lnidlotemaopera,lcswitchcabefac,lcError,nIdOperacion 
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		loObjNeg       = thisform.GetRefObjneg('thisform.Odatamaopera')
		loObjTabasto   = thisform.GetRefObjneg('thisform.OdataTabasto')
		loObjTabimpu   = thisform.GetRefObjneg('thisform.OdataTabimpu')
		loObjMovCtacte = thisform.Getrefobjneg('thisform.OdataMovCtacte')
		loObjCtacte    = thisform.getrefobjneg('thisform.OdataCtacte')
		loObjMovBcoCar = thisform.getrefobjneg('thisform.OdataMovbcoCar')
		loObjMovCaja   = thisform.getrefobjneg('thisform.odatamovcaja')
		loObjMovTarjeta = thisform.getrefobjneg('thisform.odataMovtarjeta')
		loObjCabefac   = thisform.getrefobjneg('thisform.odatacabefac')
		loObjCuerfac   = thisform.getrefobjneg('thisform.odatacuerfac')
		loObjMovstock  = thisform.getrefobjneg('thisform.odatamovstock')
		loObjExistenc  = thisform.getrefobjneg('thisform.odataexistenc')
		loObjcuervari  = thisform.getrefobjneg('thisform.Odatacuervari')
		loObjAfeCtacte = thisform.getrefobjneg('thisform.OdataAfectacte')
		loObjidasociado = thisform.getrefobjneg('thisform.Odataidasociado')
		loObjvendedor = thisform.getrefobjneg('thisform.Odatavendedor')
		loObjCabeAsi    = thisform.GetRefObjneg('thisform.OdataCabeasi')
		loObjMovBcoDEta    = thisform.GetRefObjneg('thisform.OdataMovBcoDEta')
		loObjCabeDeta = thisform.GetRefObjneg('thisform.OdataCabedeta')
		loObjAfeCabefac = thisform.GetRefObjneg('thisform.OdataAfeCabefac')
		
		loObjfleteren	= thisform.GetRefObjneg('thisform.Odatafleteren')
		loObjrenmaope	= thisform.GetRefObjneg('thisform.Odatarenmaope')
		
		loObjpedipda	= thisform.GetRefObjneg('thisform.Odatapedipda')
		loObjvisita		= thisform.GetRefObjneg('thisform.Odatavisita')
		
		loObjAfeLicita = thisform.getrefobjneg('ThisForm.OdataAfeLicita')
		
		loObjEMaopera = thisform.getrefobjneg('ThisForm.OdataEMaopera')
		
		
		lObjParametro = thisform.objgrabadato
		lObjParametro.lcaliasComp  = "CsrCompAux"
		lObjParametro.clasecomp    = Csrcomprobante.clase
		lObjParametro.clasetipo    = Csrcomprobante.clasetipo
		lObjparametro.compabrevia  = Csrcomprobante.cabrevia
		lObjParametro.lcintablaori = "CAFA"
		
		lnidlotemaopera = 0
		lnidfletero	= 0
		ldfechafac	= DATETIME()
		
		*!*	oCa = thisform.obtenercursor('CsrMaopera')
		*!*	cCmdMaope = oca.SelectCmd
		*!*	oavisar.usuario(cCmdMaope)
			
		SELECT CsrAuxCabefac
		GO top
		cIdCtacte = ""
		cSep = ""
		llok = .t.
		&&Recuperamos todos los clientes, pq sino al actualizafac.leerctacte, pierdo el saldo anterior
		SCAN 
			IF NOT strtrim(CsrAuxCabefac.idctacte)$cIdCtacte
				cIdCtacte = cIdCtacte + cSep + strtrim(CsrAuxCabefac.idctacte)
				cSep=","
			ENDIF 
		ENDSCAN 
		IF lentrim(cIdCtacte)#0
			thisform.actualizafac.leerctacte()
		ELSE
			llok = .f.
			thisform.cadenaerrores = "No se encontraron clientes a facturar"
		ENDIF
		
		**''
		*stop()
		SELECT CsrAuxCabefac
		GO top
		llok = .t.
		SCAN FOR llok AND !EOF()
			SELECT CsrAuxMaopera
			SCATTER NAME Oscmaopera
			
			nIdOperacion2 = CsrAuxCabefac.idmaopera
			
			IF this.facturacf OR this.facturaPiva
				SELECT CsrAuxCuerfac
				SET FILTER TO idmaopera = nIdOperacion2
				*vista()
				SELECT CsrAuxCuerVari
				SET FILTER TO idmaopera = nIDOperacion2
				
				IF RECCOUNT('CsrAuxCuerfac')=0
					LOOP 
				ENDIF 
				lnidlotemaopera = 0
			ENDIF 
			
			OscMaopera.idcomproba  = thisform.containerencabeza._cbocomprobante.Value
			OscMaopera.clasecomp   = Csrcomprobante.clase
			OscMaopera.clasetipo	= CsrComprobante.clasetipo
			OscMaopera.numcomp 	   = IIF(thisform.tipofactura$"EM",thisform.proximonro,CsrAuxCabefac.proximonro)
			OscMaopera.fechasis    = ldfechasis
			OscMaopera.fechaserver = ldfechaserver
			OscMaopera.ESTADO		= 0
			OscMaopera.origen 		= 'FAC'
			OscMaopera.programa 	= UPPER(this.Name)
			loObjNeg.agregar
			SELECT CsrMaopera
			GATHER NAME OscMaopera FIELDS EXCEPT id
			
			SCATTER NAME Oscmaopera ADDITIVE 
			lnidlotemaopera = IIF(lnidlotemaopera=0,OscMaopera.id,lnidlotemaopera)
			
			SELECT CsrAuxMaopera
			replace fechaserver WITH OscMaopera.fechaserver 
			
			SELECT CsrauxCabefac
			lcswitchcabefac= switch &&LEFT(switch,2)+thisform.esvale+RIGHT(switch,2)
			REPLACE idlotemaopera WITH lnidlotemaopera,switch WITH lcswitchcabefac
			&&Para el CAE
			replace idmaopera WITH lnidlotemaopera,infocae WITH 0
			
			SCATTER NAME OscCabefac
			
			lnidfletero	= OscCabefac.idfletero
			ldfechafac	= OscCabefac.fecha
			
			OscMaopera.fechasis = OscCabefac.fecha
			lObjparametro.cnombre = OscCabefac.cnombre
			lObjparametro.detalle=ALLTRIM(lObjparametro.compabrevia+' '+OscMaopera.numcomp+' - '+lObjparametro.cnombre)
			Oscmaopera.detalle=lObjparametro.detalle
			lObjParametro.statusform = OscMaopera.statusform
			.actualizafac.grabarextramaopera(OscMaopera,lObjParametro)
			*stop()
			IF this.lbGeneroHojaConTotal
				&&Rearmamos los pagos segun cada hoja
				&&Se repite el proceso, porque el csrpago solo
				&&debe tener los registros de la hoja actual.
				thisform.totalhojapagos()
			ENDIF 
			
			WITH thisform
				*stop()
				IF .lbGeneroHojaConTotal
					&&Cada hoja es una factura ahora.
					replace hojaactual WITH 1,hojatotal WITH 1 IN CsrCabefac
					*replace ALL hojaactual WITH 1 IN CsrCuerfac
					
					
				ENDIF 
				.actualizafac.grabarcabefac(OscMaopera)
				SELECT CsrMovStock
				lObjparametro.idorigen = OscCabefac.id
				*.actualizafac.leerctacte()
		*		.actualizafac.leermovctacte(OscCabefac)
				*IF ! .generandoloteremito &&El lote de remitos no graba asto o movctacte.
					
					.actualizafac.generarctacte(OscMaopera,OscCabefac,@lObjparametro)
					.actualizafac.grabarpago(OscMaopera,@lObjparametro)
					.actualizafac.grabarcabeasi(OscMaopera,lObjParametro)
					.actualizafac.grabarastofac(OscMaopera)
					.actualizafac.cambioctacte(@lObjParametro,1)
				*ENDIF 
		
				IF .importandopedidos
					.actualizafac.grabarpedido(OscMaopera)
				ENDIF 
					
			ENDWITH
			
			SELECT CsrCabefac
			SCATTER NAME OscCabefac
			
			&&Si existe un comprobante original
			IF this.generandoloteremito AND USED('FsrAuxOpera')
				*1-El lote es unico, no se acarrea.
				*2-Selete max nrolote para un nuevo
				TEXT TO lcCmdMax TEXTMERGE NOSHOW 
				SELECT 'B' as orden,MAX(nrolote) as nrolote FROM AfeCabefac as CsrAfeCabefac 
				ENDTEXT 
				IF !CrearCursorAdapter('CsrMaxNroLote',lcCmdMax)
					RETURN .f.
				ENDIF 
				lnNroLote = 1
				IF RECCOUNT('CsrMaxNroLote')#0
					*Solo puede ser A o B. Si no existe A, hago por B, para asegurar q halla un valor.
					SELECT CsrMaxNroLote
					LOCATE FOR orden='A'
					IF !orden='A'
						LOCATE FOR orden='B'
					ENDIF 
					lnNroLote = CsrMaxNroLote.nrolote
				ENDIF 
				SELECT FsrAuxOpera
				GO TOP 
				SCAN 
					loObjAfeCabefac.agregar
					replace idorigen WITH OscCabefac.id,idmaoperao WITH OscMaopera.id;
							,idafecta WITH FsrAuxOpera.id,idmaoperaa WITH FsrAuxOpera.idmaopera;
							,nrolote WITH lnNroLote,switch WITH '00000' IN CsrAfeCabefac
				ENDSCAN 
			ENDIF 
			
			&&Mercaderia Comprometida no graba stock
			IF LEFT(RIGHT(OscCabefac.switch,2),1)='1'
				loObjMovStock.debesalvar = .f.
				loObjExistenc.debesalvar = .f.
			ENDIF 
		
		
		ENDSCAN 
		
		thisform.actualizafac.grabarexistencia()
		
		IF this.facturacf  OR this.facturaPiva
			SELECT CsrAuxCuerfac
			SET FILTER TO 
			SELECT CsrAuxCuerVari
			SET FILTER TO
		ENDIF 
			
		SELECT CsrMovStock
		*vista()
		
		&&La facturacion de lote de remitos solo genera asto.
		&&Entonces debemos cancelar la grabacion de todo lo que no sea contabilidad
		&&Necesitamos que se ejecuten los procesos, para saber ah que cuentas debe tocar.
		IF  thisform.generandoloteremito AND NOT thisform.generandorementrega&&El lote de remitos no graba asto o movctacte.
			loObjTabasto.debesalvar = .f.
			loObjMovCtacte.debesalvar = .f.
			loObjCtacte.debesalvar = .f.
			loObjMovBcoCar.debesalvar = .f.
			loObjMovCaja.debesalvar = .f.
			loObjMovTarjeta.debesalvar = .f.
			loObjAfeCtacte.debesalvar = .f.
			loObjidasociado.debesalvar = .f.
			loObjvendedor.debesalvar = .f.
			loObjCabeAsi.debesalvar = .f.
			loObjMovBcoDeta.debesalvar = .f.
			loObjCabeDeta.debesalvar = .f.
			
			replace idasiento WITH 0  IN CsrTablaImp
		ENDIF 
				
		
		*Si la factura NO es cdo pde. o ctacte. la guardamos en una rendicion de caja.
		this.oFacRendir.IniciarParametros()
		this.oFacRendir.oDatos.idfletero = lnidfletero
		this.oFacRendir.oDatos.dfechaserver = ldfechaserver
		this.oFacRendir.oDatos.dfechafac = ldfechafac
		llok = .t.
		IF !this.oFacRendir.grabardato()
			thisform.cadenaerrores = this.oFacRendir.cadenaerror
			llok = .f.
		ENDIF 
		
		SELECT CsrCuerfac
		vista()
		
		IF llok 
			IF ! loObjNeg.Salvar('CsrMaopera')
				thisform.cadenaerrores = loObjNeg.cadenaerror
				llok = .f.
			ENDIF
		ENDIF 
		
		this.facturaPiva = .f.
		
		IF  thisform.generandoloteremito &&El lote de remitos no graba asto o movctacte.
			loObjTabasto.debesalvar = .t.
			loObjMovCtacte.debesalvar = .t.
			loObjCtacte.debesalvar = .t.
			loObjMovBcoCar.debesalvar = .t.
			loObjMovCaja.debesalvar = .t.
			loObjMovTarjeta.debesalvar = .t.
			loObjAfeCtacte.debesalvar = .t.
			loObjidasociado.debesalvar = .t.
			loObjvendedor.debesalvar = .t.
			loObjCabeAsi.debesalvar = .t.
			loObjMovBcoDeta.debesalvar = .t.
			loObjCabeDeta.debesalvar = .t.
		ENDIF 
		
		loObjNeg       = null 	       
		loObjTabasto   = null 
		loObjTabimpu   = null
		loObjMovCtacte = null
		loObjCtacte    = null 
		loObjMovBcoCar = null 
		loObjMovCaja   = null
		loObjMovTarjeta = null
		loObjCabefac   = null
		loObjCuerfac   = null
		loObjMovstock  = null
		loObjExistenc  = null
		loObjcuervari  = null
		loObjAfeCtacte = null
		loObjidasociado = null
		lObjparametro  = null
		loObjvendedor = null	
		loObjCabeAsi    = null   
		loObjMovBcoDEta    = null
		loObjCabeDeta = null
		
		loObjfleteren	= null
		loObjrenmaope	= null
		
		thisform.oDataMovLicita.cobjnegpadre = ""
		RETURN llok
		
	ENDPROC

	PROCEDURE grabardatolic
		
		LOCAL ldfechaserver,lok,ldfechafac
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		loObjNegocio	= thisform.GetRefObjneg('thisform.OdataMaopera')
		loObjMovLicita  = thisform.GetRefObjneg('thisform.OdataMovLicita')
		
		SELECT CsrAuxcabefac
		GO TOP 
		llok = .t.
		
		SCATTER NAME OscCabefac
		
		SELECT CsrMaopera
		SCATTER NAME Oscmaopera
		
		loObjNegocio.agregar
		
		SELECT CsrAuxMaopera
		SCATTER NAME Oscmaopera ADDITIVE 
		
		OscMaopera.idcomproba  = thisform.containerencabeza._cbocomprobante.Value
		Oscmaopera.clasecomp   = Csrcomprobante.clase
		OscMaopera.numcomp     = thisform.proximonro &&OscCabefac.nrocomplic
		OscMaopera.fechasis    = ldfechasis
		OscMaopera.fechaserver = ldfechaserver
		OscMaopera.switch      = "00000"
		OscMaopera.sucursal    = Goapp.sucursal
		OscMaopera.terminal    = Goapp.terminal
		OscMaopera.sector      = thisform.sectorterminal
		OscMaopera.puestocaja  = thisform.puestocaja
		OscMaopera.idoperador  = goapp.idusuario
		OscMaopera.estado      = "0"
		
		SELECT CsrMaopera
		GATHER NAME OscMaopera FIELDS EXCEPT id
		SCATTER NAME OscMaopera
		
		SELECT CsrMovLicita
		SCATTER NAME OscMov 
		SELECT CsrAuxCuerfac
		GO top
		
		**&&''
		SCAN FOR !EOF()
			* no guardo lineas en blanco
			IF idarticulo=0 AND LEN(TRIM(nombre))=0 AND cantidad=0 AND preunita=0
				LOOP 
		   	ENDIF 
		   	SCATTER NAME OscMov ADDITIVE 
		   	
		   	OscMov.idmaopera	= Oscmaopera.id
		   	OscMov.switch		= "00000"
		   	OscMov.idctacte		= OscCabefac.idctacte
		    OscMov.nrolicitacion= OscCabefac.nrocomplic  
		   	* lo guardo en cantidades totales
		   	lnunibulto = IIF(OscMov.unibulto=0,1,OscMov.unibulto)
		   	lnunibulto = IIF(OscMov.univenta=1,1,lnunibulto)
		  	
		   	OscMov.cantidad = OscMov.cantidad * lnunibulto
		   	OScMov.sdocant	= OscMov.cantidad
			OscMov.idvariedad	= 0   
		         
		   	loObjMovLicita.agregar   
		   	SELECT CsrMovLicita
		   	GATHER NAME OscMov FIELDS EXCEPT id
		  
		   	SELECT CsrAuxCuerVari
		   	GO top
		   	lNuevaLinea	= .f.
		   	SCAN FOR idarticulo = OscMov.idarticulo AND !EOF() AND registro = OscMov.registro  
		   		SELECT CsrAuxCuerVari
		    	SCATTER NAME OscCuerVari
		   		
		   		IF lNuevaLinea
		   			loObjMovLicita.agregar
		   			SELECT CsrMovLicita
		   			GATHER NAME OscMov FIELDS EXCEPT id
		   		ENDIF 
		   		
		   		
		   		IF OscCuerVari.cantidad#0
		   			SELECT CsrMovLicita
		   			OscMov.cantidad 	= ABS(OscCuerVari.cantidad) * lnunibulto
		   			OscMov.sdocant		= OScMov.cantidad
		   			OscMov.idvariedad	= OscCuerVari.idvariedad
		   			GATHER NAME OscMov FIELDS EXCEPT id 
		   			
		   			lNuevaLinea = .t.
				   
				ENDIF 	   		  
		 	    SELECT CsrAuxCuerVari	   		  
		   ENDSCAN      
		   SELECT CsrAuxCuerfac   
		ENDSCAN 
		
		
		llok = loObjNegocio.Salvar('Csrmaopera')
		                    
		IF !llok
		   =Oavisar.usuario(loObjNegocio.cadenaerror,0)
		ENDIF 
		
		loObjNegocio  = null
		loObjMovLicita   = null
		
		
		RETURN llok
		
	ENDPROC

	PROCEDURE grabardatorto
		
		LOCAL ldfechaserver,lok,ldfechafac,lnidlotemaopera,lcswitchcabefac,lcError
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		loObjNeg       = thisform.GetRefObjneg('thisform.Odatamaopera')
		loObjTabasto   = thisform.GetRefObjneg('thisform.OdataTabasto')
		loObjTabimpu   = thisform.GetRefObjneg('thisform.OdataTabimpu')
		loObjMovCtacte = thisform.Getrefobjneg('thisform.OdataMovCtacte')
		loObjCtacte    = thisform.getrefobjneg('thisform.OdataCtacte')
		loObjMovBcoCar = thisform.getrefobjneg('thisform.OdataMovbcoCar')
		loObjMovCaja   = thisform.getrefobjneg('thisform.odatamovcaja')
		loObjMovTarjeta = thisform.getrefobjneg('thisform.odataMovtarjeta')
		loObjCabefac   = thisform.getrefobjneg('thisform.odatacabefac')
		loObjCuerfac   = thisform.getrefobjneg('thisform.odatacuerfac')
		loObjMovstock  = thisform.getrefobjneg('thisform.odatamovstock')
		loObjExistenc  = thisform.getrefobjneg('thisform.odataexistenc')
		loObjcuervari  = thisform.getrefobjneg('thisform.Odatacuervari')
		loObjAfeCtacte = thisform.getrefobjneg('thisform.OdataAfectacte')
		loObjidasociado = thisform.getrefobjneg('thisform.Odataidasociado')
		loObjvendedor = thisform.getrefobjneg('thisform.Odatavendedor')
		loObjCabeAsi    = thisform.GetRefObjneg('thisform.OdataCabeasi')
		loObjMovBcoDEta    = thisform.GetRefObjneg('thisform.OdataMovBcoDEta')
		loObjCabeDeta = thisform.GetRefObjneg('thisform.OdataCabedeta')
		loObjAfeCabefac = thisform.GetRefObjneg('thisform.OdataAfeCabefac')
		
		
		WITH thisform
			.OdataTabasto.debosalvar	= .f.
			.OdataTabimpu.debosalvar	= .f.
			.OdataMovCtacte.debosalvar	= .f.
			.OdataCtacte.debosalvar	= .f.
			.OdataMovbcoCar.debosalvar	= .f.
			.odatamovcaja.debosalvar	= .f.
			.odataMovtarjeta.debosalvar	= .f.
		
			.OdataAfectacte.debosalvar	= .f.
			.Odataidasociado.debosalvar	= .f.
			.Odatavendedor.debosalvar	= .f.
			.OdataCabeasi.debosalvar	= .f.
			.OdataMovBcoDEta.debosalvar	= .f.
			.OdataCabedeta.debosalvar	= .f.
			.OdataAfeCabefac.debosalvar	= .f.
				
			.odataexistenc.debosalvar	= .f.
			.odatamovstock.debosalvar	= .f.
		ENDWITH 
		
		*--------En maopera y cabefac se actualizan datos con UPDATE desde la fac electronica
		oCa = thisform.obtenercursor("CsrMaopera")
		
		lcCmdRto = UPPER(Oca.SelectCmd)
		i = AT("WHERE",lcCmdRto)
		lcCmdRto = LEFT(lcCmdRto,i-1)
		lcCmdRto = lcCmdRto + " WHERE CsrMaopera.id < 0"
		 
		IF !ThisForm.Obtenerdatos('CsrMaopera',lcCmdRto)
			RETURN .f.
		ENDIF
			
		oCa = thisform.obtenercursor("CsrCabefac")
		
		lcCmdRto = UPPER(Oca.SelectCmd)
		i = AT("WHERE",lcCmdRto)
		lcCmdRto = LEFT(lcCmdRto,i-1)
		lcCmdRto = lcCmdRto + " WHERE CsrCabefac.id < 0"
		 
		IF !ThisForm.Obtenerdatos('CsrCabefac',lcCmdRto)
			RETURN .f.
		ENDIF
		*-------------------------
		
			
		lObjParametro = thisform.objgrabadato
		lObjParametro.lcaliasComp  = "CsrCompAux"
		lObjParametro.clasecomp    = Csrcomprobante.clase
		lObjParametro.clasetipo    = Csrcomprobante.clasetipo
		lObjparametro.compabrevia  = Csrcomprobante.cabrevia
		lObjParametro.lcintablaori = "CAFA"
		
		lnidlotemaopera = 0
		lnidfletero	= 0
		ldfechafac	= DATETIME()
		
		SELECT CsrAuxCabefac
		GO top
		llok = .t.
		SCAN FOR llok AND !EOF()
			SELECT CsrAuxMaopera
			SCATTER NAME Oscmaopera
		
			OscMaopera.numcomp 	   = thisform.proximonro
			OscMaopera.fechasis    = ldfechasis
			OscMaopera.fechaserver = ldfechaserver
			OscMaopera.ESTADO		= 0
			OscMaopera.origen 		= 'FAC'
			OscMaopera.programa 	= UPPER(this.Name)
			loObjNeg.agregar
			SELECT CsrMaopera
			GATHER NAME OscMaopera FIELDS EXCEPT id
			
			SCATTER NAME Oscmaopera ADDITIVE 
			lnidlotemaopera = IIF(lnidlotemaopera=0,OscMaopera.id,lnidlotemaopera)
			
			SELECT CsrauxCabefac
			lcswitchcabefac= switch &&LEFT(switch,2)+thisform.esvale+RIGHT(switch,2)
			REPLACE idlotemaopera WITH lnidlotemaopera,switch WITH lcswitchcabefac
			&&Para el CAE
			replace idmaopera WITH lnidlotemaopera,infocae WITH 0
			
			SCATTER NAME OscCabefac
			
			lnidfletero	= OscCabefac.idfletero
			ldfechafac	= OscCabefac.fecha
			
			OscMaopera.fechasis = OscCabefac.fecha
			lObjparametro.cnombre = OscCabefac.cnombre
			lObjparametro.detalle=ALLTRIM(lObjparametro.compabrevia+' '+OscMaopera.numcomp+' - '+lObjparametro.cnombre)
			Oscmaopera.detalle=lObjparametro.detalle
				
			WITH thisform
				.actualizafac.grabarcabefac(OscMaopera)
				lObjparametro.idorigen = OscCabefac.id		
				
				replace caetipo WITH "",idtipocbte WITH 0,talonario WITH 1 IN CsrCabefac	
			ENDWITH
			
			SELECT CsrCabefac
			SCATTER NAME OscCabefac
		
			*1-El lote es unico, no se acarrea.
			*2-Selete max nrolote para un nuevo
			TEXT TO lcCmdMax TEXTMERGE NOSHOW 
			SELECT 'B' as orden,MAX(nrolote) as nrolote FROM AfeCabefac as CsrAfeCabefac 
			ENDTEXT 
			IF !CrearCursorAdapter('CsrMaxNroLote',lcCmdMax)
				RETURN .f.
			ENDIF 
			lnNroLote = 1
			IF RECCOUNT('CsrMaxNroLote')#0
				*Solo puede ser A o B. Si no existe A, hago por B, para asegurar q halla un valor.
				SELECT CsrMaxNroLote
				LOCATE FOR orden='A'
				IF !orden='A'
					LOCATE FOR orden='B'
				ENDIF 
				lnNroLote = NVL(CsrMaxNroLote.nrolote,lnNroLote)
			ENDIF 
			
			SELECT FsrAuxOpera
			GO TOP 
			SCAN 
				loObjAfeCabefac.agregar
				replace idorigen WITH OscCabefac.id,idmaoperao WITH OscMaopera.id;
						,idafecta WITH FsrAuxOpera.id,idmaoperaa WITH FsrAuxOpera.idmaopera;
						,nrolote WITH lnNroLote,switch WITH '00000' IN CsrAfeCabefac
			ENDSCAN 
			
		
		ENDSCAN 
		
		SELECT CsrMovStock
		vista()
		
		IF llok 
			IF ! loObjNeg.Salvar('CsrMaopera')
				thisform.cadenaerrores = loObjNeg.cadenaerror
				llok = .f.
			ENDIF
		ENDIF 
		
		WITH thisform
			.odataexistenc.debosalvar	= .t.
			.odatamovstock.debosalvar	= .t.
		
			.OdataTabasto.debosalvar	= .t.
			.OdataTabimpu.debosalvar	= .t.
			.OdataMovCtacte.debosalvar	= .t.
			.OdataCtacte.debosalvar	= .t.
			.OdataMovbcoCar.debosalvar	= .t.
			.odatamovcaja.debosalvar	= .t.
			.odataMovtarjeta.debosalvar	= .t.
			.odatacabefac.debosalvar	= .t.
			.odatacuerfac.debosalvar	= .t.
			.Odatacuervari.debosalvar	= .t.
			.OdataAfectacte.debosalvar	= .t.
			.Odataidasociado.debosalvar	= .t.
			.Odatavendedor.debosalvar	= .t.
			.OdataCabeasi.debosalvar	= .t.
			.OdataMovBcoDEta.debosalvar	= .t.
			.OdataCabedeta.debosalvar	= .t.
			.OdataAfeCabefac.debosalvar	= .t.
		ENDWITH 
		
		loObjNeg       = null 	       
		loObjTabasto   = null 
		loObjTabimpu   = null
		loObjMovCtacte = null
		loObjCtacte    = null 
		loObjMovBcoCar = null 
		loObjMovCaja   = null
		loObjMovTarjeta = null
		loObjCabefac   = null
		loObjCuerfac   = null
		loObjMovstock  = null
		loObjExistenc  = null
		loObjcuervari  = null
		loObjAfeCtacte = null
		loObjidasociado = null
		lObjparametro  = null
		loObjvendedor = null	
		loObjCabeAsi    = null   
		loObjMovBcoDEta    = null
		loObjCabeDeta = null
		
		loObjfleteren	= null
		loObjrenmaope	= null
		
		thisform.oDataMovLicita.cobjnegpadre = ""
		RETURN llok
		
	ENDPROC

	PROCEDURE grabardelete
		LOCAL lcidmaopera,ldfechaserver,lok,ldfechafac
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		loObjNeg       = thisform.GetRefObjneg('thisform.Odatamaopera')
		loObjTabasto   = thisform.GetRefObjneg('thisform.OdataTabasto')
		loObjTabimpu   = thisform.GetRefObjneg('thisform.OdataTabimpu')
		loObjMovCtacte = thisform.Getrefobjneg('thisform.OdataMovCtacte')
		loObjMovBcoCar = thisform.getrefobjneg('thisform.OdataMovbcoCar')
		loObjMovCaja   = thisform.getrefobjneg('thisform.odatamovcaja')
		loObjCabefac   = thisform.getrefobjneg('thisform.odatacabefac')
		loObjMovstock  = thisform.getrefobjneg('thisform.odatamovstock')
		loObjExistenc  = thisform.getrefobjneg('thisform.odataexistenc')
		loObjAfeCtacte = thisform.getrefobjneg('thisform.OdataAfectacte')
		loObjanmaopera = thisform.getrefobjneg('thisform.Odataanmaopera')
		loObjAfebcocar = thisform.getrefobjneg('thisform.OdataAfebcocar')
		loObjCabeAsi    = thisform.GetRefObjneg('thisform.OdataCabeasi')
		loObjMovBcoDEta    = thisform.GetRefObjneg('thisform.OdataMovBcoDEta')
		loObjCabeDeta = thisform.GetRefObjneg('thisform.OdataCabedeta')
		loObjAfeCabefac = thisform.GetRefObjneg('thisform.OdataAfeCabefac')
		loObjRenMaope = thisform.GetRefObjneg('thisform.OdataRenMaope')
		
		lcidmaopera  = CsrAuxMaopera.id
		
		lObjParametro = thisform.objgrabadato
		
		
		WITH thisform
			SELECT CsrAuxMaopera
			SCATTER NAME Oscmaopera
			
		*!*	* operacion actual marco como anulado
		*!*		REPLACE estado WITH "1" IN Csrmaopera	
		*!*		
		*!*		OscMaopera.programa	   = UPPER(thisform.name)
		*!*	    OscMaopera.pefiscal    = Csrparaconfig.pefiscal	
		*!*		OscMaopera.idcomproba  = VAL(.idcompanulacion)
		*!*		OscMaopera.clasecomp   = 'K'
		*!*		OscMaopera.fechasis    = ldfechasis
		*!*		OscMaopera.fechaserver = ldfechaserver
		*!*		
		*!*		loObjNeg.agregar
		*!*		SELECT CsrMaopera
		*!*		GATHER NAME OscMaopera FIELDS EXCEPT id
		
		*!*		SCATTER NAME Oscmaopera ADDITIVE 
		
		*!*		loObjanmaopera.agregar
		*!*		REPLACE idmaopera WITH OscMaopera.id,idafecta WITH lcidmaopera,detalle WITH OscMaopera.numcomp,idmotanula WITH OscMaopera.idmotanula IN Csranmaopera
		
			SELECT CsrAuxCabefac
			SCATTER NAME OscCabefac
		
			lObjParametro.idctacte  = OscCabefac.idctacte
			lObjParametro.ctacte    = OscCabefac.ctacte
			lObjParametro.subnumero = OscCabefac.subnumero
			lObjParametro.idsubcta  = OscCabefac.idsubcta
			lObjparametro.cnombre   = OscCabefac.cnombre
		*!*		lObjparametro.idorigen  = OscMaopera.id
			lObjParametro.importe   = OscCabefac.total
			lObjParametro.total     = OscCabefac.total
			lObjParametro.fecha     = ldfechaserver
		*!*		lObjParametro.detalle	= 'Anula '+OscMaopera.detalle
			
			
			IF !.actualizafac.controlcajaactiva(OscMaopera)
				.cadenaerrores ='Se CANCELO la grabación' +CHR(13)+'Porque se CERRO LA CAJA.'
				RETURN .f.
			ENDIF 	
			&&Usamos la fecha contable para mantener la fecha de anulacion.
		*!*		lObjParametro.fecha     = FechaHoraCero(OscMaopera.fechasis) &&ldfechaserver
			
			**&&''
			.actualizafac.leerctacte()
			.actualizafac.borrocontab(lcidmaopera,OscMaopera,lObjParametro)
			*.actualizafac.grabarcabeasi(OscMaopera,lObjParametro)
			*.actualizafac.borroasto(lcidmaopera,OscMaopera,lObjParametro)
			.actualizafac.cambioctacte(@lObjParametro,1)
			.actualizafac.grabarexistencia()
			
			TEXT TO lcCmdAfe TEXTMERGE NOSHOW 
			SELECT CsrAfeCabefac.* FROM AfeCabefac as CsrAfeCabefac
			where idorigen = <<CsrAuxCabefac.id>> and idmaoperao = <<CsrAuxMaopera.id>>
			ENDTEXT 
			IF thisform.obtenerdatos('CsrAfeCabefac',lcCmdAfe)
				thisform.Release
			ENDIF 
			DELETE FROM CsrAfeCabefac		
			
			*Eliminamos la factura de la rendicion.	
			.oFacRendir.iniciarparametros()
			.oFacRendir.oDatos.cidmaopera = strid(lcidmaopera)
		
			llok =.oFacRendir.Grabarborrado()
			IF !llok
				.cadenaerrores = .oFacRendir.cadenaerror
			ENDIF 
			
			cCadena = ""
			IF NOT this.Actualizafac.controlasto(@cCadena)
				.cadenaerrores = cCadena
				llok = .f.
			ENDIF 
			
			IF llok
				IF !loObjNeg.Salvar('CsrMaopera')               
					llok = .f.
				   	.cadenaerrores = loObjNeg.cadenaerror
				ENDIF 
			ENDIF 
		ENDWITH
		
		loObjNeg       = null 	       
		loObjTabasto   = null 
		loObjTabimpu   = null
		loObjMovCtacte = null
		loObjMovBcoCar = null 
		loObjMovCaja   = null
		loObjCabefac   = null
		loObjMovstock  = null
		loObjExistenc  = null
		loObjAfeCtacte = null
		loObjanmaopera = null
		lObjparametro  = null
		loObjAfebcocar = null
		loObjCabeAsi    = null
		loObjMovBcoDEta = null
		loObjCabeDeta = null
		RETURN .t.
		
	ENDPROC

	PROCEDURE grabardiferido		&& grabar para  luego leer en impresora fiscal
		
		* guardo los datos en auxiliares que seran capturados por el impresor diferido de facturas fiscales
		* el facturador siempre sale con .t., si no se graba el comprobante, el mismo debera ser informado en la maquina 
		* que tiene la impresion diferida
		
		LOCAL ldfechaserver,lok,ldfechafac
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		LOCAL OscCabefac,OscCuerfac,Oscpagos,OscDmaopera
		
		loObjDMaopera  = thisform.GetRefObjneg('thisform.OdataDmaopera')
		loObjDCabFac   = thisform.GetRefObjneg('thisform.OdataDcabefac')
		loObjDCueFac   = thisform.getrefobjneg('thisform.OdataDcuerfac')
		loObjDpagos    = thisform.getrefobjneg('thisform.OdataDpagos')
		loObjDcuervari = thisform.getrefobjneg('ThisForm.OdataDcuervari')
		loObjCabeDeta = thisform.GetRefObjneg('thisform.OdataCabedeta')
		
		SELECT CsrAuxcabefac
		SCATTER NAME OscCabefac
		
		SELECT CsrDMaopera
		SCATTER NAME OscDmaopera
		
		loObjDMaopera.agregar
		
		SELECT CsrAuxMaopera
		SCATTER NAME OscDmaopera ADDITIVE 
		
		OscDMaopera.id	       = CsrDmaopera.id
		OscDMaopera.idcomproba = thisform.containerencabeza._cbocomprobante.Value
		OscDmaopera.clasecomp  = Csrcomprobante.clase
		OscDMaopera.numcomp    = thisform.proximonro
		OscDMaopera.fechasis   = ldfechaserver
		OscDMaopera.fechaserver = ldfechaserver
		OscDMaopera.fecha      = OscCabefac.fecha
		OscDMaopera.idctacte   = OscCabefac.idctacte
		OscDMaopera.importe    = OscCabefac.total
		OscDMaopera.idprefijo  = Csrprefijonro.id
		OscDMaopera.copiatkt   = OscCabefac.copiatkt
		OscDMaopera.switch     = "00000"
		OscDMaopera.sucursal   = Goapp.sucursal
		OscDMaopera.terminal   = Goapp.terminal
		OscDMaopera.sector     = thisform.sectorterminal
		OscDMaopera.puestocaja = thisform.puestocaja
		OscDMaopera.idoperador = goapp.idusuario
		OscDMaopera.estado     = "0"
		
		SELECT CsrDMaopera
		GATHER NAME OscDMaopera FIELDS EXCEPT id
		
		loObjDCabfac.agregar
		SELECT CsrDcabefac
		OscCabefac.id         = CsrDcabefac.id
		OscCabefac.idmaopera  = OscDmaopera.id
		OscCabefac.signo      = 1
		GATHER NAME OscCabefac
		
		SELECT CsrAuxCuerfac
		GO top
		SCAN FOR !EOF()
			* no guardo lineas en blanco
		   IF idarticulo=0 AND LEN(TRIM(nombre))=0 AND cantidad=0 AND preunita=0
		   		LOOP 
		   ENDIF 
		   SCATTER NAME OscCuerfac
		   OscCuerfac.idmaopera = OscDmaopera.id
		   OscCuerfac.switch    = "00000"
		   OscCuerfac.idcabeza  = OscCabefac.id
		   
		   * lo guardo en cantidades totales
		   lnunibulto = IIF(OscCuerfac.unibulto=0,1,OscCuerfac.unibulto)
		   lnunibulto = IIF(OscCuerfac.univenta=1,1,lnunibulto)
		   
		   OscCuerfac.unibulto = IIF(OscCuerfac.unibulto=0,1,OscCuerfac.unibulto)
		   OscCuerfac.cantidad = OscCuerfac.cantidad * lnunibulto
		   OscCuerfac.kilos    = OscCuerfac.kilos    * OscCuerfac.cantidad
		   OscCuerfac.volumen  = OscCuerfac.volumen  * OscCuerfac.cantidad
		         
		   loObjDCuefac.agregar   
		   SELECT CsrDcuerfac
		   GATHER NAME OscCuerfac FIELDS EXCEPT id
		
		   SELECT CsrAuxCuerVari
		   GO top
		   SCAN FOR idarticulo = OscCuerfac.idarticulo AND !EOF()  AND registro = OscCuerfac.registro
		        SCATTER NAME OscCuerVari
		   		IF CsrAuxCuerVari.cantidad#0
		   		   OscCuerVari.cantidad = OscCuerVari.cantidad * lnunibulto
				   OscCuervari.kilos    = OscCuervari.kilos    * OscCuerVari.cantidad
				   OscCuervari.volumen  = OscCuervari.volumen  * OscCuerVari.cantidad
				   
				   loObjDcuervari.agregar
				   REPLACE idmaopera WITH OscDmaopera.id,idcuerfac WITH OscCuerfac.idcuerfac,idarticulo WITH OscCuerfac.idarticulo;
				   		  ,idsubarti WITH OscCuervari.idsubarti,idvariedad WITH OscCuervari.idvariedad;
				   		  ,cantidad WITH OscCuervari.cantidad,kilos WITH OscCuervari.kilos,volumen WITH OscCuervari.volumen IN CsrDCuervari
				ENDIF 	   		  
		 	    SELECT CsrAuxCuerVari	   		  
		   ENDSCAN      
		      
		   SELECT CsrAuxCuerfac   
		ENDSCAN 
		
		SELECT Csrpago
		GO top
		SCAN FOR !eof()
		   if importe=0
		      loop
		   ENDIF
		   
		   SCATTER NAME OscPagos
		   Oscpagos.idmaopera = OscDmaopera.id
		         
		   loObjDpagos.agregar   
		   SELECT CsrDpagos
		   GATHER NAME Oscpagos FIELDS EXCEPT id
		
		   Sele Csrpago
		Endscan
		
		llok = loObjDMaopera.Salvar('CsrDmaopera')
		                    
		IF !llok
		   =Oavisar.usuario(loObjDMaopera.cadenaerror,0)
		ENDIF 
		
		loObjDmaopera  = null
		loObjDCabFac   = null
		loObjDCueFac   = null
		loObjDpagos    = null
		loObjDcuervari = null
		loObjCabeDeta = null
		
		RETURN .t.
		
	ENDPROC

	PROCEDURE grabardiferidofiscal
		
		LPARAMETERS lnDondeGrabo
		
		* guardo los datos en auxiliares que seran capturados por el impresor diferido de facturas fiscales
		* el facturador siempre sale con .t., si no se graba el comprobante, el mismo debera ser informado en la maquina 
		* que tiene la impresion diferida
		
		LOCAL ldfechaserver,lok,ldfechafac
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		LOCAL OscCabefac,OscCuerfac,Oscpagos,OscDmaopera
		
		loObjDMaopera  = thisform.GetRefObjneg('thisform.OdataDmaopera')
		loObjDCabeFac   = thisform.GetRefObjneg('thisform.OdataDcabefac')
		loObjDCuerFac   = thisform.getrefobjneg('thisform.OdataDcuerfac')
		loObjDpagos    = thisform.getrefobjneg('thisform.OdataDpagos')
		loObjDcuervari = thisform.getrefobjneg('ThisForm.OdataDcuervari')
		loObjDCabeDeta= thisform.getrefobjneg('ThisForm.OdataDCabeDeta')
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrDCabefac.* FROM DCabefac as CsrDCabefac WHERE id < 0
		ENDTEXT 
		IF NOT thisform.obtenerdatos('CsrDCabefac',lcCmd)
			RETURN .f.
		ENDIF 
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrDMaopera.* FROM DMaopera as CsrDMaopera WHERE id < 0
		ENDTEXT 
		IF NOT thisform.obtenerdatos('CsrDMaopera',lcCmd)
			RETURN .f.
		ENDIF 
		
		WITH this.oActualizaFacFiscal
			.IniciarParametros()
			
			&&el fiscal solo graba factura,n debito o n.credito
			
			.oDatos.nidcomproba		= thisform.containerencabeza._cbocomprobante.Value
			.oDatos.cproximonro		= thisform.proximonro
			.oDatos.dfechasis			= ldfechasis
			.oDatos.dfechaserver		= ldfechaserver
			.oDatos.switchmaope		= "00000"
			.oDatos.nsectorterminal	= thisform.sectorterminal
			.oDatos.npuestocaja		= thisform.puestocaja
			.oDatos.nidpuestospooler	= this.puestospooler
			.oDatos.nidafectado		= this.idafectado
			.oDatos.nidmaopeafectado	= this.idmaopeafectado
			llok = .t.
			IF .grabardato()
				IF ! loObjDMaopera.Salvar('CsrDMaopera')
					thisform.cadenaerrores = loObjDMaopera.cadenaerror
					llok = .f.
				ENDIF 
			ELSE
				thisform.cadenaerrores = .cadenaerror
				llok = .f.
			ENDIF 
		ENDWITH 
		
		loObjDmaopera  = null
		loObjDCabFac   = null
		loObjDCueFac   = null
		loObjDpagos    = null
		loObjDcuervari = null
		loObjDCabeDeta = null
		RETURN llok
		
	ENDPROC

	PROCEDURE grabarnotapedido		&& graba notas de pedido
		
		* guardo los datos en auxiliares que seran capturados por el facturador de notas de pedido
		* el facturador siempre sale con .t., si no se factura el comprobante, el mismo debera ser informado por el facturador 
		
		LOCAL ldfechaserver,lok,ldfechafac
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		LOCAL OscCabefac,OscCuerfac,Oscpagos,OscNmaopera
		
		
		loObjNMaopera  = thisform.GetRefObjneg('thisform.OdataNmaopera')
		loObjNCabFac   = thisform.GetRefObjneg('thisform.OdataNcabefac')
		loObjNCueFac   = thisform.getrefobjneg('thisform.OdataNcuerfac')
		loObjNcuervari = thisform.getrefobjneg('ThisForm.OdataNcuervari')
		loObjAfeLicita = thisform.getrefobjneg('ThisForm.OdataAfeLicita')
		
		thisform.oDataMovLicita.cobjnegpadre = "oDataNMaopera"
		
		SELECT CsrAuxcabefac
		GO TOP 
		llok = .t.
		SCAN FOR NOT EOF() AND llok
			SELECT CsrAuxCabefac
			SCATTER NAME OscCabefac
		
			SELECT CsrNMaopera
			SCATTER NAME OscNmaopera
		
			loObjNMaopera.agregar
		
			SELECT CsrAuxMaopera
			SCATTER NAME OscNmaopera ADDITIVE 
		
			OscNMaopera.id          = CsrNMaopera.id
			OscNMaopera.idcomproba  = thisform.containerencabeza._cbocomprobante.Value
			OscNmaopera.clasecomp   = Csrcomprobante.clase
			OscNmaopera.clasetipo   = Csrcomprobante.clasetipo
			OscNMaopera.numcomp     = OscCabefac.proximonro
			OscNMaopera.fechasis    = ldfechasis
			OscNMaopera.fechaserver = ldfechaserver
			OscNMaopera.fecha       = OscCabefac.fecha
			OscNMaopera.idctacte    = OscCabefac.idctacte
			OscNMaopera.importe     = OscCabefac.total
			OscNMaopera.idprefijo   = Csrprefijonro.id
			OscNMaopera.copiatkt    = OscCabefac.copiatkt
			OscNMaopera.switch      = "00000"
			OscNMaopera.sucursal    = Goapp.sucursal
			OscNMaopera.terminal    = Goapp.terminal
			OscNMaopera.sector      = thisform.sectorterminal
			OscNMaopera.puestocaja  = thisform.puestocaja
			OscNMaopera.idoperador  = goapp.idusuario
			OscNMaopera.estado      = "0"
		
			SELECT CsrNMaopera
			GATHER NAME OscNMaopera FIELDS EXCEPT id
			
			loObjNCabfac.agregar
			SELECT CsrNcabefac
			OscCabefac.id         = CsrNcabefac.id
			OscCabefac.idmaopera  = OscNmaopera.id
			OscCabefac.signo      = 1
			GATHER NAME OscCabefac
		
			SELECT CsrAuxCuerfac
			GO top
		
			SCAN FOR !EOF()
				IF idfrio <> OscCabefac.idfrio AND This.objseteoparam.FacPedido_Frio
					LOOP 
				ENDIF 
				* no guardo lineas en blanco
			   	IF idarticulo=0 AND LEN(TRIM(nombre))=0 AND cantidad=0 AND preunita=0
			   		LOOP 
			   	ENDIF 
			   	SCATTER NAME OscCuerfac
			   	OscCuerfac.idmaopera = OscNmaopera.id
			   	OscCuerfac.switch    = "00000"
			   	OscCuerfac.idcabeza  = OscCabefac.id
			      
			   	* lo guardo en cantidades totales
			   	lnunibulto = IIF(OscCuerfac.unibulto=0,1,OscCuerfac.unibulto)
			   	lnunibulto = IIF(OscCuerfac.univenta=1,1,lnunibulto)
			  	
			   	OscCuerfac.unibulto = IIF(OscCuerfac.unibulto=0,1,OscCuerfac.unibulto)
			   	OscCuerfac.cantidad = OscCuerfac.cantidad * lnunibulto
			   	OscCuerfac.cantorig =  OscCuerfac.cantidad
			   	IF OscCuerfac.pesable=0
			   		OscCuerfac.kilos    = OscCuerfac.kilos    * OscCuerfac.cantidad
			   	ELSE
			   		OscCuerfac.kilos    = 0&&OscCuerfac.kilos   
			   	ENDIF 
			   	OscCuerfac.volumen  = OscCuerfac.volumen  * OscCuerfac.cantidad
			         
			   	loObjNCuefac.agregar   
			   	SELECT CsrNcuerfac
			   	GATHER NAME OscCuerfac FIELDS EXCEPT id
		
			   	OscCuerfac.codvalido = ''
			   	OscCuerfac.idcuerfac = CsrNcuerfac.id         && id Ncuerfac
			   
			   	SELECT CsrAuxCuerVari
			   	GO top
			   	SCAN FOR idarticulo = OscCuerfac.idarticulo AND !EOF() AND registro = OscCuerfac.registro  
			    	SCATTER NAME OscCuerVari
			   		IF CsrAuxCuerVari.cantidad#0
			   			OscCuerVari.cantidad = ABS(OscCuerVari.cantidad) * lnunibulto
					   	OscCuervari.kilos    = OscCuervari.kilos    * OscCuerVari.cantidad
					   	OscCuervari.volumen  = OscCuervari.volumen  * OscCuerVari.cantidad
			   			OscCuervari.comprome = 0
					   	loObjNcuervari.agregar
					   	REPLACE idmaopera WITH OscNmaopera.id,idcuerfac WITH OscCuerfac.idcuerfac,idarticulo WITH OscCuerfac.idarticulo;
					   		  ,idsubarti WITH OscCuerVari.idsubarti,idvariedad WITH OscCuerVari.idvariedad, escambio WITH OscCuerVari.escambio;
					   		  ,cantidad WITH OscCuerVari.cantidad,kilos WITH OscCuerVari.kilos,volumen WITH OscCuerVari.volumen;
					   		  ,cantorig WITH OscCuerVari.cantidad IN CsrNCuervari
					ENDIF 	   		  
			 	    SELECT CsrAuxCuerVari	   		  
			   ENDSCAN      
			
			   OscNMaopera.origen = 'FPE'
			   this.actualizafac.afectarlicita(OscNMaopera,OscCuerfac)
			   
			   SELECT CsrAuxCuerfac   
			ENDSCAN 
		ENDSCAN 
		
		llok = loObjNMaopera.Salvar('CsrNmaopera')
		                    
		IF !llok
		   =Oavisar.usuario(loObjNMaopera.cadenaerror,0)
		ENDIF 
		
		loObjNmaopera  = null
		loObjNCabFac   = null
		loObjNCueFac   = null
		loObjNcuervari = null
		loObjAfeLicita = null
		
		thisform.oDataMovLicita.cobjnegpadre = "thisform.oDataMaopera"
		
		RETURN llok
		
	ENDPROC

	PROCEDURE grid2_borrarlinea		&& Borra una linea del grid2, productos elegidos
		LOCAL lncantidad,lnunibulto,lnuniventa,lnunitario,lntotal,lndescto,lcCmd,lnbonifica
		LOCAL lndecimaluni,lndecimaltot,lncalculo,lok,OscatterCab,lnCantStock,lnrecno
		
		SELECT CsrAuxCabefac
		SCATTER NAME OscatterCab
		
		SELECT CsrAuxCuerfac
		lnrecno = RECNO("CsrAuxCuerfac")
		*vista()
		
		*stop()
		WITH thisform
			 lndecimaluni              = .ndecimaluni
			 lndecimaltot              = .ndecimaltot
			 .loObjBonifica.idproducto = CsrAuxCuerfac.idarticulo
		 	 .loObjBonifica.idvendedor = CsrAuxMaopera.idvendedor
			 .loObjBonifica.cantidad     = 0
			 .loObjBonifica.idprodpromo  = 0	 
			 .loObjBonifica.idprodregalo = 0	 	 
			 .loObjBonifica.cada		 = 0
			 .loObjBonifica.entrega		 = 0
			 .loObjBonifica.bonpromo	 = 0
			 .loObjBonifica.bonivdorviernes = 0
			 .loObjBonifica.idcabeunifica = CsrAuxCuerfac.idcabeunifica
		 	 .loObjBonifica.bonctacte   = 0
		     .loObjBonifica.registro    = CsrAuxCuerfac.registro
		     
			 DELETE FOR idarticulo = this.loObjBonifica.idproducto AND registro=this.loObjBonifica.registro IN CsrAuxCuerVari	
			 &&Borramos los combos asociados
			 IF .loObjBonifica.idproducto#0
			 	DELETE For idprodgenera = this.loObjBonifica.idproducto IN CsrAuxCuerfac
			 ENDIF 
			 DELETE For idarticulo = this.loObjBonifica.idproducto AND registro = this.loObjBonifica.registro IN CsrAuxCuerfac
			 
			 *DELETE IN CsrAuxCuerfac
			 SKIP IN csrauxcuerfac
			 IF EOF()
			    thisform.agregarcuerfac()	     	 	
			 ENDIF
			 lnrecno = RECNO("CsrAuxCuerfac")
			 
			 *pack IN csrauxcuerfac
		
		   	 .controlbonificacion()
		   	  
		     lnbonifica  = IIF(.loObjBonifica.bonctacte > .loObjBonifica.bonpromo,.loObjBonifica.bonctacte,.loObjBonifica.bonpromo)
		     IF (.containerencabeza._txtbonif1.Value#0 OR .containerencabeza._txtbonif2.Value#0) AND lnbonifica#0
				 .loObjBonifica.bonpromo = 0
		 		 lnbonifica = 0
			 ENDIF 
			 
		     SELECT  CsrAuxCuerFac
			 IF .loObjBonifica.idcabeunifica#0
				GO top
				SCAN
					IF idcabeunifica = .loObjBonifica.idcabeunifica			
						* recalculo el nuevo descuento
						SCATTER NAME Oscatter
						lncantidad     = Oscatter.cantidad
						lnunibulto	   = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
						lnuniventa     = Oscatter.univenta
						lnunibulto     = IIF(lnuniventa=1,1,lnunibulto)
						lnCantFinal    = lncantidad * lnunibulto
					    Oscatter.despor = lnbonifica
							
						.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto)
						
						Oscatter.total = Red((Oscatter.UniSiva + Oscatter.internoFin + Oscatter.ivauni),lndecimaltot)		    
						GATHER NAME Oscatter
					ENDIF 			      
				ENDSCAN
			 ENDIF				
			 
			 GO lnrecno
			 
			 .grid2_procesolinea(13)
		
		ENDWITH 
	ENDPROC

	PROCEDURE grid2_calculoprecio
		LPARAMETERS Oscatter
		
		lcAlias = ALIAS()
		
		lndecimaluni = thisform.ndecimaluni
		lndecimaltot = thisform.ndecimaltot
		
		SELECT CsrAuxCabefac
		SCATTER NAME OscatterCab
		
		SELECT CsrProducto
		LOCATE FOR id = Oscatter.idarticulo
		IF NOT FOUND()
		
			oCa = thisform.obtenercursor("CsrProducto")
		
			lcCmdProd = UPPER(Oca.SelectCmd)
			i = AT("WHERE",lcCmdProd)
			lcCmdProd = LEFT(lcCmdProd,i-1)
			lcCmdProd = lcCmdProd + " WHERE Csrproducto.id in (" + Oscatter.idarticulo+ ") "
		
			IF !thisform.obtenerdatos('Csrproducto',lcCmdProd )
			   thisform.Release 
			ENDIF   
		ENDIF 
		
		SELECT CsrProducto
		LOCATE FOR id = Oscatter.idarticulo
		SCATTER NAME lObjProducto
		
		SELECT(lcAlias)
		
		thisform.precioprod1.calculaprecio(lObjProducto,@lObjprecio)
		*!*					
		*!*	Oscatter.tasaiva		= lObjprecio.ivari
		*!*	Oscatter.precostosiva	= lobjprecio.costoreposicion
		*!*	Oscatter.interno		= lObjprecio.interno
		*!*	Oscatter.precosto		= lobjprecio.costosiniva
		
		LOCAL lnpreunita,lnpreunitasiva,lnprearti,lnpreartisiva
		
		IF NOT thisform.oRegfacvta.preciosnegociados(lObjProducto.id,@lObjprecio)
			thisform.oRegFACVTA.PRECIoporlista(lObjProducto,@lObjprecio)
			thisform.determinarlistaprecio(@lnpreunita,@lnpreunitasiva,@lnprearti,@lnpreartisiva,Oscatter.omitirlistas)
		ELSE
			&&Si se encuentran precios negociados,cambiamos las variables del precio
			lnpreunita     = lObjprecio.prevtaciva1   && CsrProducto.prevtaf4
			lnpreunitasiva = lObjprecio.prevta1       && CsrProducto.prevta4
			lnprearti		= ROUND(lnpreunita,2)
			lnpreartisiva	= ROUND(lnpreunitasiva,2)
		ENDIF 
		        
				
		Oscatter.prearti		= lnprearti
		Oscatter.preartisiva	= lnpreartisiva
		Oscatter.preunita		= lnpreunita
		Oscatter.preunitasiva	= lnpreunitasiva
		Oscatter.total			= 0
		
		IF Oscatter.idarticulo=0 AND Oscatter.prearti=0 AND Oscatter.preunita#0
		  IF Csrplanpago.tasa#0
			 Oscatter.preunita = red( ((Oscatter.preunita-Oscatter.interno)*(Csrplanpago.tasa/100)+Oscatter.interno),lndecimaluni)
		  ENDIF      
		ENDIF 
		
		lncantidad     = Oscatter.cantidad
		lnunibulto	   = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
		lnuniventa     = Oscatter.univenta
		lnunibulto     = IIF(lnuniventa=1,1,lnunibulto)
		lnCantFinal    = lncantidad * lnunibulto
				
		thisform.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto)
		
		Oscatter.total = Red((IIF(this.incluyeiva,Oscatter.UniCiva,Oscatter.UniSiva) + Oscatter.internofin ),lndecimaltot)	
		
		SELECT(lcAlias )
	ENDPROC

	PROCEDURE grid2_control		&& Verifica producto en container pedido de productos
		PARAMETERS lcSetfocus,lcGotfocus
		
		IF thisform.accion#'A' OR thisform.hayescape
			*oavisar.usuario('Entro')
			RETURN .t.
		ENDIF 
		
		LOCAL lncantidad,lnunibulto,lnuniventa,lnunitario,lntotal,lndescto,lcCmd,lnbonifica,lnCantFinal
		LOCAL lndecimaluni,lndecimaltot,lncalculo,lok,OscatterCab,lnCantStock,lnrecno
		
		cleartec()
		lok = .t.
		
		SELECT CsrAuxCabefac
		SCATTER NAME OscatterCab
		
		SELECT CsrAuxCuerFac
		lnrecno = RECNO()
		SCATTER NAME Oscatter
		
		
		WITH thisform
			 lndecimaluni              = .ndecimaluni
			 lndecimaltot              = .ndecimaltot
			 .loObjBonifica.idproducto = Oscatter.idarticulo
			 .loObjBonifica.idrubro		= CsrProducto.idrubro
		 	 .loObjBonifica.idvendedor = CsrAuxMaopera.idvendedor
			 .loObjBonifica.cantidad     = 0
			 .loObjBonifica.idprodpromo  = 0	 
			 .loObjBonifica.idprodregalo = 0	
			 .loObjBonifica.idprodcombo  = 0	 	 
			 .loObjBonifica.cada		 = 0
			 .loObjBonifica.entrega		 = 0
			 .loObjBonifica.bonpromo	 = 0
			 .loObjBonifica.bonivdorviernes = 0
			 .loObjBonifica.idcabeunifica = Oscatter.idcabeunifica
		 	 .loObjBonifica.bonctacte   = 0
		     .loObjBonifica.registro    = Oscatter.registro
			 .loObjBonifica.idcombo   = 0
				
			 IF Oscatter.escombo = 1
			 	&&No se toca el producto si proviene de un combo
			 	RETURN .t.
			 ENDIF 
			 
			&&Solo si resta del stock, controlamos que existan unidades
			 IF Oscatter.idarticulo#0 AND (UPPER("ThisForm.Grid2.Column5.Text1")$UPPER(lcGotFocus) OR UPPER("ThisForm.Grid2.Column10.Text1")$UPPER(lcGotFocus)) 
			 	
			 	IF UPPER("ThisForm.Grid2.Column10.Text1")$UPPER(lcGotFocus) &&Si la columna kilos es la activa, debemos validar la carga
			 		IF Oscatter.pesable = 1 and Oscatter.cantkilos = 0	 	
			 			RETURN .f.
			 		ENDIF 
			 	ENDIF 
			 	IF NOT this.cantidaddec
			 		Oscatter.cantidad = INT(Oscatter.cantidad)
			 	ENDIF 
			 	
				IF Oscatter.cantidad=0
					*=Oavisar.usuario("La cantidad no puede ser 0",0)
					RETURN .f.
				ELSE
					SELECT CsrExistenc
					SUM existedisp TO lnCantStock
					SUM kilosdisp TO lnCantKilosStock
					
					lncantidad     = Oscatter.cantidad
					
					lnunibulto	   = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
					lnpesable = Oscatter.pesable
					lnuniventa     = Oscatter.univenta
					lnunibulto     = IIF(lnuniventa=1,1,lnunibulto)
					lnkilos		=IIF(lnpesable=0,0,Oscatter.cantkilos)
					IF lnpesable=0
						lnCantFinal    = lncantidad * lnunibulto
					ELSE
						lnCantKilosFinal = lnkilos
						lnCantFinal = lncantidad
					ENDIF 
					&&Las notas de credito signo(1) no deben controlar minimos
					IF Oscatter.espromocion<>1 AND thisform.tipoform#'D' AND Csrcomprobante.signostock=2 && promociones no controlo stock
						lnminimo	   =  csrproducto.minimofac * lnunibulto
						IF lnCantFinal < lnminimo AND lnminimo>0 AND !this.leyendocuerpedido AND NOT this.vtabulto
							lcmensaje =  "La cantidad digitada de "+ALLTRIM(STR(lnCantFinal))+" unidades"+CHR(13)+CHR(13);
							+"es menor al minimo de "+ALLTRIM(STR(lnminimo))+" unidades"
							=Oavisar.usuario(lcmensaje,0)
							thisform.lpidocantidad=.t.
							IF NOT this.lomitirexistenc
								RETURN .f.
							ENDIF 
						ENDIF 						
					ENDIF 			 
					
					*IF not(thisform.tipofactura$"DE") AND thisform.lpidoexistenc AND !this.leyendocuerpedido AND STR(CsrAuxMaopera.idcomproba,10)$thisform.idctastockresta
					
					IF not(thisform.tipofactura$"DE") AND Oscatter.infstock=1 AND !this.leyendocuerpedido AND STR(CsrAuxMaopera.idcomproba,10)$thisform.idctastockresta
						&&Error de logica, en caso de vartiedades, no se puede validar por la suma de variedades
						**stop()
						IF !.lhayvariedad
						*IF lnCantFinal > lnCantStock
							*IF !.lhayvariedad
							IF lnCantFinal > lnCantStock
								lcmensaje =  "La cantidad digitada de "+STR(lnCantFinal)+" unidades"+CHR(13)+CHR(13);
										+"Supera la existencia de "+STR(lnCantStock)+" unidades"
								=Oavisar.usuario(lcmensaje,0)
								*RETURN .f.		
							*ELSE
							ENDIF 
							IF lnpesable=1
								IF lnCantkilosFinal > lnCantKilosStock
									lcmensaje =  "La cantidad digitada de "+STR(lnCantFinal)+" kilos"+CHR(13)+CHR(13);
											+"Supera la existencia de "+STR(lnCantStock)+" kilos"
									=Oavisar.usuario(lcmensaje,0)
									*RETURN .f.			
								ENDIF 
							ENDIF 
						ELSE 
								lcmensaje = ''
								SELECT CsrAuxCuerVari
								LOCATE FOR idarticulo = Oscatter.idarticulo AND registro=Oscatter.registro
								DO WHILE idarticulo = Oscatter.idarticulo AND registro=Oscatter.registro AND !EOF()
									SELECT CsrSubProducto
									LOCATE FOR id = CsrAuxCuervari.idsubarti
								
									SELECT CsrExistenc
									SUM existedisp FOR idarticulo=Oscatter.idarticulo AND idsubarti=CsrAuxCuerVari.idsubarti TO lnCantVariStock
									lnCantVariFinal    	= CsrAuxCuervari.cantidad
									lnCantVariFinal	= lnCantVariFinal* lnunibulto
									IF lnCantVariFinal > lnCantVariStock
										lcmensaje =  lcmensaje + "La cantidad digitada de "+LTRIM(STR(lnCantVariFinal))+" unidades de la variedad "+CsrSubproducto.nombre+CHR(13);
											+"Supera la existencia de "+LTRIM(STR(lnCantVariStock))+" unidades"+CHR(13)+CHR(13)
									ENDIF 
									SELECT CsrAuxCuervari
									SKIP 
								ENDDO 
								IF LEN(LTRIM(lcmensaje))#0
									=Oavisar.usuario(lcmensaje,0)
									*RETURN .f.
								ENDIF 
							*ENDIF 
								
						ENDIF 
						
					ENDIF	
				ENDIF 
			ENDIF
		
			ldFechaPrecio = (csrauxcuerfac.fechaultprecio+thisform.preciodiasact)
			lcCartelPrecio = "+ "+strtrim(thisform.preciodiasact)+" días"
			*stop()
			IF UPPER("ThisForm.Grid2.Column5.Text1")$UPPER(lcGotFocus) OR UPPER("ThisForm.Grid2.Column1.Text1")$UPPER(lcGotFocus)
				IF ldFechaPrecio< DATE() AND thisform.preciodiasact#0 AND CsrAuxCuerfac.precostosiva#0
					*oavisar.usuario('ADVERTERNCIA'+CHR(13)+CHR(13)+"PRECIO DESACTUALIZADO "+CHR(13)+lcCartelPrecio)
				ENDIF 
			ENDIF 
			
			 IF Oscatter.idarticulo#0 AND UPPER("ThisForm.Grid2.Column4.Text1")$UPPER(lcGotFocus) AND !this.leyendocuerpedido
				IF Oscatter.preunita=0 AND !.tipoform#"FD"   && facturacion, nota pedido
					=Oavisar.usuario("El precio unitario no puede ser 0.00",0)
					RETURN .f.
				ENDIF 	
					
			ENDIF
			
		 
			&&PRIORIDADES EM BONIFICACIONES
			&&1-BONIFICACION DIGITADA
			&&o
			&&	2B-BONIFICACION CTACTE X RUBRO
			&&o
			&&	2-BONIFICACION X CTACTE
			&&o
			&&	2-BONIFICACION X CATEGORIA CTACTE
			&&+
			&&3-BONIFICACION DEL CLIENTE PARA ESE PRODUCTO
			&&ó
			&&BONIFICACION X FAMILIA
			&&ó
			&&BONIFICACION X FAMILIA
			&&ó
			&&BONIFICACION X PROMOCION (NO ENTREGA MERCADERIA)
			&&ó
			&&BONIFICACION DE PRODUCTO X FECHA
			
			*oavisar.usuario(str(Oscatter.bondigitada)+CHR(13)+STR(OScatter.despor))
			
			*stop()
			* bonificacion digitada
			
			IF Oscatter.espromocion = 1
		  		Oscatter.despor = 0
		  		Oscatter.bondigitada= 0
		  	ENDIF 
		  	
		    	lnbonifica = 0
		   	IF Oscatter.bondigitada=1
		       		lnbonifica = Oscatter.despor
		  	ENDIF 
		  	
		  	IF Oscatter.bondigitada<> 1 AND Oscatter.nobonificar=0
		  		*stop()
			   	 *Bonificaciones por ctacte o promocion
				IF Oscatter.idarticulo#0 AND (UPPER("ThisForm.Grid2.Column5.Text1")$UPPER(lcGotFocus) OR UPPER("ThisForm.Grid2.Column10.Text1")$UPPER(lcGotFocus) )
					*stop()
					.loObjBonifica.cantidad = lnCantFinal&&Oscatter.cantidad
			   	  	.controlbonificacion()
			   	  	&&.loObjBonifica.bonctacte = "bonificacion del cliente por producto " 
			   	  	&& .loObjBonifica.bonpromo = "bonificacion otras sobre el producto"
			      		&&lnbonifica  = IIF(.loObjBonifica.bonctacte > .loObjBonifica.bonpromo,.loObjBonifica.bonctacte,.loObjBonifica.bonpromo)
			      		lnbonifica  = IIF(.loObjBonifica.bonctacte <> 0 ,.loObjBonifica.bonctacte,.loObjBonifica.bonpromo)
			      		ldboniffecha= IIF(.loObjBonifica.bonctacte <> 0 ,.loObjBonifica.bonfecha,.loObjBonifica.bonpfecha)
			      		Oscatter.despor		= lnbonifica
			      		Oscatter.oferfecha	= ldboniffecha
			 	ENDIF 
		  		
		  		IF Oscatter.idarticulo#0
				 	&&Se suma en la linea del producto la bonifcacion del clienta. Y se guarda como una sola bonif
				 	LOCAL nBoniRubro
				 	nBoniRubro = .CalculoBoniRubro()
				 	IF nBoniRubro <> -1
				 		Oscatter.despor = lnbonifica + nBoniRubro
				 	ELSE 
					    	IF (OscatterCab.bonif1#0 OR OscatterCab.bonif2#0)
					       		Oscatter.despor		= lnbonifica + .CalculoBoniCtacte(OscatterCab.bonif1 , OscatterCab.bonif2)
					       		Oscatter.oferfecha	= CTOD('01-01-1900')
					       	ELSE
					       		IF RECCOUNT("CsrCateCtacte")>0 
							   IF TTOD(CsrCateCtacte.fechabonif) >= TTOD(CsrAuxCabefac.fecha)
							      Oscatter.despor = lnbonifica + CsrCateCtacte.bonif1
							      Oscatter.oferfecha = CsrCateCtacte.fechabonif
							   ENDIF    
							ENDIF 
						ENDIF
					ENDIF  
				ENDIF 
			ENDIF 
			
		
		   	SELECT  CsrAuxCuerFac
			GO lnrecno 	    
			
			IF lok			
				IF Oscatter.prearti=0 AND Oscatter.preunita#0
					IF Csrplanpago.tasa#0
						Oscatter.preunita = Red( ((Oscatter.preunita-Oscatter.interno)*(Csrplanpago.tasa/100)+Oscatter.interno),lndecimaluni)
					ENDIF      
				ENDIF 
		
				lncantidad     = Oscatter.cantidad
				IF lncantidad  < 0 AND thisform.tipoform$'NF'
					Oscatter.escambio = 1
					Oscatter.cantidad = ABS(Oscatter.cantidad)
					Oscatter.preunita = 0
					
				ENDIF
				lncantidad  = Oscatter.cantidad	
				lnunibulto	= IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
				lnpesable 	= Oscatter.pesable
				lnuniventa  = Oscatter.univenta
				lnunibulto  = IIF(lnuniventa=1,1,lnunibulto)
				lnkilos		= IIF(lnpesable=0,0,Oscatter.cantkilos)
				lnbonifica = Oscatter.despor &&Para que pase la bonif a las unificaciones
				IF lnpesable=0
					lnCantFinal    = lncantidad * lnunibulto
				ELSE
					lnCantKilosFinal = lnkilos
					lnCantFinal = lncantidad
				ENDIF 
				*stop()
				
				.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
		
				
				Oscatter.total = Red((IIF(this.incluyeiva,Oscatter.UniCiva,Oscatter.UniSiva) + Oscatter.internofin ),lndecimaltot)	
				Oscatter.idprodpromo   = .loObjBonifica.idprodpromo
				Oscatter.idprodregalo  = .loObjBonifica.idprodregalo
				Oscatter.cada          = .loObjBonifica.cada
				Oscatter.entrega       = .loObjBonifica.entrega
				Oscatter.idcabeunifica = .loObjBonifica.idcabeunifica
				Oscatter.idprodcombo   = .loObjBonifica.idcombo
				
				IF Oscatter.esCambio = 1
					Oscatter.Boniciva  = 0
		   			Oscatter.Bonisiva  = 0	
		   			Oscatter.totalciva = 0
		   			Oscatter.totalsiva = 0
		   			Oscatter.total	=0
		   		ENDIF 
		   		
				SELECT CsrAuxCuerfac	
				GO lnRecno	
				GATHER NAME Oscatter
				
				IF Oscatter.idcabeunifica#0
					SELECT CsrAuxCuerfac
					GO top
					SCAN FOR !EOF()
						IF idcabeunifica = Oscatter.idcabeunifica
						* recalculo el nuevo descuento
							SCATTER NAME Oscatter
							lncantidad	= Oscatter.cantidad
							lnunibulto	= IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
							lnpesable 	= Oscatter.pesable
							lnuniventa  = Oscatter.univenta
							lnunibulto  = IIF(lnuniventa=1,1,lnunibulto)
							lnkilos		= IIF(lnpesable=0,0,Oscatter.cantkilos)
							IF lnpesable=0
								lnCantFinal    = lncantidad * lnunibulto
							ELSE
								lnCantKilosFinal = lnkilos
								lnCantFinal = lncantidad
							ENDIF 
							Oscatter.despor = lnbonifica
							
							.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto)
		
							Oscatter.total = Red((IIF(this.incluyeiva,Oscatter.UniCiva,Oscatter.UniSiva) + Oscatter.internofin),lndecimaltot)		    
							GATHER NAME Oscatter
						ENDIF 			      
					ENDSCAN
					GO lnrecno 
				ENDIF		
			ENDIF 
		ENDWITH
		
		RETURN lok
	ENDPROC

	PROCEDURE grid2_lostfocuscant
		WITH thisform  
			lcSetfocus = .lcsetfocus
			lcGotfocus = .lcgotfocus
			IF .grid2.column3.Enabled 
				IF !.grid2_control(lcSetFocus,lcGotFocus)
				   .grid2.column5.text1.SetFocus()
				   RETURN .f.
				ENDIF 
				this.controlpromocion()
			ENDIF 
		ENDWITH
		
	ENDPROC

	PROCEDURE grid2_lostfocusdto		&& Lostfocus Descuento Grid2
		WITH thisform 
			lcSetfocus = .lcsetfocus
			lcGotfocus = .lcgotfocus
			*stop()
			IF .grid2.column6.Enabled OR .grid2.column11.Enabled OR .grid2.column12.Enabled 
				
				IF !strzero(thisform.lnkeycode,3)$"003-005-018-024" &&AND NOT thisform.consultandocomprobante
					llok = .grid2_control(lcSetFocus,lcGotfocus)
					IF !llok
						.grid2.column1.text1.SetFocus
					ELSE 	
						this.controlpromocion()
						IF !thisform.lpidodescto AND !thisform.lpidodescuento
							.grid2_procesolinea(13)
						ELSE 
							IF !this.verdto2 AND !this.verdto3
								.grid2_procesolinea(13)
								.lpidodescto=.f.
							ELSE
								IF 'GRID2.COLUMN11'$.lcgotfocus
									*stop()
								ENDIF 
								IF 'GRID2.COLUMN11'$.lcgotfocus AND !this.verdto3
									.grid2_procesolinea(13)
									.lpidodescto=.f.
								ELSE
									IF 'GRID2.COLUMN12'$.lcgotfocus AND this.verdto3
										.grid2_procesolinea(13)
										.lpidodescto=.f.
									ENDIF 
								ENDIF 	
							ENDIF 
						ENDIF 				
					ENDIF
				ENDIF 			
			ENDIF 
		ENDWITH 	
		
	ENDPROC

	PROCEDURE grid2_lostfocusimp
		WITH thisform 
			lcSetfocus = .lcsetfocus
			lcGotfocus = .lcgotfocus
			.grid2.column4.inputMask = Thisform.precio_inputmask
			
			IF .grid2.column4.Enabled 
				IF !.grid2_control(lcSetFocus,lcGotfocus)
					.grid2.column4.text1.SetFocus
				ENDIF 
				this.controlpromocion()
			ENDIF 
		ENDWITH 	
		
	ENDPROC

	PROCEDURE grid2_lostfocuskilos
		WITH thisform  
			lcSetfocus = .lcsetfocus
			lcGotfocus = .lcgotfocus
			IF .grid2.column3.Enabled 
				IF !.grid2_control(lcSetFocus,lcGotFocus)
				   RETURN .f.
				ENDIF 
				this.controlpromocion()
			ENDIF 
		ENDWITH
		
	ENDPROC

	PROCEDURE grid2_ponerlineaencero
		DELETE FOR idarticulo = CsrAuxCuerfac.idarticulo AND registro=CsrAuxCuerfac.registro IN CsrAuxCuerVari	
		REPLACE idarticulo WITH 0,codigo WITH "",nombre WITH "",unibulto WITH 0,precosto WITH 0,precostosiva WITH 0,interno WITH 0,idctavta WITH 0;
		,tasaiva WITH 0,idfuerzavta WITH 0,alcohol WITH " ",kilos WITH 0,volumen WITH 0,perceibruto WITH 0,univenta WITH 0,preunitasiva WITH 0,prearti WITH 0,preartisiva WITH 0, cantkilos WITH 0 IN CsrAuxCuerFac
		replace perceiva5329 WITH 0 IN CsrAuxCuerfac
		
		thisform.grid2.column4.text1.value=0
		thisform.grid2.column5.text1.value=0        
		thisform.grid2.column6.text1.value=0
		thisform.grid2.column7.text1.value=0
		thisform.grid2.Refresh
		
	ENDPROC

	PROCEDURE grid2_procesolinea		&& Vuelca CsrAuxCuerCbio (linea editada) en Csrauxcuerfac (productos seleccionados)
		PARAMETERS lnKeyCode
		
		LOCAL lok,OScatter,lcCtrlSource,lcalias,AcolOdataNavega,lcnombre
		STORE '' TO lcCtrlSource,AcolOdataNavega
		lcAlias = "CsrAuxCuerfac"
		lok = IIF(lnKeyCode = 27,.f.,.t.)
		
		IF lok
			thisform.hacerfocoen  = ''
			
			IF thisform.consultandocomprobante
				thisform.grid2.column1.text1.SetFocus()
				thisform.grid2.column1.text1.Click()
				
				KEYBOARD '{DNARROW}'
				RETURN .t.
			ENDIF 
			
			* ingreso la linea de promocion
		    IF RECCOUNT("CsrAuxCuerPromo")#0
		    	IF !this.leyendocuerpedido
				    SELECT CsrAuxCuerPromo
				    SCATTER NAME OScatter
		
					_screen.LockScreen = .t.
				    thisform.bindergridoff('thisform.grid2',@lcalias,@lcCtrlSource,@AcolOdataNavega)
				    
					SELECT CsrAuxCuerFac
					LOCATE FOR idarticulo=oscatter.idarticulo
					IF FOUND()
					   delete
					endif
					LOCATE FOR idprodgenera=OScatter.idprodgenera AND espromocion=1
					IF EOF() OR idprodgenera#OScatter.idprodgenera OR espromocion#1
						GO BOTTOM 
						IF idarticulo#0 OR LEN(TRIM(nombre))#0
			 			   thisform.agregarcuerfac()
						   thisform.totcuerfac = thisform.totcuerfac + 1
					    ENDIF   
						Oscatter.registro   = RECNO()
					ENDIF 
				    GATHER NAME Oscatter
			  	    thisform.agregarcuerfac()
				    thisform.totcuerfac = thisform.totcuerfac + 1	    
				    thisform.grid2.coLUMN3.combo1.RowSource = "UNIDAD,1,BULTO,2"
				    *thisform.grid2.column3.combo1.Enabled=.f.
			    	thisform.bindergridon('thisform.grid2',lcalias,lcCtrlSource,AcolOdataNavega)
					_screen.LockScreen = .f.
				ENDIF 
			ENDIF 
		
			* ingreso el cuerpo del combo
		    IF RECCOUNT("CsrAuxCuerCombo")#0
		    	IF !this.leyendocuerpedido
		    		
				    SELECT CsrAuxCuerCombo
				    GO TOP 	    
				    *vista()
				   * stop()	
				   
				    DO while NOT EOF() 
					    SCATTER NAME OScatter
		
						_screen.LockScreen = .t.
					    thisform.bindergridoff('thisform.grid2',@lcalias,@lcCtrlSource,@AcolOdataNavega)
					    
						SELECT CsrAuxCuerFac
						&&Borro los articulos que generan el combo
						LOCATE FOR idarticulo=oscatter.idarticulo AND escombo=1 AND idprodgenera=OScatter.idprodgenera AND despor = Oscatter.despor
						IF FOUND()
							SELECT CsrAuxCuerVari
							DELETE FROM CsrAuxCuerVari WHERE registro = CsrAuxCuerfac.registro
							
							SELECT CsrauxCuerfac
						   	DELETE 
						ENDIF
						&&Volvemos a controlar devuelta
						LOCATE FOR idarticulo=oscatter.idarticulo AND idprodgenera=OScatter.idprodgenera AND escombo=1 AND despor = Oscatter.despor
						IF EOF() OR not(idarticulo=oscatter.idarticulo AND idprodgenera=OScatter.idprodgenera AND escombo=1 AND despor = Oscatter.despor)
							GO BOTTOM 
							IF idarticulo#0 OR LEN(TRIM(nombre))#0
				 			   thisform.agregarcuerfac()
							   thisform.totcuerfac = thisform.totcuerfac + 1
							   
							   SELECT CsrAuxCuerfac 
						    ENDIF   
							Oscatter.registro   = RECNO()
											   
						ENDIF
					    GATHER NAME Oscatter
					    
				    	&&Si tiene variedad. Debemos agregarla
					   	IF Oscatter.idsubprod#0
					   		SELECT CsrAuxCuerCombo
					   		lnCantidad = 0
					   		DO while NOT EOF() AND idarticulo = OScatter.idarticulo
								SELECT CsrAuxCuerVari
								APPEND BLANK 
					  	   		REPLACE idsubarti WITH CsrAuxCuerCombo.idsubprod,idarticulo WITH Oscatter.idarticulo;
					  	   			,idvariedad WITH CsrAuxCuerCombo.idvariedad;
					  	   		   ,cantidad WITH CsrAuxCuerCombo.cantidad,kilos WITH 0,volumen WITH 0;
					  	   		   ,registro WITH Oscatter.registro,escambio WITH 0 
					  	   		   
					  	   		   lnCantidad = lnCantidad + CsrAuxCuerVari.cantidad
					  	   		SELECT CsrAuxCuerCombo
					  	   		SKIP 
					  	   	ENDDO  	
					  	   	IF NOT EOF()
					  	   		SKIP -1 &&Volvemos al registro anterior
					  	   	ENDIF    		
							replace cantidad WITH lnCantidad IN CsrAuxCuerfac
					   	ENDIF
					   	
						SELECT CsrAuxCuerfac
						SCATTER NAME Oscatter
						thisform.grid2_calculoprecio(@Oscatter)
						
						GATHER NAME Oscatter
						   	
				  	    thisform.agregarcuerfac() &&Linea en Blanco para el proximo
				  	    
					    thisform.totcuerfac = thisform.totcuerfac + 1	    
					    thisform.grid2.coLUMN3.combo1.RowSource = "UNIDAD,1,BULTO,2"
					    *thisform.grid2.column3.combo1.Enabled=.f.
				    	thisform.bindergridon('thisform.grid2',lcalias,lcCtrlSource,AcolOdataNavega)
						_screen.LockScreen = .f.
						
						SELECT CsrAuxCuerCombo
						SKIP 
					ENDDO  
				ENDIF 
			ENDIF 
		    thisform.totalcomprobante()
		ENDIF
		
		SET SAFETY OFF 
		SELECT CsrAuxCuerPromo   && borro el registro promociones 
		ZAP
		SELECT CsrAuxCuerCombo
		ZAP 
		SET SAFETY ON
		
		
		
		cleartec()
		
		IF lok 
			IF !this.leyendocuerpedido
				thisform.generarlinea()   
			ENDIF 
		ELSE
			thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
			thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.Click()   
		ENDIF    
		
	ENDPROC

	PROCEDURE gridvariedad_when		&& agregado para leon. cuando se elige el articulo y tiene variedad, antes de poner cantidad, listamos variedades
		WITH thisform
			LOCAL llok
			llok = .t.
			IF .lhayvariedad AND .lpidocantidad   &&this.Value = 0
			
				IF this.nCantDigitada <> 0 AND RECCOUNT('CsrSubProducto')=1
					.key_grid1(0, 0)  
				ELSE 	
					llok = .f.
					.ultimocontainer = "CONTAINERVARIEDAD"
					.lblayudapie.Caption = "[ + ]Cierra     [Arriba/Abajo]Elije variedad  [ * ]Digita Descto"
					.containervariedad.Visible = .t.
					.containervariedad.grid1.Visible = .t.
					.containervariedad.grid1.column1.text1.readonly = .f.
					.containervariedad.grid1.column2.text1.readonly = .f.
					.containervariedad.Refresh
					.containervariedad.grid1.column2.text1.SetFocus
				ENDIF
			ENDIF 
			*agregado 21/10/10
			*Si estamos consultando el CsrauxCuervari ya esta cargado
			*Asi que cargamos en el subproducto(grilla variedad)
			*los datos que trajimos el cuervari
			IF .consultandocomprobante AND .lHayvariedad
				llok = .f.
				.containervariedad.grid1.recordsource = ""
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT Csrsubproducto.*,000000.000 as cantidad,000000.000 as kilos,000000.000 as volumen 
				FROM subProducto as Csrsubproducto
				where Csrsubproducto.idarticulo = 0 and nofactura=0 and estado=0
				ENDTEXT 
		
				IF !.obtenerdatos('Csrsubproducto',lccmd)
			   		.Release 
				ENDIF    
				
				SELECT CsrAuxCuervari
				GO top
				SET ORDER TO idarticulo
				SEEK CsrAuxCuerfac.idarticulo
				IF FOUND()
					SCAN FOR idarticulo = CsrAuxCuerfac.idarticulo AND registro=CsrAuxCuerfac.registro
						IF idarticulo#CsrAuxCuerfac.idarticulo OR registro#CsrAuxCuerfac.registro
							LOOP 
						ENDIF 
						SELECT CsrSubProducto
						APPEND BLANK
						SCATTER NAME OscSubProd
						OscSubProd.idarticulo	= CsrAuxCuervari.idarticulo
						OscSubProd.id		  	= CsrAuxCuervari.idsubarti
						OscSubProd.cantidad		= CsrAuxCuervari.cantidad
						OscSubProd.nombre		= CsrAuxCuervari.nombre
						GATHER NAME OscSubProd
						SELECT CsrAuxCuervari
					ENDSCAN 
				ELSE 
					RETURN .t.
				ENDIF 
				SELECT CsrSubPRoducto
				GO TOP 
				
				.containervariedad.grid1.recordsource = 'CsrSubProducto'
				.containervariedad.grid1.column1.controlsource = 'CsrSubProducto.nombre'
				.containervariedad.grid1.column2.controlsource = 'CsrSubProducto.cantidad'
				.containervariedad.grid1.column1.text1.readonly = .t.
				.containervariedad.grid1.column2.text1.readonly = .t.
				
				IF .lhayvariedad
					.ultimocontainer = "CONTAINERVARIEDAD"
					.lblayudapie.Caption = "[ + ]Cierra     [Arriba/Abajo]Elije variedad"
					.containervariedad.Visible = .t.
					.containervariedad.grid1.Visible = .t.
					.containervariedad.Refresh
					.containervariedad.grid1.column2.text1.SetFocus
				ENDIF 
			ENDIF 
		ENDWITH 
		RETURN llok
	ENDPROC

	PROCEDURE guardarentorno
		WITH Thisform
		oEntorno = CREATEOBJECT('custom')
		oEntorno.AddProperty('Height',.Height)
		oEntorno.AddProperty('Image1_H',.Image1.Height)
		oEntorno.AddProperty('AyudaPie_T',.lblayudapie.Top)
		oEntorno.AddProperty('Boton_T',.CmdSalvar.Top )
		oEntorno.AddProperty('EditO_V',._EditObserva.Visible)
		oEntorno.AddProperty('EditO_H',._EditObserva.Height)
		oEntorno.AddProperty('EditO_T',._EditObserva.Top)
		ENDWITH 
	ENDPROC

	PROCEDURE importarpedidos		&& metodo donde se arma el pedido
		LOCAL Lcsep,lcarchivo,lccodigo,lcCmd,Oscatter,OscatterCab,lok,lnvendedor
		
		thisform.importandopedidos=.t.
		
		LOCAL cArchivo
		
		cleartec()
		
		SET SAFETY OFF 
		SELECT CsrauxCuerfac
		ZAP
		SELECT CsrAuxCuerVari
		ZAP
		SELECT CsrAuxCuerPromo
		ZAP
		SELECT CsrAuxPediPda
		ZAP 
		SET SAFETY ON
		
		This.oPreventaMobile.CrearCursores()
								
		SELECT Csropcion
		IF estado=1
			*this.leyendocuerpedido = .t. &&Solo para debug
			nRecno = RECNO()
			DO WHILE NOT EOF() AND estado=1
				SKIP 
			ENDDO
			IF EOF()
				GO TOP 
				DO WHILE NOT !EOF() AND estado=1 AND RECNO()<nRecno
					SKIP 
				ENDDO
				IF EOF() OR RECNO()=nRecno
					&&Sino hay mas archivos, cancelamos el proceso
					this.importandopedidos = .f.
					RETURN .F.
				ENDIF 
			ENDIF 
		ENDIF 
		
		cArchivo	= UPPER(Csropcion.archivo)
		nIdPedido	= CsrOpcion.idpedido
		
		This.oPreventaMobile.LeerEncabezado(cArchivo,nIdPedido)
		
		SELECT CsrAuxPediPda
		APPEND BLANK
		SCATTER NAME OscPediPda
		
		OscPediPda.idpedido = CabePedido.id
		nVendedor			= CabePedido.vendedor_codigo 
		ThisForm.Containeringreso.Kitbuscaoaltaenvendedor.Txtexiste1.Value=nVendedor
		ThisForm.Containeringreso.Kitbuscaoaltaenvendedor.Txtexiste1.lostfocus()
		
		&&El pedido trae como se factura, se lo adjuntamos en las observaciones
		ThisForm._EditObserva.Value = IIF(CabePedido.remito=1,"REMITO POR VDOR - ","")+ALLTRIM(CabePedido.observaciones) &&Se adjuntara luego un mensaje si las bonificaciones vienen del pedido
		&&Agregamos a las observaciones los % de bonifcacion de cada producto que viene en el archivo
		cMensajeBonif = ""
		nVale 	= IIF(CabePedido.vales=1,9,0)
		nRemito = IIF(CabePedido.remito=1,2,0) &&el pedido trae como se factura.
		
		nCtacte	= CabePedido.clientes_numero
		TEXT TO lcCmdCtaCte TEXTMERGE NOSHOW 
		Select CsrCtacte.* from Ctacte as CsrCtacte where cnumero = <<nCtacte>>
		ENDTEXT 
		IF !thisform.obtenerdatos('CsrCtacte',lcCmdctaCte)
			thisform.Release
		ENDIF 
		
		ThisForm.Containerencabeza.KitbuscaoaltaenCtacte.Txtexiste1.Value=CsrCtacte.cnumero
		ThisForm.Containerencabeza.KitbuscaoaltaenCtacte.txtid.Value = CsrCtacte.id
		ThisForm.Containerencabeza.KitbuscaoaltaenCtacte.txtNombre.Value = CsrCtacte.cnombre
		ThisForm.Containerencabeza.KitbuscaoaltaenCtacte.lostfocosay()
		
		tFecha		= CTOT(DTOC(TTOD(CabePedido.fecha))+" "+CabePedido.horain)
		cFecha		= TtoS(tFecha)
		
		nEstado = 0
		IF NOT This.oPreventaMobile.EstadoPedido(nCtacte,nIDPedido)
			nEstado = 1 &&Duplicado por decision del operador
		ENDIF 
		
		OscPediPda.fecha = tFecha
		OscPediPda.idctacte = CsrAuxCabefac.idctacte
		OscPediPda.idvendedor = CsrAuxMaopera.idvendedor
		OscPediPda.idmotivo = 0 &&SIN MOTIVO DE RECHAZO.
		OscPediPda.pedidoid_pm = CabePedido.pedidoid_pm
		OscPediPda.origen	= "ANDRO"
		*OscPediPda.estado = nEstado
		
		
		SELECT CsrAuxPediPda
		GATHER NAME OscPediPda
		
		lndecimaluni = thisform.ndecimaluni
		lndecimaltot = thisform.ndecimaltot
		lok          = .f.
		
		*???????????????
		WITH thisform
			.lntotalri = 0
			.lntotalnc = 0
			.lnperceib1 = 0
			.tasaperib1 =0
			.tasaperib2 =0
		ENDWITH
		
		this.leyendocuerpedido = .t.
		
		SELECT CsrauxCabefac
		SCATTER NAME Oscattercab
		
		nParada =  (3*100+nVale*10)*10+nRemito
		
		ThisForm.Containerencabeza._txtparada.Value =nParada &&CsrAuxCabefac.parada
		thisform.lnkeycode = 13
		**&&''
		ThisForm.Containerencabeza._txtparada.LostFocus()
		
		
		SELECT CsrauxCuerfac
		SCATTER NAME Oscatter
		
		**&&''
		This.oPreventaMobile.LeerCuerpos(cArchivo)
		
		thisform.containerencabeza._cbocomprobante.Value = CsrComprobante.id
		thisform.containerencabeza._cbocomprobante.SetFocus()
		ThisForm.Containerencabeza.KitbuscaoaltaenCtacte.txtExiste1.SetFocus()
		
		&&Buscamos la lista de articulos y sus sabores
		cArticulo = ""
		
		_Screen.LockScreen = .t.
		
		SELECT CuePedido
		COUNT FOR idcabpedido = CabePedido.id TO nCantProd
		GO TOP 
		SCAN 
			IF idcabpedido = CabePedido.id
				cArticulo = LTRIM(cArticulo)+IIF(LEN(LTRIM(cArticulo))#0,",","")+strtrim(CuePedido.articulo_numero)
			ENDIF 
		ENDSCAN 
		
		IF LENtrim(cArticulo)=0
			_Screen.LockScreen = .f.
			RETURN .f.
		ENDIF 
		
		TEXT TO lcCmdProd TEXTMERGE NOSHOW 
		SELECT Csrproducto.*,ISNULL(Tipoiva.tasa,0) as tasa,ISNULL(rubro.idfuerzavta,0) as idfuerzavta
		,isnull(left(tipoprod.switch,1),'0') as alcohol,ISNULL(rubro.perceibruto,0) as perceibruto 
		,isnull(rubro.omitirlistas,0) as omitirlistas 
		FROM Producto as Csrproducto 
		LEFT JOIN Tipoiva on Csrproducto.idiva = Tipoiva.id 
		LEFT JOIN rubro on Csrproducto.idrubro = rubro.id 
		LEFT JOIN tipoprod on rubro.idtipoprod = tipoprod.id 
		where Csrproducto.numero in (<<cArticulo>>)
		ENDTEXT 
		IF !thisform.obtenerdatos('CsrProducto',lcCmdProd)
			thisform.Release
		ENDIF 
		
		SELECT CsrProducto
		IF RECCOUNT('CsrProducto')=0
			RETURN
		ENDIF 
		
		
		SELECT CuePedido
		GO TOP 
		SCAN FOR !EOF()
			WITH thisform
				IF CuePedido.idcabpedido <> CabePedido.id
					LOOP 
				ENDIF 
		
				nArticulo	= CuePedido.articulo_numero
				
				nBonidig	= IIF(CuePedido.Bonif1<>0,1,0) 
				nDesc		= CuePedido.Bonif1
				
				SELECT CsrProducto
				LOCATE FOR numero = nArticulo
				IF ! numero = nArticulo
					LOOP 
				ENDIF 
				
				SELECT CsrAuxCuerfac
				cClave = strzero(CsrProducto.id,10)+strzero(nDesc,5,2)
				IF !SEEK(cClave,"CsrAuxCuerfac","kclave")			
					.agregarcuerfac()
					replace codigo WITH strtrim(CsrProducto.numero,8) IN CsrAuxCuerfac
					.codigoanterior = strtrim(CsrProducto.numero,8)
					.kitbuscarProd.f_lostfocussay()
					&&Esto carga CsrSubProducto, que es el cursor que se muestra en la grilla
					&&Debemos recorrerlo
					SELECT CsrAuxCuerfac
					nUniventaprod	= CsrAuxCuerfac.univenta
					nUnibultoprod	= CsrAuxCuerfac.unibulto
					
					SCATTER NAME Oscatter ADDITIVE 
					Oscatter.clavepedido	= cClave
					Oscatter.univenta		= 1
					Oscatter.cantidad		= 0
					Oscatter.bondigitada	= nBonidig
					Oscatter.despor			= nDesc
					
					*En el PM butlos=1 y unidades = 0
					Oscatter.univenta	= IIF(cuepedido.univta > 1,1,cuepedido.univta) + 1	
					*Si se factura bulto y el pedido es unidades, se transforma a bulto
					Oscatter.univenta	= IIF(Oscatter.univenta <> nUniventaprod and nUniventaprod=2,2,Oscatter.univenta)
					*Si el prod se factura en bultos y la uni.x.bult es 1, el pedido los transforma a unid. Hay que revertirlo
					IF nuniventaprod = 2 AND nunibultoprod= 1 &&Bultos y UnixBulto = 1
						IF Oscatter.univenta = 1 &&El pedido dice unidades
							Oscatter.univenta = nuniventaprod
						ENDIF 
					ENDIF 
					
					&&Guardamos para mostrar el codigo con su bonifiacion
					IF Oscatter.despor!=0 
						cMensajeBonif = cMensajeBonif + IIF(LEN(LTRIM(cMensajeBonif))=0,"","; ")+ "Código "+ALLTRIM(Oscatter.codigo)+" ["+strtrim(Oscatter.despor,6,2)+" %]"
					ENDIF 
					
					GATHER NAME Oscatter
				ENDIF
				 
				SCATTER NAME OscCuerfac ADDITIVE 
				nCantidad	= cuepedido.cantidad
				nCodigo		= cuepedido.articulo_numero
				
				IF nCantidad#0
					SELECT CuePedidoVari
					LOCATE FOR idcuepedido = CuePedido.id
					IF idcuepedido = CuePedido.id
						DO WHILE idcuepedido = CuePedido.id AND NOT EOF()
						
							SELECT CsrSubProducto
							LOCATE FOR idarticulo = CsrProducto.id AND subnumero = CuePedidoVari.variedad_codigo
							IF idarticulo = CsrProducto.id AND subnumero = CuePedidoVari.variedad_codigo
								
								SCATTER NAME OscatterVari	
								OscatterVari.cantidad = CuePedidoVari.cantidad
								GATHER NAME OscatterVari		
								
								SELECT CsrAuxCuerVari
								LOCATE FOR idarticulo = CsrProducto.id AND idsubarti = OscatterVari.id AND registro=OscCuerfac.registro
								IF !(idarticulo = CsrProducto.id AND idsubarti = OscatterVari.id AND registro=OscCuerfac.registro) 
								   APPEND BLANK 
							  	   REPLACE idsubarti WITH OscatterVari.id,idarticulo WITH OscatterVari.idarticulo,idvariedad WITH OscatterVari.idvariedad;
							  	   		   ,nombre WITH OscatterVari.nombre,cantidad WITH OscatterVari.cantidad,kilos WITH OscatterVari.kilos,volumen WITH OscatterVari.volumen;
							  	   		   ,registro WITH OscCuerfac.registro
							  	   		   
							  	   replace cantidad WITH cantidad + CuePedidoVari.cantidad IN CsrAuxCuerfac
							  	ELSE 
							  	   IF !EOF()
							  	   		nCantidad = CsrAuxCuervari.cantidad &&Cantidad anterior
							  	   		replace cantidad WITH cantidad - CuePedidoVari.cantidad IN CsrAuxCuerfac &&Le sacamos las cantidades al cuerpo
									  	REPLACE cantidad WITH OscatterVari.cantidad,kilos WITH OscatterVari.kilos,volumen WITH OscatterVari.volumen IN CsrAuxCuervari
									  	replace cantidad WITH cantidad + CuePedidoVari.cantidad IN CsrAuxCuerfac
							  	   ENDIF    
								ENDIF
							ENDIF  	
							
							SELECT CuePedidoVari
							SKIP 
						ENDDO 
					ELSE
						replace cantidad WITH cantidad + nCantidad IN CsrAuxCuerfac
					ENDIF  	
				ENDIF 
				
				
			ENDWITH 
		ENDSCAN
		
		SELECT CsrAuxCuerfac
		GO TOP 
		SCAN 
			WITH thisform	
				SELECT CsrProducto
				LOCATE FOR id = CsrauxCuerfac.idarticulo
						
				* existencia
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT Csrexistenc.* from existenc as Csrexistenc
				where Csrexistenc.idarticulo = <<CsrProducto.id>> and Csrexistenc.iddeposito=<<thisform.lniddeposito>>
				ENDTEXT 
		
				IF !.obtenerdatos('CsrExistenc',lccmd)
					.release
				ENDIF 
				
				SET SAFETY OFF 
				SELECT CsrAuxCuerPromo
				ZAP 
				SET SAFETY ON 
				
				.lcsetfocus            = "THISFORM.GRID2.COLUMN6.TEXT1"
				.lcgotfocus            = "THISFORM.GRID2.COLUMN5.TEXT1"
				SELECT CsrAuxCuerfac
				nRecno = RECNO()
				IF .grid2_lostfocuscant()
					DO case 
					CASE .loObjBonifica.cada#0 AND .loObjBonifica.entrega#0 AND .loObjBonifica.bonpromo=0	
						SELECT CsrAuxCuerFac
					   	SCATTER NAME Oscatter			   	
				        	.cargarpromocion(Oscatter)
					CASE (.loObjBonifica.cada=0 OR .loObjBonifica.entrega=0) AND .loObjBonifica.bonpromo#0	   	     
					CASE .loObjBonifica.cada#0 AND .loObjBonifica.entrega#0 AND .loObjBonifica.bonpromo#0
						nok = 0
						DO WHILE nok != 6
							.containerpromoboni.chkpromocion.Value=1
							.containerpromoboni.CHkbonifica.Value = 1
							nok = oavisar.usuario("El Producto "+RTRIM(CsrAuxCuerfac.nombre)+" contiene PROMOCIÓN y BONIFICACIÓN"+CHR(13)+;
													"Desea seleccionar ambas (SI)"+CHR(13)+;
													"Caso contrario podria elegir de forma individual (NO)"+CHR(13)+;
													"Cual es la acción elegida?",36+256)
							IF nok != 6
								.containerpromoboni.chkpromocion.Value=0
								.containerpromoboni.CHkbonifica.Value = 0
								nok = oavisar.usuario("El Producto "+RTRIM(CsrAuxCuerfac.nombre)+" contiene PROMOCIÓN"+CHR(13)+;
													"Desea cargarla?",36)
								IF nok = 6
									.containerpromoboni.chkpromocion.Value= 1
								ENDIF 
								nok = oavisar.usuario("El Producto "+RTRIM(CsrAuxCuerfac.nombre)+" contiene BONIFICACIÓN"+CHR(13)+;
													"Desea cargarla?",36)
								IF nok = 6
									.containerpromoboni.chkbonifica.Value= 1
								ENDIF 
							ENDIF 	
							IF .containerpromoboni.chkpromocion.Value=0 AND .containerpromoboni.CHkbonifica.Value = 0
								= oavisar.usuario("El Producto "+RTRIM(CsrAuxCuerfac.nombre)+" contiene PROMOCIÓN y BONIFICACIÓN"+CHR(13)+;
													"Debe elegir una o ambas",0)
								nok = 0
							ENDIF 
						ENDDO 
						.containerpromoboni.lostfocus()
					ENDCASE	
				ENDIF 
				IF RECCOUNT('CsrAuxCuerPromo') != 0
					SELECT CsrAuxCuerPromo
					SCATTER NAME OScatter
				    	
					SELECT CsrAuxCuerFac
					LOCATE FOR idarticulo=oscatter.idarticulo
					IF FOUND()
						DELETE 
					ENDIF
					LOCATE FOR idprodgenera=OScatter.idprodgenera AND espromocion=1
					IF EOF() OR idprodgenera#OScatter.idprodgenera OR espromocion#1
						GO BOTTOM 
						IF idarticulo#0 OR LEN(TRIM(nombre))#0
							thisform.agregarcuerfac()
							thisform.totcuerfac = thisform.totcuerfac + 1
						ENDIF   	
						Oscatter.registro   = RECNO()
						Oscatter.idcabeunifica=0
						GATHER NAME Oscatter
					ELSE  
			 			GATHER NAME Oscatter
			 		ENDIF
				ENDIF 
				SELECT CsrAuxCuerfac
				GO nRecno
			ENDWITH 	
		ENDSCAN
		
		&&Marcos 2013/04/09 Agregamos a las observaciones los % de bonifcacion de cada producto que viene en el archivo
		IF LEN(LTRIM(cMensajeBonif))!=0
			ThisForm._EditObserva.Value = ThisForm._EditObserva.Value + CHR(13) + "BONIF DEL PEDIDO "+cMensajeBonif
		ENDIF 
		
		thisform.agregarcuerfac()
		thisform.grid2_procesolinea(13) &&Totalcomprobante
		this.leyendocuerpedido = .f.
		
		SELECT CsrAuxCuerfac
		GO TOP 
		
		_Screen.LockScreen = .f.
		* para que repinte el comprobante
		WITH thisform
			*.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.GotFocus
			.Refresh
		ENDWITH 
		
		RETURN .t.
		
		
		
	ENDPROC

	PROCEDURE imprimir		&& Determina el medio de impresion
		PARAMETERS nombreimpresora,tipoimpresora,tipoimpresion,lnvistapreliminar
		LOCAL _debogenerar
		
		
		** tipoimpresion 1=originak, 2= reimpresion
		_debogenerar=IIF(tipoimpresion=1,.t.,.f.)
		lnvistapreliminar = IIF(PCOUNT()<4,0,lnvistapreliminar)
		lnDeboActualizarNro = 0 &&IIF(CsrComprobante.clase$'0',1,0)
		
		lcTalonario = strzero(thisform.talonario,5)
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		select CsrCabeImp.* from CabeImpresion as CsrCabeImp WHERE talonarios like '%<<lcTalonario>>%'
		ENDTEXT 
		=CrearCursorAdapter('CsrCabeImp',lcCmd)
		IF RECCOUNT('CsrCabeImp')=0
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			select CsrCabeImp.* from CabeImpresion as CsrCabeImp WHERE sucursal = <<CsrAuxMaopera.sucursal>>
			ENDTEXT 
			=CrearCursorAdapter('CsrCabeImp',lcCmd)
		ENDIF 
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		select distinct impresora.*,csrmapeo.idmapeada,csrmapeo.idimpresora
		from seteotermi as CsrSeteoTermi
		left join mapeoimpresora as CsrMapeo on  CsrSeteotermi.id =  CsrMapeo.idterminal 
		left join impresora on csrmapeo.idimpresora = impresora.id
		where Csrseteotermi.numero = <<goapp.terminal>>
		ENDTEXT
		=SaveSQL(lcCmd,this.Name+"_impresora_mapeo")	
		=CrearCursorAdapter('CsrMapeoImp',lccmd)
		
		**''
		cOrigen = "FN"
		*stop()
		IF goapp.codempresa = 8 OR goapp.codempresa = 3 OR goapp.codempresa = 7
			&&Solo Mardones usamos el remito de logistica como licitacion
			cOrigen = IIF(CsrComprobante.clase$'8','LI',cOrigen)
		ENDIF 
		
		IF thisform.accion<>'C'
			replace ALL hojaactual WITH CsrAuxCabefac.hojaactual IN CsrAuxCuerfac
		ENDIF 
		
		THIS.OBJIMPRESOR.lrtoprecio = .t.
		IF  CsrComprobante.clase$"XH01" AND (goapp.codempresa = 7 OR goapp.codempresa = 2)
			lnok = oavisar.usuario("DESEA IMPRIMIR EL COMPROBANTE CON PRECIOS?",36)
			IF lnok = 7
				this.objIMPRESOR.lrtoprecio = .f.
			ENDIF 
		ENDIF 
			
		&&La impresion manual, genera varias hojas, pero no genera totales por hoja.
		&&Entonces la generamos aca y luego , le decimos que no vuelva a regenerar las hojas.
		IF (NOT this.oFacCAE.es_caea AND NOT this.oFacCAE.es_cae ) OR  NOT CsrComprobante.clase$"ABC"
			thisform.Objimpresor.generootroproceso = .t.
			
		*!*		
		*!*		IF _debogenerar AND this.lbGeneroHojaConTotal
		*!*			thisform.Objimpresor.generafactura("F",thisform.canlinea)
		*!*			thisform.Objimpresor.generootroproceso = .t.
		*!*			
		*!*			&&Retotalizamos por hoja.
		*!*			IF NOT thisform.totalporhoja()
		*!*				RETURN .f.
		*!*			ENDIF 
		*!*		ENDIF 
			IF CsrComprobante.clase$"8"
				IF goapp.codempresa = 14
					&&Debemos generar con codigo de barra ficticio
					This.oFacCAE.p_fecha = CTOD("01-12-2021") &&CsrAuxCabefac.fecha
					
					cCAEA =  "82179901086621" 			 
					replace cae WITH cCAEA,vtocae WITH GOMONTH(This.oFacCAE.p_fecha,4),caetipo WITH "CAI" IN CsrAuxCabefac
					nOrden = VAL(RIGHT(this.proximonro,12))
					dFecVto = DTOS(NVL(CsrAuxCabefac.vtocae,CTOD('01-01-1900')))
					cTipoCbte = "91"
					this.oFACCAE.p_orden = CsrAuxCabefac.idmaopera
					This.oFacCAE.p_codbarra = LEFT(NVL(CsrAuxCabefac.cae,'0'),14)+cTipoCbte+strzero(thisform.talonario,4)+dFecVto
					thisform.oFacCAE.fac_Generarcaebarra()
					
					ObjReporter.numcae = this.oFacCAE.p_filecodbarra
					replace caecheck WITH this.oFacCAE.p_codbarra IN CsrAuxCabefac
				ENDIF 
			ENDIF 
			
		ELSE
			**''
			IF CsrComprobante.clase$"ABC"
				cOrigen = "FE"
				LOCAL dFecVto,cTipoCbte,cCheckCAE
				IF this.oFacCAE.es_caea	
					This.oFacCAE.p_fecha = CsrAuxCabefac.fecha
					cCAEA = thisform.oFacCAE.fac_ConsultarCAEA_sql()
					replace cae WITH This.oFacCAE.p_cae,vtocae WITH This.oFacCAE.p_fecha IN CsrAuxCabefac
					nOrden = VAL(RIGHT(this.proximonro,12))
				ELSE
					*El cae y  fecha ya esta guardado en el cabefac
					*dFecVto = DTOS(NVL(CsrAuxCabefac.vtocae,CTOD('01-01-1900')))
					nOrden = CsrAuxCabefac.idmaopera
					*_debogenerar = .t. 
					&&El debogenerar me indica si debo actualizar el prefijonro, no reemplazo el numcomp
				ENDIF 
				dFecVto = DTOS(NVL(CsrAuxCabefac.vtocae,CTOD('01-01-1900')))
				cTipoCbte = NVL(CsrAuxCabefac.TipoCbte,'00')
				this.oFACCAE.p_orden = CsrAuxCabefac.idmaopera
				This.oFacCAE.p_codbarra = LEFT(NVL(CsrAuxCabefac.cae,'0'),14)+cTipoCbte+strzero(thisform.talonario,4)+dFecVto
				thisform.oFacCAE.fac_Generarcaebarra()
				
				ObjReporter.numcae = this.oFacCAE.p_filecodbarra
				replace caecheck WITH this.oFacCAE.p_codbarra IN CsrAuxCabefac
						
			ENDIF 
			
			thisform.Objimpresor.generootroproceso = .t.
		ENDIF 
		
		IF this.activoenvioemail
			thisform.objimpresor.salidaporpdf = .t.
		ENDIF 
		
		SELECT CsrAuxCuerVari
		*vista()
		
		lok = thisform.Objimpresor.inicioimpresora(cOrigen,nombreimpresora,tipoimpresora,thisform.formulario,_debogenerar,lnDeboActualizarNro,lnvistapreliminar)
		
		*!*	IF this.activoenvioemail AND lok
		*!*		this.enviocorreo(thisform.Objimpresor.rutadelarchivo)
		*!*	ENDIF 
		
		thisform.Objimpresor.generootroproceso = .f.
		this.activoenvioemail = .f.
		thisform.objimpresor.salidaporpdf = .f.
		
		RETURN lok
		
	ENDPROC

	PROCEDURE inicarparametros
	ENDPROC

	PROCEDURE iniciavariables		&& Seteo de variables, llamado por init del formulario
		LOCAL lnnroautomatido_def
		
		WITH thisform 
			.copiandocomprobante=.f.
			.containerencabeza.lblvale.Caption=''
			
			TEXT TO lccmd TEXTMERGE NOSHOW 
			Select Csrparaconfig.*,isnull(Csrlocalidad.idprovincia,0) as idprovincia
			,isnull(Csrdetanrocaja.idejercicio,cast(0 as int)) as idejerciciocaja
			,ISNULL(Csrdetanrocaja.nrocaja,0) as nrocaja
			,isnull(Csrdetanrocaja.fecdesde,'19000101') as fecdesde
			,isnull(Csrdetanrocaja.fechasta,'19000101') as fechasta
			,isnull(Csrdetanrocaja.pefiscal,0) as pefiscal,Csrcotizadolar.fechacoti as fechacoti,Csrcotizadolar.preciocpra as preciocpra
			,Csrcotizadolar.preciovta as preciovta
			,ISNULL(Csrdetanrocajafac.nrocaja,0) as nrocajafac
			 from paraconfig as Csrparaconfig 
			left join detanrocaja as Csrdetanrocaja on Csrparaconfig.iddetanrocaja = CsrDetanrocaja.id 
			left join Cotizadolar as Csrcotizadolar on Csrparaconfig.idcotizadolar = Csrcotizadolar.id   
			left join localidad as Csrlocalidad on Csrparaconfig.idlocalidad = Csrlocalidad.id
			left join detanrocaja as Csrdetanrocajafac on Csrparaconfig.iddetafac = CsrDetanrocajafac.id 	
			ENDTEXT 
			
			IF !.obtenerdatos('CsrParaConfig',lcCmd)
				.Release
			ENDIF 
			
			
			&&Si es facturacion manula, podemos ingresar facturas con otra fecha.
			IF .tipofactura$'EM'
				.buscarcajaactiva = .t.
				=LeerCajaActivaOtroEjercicio(thisform)
				&&EL ejercicio activo, da la caja, por ende da el ejerciciofac
				goapp.idejerciciofac = goapp.idejercicio
				replace nrocajafac WITH nrocaja,fechafac WITH fecdesde;
				,iddetafac WITH iddetanrocaja,idejerciciocaja WITH goapp.idejerciciofac IN CsrParaConfig
		
			ENDIF 
			&&Refrescamos la estructura
			.traerproductofuerzavta(-1)
			.traerproductosbloqueados()
		
			.actualizafac.lnquestock = .objseteoparam.def_lnquestock
			
			&&08/05/2012
			&&Guardamos el valor de si la numeracion debe ser automatica.
			&&Por lo general todos son 1, excepto el Manual que es 0. Siempre sin importar los parametros.
			&&Si alguna vez existe otro comprobante. Dejamos contemplado mantener su valor.
			lnnroautomatido_def = .lnnroautomatico
			.lnnroautomatico = IIF(.tipofactura $"EM",0,lnnroautomatido_def)
			
			.esvale='0'
		 	.bloqueocodigo = .f.
		 	.noCalculoIBTO = IIF(goapp.empresarete = 1,.f.,.t.)
			.permitemultilineas = .objseteoparam.def_MULTIARTICULOS
			.lpidoimporte = .f.
			.lpidodescuento = .f.
			.generandoloteremito = .f.
			 
			.cargarvalores()
			.leerparametrosconfig()
		
		    .leerseteoterminal()
		    .leerprefijoterminal(.lnidterminal)
		    .lnidvendedor = CsrVendedor.id
			*.cargarcomboptovta() &&SE comenta pq esto lo toma siempre al limpiar cursor. Y tenemos que iniciarlo la primera vez con el talonario por defecto
			.cargarfuerzavta()
			
		*!*		&&20/03/2014 Marcos Comentado pq no cambia el valor desde que entra en el init
		*!*		&&08/05/2012
		*!*		&&Volvemos el valor de THISFORM.lnnroautomatico
		*!*		.lnnroautomatico = IIF(.tipofactura ="M",0,lnnroautomatido_def)
			**'')
			thisform.grid2.Column4.ControlSource =  IIF(thisform.incluyeiva,"CsrAuxCuerfac.preunita","CsrAuxCuerfac.preunitasiva")
			
			&&Urquiza
			IF goapp.codempresa = 8 
				thisform.containerencabeza.kitbuscaoaltaenCtacte.bttn_nombreabm='abmctactepub'
			ENDIF 
			
			IF NOT this.tipoform$'N'
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT CsrConexionCentral.* FROM Conexion as CsrConexionCentral WHERE LEFT(switch,1)='1' AND servpedido = 1
				and sucursal = <<goapp.sucursal>>
				ENDTEXT 
				*IF !CrearCursorAdapter('CsrconexionCentral',lcCmd)
				IF NOT this.Obtenerdatos('CsrConexionCentral',lcCmd)
					=Oavisar.Usuario('Error al establecer conexion con la CENTRAL'+CHR(13)+'Se DESHABILITA la funcion de envio de datos')
					thisform.Release
				ENDIF 
				IF RECCOUNT('CsrConexionCentral')=0
					=Oavisar.Usuario('Error al establecer conexion con la CENTRAL'+CHR(13)+'Se DESHABILITA la funcion de envio de datos')
					thisform.Release
				ENDIF
			ENDIF 
			
			TEXT TO lcCmdArti TEXTMERGE NOSHOW 
			SELECT 0 as ok,t.*
			FROM (Select CsrProducto.numero as codigo,CsrProducto.nombre as NomArticulo,CsrProducto.id
			,CsrProducto.codartprod,CsrProducto.prevtaf1,CsrProducto.prevta1
			,CsrCtacte.cnombre as NomProveedor,CsrCtacte.id as idctacte
			,ISNULL(CsrMarca.nombre,SPACE(20)) as nommarca
			,ISNULL(CsrRubro.nombre,SPACE(20)) as nomrubro
			,convert(char(10),ISNULL(CsrProducto.fecmodi,getdate()),105) as fechamodif
			,CAST(0 as numeric(11,0)) as cantstock
			,CAST(0 as numeric(11,0)) as cantreserva
			,ISNULL((select SUM(existe) from Existenc as CsrExistenc where CsrProducto.id = CsrExistenc.idarticulo
			and CsrExistenc.iddeposito = <<CsrParaConfig.iddeposito>> ),CAST(0 as numeric(11,0))) as existe
			,ISNULL((select SUM(existedisp) from Existenc as CsrExistenc where CsrProducto.id = CsrExistenc.idarticulo
			and CsrExistenc.iddeposito = <<CsrParaConfig.iddeposito>> ),CAST(0 as numeric(11,0))) as existedisp
			From Producto as CsrProducto
			LEFT JOIN Ctacte as CsrCtacte on CsrProducto.idctacte = CsrCtacte.id
			LEFT JOIN Marca as CsrMarca on CsrProducto.idmarca = CsrMarca.id
			LEFT JOIN Rubro as CsrRubro on CsrProducto.idrubro = CsrRubro.id 
			WHERE CsrProducto.idestado=1 and CsrProducto.nofactura=0) as t 
			ORDER BY t.NomArticulo
			ENDTEXT
			=SaveSQL(lcCmd,this.Name+"_BuscarProd")
			IF NOT CrearCursorAdapter('CsrAuxBuscar',lcCmdArti)
				thisform.Release
			ENDIF 
			SELECT * FROM CsrAuxBuscar INTO CURSOR CsrBusProd READWRITE 
			replace ALL cantstock WITH existe, cantreserva WITH existe-existedisp IN CsrBusProd
			
			SET SAFETY OFF 
			SELECT CsrBusProd
			INDEX on nomarticulo TAG knombre
			INDEX on codigo TAG kcodigo
			SET SAFETY ON 
			
			SELECT CsrBusProd
			
			lcFechaPrecio = "(csrauxcuerfac.fechaultprecio+"+strtrim(thisform.preciodiasact)+")"
			THIS.Grid2.Setall("DynamicBackColor",;
				"iif(csrauxcuerfac.escambio=0,"+;
				"	IIF(csrauxcuerfac.cantidad=0 .and. csrauxcuerfac.idarticulo<>0,"+;
				"		RGB(254,254,234),"+;
				"		IIF(CsrAuxCuerfac.escombo=1"+;
				"			,RGB(0,128,255)"+;
				"			,IIF("+lcFechaPrecio+"< DATE()"+;
				"				,RGB(128,255,128)"+;
				"				,RGB(222,229,235)"+;
				"			))"+;
				"	)"+;
				"	,RGB(254,230,218))";
				,"Column")
		
			This.Grid2.Column11.Visible = .f. &&La oculto para verla en diseño
			This.Grid2.Column2.Width = This.nColumnNombreWidth
			IF This.VerDto2
				This.Grid2.Column11.Enabled = .t.
				This.Grid2.Column11.Visible = .t.
			ELSE
				This.Grid2.Column2.Width = This.Grid2.Column2.Width + This.Grid2.Column11.Width
			ENDIF 
			This.Grid2.Column12.Visible = .f.
			IF This.VerDto3
				This.Grid2.Column12.Enabled = .t.
				This.Grid2.Column12.Visible = .t.
			ELSE
				This.Grid2.Column2.Width = This.Grid2.Column2.Width + This.Grid2.Column12.Width
			ENDIF 
			
			IF goapp.codempresa = 20
				this.kitbuscarProd.prioridadcodalfa = .t.
			ENDIF 
			
		ENDWITH 
	ENDPROC

	PROCEDURE Init
		PARAMETERS lctipoform,lntipoPrefijo
		* F = facturacion normal, N notas de pedido, P Premios, M facturacion manula, S facturacion diferida
		* D  = factutacion diferida y manual
		* I = facturacion con iva.
		* R = modal desde recibo
		* C = factura desde camion / X= factura desde camion c/iva / Y = factura desde camion a CF
		* Z= factura desde camion, c/iva ,fiscales
		* B= factura normal, desde mostrador
		* 1 =el numero de comprobante es actualizado automaticamente, 0 el prefijo es manual
		
		PUBLIC oEntorno
		oEntorno = null
		cFileNameLog = RTRIM(this.Name)+DTOC(DATE())+'_'+strzero(HOUR(DATETIME()),2)+strzero(MINUTE(DATETIME()),2)+'.log'
		
		*thisform.tipoform='S'
		thisform.tipoform = IIF(PCOUNT()<1,"F",UPPER(lctipoform))
		thisform.lnnroautomatico = IIF(PCOUNT()<2,1,VAL(lntipoPrefijo))
		SET FUNCTION F10 TO CHR(255)   && asigno chr(255) 
		SET FUNCTION F7 TO CHR(254)   && asigno chr(255) 
		
		thisform.sesionactiva= thisform.datasessionid
		
		WITH thisform 
			*stop()
			IF .tipoform='R'
				.WindowType = 1
				.tipoform = 'F'
			ENDIF 
			IF .tipoform='D' && descargas
			   	.lbltituloform.Caption = .lbltituloform.Caption + " "+TRIM(thisform.lbltituloform.Caption)+"DIFERIDA"
			else	 
				.lbltituloform.Caption = IIF(.tipoform="N","GENERACIÓN PEDIDOS",'FACTURACIÓN DE VENTAS '+IIF(.tipoform="F","",IIF(.tipoform="P","PREMIOS",IIF(.tipoform="S","MERCADERIA DIFERIDA",iif(.tipoform="M","MERCADERIA MANUAL","")))))	      	 	 
			ENDIF
			
			
			This.GuardarEntorno()
			
		 	lObjeto = null
			.agregaobjeto.objgrabadato(@lObjeto)
			.AddProperty("objgrabadato",lObjeto)	 	
			lObjeto = NULL
			.agregaobjeto.objseteoparam(@lObjeto)
			.AddProperty("objseteoparam",lObjeto)
			lObjeto = null
			
			
			IF VARTYPE(.objseteoparam.def_lnquestock)='N'
				.objseteoparam.def_lnquestock = this.actualizafac.lnquestock
			ENDIF 
			IF VARTYPE(.objseteoparam.def_MULTIARTICULOS)='L'
				.permitemultilineas =  .objseteoparam.def_MULTIARTICULOS
			ENDIF 
		*!*		IF VARTYPE(.objseteoparam.def_CTRLEXISTENC)='L'
		*!*			.lpidoexistenc = .objseteoparam.DEF_CTRLEXISTENC
		*!*		ENDIF 
			IF VARTYPE(.objseteoparam.CtacteCFaRemito)$'X-U'
				.objseteoparam.AddProperty("CtacteCFaRemito",.f.)
			ENDIF 
			
			IF VARTYPE(.objseteoparam.Fac_CtrlVencimien)$'L'
				.Fac_CtrlVencimien = .objseteoparam.Fac_CtrlVencimien
			ENDIF 
			IF VARTYPE(.objseteoparam.FacPedido_Frio)$'XU'
				.objseteoparam.AddProperty("FacPedido_Frio",.f.)
			ENDIF 
		*!*		IF VARTYPE(.objseteoparam.SoloContadoPde_Fac)='L'
		*!*			.SoloContadoPde = .objseteoparam.SoloContadoPde_Fac
		*!*		ENDIF 
			IF VARTYPE(.oBJIMPRESOR.version_facvta)$'XU'
				.ObjImpresor.AddProperty('version_facvta',0)
			ENDIF 
			IF VARTYPE(.objseteoparam.ImpFac_Tipo)='N'
				.ObjImpresor.version_facvta = .objseteoparam.ImpFac_Tipo
			ENDIF 
			this.oPreventamobile.version = .ObjImpresor.version_facvta 
			&&Tipo de report para facturacion
			IF VARTYPE(.objseteoparam.ImpFac_TipoRep)='N'
				.ObjImpresor.tiporeport = .objseteoparam.ImpFac_TipoRep
			ENDIF 
			IF VARTYPE(.oBJIMPRESOR.cbioproducto_facvta)$'XU'
				.ObjImpresor.AddProperty('cbioproducto_facvta',.f.)
			ENDIF 
			IF VARTYPE(.objseteoparam.ImpFac_Cbio)='L'
				.ObjImpresor.cbioproducto_facvta = .objseteoparam.ImpFac_Cbio
			ENDIF 
			IF VARTYPE(.objseteoparam.regvta_sinpromo)$'XU'
				.objseteoparam.AddProperty('regvta_sinpromo',.t.)
			ENDIF 
			IF VARTYPE(.objseteoparam.ventas_reba)$'L'
				.controlar_reba = .objseteoparam.ventas_reba
			ENDIF 
			IF VARTYPE(.objseteoparam.FacVta_CFCdoPde)$"L"
				.RemiCdoPde = .objseteoparam.FacVta_CFCdoPde
			ENDIF
			IF VARTYPE(.objseteoparam.RegVta_Stock)$"N"
				.nQueStockFacVta = .objseteoparam.RegVta_Stock
			ENDIF
			IF VARTYPE(.objseteoparam.RegVta_LetraAM)$"L"
				.agregaobjeto.cambioaam = .objseteoparam.RegVta_LetraAM
				.cambioaam = .agregaobjeto.cambioaam
			ENDIF
			IF VARTYPE(.objseteoparam.RegVta_LetraBM)$"L"
				.agregaobjeto.cambiobam = .objseteoparam.RegVta_LetraBM
				.cambiobam = .agregaobjeto.cambiobam
			ENDIF
			IF VARTYPE(.objseteoparam.RegVta_TipoPresu)$"N"
				.tipopresupuesto = .objseteoparam.RegVta_TipoPresu
			ENDIF
			.activarcajadiario = .f.
			IF VARTYPE(.objseteoparam.RegVta_CajaDiaria)$"L"
				.activarcajadiario= .objseteoparam.RegVta_CajaDiaria
			ENDIF
			.usarcombo = .f.
			IF VARTYPE(.objseteoparam.Fac_Combo)$"L"
				.usarcombo = .objseteoparam.Fac_Combo
			ENDIF
			.usar_tasa0 = .f.
			IF VARTYPE(.objseteoparam.gestion_tasa0)$"L"
				.usar_tasa0 = .objseteoparam.gestion_tasa0
			ENDIF
			.cantidaddec = .t.
			
			lObjeto = null
			.armarobserva(0)
			
			*stop()
			.incluyeiva = goapp.empresaincluyeiva
			
			IF .tipoform$"I"
				.incluyeiva = .t.
				.tipoform="F"
			ENDIF 
			*stop()
			.tipoestadofac = .tipoform
			DO CASE 
				CASE .tipoform = "F" OR .tipoform $ "C-X-Y-Z-B"
					.tipofactura ="N"
					&&lpidoexistenc chequea que debe controlarse la existencia
					&&lomitirexistenc deja informar, pero no cancela el proceso
		*!*				IF VARTYPE(.objseteoparam.def_CTRLEXISTENC_FAC)='L'
		*!*					.lpidoexistenc = .objseteoparam.def_ctrlexistenc_fac
		*!*				ENDIF 
					.lpidoexistenc = .t.
					IF VARTYPE(.objseteoparam.FacVta_OmitirCtrolExis)='L'
						.lomitirexistenc = .objseteoparam.FacVta_OmitirCtrolExis
					ENDIF 
					IF VARTYPE(.objseteoparam.regvta_soliimporte)$"L"
						.regvta_soliimporte = .objseteoparam.regvta_soliimporte
					ENDIF 
					*stop()
					IF .tipoform $ "B"
						.tipoform = 'F'
						this.oregfacvta.facmostrador = .t.
					ENDIF 
					IF .tipoform $ "CXYZ"
						.tipoestadofac = .tipoform
						IF .tipoform$"XYZ"
							.incluyeiva = .t.
							.excluyefiscales = .t.
							.lbltituloform.Caption = .lbltituloform.Caption + " C/IVA"
						ENDIF 
						IF .tipoform$"Y"
							.facturaCF = .t.
							.lbltituloform.Caption = .lbltituloform.Caption + " CF Fiscales"
						ENDIF 
						IF .tipoform$'Z'
							.excluyefiscales = .f.
							.lbltituloform.Caption = .lbltituloform.Caption + " Fiscales"
						ENDIF 
						.tipoform = "F"
						.tomardatosfac = .t.
						.pidodatosfac = .t.
						
					ENDIF 
					
				CASE .tipoform = "M"
					.tipofactura = "M"
					.tipoform = "F"
					this.containerencabeza._txtfecha.Enabled = .t.
					IF VARTYPE(.objseteoparam.facvta_pidodatos)='L'
						.pidodatosfac = .objseteoparam.facvta_pidodatos
					ENDIF 
					.tomardatosfac = .pidodatosfac
					.lnnroautomatico = 0
					.lpidoexistenc = .f.
				CASE .tipoform = "S"
					.tipofactura = "D"
					.tipoform = "F"
					IF VARTYPE(.objseteoparam.def_MULTIARTICULOS_dif)='L'
						.permitemultilineas =  .objseteoparam.def_MULTIARTICULOS_dif
						*Esto se carga al inicio el form. por lo tanto, el defecto del objeto debe tomar este valor
						.objseteoparam.def_MULTIARTICULOS = .objseteoparam.def_MULTIARTICULOS_dif
					ENDIF 
				CASE .tipoform = "D"
					.tipofactura = "E"
					.tipoform = "F"
					IF VARTYPE(.objseteoparam.def_MULTIARTICULOS_dif)='L'
						.permitemultilineas =  .objseteoparam.def_MULTIARTICULOS_dif
						*Esto se carga al inicio el form. por lo tanto, el defecto del objeto debe tomar este valor
						.objseteoparam.def_MULTIARTICULOS = .objseteoparam.def_MULTIARTICULOS_dif
					ENDIF 
				CASE .tipoform = "N"
					.SoloContadoPde= .t.
					.tipofactura ="N"
					.containeringreso.kitbuscaoaltaenFletero.Visible	= .f.
					.containeringreso.kitbuscaoaltaenFletero.Enabled 	= .f.
					.containeringreso.lblfletero.Visible 				= .f.
					.containeringreso.kitbuscaoaltaenvendedor.Left 		= .containeringreso.kitbuscaoaltaenFletero.Left
					.containeringreso.lblvendedor.Left 					= .containeringreso.lblfletero.Left
					.containerencabeza.chkesremito.Visible = .t.
					.UsarPromocion = .objseteoparam.regvta_sinpromo &&Si es true no desactiva
					.controlar_reba = .f. &&Notas de pedido no validan
					.lpidoexistenc = .f.
			ENDCASE 	
			
			dodefaul()
			
			IF Goapp.codempresa = 8
				thisform.containerencabeza.kitbuscaoaltaenCtacte.botonllamarabm1.nombreabm = 'abmctactepub'
			ENDIF 
				
			.AddObject('loObjBonifica','Custom') 	 
			.loObjBonifica.AddProperty('idproducto',0)
			.loObjBonifica.AddProperty('idrubro',0)
			.loObjBonifica.AddProperty('idvendedor',0)
			.loObjBonifica.AddProperty('cantidad',0)
			.loObjBonifica.AddProperty('idprodpromo',0)	 
			.loObjBonifica.AddProperty('idprodregalo',0)	 	 
			.loObjBonifica.AddProperty('cada',0)
			.loObjBonifica.AddProperty('entrega',0)
			.loObjBonifica.AddProperty('bonpromo',0)
			.loObjBonifica.AddProperty('bonivdorviernes',0)
			.loObjBonifica.AddProperty('idcabeunifica',0)
			.loObjBonifica.AddProperty('bonctacte',0)
			.loObjBonifica.AddProperty('registro',0)
			.loObjBonifica.AddProperty('oferminimo',0)
		  	.loObjBonifica.AddProperty('oferfecha',DATETIME(1900,1,1,0,0,0))
		  	.loObjBonifica.AddProperty('bonfecha',DATETIME(1900,1,1,0,0,0))
		  	.loObjBonifica.AddProperty('bonpfecha',DATETIME(1900,1,1,0,0,0))
		  	.loObjBonifica.AddProperty('idcombo',0)
		  	.loObjBonifica.AddProperty('idprodcombo',0)
		  	
		  	
		  	.AddProperty('nColumnNombreWidth',This.Grid2.Column2.Width)
		  	.controlcaja()
		    .iniciavariables() 
		    .cargarcomboptovta(.t.)
		    .insertacursor()
		    .leercomprobante()
		
			.refresh()
		ENDWITH 
	ENDPROC

	PROCEDURE insertacursor		&& Crea registro iniciales,  CsrAuxmaopera, CsrauxCabefac.
		parameters lsolocabefac
		lsolocabefac = iif(pcount()<1,.f.,lsolocabefac)
		
		Set safe off
		if !lsolocabefac
		    SELECT CsrAuxMaopera
		    ZAP
		    lnnrocaja = IIF(ISNULL(CsrParaConfig.nrocajafac),0,CsrParaConfig.nrocajafac)
		    INSERT INTO CsrAuxmaopera (origen,programa,terminal,fechasis,idoperador,numcomp,iddetanrocaja;
		                ,turno,switch,sucursal,sector,puestocaja,idcotizadolar,nrocaja,iddeposito,pefiscal,estado,detalle,fechaserver;
		                ,NomOpera,idvendedor,clasetipo,statusform);
		           VALUES ('FAC',UPPER(thisform.name),Goapp.terminal,Csrparaconfig.fechaserver,goapp.idusuario;
			            ,'B000000000000',thisform.lnidnrocaja,Csrparaconfig.turno,"00000",Goapp.sucursal,thisform.sectorterminal,thisform.puestocaja;
		                ,Csrparaconfig.idcotizadolar,lnnrocaja,thisform.lniddeposito,Csrparaconfig.pefiscal,'0',"",Csrparaconfig.fechaserver;
		                ,CsrUsuarios.nombre,thisform.lnidvendedor,'00',this.tipoestadofac+REPLICATE('0',9))
		ENDIF 
		    
		SELECT  CsrAuxcabefac
		zap
		Insert into CsrAuxcabefac (fecha,idtipoiva,idplanpago,switch,copiatkt,vencimien,parada;
			,idlocalidad,idprovincia,idfletero,idfuerzavta,listaprecio,idrutavdor,idtiponcredito);
		       value (FechaHoraCero(Csrparaconfig.fechafac),3,thisform.lnidplanpago,thisform.tipoform+"0"+thisform.tipofactura+"00",1,Csrparaconfig.fechafac,0,thisform.lnidlocalidad,thisform.lnidprovincia,Csrfletero.id;
		       		,CsrFuerzavta.id,thisform.listadefecto,0,0)
		 
		      		
		thisform.fechafactura=Csrparaconfig.fechafac
		thisform.cajafacturacion=csrauxmaopera.nrocaja
		
		SELECT CsrAuxCuerfac
		ZAP
		
		SELECT CsrAuxCuervari
		ZAP
		
		SELECT CsrAuxMovAfectado
		ZAP
		        
		WITH thisform
			.accion 								 = "A"
			.containertotales._txtbonificacion.Value = 0.00
			.containertotales._txtinterno.Value      = 0.00
			.containertotales._txtiva.Value          = 0.00
			.containertotales._txtnetoexento.Value   = 0.00
			.containertotales._txtnetogravado.Value  = 0.00
			.containertotales._txtpercepcion.Value   = 0.00
			.containertotales._txtnocatego.Value     = 0.00
			.containertotales._txtsubtotal.Value     = 0.00
			.containertotales._txttotal.Value        = 0.00
			.containertotales._txtperceiva.Value        = 0.00
			.containerencabeza._txtletra.Value       = " "
			.containerencabeza._txtnumcomp.Value     = .containerencabeza._txtnumcomp.Value + 1
		ENDWITH 		
		
		thisform.refresh()
		
		set safe on
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		WITH thisform
			.lnkeycode = nKeycode
			.kitbuscarProd.tecla = nKeyCode
			
			IF 	nShiftAltCtrl = 2
				oavisar.usuario(strtrim(nKeyCode))
			ENDIF 
			
			DO CASE  
				CASE nkeycode = 22 AND thisform.consultandocomprobante
					NODEFAULT 
		        			thisform.copiarcomprobante()
		            	   
				CASE .grid2.activecolumn = 7
					IF nkeycode = 27
						NODEFAULT 
					ENDIF 
					IF nkeyCode = 42
						NODEFAULT 
						KEYBOARD '{ENTER}'
					ENDIF   	
							
			  	CASE nKeyCode = 27 AND !.ultimocontainer ="CONTAINERVARIEDAD"   
			   	    NODEFAULT 
			   	    thisform.bloqueocodigo=.f.
			        .k_escape()
			        
			   	CASE UPPER(.ultimocontainer)="CONTAINERINGRESO"
			   		IF .accion="A"
				        IF nKeyCode = -3
					   		NODEFAULT 
				   			.key_f4()
						ENDIF
					ELSE
						IF nKeyCode=43 OR nKeyCode=45
							NODEFAULT 
							.VerComprobante(nKeyCode)
						ENDIF
					ENDIF
					
			CASE UPPER(.ultimocontainer)="CONTAINERENCABEZA"
				IF (nKeyCode=43 OR nKeyCode=45) AND .consultandocomprobante
					NODEFAULT 
					.VerComprobante(nKeyCode)
				ENDIF
				IF  (nKeyCode=43 OR nKeyCode=45) AND .importandopedidos
					NODEFAULT 
					.VerPedido(nKeyCode)
				ENDIF 
						
			   CASE .ultimocontainer ="THISFORM.GRID2" 
					
			   		DO CASE 
			   		    CASE (nKeyCode = 42) AND thisform.grid2.ActiveColumn=5 AND !thisform.consultandocomprobante && F7/* en el importe
					   		 NODEFAULT 											&& *
			   		         thisform.lpidodescto=.t.	   		         
			   		         REPLACE bondigitada WITH 1 IN csrauxcuerfac
			   		    CASE (nKeyCode=254) AND thisform.grid2.ActiveColumn=5 AND !thisform.consultandocomprobante && F7/* en el importe
					   		 NODEFAULT 											&& *
			   		         thisform.lpidodescto=.t.	   		         
			   		         REPLACE bondigitada WITH 1 IN csrauxcuerfac     					 
			   		         KEYBOARD '{ENTER}'
			   		    CASE (nKeyCode)=43  AND thisform.grid2.ActiveColumn=5 AND !thisform.consultandocomprobante && + en cantidad
						   	NODEFAULT
						   	IF this.activocbiouniventa										
			   		         	REPLACE univenta WITH IIF(univenta=1,2,1) IN csrauxcuerfac     					 
			   		         ENDIF   		         
			   		    CASE nKeyCode = -7 AND !thisform.consultandocomprobante  												&& F8
					   		 NODEFAULT 
					   		 .bloqueocodigo=.f.
					   		 IF .grid2.ActiveColumn=1 
						   		 IF !.cambioarticulo
				  			   		 .grid2_borrarlinea()
				  			   	 ELSE
					  			   	 .Grid2.Column1.Text1.Value=.codigoanterior	    		
				  			   	 endif 
				  			 endif  
				  			 	 
			   			CASE nKeyCode=5 OR nKeyCode=19
					   		IF .ultimofocoen="._TXTPARADA" AND RECCOUNT("CsrAuxCuerfac")=0
				    		    NODEFAULT
						        .Containerencabeza._txtparada.SetFocus()
							ENDIF 		    	  
							  
					   CASE nKeyCode=255 AND thisform.grid2.ActiveColumn=1 && + para grabar 
					        thisform.bloqueocodigo=.f.
					        thisform.generarentrega = .f.
					        NODEFAULT
					        
					        .cargarconcepto()         
					             									        
					   CASE nKeyCode=255 AND thisform.grid2.ActiveColumn#1
					   		NODEFAULT 
					   CASE nKeyCode=43 
					   		NODEFAULT 
						CASE nKeyCode = -5 &&AND thisform.tipoform$"N"
							thisform.cmdlicita.SetFocus()
							thisform.cmdlicita.Click()
						CASE nKeyCode=9 AND thisform.grid2.ActiveColumn=1 AND NOT thisform.consultandocomprobante
					    	NODEFAULT 
					    	.buscarproducto()
					ENDCASE 
			   CASE .ultimocontainer ="CONTAINERVARIEDAD"  && + en grid1 variedad  
			   		IF nKeyCode=43 .or. nkeycode=27
				        NODEFAULT      		           
			    	    .key_grid1(.lnkeycode, nShiftAltCtrl)  
			    	ENDIF      
					IF nKeyCode = 42 AND !thisform.consultandocomprobante &&* en la cantidad
					   	NODEFAULT 										
			   		    thisform.lpidodescto=.t.	   		         
			   		    REPLACE bondigitada WITH 1 IN csrauxcuerfac       
			   		ENDIF 
				OTHERWISE 	
			ENDCASE 
		ENDWITH 	
	ENDPROC

	PROCEDURE key_43		&& Tecla  + para grabar
		IF thisform.Hayescape
		   thisform.Hayescape = .f.
		   RETURN .t.
		ENDIF 
		
		*stop()
		IF thisform.validarcomproba()
			thisform.actualizar()
			**stop()
			&&Si la grabación proviene de un pedido.
			IF this.importandopedidos AND this.lokgrabar
			    &&Renombramos el archivo original
			   
			    SELECT CsrOpcion
			    this.renombrarpedido()
			    SKIP
			    DO WHILE NOT !EOF() AND estado=1
					SKIP 
			    ENDDO
			    nRecno = IIF(EOF(),0,RECNO())
			    
				thisform.leyendocuerpedido = .t.
				thisform.recorriendopedido = .t.
				*thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
				SELECT CsrOpcion
				IF nRecno#0
					GO nRecno
					thisform.leyendocuerpedido = .f.
					thisform.importarpedidos()
				ELSE 
					this.importandopedidos = .f.
				ENDIF 
			ENDIF 
			this.actualizafac.lnquestock = this.objseteoparam.def_lnquestock
		ELSE
			this.actualizafac.lnquestock = this.objseteoparam.def_lnquestock
			oavisar.usuario("Hay errores en la facturacion, "+CHR(13)+thisform.cadenaerrores,0)
			thisform.grid2.column1.Text1.SetFocus()
		endif	
		
		
			
				        		
		
	ENDPROC

	PROCEDURE key_afip
		IF LEN(LTRIM(CsrAuxMaopera.numcomp)) <> 0 AND CsrAuxMaopera.clasecomp$'ABC'
			DO FORM compconsultar_fe WITH CsrAuxMaopera.id
		ELSE
			lnok = oavisar.usuario('Desea pedir autorización a AFIP?',36)
			IF lnok = 6
			
				oCadapter = thisform.obtenercursor('CsrMaopera')
		
		
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT CsrParaVario.* FROM ParaVario as CsrParaVario
				ENDTEXT 
				IF NOT CrearCursorAdapter('CsrParaVario',lcCmd)
					RETURN .f.
				ENDIF 
		
				SELECT CsrParaVario
				LOCATE FOR nombre='CAE_LOTE'
				IF nombre='CAE_LOTE' AND ESTADO=1
					RETURN .T.
				ENDIF 
		
				&&Toma el primer comprobante disponible
				SELECT CsrAuxCabefac
				GO TOP 
				SCATTER NAME OscCAECabefac
				*stop()
				thisform.oFacCAE.fac_solicitacae()
				IF Thisform.oFacCAE.sw_estado
					oavisar.usuario('Autorización EXITOSA!'+CHR(13)+'')
					SELECT CsrAuxCabefac
					GO TOP 
					
					TEXT TO lcCmd TEXTMERGE NOSHOW 
					SELECT Csrcabefac.*,CsrMaopera.numcomp from cabefac as Csrcabefac 
					left join maopera as CsrMaopera on CsrCabefac.idmaopera = CsrMaopera.id
					where Csrcabefac.idmaopera in (<<CsrAuxCabefac.idmaopera>>)
					order by id
					ENDTEXT 
					IF !CrearCursorAdapter('Csrcabecae',lccmd)
					  RETURN .f.
					ENDIF
					
					TEXT TO lcCmd TEXTMERGE NOSHOW 
					SELECT CsrTipoCbte.* FROM AfipComproba as CsrTipoCbte WHERE id = <<NVL(Csrcabecae.idtipocbte,0)>>
					ENDTEXT 
					=CrearCursorAdapter('CsrTipoCbte',lccmd)
					
				
					SELECT CsrAuxCabefac
					SCATTER NAME OscatterCab
					OscatterCab.vencimien	= Csrcabecae.fecha
					OscatterCab.proximonro	= Csrcabecae.numcomp
					OscatterCab.cae			= Csrcabecae.cae
					OscatterCab.caetipo 	= Csrcabecae.caetipo
					OscatterCab.vtocae		= Csrcabecae.vtocae
					OscatterCab.fecha		= Csrcabecae.fecha
					
					*GATHER NAME OscatterCab
					
					SELECT CsrTipoCbte
					OscatterCab.tipocbte = strzero(NVL(CsrTipoCbte.codafip,0),2)
					USE IN CsrTipoCbte
					
					IF LEN(CsrCabefac.cae)<>0
						thisform.lblCAEA.Caption = "CAE / CAEA: "+OscatterCab.cae
					ENDIF 
					SELECT CsrAuxCabefac
					GATHER NAME OscatterCab
					
					replace numcomp WITH Csrcabecae.numcomp IN CsrAuxMaopera
					
					WITH thisform
						.containerencabeza._txtletra.Value   = left(CsrAuxmaopera.numcomp,1)
						.containerencabeza._txtptovta.value  = subs(CsrAuxmaopera.numcomp,2,4)
						.containerencabeza._txtnumcomp.Value = VAL(righ(CsrAuxmaopera.numcomp,8))
						.talonario 							 = VAL(.containerencabeza._txtptovta.value)
						*.containerencabeza._txtptovta.Value  = VAL(.containerencabeza._cboptovta.List(.talonario))	
						.proximonro 						 = CsrAuxMaopera.numcomp	
						
						.cmdimprimir.Click()
					ENDWITH 
		
				ENDIF 
				
				oavisar.proceso('N')
				oCadapter = null
		
			ENDIF 
		ENDIF 
		
	ENDPROC

	PROCEDURE key_asientos
		DO FORM listasto WITH CsrAuxMaopera.id
	ENDPROC

	PROCEDURE key_borrar
	ENDPROC

	PROCEDURE key_cbioplanpago
		&&Si ingresa la clave de acceso correcto.
		LOCAL loObjeto
		
		DO FORM frmterminal name LobjForm linked
		
		llok = lobjform.encontrokey
		
		RELEASE lobjform
		
		IF llok
			IF CsrPlanPago.numero='CCT'
				thisform.generarcbioplan()
			ELSE
				thisform.contenedorVto.Visible = .t.
				thisform.contenedorVto.Enabled = .t.
				thisform.contenedorVto._txtfechavto.Value = DATE()
				thisform.contenedorVto._txtfechavto.SetFocus()
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE key_f4		&& Consulta comprobantes
		
		LOCAL lcCtrlSource,lcalias,AcolOdataNavega,loObjCabefac,oca,lccmdCampos,lcIdretorno,lcorigen,loObjeto
		STORE '' TO lcCtrlSource,AcolOdataNavega,lccmdSelect,lcIdretorno
		
		*!*	loObjeto = CREATEOBJECT("Custom")
		*!*	loObjeto.AddProperty('idcompanulacion',thisform.idcompanulacion)
		
		loObjCabefac   = thisform.getrefobjneg('thisform.odatacabefac')
		lcalias = loObjCabefac.calias  && alias del objeto de negocio
		SELECT (lcalias)
		oca=thisform.obtenercursor(lcalias)
		
		public pndatasessionid
		pndatasessionid = thisform.datasessionid
		
		IF NOT strzero(goapp.codempresa,3)$'002-001-007'
			lcCmdCampos = 'FECHA\CTACTE\NUMCOMP\CNOMBRE'   && campos a leer del archivo principal
			lcTypeData  = 'T\*\C\C'				&& tipo de dato de cada campo
			lcCmdMuestra     = 'FECHA\NRO CLIENTE\NRO COMPROBANTE\NOMBRE'       && campos a mostrar
			lcCmdOperador    = '1\1\5\1'		        && igual\;no igual\;más que\;menos que\;contiene\;en
			lcCmdDatoInicial = DTOC(thisform.containerencabeza._txtfecha.Value)+"\"+ALLTRIM(CsrCtacte.cnumero)+"\ \ "
		ELSE
			lcCmdCampos = 'CTACTE\FECHA\NUMCOMP\CNOMBRE'   && campos a leer del archivo principal
			lcTypeData  = '*\T\C\C'				&& tipo de dato de cada campo
			lcCmdMuestra     = 'NRO CLIENTE\FECHA\NRO COMPROBANTE\NOMBRE'       && campos a mostrar
			lcCmdOperador    = '1\1\5\1'		        && igual\;no igual\;más que\;menos que\;contiene\;en
			lcCmdDatoInicial = ALLTRIM(CsrCtacte.cnumero)+"\"+DTOC(thisform.containerencabeza._txtfecha.Value)+"\ \ "
		ENDIF 
		lcOrigen = IIF(thisform.tipoform$'FPD',"FAC","NPE")
		
		&& "FAC - NPE" permite elegir un solo comprobante
		&& "A" tipo eleccion permite elegir un solo comprobante de salida
		
		*!*	DO FORM buscompro WITH lcOrigen,oca,lcCmdCampos,lcTypeData,"T",loObjeto,lcCmdMuestra,lcCmdOperador,lcCmdDatoInicial TO lcIdretorno
		
		*!*	loObjeto = null
		
		LOCAL loObjParametro
		this.agregaobjeto.objbuscocomproba(@loObjParametro)
		
		WITH loObjParametro
			.oObjOca=oca
			.AddProperty('idcompanulacion',thisform.idcompanulacion)
			.cCmdCampos      = lcCmdCampos 
			.cTypeData       = lcTypeData
			.cCmdMuestra     = lcCmdMuestra
			.cCmdOperador    = lcCmdOperador
			.cCmdDatoInicial = lcCmdDatoInicial
			.cOrigen 		 = lcOrigen
			.cTypeSelection = "T"
		ENDWITH 
		
		&& "A" tipo eleccion permite elegir un solo comprobante de salida
		
		DO FORM buscomprofacvta WITH loObjParametro 
		lcidRetorno = loObjParametro.cidretorno
		loObjParametro = null
		
		WITH thisform 
			IF LEN(TRIM(lcidretorno))#0
				.accion = "C"	
				IF USED("CsrCurConsulta")
					GO TOP IN CsrCurConsulta
					lcidretorno = STRID(CsrCurConsulta.idmaopera)			
				ENDIF 
				.consultandocomprobante=.t.
				.bloqueocodigo = .f.
				.muestracomprobante(lcidretorno)
				*=MESSAGEBOX(csrauxcabefac.switch)
				
		*!*			IF subst(csrauxcabefac.switch,3)='1'
		*!*			   thisform.esvale='1'
		*!*			ENDIF
		*!*			IF thisform.esvale='1'		
		*!*				ThisForm.Containerencabeza._txtparada.Value='9'
		*!*				thisform.containerencabeza.lblvale.Visible=.t.
		*!*			    thisform.containerencabeza.lblvale.Caption='VALE'
		*!*			endif
				
				thisform.ponerpantallamodoconsulta()
			ELSE
				.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()			
			ENDIF 
		ENDWITH 
			
	ENDPROC

	PROCEDURE key_f6_opciones
		LPARAMETERS lcTipoOrden
		
		LOCAL oParametros ,cLeyenda
		
		oParametros = CREATEOBJECT("custom")
		WITH oParametros
			.AddProperty("titulo",Thisform.lbltituloform.Caption)
			.AddProperty("btnCancel",.t.)
			nItems = 5
			
			stop()	
			.AddProperty("items",nItems)
			.AddProperty("arrayList[oParametros.items,2]",'')
			
			.arrayList[1,1]	= 'Estado AFIP'
			.arrayList[1,2]	= "Thisform.key_afip()"
		
			.arrayList[2,1]	= 'Asientos Contables'
			.arrayList[2,2]	= "thisform.key_asientos()"
			
			.arrayList[3,1]	= 'Copiar Comprobante'
			.arrayList[3,2]	= "thisform.copiarcomprobante()"
			
			i = 4
			IF this.cmdplan_cbioestado(@cLeyenda)
				.arrayList[4,1]	= cLeyenda
				.arrayList[4,2]	= "thisform.key_cbioplanpago()"
				i = i + 1 
			ENDIF 
			
			IF goapp.codempresa = 15
				.arrayList[i,1]	= 'GS1'
				.arrayList[i,2]	= "thisform.generargs1()"
			ELSE
				.arrayList[i,1]	= 'Consignar'
				.arrayList[i,2]	= "thisform.generarconsigna()"
			ENDIF 
			i = i + 1 
			
		ENDWITH 
		
		DO FORM informeparam WITH oParametros TO cResponse
		
		IF NOT cResponse$'CANCELAR'
			&cResponse
		ENDIF 
	ENDPROC

	PROCEDURE key_grid1		&& Teclas para grid1 containervariedad
		LPARAMETERS lnKeyCode, lnShiftAltCtrl
		
		WITH thisform
			.lpidocantidad       = .f.
			.lcsetfocus          = "THISFORM.GRID2.COLUMN6.TEXT1"
			.lcgotfocus          = "THISFORM.GRID2.COLUMN5.TEXT1"
			.ultimocontainer     = "THISFORM.GRID2"
			.lblayudapie.Caption = "[Esc]Retrocede a Cliente     [ + ]Graba"
			.containervariedad.LostFocus()
		 	.containervariedad.Visible = .f.
			.containervariedad.grid1.Visible = .f.	
			.containervariedad.Refresh
			.containerencabeza.Enabled= .t.
			.containeringreso.Enabled=.t.
			.containerpromoboni.Enabled=.t.
			.CmdBorrar.Enabled=.t.
			.cmdconsulta.Enabled=.t.
			.cmdimprimir.Enabled=.t.
			.cmdSalvar.Enabled=.t.
			.cmdRemito.Enabled	= .t.
			*.cmdAsiento.Enabled = .t.
			*.cmdwebservice.Enabled = .t.
			*.cmdconsignar.enabled = .t.
			.CmdOpciones.Enabled = .t.
			.CmdLicita.Enabled = .t.
			.grid2.Enabled=.t.	
			*
			
		    IF .Hayescape
		       .Hayescape = .f.
		       RETURN .t.
		    ENDIF 
		ENDWITH
		
		LOCAL lncantidad,Oscatter
		lncantidad = CsrAuxCuerfac.cantidad
				
		IF !thisform.consultandocomprobante
			lhayunCambio = .f.
			lncantidad = 0
			SELECT CsrSubproducto
			GO top
			&&Si el primero es Devolucion son todas devolcuiones.
			SCAN FOR !EOF() AND NOT lhayUnCambio
				lhayUnCambio = IIF(not lHayUnCambio and CsrSubProducto.cantidad < 0,.t.,lHayUnCambio)
				IF CsrSubProducto.cantidad != 0 &&Cualquier cantidad distinta de 0 cancela el chequeo.
					EXIT 
				ENDIF 
			ENDSCAN 
			GO TOP 
			SCAN FOR !EOF()
				SCATTER NAME Oscatter
				*lhayUnCambio = IIF(not lHayUnCambio and Oscatter.cantidad < 0,.t.,lHayUnCambio)
				Oscatter.cantidad = ABS(Oscatter.cantidad)*IIF(lHayUnCambio ,-1 ,1)&&Si El primero es devolucion entonces son todos devolciones. 
				SELECT CsrAuxCuerVari
				LOCATE FOR idsubarti = Oscatter.id  AND registro = CsrAuxCuerfac.registro
				IF EOF() AND Oscatter.cantidad#0
				   APPEND BLANK 
			  	   REPLACE idsubarti WITH Oscatter.id,idarticulo WITH Oscatter.idarticulo,idvariedad WITH Oscatter.idvariedad;
			  	   		   ,nombre WITH Oscatter.nomvariedad,cantidad WITH Oscatter.cantidad,kilos WITH Oscatter.kilos,volumen WITH Oscatter.volumen;
			  	   		   ,registro WITH CsrAuxCuerfac.registro,escambio WITH IIF(lHayUnCambio,1,0)
			  	ELSE 
			  	   IF !EOF()
					  REPLACE cantidad WITH Oscatter.cantidad,kilos WITH Oscatter.kilos,volumen WITH Oscatter.volumen
			  	   ENDIF    
				ENDIF 			
				lncantidad = lncantidad + Oscatter.cantidad	
				SELECT Csrsubproducto
			ENDSCAN 	
			WITH thisform
				.grid2.column5.text1.value = lncantidad
		    		.hacerfocoen = ""
				.grid2.column5.text1.SetFocus 	
		 		.grid2.column5.text1.Lostfocus()
				*KEYBOARD '{TAB}' 
				&&Comentado 33/11/11
				&&Salteaba si se queria digitar descto de variedades.
			ENDWITH	
		ELSE
			.lhayvariedad = .f.		
			thisform.grid2_procesolinea(1)
		ENDIF 
		
		
		
		
		
	ENDPROC

	PROCEDURE k_escape
		LOCAL lok
		
		WITH thisform
			.Hayescape = .t.   
			DO CASE 
				CASE UPPER(.ultimocontainer)="CONTAINERINGRESO"
			   		.limpiarcursor()	
			   		.controlinicial()
			   	
			      	IF .salirigual
			        	lok = 6
			      	ELSE 
			        	lok = Oavisar.usuario('Desea abandonar la registración',36)
			      	ENDIF   
			      	IF lok=6     
			      		.armarobserva(0)  
			         	.Release
					ELSE
				  		.containeringreso._txtlostfocus.SetFocus()	 
				  		.containeringreso._txtlostfocus.Click()
			      	ENDIF          
			      
			   CASE UPPER(.ultimocontainer)="CONTAINERENCABEZA"
			   		
				    *.containeringreso.kitbuscaoaltaenFletero.txtexiste1.SetFocus()	  
			  	    *.containeringreso.kitbuscaoaltaenFletero.txtexiste1.Click()
			  	    .CmdSalvar.Visible = .f.
			  	    .cmdRemito.Visible = .f.
			  	    *IF thisform.tipoform$"N"
						.CmdLicita.Visible = .f.
					*ENDIF 
					this.lnidctacteant = 0
					this.lnidcompant = 0
					
				  	.containeringreso._txtlostfocus.SetFocus()	 
				  	.containeringreso._txtlostfocus.click()
				  	
			   CASE UPPER(.ultimocontainer)="THISFORM.GRID2"
			   		.grid2_procesolinea(27)      
			   
			   CASE UPPER(.ultimocontainer)="CONTENEDORPERCE"
			   		.contenedorperce.Visible = .f.
			   		.grid2_procesolinea(27)    
			   		  
			   CASE UPPER(.ultimocontainer)="CONTENEDORCOBRANZA"
			   		.contenedorcobranza.Visible = .f.
			   		.grid2_procesolinea(27)      
			   
			   CASE UPPER(.ultimocontainer)="CONTENEDORDNI"					
			   		.contenedordni.Visible = .f.
			   		.grid2_procesolinea(27)
			   							
			   CASE UPPER(.ultimocontainer)="CONTAINERVARIEDAD"   
			   		.containervariedad.LostFocus()
				 	.containervariedad.Visible = .f.
					.containervariedad.grid1.Visible = .f.	
					.containervariedad.Refresh
					.lhayvariedad = .f.
					
					.containerencabeza.Enabled= .t.
					.containeringreso.Enabled=.t.
					
					.containerpromoboni.Enabled=.t.
					.CmdBorrar.Enabled=.t.
					.cmdconsulta.Enabled=.t.
					.cmdimprimir.Enabled=.t.
					*.cmdasiento.Enabled = .t.
					*.cmdwebservice.Enabled = .t.
					*.cmdconsignar.Enabled = .t.
					.cmdSalvar.Enabled=.t.
					.cmdRemito.Enabled	= .t.
					.CmdLicita.Enabled = .t.
					.CmdOpciones.Enabled = .t.
					.grid2.Enabled=.t.		
					
					.grid2_procesolinea(27)      
			   		
			   		
			   OTHERWISE 
			     IF !EMPTY(.hacerfocoen)
					lchacerfoco = .hacerfocoen+'.setfocus'
					&lchacerfoco
					.hacerfocoen = ''
			     ENDIF 
			ENDCASE 
		ENDWITH
		
	ENDPROC

	PROCEDURE leercomprobante		&& Lee comprobante, valido para la terminal , vendedor
		LOCAL lcidcomprobante
		
		STORE "" TO lcidcomprobante
		
		thisform.agregaobjeto.objcomprobante(@lcidcomprobante)
		lcidcomprobante	= IIF(LEN(TRIM(lcidcomprobante))=0,'0',lcidcomprobante)
		
		DO case
			* facturacion normal, Premios
			CASE thisform.tipoform$"FPD" AND !this.tipofactura$"ED"
				IF LEN(TRIM(lcidcomprobante))#0
					lcClase = "'I'"
					IF goapp.codempresa <> 13
					
					   TEXT TO lcCmd TEXTMERGE NOSHOW 
					   SELECT Csrcomprobante.* FROM comprobante as Csrcomprobante 
					   WHERE Csrcomprobante.id in (<<lcidcomprobante>>) AND regisf=1 
					   and not Csrcomprobante.clase in (<<lcClase>>) order by cnombre
					   ENDTEXT 
					ELSE
						
						IF thisform.facturacf
							lcClase = lcClase + ",'X','H'"
						ELSE 
							IF NOT thisform.incluyeiva
								lcClase = lcClase + ",'X','H'"
							ELSE
								IF thisform.excluyefiscales
									lcClase = lcClase + ",'A','B','C'"
								ENDIF 
							ENDIF				
						ENDIF  		
									
						TEXT TO lcCmd TEXTMERGE NOSHOW 
					   	SELECT Csrcomprobante.* FROM comprobante as Csrcomprobante 
					   	WHERE Csrcomprobante.id in (<<lcidcomprobante>>) AND regisf=1 
					   	and not Csrcomprobante.clase in (<<lcClase>>) order by cnombre
					   	ENDTEXT 
					ENDIF 
				ENDIF 
			*facturacion diferida
			CASE thisform.tipoform$"F" AND this.tipofactura$"ED"
				IF LEN(TRIM(lcidcomprobante))#0
				   TEXT TO lcCmd TEXTMERGE NOSHOW 
				   SELECT Csrcomprobante.* FROM comprobante as Csrcomprobante 
				   WHERE Csrcomprobante.id in (<<lcidcomprobante>>) AND regisf=1 
				   and Csrcomprobante.clase <>'I' order by cnombre
				   ENDTEXT 
				ENDIF 
			* notas de pedidto		
			CASE thisform.tipoform="N"
				IF LEN(TRIM(lcidcomprobante))#0
				   TEXT TO lcCmd TEXTMERGE NOSHOW 
				   SELECT Csrcomprobante.* FROM comprobante as Csrcomprobante 
				   WHERE Csrcomprobante.id in (<<lcidcomprobante>>) AND regisf=1 and Csrcomprobante.clase='I' order by cnombre
				   ENDTEXT 
				ENDIF 	
		ENDCASE 
		
		=SaveSQL(lccmd,this.Name+"_leercomproba")
			   
		IF !thisform.obtenerdatos('Csrcomprobante',lccmd)
		   thisform.Release 
		ENDIF    
			
		LOCAL i,lcbusco
		thisform.lcprioridad = 'ABCVUI08'  && factura, n.dto., n.cre., receta, ticket, n.pedido
		IF thisform.tipoform='D'
			thisform.lcprioridad = 'CH0'  && factura, n.dto., n.cre., receta, ticket, n.pedido
		ENDIF
		
		SELECT Csrcomprobante
		FOR i=1 TO LEN(thisform.lcprioridad)
		    lcbusco = SUBSTR(thisform.lcprioridad,i,1)
			LOCATE FOR clase=lcbusco &&AND (signocta=2 OR signostock=2)
			IF clase=lcbusco
			   EXIT 
			ENDIF 
		NEXT 
		IF thisform.tipoform='D'
			SELECT Csrcomprobante
			LOCATE FOR clase='C' AND signocta=2
			IF !found()
			    GO top
			endif
		ENDIF
		
		REPLACE idcomproba WITH Csrcomprobante.id IN CsrAuxMaopera
		
		RETURN .t.
	ENDPROC

	PROCEDURE leerentorno
		thisform.cargarvalores()
		
		TEXT TO lccmdConta TEXTMERGE NOSHOW 
		Select Csrparaconta.* from paraconta as Csrparaconta 
		Where idejercicio = <<goapp.idejerciciofac>> order by numero
		ENDTEXT
		IF !thisform.obtenerdatos('CsrParaConta',lcCmdConta)
			thisform.Release
		ENDIF 
		
		TEXT TO lcCmdConta TEXTMERGE NOSHOW 
		Select Csrplancue.*,isnull(Csrclasecta.cnumero,' ') as clasecta from plancue as Csrplancue left join clasecta as Csrclasecta on Csrplancue.idclase = Csrclasecta.id where imputable=1
		AND csrplancue.idejercicio = <<goapp.idejerciciofac>>
		ENDTEXT 
		IF !thisform.obtenerdatos('CsrPlancue',lcCmdConta)
			thisform.Release
		ENDIF 
		
		TEXT TO lccmdConta TEXTMERGE NOSHOW 
		SELECT CsrProvCtaCon.* FROM ProvCtaCon as CsrProvCtaCon 
		WHERE CsrProvCtaCon.idejercicio = <<goapp.idejerciciofac>>
		ENDTEXT 
		IF !thisform.obtenerdatos('CsrProvCtaCon',lcCmdConta)
			thisform.Release
		ENDIF 
	ENDPROC

	PROCEDURE leerparametrosconfig		&& lee parametros configuracion general y diarios
		
		IF Csrparaconfig.idplanpago#0
		   SELECT Csrplanpago
		   LOCATE FOR id=Csrparaconfig.idplanpago
		   SELECT Csrvalor
		   LOCATE FOR id=Csrplanpago.idvalor
		ELSE
			SELECT CsrValor
		*!*		IF thisform.tipoform="F"
		*!*			LOCATE FOR clasevalor="E"   && contado
		*!*		ELSE 
				LOCATE FOR clasevalor="F"   && contado pendiente
		*!*		ENDIF 	
			SELECT Csrplanpago
			LOCATE FOR idvalor=Csrvalor.id
		ENDIF
		
		WITH thisform
		
			.lnidnrocaja	 = Csrparaconfig.iddetafac
			.lnidejercicio	 = Csrparaconfig.idejerciciocaja
			&&''
			.talonario 	     = Csrparaconfig.talonpc1
			.talonarioCF	     = CsrParaConfig.talonpc2
			
			.lniddeposito 	 = IIF(.lniddeposito <> 0,.lniddeposito,Csrparaconfig.iddeposito)
			.lnidlocalidad   = Csrparaconfig.idlocalidad
			.lnidprovincia   = Csrparaconfig.idprovincia
			.listadefecto    = Csrparaconfig.listadefecto
			
			.lnidcomprobafac	= Csrparaconfig.idcomproba1
			.lnidcomprobafacb	= Csrparaconfig.idcomproba2
			.lnidcomprobafaccf	= Csrparaconfig.idcomproba3	
			
			*.lnidcompfaccf   = Csrparaconfig.IDCOMPROBA3
		
			.lnidcomremlog	 = CsrParaConfig.idcomproba9
			.lnidplanpago    = Csrplanpago.id
			.haycbioplanpago = IIF(LEFT(Csrparaconfig.switch,1)='1',.t.,.f.)
			.containerencabeza._cboplanpago.Enabled = .haycbioplanpago
			
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT CsrParaVario.* FROM ParaVario as CsrParaVario
			ENDTEXT 
			IF NOT CrearCursorAdapter('CsrParaVario',lccmd)
				thisform.Release
			ENDIF 
		
			lnCantBonifVisible = 1
			lnActivarCodArtProd = .f.
			lnCbioUniVenta = .f.
			
			lcPathPDF =''
			
			SELECT CsrParaVario
			GO TOP 
			SCAN 
				.TopeCF = IIF(nombre = "TOPEFISCALCF",importe,.TopeCF)
				
				.preciodiasact = IIF(NOMBRE='DIASPRECIO' AND importe#0 ,importe,.preciodiasact )
						
				.activoPerceIVA5329 = IIF(ALLTRIM(nombre)="FACREG5329" and estado = 1,.t.,.activoPerceIVA5329)	
				.minimopiva5329 = IIF(ALLTRIM(nombre)="FACREG5329" and estado = 1,importe,.minimopiva5329 )
				
				&&La factura solicita transporte, pq se imprime en ella misma
				.facconremito= IIF(ALLTRIM(nombre)="FACREG_FACTRANSP",IIF(estado=0,.F.,.T.),.facconremito)	
				
				lnActivarCodArtProd = IIF(TRIM(nombre)='FACREG_BUSCODPROV' and estado =1, .t.,lnActivarCodArtProd )
				lnCantBonifVisible = IIF(TRIM(nombre)='FACREG_BONIFVISIBLE',estado,lnCantBonifVisible )
				
				lnCbioUniVenta= IIF(TRIM(nombre)='FACREG_UNIVENTA',estado,lnCbioUniVenta)
				
				lcPathPDF= IIF(ALLTRIM(nombre)="PATHFACPDF"+strzero(goapp.terminal,4),CsrParaVario.detalle,lcPathPDF) 
				
				
			ENDSCAN 
			
			this.objimpresor.pathpdf = IIF(LEN(LTRIM(lcPathPDF))#0,lcPathPDF,.objimpresor.pathpdf)
			
			this.verdto2 = IIF(lnCantBonifVisible >=2,.t.,.f.)
			this.verdto3 = IIF(lnCantBonifVisible >=3,.t.,.f.)
			this.kitbuscarProd.lhabilitarcodalfa = lnActivarCodArtProd
			This.objimpresor.MostrarCodArt = lnActivarCodArtProd
			.activoCbioUniVenta = lnCbioUniVenta
		ENDWITH
		
		
	ENDPROC

	PROCEDURE leerprefijoterminal		&& Leer archivo prefitermi para la terminal
		PARAMETERS lnidleer,lnidareaneg
		
		lnidareaneg = IIF(PCOUNT()<2,0,lnidareaneg)
		
		
		
		LOCAL lcCmd,lcAreaNeg
		
		
		*!*	TEXT TO lcCmd TEXTMERGE NOSHOW 
		*!*	Select Csrprefitermi.*,ISNULL(Csrprefijo.prefijo,-1) as prefijo,ISNULL(Csrprefijo.letra,' ') as letra
		*!*	,ISNULL(Csrprefijo.idimpresora,0) as idimpresora
		*!*	,ISNULL(CsrPrefijo.activocae,0) as activocae
		*!*	,ISNULL(CsrPrefijo.activocaea,0) as activocaea
		*!*	,ISNULL(Csrimpresora.nombre,SPACE(40)) as nomimpresora,ISNULL(Csrimpresora.tipo,0) as tipoimpresora
		*!*	,ISNULL(Csrimpresora.modelofis,0) as modelofis
		*!*	,ISNULL(Csrimpresora.puerto,0) as puerto,ISNULL(Csrimpresora.direccionip,SPACE(20)) as direccionip
		*!*	,ISNULL(Csrimpresora.portname,SPACE(40)) as nompuerto
		*!*	,ISNULL(Csrprefijo.nroautoma,-1) as nroautomatico
		*!*	from prefitermi as Csrprefitermi
		*!*	left join prefijonro as Csrprefijo on Csrprefitermi.idprefijonro = Csrprefijo.id
		*!*	left join impresora as Csrimpresora on ISNULL(Csrprefijo.idimpresora,0) = Csrimpresora.id 
		*!*	where Csrprefitermi.idterminal = <<lnidleer>> and ISNULL(Csrprefijo.nroautoma,-1) = <<thisform.lnnroautomatico>>
		*!*	ENDTEXT
		
		*!*	IF !thisform.obtenerdatos('Csrprefitermi',lccmd)
		*!*	   thisform.Release
		*!*	ENDIF
		
		lcAreaNeg = ""
		IF lnidareaneg > 0
			lcAreaNeg = " and CsrAreaNegTermi.idareaneg = " + str(lnidareaneg)
		ENDIF 
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select CsrSeteoTermi.id as idterminal,CsrPrefiTermi.*
		,ISNULL(Csrprefijo.prefijo,-1) as prefijo,ISNULL(Csrprefijo.letra,' ') as letra
		,ISNULL(Csrprefijo.idimpresora,0) as idimpresora
		,ISNULL(CsrPrefijo.activocae,0) as activocae
		,ISNULL(CsrPrefijo.activocaea,0) as activocaea
		,ISNULL(Csrimpresora.nombre,SPACE(40)) as nomimpresora,ISNULL(Csrimpresora.tipo,0) as tipoimpresora
		,ISNULL(Csrimpresora.modelofis,0) as modelofis
		,ISNULL(Csrimpresora.puerto,0) as puerto,ISNULL(Csrimpresora.direccionip,SPACE(20)) as direccionip
		,ISNULL(Csrimpresora.portname,SPACE(40)) as nompuerto
		,ISNULL(Csrprefijo.nroautoma,-1) as nroautomatico
		from seteotermi as CsrSeteoTermi
		inner join areanegtermi as CsrAreaNegTermi on CsrSeteoTermi.id = CsrAreaNegTermi.idterminal
		inner join prefineg as CsrPrefiTermi on CsrAreaNegTermi.idareaneg = CsrPrefitermi.idareaneg
		left join prefijonro as Csrprefijo on  CsrPrefiTermi.idprefijonro = Csrprefijo.id
		left join impresora as Csrimpresora on ISNULL(Csrprefijo.idimpresora,0) = Csrimpresora.id 
		where CsrSeteoTermi.id = <<lnidleer>> and ISNULL(Csrprefijo.nroautoma,-1) = <<thisform.lnnroautomatico>> and CsrAreaNegTermi.estado = 0
		<<lcAreaNeg>>
		ENDTEXT
		=SaveSQL(lcCmd,this.Name+"_leerprefijo")
		IF NOT CrearCursorAdapter('CsrPrefiTermi',lcCmd)
		   thisform.Release
		ENDIF
		
		
	ENDPROC

	PROCEDURE leerproximonro		&& Genera proximo nro comprobante
		PARAMETERS lnidleer,llupdate,llCbioLetra
		
		llCbioLetra = IIF(PCOUNT()<3,.t.,llCbioLetra)
		
		LOCAL lcidprefijos,lnidprefijo,lcCmd,ldebociclar
		
		WITH thisform
			*.agregaobjeto.letractacte(CsrAuxcabefac.idtipoiva)
			*''
			.oreGFACVTA.letraiva(CsrAuxcabefac.idtipoiva)
			
			IF CSRCOMPROBANTE.CLASE$"ABCU" 
				*''
				SELECT CSRSETEOTERMI
				LOCATE FOR IDCOMPROBA=CSRCOMPROBANTE.ID AND LETRA=.LCLETRA AND IDTERMINAL = .LNIDTERMINAL AND PREFIJO = .TALONARIO
				*.TALONARIO     = CSRSETEOTERMI.PREFIJO
				.PUESTOSPOOLER = CSRSETEOTERMI.PUESTOSPOOLER
			ENDIF
			
			lcidprefijos = ''
			lencontrado = .f.
			SELECT Csrprefitermi
			GO top
			SCAN FOR !EOF()
			     IF idcomproba=lnidleer
			        lcidprefijos = lcidprefijos + '-'+STRID(idprefijonro)
			     ENDIF 
			     IF idcomproba=lnidleer AND letra=this.lcLetra
			     	&&Verificamos si esta fac electronica activa
			     	IF this.oFaCCAE.es_cae AND this.lcLetra$'AB'
						IF NOT this.oFaCCAE.es_caea 
							if NVL(Csrprefitermi.activocae,0)=0
								LOOP 
							endif    
						ELSE
							if NVL(Csrprefitermi.activocaea,0)=0
								LOOP 
							endif  
						ENDIF 
					ELSE
					ENDIF 				
					*this.Talonario = prefijo
					*cTalonario = strzero(this.Talonario,4)
					cTalonario = strzero(prefijo,4)
					for i=1 to .containerencabeza._cboptovta.listcount
						if .containerencabeza._cboptovta.list(i) = cTalonario
							lencontrado=.t.
							this.Talonario = prefijo
							exit
						endif
					next   
				ENDIF 
			ENDSCAN 
		
			*
			lcCmd = "select Csrprefijonro.* from prefijonro as Csrprefijonro where letra= '"+.lcLetra+"' AND PREFIJO=" + STR(.TALONARIO)
			IF !.obtenerdatos('Csrprefijonro',lccmd)
			   Oavisar.usuario('NO PUEDE LEER EL PREFIJO ESPECIFICADO '+CHR(13)+"LETRA "+.lcLetra+" PVTA" + STR(.talonario),0)
			   RETURN .f. 
			ENDIF
		
			lnidprefijo = 0
			llPrefiAutomatico = .t.
			SELECT Csrprefijonro
			GO top
			SCAN FOR !EOF()
			     IF STRID(id)$lcidprefijos AND letra=.lcletra AND PREFIJO=.TALONARIO
			     	SELECT Csrprefitermi
			     	LOCATE FOR idprefijonro = CsrPrefijoNro.id
			     	IF  Csrprefitermi.nroautomatico = thisform.lnnroautomatico
			        	lnidprefijo = Csrprefijonro.id
			        ELSE
			        	llPrefiAutomatico = .f.
			        ENDIF 
			        exit
			     ENDIF 
			ENDSCAN 
			
			IF NOT llPrefiAutomatico
				 =Oavisar.usuario('NO ES POSIBLE ESTABLECER EL PROXIMO NUMERO'+chr(13);
				              +'DEBE ASIGNAR COMO NRO.AUTOMATICO AL COMPROBANTE'+CHR(13)+CHR(13);
				              +'ARCHIVOS GENERALES \\ ABM DE PREFIJOS COMPROBANTES',0)
			   .salirigual = .t.
			   .ultimocontainer="CONTAINERINGRESO"	              
			   .k_escape()              
			   RETURN .f.
			ENDIF 
			
			IF .talonario=0 AND LLUPDATE
			   =Oavisar.usuario('NO ES POSIBLE ESTABLECER EL PROXIMO NUMERO'+chr(13);
				              +'DEBE DEFINIR PUNTO DE VENTA POR DEFECTO'+CHR(13)+CHR(13);
				              +'UTILES \\ PARAMETROS \\ PARAMETROS GENERALES',0)
			   .salirigual = .t.	              
			   .ultimocontainer="CONTAINERINGRESO"	              
			   .k_escape()              
			   RETURN .f.
			ENDIF
		
			IF .lnnroautomatico=1 AND lnidprefijo=0 AND LLUPDATE
			   =Oavisar.usuario('NO ES POSIBLE ESTABLECER EL PROXIMO NUMERO'+chr(13);
				              +'DEBE ASIGNAR UN PUNTO DE VENTA AL COMPROBANTE'+CHR(13)+CHR(13);
				              +'ARCHIVOS GENERALES \\ ABM DE PREFIJOS COMPROBANTES',0)
			   .salirigual = .t.
			   .ultimocontainer="CONTAINERINGRESO"	              
			   .k_escape()              
			   RETURN .f.
			ENDIF
		
			IF .lnnroautomatico=1 AND llupdate
		
				cCmdText = "UPDATE prefijonro SET numero = numero + 1 where id ="+STRID(lnidprefijo) + " and letra= '"+.lcLetra+"' and prefijo=" + STR(.talonario)
				  
				Oca = Ocmd
				Oca.commandtext = cCmdText
				Oca.commandtype = 1
		
				LOCAL loCatchErr As Exception
				ldebociclar = .t.
				DO WHILE ldebociclar 
				   ldebociclar = .f.
					TRY 
					  Oca.execute()
					CATCH TO loCatchErr
				*!*		  IF AERROR(laError) > 0
				*!*			  =Oavisar.usuario("Error al obtener datos:"+laError[2],0)
				*!*		  ENDIF
				 	  ldebociclar = .t.
					ENDTRY   
				ENDDO 
				
			ENDIF
		
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			Select Csrprefijonro.*,Csrformulario.diseno as diseno
			from prefijonro as Csrprefijonro
			left join formulario as Csrformulario on Csrprefijonro.formulario = Csrformulario.id
			where Csrprefijonro.id =<<lnidprefijo>>
			ENDTEXT
		
			IF !.obtenerdatos('Csrprefijonro',lccmd)
			   Oavisar.usuario('NO PUEDE LEER EL PREFIJO ESPECIFICADO '+STRID(lnidprefijo),0)   
			   .Release
			ENDIF
		
			lnsumo=IIF(llupdate,0,1)
		
			IF .lnnroautomatico=1 AND .accion$"AR"
			   .proximonro  = Csrprefijonro.letra+strzero(Csrprefijonro.prefijo,4)+strzero(Csrprefijonro.numero+lnsumo,8)
			ELSE
			   IF !llupdate        
			      .proximonro  = .lcletra + strzero(.talonario,4) + strzero(.containerencabeza._txtnumcomp.Value,8)
			   ENDIF    
			ENDIF
		
			SELECT Csrprefitermi
			LOCATE FOR idprefijonro = lnidprefijo
			
			.oFACCAE.nidprefijonro = lnidprefijo
			.idimpresora = Csrprefijonro.idimpresora
			.formulario  = VAL(Csrprefijonro.diseno)
			.lcimpresora = IIF(LEN(TRIM(Csrprefitermi.nompuerto))#0,Csrprefitermi.nompuerto,Csrprefitermi.nomimpresora)
			.copiastkt   = Csrprefijonro.copias
			.canlinea    = Csrprefijonro.cantlinea
			
			.talonario = csrprefijonro.prefijo
			.containerencabeza._txtptovta.Value = strzero(csrprefijonro.prefijo,4)
			
		*!*		IF LEN(LTRIM(.containerencabeza._txtremito.Value))=0
		*!*			.containerencabeza._txtremito.Value = LEFT(.proximonro,1)+' '+RIGHT(LEFT(.proximonro,5),4)+'-'+RIGHT(.proximonro,8)
		*!*		ENDIF 
			
		ENDWITH 
	ENDPROC

	PROCEDURE leerproximoremito
		&&Buscamos cual es el proximo nro para los remitos de entrega que 
		
		lnIdComprobante = CsrComprobante.id
		
		SELECT CsrComprobante
		LOCATE FOR clase='8'
		IF CsrComprobante.id = 0
			oavisar.usuario('NO ESTA DISPONIBLE EL COMPROBANTE TIPO REMITO DE ENTREGA'+CHR(13)+'VERIFIQUE LOS COMPROBANTES HABILITADOS')
			RETURN ''
		ENDIF 
		
		thisform.leerproximonro(Csrcomprobante.id,.f.,.f.) 
		
		lcNroRemito = thisform.proximonro
		lcNroRemito = LEFT(lcNroRemito,1) + " " + RIGHT(LEFT(lcNroRemito,5),4) + "-"+RIGHT(lcNroRemito,8)
		
		&&Volvemos a cargar el comprobante actual para la conf de la impresora
		SELECT CsrComprobante
		LOCATE FOR id = lnIdComprobante
		thisform.leerproximonro(Csrcomprobante.id,.f.,.f.)
					
					
		RETURN lcNroRemito
	ENDPROC

	PROCEDURE leerseteoterminal		&& Leer archivo seteotermi
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		select distinct Csrprefijonro.*,CsrFormulario.diseno,ISNULL(Csrseteotermi.id,CAST(0 as numeric(12,0))) as idterminal
		,ISNULL(Csrprefitermi.idcomproba,CAST(0 as numeric(12,0))) as idcomproba,ISNULL(Csrimpresora.tipo,00) as tipoimpresora
		,ISNULL(Csrimpresora.nombre,SPACE(30)) as nombreimpresora,Csrseteotermi.sector
		,CsrSeteoTermi.puestocaja,ISNULL(Csrimpresora.idterminal,CAST(0 as numeric(12,0))) as PuestoSpooler
		from seteotermi as Csrseteotermi
		left join areanegtermi as CsrAreanegTermi on CsrSeteotermi.id = CsrAreaNegTermi.idterminal
		left join prefineg as Csrprefitermi on CsrAreaNegTermi.idareaneg = Csrprefitermi.idareaneg
		left join prefijonro as Csrprefijonro on Csrprefitermi.idprefijonro = Csrprefijonro.id
		left join impresora as Csrimpresora on Csrprefijonro.idimpresora = Csrimpresora.id
		left join formulario as Csrformulario on Csrprefijonro.formulario = CsrFormulario.numero
		where CsrSeteotermi.numero = <<goapp.terminal>>
		ENDTEXT	
		=CrearCursorAdapter('Csrseteotermi',lccmd)
		thisform.lnidterminal   = Csrseteotermi.idterminal
		thisform.sectorterminal = Csrseteotermi.sector
		thisform.puestocaja     = Csrseteotermi.puestocaja
		thisform.puestospooler = CsrSeteotermi.puestospooler
		
		IF thisform.lnidterminal=0
		   thisform.Release 
		ENDIF
		
		RETURN .t.
	ENDPROC

	PROCEDURE limpiarcursor		&& Limpia los cursores despues de grabar
		PARAMETERS lbInsertarCursor
		lbInsertarCursor = IIF(PCOUNT()<1,.t.,lbInsertarCursor)
		
		thisform.containerencabeza.lblvale.Caption=''
		WITH thisform
			.copiandocomprobante=.f.
		    .iniciavariables()
		    
		   	.limpiarDatos()
		   	
			IF lbInsertarCursor
				.insertacursor()
			ENDIF 
			.leercomprobante()
			.lhayvariedad = .f.
			.ponerpantallamodoedicion()
			
			*.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
			*.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.Click()
		ENDWITH
		
	ENDPROC

	PROCEDURE limpiardatos
		 LOCAL cCmd
		 
		oCa = thisform.obtenercursor('CsrMaopera')
		cCmd = oca.SelectCmd
		this.obtenerdatos('CsrMaopera',cCmd)
		
		oCa = thisform.obtenercursor('CsrCabefac')
		cCmd = oca.SelectCmd
		this.obtenerdatos('CsrCabefac',cCmd)
		
		oCa = thisform.obtenercursor('CsrMovCtacte')
		cCmd = oca.SelectCmd
		this.obtenerdatos('CsrMovCtacte',cCmd)
			
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		thisform.crearcursor()
	ENDPROC

	PROCEDURE muestracomprobante		&& muestra el comprobante elegido para modificar o borrar
		PARAMETERS lcidmaopera
		
		LOCAL lcCmd,Oscatter,OscatterCab,lok
		
		lcidmaopera = CHRTRAN(lcidmaopera,",","")
		
		lndecimaluni = thisform.ndecimaluni
		lndecimaltot = thisform.ndecimaltot
		lok          = .f.
		
		SET SAFETY OFF 
		
		SELECT CsrAuxmaopera
		ZAP
		
		SELECT CsrAuxCabefac
		ZAP 
		
		SELECT CsrauxCuerfac
		ZAP
		
		SELECT CsrAuxCuerVari
		ZAP
		
		SET SAFETY ON
		
		
		
		DO case
			* facturacion, premios
			CASE thisform.tipoform$"FPD"
				* maopera
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT Csrmaopera.*,ISNULL(Csrdetanrocaja.nrocaja,0) as nrocaja,ISNULL(CsrUsuarios.nombre,SPACE(15)) as NomOpera
				,'00' as clasetipo
				from maopera as Csrmaopera
				left join detanrocaja as Csrdetanrocaja on Csrmaopera.iddetanrocaja = Csrdetanrocaja.id
				left join usuarios as CsrUsuarios on CsrMaopera.idoperador = CsrUsuarios.id
				where Csrmaopera.id = <<lcidmaopera>>
				ENDTEXT 
				
		        lok=thisform.obtenerdatos('Csrmaopera',lccmd)
		        
			CASE thisform.tipoform$"N"
				* nmaopera
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT Csrnmaopera.*,ISNULL(Csrdetanrocaja.nrocaja,0) as nrocaja,'00' as clasetipo
				from Nmaopera as Csrnmaopera
				left join detanrocaja as Csrdetanrocaja on CsrNmaopera.iddetanrocaja = Csrdetanrocaja.id
				where Csrnmaopera.id = <<lcidmaopera>>
				ENDTEXT 	
				
		        lok=thisform.obtenerdatos('Csrnmaopera',lccmd)
		
		ENDCASE
		
		IF !lok
		  RETURN .f.
		ENDIF
		
		IF thisform.tipoform$"FPD"
			SELECT Csrmaopera
		ELSE
			SELECT CsrNmaopera
		ENDIF
		
		GO TOP 
		SCATTER NAME Oscatter
			   
		SELECT CsrAuxmaopera
		APPEND BLANK
		GATHER NAME Oscatter		
		
		DO case
			CASE thisform.tipoform$"FPD" 
				* Cabefac
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT Csrcabefac.* from cabefac as Csrcabefac where Csrcabefac.idmaopera in (<<lcidmaopera>>)
				order by id
				ENDTEXT 
				IF !thisform.obtenerdatos('Csrcabefac',lccmd)
				  RETURN .f.
				ENDIF
				
				SELECT CsrAuxCabefac
				SCATTER NAME OscatterCab
		
				SELECT CsrCabefac
				SCATTER NAME OscatterCab ADDITIVE 
				OscatterCab.vencimien = OscatterCab.fecha
				OscatterCab.proximonro = Oscatter.numcomp
				
				* Datos del detalle
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT Csrcabedeta.* from cabedeta as Csrcabedeta 
				where Csrcabedeta.idmaopera in (<<lcidmaopera>>)
				order by id
				ENDTEXT 
				IF !thisform.obtenerdatos('Csrcabedeta',lccmd)
				  RETURN .f.
				ENDIF
				SELECT CsrCabeDeta
				GO TOP 
				SCAN 
					lcSwitch = IIF(ISNULL(CsrCabeDeta.switch),'00000',CsrCabeDeta.switch)
					DO CASE 
						CASE LEFT(lcswitch,1)$'0'
							OscatterCab.detalle = CsrCabeDeta.detalle
						CASE LEFT(lcswitch,1)$'1'
							OscatterCab.detaref = CsrCabeDeta.detalle
						CASE LEFT(lcswitch,2)$'20'
							OscatterCab.detacobranza = CsrCabeDeta.detalle
						CASE LEFT(lcswitch,2)$'21'
							OscatterCab.transporte = CsrCabeDeta.detalle
					ENDCASE 
				ENDSCAN 
			
				* Datos rendicion - Gabriel
				*Modfic marcos. switch que indica si la rendici'on es de caja y no de repartidor. En caso de caja se puede anular.
				TEXT TO lcCmd TEXTMERGE NOSHOW 		
				select csrvendedor.nombre as vendedor ,isnull(csrfletero.nombre,'Sin fletero') as fletero,csrcabefac.rendida,isnull(csrfleteren.numero,0) as rendicion
				,isnull(csrfleteren.fecha,'') as fecha, RIGHT(LEFT(ISNULL(CsrFleteRen.switch,'00'),2),1) as rendicaja from maopera as csrmaopera
				left join cabefac as csrcabefac on csrmaopera.id=csrcabefac.idmaopera
				left join renmaope as csrrenmaope on csrmaopera.id=csrrenmaope.idmaopera
				left join fleteren as csrfleteren on csrfleteren.id=csrrenmaope.idfleteren
				left join vendedor as csrvendedor on csrvendedor.id=csrmaopera.idvendedor
				left join fletero as csrfletero on csrfletero.id=csrfleteren.idfletero
				where Csrcabefac.idmaopera in (<<lcidmaopera>>)
				ENDTEXT 
				=CrearCursorAdapter('Csrdatosren',lccmd)
				SELECT csrdatosren
				
				OscatterCab.rendicaja = CsrDatosRen.rendicaja
				
				&&Traemos el movctacte para ver las cuotas a cargar al pie del la factura.
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT CsrMovCtacte.vencimien as fecha,CsrMovCtacte.importe FROM MovCtacte as CsrMovCtacte
				where idmaopera in (<<lcidmaopera>>)
				ENDTEXT 
				IF NOT CrearCursorAdapter('CsrCuotas',lcCmd)
					thisform.release
				ENDIF 
				LOCAL aPieCuota[9],nCuota
				nCuota = 1
				FOR i=1 TO 9
					aPieCuota[i] = ""
				ENDFOR 
				SELECT CsrCuotas
				GO TOP 
				OscatterCab.vencimien = CsrCuotas.fecha
				DO WHILE ncuota <= 9 AND NOT EOF()
					IF ncuota < 9
						SET CENTURY ON 
						
						aPieCuota[ncuota] = DTOC(TTOD(CsrCuotas.fecha)) + " $"+strtrim(CsrCuotas.importe,8,2)
						
						SET CENTURY OFF 
					ELSE
						aPieCuota[ncuota] = " + cuotas"
					ENDIF 
					ncuota = ncuota + 1
					SET CENTURY OFF  
		
					SKIP IN CsrCuotas          
				ENDDO 
				OscatterCab.detapiecuota01 = aPieCuota[1]
				OscatterCab.detapiecuota02 = aPieCuota[2]
				OscatterCab.detapiecuota03 = aPieCuota[3]
				OscatterCab.detapiecuota04 = aPieCuota[4]
				OscatterCab.detapiecuota05 = aPieCuota[5]
				OscatterCab.detapiecuota06 = aPieCuota[6]
				OscatterCab.detapiecuota07 = aPieCuota[7]
				OscatterCab.detapiecuota08 = aPieCuota[8]
				OscatterCab.detapiecuota09 = aPieCuota[9]
				
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT CsrTipoCbte.* FROM AfipComproba as CsrTipoCbte WHERE id = <<NVL(OscatterCab.idtipocbte,0)>>
				ENDTEXT 
				=CrearCursorAdapter('CsrTipoCbte',lccmd)
				SELECT CsrTipoCbte
				OscatterCab.tipocbte = strzero(NVL(CsrTipoCbte.codafip,0),2)
				USE IN CsrTipoCbte
				
				IF LEN(CsrCabefac.cae)<>0
					this.lblCAEA.Caption = "CAE / CAEA: "+CsrCabefac.cae
				ENDIF 
				
				SELECT CsrCategoiva
				LOCATE FOR id = OscatterCab.idtipoiva		
				OscatterCab.categoiva = CsrCategoiva.abrevia
				
			CASE thisform.tipoform$"N"
				* NCabefac
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT CsrNcabefac.* from Ncabefac as CsrNcabefac where CsrNcabefac.idmaopera in (<<lcidmaopera>>)
				ENDTEXT 
				IF !thisform.obtenerdatos('CsrNcabefac',lccmd)
				  RETURN .f.
				ENDIF
				
				SELECT CsrAuxCabefac
				SCATTER NAME OscatterCAb
		
				SELECT CsrNCabefac
				SCATTER NAME OscatterCab ADDITIVE 
				OscatterCab.vencimien = OscatterCab.fecha
				OscatterCab.detaref			= NVL(OscatterCab.detaref,"")	
				OscatterCab.detacobranza	= NVL(OscatterCab.detacobranza,"")
		ENDCASE
		        
		SELECT CsrAuxCabefac
		APPEND BLANK
		GATHER NAME OscatterCab
		*vista()
		
		* bonificacion por cliente / producto
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Csrbonirubro.* from bonirubro as Csrbonirubro
		where Csrbonirubro.idctacte =<<CsrAuxCabefac.idctacte>>
		ENDTEXT 
		
		IF !CrearCursorAdapter('CsrboniRubro',lccmd)
		   thisform.Release 
		ENDIF  
		
		*thisform.agregaobjeto.letractacte(CsrAuxcabefac.idtipoiva)
		thisform.oreGFACVTA.letraiva(CsrAuxcabefac.idtipoiva)
		
		lccuit = STRTRAN(CsrAuxcabefac.cuit,"-","")
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select CsrcateCtaCte.*,CAST(0 as numeric(8,3)) as porperce,CAST(0 as numeric(8,3)) as porrete
		from cateCtaCte as CsrcateCtaCte 
		where CsrcateCtaCte.id = <<OscatterCab.idcategoria>>
		ENDTEXT 
		
		=CrearCursorAdapter('CsrCateCtaCte',lccmd)
		
		lcaliascateibto= ""
		STORE 0 TO lnporperce,lnporrete
		
		thisform.agregaobjeto.objobteneribto(lccuit,OscatterCab.idprovincia,@lcaliascateibto,@lnporperce,@lnporrete)
		
		IF RECCOUNT("CsrCateCtaCte")#0
			REPLACE porperce WITH lnporperce,porrete WITH lnporrete IN CsrCateCtacte
		ENDIF 
		
		SELECT CsrProvincia
		LOCATE FOR id = OscatterCab.idprovincia
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrCanalVta.* FROM Ctacte as CsrCtacte INNER JOIN CanalVta as CsrCanalVta ON csrCtacte.idcanalvta = CsrCanalVta.id
		WHERE CsrCtacte.id = <<CsrAuxCabefac.idctacte>>
		ENDTEXT 
		=CrearCursorAdapter('CsrAuxCanalCtacte',lcCmd)
		IF RECCOUNT('CsrAuxCanalCtacte')<>0
			replace canalvta WITH CsrAuxCanalCtacte.nombre IN CsrAuxCabefac
		ENDIF 
		USE IN CsrAuxCanalCtacte
		
		
		WITH thisform
		
			STORE 0 TO lnBaseSubCiva,lnBaseDescuento,lnBaseinterno,lnBaseiva,lnBaseExe,lnBaseGra,lnBaseRetencion,lnTotNoCatego,lnTotalFac
			STORE 0 TO lnTotalPB1,lnTotalPB2,lnTasaIB1,lnTasaIB2,lnBaseSubSiva,lnBaseDescuentoSiva
			STORE 0 TO lnImpIG1,lnImpIG2,lnImpIG3,lnImpIG4,lnImpIG5
			STORE 0 TO lnTasaIG1,lnTasaIG2,lnTasaIG3,lnTasaIG4,lnTasaIG5
			STORE 0 TO nPerceIVA5329  
			STORE 0 TO lnTotalPI3,lnTotalPI1,lnTasaPI3,lnTasaPI1
			loObjiva       = null
			loObjRetencion = null
			
			IF .tipoform$"FPD"
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT (Case when Csrtablaimp.tipoconce='PB' AND Csrtablaimp.nombre='IBTO1' then Csrtablaimp.importe else cast(0 as numeric(12,2)) end) as TotalPB1
				,(Case when Csrtablaimp.tipoconce='PB' AND Csrtablaimp.nombre='IBTO2' then Csrtablaimp.importe else cast(0 as numeric(12,2)) end) as TotalPB2
		       		,(Case when Csrtablaimp.tipoconce='PB' AND Csrtablaimp.nombre='IBTO1' then Csrtablaimp.tasa else cast(0 as numeric(12,2)) end) as Tasaib1
				,(Case when Csrtablaimp.tipoconce='PB' AND Csrtablaimp.nombre='IBTO2' then Csrtablaimp.tasa else cast(0 as numeric(12,2)) end) as Tasaib2		
				,(Case when Csrtablaimp.tipoconce='PN' then Csrtablaimp.importe else cast(0 as numeric(12,2)) end) as TotalPN
				,(Case when Csrtablaimp.tipoconce='RB' then Csrtablaimp.importe else cast(0 as numeric(12,2)) end) as TotalRB
				,(case when CsrTablaimp.tipoconce='NG' then CsrTablaImp.importe else CAST(0 as numeric(12,2)) end) as TotalNG
				,(case when CsrTablaimp.tipoconce='IG' then CsrTablaImp.importe else CAST(0 as numeric(12,2)) end) as TotalIG
				,(case when CsrTablaimp.tipoconce='IG' then CsrTablaImp.tasa else CAST(0 as numeric(12,2)) end) as TasaIG
				,(case when CsrTablaimp.tipoconce='EX' then CsrTablaImp.importe else CAST(0 as numeric(12,2)) end) as TotalEX
				,(case when CsrTablaimp.tipoconce='II' then CsrTablaImp.importe else CAST(0 as numeric(12,2)) end) as TotalII
				,(case when CsrTablaimp.tipoconce in ('IG','PB','PN','RB','NG','IG','EX','II','PI') then  CAST(0 as numeric(12,2)) 
					else CsrTablaImp.importe end) as TotalNoCatego
				,((Case when Csrtablaimp.tipoconce='PI' AND Csrtablaimp.nombre like 'PIVA%' and ISNULL(Csrtablaimp.tasa,0)=3 then Csrtablaimp.importe  else cast(0 as numeric(12,2)) end)) as TotalPI3
				,((Case when Csrtablaimp.tipoconce='PI' AND Csrtablaimp.nombre like 'PIVA%' and ISNULL(Csrtablaimp.tasa,0)=1.5 then Csrtablaimp.importe  else cast(0 as numeric(12,2)) end)) as TotalPI1
				,((Case when Csrtablaimp.tipoconce='PI' AND Csrtablaimp.nombre like 'PIVA%' and ISNULL(Csrtablaimp.tasa,0)=3 then Csrtablaimp.tasa  else cast(0 as numeric(12,2)) end)) as TasaPI3
				,((Case when Csrtablaimp.tipoconce='PI' AND Csrtablaimp.nombre like 'PIVA%' and ISNULL(Csrtablaimp.tasa,0)=1.5 then Csrtablaimp.tasa else cast(0 as numeric(12,2)) end)) as TasaPI1
		
				from tablaimp as CsrTablaimp where idmaopera=<<lcidmaopera>>
				ENDTEXT
				=SaveSQL(lcCmd,This.Name+"_imp_f4")
				=CrearCursorAdapter('CsrAuxCursorAsto',lccmd)	
				
				.agregaobjeto.objimpuestovta(@loObjIva,@loObjRetencion)
				*stop()
				SELECT CsrAuxCursorAsto
				GO TOP
				SCAN 
		
		   		  	lnBaseSubCiva	= lnBaseSubCiva + CsrAuxCursorAsto.TotalNG + CsrAuxCursorAsto.TotalEx + CsrAuxCursorAsto.TotalIG + CsrAuxCursorAsto.TotalII
		   		  	lnBaseSubSiva	= lnBaseSubSiva + CsrAuxCursorAsto.TotalNG + CsrAuxCursorAsto.TotalEx + CsrAuxCursorAsto.TotalII
					lnBaseinterno	= lnBaseinterno + CsrAuxCursorAsto.TotalII
					lnBaseiva		= lnBaseiva + CsrAuxCursorAsto.TotalIG
					lnBaseExe		= lnBaseExe + CsrAuxCursorAsto.TotalEX
					lnBaseGra		= lnBaseGra + CsrAuxCursorAsto.TotalNG
					lnTotalPB1		= lnTotalPB1 + CsrAuxCursorAsto.TotalPB1 
					lnTotalPB2		= lnTotalPB2 + CsrAuxCursorAsto.TotalPB2 
					lnTasaIB1		= lnTasaIB1	+ CsrAuxCursorAsto.tasaIB1
					lnTasaIB2		= lnTasaIB2	+ CsrAuxCursorAsto.tasaIB2
					lnBaseRetencion	= lnBaseRetencion + CsrAuxCursorAsto.TotalRB 
					lnTotNoCatego	= lnTotNoCatego + CsrAuxCursorAsto.TotalNoCatego + CsrAuxCursorAsto.TotalPN
					lnTotalPI3		= lnTotalPI3+ CsrAuxCursorAsto.TotalPI3
					lnTotalPI1		= lnTotalPI1+ CsrAuxCursorAsto.TotalPI1 
					lnTasaPI3		= lnTasaPI3	+ CsrAuxCursorAsto.tasaPI3
					lnTasaPI1		= lnTasaPI1	+ CsrAuxCursorAsto.tasaPI1
				
					IF CsrAuxCursorAsto.tasaIG#0
						lnTasa		= CsrAuxCursorAsto.tasaIG
				        		lnCalculo	= ROUND(CsrAuxCursorAsto.TotalIG,lndecimaluni) 
		                			this.unitariofac.acumulaimpuesto(@loObjIva,"9999999999"+TRANSFORM(lntasa,"99.99"),0,lntasa,lnCalculo,"IVA "+TRANSFORM(lntasa,"99.99"),0)
					ENDIF 
					IF lnTotNoCatego#0
					   	thisform.unitariofac.Acumulaimpuesto(@loObjRetencion,"NOCATEGORI",0,0,lnTotNoCatego,"NO CATEGO.",0)
					ENDIF
					IF CsrAuxCursorAsto.TotalPB1#0
						lnTasa		= lnTasaIB1
				        		lnCalculo	= ROUND(CsrAuxCursorAsto.TotalPB1,lndecimaluni) 
		                			this.unitariofac.acumulaimpuesto(@loObjRetencion ,"IBTO1",0,lntasa,lnCalculo,"IBTO "+TRANSFORM(lntasa,"99.99"),0)
					ENDIF 
					IF CsrAuxCursorAsto.TotalPB2#0
						lnTasa		= lnTasaIB2
				        		lnCalculo	= ROUND(CsrAuxCursorAsto.TotalPB2,lndecimaluni) 
		                			this.unitariofac.acumulaimpuesto(@loObjRetencion ,"IBTO2",0,lntasa,lnCalculo,"IBTO "+TRANSFORM(lntasa,"99.99"),0)
					ENDIF 
					IF CsrAuxCursorAsto.TotalPI3#0
						lnTasa		= lnTasaPI3
				        		lnCalculo	= ROUND(CsrAuxCursorAsto.TotalPI3,lndecimaluni) 
		                			this.unitariofac.acumulaimpuesto(@loObjRetencion ,"PIVA"+TRANSFORM(lntasa,"99.99"),0,lntasa,lnCalculo,"PIVA "+TRANSFORM(lntasa,"99.99"),0)
		                			nPerceIVA5329 = nPerceIVA5329 + lnCalculo
					ENDIF 
					IF CsrAuxCursorAsto.TotalPI1#0
						lnTasa		= lnTasaPI1
				        		lnCalculo	= ROUND(CsrAuxCursorAsto.TotalPI1,lndecimaluni) 
		                			this.unitariofac.acumulaimpuesto(@loObjRetencion ,"PIVA"+TRANSFORM(lntasa,"99.99"),0,lntasa,lnCalculo,"PIVA "+TRANSFORM(lntasa,"99.99"),0)
		                			nPerceIVA5329 = nPerceIVA5329 + lnCalculo
					ENDIF 
					
				ENDSCAN  
				lnBaseRetencion  = lnTotalPB1 + lnTotalPB2 + lnBaseRetencion
				lnTotalFac		= lnBaseGra + lnBaseExe + lnBaseRetencion + lnTotNoCatego +lnBaseiva + lnBaseinterno + nPerceIVA5329 
				
		*!*			REPLACE retencion1 WITH lnTotalPB1,tasarete1 WITH lnTasaIB1	;
		*!*		   		,retencion2 WITH lnTotalPB2,tasarete2 WITH lnTasaIB2;
		*!*		   	   	,BaseExe WITH lnBaseExe,BaseInterno WITH lnBaseInterno;
		*!*		   		,BaseGra WITH lnBaseGra,BaseIva WITH lnBaseiva;
		*!*		   		,nomrete1 WITH "IBTO1",nomrete2 WITH "IBTO2";
		*!*		   		,SubtotCiva WITH lnBaseSubCiva,total WITH lnTotalFac ;
		*!*		   		,SubtotSiva WITH lnBaseSubSiva IN CsrAuxCabefac
		
				REPLACE  BaseExe WITH lnBaseExe,BaseInterno WITH lnBaseInterno;
			   		,BaseGra WITH lnBaseGra,BaseIva WITH lnBaseiva;
			   		,SubtotCiva WITH lnBaseSubCiva,total WITH lnTotalFac ;
			   		,SubtotSiva WITH lnBaseSubSiva IN CsrAuxCabefac
				replace PerceIVA5329 WITH NPerceIVA5329  IN CsrAuxCabefac
				
			   	REPLACE ivari1 WITH loObjIva.impuesto1,tasa1 WITH loObjIva.tasa1;
				  ,ivari2 WITH loObjIva.impuesto2,tasa2 WITH loObjIva.tasa2;
				  ,ivari3 WITH loObjIva.impuesto3,tasa3 WITH loObjIva.tasa3;
				  ,ivari4 WITH loObjIva.impuesto4,tasa4 WITH loObjIva.tasa4;
				  ,ivari5 WITH loObjIva.impuesto5,tasa5 WITH loObjIva.tasa5 IN CsrAuxCabefac
				  
				REPLACE  nomrete1 WITH loObjRetencion.nombre1,retencion1 WITH loObjRetencion.impuesto1,baserete1 WITH loObjRetencion.base1;
				   ,tasarete1 WITH loObjRetencion.Tasa1;
				   ,nomrete2 WITH loObjRetencion.nombre2,retencion2 WITH loObjRetencion.impuesto2,baserete2 WITH loObjRetencion.base2;
				   ,tasarete2 WITH loObjRetencion.Tasa2;
				   ,nomrete3 WITH loObjRetencion.nombre3,retencion3 WITH loObjRetencion.impuesto3,baserete3 WITH loObjRetencion.base3;
				   ,tasarete3 WITH loObjRetencion.Tasa3;
				   ,nomrete4 WITH loObjRetencion.nombre4,retencion4 WITH loObjRetencion.impuesto4,baserete4 WITH loObjRetencion.base4;
				   ,tasarete4 WITH loObjRetencion.Tasa4;
				   ,nomrete5 WITH loObjRetencion.nombre5,retencion5 WITH loObjRetencion.impuesto5,baserete5 WITH loObjRetencion.base5;
				   ,tasarete5 WITH loObjRetencion.Tasa5 IN CsrAuxCabefac
					
			ENDIF 	
			IF CsrAuxMaopera.clasecomp$"XH8"
				replace total WITH CsrCabefac.total IN CsrAuxCabefac
				lnBaseSubCiva	= CsrCabefac.total
				lnTotalFac		= CsrCabefac.total
			ENDIF 
			IF .tipoform$"N"
				lnTotalFac = CsrNCabefac.total
			ENDIF 
		   
			.containerencabeza._txtletra.Value   = left(CsrAuxmaopera.numcomp,1)
			.containerencabeza._txtptovta.value  = subs(CsrAuxmaopera.numcomp,2,4)
			.containerencabeza._txtnumcomp.Value = VAL(righ(CsrAuxmaopera.numcomp,8))
			.talonario 							 = VAL(.containerencabeza._txtptovta.value)
			.containerencabeza._txtptovta.Value  = VAL(.containerencabeza._cboptovta.List(.talonario))	
			.proximonro 						 = CsrAuxMaopera.numcomp	
		
		ENDWITH
		
		&&marcos 05/11/2013
		&&AL copiar un comprobante, en el muestracomprobante no se relaciona el idenvase (no existe en cuerfac/ncuerfac)
		&&Si se anulaba, la anulacion genera un contramovimiento por el maopera. (Correcto)
		&&Pero si se copiaba y no se pasaba por el produicto a modificar algo, este no refrescaba el idenvase
		*stop()
		thisform.orden  = 0
		DO CASE 
			CASE thisform.tipoform$"FPD"
				* Cuerfac
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT Csrcuerfac.* from Cuerfac as Csrcuerfac where Csrcuerfac.idmaopera in (<<lcidmaopera>>)
				order by id
				ENDTEXT 
				        
				IF !thisform.obtenerdatos('Csrcuerfac',lccmd)
				  RETURN .f.
				ENDIF
				
				&&Marcos 05/11/2013
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT CsrEnvase.id as idarticulo,CsrEnvase.idenvase,CsrEnvase.peso FROM Cuerfac as CsrCuerpo
				left join Producto as CsrEnvase on CsrCuerpo.idarticulo = CsrEnvase.id
				where Csrcuerpo.idmaopera in (<<lcidmaopera>>)
				ENDTEXT 
				IF NOT CrearCursorAdapter('CsrEnvase',lcCmd)
					thisform.Release
				ENDIF 
				
				&&Marcos 28/10/2022
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT CsrProducto.id as idarticulo,CsrProducto.nombulto,CsrProducto.codArtProd,CsrProducto.Peso FROM Cuerfac as CsrCuerpo
				left join Producto as CsrProducto on CsrCuerpo.idarticulo = CsrProducto.id
				where Csrcuerpo.idmaopera in (<<lcidmaopera>>)
				ENDTEXT 
				IF NOT CrearCursorAdapter('CsrControlador',lcCmd)
					thisform.Release
				ENDIF 
				
				
				SELECT CsrauxCuerfac
				SCATTER NAME Oscatter
		
				SELECT CsrCuerfac
				*vista()
				GO top
				*stop()
				SCAN FOR !EOF()
					SCATTER NAME Oscatter ADDITIVE 
					Oscatter.codextend = Oscatter.codigo
					
					SELECT CsrControlador
					LOCATE FOR idarticulo = Oscatter.idarticulo
					IF idarticulo = Oscatter.idarticulo
						Oscatter.nomcomandera = CsrControlador.nombulto
						Oscatter.codArtProd = CsrControlador.codArtProd
						Oscatter.PesoProd = CsrControlador.Peso
					ENDIF 
					SELECT CsrCuerfac
					
					lncantidad  = Oscatter.cantidad
					lnunibulto  = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
					lnuniventa  = Oscatter.univenta			
					lnunibulto  = IIF(lnuniventa=1,1,lnunibulto)
					lnCantFinal = IIF(lnCantidad=0,1,lnCantidad)
					
					lnCantidad        = lnCantidad / lnunibulto
					
					IF Oscatter.escambio = 1
						lncantidad = ABS(lnCantidad)
						Oscatter.preunita = 0
					ENDIF
					Oscatter.cantidad = lnCantidad
					
					lnpesable = Oscatter.pesable
					IF lnpesable = 0
						Oscatter.kilos    = 0&&Oscatter.kilos / lnCantFinal
					ENDIF 
					lnkilos = Oscatter.kilos
					Oscatter.cantkilos = lnkilos 
					Oscatter.volumen  = Oscatter.volumen / lnCantFinal
					
		
					thisform.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
					
					Oscatter.total = Red((IIF(this.incluyeiva,Oscatter.UniCiva,Oscatter.UniSiva) + Oscatter.internofin ),lndecimaltot)				
					
					IF Oscatter.escombo = 1
						Oscatter.idprodgenera = Oscatter.idprodcombo
					ENDIF 
								
					oscatter.hojaactual = CsrauxCabefac.hojaactual
					Oscatter.registro = RECNO()
					Oscatter.orden		= OScatter.registro
					
					thisform.orden = Oscatter.orden
					
					lnBaseDescuento  = lnBaseDescuento  + red(Oscatter.desctoCiva,lndecimaltot)
					lnBaseDescuentoSiva = lnBaseDescuentoSiva  + red(Oscatter.desctoSiva,lndecimaltot)
					
					&&Marcos 05/11/2013
					SELECT CsrEnvase
					LOCATE FOR idarticulo = Oscatter.idarticulo
					IF idarticulo = Oscatter.idarticulo
						Oscatter.idenvase = CsrEnvase.idenvase
						Oscatter.peso = CsrEnvase.peso
					ENDIF 
					
					SELECT CsrauxCuerfac
					APPEND BLANK
				    	GATHER NAME Oscatter 	      
				    
					SELECT CsrCuerfac	
				ENDSCAN
				USE IN CsrControlador
				
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				Select Csrcuervari.*,Csrsubproducto.nombre as nombre from cuervari as Csrcuervari
				left join subproducto as Csrsubproducto on Csrcuervari.idsubarti = Csrsubproducto.id		
				where Csrcuervari.idmaopera in (<<lcidmaopera>>)
				ENDTEXT 
				        
				IF !thisform.obtenerdatos('Csrcuervari',lccmd)
				  RETURN .f.
				ENDIF
		
			    	SELECT CsrCuerVari
			    	GO top
		        		SCAN FOR !EOF()
				 	SCATTER NAME Oscatter ADDITIVE 
					SELECT CsrAuxCuerfac
					LOCATE FOR id=Oscatter.idcuerfac
					IF id=Oscatter.idcuerfac
						lnunibulto = IIF(CsrAuxCuerfac.unibulto=0,1,CsrAuxCuerfac.unibulto)
						lnuniventa = CsrAuxCuerfac.univenta
						lnunibulto = IIF(lnuniventa=1,1,lnunibulto)
						lnCantFinal = IIF(Oscatter.cantidad=0,1,Oscatter.cantidad)
						Oscatter.cantidad = Oscatter.cantidad / lnunibulto
						Oscatter.kilos    = Oscatter.kilos / lnCantFinal
						Oscatter.volumen  = oscatter.volumen / lnCantFinal
						
						Oscatter.cantidad = ABS(Oscatter.cantidad)*IIF(Oscatter.escambio=0,1,-1)
						Oscatter.registro = CsrAuxCuerfac.registro
					ENDIF 
								
					SELECT CsrauxCuervari
					APPEND BLANK
				    GATHER NAME Oscatter 	      
				    
					SELECT CsrCuervari
				ENDSCAN	   
				
				SELECT CsrAuxCuerfac
				SET ORDER TO orden       
				*vista()
				SELECT CsrAuxCuerVari
				*vista()
				
			CASE thisform.tipoform="N"
				* NCuerfac
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT CsrNcuerfac.* from NCuerfac as CsrNcuerfac where CsrNcuerfac.idmaopera in (<<lcidmaopera>>)
				order by id
				ENDTEXT 
				        
				IF !thisform.obtenerdatos('CsrNcuerfac',lccmd)
				  RETURN .f.
				ENDIF
				
				&&Marcos 05/11/2013
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT CsrEnvase.id as idarticulo,CsrEnvase.idenvase FROM NCuerfac as CsrCuerpo
				left join Producto as CsrEnvase on CsrCuerpo.idarticulo = CsrEnvase.id
				where Csrcuerpo.idmaopera in (<<lcidmaopera>>)
				ENDTEXT 
				IF NOT CrearCursorAdapter('CsrEnvase',lcCmd)
					thisform.Release
				ENDIF 
				
				SELECT CsrauxCuerfac
				SCATTER NAME Oscatter
		
				SELECT CsrNCuerfac
				GO top
				SCAN FOR !EOF()
					SCATTER NAME Oscatter ADDITIVE 		
					Oscatter.codextend = Oscatter.codigo
						
					lncantidad = Oscatter.cantidad
					lnunibulto = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
					lnuniventa = Oscatter.univenta			
					lnunibulto = IIF(lnuniventa=1,1,lnunibulto)	   	      
					lnCantFinal = IIF(lnCantidad=0,1,lnCantidad)
					
					lnCantidad = lnCantidad / lnunibulto
					
					IF Oscatter.escambio = 1
						lncantidad = ABS(lnCantidad)
						Oscatter.preunita = 0
					ENDIF
					Oscatter.cantidad = lnCantidad
					
					lnpesable = Oscatter.pesable
					IF lnpesable = 0
						Oscatter.kilos    = Oscatter.kilos / lnCantFinal
					ENDIF 
					lnkilos = Oscatter.kilos
					Oscatter.cantkilos = lnkilos
					Oscatter.volumen  = Oscatter.volumen / lnCantFinal
					Oscatter.registro = RECNO()
					Oscatter.orden = Oscatter.registro
					thisform.orden = Oscatter.orden
					thisform.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
					
					Oscatter.total = Red((IIF(this.incluyeiva,Oscatter.UniCiva,Oscatter.UniSiva) + Oscatter.internofin ),lndecimaltot)				
					
					&&Marcos 05/11/2013
					SELECT CsrEnvase
					LOCATE FOR idarticulo = Oscatter.idarticulo
					IF idarticulo = Oscatter.idarticulo
						Oscatter.idenvase = CsrEnvase.idenvase
					ENDIF 
					
					SELECT CsrauxCuerfac
					APPEND BLANK
				    GATHER NAME Oscatter 	      
				    
					SELECT CsrNCuerfac
				ENDSCAN
		
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				Select CsrNcuervari.*,Csrsubproducto.nombre as nombre from Ncuervari as CsrNcuervari
				left join subproducto as Csrsubproducto on CsrNcuervari.idsubarti = Csrsubproducto.id		
				where CsrNcuervari.idmaopera in (<<lcidmaopera>>)
				ENDTEXT 
				        
				IF !thisform.obtenerdatos('CsrNcuervari',lccmd)
				  RETURN .f.
				ENDIF
		
			    SELECT CsrNCuerVari
			    GO top
		        SCAN FOR !EOF()
				 	SCATTER NAME Oscatter ADDITIVE 
				 	
					SELECT CsrAuxCuerfac
					LOCATE FOR id=Oscatter.idcuerfac
					IF id=Oscatter.idcuerfac
						lnunibulto = IIF(CsrAuxCuerfac.unibulto=0,1,CsrAuxCuerfac.unibulto)
						lnuniventa = CsrAuxCuerfac.univenta
						lnunibulto = IIF(lnuniventa=1,1,lnunibulto)
						lnCantFinal = IIF(Oscatter.cantidad=0,1,Oscatter.cantidad)
						Oscatter.cantidad = Oscatter.cantidad / lnunibulto
						Oscatter.kilos    = Oscatter.kilos / lnCantFinal
						Oscatter.volumen  = oscatter.volumen / lnCantFinal
						
						Oscatter.cantidad = ABS(Oscatter.cantidad)*IIF(Oscatter.escambio=0,1,-1)
						
						Oscatter.registro = CsrAuxCuerfac.registro
					ENDIF 
					
					SELECT CsrauxCuervari
					APPEND BLANK
				    GATHER NAME Oscatter 	      
				    
					SELECT CsrNCuervari
				ENDSCAN	   
		
		ENDCASE
		SELECT CsrAuxCuerfac
		*vista()
		
		&&Descuentos
		REPLACE BaseDescto WITH lnBasedescuento IN CsrAuxCabefac
		REPLACE BaseDesctoSiva WITH lnBasedescuentoSiva IN CsrAuxCabefac
		
		*Movbcocar
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrmovbcocar.*,CsrMovBcodeta.* from Movbcocar as CsrMovbcocar
		left join movbcodeta as CsrMovBcoDeta on CsrMovBcocar.id = CsrMovBcodeta.idmovbcocar
		where Csrmovbcocar.idmaopera in (<<lcidmaopera>>)
		ENDTEXT 
		
		=CrearCursorAdapter("Csrcursor",lccmd)
		
		IF USED("CsrPago")
			USE IN CsrPago
		ENDIF
		
		SELECT id as id,idmaopera as idmaopera,importe as importe,numero as nrocheque,idctabco as idctabco,banco as banco,localidad as localidad;
		,fechavto as fechavto,cuit as cuit,titular as titular,recibido as recibido,entregado as entregado,fecha as fecha;
		,000 as numero,SPACE(25) as cnombre,CAST(0 as int) as idcuenta,SPACE(6) as ctactebco,CAST(0 as int) as idtipobco;
		,CAST(0 as int) as idvalor,CAST(0 as int) as idprovincia,'  ' as tipocaja,' ' as esclase,SPACE(15) as nrotarjeta;
		,SPACE(15) as cupon,00 as cuota,SPACE(254) as idcheque ,SPACE(50) as detalle;
		,idbanco,idctaentrega as IdctaEntregado,idctarecibido,idctatitular,idlocalidad,codbarra as nroidentificador,cuit as lccuit;
		FROM Csrcursor INTO CURSOR CsrPago READWRITE 
		
		USE IN CsrCursor 
		
		*Nombre de la Provincia para la impresion.
		SELECT CsrProvincia
		replace nomProvincia WITH CsrProvincia.impabre IN CsrAuxCabefac
		
		*thisform.totalcomprobante()
		IF thisform.tipoform$"FMSN"
			WITH thisform.containertotales
				._txtsubtotal.Value		 = lnBaseSubCiva &&lnUnitotal
				._txtbonificacion.Value  = lnBasedescuentoSiva && lnBaseDescuento
				._txtinterno.Value		 = lnBaseinterno
				._txtiva.Value			 = lnBaseiva
				._txtnetoexento.Value	 = lnBaseExe
				._txtnetogravado.Value	 = lnBaseGra
				._txtpercepcion.Value	 = lnBaseRetencion
				._txtnocatego.value      = lnTotNoCatego
				._txttotal.Value		 = lnTotalFac
				._txtperceiva.Value	 = nPerceIVA5329 
			ENDWITH 
		ENDIF 
		
		
		SELECT CsrAuxCuerfac
		GO top
		
		* para que repinte el comprobante
		WITH thisform
			.traerproductofuerzavta(CsrAuxcabefac.idfuerzavta) 
			.traerproductosbloqueados()
			*.cmdplan_cbioestado()
			*&&''
			IF !this.oCONTABILIDAD.Validar()
				*=oavisar.usuario(this.oCONTABILIDAD.Cadenaerror,0)
				this.cmdBorrar.Visible = .f.
				this.cmdPlan.Visible = .f.
			ENDIF 
			.containerencabeza._cbocomprobante.SetFocus
			.containerencabeza._cbocomprobante.Click
			.Refresh
			
			replace saldocta WITH CsrCtacte.saldo IN CsrAuxCabefac &&No se refresco aun la csrctacte previamente
			
			.containeringreso.kitbuscaoaltaenFletero.txtexiste1.SetFocus
		ENDWITH 
		if thisform.tipoform$"FPD" 
			IF csrdatosren.rendida=0
			   	thisform.lblayudapie.Caption = "Estado : Sin Rendir"
			else
				thisform.lblayudapie.Caption = "RENDIDA : "+ALLTRIM(csrdatosren.fletero)+" Nº"+ALLTRIM(STR(csrdatosren.rendicion))+" "+DTOC(csrdatosren.fecha)
		 	ENDIF
		 	thisform.lblayudapie.Caption = thisform.lblayudapie.Caption+ " [Esc]Sale   [Insert]Copia"
		endif
		RETURN .t.
		
	ENDPROC

	PROCEDURE nuevoorden
		thisform.orden=thisform.orden+1
		RETURN thisform.orden
	ENDPROC

	PROCEDURE pidofinanciacion
	ENDPROC

	PROCEDURE pidototales
		WITH thisform
			.accion = "A"
			lok = .t.
		
		 	IF NOT .tipofactura$"M" &&Facturacion MANUAL
		 		RETURN .t.
		 	ENDIF 
		 	
		 	IF NOT RTRIM(CsrComprobante.clase)$'ABC'
		 		RETURN .t.
		 	ENDIF 
		 	
			SELECT CsrAuxCabefac
			SCATTER NAME OscCabefac
			
			oParametros= CREATEOBJECT("custom")
			oParametros.AddProperty('Comprobante',thisform.proximonro)
			oParametros.AddProperty('origen','VTA')
			
			DO FORM pidototalfac WITH oParametros,OscCabefac name LobjForm linked
			
			
			IF lobjform.quetecla<>27
				SELECT CsrAuxCabefac
				GATHER NAME OscCabefac
				*vista()
				
				**&&''
				STORE 0 TO lnBaseNocatego,lnBasePercep1,lnBasePercep2,lnBaseGra,lnBaseIva,lnBaseInterno,lnBasePerceIVA
				
				lnBaseGra		= OscCabefac.BaseGra1 + OscCabefac.BaseGra2 + OscCabefac.BaseGra3 + OscCabefac.BaseGra4 + OscCabefac.BaseGra5
				lnBaseIva		= red(OscCabefac.ivari1,lndecimaltot) + red(OscCabefac.ivari2,lndecimaltot) + red(OscCabefac.ivari3,lndecimaltot) + red(OscCabefac.ivari4,lndecimaltot) + red(OscCabefac.ivari5,lndecimaltot) 
				lnBaseInterno	= red(OscCabefac.BaseInterno,lndecimaltot)
				lnBaseExe		= red(OscCabefac.BaseExe,lndecimaltot)
				
				FOR i=1 TO 5
				    lcname = "OscCabefac.nomrete"+STR(i,1)
				    lcimpu = "OscCabefac.retencion"+STR(i,1)
					lnimporte   = &lcimpu
				    IF "IBTO1"$&lcname   				
						lnBasePercep1 = lnBasePercep1 +lnimporte
					ENDIF
					 IF "IBTO2"$&lcname   				
						lnBasePercep1 = lnBasePercep1 +lnimporte
					ENDIF
					 IF "NOCATEGORI"$&lcname   				
						lnBaseNocatego = lnBaseNocatego +lnimporte
					ENDIF
					 IF "PIVA"$&lcname   				
						lnBasePerceIVA= lnBasePerceIVA+lnimporte
					ENDIF
				NEXT 	
		
				
				lnBasePercepcion = lnBasePercep1 + lnBasePercep2
				
				lnBaseSubSiva  = lnBaseGra + lnBaseExe + lnBaseInterno
				lnBaseSubCiva  = lnBaseGra + lnBaseExe + lnBaseInterno + lnBaseIva 
				lnTotalFac     = lnBaseGra + lnBaseExe + lnBaseInterno + lnBaseIva + lnBasePercepcion + lnBaseNocatego +lnBasePerceIVA
				
				REPLACE BaseExe WITH lnBaseExe,BaseInterno WITH lnBaseInterno;
				   ,BaseGra WITH lnBaseGra,BaseIva WITH lnBaseiva,BaseNocatego WITH lnBaseNocatego,Perceibto1 WITH lnBasePercep1,Perceibto2 WITH lnBasePercep2;
				   ,SubtotSiva WITH lnBaseSubSiva,SubtotCiva WITH lnBaseSubCiva,total WITH lnTotalFac IN CsrAuxCabefac
				replace PerceIVA5329 WITH lnBasePerceIVA   IN CsrAuxCabefac
				 
				SCATTER NAME OscCabefac
				
				WITH thisform.containertotales
					._txtsubtotal.Value		 = OscCabefac.SubtotSiva
					._txtbonificacion.Value  = IIF(thisform.incluyeiva,OscCabefac.BaseDescto ,OscCabefac.BaseDesctoSiva)
					._txtinterno.Value		 = OscCabefac.BaseInterno
					._txtiva.Value			 = OscCabefac.BaseIva
					._txtnetoexento.Value	 = OscCabefac.BaseExe
					._txtnetogravado.Value	 = OscCabefac.BaseGra
					._txtpercepcion.Value	 = OscCabefac.Perceibto2 + OscCabefac.Perceibto1
					._txtnocatego.value      = OscCabefac.BaseNocatego
					._txttotal.Value		 = OscCabefac.total
					._txtperceiva.Value	 	 = (lnBasePerceIVA) 
					.refresh
				ENDWITH 
		
			ENDIF
		   
				
			loObjeto = null
			RELEASE lobjform
				
		
			RETURN lok
				
		ENDWITH 	  
	ENDPROC

	PROCEDURE pidovalores		&& llama al form para cargar los valores
		parameters lcaccion
		
		=CrearCursordbf('Csrpago')
		
		*!*	IF this.generandoloteremito &&Lote de pendientes no genera pagos.
		*!*		RETURN .t.
		*!*	ENDIF 
		
		local lcdias,i,lndias,lcclasevalor,ldfecha,lnimpcuota,lncuota,lntotcuota,lntotalcomp,lnimporte
		local lccid,lctipocaja,haycambios,lcidcliente,lcorigencta
		LOCAL lcclaseorig,lnimporte,lnidvalororig,lnidplanorig
		STORE 0 TO lnimporte
		
		replace detapiecuota01 WITH "", detapiecuota02 WITH "";
					, detapiecuota03 WITH "", detapiecuota04 WITH "" ;
					, detapiecuota05 WITH "", detapiecuota06 WITH "" ;
					, detapiecuota07 WITH "", detapiecuota08 WITH "", detapiecuota09 WITH "" IN CsrAuxCabefac
					
		lcidcliente = Csrauxcabefac.idctacte
		ldfecha     = TTOD(CsrAuxCabefac.fecha)
		ldfechavto = TTOD(CsrauxCabefac.vencimien)
		haycambios = .t.
		
		if lcaccion='A' or haycambios
			&&Marcos 2014/09/29
			&&Si se cargaron negociaciones para la cobranza, reemplazamos las cuotas del plan de pago
			lcdias = ""
			IF NOT this.pedirdetacobranza
				lcdias = CsrPlanpago.dias
			ELSE
				&&En caso del negociado, hay que armar la cadena con los dias, como esta en el plan de pago
				&&Para asi seguir haciendo el mismo procedimiento
				cCadNegociado = ""
				FOR i=1 TO CsrAuxCabefac.plancuota
					cCadNegociado  = cCadNegociado +IIF(LEN(cCadNegociado)!=0,"-","")+strzero(CsrAuxCabefac.planrango,3)
				ENDFOR 
				lcdias = cCadNegociado		
				replace detacobranza WITH lcdias IN CsrAuxCabefac 
			ENDIF 
			
			i=1
			lncuota = 0
			do while i <= len(lcdias)
				lndias = val(subs(lcdias,i,3))
			   	if len(trim(subs(lcdias,i,3)))<>0
			      	lncuota = lncuota + 1 
			   	endif   
			   	i=i+4
			enddo
			lntotalcomp = thisform.containertotales._txttotal.Value
			lnimpcuota = iif(lncuota=0,lntotalcomp,red(lntotalcomp/lncuota,2))
			lntotcuota = 0
		
			IF CsrComprobante.clase$'1' &&Remito 3ro. Simpre va a CONTADO PENDIENTE
				SELECT CsrPlanPago
				LOCATE FOR numero = 'CDP'
			ENDIF 
					
			SELECT Csrvalor
			LOCATE FOR id=Csrplanpago.idvalor
		
			lcclasevalor = Csrvalor.clasevalor
			
			SELECT Csrplancue
			LOCATE FOR id=CsrValor.idctaf
			lctipocaja = iif('C'$lcclasevalor,'CC','CA')   && ctacte, caja
			
			local lcidcuenta
			WITH thisform
				SELECT CsrParaConta
				LOCATE FOR numero = 2
				
			    lcidcuenta = IIF(!.cambiarcuenta(),CsrValor.idctaf,.lcidcuentad)
				lcidcuenta = IIF(lcidcuenta=0,CsrParaConta.idcuenta,lcidcuenta)
		    ENDWITH 
		    
		     		
		    IF lcidcuenta=0 
		   		Oavisar.usuario('NO SE ENCONTRO UNA CUENTA CONTABLE ASOCIADA AL VALOR ';
		   			+CHR(13)+'CONSUELTE ARCHIVOS GENERALES'+CHR(13)+'	ABM VALORES.';
		   			+CHR(13)+CHR(13)+'NO SE ENCONTRO UNA CUENTA CONTABLE PARA DEUDORES VARIOS ';
		   			+CHR(13)+'CONSUELTE ARCHIVOS GENERALES'+CHR(13)+'	ABM PARAMETROS CONTABLES',0)
		   		RETURN .f.
			ENDIF 
			&&Marcos 2014/09/29
			&&Si se cargaron negociaciones para la cobranza, reemplazamos las cuotas del plan de pago
			i=1
			*stop()
			ldfecha     = TTOD(CsrAuxCabefac.fecha)
			ldfechavto = TTOD(CsrAuxCabefac.vencimien )
			IF ldfecha  = ldfechavto 
				do while i <= len(lcdias)
					lndias = val(subs(lcdias,i,3))
				   	if len(trim(subs(lcdias,i,3)))=0 
				      	i=i+4
				      	loop
				   	endif
					
				   	lccid = i
		
				   	Insert into Csrpago (numero,cnombre,fecha,importe,idcuenta,ctactebco,idprovincia,titular,banco;
				              ,localidad,nrocheque,fechavto,entregado,idvalor,idtipobco,tipocaja,idctabco,esclase,recibido;
				              ,idlocalidad,idbanco,idctatitular,idctaentregado,idctarecibido,nroidentificador);
				          Value (Csrvalor.numero,Csrvalor.nombre,ldfechavto+lndias,lnimpcuota,lcidcuenta;
				              ,"",0,CsrAuxCabefac.cnombre,"","",0,ldfechavto+lndias,CsrAuxCabefac.cnombre,Csrplanpago.idvalor,0;
				              ,lctipocaja,0,lcclasevalor,CsrAuxCabefac.cnombre,0,0,CsrAuxCabefac.idctacte,CsrAuxCabefac.idctacte;
				              ,0,"")
				              
				      ldfechavto = ldfechavto + lndias     
				   	lntotcuota=lntotcuota + lnimpcuota
				   	i=i+4            
				ENDDO
			ENDIF 
			&&Si el plan no tiene dias, entonces tomamos la fecha de vencimiento del cabefac.
			ldfechavto = TTOD(CsrauxCabefac.vencimien)
			Sele Csrpago
			go top
			if eof()
			   lccid = 1
			   Insert into Csrpago (numero,cnombre,fecha,importe,idcuenta,ctactebco,idprovincia,titular,banco;
			               ,localidad,nrocheque,fechavto,entregado,idvalor,idtipobco,tipocaja,idctabco,esclase,recibido;
			                ,idlocalidad,idbanco,idctatitular,idctaentregado,idctarecibido,nroidentificador);
			          Value (Csrvalor.numero,Csrvalor.nombre,ldfechavto,lntotalcomp,lcidcuenta;
			              ,"",0,"","","",0,ldfechavto,CsrAuxCabefac.cnombre,Csrplanpago.idvalor,0,lctipocaja,0,lcclasevalor;
			              ,CsrAuxCabefac.cnombre,0,0,CsrAuxCabefac.idctacte,CsrAuxCabefac.idctacte,0,"")
			else              
			   if lntotcuota<>lntotalcomp
			      go top
			      lnimporte = (lntotalcomp-lntotcuota)
			      lnimporte = iif(importe=0,lntotalcomp,(importe+lnimporte))
			      repl importe with lnimporte
			   endif
			endif
			go top
		endif
		
		store "" to lcid,lcsalidavalida
		public pndatasessionid
		pndatasessionid = thisform.datasessionid
		
		* lcclasevalor
		*!*	P	CHEQUE PROPIO                 
		*!*	F	CONTADO PENDIENTE             
		*!*	C	CUENTA CORRIENTE              
		*!*	H	CREDITOS BANCARIOS            
		*!*	G	TARJETA PROPIA
		
		&&TAPADO EL 28/07/2011 PARA QUE DEJE PASAR COMPROBANTES EN ZERO
		
		*!*	IF lntotalcomp=0 AND thisform.tipoform="N"
		*!*		=Oavisar.usuario("Va a cerrar el comprobante en cero",0)
		*!*	ELSE
		*!*		IF lntotalcomp=0 
		*!*			=Oavisar.usuario("No puede cerrar el comprobante en cero",0)
		*!*			RETURN .f.	   
		*!*		ENDIF 		
		*!*	ENDIF
		
		IF this.generandoloteremito &&Lote de pendientes no genera pagos. Se saca aca, pq necesito haber cargado las cuentas contables.
			RETURN .t.
		ENDIF 
		
		IF haycambios AND thisform.tipoform#"N" and !lcclasevalor$'CF' AND lntotalcomp#0    
		
		   	SELECT Csrvalor.* FROM Csrvalor WHERE regisf=1 AND !clasevalor$'CFGHP' INTO CURSOR CsrAuxValor    
		   	lcfiltro =" AND CsrValor.regisf=1 AND not CsrClaseValor.numero in ('C','F','G','H','P') "+;
		   			  " and  Csrvalorctacon.idejercicio="+STR(Goapp.idejerciciofac)
			
		   	loObjValor = CREATEOBJECT("Custom")
		   	loObjValor.AddProperty('totalcomp',lntotalcomp)
		   	loObjValor.AddProperty('origencomp',"FAC")
		   	loObjValor.AddProperty('idbcocompcheque',thisform.idbcocompcheque)   
		   	loObjValor.AddProperty('lcfiltro',lcfiltro) 
		   
		   	DO FORM pidopagos WITH lcid,loObjValor TO thisform.quetecla   
		   	thisform.cargarvalores()
		   	
		   	&&Nose cargo el form
		   	IF thisform.quetecla=0 OR thisform.quetecla=43
		   		replace ALL importe WITH 0 IN CsrPago
		   		thisform.quetecla = 27 
		   		RETURN .t.
		   	ENDIF 
		   	
		   loObjValor = null
		   
		ENDIF 
		
		RETURN .t.
		
	ENDPROC

	PROCEDURE ponerpantallamodoconsulta		&& desactiva todos los controles menos los pertinentes cuando estoy consultando una factura
		WITH thisform
			.LockScreen=.t.
			.containerencabeza.Enabled=.t.
			.containeringreso.Enabled=.f.
			.containertotales.Enabled=.f.
			.grid2.ReadOnly=.t.
			.cmdSalvar.Visible = .f.
			.cmdRemito.Visible	= .f.
			.cmdborrar.Visible = IIF(Csrmaopera.origen="FPE" and 'FACPEDIDO'$Csrmaopera.programa and LEN(LTRIM(Csrmaopera.numcomp))=0 ,.F.,.T.)  && si es facturacion de pedido no dejo borrar por aca
			.cmdimprimir.visible= .t.
			*.cmdasiento.visible = .t.
			*.cmdwebservice.Visible = .t.
			*.cmdconsignar.Visible = .t.
			.CmdOpciones.Visible = .t.
			.cmdrecuperar.Visible = .f.
			*IF thisform.tipoform$"N"
				.CmdLicita.Visible = .f.
			*ENDIF 
				
			*.cmdplan.visible = .t.
			.LockScreen=.f.
		ENDWITH 
	ENDPROC

	PROCEDURE ponerpantallamodoedicion		&& vuelve a activar los controles desactuivados en modo consulta
		WITH thisform
			.LockScreen=.t.
			.consultandocomprobante = .f.
			.containerencabeza.Enabled=.t.
			.containeringreso.Enabled=.t.
			.containertotales.Enabled=.t.
			.grid2.ReadOnly=.f.
			
			.cmdBorrar.Visible  = .f.
			.cmdimprimir.Visible= .f.
			*.cmdasiento.Visible = .f.
			*.cmdwebservice.Visible = .f.
			*.cmdconsignar.Visible = .f.
			*.cmdplan.Visible = .f.
			.CmdOpciones.Visible = .f.
			.cmdrecuperar.visible = .t.
			&&IF thisform.tipoform$"N"
				.CmdLicita.Visible = .t.
			&&ENDIF 
			
			.LockScreen=.f.
		ENDWITH 
	ENDPROC

	PROCEDURE recuperarcomproba
		&&Recuperamos el comprobante.
		&&Si el origen es una factura, debemos validar si los productos
		&&Son los mismos de la factura y no superan la cantidad
		&&Entre el y los remitos generados.
		&&Si el origen es uno o varios remitos, no se puede cambiar nada.
		
		loObjeto = CREATEOBJECT("CUSTOM")
		*loObjeto.AddProperty('claseafectador',CsrComprobante.clase)
		loObjeto.AddProperty('claseafectado',IIF(CsrComprobante.clase$'I8','V',''))
		*loObjeto.AddProperty('idmaoperaafectado',0)
		loObjeto.AddProperty('idctacte',CsrAuxCabefac.idctacte)
		loObjeto.AddProperty('incluyeiva',thisform.incluyeiva)
		*loObjeto.AddProperty('esnota',IIF(CsrComprobante.clase$'C',.T.,.F.))
		
		PUBLIC pndatasessionid
		pndatasessionid = thisform.datasessionid
		
		*thisform.haycambio = .f.
		
		*!*	IF (thisform.claseanterior <> CsrComprobante.clase) AND (thisform.claseanterior <> 'E')
		*!*		IF USED('CsrGeneral')
		*!*			USE IN CsrGeneral
		*!*		ENDIF
		*!*		
		*!*		thisform.haycambio = .T.
		
		*!*	ENDIF
		
		*!*	thisform.claseanterior = CsrComprobante.clase
		
		
		DO FORM PidoLicita WITH loObjeto NAME loForm LINKED
		
		
		IF NOT USED('CsrRemFac')
			RETURN .f.
		ENDIF
		
		SELECT CsrRemFac
		IF RECCOUNT('CsrRemFac')=0
			RETURN .f.
		ENDIF
		
		RELEASE loObjeto
		RELEASE loForm
		
		
		SET SAFETY OFF
		SELECT CsrauxCuerfac
		ZAP
		
		SELECT CsrAuxCuerVari
		ZAP
		SET SAFETY ON 
		
		* Cabefac
		SELECT CsrAuxCabefac
		
		&&Si se recupero un remito. Esta no compromete mercaderia
		SELECT CsrAuxCabefac
		GO TOP 
		
		LOCAL cCadArti,cSep
		
		STORE "" TO cCadArti,cSep,cCadMovLi,cSepLi
		
		SELECT CsrRemFac
		GO TOP 
		SCAN 
			IF NOT strtrim(CsrRemFac.idarticulo)$cCadArti AND afecta <> 0
				cCadArti = cCadArti + cSep + strtrim(CsrRemFac.idarticulo)
				cSep = ","
			ENDIF 
			IF NOT strtrim(CsrRemFac.id)$cCadMovLi AND afecta <> 0
				cCadMovLi = cCadMovLi + cSepLi + strtrim(CsrRemFac.id,12)
				cSepLi = ","
			ENDIF 
		ENDSCAN 
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrMovLicita.* FROM MovLicita as CsrMovLicita
		Where id in (<<cCadMovLi>>)
		ENDTEXT 
		
		IF NOT this.obtenerdatos('CsrMovLicita',lcCmd)
			thisform.Release
		ENDIF 
		
		
		oCa = thisform.obtenercursor("CsrProducto")
		
		lcCmdProd = UPPER(Oca.SelectCmd)
		i = AT("WHERE",lcCmdProd)
		lcCmdProd = LEFT(lcCmdProd,i-1)
		lcCmdProd = lcCmdProd + " WHERE Csrproducto.id in (" + cCadArti + ") " 
		
		
		*!*	&&Siempre el precio debe omitir las listas, porque debemos mantener el licitado
		*!*	TEXT TO lcCmdProd TEXTMERGE NOSHOW
		*!*	SELECT Csrproducto.*,ISNULL(Tipoiva.tasa,0) as tasa,ISNULL(rubro.idfuerzavta,0) as idfuerzavta
		*!*	,isnull(left(tipoprod.switch,1),'0') as alcohol,ISNULL(rubro.perceibruto,0) as perceibruto
		*!*	,0 as omitirlistas 
		*!*	FROM Producto as Csrproducto 
		*!*	LEFT JOIN Tipoiva on Csrproducto.idiva = Tipoiva.id 
		*!*	LEFT JOIN rubro on Csrproducto.idrubro = rubro.id 
		*!*	LEFT JOIN tipoprod on rubro.idtipoprod = tipoprod.id 
		*!*	where CsrProducto.id in (<<cCadArti>>)
		*!*	ENDTEXT 
		
		lok=thisform.obtenerdatos('CsrProducto',lccmdProd)
		
		&&El precio sale de lista base para que no tenga ningun incremento
		
		replace listaprecio WITH 1 IN CsrAuxCabefac
		
		lndecimaluni = thisform.ndecimaluni
		lndecimaltot = thisform.ndecimaltot
		*lnuniventa   = IIF(CsrAuxCuerfac.univenta=0,Csrproducto.idtipovta,CsrAuxCuerfac.univenta)
		
		SELECT CsrRemFac
		GO TOP 
		*vista()
		SCAN FOR !EOF()
			IF CsrRemFac.afecta = 0
				LOOP 
			ENDIF 
			
			thisform.codigoanterior = ""
			
			SELECT CsrProducto
			LOCATE FOR id = CsrRemFac.idarticulo
			
			this.agregarcuerfac()
			
			lnuniventa   = Csrproducto.idtipovta
			
			REPLACE idarticulo WITH Csrproducto.id,codigo WITH LTRIM(STR(Csrproducto.numero)),nombre WITH Csrproducto.nombre;
			,univenta WITH lnuniventa,idctavta WITH 0,unibulto WITH Csrproducto.unibulto;
			,idfuerzavta WITH Csrproducto.idfuerzavta,alcohol WITH IIF(NOT thisform.controlar_reba,'0',CsrProducto.alcohol),kilos WITH Csrproducto.peso,volumen WITH Csrproducto.volumen;
			,perceibruto WITH Csrproducto.perceibruto,nofactura WITH Csrproducto.nofactura,idenvase WITH Csrproducto.idenvase;
			,pesable WITH CsrProducto.vtakilos, idfrio WITH CsrProducto.idfrio,idoriginal WITH Csrproducto.id;
			,OMITIRLISTAS WITH 0 IN CsrAuxCuerfac
			
			replace tasaiva WITH CsrProducto.tasa IN CsrAuxCuerfac
			&&Omitimos cualquier tipo de bonificacion del sistema
			replace bondigitada WITH 1 IN CsrAuxCuerFac
			
			replace idmovlicita WITH CsrRemFac.id,idmaopelicita WITH CsrRemFac.idmaopera IN CsrAuxCuerfac
			
			IF LEN(LTRIM(CsrAuxCuerfac.codextend))=0
				REPLACE codextend WITH LTRIM(STR(Csrproducto.numero)) IN CsrAuxCuerfac
			ENDIF 
			
			IF LEN(TRIM(CsrAuxCuerfac.nombre))#0
				IF Csrproducto.id#0
					thisform.traerdatosextra(Csrproducto.id,CsrAuxcabefac.idctacte)
				ENDIF 	
				
				IF thisform.controlfactura(1) OR thisform.leyendocuerpedido
					SELECT CsrProducto
					SCATTER NAME lObjProducto
					
					*this.precioprod1.cflimpiarprecio()
					this.precioprod1.calculaprecio(lObjProducto,@lObjprecio)
					
					lObjprecio.prevtaciva1	= CsrRemFac.preunita
					lObjprecio.prevta1 		= CsrRemFac.preunitasiva
					
					LOCAL lnpreunita,lnpreunitasiva,lnprearti,lnpreartisiva
					
					IF NOT thisform.oRegfacvta.preciosnegociados(lObjProducto.id,@lObjprecio)
						thisform.oRegFACVTA.PRECIoporlista(lObjProducto,@lObjprecio)
						thisform.determinarlistaprecio(@lnpreunita,@lnpreunitasiva,@lnprearti,@lnpreartisiva,CsrAuxCuerfac.omitirlistas)
			        ELSE
						&&Si se encuentran precios negociados,cambiamos las variables del precio
						lnpreunita     = lObjprecio.prevtaciva1   && CsrProducto.prevtaf4
						lnpreunitasiva = lObjprecio.prevta1       && CsrProducto.prevta4
						lnprearti		= ROUND(lnpreunita,2)
						lnpreartisiva	= ROUND(lnpreunitasiva,2)
			        ENDIF 
		        
			       	*IF thisform.codigoanterior # CsrAuxCuerfac.codigo
			    		REPLACE preunita WITH lnpreunita,preunitasiva WITH lnpreunitasiva,prearti WITH lnprearti,preartisiva WITH lnpreartisiva,total WITH 0 IN CsrAuxCuerfac
			   		*ENDIF 
			   				
					lok = .f.   		    
					IF NOT thisform.controlfactura(2)
						
						RETURN .f.	
					ENDIF 
				ENDIF 
			
				SELECT CsrAuxCuerfac
				replace cantidad	WITH  CsrRemFac.afecta
				replace registro	WITH  RECNO()
				SCATTER NAME Oscatter
				
				thisform.grid2_control("","ThisForm.Grid2.Column5.Text1")
					
			    
			    SELECT CsrSubProducto
			    LOCATE FOR idarticulo = CsrRemFac.idarticulo AND pos = Oscatter.registro
			    DO WHILE idarticulo = CsrRemFac.idarticulo AND pos = Oscatter.registro
			    
			    	SCATTER NAME OscatterVari ADDITIVE 
			    	
			    	IF OscatterVari.idvariedad <> CsrRemFac.idvariedad
			    		SKIP 
			    		LOOP 
			    	ENDIF 
			    		
			    	OscatterVari.cantidad	= Oscatter.cantidad
			    			
					SELECT CsrAuxCuerVari
					LOCATE FOR registro = Oscatter.registro AND idvariedad = OscatterVari.idvariedad
					IF !(registro = Oscatter.registro AND idvariedad = OscatterVari.idvariedad)
						APPEND BLANK
						REPLACE idsubarti WITH OscatterVari.id,idarticulo WITH OscatterVari.idarticulo,idvariedad WITH OscatterVari.idvariedad;
			  	   		   ,nombre WITH OscatterVari.nomvariedad,cantidad WITH OscatterVari.cantidad,kilos WITH OscatterVari.kilos,volumen WITH OscatterVari.volumen;
			  	   		   ,registro WITH Oscatter.registro,escambio WITH 0
					ENDIF 
			    	
			    	SELECT CsrSubProducto
			    	SKIP    	
			    ENDDO 
			ENDIF 
			thisform.codigoanterior = CsrAuxCuerfac.codigo
			SELECT CsrRemFac
		ENDSCAN 
		
		thisform.totalcomprobante()
		
		thisform.grid2.Refresh()
		
		*oavisar.usuario(STR(RECCOUNT("CsrAuxCuerfac")))
		RETURN .t.
	ENDPROC

	PROCEDURE renombrarachivos
	ENDPROC

	PROCEDURE renombrarpedido		&& cambiamos el nombre del pedido y los datos para no volver a pasarlo
		&&Los archivos del pm, es uno para todos los pedidos
			SELECT CsrOpcion
			replace estado WITH 1 IN CsrOpcion
		
			llok = this.establecerservidor(0)
			TRY 
				IF llok 
					
					SELECT CsrAuxPediPda
					GO TOP 
					SCAN 
						nIdPedido = CsrAuxPediPda.idpedido
						cLote = DTOS(DATE())+strzero(HOUR(DATETIME()),2)+strzero(MINUTE(DATETIME()),2)
						LOCAL Oca
				    	Oca = CREATEOBJECT('ADODB.Command')
						Oca.ActiveConnection = cConnStringActual
						Oca.CommandText = "Update CabPedido Set loteexportacion = '"+cLote+"' Where id = "+str(nIdPedido)
						Oca.CommandType = 1
		
						LOCAL loCatchErr As Exception
						ldebociclar = .t.
						DO WHILE ldebociclar 
						   ldebociclar = .f.
							TRY 
							  Oca.execute()
							CATCH TO loCatchErr
						 	  ldebociclar = .t.
							ENDTRY   
						ENDDO 
						
						SELECT CsrAuxPediPda
					ENDSCAN 
				ENDIF  
			CATCH TO oError
				oavisar.usuario(' Metodo: '+oError.Procedure+CHR(13)+;
							'Mensaje: '+ALLTRIM(oError.Message)+' Nro Error  '+ALLTRIM(STR(oError.ErrorNo))+' '+CHR(13)+;
		 						'Linea: '+ALLTRIM(oError.LineContents))
			FINALLY 
				llok = this.establecerservidor(1)
				SELECT CsrOpcion
			ENDTRY 
				
		RETURN
	ENDPROC

	PROCEDURE solicitacae
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrParaVario.* FROM ParaVario as CsrParaVario
		ENDTEXT 
		IF NOT CrearCursorAdapter('CsrParaVario',lcCmd)
			RETURN .f.
		ENDIF 
		
		SELECT CsrParaVario
		LOCATE FOR nombre='CAE_LOTE'
		IF nombre='CAE_LOTE' AND ESTADO=1
			RETURN .T.
		ENDIF 
		
		LOCAL lok
		
		lok = .t.
		&&Toma el primer comprobante disponible
		*stop()
		SELECT CsrAuxCabefac
		GO TOP 
		nSoloGrabar = thisform.chkSoloImprimir.Value && CsrAuxCabefac.solograbar
		
		SCAN FOR lok
			SCATTER NAME OscCAECabefac
			**&&''
		
			This.oFACCAE.TopeCF = This.TopeCF
			this.oFacCAE.fac_solicitacae()
			lok = This.oFacCAE.sw_estado
			IF lok
				SELECT CsrAuxCabefac
				OscCAECabefac.idmaopera = 0 &&Pq los cuerpos no tienen id
				GATHER NAME OscCAECabefac
			ENDIF 
		ENDSCAN 
		IF lok
			lnok = 6
			IF nSoloGrabar=0
				IF goapp.codempresa = 10
					lnok = oavisar.usuario("DESEA IMPRIMIR EL COMPROBANTE?",36)
				ENDIF
				SELECT CsrAuxCabefac
				GO TOP  
				SCAN 
					IF lnok=6    		
						this.imprimir(thisform.lcimpresora,Csrprefitermi.tipoimpresora,1)
					ELSE
						thisform.leerproximonro(CsrComprobante.id,.t.)
					ENDIF 
				ENDSCAN 
			ELSE
				thisform.leerproximonro(CsrComprobante.id,.t.)
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE temp_load
		&&Guardamos en un archivo los vamos de temporal
		LOCAL cRuta,nOrden
		
		IF RECCOUNT('CsrAuxCuerfac') > 1
			IF oavisar.usuario('Tiene articulos cargados, esta seguro de recuperar el archivo?',36) <> 6
				oavisar.usuario('Recuperacion cancelada')
				RETURN 
			ENDIF 
		ENDIF 
		
		**stop()
		cRuta = SYS(5)+CURDIR()
		
		cRuta  =SYS(5)+CURDIR()+'Temporal'
		IF !DIRECTORY(cRuta)
			MKDIR SYS(5)+CURDIR()+'Temporal'
		ENDIF 
		
		cFile = ADDBS(cRuta)+"FAC"+strzero(goapp.terminal,3)+".XML"
		IF FILE(cFile )	
			
			LOCAL Oscatter,lcCtrlSource,lcalias,AcolOdataNavega,lcnombre,lnkeyCode,lclista
			STORE '' TO lcCtrlSource,AcolOdataNavega
			lcAlias = "CsrAuxCuerfac"
			
			nOrden = 0	
		
			WITH thisform
				lnLista = CsrAuxCabefac.listaprecio
				IF lnLista > 4
					lnLista = 1 
				ENDIF 
				lclista = "prevtaf"+LTRIM(STR(lnLista ))
				
				.kitbuscarProd.controlsource01 = lclista
				
				_screen.LockScreen = .t.
			    .bindergridoff('thisform.grid2',@lcalias,@lcCtrlSource,@AcolOdataNavega)
		
					
				SET SAFETY OFF 
				SELECT CsrAuxCuerfac
				ZAP 
				XMLTOCURSOR(cFile ,"CsrAuxCuerfac",512+8192)
				SET SAFETY ON 
			
			    .grid2.coLUMN3.combo1.RowSource = "U,1,B,2"
				*.grid2.coLUMN11.combo1.RowSource = "$,1,U$D,2"
				
				
			    .bindergridon('thisform.grid2',lcAlias,lcCtrlSource,AcolOdataNavega)
			    	
			    	cFile = ADDBS(cRuta)+"VAR"+strzero(goapp.terminal,3)+".XML"
				IF FILE(cFile )
					SET SAFETY OFF 
					SELECT CsrAuxCuerVari
					ZAP 
					XMLTOCURSOR(cFile ,"CsrAuxCuerVari",512+8192)
					SET SAFETY ON 
				ENDIF 
				
			    	replace ALL idmaopera WITH CsrAuxCabefac.idmaopera, idcabeza WITH 0 IN CsrAuxCuerfac
			    	replace ALL idmaopera WITH CsrAuxCabefac.idmaopera IN CsrAuxCuerVari
		
			    	SELECT CsrAuxCuerfac
				GO BOTTOM
				nOrden = CsrAuxCuerfac.orden 
				_screen.LockScreen = .f.
				thisform.grid2.Column1.SetFocus()
			ENDWITH 
		
			
		oavisar.usuario('Recuperación Exitosa!')
		ENDIF 
		
		thisform.orden = nOrden
		
		RETURN .t.
	ENDPROC

	PROCEDURE temp_save
		&&Guardamos en un archivo los vamos de temporal
		LOCAL cRuta,nRecno
		
		IF RECCOUNT('CsrAuxCuerfac') <= 2
			RETURN .t.
		ENDIF 
		
		*stop()
		
		SELECT CsrAuxCuerfac
		nrecno = RECNO()
		
		cRuta = SYS(5)+CURDIR()
		
		cRuta  =SYS(5)+CURDIR()+'Temporal'
		IF !DIRECTORY(cRuta)
			MKDIR SYS(5)+CURDIR()+'Temporal'
		ENDIF 
		
		cFile = ADDBS(cRuta)+"FAC"+strzero(goapp.terminal,3)+".XML"
		
		SET SAFETY OFF 
		CursorAdapterToXML('CsrAuxCuerfac',cFile )
		SET SAFETY ON 
		
		cFile = ADDBS(cRuta)+"VAR"+strzero(goapp.terminal,3)+".XML"
		
		SET SAFETY OFF 
		CursorAdapterToXML('CsrAuxCuerVari',cFile )
		SET SAFETY ON 
		
		SELECT CsrAuxCuerfac
		GO nRecno
		
		this.cmdrecuperar.Enabled = .f.
		
		
		RETURN .t.
		
	ENDPROC

	PROCEDURE totalcomprobante
		LOCAL lnrecno,lnTotalFac,lnTotalPagar,lnBaseSubtotal,lndecimaluni,lndecimaltot,lntasa,lnCalculo,lninterno,lnpreunita
		LOCAL lnBaseGra,lnBaseExe,i,lnbase,lnUniCiva,lnBaseRetencion,lnBaseInterno,lnBaseIva,lnBaseCiva,lnBaseDescuento,lnBaseNoCatego
		LOCAL lnBaseIBTO1,lnBaseIBTO2,lnPerceibto1,lnPerceibto2,ldfechafac,lnTotNoCatego,lnIvaUni,lnidctavta,lnUniTotal
		LOCAL lnEsCambio
		
		STORE 0.00 TO lnTotalFac,lnTotalPagar,lnBaseGra,lnBaseExe,lnBase,lnUniCiva,lntasa,lnCalculo,lnTotNoCatego
		STORE 0.00 TO lnBasedescuento,lnBaseIva,lnBaseCiva,lnBaseSubtotal,lnBaseNoCatego,lnBaseRetencion,lnBaseInterno
		STORE 0.00 TO lnBaseIBTO1,lnBaseIBTO2,lnPerceibto1,lnPerceibto2,lninterno,lnpreunita,lnIvaUni,lnUniTotal
		STORE 0.00 TO lnBaseDesctoSiva,lnidctavta,lnEsCambio
		STORE 0.00 TO lnBasePerceIVA   
		
		IF thisform.consultandocomprobante
			RETURN .t.
		ENDIF 
		*stop()
		loObjiva       = null
		loObjRetencion = null
		
		WITH thisform
			.agregaobjeto.objimpuestovta(@loObjIva,@loObjRetencion)
		*!*		.oImpuestos.limpiarDatos(@oObjImpFac)    
		*!*		.oImpuestos.agregarimpuesto(@oObjImpFac)
			
			lndecimaluni   = .ndecimaluni
			lndecimaltot   = .ndecimaltot
			ldfechafac     = TTOD(.containerencabeza._txtfecha.Value)
		ENDWITH
		
		lnrecno = RECNO('CsrAuxCuerfac')
		SELECT CsrAuxCuerfac
		GO Top
		*vista()
		*stop()
		**&&''
		lnTotalCal = 0
		SCAN FOR !EOF()
		
		     lnCant      = CsrAuxCuerfac.cantidad
		     lnDesctoCiva = CsrAuxCuerfac.desctoCiva
		     lnDesctoSiva = CsrAuxCuerfac.desctoSiva     
			 lninterno   = CsrAuxCuerfac.internofin
			 lnpreunita  = IIF(thisform.incluyeiva,CsrAuxCuerfac.preunita,CsrAuxCuerfac.preunitasiva)
		    
		     lnUniSiva   = CsrAuxCuerfac.UniSiva
		     lnUniCiva   = CsrAuxCuerfac.UniCiva
			 lnuniventa  = CsrAuxCuerfac.univenta
		     lnunibulto  = IIF(CsrAuxCuerfac.unibulto=0,1,CsrAuxCuerfac.unibulto)
		 	 lnunibulto  = IIF(lnuniventa=1,1,lnunibulto)
			 lntasa      = CsrAuxCuerfac.tasaiva
			 lnIvaUni    = CsrAuxCuerfac.Ivauni
		     lntotalLine = CsrAuxCuerfac.total
			 lnidctavta  = CsrAuxCuerfac.idctavta
			 lnkilos = CsrAuxCuerfac.kilos
			 lnpesable = CsrauxCuerfac.pesable
			 lnEsCambio	 = CsrAuxCuerfac.escambio
			 
			 IF lnEsCambio=1
			 	LOOP 
			 ENDIF 
			 	      	            
			 IF lntasa#0
			        lnAbase   = red(lnUniSiva,lndecimaltot)
			        lnCalculo = red(lnIvaUni,lndecimaluni) 
			        *lnCalculo = lnIvaUni &&ROUND(lnIvaUni,lndecimaluni) 
			        lnTotalCal = lnTotalCal + lnCalculo
			        thisform.unitariofac.acumulaimpuesto(@loObjIva,TRANSFORM(lnidctavta,"9999999999")+TRANSFORM(lntasa,"99.99"),lnAbase,lntasa,lnCalculo,"IVA "+TRANSFORM(lntasa,"99.99"),lnidctavta)
			        IF CsrAuxCuerfac.perceiva5329=1 AND  Thisform.CalculoPIVA5329 
						nAlicuotaPI = IIF(lnTasa = 21,3,IIF(lnTasa=10.5,1.5,0))
						IF nAlicuotaPI #0
							lnPerceIVA = red(lnUniSiva * nAlicuotaPI / 100,lndecimaltot)
							lnBasePerceIVA   = lnBasePerceIVA+ lnPerceIVA 
							
							thisform.unitariofac.acumulaimpuesto(@loObjRetencion,"PIVA"+TRANSFORM(nAlicuotaPI ,"99.99"),lnUniSiva ,nAlicuotaPI ,lnPerceIVA ,"PIVA "+TRANSFORM(nAlicuotaPI ,"99.99"),0)
						ENDIF 
					ENDIF 
		     	ELSE
		        		lnBaseExe  = lnBaseExe + red(lnUniSiva,lndecimaltot)
		     	ENDIF    
		
		     lnBaseInterno    = lnBaseInterno   + red(lninterno,lndecimaltot)
		     lnBaseCiva       = lnBaseCiva      + red(lnUniCiva,lndecimaltot)
		     lnBaseDescuento  = lnBaseDescuento  + red(lndesctoCiva,lndecimaltot)
		     lnBaseDesctoSiva = lnBaseDesctoSiva + red(lndesctoSiva,lndecimaltot)
		
		     IF CsrAuxCuerfac.perceibruto=1
		        lnBaseIBTO1   = lnBaseIBTO1 + red(lnUniSiva,lndecimaltot)
		     ENDIF 
		     lnBaseIBTO2      = lnBaseIBTO2 + red(lnUniSiva,lndecimaltot)
		ENDSCAN
		
		IF lnrecno>=1
			GO RECORD lnrecno IN CsrAuxCuerfac
		ENDIF 
		
		lnBaseGra = loObjIva.base1     + loObjIva.base2     + loObjIva.base3     + loObjIva.base4     + loObjIva.base5
		lnBaseIva = red(loObjIva.impuesto1,lndecimaltot) + red(loObjIva.impuesto2,lndecimaltot) + red(loObjIva.impuesto3,lndecimaltot) + red(loObjIva.impuesto4,lndecimaltot) + red(loObjIva.impuesto5,lndecimaltot) 
		*lnBaseIva = ROUND(loObjIva.impuesto1 + loObjIva.impuesto2 + loObjIva.impuesto3 + loObjIva.impuesto4 + loObjIva.impuesto5,lndecimaltot)
		
		
		IF thisform.accion#"A"
			lnTotNocatego = thisform.lntotalnc
			lnPerceibto1 = thisform.lnperceib1
			lntasaibto1=thisform.tasaperib1
			lntasaibto2=thisform.tasaperib2
			loObjRetencion.impuesto1 = thisform.lntotalri
		ENDIF 
		
		IF CsrCategoiva.fiscal$'T' AND thisform.accion="A"   && no categorizado  (NOCATEGORI no cambiar, lo usa actualizar impuesto)
		    lnBaseNoCatego = lnBaseGra+lnBaseiva
		    lntasa         = CsrCategoiva.tasa1
		    lnCalculo      = red(lnBaseNoCatego*lntasa/100,lndecimaltot)    
			IF lnBaseNoCatego#0
			   thisform.unitariofac.Acumulaimpuesto(@loObjRetencion,"NOCATEGORI",lnBaseNoCatego,lntasa,lnCalculo,"NO CATEGO.",0)
			   lnTotNoCatego = lnTotNoCatego + lnCalculo
			ENDIF
		ENDIF
		
		STORE 0 TO lnPerceibto1,lnPerceibto2
		
		*stop()
		IF CsrCategoiva.fiscal$'IMN' AND CsrComprobante.clase$'ABCUI' AND thisform.accion="A" AND !thisform.noCalculoIBTO&& RI/MT/rni (IBTO1 y IBTO2 no cambiar, lo usa actualizar impuesto) ABCU  fac.,n.deb,n.cre,tkt
			*stop()
			IF CsrCategoiva.fiscal $ 'M'
				lnBaseIBTO1 = lnBaseIBTO1 + lnBaseiva
				lnBaseIBTO2 = lnBaseIBTO2 + lnBaseiva
			ENDIF 
			
			IF lnBaseIBTO1#0 AND lnBaseIBTO1 >= Csrprovincia.minimo1 AND Csrcatectacte.porperce=-1
			   lnPerceibto1 = red(lnBaseIBTO1*Csrprovincia.alicuota1/100,lndecimaltot)	   
			   thisform.unitariofac.Acumulaimpuesto(@loObjRetencion,"IBTO1",lnBaseIBTO1,Csrprovincia.alicuota1,lnPerceibto1,"IBTO "+TRANSFORM(Csrprovincia.alicuota1,"99.99")+"%",0)
			ENDIF 
			
			IF lnPerceibto1#0
			   lnBaseIBTO2 = red(lnBaseIBTO2 - lnBaseIBTO1,lndecimaltot)
			ENDIF 
			
			IF lnBaseIBTO2#0 AND lnBaseIBTO2 >= Csrprovincia.minimo2 AND ldfechafac >= TTOD(Csrprovincia.fecdesde2)
			   lntasaib = Csrcatectacte.porperce
			   IF lntasaib=-1
			      lntasaib = IIF(CsrCategoiva.fiscal='M',Csrprovincia.alicuota3,Csrprovincia.alicuota2)
			   ENDIF 
			   lnPerceibto2 = red(lnBaseIBTO2*lntasaib/100,lndecimaltot)
			   thisform.unitariofac.Acumulaimpuesto(@loObjRetencion,"IBTO2",lnBaseIBTO2,lntasaib,lnPerceibto2,"IBTO "+TRANSFORM(lntasaib,"99.99")+"%",0)
			ENDIF 
		ENDIF
		
		lnBaseRetencion = loObjRetencion.impuesto1 + loObjRetencion.impuesto2 + loObjRetencion.impuesto3 + loObjRetencion.impuesto4 + loObjRetencion.impuesto5
		*lnBaseRetencion = red(lnBaseRetencion - lnTotNoCatego,lndecimaltot)
		lnBaseRetencion = red(lnBaseRetencion - lnTotNoCatego - lnBasePerceIVA  ,lndecimaltot)
		
		*stop()
		
		IF lnBasePerceIVA  = 0 OR  lnBasePerceIVA   < This.MinimoPIva5329  OR NOT CsrCategoiva.fiscal $ 'I' OR NOT CsrComprobante.clase$'ABCU'  		
			thisform.unitariofac.VaciarImpuesto(@loObjRetencion,"PIVA"+TRANSFORM(3 ,"99.99"))
			thisform.unitariofac.VaciarImpuesto(@loObjRetencion,"PIVA"+TRANSFORM(1.5 ,"99.99"))
			lnBasePerceIVA  = 0
		ENDIF 
				
		
		
		IF lnBaseRetencion < 0
		   lnBaseRetencion = 0
		ENDIF
		
		IF GOapp.empresatipoiva#1
		   lnBaseExe = lnBaseExe + lnBaseGra
		   lnBaseGra = 0
		   lnBaseiva = 0
		   lnBaseRetencion = 0
		ENDIF
		
		lnBaseSubSiva  = lnBaseGra + lnBaseExe + lnBaseInterno
		lnBaseSubCiva  = lnBaseGra + lnBaseExe + lnBaseInterno + lnBaseIva 
		*lnTotalFac     = lnBaseGra + lnBaseExe + lnBaseInterno + lnBaseIva + lnBaseretencion + lnTotNoCatego
		lnTotalFac     = lnBaseGra + lnBaseExe + lnBaseInterno + lnBaseIva + lnBaseretencion + lnTotNoCatego + lnBasePerceIVA  
		
		lnTotalpagar   = lnTotalFac
		
		IF CsrComprobante.clase$'1' &&Si es remito 3ro. Solo informamos el total
			STORE 0 TO lnBaseDescuento,	lnBaseinterno,	lnBaseiva,	lnBaseExe,	lnBaseGra,	lnBaseRetencion,	lnTotNoCatego
			STORE 0 TO lnPerceibto1,lnPerceibto2
			lnTotalFac = lnBaseSubCiva
		ENDIF 
		
		WITH thisform.containertotales
			._txtsubtotal.Value		 = (lnBaseSubCiva) &&lnUnitotal
			._txtbonificacion.Value  = ( IIF(thisform.incluyeiva,lnBaseDescuento ,lnBaseDesctoSiva))
			._txtinterno.Value		 = (lnBaseinterno)
			._txtiva.Value			 = (lnBaseiva)
			._txtnetoexento.Value	 = (lnBaseExe)
			._txtnetogravado.Value	 = (lnBaseGra)
			._txtpercepcion.Value	 = (lnBaseRetencion)
			._txtnocatego.value      = (lnTotNoCatego)
			._txttotal.Value		 = lnTotalFac
			._txtperceiva.Value	 	 = (lnBasePerceIVA) 
			.refresh
		ENDWITH 
		
		IF !CsrComprobante.clase$'1' &&Remito de 3ro No calculamos impuestos
		
			REPLACE idctavta1 WITH loObjIva.idctavta1,ivari1 WITH loObjIva.impuesto1,BaseGra1 WITH loObjIva.Base1,tasa1 WITH loObjIva.tasa1;
			   ,idctavta2 WITH loObjIva.idctavta2,ivari2 WITH loObjIva.impuesto2,BaseGra2 WITH loObjIva.Base2,tasa2 WITH loObjIva.tasa2;
			   ,idctavta3 WITH loObjIva.idctavta3,ivari3 WITH loObjIva.impuesto3,BaseGra3 WITH loObjIva.Base3,tasa3 WITH loObjIva.tasa3;
			   ,idctavta4 WITH loObjIva.idctavta4,ivari4 WITH loObjIva.impuesto4,BaseGra4 WITH loObjIva.Base4,tasa4 WITH loObjIva.tasa4;
			   ,idctavta5 WITH loObjIva.idctavta5,ivari5 WITH loObjIva.impuesto5,BaseGra5 WITH loObjIva.Base5,tasa5 WITH loObjIva.tasa5;
			   ,nomrete1 WITH loObjRetencion.nombre1,retencion1 WITH loObjRetencion.impuesto1,baserete1 WITH loObjRetencion.base1;
			   ,tasarete1 WITH loObjRetencion.Tasa1;
			   ,nomrete2 WITH loObjRetencion.nombre2,retencion2 WITH loObjRetencion.impuesto2,baserete2 WITH loObjRetencion.base2;
			   ,tasarete2 WITH loObjRetencion.Tasa2;
			   ,nomrete3 WITH loObjRetencion.nombre3,retencion3 WITH loObjRetencion.impuesto3,baserete3 WITH loObjRetencion.base3;
			   ,tasarete3 WITH loObjRetencion.Tasa3;
			   ,nomrete4 WITH loObjRetencion.nombre4,retencion4 WITH loObjRetencion.impuesto4,baserete4 WITH loObjRetencion.base4;
			   ,tasarete4 WITH loObjRetencion.Tasa4;
			   ,nomrete5 WITH loObjRetencion.nombre5,retencion5 WITH loObjRetencion.impuesto5,baserete5 WITH loObjRetencion.base5;
			   ,tasarete5 WITH loObjRetencion.Tasa5 IN CsrAuxCabefac
		ENDIF 
		
		REPLACE BaseExe WITH lnBaseExe,BaseInterno WITH lnBaseInterno,BaseDescto WITH lnBasedescuento,BaseDesctoSiva WITH lnBasedesctoSiva;
			   ,BaseGra WITH lnBaseGra,BaseIva WITH lnBaseiva,BaseNocatego WITH lnTotNoCatego,Perceibto1 WITH lnPerceibto1,Perceibto2 WITH lnPerceibto2;
			   ,SubtotSiva WITH lnBaseSubSiva,SubtotCiva WITH lnBaseSubCiva,total WITH lnTotalFac IN CsrAuxCabefac
		replace PerceIVA5329 WITH lnBasePerceIVA   IN CsrAuxCabefac
		
		IF thisform.ObjImpresor.version_facvta=1 &&Mardone el Saldo audeudado incluye la factura
			replace SaldoCta WITH CsrCtacte.saldo+IIF(CsrComprobante.signocta=2,(-1),(1))*lnTotalFac IN CsrAuxCabefac
		ENDIF 
		
		SELECT CsrParaVario
		LOCATE FOR nombre='TOPEFISCALCF'
		IF nombre='TOPEFISCALCF' AND CsrCategoiva.fiscal$"C" AND CsrComprobante.clase$"ABC" AND Csrprefitermi.tipoimpresora=3
			IF CsrParaVario.importe < lnTotalFac AND CsrParaVario.importe > 0
				oavisar.usuario("Los clientes CONSUMIDOR FINAL no pueden facturar mas del tope establecido "+strtrim(CsrParaVario.importe,11,2))
			ENDIF 
		ENDIF 
		
		
		loObjiva       = null
		loObjRetencion = null
		
	ENDPROC

	PROCEDURE totalhojapagos
		=CrearCursordbf('Csrpago')
		
		local lcdias,i,lndias,lcclasevalor,ldfecha,lnimpcuota,lncuota,lntotcuota,lntotalcomp,lnimporte
		local lccid,lctipocaja,haycambios,lcidcliente,lcorigencta
		LOCAL lcclaseorig,lnimporte,lnidvalororig,lnidplanorig
		STORE 0 TO lnimporte
		
		*!*	SELECT CsrAuxCabefac
		*!*	GO TOP 
		*!*	SCAN 
			
			lcidcliente = Csrauxcabefac.idctacte
			ldfecha     = TTOD(CsrAuxCabefac.fecha)
			lntotalcomp = CsrAuxCabefac.total
			replace detapiecuota01 WITH "", detapiecuota02 WITH "";
					, detapiecuota03 WITH "", detapiecuota04 WITH "" ;
					, detapiecuota05 WITH "", detapiecuota06 WITH "" ;
					, detapiecuota07 WITH "", detapiecuota08 WITH "", detapiecuota09 WITH "" IN CsrAuxCabefac
					
			&&Marcos 2014/09/29
			&&Si se cargaron negociaciones para la cobranza, reemplazamos las cuotas del plan de pago
			lcdias = ""
			IF NOT this.pedirdetacobranza
				lcdias = CsrPlanpago.dias
			ELSE
				&&En caso del negociado, hay que armar la cadena con los dias, como esta en el plan de pago
				&&Para asi seguir haciendo el mismo procedimiento
				cCadNegociado = ""
				FOR i=1 TO CsrAuxCabefac.plancuota
					cCadNegociado  = cCadNegociado +IIF(LEN(cCadNegociado)!=0,"-","")+strzero(CsrAuxCabefac.planrango,3)
				ENDFOR 
				lcdias = cCadNegociado		
				replace detacobranza WITH lcdias IN CsrAuxCabefac &&Se necesita para npedido
			ENDIF 
			
			i=1
			lncuota = 0
			do while i <= len(lcdias)
				lndias = val(subs(lcdias,i,3))
				if len(trim(subs(lcdias,i,3)))<>0
					lncuota = lncuota + 1 
				endif   
				i=i+4
			enddo
			
			lnimpcuota = iif(lncuota=0,lntotalcomp,red(lntotalcomp/lncuota,2))
			lntotcuota = 0
			
			IF CsrComprobante.clase$'1' &&Remito 3ro. Simpre va a CONTADO PENDIENTE
				SELECT CsrPlanPago
				LOCATE FOR numero = 'CDP'
			ENDIF 
			
			SELECT Csrvalor
			LOCATE FOR id=Csrplanpago.idvalor
			
			lcclasevalor = Csrvalor.clasevalor
			
			SELECT Csrplancue
			LOCATE FOR id=CsrValor.idctaf
			lctipocaja = iif('C'$lcclasevalor,'CC','CA')   && ctacte, caja
			
			local lcidcuenta
			SELECT CsrParaConta
			LOCATE FOR numero = 2
			
			lcidcuenta = IIF(!this.cambiarcuenta(),CsrValor.idctaf,this.lcidcuentad)
			lcidcuenta = IIF(lcidcuenta=0,CsrParaConta.idcuenta,lcidcuenta)
			 		
			IF lcidcuenta=0 
				Oavisar.usuario('NO SE ENCONTRO UNA CUENTA CONTABLE ASOCIADA AL VALOR ';
							+CHR(13)+'CONSUELTE ARCHIVOS GENERALES'+CHR(13)+'	ABM VALORES.';
							+CHR(13)+CHR(13)+'NO SE ENCONTRO UNA CUENTA CONTABLE PARA DEUDORES VARIOS ';
							+CHR(13)+'CONSUELTE ARCHIVOS GENERALES'+CHR(13)+'	ABM PARAMETROS CONTABLES',0)
				RETURN .f.
			ENDIF 
		
			i=1
			do while i <= len(lcdias)
				lndias = val(subs(lcdias,i,3))
				if len(trim(subs(lcdias,i,3)))=0 
					i=i+4
					loop
				endif
				lccid = i
		
				Insert into Csrpago (numero,cnombre,fecha,importe,idcuenta,ctactebco,idprovincia,titular,banco;
				,localidad,nrocheque,fechavto,entregado,idvalor,idtipobco,tipocaja,idctabco,esclase,recibido;
				,idlocalidad,idbanco,idctatitular,idctaentregado,idctarecibido,nroidentificador);
				Value (Csrvalor.numero,Csrvalor.nombre,ldfecha+lndias,lnimpcuota,lcidcuenta;
				,"",0,CsrAuxCabefac.cnombre,"","",0,ldfecha+lndias,CsrAuxCabefac.cnombre,Csrplanpago.idvalor,0;
				,lctipocaja,0,lcclasevalor,CsrAuxCabefac.cnombre,0,0,CsrAuxCabefac.idctacte,CsrAuxCabefac.idctacte;
				,0,"")
		 		
				lntotcuota=lntotcuota + lnimpcuota
				ldfecha = ldfecha+lndias
				i=i+4 
				
				
			enddo
			
			Sele Csrpago
			go top
			if eof()
				lccid = 1
				Insert into Csrpago (numero,cnombre,fecha,importe,idcuenta,ctactebco,idprovincia,titular,banco;
				,localidad,nrocheque,fechavto,entregado,idvalor,idtipobco,tipocaja,idctabco,esclase,recibido;
				,idlocalidad,idbanco,idctatitular,idctaentregado,idctarecibido,nroidentificador);
				Value (Csrvalor.numero,Csrvalor.nombre,ldfecha+lndias,lntotalcomp,lcidcuenta;
				,"",0,"","","",0,ldfecha+lndias,CsrAuxCabefac.cnombre,Csrplanpago.idvalor,0,lctipocaja,0,lcclasevalor;
				,CsrAuxCabefac.cnombre,0,0,CsrAuxCabefac.idctacte,CsrAuxCabefac.idctacte,0,"")
			else              
				if lntotcuota<>lntotalcomp
					go top
					lnimporte = (lntotalcomp-lntotcuota)
					lnimporte = iif(importe=0,lntotalcomp,(importe+lnimporte))
					repl importe with lnimporte
				endif
			endif
			
			&&Marcos 2014/09/29
			&&Si es una negociacion mostramos las cuotas generadas
			SELECT CsrPago
			GO TOP 
			IF LEN(LTRIM(lcdias))<>0
				ncuota = 1
				lmaxcuota = .f.
				LOCAL aPieCuota[9]
				FOR i=1 TO 9
					aPieCuota[i] = ""
				ENDFOR 
		*!*			STORE "" TO cDetaPie01,cDetaPie02,cDetaPie03,cDetaPie04,cDetaPie05,cDetaPie06,cDetaPie07
		*!*			STORE "" TO cDetaPie08, cDetaPie09
				
				DO WHILE ncuota <= 9 AND NOT EOF()
					IF ncuota < 9
						SET CENTURY ON 
						
						aPieCuota[ncuota] = DTOC(CsrPago.fecha) + " $"+strtrim(CsrPago.importe,8,2)
						
						SET CENTURY OFF 
					ELSE
						aPieCuota[ncuota] = " + cuotas"
					ENDIF 
					ncuota = ncuota + 1
					SET CENTURY OFF  
		
					SKIP IN CsrPago           
				ENDDO 
				
		*!*			replace detapiecuota01 WITH cDetaPie01, detapiecuota02 WITH cDetaPie02, detapiecuota03 WITH cDetaPie03;
		*!*					, detapiecuota04 WITH cDetaPie04, detapiecuota05 WITH cDetaPie05, detapiecuota06 WITH cDetaPie06;
		*!*					, detapiecuota07 WITH cDetaPie07, detapiecuota08 WITH cDetaPie08, detapiecuota09 WITH cDetaPie09 IN CsrAuxCabefac
				replace detapiecuota01 WITH aPieCuota[1], detapiecuota02 WITH aPieCuota[2], detapiecuota03 WITH aPieCuota[3];
						, detapiecuota04 WITH aPieCuota[4], detapiecuota05 WITH aPieCuota[5], detapiecuota06 WITH aPieCuota[6];
						, detapiecuota07 WITH aPieCuota[7], detapiecuota08 WITH aPieCuota[8], detapiecuota09 WITH aPieCuota[9] IN CsrAuxCabefac
						
			ENDIF 
				
			SELECT CsrAuxCabefac
		  	*vista()
		*!*	ENDSCAN 
		
		
	ENDPROC

	PROCEDURE totalporhoja
		LPARAMETERS lHayFrio
		lHayFrio = IIF(PCOUNT()<1,.f.,lHayFrio)
		
		LOCAL lnrecno,lnTotalFac,lnTotalPagar,lnBaseSubtotal,lndecimaluni,lndecimaltot,lntasa,lnCalculo,lninterno,lnpreunita
		LOCAL lnBaseGra,lnBaseExe,i,lnbase,lnUniCiva,lnBaseRetencion,lnBaseInterno,lnBaseIva,lnBaseCiva,lnBaseDescuento,lnBaseNoCatego
		LOCAL lnBaseIBTO1,lnBaseIBTO2,lnPerceibto1,lnerceibto2,ldfechafac,lnTotNoCatego,lnIvaUni,lnidctavta,lnUniTotal
		LOCAL lnEsCambio,llProcesoCorrecto
		
		WITH thisform
			lndecimaluni   = .ndecimaluni
			lndecimaltot   = .ndecimaltot
		ENDWITH
		
		llProcesoCorrecto = .t.
		
		lnrecno = RECNO('CsrAuxCuerfac')
		SELECT CsrAuxCuerfac
		SET ORDER TO hoja
		GO TOP 
		
		SELECT CsrAuxCabefac
		GO TOP 
		nRecnoCabe = RECNO('CsrAuxCabefac')
		SCAN FOR NOT EOF() AND llProcesoCorrecto
		
			STORE 0 TO lnTotalFac,lnTotalPagar,lnBaseGra,lnBaseExe,lnBase,lnUniCiva,lntasa,lnCalculo,lnTotNoCatego
			STORE 0 TO lnBasedescuento,lnBaseIva,lnBaseCiva,lnBaseSubtotal,lnBaseNoCatego,lnBaseRetencion,lnBaseInterno
			STORE 0 TO lnBaseIBTO1,lnBaseIBTO2,lnPerceibto1,lnPerceibto2,lninterno,lnpreunita,lnIvaUni,lnUniTotal
			STORE 0 TO lnBaseDesctoSiva,lnidctavta,lnEsCambio
			STORE 0 TO lnBasePerceIVA   
			
			loObjiva       = null
			loObjRetencion = null
		
			WITH thisform
				.agregaobjeto.objimpuestovta(@loObjIva,@loObjRetencion)
			ENDWITH
		
			SCATTER NAME OscatterCab
			ldfechafac     = TTOD(OscatterCab.fecha)
			
			SELECT CsrAuxCuerfac
			*SEEK OscatterCab.hojaactual
			LOCATE FOR CsrAuxCuerfac.hojaactual = OscatterCab.hojaactual AND CsrAuxCuerfac.idmaopera = OscatterCab.idmaopera 
		
			DO WHILE !EOF() AND OscatterCab.hojaactual = CsrAuxCuerfac.hojaactual AND CsrAuxCuerfac.idmaopera = OscatterCab.idmaopera 
				
				IF lHayFrio
					IF OscatterCab.idfrio != CsrAuxCuerfac.idfrio
						SELECT CsrAuxCuerfac
						SKIP 
						LOOP 
					ENDIF 
				ENDIF 
				
				lnCant      = CsrAuxCuerfac.cantidad
				lnEsCambio = CsrauxCuerfac.esCambio
				
				IF lncant<0 OR lnEsCambio=1
					SKIP 
					LOOP
				ENDIF 	
		
				lnDesctoCiva = CsrAuxCuerfac.desctoCiva
				lnDesctoSiva = CsrAuxCuerfac.desctoSiva     
				*lninterno   = CsrAuxCuerfac.interno
				lninterno   = CsrAuxCuerfac.internofin
				*lnpreunita  = CsrAuxCuerfac.preunita
				lnpreunita  = IIF(thisform.incluyeiva,CsrAuxCuerfac.preunita,CsrAuxCuerfac.preunitasiva)
				lnUniSiva   = CsrAuxCuerfac.UniSiva
				lnUniCiva   = CsrAuxCuerfac.UniCiva
				lnuniventa  = CsrAuxCuerfac.univenta
				lnunibulto  = IIF(CsrAuxCuerfac.unibulto=0,1,CsrAuxCuerfac.unibulto)
				lnunibulto  = IIF(lnuniventa=1,1,lnunibulto)
				lntasa      = CsrAuxCuerfac.tasaiva
				lnIvaUni    = CsrAuxCuerfac.Ivauni
				lntotalLine = CsrAuxCuerfac.total
				lnidctavta  = CsrAuxCuerfac.idctavta
				lnkilos = CsrAuxCuerfac.kilos
				lnpesable = CsrauxCuerfac.pesable
		
				IF lntasa#0
					lnAbase   = red(lnUniSiva,lndecimaltot)
					lnCalculo = red(lnIvaUni,lndecimaluni) 
					thisform.unitariofac.acumulaimpuesto(@loObjIva,TRANSFORM(lnidctavta,"9999999999")+TRANSFORM(lntasa,"99.99"),lnAbase,lntasa,lnCalculo,"IVA "+TRANSFORM(lntasa,"99.99"),lnidctavta)
					
					IF CsrAuxCuerfac.perceiva5329=1 AND  Thisform.CalculoPIVA5329
						nAlicuotaPI = IIF(lnTasa = 21,3,IIF(lnTasa=10.5,1.5,0))
						IF nAlicuotaPI #0
							lnPerceIVA = red(lnUniSiva * nAlicuotaPI / 100,lndecimaltot)
							lnBasePerceIVA   = lnBasePerceIVA+ lnPerceIVA 
							
							thisform.unitariofac.acumulaimpuesto(@loObjRetencion,"PIVA"+TRANSFORM(nAlicuotaPI ,"99.99"),lnUniSiva ,nAlicuotaPI ,lnPerceIVA ,"PIVA "+TRANSFORM(nAlicuotaPI ,"99.99"),0)
						ENDIF 
					ENDIF 
				ELSE
					lnBaseExe  = lnBaseExe + red(lnUniSiva,lndecimaltot)
				ENDIF    
				lnBaseInterno    = lnBaseInterno   + red(lninterno,lndecimaltot)
				lnBaseCiva       = lnBaseCiva      + red(lnUniCiva,lndecimaltot)
				lnBaseDescuento  = lnBaseDescuento  + red(lndesctoCiva,lndecimaltot)
				lnBaseDesctoSiva = lnBaseDesctoSiva + red(lndesctoSiva,lndecimaltot)
		
				IF CsrAuxCuerfac.perceibruto=1
					lnBaseIBTO1   = lnBaseIBTO1 + red(lnUniSiva,lndecimaltot)
				ENDIF 
				lnBaseIBTO2      = lnBaseIBTO2 + red(lnUniSiva,lndecimaltot)
		
				SELECT CsrAuxCuerfac
				SKIP 
			ENDDO 
		
			lnBaseGra = loObjIva.base1     + loObjIva.base2     + loObjIva.base3     + loObjIva.base4     + loObjIva.base5
			lnBaseIva = loObjIva.impuesto1 + loObjIva.impuesto2 + loObjIva.impuesto3 + loObjIva.impuesto4 + loObjIva.impuesto5
		
			IF CsrCategoiva.fiscal $ 'T' && no categorizado  (NOCATEGORI no cambiar, lo usa actualizar impuesto)
			    lnBaseNoCatego = lnBaseGra+lnBaseiva
			    lntasa         = CsrCategoiva.tasa1
			    lnCalculo      = red(lnBaseNoCatego*lntasa/100,lndecimaltot)    
				IF lnBaseNoCatego#0
				   thisform.unitariofac.Acumulaimpuesto(@loObjRetencion,"NOCATEGORI",lnBaseNoCatego,lntasa,lnCalculo,"NO CATEGO.",0)
				   lnTotNoCatego = lnTotNoCatego + lnCalculo
				ENDIF
			ENDIF
		
			STORE 0 TO lnPerceibto1,lnPerceibto2
		
			&&Bloqueamos el comprobante, pq todos los generados aca. se calcula impuestos.
			IF CsrCategoiva.fiscal $ 'IMN' AND CsrComprobante.clase$'ABCU'  && RI / MT / rni (IBTO1 y IBTO2 no cambiar, lo usa actualizar impuesto)
				IF CsrCategoiva.fiscal $ 'M'
					lnBaseIBTO1 = lnBaseIBTO1 + lnBaseiva
					lnBaseIBTO2 = lnBaseIBTO2 + lnBaseiva
				ENDIF 
		
				IF lnBaseIBTO1#0 AND lnBaseIBTO1 >= Csrprovincia.minimo1 AND Csrcatectacte.porperce=0
					lnPerceibto1 = red(lnBaseIBTO1*Csrprovincia.alicuota1/100,lndecimaltot)	   
					thisform.unitariofac.Acumulaimpuesto(@loObjRetencion,"IBTO1",lnBaseIBTO1,Csrprovincia.alicuota1,lnPerceibto1,"IBTO "+TRANSFORM(Csrprovincia.alicuota1,"99.99")+"%",0)
				ENDIF 
				IF lnPerceibto1#0
					lnBaseIBTO2 = red(lnBaseIBTO2 - lnBaseIBTO1,lndecimaltot)
				ENDIF 
				IF lnBaseIBTO2#0 AND lnBaseIBTO2 >= Csrprovincia.minimo2 AND ldfechafac >= TTOD(Csrprovincia.fecdesde2)
					lntasaib = CsrCateCtacte.porperce
					IF lntasaib=-1
						lntasaib = IIF(CsrCategoiva.fiscal='M',Csrprovincia.alicuota3,Csrprovincia.alicuota2)
					ENDIF 
					lnPerceibto2 = red(lnBaseIBTO2*lntasaib/100,lndecimaltot)
					thisform.unitariofac.Acumulaimpuesto(@loObjRetencion,"IBTO2",lnBaseIBTO2,lntasaib,lnPerceibto2,"IBTO "+TRANSFORM(lntasaib,"99.99")+"%",0)
				ENDIF 
			ENDIF
			
			lnBaseRetencion = loObjRetencion.impuesto1 + loObjRetencion.impuesto2 + loObjRetencion.impuesto3 + loObjRetencion.impuesto4 + loObjRetencion.impuesto5
			*lnBaseRetencion = red(lnBaseRetencion - lnTotNoCatego,lndecimaltot)
			lnBaseRetencion = red(lnBaseRetencion - lnTotNoCatego - lnBasePerceIVA ,lndecimaltot)
			
			IF lnBasePerceIVA  = 0 OR  lnBasePerceIVA   < This.MinimoPIva5329  OR NOT CsrCategoiva.fiscal $ 'I' OR NOT CsrComprobante.clase$'ABCU'  		
				thisform.unitariofac.VaciarImpuesto(@loObjRetencion,"PIVA"+TRANSFORM(3 ,"99.99"))
				thisform.unitariofac.VaciarImpuesto(@loObjRetencion,"PIVA"+TRANSFORM(1.5 ,"99.99"))
				lnBasePerceIVA  = 0
			ENDIF 
				
			
			IF lnBaseRetencion < 0
				lnBaseRetencion = 0
			ENDIF
		
			IF GOapp.empresatipoiva#1
				 lnBaseExe = lnBaseExe + lnBaseGra
				 lnBaseGra = 0
				 lnBaseiva = 0
				 lnBaseRetencion = 0
			ENDIF
		
			lnBaseSubSiva  = lnBaseGra + lnBaseExe + lnBaseInterno &&+ lnBaseDesctoSiva
			lnBaseSubCiva  = lnBaseGra + lnBaseExe + lnBaseInterno + lnBaseIva &&+ lnBaseDescuento
			*lnTotalFac     = lnBaseGra + lnBaseExe + lnBaseInterno + lnBaseIva + lnBaseretencion + lnTotNoCatego
			lnTotalFac     = lnBaseGra + lnBaseExe + lnBaseInterno + lnBaseIva + lnBaseretencion + lnTotNoCatego + lnBasePerceIVA 
			lnTotalpagar   = lnTotalFac
			
			REPLACE idctavta1 WITH loObjIva.idctavta1,ivari1 WITH loObjIva.impuesto1,BaseGra1 WITH loObjIva.Base1,tasa1 WITH loObjIva.tasa1;
				   ,idctavta2 WITH loObjIva.idctavta2,ivari2 WITH loObjIva.impuesto2,BaseGra2 WITH loObjIva.Base2,tasa2 WITH loObjIva.tasa2;
				   ,idctavta3 WITH loObjIva.idctavta3,ivari3 WITH loObjIva.impuesto3,BaseGra3 WITH loObjIva.Base3,tasa3 WITH loObjIva.tasa3;
				   ,idctavta4 WITH loObjIva.idctavta4,ivari4 WITH loObjIva.impuesto4,BaseGra4 WITH loObjIva.Base4,tasa4 WITH loObjIva.tasa4;
				   ,idctavta5 WITH loObjIva.idctavta5,ivari5 WITH loObjIva.impuesto5,BaseGra5 WITH loObjIva.Base5,tasa5 WITH loObjIva.tasa5;
				   ,nomrete1 WITH loObjRetencion.nombre1,retencion1 WITH loObjRetencion.impuesto1,baserete1 WITH loObjRetencion.base1,tasarete1 WITH loObjRetencion.Tasa1;
				   ,nomrete2 WITH loObjRetencion.nombre2,retencion2 WITH loObjRetencion.impuesto2,baserete2 WITH loObjRetencion.base2,tasarete2 WITH loObjRetencion.Tasa2;
				   ,nomrete3 WITH loObjRetencion.nombre3,retencion3 WITH loObjRetencion.impuesto3,baserete3 WITH loObjRetencion.base3,tasarete3 WITH loObjRetencion.Tasa3;
				   ,nomrete4 WITH loObjRetencion.nombre4,retencion4 WITH loObjRetencion.impuesto4,baserete4 WITH loObjRetencion.base4,tasarete4 WITH loObjRetencion.Tasa4;
				   ,nomrete5 WITH loObjRetencion.nombre5,retencion5 WITH loObjRetencion.impuesto5,baserete5 WITH loObjRetencion.base5,tasarete5 WITH loObjRetencion.Tasa5;
				   ,total WITH lnTotalFac IN CsrAuxCabefac	   
				   
			REPLACE BaseExe WITH lnBaseExe,BaseInterno WITH lnBaseInterno,BaseDescto WITH lnBasedescuento,BaseDesctoSiva WITH lnBasedesctoSiva;
			   	,BaseGra WITH lnBaseGra,BaseIva WITH lnBaseiva,BaseNocatego WITH lnTotNoCatego,Perceibto1 WITH lnPerceibto1,Perceibto2 WITH lnPerceibto2;
			   	,SubtotSiva WITH lnBaseSubSiva,SubtotCiva WITH lnBaseSubCiva IN CsrAuxCabefac
			   	
			replace hojatotal WITH hojaactual IN CsrAuxCabefac
			
			replace PerceIVA5329 WITH lnBasePerceIVA in CsrAuxCabefac
			   	
			IF CsrAuxCabefac.total < 0
				llProcesoCorrecto = .f.
				oavisar.usuario('Error'+CHR(13)+"La division de hojas de la factura encontro total en negativo",0)
			ENDIF 
			
			SELECT CsrAuxCabefac
			
			this.totalhojapagos()
			
		ENDSCAN 
		
		SELECT CsrAuxCabefac
		GO RECORD nRecnoCabe
		
		IF !EOF('CsrAuxCuerfac')
			SET ORDER TO orden IN CsrAuxCuerfac
			GO RECORD lnrecno IN CsrAuxCuerfac
		ENDIF
		
		loObjiva       = null
		loObjRetencion = null
		
		RETURN llProcesoCorrecto
		
	ENDPROC

	PROCEDURE traerdatosextra		&& Trae datos extra para el articulo
		PARAMETERS lnidproducto,lnidctacte
		
		LOCAL lok,lcCmd
		WITH thisform 
			* bonificacion por cliente / producto
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			Select Csrbonictacte.* from bonictacte as Csrbonictacte
			where Csrbonictacte.idctacte =<<lnidctacte>> and Csrbonictacte.idproducto =<<lnidproducto>>
			ENDTEXT 
		
			IF !.obtenerdatos('Csrbonictacte',lccmd)
			   .Release 
			ENDIF    
		
			* existencia
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT Csrexistenc.* from existenc as Csrexistenc
			where Csrexistenc.idarticulo = <<lnidproducto>> and Csrexistenc.iddeposito=<<thisform.lniddeposito>>
			ENDTEXT 
		
			IF !.obtenerdatos('CsrExistenc',lccmd)
				.release
			ENDIF 
			
			.containervariedad.grid1.RecordSource = ""
			
			*stop()
			
			.lhayvariedad = .f.
			&&Montenegro no usa variedades
			*IF goapp.codempresa <> 10 
				
				lcvariedad = "CsrSubProducto.id > 0 "
				IF NOT VARTYPE(thisform.loObjParamKit)$'U-X'
					lcvariedad = "CsrSubProducto.id = " + strtrim(this.loObjParamKit.idsubarti,10)
				ENDIF 
		
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT id, idarticulo, numero, subnumero,(convert(char(3),subnumero)+' '+ nombre) as nombre, nofactura,idvariedad,estado
				,000000.00 as cantidad,000000.000 as kilos,000000.000 as volumen, <<RECNO('CsrAuxCuerFac')>> as pos
				,nombre as nomvariedad
				FROM subProducto as Csrsubproducto
				where Csrsubproducto.idarticulo = <<lnidproducto>> AND nofactura=0 and estado = 0
				and <<lcvariedad>>
				ORDER BY subnumero
				ENDTEXT 
		
				IF !.obtenerdatos('Csrsubproducto',lccmd)
				   .Release 
				ENDIF    
		
				SELECT CsrSubproducto
				GO top
				SCAN FOR !EOF()
					SELECT CsrAuxCuerVari
					LOCATE FOR idsubarti = CsrSubproducto.id AND idarticulo = lnidproducto AND registro = CsrAuxCuerfac.registro
					IF !EOF() AND idsubarti = CsrSubproducto.id AND idarticulo = lnidproducto AND registro = CsrAuxCuerfac.registro
					   REPLACE cantidad WITH CsrAuxCuervari.cantidad IN CsrSubproducto
					ENDIF 					
					SELECT Csrsubproducto
					REPLACE kilos WITH Csrproducto.peso,volumen WITH Csrproducto.volumen
				ENDSCAN 	
		
				SELECT CsrSubproducto
				GO top
				.lhayvariedad = IIF(RECCOUNT("CsrSubproducto")#0,.t.,.f.)
					
				.containervariedad.grid1.RecordSource = "Csrsubproducto"
				.containervariedad.grid1.column1.ControlSource = "nombre"
				.containervariedad.grid1.column2.ControlSource = "cantidad"
			*ENDIF 
		ENDWITH 
		
	ENDPROC

	PROCEDURE traerproductofuerzavta		&& Genera cursor con productos segun fuerza de venta concatena bonificacion vdor, promocion y unificacion
		PARAMETERS lnidfuerzavta
		LOCAL lcCmdFuerza
		lcCmdFuerza = ''
		TEXT TO lcCmdFuerza TEXTMERGE NOSHOW 
		SELECT Csrprodfzavta.id,ISNULL(Csrrubro.idfuerzavta,0) as idfuerzavta,ISNULL(CsrRubro.id,0) as idrubro
		,ISNULL(Csrcabepromo.id,0) as idcabepromo,ISNULL(Csrcabepromo.idprodpromo,0) as idprodpromo
		,ISNULL(Csrcabepromo.idprodregalo,0) as idprodregalo
		,ISNULL(Csrcabepromo.cada,0) as cada,ISNULL(Csrcabepromo.entrega,0) as entrega
		,Csrcabepromo.fechasta as fecCabepromo
		,ISNULL(Csrcuerpromo.id,0) as idcuerpromo,ISNULL(Csrcuerpromo.candesde,0) as candesde
		,ISNULL(Csrcuerpromo.canhasta,0) as canhasta
		,ISNULL(Csrcuerpromo.bonifica,0) as bonCuerpromo,Csrcuerpromo.fechasta as fecCuerpromo
		,ISNULL(CsrBonivdor.id,0) as idBonivdor,ISNULL(CsrBonivdor.idvendedor,0) as idvendedor
		,ISNULL(Csrbonivdor.bonifica,0) as bonVdor,ISNULL(Csrbonivdor.diasvisita,'') as Diasvisita
		,ISNULL(Csrbonivdor.diasfactura,'') as diasfactura
		,ISNULL(Csrcuerunifica.id,0) as idcuerunifica,ISNULL(Csrcuerunifica.idcabeunifica,0) as idcabeunifica
		,CsrProdfzaVta.Desc1,CsrProdfzaVta.Min1,CsrProdfzaVta.Desc2,CsrProdfzaVta.Min2
		,CsrProdfzaVta.Desc3,CsrProdfzaVta.Min3,CsrProdfzaVta.FecOferta
		,ISNULL(CsrCabePromo.stockregalo,0) as stockregalo
		,ISNULL(CsrRubro.bonif1,0) as BonRubro,ISNULL(CsrRubro.fechabonif,'19000101') as FecRubro
		,ISNULL(CsrRubro.switch,'00000') as SwitchRubro 
		,ISNULL(CsrCabeCombo.id,0) as idpromocombo,ISNULL(CsrCabeCombo.feccorte,'19000101') as FecCombo
		 FROM producto as Csrprodfzavta
		left join rubro as Csrrubro on Csrprodfzavta.idrubro = Csrrubro.id 
		left join cabepromo as Csrcabepromo on Csrprodfzavta.id = Csrcabepromo.idprodgenera
		left join cuerpromo as Csrcuerpromo on CsrCabepromo.id = Csrcuerpromo.idcabepromo
		left join bonivdor as Csrbonivdor on Csrprodfzavta.id = Csrbonivdor.idproducto
		left join cuerunifica as Csrcuerunifica on Csrprodfzavta.id = Csrcuerunifica.idproducto
		left join cabecombo as CsrCabeCombo on Csrprodfzavta.id = CsrCabeCombo.idpromocion
		where Csrprodfzavta.nofactura = 0 and Csrrubro.idfuerzavta = <<lnidfuerzavta>>
		ENDTEXT 
		
		Oavisar.proceso('S','Lee productos fuerza de venta '+Csrfuerzavta.nombre)
		=SaveSQL(lcCmdFuerza,this.Name+"_prodfzavta")
		IF !thisform.obtenerdatos('Csrprodfzavta',lcCmdFuerza)
		   thisform.Release 
		ENDIF    
		
		Oavisar.proceso('N')
		
		SET SAFETY OFF 
		SELECT Csrprodfzavta
		INDEX on id TAG id 
		INDEX on idcabeunifica TAG idcabuni
		SET SAFETY ON 
		
		CURSORSETPROP("Buffering",5,'Csrprodfzavta')
		
	ENDPROC

	PROCEDURE traerproductosbloqueados		&& se traen todos los productos bloqueados del sistema
		&& traemos los productos bloqueados una unica vez
		TEXT TO lccmd TEXTMERGE NOSHOW 
		SELECT CsrBloqueoProd.* FROM BloqueoProd as CsrbloqueoProd
		order by idctacte, idarticulo,idsubarti
		ENDTEXT 
		thisform.obtenerdatos('CsrBloqueoProd',lccmd)
	ENDPROC

	PROCEDURE validaracumuladovales
		*!*	LOCAL lnidctactevendedor,lnsuma
		
		*!*	IF THISFORM.esvale='0'
		*!*	    RETURN .t.
		*!*	endif
		
		*!*	lnidctactevendedor=csrvendedor.idctacte
		
		*!*	TEXT TO lcCmd TEXTMERGE NOSHOW 
		*!*	Select csrctacte.id,csrctacte.saldo,csrctacte.saldoauto FROM ctacte as csrctacte WHERE id=<<lnidctactevendedor>>
		*!*	ENDTEXT
		*!*	lok =CrearCursorAdapter("Csrctactevendedor",lcCmd) 
		*!*	IF lok
		*!*		lnsuma=red(Csrctactevendedor.saldo+csrvendedor.acumulavale+ThisForm.Containertotales._txttotal.Value)
		*!*	    IF lnsuma>csrctactevendedor.saldoauto
		*!*	        thisform.cadenaerrores=thisform.cadenaerrores+"VALES = Saldo Autorizado : "+ALLTRIM(TRANSFORM(csrctactevendedor.saldoauto,'999999999.99'))+" Saldo Comprobante incluído : "+ALLTRIM(TRANSFORM(lnsuma,'999999999.99'))
		*!*	        RETURN .f.
		*!*	    endif
		*!*	else
		*!*		RETURN .f.
		*!*	endif
	ENDPROC

	PROCEDURE validarcomproba
		LOCAL llok,lineaok,lokcuit,lccuit
		
		llok=.t.
		WITH thisform
			.cadenaerrores = ''	
		  	
		  	TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT CsrParaVario.* FROM ParaVario as CsrParaVario
			ENDTEXT 
			IF NOT CrearCursorAdapter('CsrParaVario',lccmd)
				thisform.Release
			ENDIF 
			
			IF this.tipofactura='M'
			  	SELECT CsrParaVario
				LOCATE FOR nombre='PFISCALPRE'
				ldpefiscal = CsrParaVario.fecha
				ldfecha = CTOD("01"+SUBSTR(DTOC(CsrAuxCabefac.fecha),3) )
				IF .tipoform#'N'
					.ve_condicion((GOMONTH(ldfecha,-1)<ldpefiscal) OR (GOMONTH(ldpefiscal,2)<ldfecha),'La fecha de emisión es menor o igual al ultimo periodo presentado'+CHR(13);
									+'o el periodo presentado es menor a mas de dos meses con la fecha de emisión'+CHR(13)+"UTILES > PAREMETOS > CIERRE IVA")
				ENDIF 
			ENDIF 
		*!*		IF !thisform.validaracumuladovales()
		*!*	     		.ve_condicion(.t.,'')    
		*!*	   	ENDIF 
			.ve_condicion(EMPTY(.Containerencabeza.KitbuscaoaltaenCtacte.Txtexiste1.Value),'El nº de cliente no puede ser nulo ...')
			.ve_condicion(EMPTY(.Containeringreso.Kitbuscaoaltaenfuerzavta.Txtexiste1.Value),'La fuerza de venta no puede ser nulo ...')
			.ve_condicion(EMPTY(.Containeringreso.Kitbuscaoaltaenvendedor.Txtexiste1.Value),'El Vendedor no puede ser nulo ...')  
			.ve_condicion(.tipoform#'N' and EMPTY(.Containeringreso.KitbuscaoaltaenFletero.Txtexiste1.Value),'El fletero no puede ser nulo ...')  
			.ve_condicion(.tipoform='D' .and. csrcomprobante.signostock=2,'EN DESCARGAS SOLO SE ADMITEN COMPROBANTES DE ENTADA DE STOCK...')    
			lokcuit=.t.
			lccuit=cuit(LEFT(pelocuit(.Containerencabeza._txtcuit.value)+strzero(0,11),11))
			if ALLTRIM(Csrcategoiva.fiscal)$'I-N-E-M'		&& RI,RNI,exento,monotributo
				lokcuit = vericuit(lccuit)
			ENDIF
			IF CsrComprobante.clase$'ABC'
		    	.ve_condicion(!lokcuit,'El CUIT no es válido para el tipo de cliente ...')  
		    ENDIF 
		  
		  	&&Marcos 19/03/2015
			&&Si la categoria del cliente es sin remito
			
			IF NOT goapp.codempresa=3 &&Mardones
				IF .tipoform$"F" AND .tipofactura$"NM" AND CsrComprobante.clase$'XH' AND NVL(CsrCateCtacte.remito,0) = 1
					.ve_condicion(.t.,'El Cliente no esta habilitado para este tipo de COMPROBANTE.'+CHR(13)+;
									'Consulte las propiedades de la Categoria del Cliente.')
				ENDIF 
			ENDIF 
			
		    IF !EMPTY(.cadenaerrores)
		     llok=.f.
		     thisform.cadenaerrores = .cadenaerrores + CHR(13)+CHR(13)+'Verifique los datos y vuelva a confirmar'
		   ENDIF 
		  
		ENDWITH 
		
		*stop()
		lerropesable = .f.
		lerrorcadena = ''
		
		lndecimaltot = thisform.ndecimaltot
		lcidarticulo = ''
		SELECT csrauxcuerfac
		LNTOTAL = 0
		GO TOP 
		SCAN
			lcidarticulo = LTRIM(lcidarticulo) + IIF(LEN(LTRIM(lcidarticulo))=0,'',',')+ STR(CsrAuxCuerfac.idarticulo)
				
			lineaok=.t.
			IF idarticulo<>0 and (escambio=1  OR espromocion=1)
				LOOP 
			ENDIF 
			IF idarticulo<>0 AND cantidad=0
			   thisform.cadenaerrores=thisform.cadenaerrores+'Cantidad = 0'
			   lineaok=.f.
			ENDIF
			
			IF idarticulo<>0 AND cantidad<>0 AND precosto>1 AND (preunita = 0 OR preunitasiva=0)
			   thisform.cadenaerrores=thisform.cadenaerrores+ CHR(13) +'Código '+ LTRIM(csrauxcuerfac.codigo) +' PRECIO = 0'
			   lineaok=.f.
			ENDIF
			
			IF idarticulo<>0 AND iddeposito=0
			   thisform.cadenaerrores=thisform.cadenaerrores+'Depósito = 0'
			   lineaok=.f.
			ENDIF
			
			IF idarticulo<>0 AND pesable = 1 
				IF cantkilos < (cantidad*kilos*0.9) OR cantkilos > (cantidad*kilos*1.1)
					lerrorcadena = lerrorcadena + CHR(13) +'Código '+ LTRIM(csrauxcuerfac.codigo) +  ' Kilos fuera de rango'
					lerropesable = .t.
				ENDIF 
			ENDIF 
		*    OJO decia preunita toco gabriel
		    && Comentado para que pasen precios en cero por las promociones nuevas de danone 
		    
		*!*		IF idarticulo<>0 AND preunitasiva=0 AND espromocion=0 AND escambio=0 AND espromocion=0
		*!*		   thisform.cadenaerrores=thisform.cadenaerrores+'Precio = 0'
		*!*		   lineaok=.f.
		*!*		ENDIF
			
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT Csrsubproducto.id FROM subProducto as Csrsubproducto
			where Csrsubproducto.idarticulo = <<Csrauxcuerfac.idarticulo>> and nofactura=0
			and estado= 0
			ENDTEXT 
		
			crearcursoradapter('Csrcursor',lccmd)
			
		
			llhayvariedad = IIF(RECCOUNT("CsrCursor")#0,.t.,.f.)
			IF llhayvariedad
				SELECT CsrAuxcuervari
				SET FILTER TO 
				SUM ALL cantidad FOR idarticulo = Csrauxcuerfac.idarticulo AND registro=CsrAuxCuerfac.registro TO lnsuma
				lnsuma = IIF(CsrAuxCuerfac.escambio=0,lnsuma,ABS(lnsuma))
				IF lnsuma#CsrAuxCuerfac.cantidad
					thisform.cadenaerrores=thisform.cadenaerrores+CHR(13);
								+'Hay diferencia de cantidad entre articulo y sus variedades'
					lineaok=.f.
					**&&''
					*IF NOT this.lomitirexistenc			
					*	lineaok=.f.
					*ENDIF 
				ENDIF
				
				IF lineaok=.f.
					Thisform.cadenaerrores=CHR(13)+'Código '+csrauxcuerfac.codigo+' '+thisform.cadenaerrores+CHR(13)
				ENDIF
			endif
			IF lineaok=.f.	
			   llok=.f.
			ENDIF
			
			SELECT csrauxcuerfac
			*vista()
			IF LEN(ALLTRIM(csrauxcuerfac.nombre))<>0 .and. idarticulo<>0 AND cantidad<>0
			   lntotal=lntotal+Red(UniCiva + internofin,lndecimaltot)
			endif
		ENDSCAN
		
		IF this.chkomitirmerma.Value = 0
			IF lerropesable
				lerrorcadena = lerrorcadena + CHR(13) + CHR(13) + "Presione ACEPTAR para confirmar la merma de kilos"
				IF oavisar.usuario(lerrorcadena,1+16+256) != 1
					this.cadenaerrores = 'Cancelado por el usuario, encontro diferencia de kilos'
					RETURN .f.
				ENDIF 
			ENDIF 
		ENDIF 
		
		IF !Csrcomprobante.clase$'1'
			WITH thisform.containertotales
				**&&''
				this.totalcomprobante()
				nTotalComp = ._txtnetogravado.Value+._txtnetoexento.value+._txtinterno.Value+._txtiva.value
				IF round(lntotal,2)<(nTotalComp - (nTotalComp*(1/100))) OR round(lntotal,2)>(nTotalComp + (nTotalComp*(1/100)))
					thisform.cadenaerrores=thisform.cadenaerrores+CHR(13)+'La Suma de los productos difiere del Total ';
					+chr(13)+"Total de productos:"+strtrim(lnTotal,11,2);
					+chr(13)+"Total de comprobante:"+strtrim(nTotalComp,11,2)
					lineaok=.f.
				ENDIF 
			ENDWITH 
			SELECT CsrParaVario
			LOCATE FOR nombre='TOPEFISCALCF'
			IF nombre='TOPEFISCALCF' AND CsrCategoiva.fiscal$"C" AND CsrComprobante.clase$"ABC" AND Csrprefitermi.tipoimpresora=3
				IF CsrParaVario.importe < red(lntotal,2) AND CsrParaVario.importe >0
					thisform.cadenaerrores=thisform.cadenaerrores+CHR(13)+"Los clientes CONSUMIDOR FINAL no pueden facturar mas del tope establecido "+strtrim(CsrParaVario.importe,11,2)
					lineaok=.f.
				ENDIF 
			ENDIF 
		ENDIF 
		
		**&&''
		&&Si es una nota de pedido, validamos el minimo
		IF Csrcomprobante.clase$'IA' AND CsrcanalVta.minimofac > 0
			WITH thisform.containertotales
				IF red(lntotal,2) < CsrcanalVta.minimofac
					thisform.cadenaerrores=thisform.cadenaerrores+CHR(13)+'El total no cumple el limite minimo establacido por el canal de vta '
					lineaok=.f.
				ENDIF 
				
			ENDWITH 
		ENDIF 
		
		**&&''
		IF this.lpidoexistenc AND lineaok AND STR(CsrAuxMaopera.idcomproba,10)$thisform.idctastockresta
			* existencia
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT Csrexistenc.* from existenc as Csrexistenc
			where Csrexistenc.idarticulo in (<<lcidarticulo>>) and Csrexistenc.iddeposito=<<thisform.lniddeposito>>
			ENDTEXT 
			IF !thisform.obtenerdatos('CsrExistenc',lcCmd)
				RETURN .f.
			ENDIF 
			
			SELECT csrauxcuerfac.idarticulo,IIF(ISNULL(csrauxcuervari.idsubarti),0,csrauxcuervari.idsubarti) as idsubarti;
			,SUM(IIF(ISNULL(csrauxcuervari.cantidad),csrauxcuerfac.cantidad,csrauxcuervari.cantidad)) as cantidad;
			,CsrAuxCuerfac.nombre;
			FROM CsrAuxCuerfac LEFT JOIN CsrauxCuervari ON CsrAuxCuerfac.idarticulo = CsrAuxCuervari.idarticulo;
			WHERE CsrauxCuerfac.infstock = 1 ;
			GROUP BY csrauxcuerfac.idarticulo,csrauxcuervari.idsubarti,CsrAuxCuerfac.nombre;
			INTO CURSOR CsrAuxCantidad READWRITE 
			
			SELECT Csrauxcantidad
			GO TOP 
			SCAN 
				lError = .t.
				SELECT CsrExistenc
				LOCATE FOR idarticulo = Csrauxcantidad.idarticulo AND idsubarti = Csrauxcantidad.idsubarti
				IF idarticulo = Csrauxcantidad.idarticulo AND idsubarti = Csrauxcantidad.idsubarti
					lError = .f.
					IF CsrExistenc.existe<Csrauxcantidad.cantidad
						lError = .t.
					ENDIF
				ENDIF 
				IF lError
					thisform.cadenaerrores=thisform.cadenaerrores+CHR(13)+'La cantidad '+RTRIM(CsrAuxCantidad.nombre)+' de '+strtrim(CsrAuxCantidad.cantidad)+' supera la existencia de '+strtrim(CsrExistenc.existe)
					IF this.lomitirexistenc OR this.importandopedidos
						IF this.lomitirexistenc			
							lineaok=.f.
							*EXIT 
						ENDIF 
						IF this.importandopedidos &&No se validan linea por linea. asi que las informamos
							lineaok=.f.
							*EXIT 
						ENDIF 
					ELSE
						lineaok=.f.
					ENDIF 
				ENDIF 
			ENDSCAN 
		ENDIF 	
		
		IF (this.lomitirexistenc OR this.importandopedidos) AND NOT lineaok
			&&Informamos, pero dejamos continuar
			oavisar.usuario(thisform.cadenaerrores)
			lineaok = .t.
		ELSE
			IF lineaok
				lineaok = this.pidototales()
			ENDIF 	
		ENDIF 
		**&&''
		
		
		IF lineaok=.f.	
		   llok=.f.
		ENDIF
		
		RETURN llok
		
	ENDPROC

	PROCEDURE validarfechacontable
		LPARAMETERS ldFecha
		
		lcfecha = " '"+DTOS(ldFecha)+"' "
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrDetanroCaja.* FROM detanrocaja as CsrDetaNroCaja WHERE fecdesde >= <<lcfecha>> and   <<lcfecha>> >=fechasta
		ENDTEXT 
		IF !CrearCursorAdapter('CsrCtrolCaja',lccmd)
			thisform.Release
		ENDIF 
		
		llok = .t.
		
		IF RECCOUNT('CsrCtrolCaja')=0
			oavisar.usuario('No se encuentra la caja')
			llok = .f.
		ELSE 
		
			IF LEFT(CsrCtrolCaja.switch,1)='1'
				oavisar.usuario('La caja se encuentra cerrada, reabrala o utilize otra')
				llok = .f.
			ELSE 
				IF thisform.lnidejercicio <> CsrCtrolCaja.idejercicio
					oavisar.usuario('La caja se encuentra fuera del ejercicio contable activo en la terminal')
					llok = .f.
				ELSE 
					replace iddetanrocaja WITH CsrCtrolCaja.id,nrocaja WITH CsrCtrolCaja.nrocaja;
							,pefiscal WITH CsrCtrolCaja.peFiscal,fecdesde WITH CsrCtrolCaja.fecdesde  IN CsrParaConfig
					
					thisform.lnidnrocaja	= Csrparaconfig.iddetanrocaja
				
					replace iddetanrocaja WITH thisform.lnidnrocaja,nrocaja WITH CsrParaConfig.nrocaja IN CsrAuxMaopera
					
					this.containerencabeza._txtnrocaja.Refresh()
				ENDIF 
			ENDIF 
		ENDIF 
		
		IF NOT llok
			this.containerencabeza._txtfecha.SetFocus()
			this.containerencabeza._txtfecha.Click()
		ENDIF 
		
	ENDPROC

	PROCEDURE validarplan		&& chequeamos si el plan de pago corresponde.
		PARAMETERS lbMostrar
		lbMostrar = IIF(PCOUNT()<1,.t.,lbMostrar)
		
		LOCAL llok
		llok = .t.
		*Se acepta el plan de pago CUENTA CORRIENTE.Si el Cliente pertenece al area de negocios.
		*Caso contrario CONTADO EFECTIVO.
		
		&&thisform.permitectacte = .f.
		LOCAL permitectacte
		permitectacte = .f.
		
		SELECT CsrPlanPago
		SCATTER NAME OscPlanPago
		
		*Si el PLAN DE PAGO original es CUENTA CORRIENTE
		lnIdPlanCtacte	= CsrCtacte.idplanpago
		
		*Si el PLAN DE PAGO ELEGIDO no es CUENTA CORRIENTE.	OK
		SELECT CsrPlanPago
		LOCATE FOR id = OscPlanPago.id
		SELECT Csrvalor
		LOCATE FOR id=CsrPlanPago.idvalor
		lcclasevalor = Csrvalor.clasevalor
		IF !'C'$lcclasevalor
			RETURN .t.
		ENDIF 
		
		&&MArcos 02/03/2015
		&&Si el comprobante es un remito, siempre debemos mandarlo a contado pendiente.
		&&Jamas a recibo de cbro, ya que esto toca contabilidad.
		IF CsrComprobante.clase$"HILMNX018" AND This.RemiCdoPde
			SELECT CsrPlanPago
			LOCATE FOR RTRIM(numero) = 'CP' &&No usamos OscCabefac.idplanpago, pq tiene el de la abmctacte
			replace idplanpago WITH CsrPlanPago.id IN CsrAuxCabefac
				
			thisform.containerencabeza._cboplanpago.SetFocus()
			thisform.containerencabeza._cboplanpago.Click()
			thisform.containerencabeza._cboplanpago.Refresh()
			RETURN .t.
		ENDIF 
			
		*Si lo cambio el plan de pago,y es CUENTA CORRIENTE
		IF lnIdPlanCtacte<>CsrPlanPago.id
			&&IF !thisform.permitectacte
			IF NOT permitectacte AND NOT CsrComprobante.clase$"HILMNX018"
				IF lbMostrar
					OAvisar.Usuario('La Cta.Cte no permite cambio en PLAN PAGO a CUENTA COPRRIENTE')
				ENDIF 
				SELECT CsrPlanPago
				LOCATE FOR id = lnIdPlanCtacte
				replace idplanpago WITH lnIdPlanCtacte IN CsrAuxCabefac
				
				thisform.containerencabeza._cboplanpago.SetFocus()
				thisform.containerencabeza._cboplanpago.Click()
				thisform.containerencabeza._cboplanpago.Refresh()
				RETURN .t.
			ENDIF 
			
		ENDIF 
		
		
		RETURN llok
		
	ENDPROC

	PROCEDURE validartopecredito		&& validacion donde chequear que el saldo mantenga los parametros especificados.
		*VALIDAMOS SI EL CLIENTE GENERA MOVCTACTE.
		*SI ALCANZO EL LIMITE DEL CANAL DE VTA.
		*SI LA SUMATORIA ES CONTADO PENDIENTE, ENTONCES VERIFICAMOS LAS FACTURAS NO RENDIDAS DEL MISMO PLAN PAGO.
		LOCAL llok,lnSumCtaCte
		lnsumCtacte = 0
		lnSumPendiente = 0
		llok = .t.
		
		IF NOT STR(CsrAuxMaopera.idcomproba,10)$thisform.idctasuma &&Creditos no controlan
			RETURN .t.
		ENDIF 
		
		SELECT CsrPago
		GO TOP 
		SCAN 
			IF CsrPago.importe = 0
				LOOP 
			ENDIF 
			lnidvalor = CsrPago.idvalor
			SELECT Csrvalor
		   	LOCATE FOR id=lnidvalor
		    * C=ctacte    
		    SELECT CsrPago
		   	IF trim(Csrvalor.clasevalor)$'C'
		   		lnSumCtacte = lnSumCtacte + CsrPago.importe
		   	ENDIF 
		   	IF trim(Csrvalor.clasevalor)$'F'
		   		lnSumPendiente = lnSumPendiente + CsrPago.importe
		   	ENDIF 
		ENDSCAN 
		
		IF lnSumCtacte#0
			TEXT TO lcCmdTope TEXTMERGE NOSHOW 
			SELECT CsrCtacte.saldo ,CsrCtacte.saldoauto,ISNULL(CsrCanalvta.limitecred,0.00) as limite
			from ctacte as Csrctacte
			left join canalvta as CsrCanalvta on CsrCtacte.idcanalvta = CsrCanalvta.id
			where CsrCtacte.id = <<CsrAuxCabefac.idctacte>>
			ENDTEXT 
			IF !CrearCursorAdapter('CsrLimite',lcCmdTope)
				thisform.Release
			ENDIF
			IF RECCOUNT('CsrLimite')#0
				lnSumCtacte = lnSumCtacte + CsrLimite.saldo
				IF lnSumCtacte > CsrLimite.saldoauto AND CsrLimite.saldoauto#0
					oavisar.usuario('El cliente ha superado el limite establecido en la ficha del CLIENTE.'+CHR(13);
									+'CONSULTE   ABM CUENTA CORRIENTE')
					llok = .f.
				ELSE
					IF CsrLimite.saldoauto=0 AND CsrLimite.limite#0 AND lnSumCtacte > CsrLimite.limite
						oavisar.usuario('El cliente ha superado el limite establecido para el CANAL de VTA..'+CHR(13);
									+'CONSULTE   ABM CANAL DE VTA')
						llok = .f.
					ENDIF 
				ENDIF 
			ENDIF
		ENDIF 
		
		&& Controlamos los vencimientos de cuenta corriente.
		IF Thisform.Fac_CtrlVencimien
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT SUM(CsrMovctacte.saldo) FROM Maopera as CsrMaopera
			inner join MovCtacte as CsrMovCtacte on CsrMaopera.id = CsrMovCtacte.idmaopera
			Where CsrMaopera.clasecomp in ('A','B')  and CsrMovCtacte.vencimien < getdate()
			ENDTEXT 
			
			IF RECCOUNT('CsrVencimientos')#0
				oavisar.usuario('El cliente posee comprobantes vencidos.'+CHR(13);
									+'CONSULTE   CUENTA CORRIENTES > REPORTES > DEUDORES > COMPOSICION DE SALDO / VENCIMIENTOS')
				llok = .f.
			ENDIF 
		ENDIF 
		
		IF lnSumPendiente#0
			TEXT TO lcCmdTope TEXTMERGE NOSHOW 
			SELECT CsrCtacte.saldoauto,ISNULL(CsrCanalVta.limitecred,0.00) as limite,SUM(CsrCabefac.total) as saldo
			from Ctacte as CsrCtacte
			left join canalvta as CsrCanalvta on CsrCtacte.idcanalvta = CsrCanalvta.id
			left join cabefac as CsrCabefac on CsrCtacte.id = CsrCabefac.idctacte
			where CsrCtacte.id = <<CsrAuxCabefac.idctacte>> and CsrCabefac.rendida = 0
			and CsrCabefac.idplanpago = <<CsrPlanPago.id>>
			group by CsrCtacte.saldoauto,CsrCanalVta.limitecred
			ENDTEXT 
			IF !CrearCursorAdapter('CsrLimite',lcCmdTope)
				thisform.Release
			ENDIF
			IF RECCOUNT('CsrLimite')#0
				lnSumPendiente = lnSumPendiente + CsrLimite.saldo
				IF lnSumPendiente > CsrLimite.saldoauto AND CsrLimite.saldoauto#0
					oavisar.usuario('El cliente ha superado el limite establecido en la ficha del CLIENTE.'+CHR(13);
									+'Posee MOVIMIENTOS sin RENDIR que superan este limite '+CHR(13);
									+'CONSULTE   ABM CUENTA CORRIENTE')
					llok = .f.
				ELSE
					IF CsrLimite.saldoauto=0 AND CsrLimite.limite#0 AND lnSumPendiente > CsrLimite.limite
						oavisar.usuario('El cliente ha superado el limite establecido para el CANAL de VTA.'+CHR(13);
									+'Posee MOVIMIENTOS sin RENDIR que superan este limite '+CHR(13);
									+'CONSULTE   ABM CANAL DE VTA')
						llok = .f.
					ENDIF 
				ENDIF 
			ENDIF
		ENDIF 
		
		IF USED('CsrLimite')
			USE IN CsrLimite
		ENDIF 
		
		RETURN  llok
	ENDPROC

	PROCEDURE vercomprobante		&& Cicla sobre CsrConsulta
		PARAMETERS lnKeyCode
		
		LOCAL lcIdretorno
		
		IF USED("CsrCurConsulta")
			IF !EOF("CsrCurConsulta") AND lnKeyCode=43
				SKIP 1 IN CsrCurConsulta
			ENDIF 		
			IF !BOF("CsrCurConsulta") AND lnKeyCode#43
				SKIP -1 IN CsrCurConsulta
			ENDIF 		
			IF EOF()
				GO BOTTOM 
			ENDIF 	
			IF BOF()
				GO TOP 
			ENDIF 
			lcidretorno = STRID(CsrCurConsulta.idmaopera)
			thisform.muestracomprobante(lcidretorno)	
		ENDIF 
		
		RETURN .t.
	ENDPROC

	PROCEDURE verestadovalores
		parameters lcidmaopera
		local lcCmd,lccheques,llOK
		store .f. to llOK
		
		IF !thisform.tipoform$"N"
			lccheques  = 'Los siguientes Cheques'
		
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT CsrMovbcocar.* from Movbcocar as CsrMovbcocar where CsrMovbcocar.idmaopera = <<lcidmaopera>>
			ENDTEXT 
		
			=thisform.obtenerdatos("CsrMovbcocar",lcCmd)
		
			Sele CsrMovbcocar
			Scan for !EOF()
			     IF LEFT(switch,1)="1" AND origen="3RO"
			        lccheques = lccheques + chr(13) + 'Nº '+transform(numcomp,'9999999999')
			        llOK = .t.
			     endif
			endscan
			if llok
			   this.CadenaErrores= this.CadenaErrores+CHR(13)+lccheques + chr(13) +  '// FUERON DEPOSITADOS O ENTREGADOS'
			ENDIF 
		
				
			&&Comprobante afectado
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT CsrAfeCtacte.* FROM AfeCtacte as CsrAfeCtacte WHERE CsrAfeCtacte.idmaoperad = <<lcidmaopera>>
			ENDTEXT 
			IF !thisform.obtenerdatos("CsrAfeCtacte",lcCmd)
				thisform.Release
			ENDIF 
			IF RECCOUNT('CsrAfeCtacte')#0
				this.CadenaErrores= this.CadenaErrores+CHR(13)+'EL COMPROBANTE ESTA AFECTADO A OTRO'	
				llOK = .T.
			ENDIF 
		
			IF 'IMPORT'$CsrAuxMaopera.programa
				this.CadenaErrores = this.Cadenaerrores +CHR(13)+'EL COMPROBANTE ES IMPORTADO'
				llok = .t.
			ENDIF 
			
			&&Comprobante licitacionn afectado
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT CsrAfeLicita.* FROM AfeLicita as CsrAfeLicita WHERE CsrAfeLicita.idmaopera = <<lcidmaopera>>
			ENDTEXT 
			IF !thisform.obtenerdatos("CsrAfeLicita",lcCmd)
				thisform.Release
			ENDIF 
			IF RECCOUNT('CsrAfeLicita')#0
				this.CadenaErrores= this.CadenaErrores+CHR(13)+'EL COMPROBANTE TIENE CANTIDADES ENTREGADAS'	
				llOK = .T.
			ENDIF 
		ENDIF 
		
		IF thisform.tipoform$"N"
		
			&&Comprobante afectado nota de pedido
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			select CsrPatron.* from nmaopera as CsrNMaopera
			left join fletecarga as CsrFleteCarga on CsrNMaopera.id = Csrfletecarga.idmaopera
			left join fleteplanilla as CsrPatron on Csrfletecarga.idfleteplan= CsrPatron.id
			where CsrNMaopera.id= <<lcidmaopera>> and isnull(CsrPAtron.id,0)<>0
			ENDTEXT 
			IF !CrearCursorAdapter("CsrPatron",lcCmd)
				thisform.Release
			ENDIF 
			IF RECCOUNT('CsrPatron')#0
				this.CadenaErrores= this.CadenaErrores+CHR(13)+'LA NOTA DE PEDIDO PERTENECE A UN PATRON'	
				llOK = .T.
			ENDIF 
		ENDIF 
		
		
		IF !this.oCONTABILIDAD.Validar()
			this.CadenaErrores= this.CadenaErrores+CHR(13)+this.oCONTABILIDAD.Cadenaerror
			LLOK = .t.
		ENDIF 
		
		return iif(llok,.f.,.t.)
	ENDPROC

	PROCEDURE verificarbloqueo		&& Comprobamos si el codigo ingresado nose encuentra bloqueado
		&& comprobamos el codigo
		
		LOCAL llok, lnidctacte,lnidprod,lcalias,lcCtrlSource,AcolOdataNavega
		thisform.bloqueosubprod = .f.
		llok = .f.
		STORE '' TO lcCtrlSource,AcolOdataNavega
		
		IF CsrProducto.id#0
			lnidprod = CsrProducto.id
			lnidctacte = thisform.containerencabeza.kitbuscaoaltaenCtacte.txtid.Value
			SELECT CsrbloqueoProd
			SET FILTER TO idctacte = lnidctacte
			LOCATE FOR idctacte = lnidctacte AND idarticulo = lnidprod
			IF FOUND()
				thisform.bloqueosubprod = IIF(CsrBloqueoProd.idsubarti#0,.t.,.f.)
				llok = !thisform.bloqueosubprod
			ENDIF 
			SET FILTER TO idctacte > 0
		ENDIF 
		&& recorro el subproducto eliminando los registros bloqueados
		IF thisform.bloqueosubprod
		
			SELECT CsrBloqueoprod
			SET FILTER TO idctacte = lnidctacte AND idarticulo = lnidprod
			GO TOP 
			SCAN
				IF CsrBloqueoProd.idsubarti#0
					lnid = CsrBloqueoProd.idsubarti
					SELECT CsrSubproducto
					LOCATE FOR id = lnid
					IF FOUND()
						DELETE IN  CsrSubproducto
					ENDIF 
				ENDIF 
			ENDSCAN 
			SET FILTER TO idctacte >0
			SELECT CsrSubproducto
			COUNT FOR !DELETED() TO lnCount
			llok = IIF (RECCOUNT('CsrSubproducto')#0 AND lnCount>0, .f.,.t.)
			this.lhayvariedad = IIF (!llok, .t.,.f.)
			this.containervariedad.grid1.Refresh()
		ENDIF 
		
		
		IF llok
			thisform.grid2_ponerlineaencero()
			thisform.bloqueocodigo=.f.
		ENDIF 
		RETURN llok
	ENDPROC

	PROCEDURE verificotipocbte
		LPARAMETERS OscCabefac,lActualizo
		lActualizo = IIF(PCOUNT()<2,.t.,lActualizo)
		
		&&Dependiendo del tipo de comprobante y letra. Devolvemos el codigo de afip para la conbinacion
		IF NOT USED('CsrTipoCbte')
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT CsrTipoCbte.* FROM AfipComproba as CsrTipoCbte
			ENDTEXT 
			=CrearCursorAdapter('CsrTipoCbte',lccmd)
		ENDIF 
		
		cLetra		= ALLTRIM(thisform.lcletra)
		cClaseComp	= CsrComprobante.clase+CsrComprobante.clasetipo
		
		IF cLetra$"ABMC" AND CsrComprobante.clase$"ABC"	
			SELECT CsrTipoCbte
			LOCATE FOR letra=cLetra AND clasecomp=cClaseComp
			IF NOT (letra=cLetra AND clasecomp=cClaseComp)
				cMensaje = "NO ES POSIBLE ESTABLECER EL CODIGO DE AFIP PARA LA LETRA + COMPROBANTE"+CHR(13)+CHR(13)+;
							"LETRA "+cLetra+ "COMPROBANTE "+ALLTRIM(CsrComprobante.cnombre)+" ("+cClaseComp+")"+CHR(13)+;
							"VERIFICAR CON EL PROGRAMADOR"
				oavisar.usuario(cMensaje)
				RETURN .f.
			ELSE
				IF lActualizo
					OscCabefac.idtipocbte = CsrTipoCbte.id
					OscCabefac.tipocbte	  = strzero(CsrTipoCbte.CodAfip,2)
				ENDIF 
			ENDIF 
		ENDIF 
			
		
	ENDPROC

	PROCEDURE verpedido
		PARAMETERS lnKeyCode
		
		LOCAL lcIdretorno
		
		IF USED("CsrOpcion")
			TRY
				**&&''
				IF !EOF("CsrOpcion") AND lnKeyCode=43
					SKIP 1 IN CsrOpcion
				ENDIF 		
				IF !BOF("CsrOpcion") AND lnKeyCode#43
					SKIP -1 IN CsrOpcion
				ENDIF 		
				IF EOF("CsrOpcion")
					 oavisar.usuario('Este es el ULTIMO pedido') 
					GO BOTTOM in CsrOpcion
				ENDIF 	
				IF BOF("CsrOpcion")
					GO TOP in CsrOpcion
				ENDIF 
				this.recorriendopedido = .t.
				lok = this.importarpedidos()
				IF NOT lok 
					oavisar.usuario('NO EXISTEN pedidos')    
				ENDIF 		
			CATCH TO oError
		 	 	oavisar.usuario('Error: '+ALLTRIM(oError.Details)+' Metodo: '+oError.Procedure+CHR(13)+;
					'Mensaje: '+ALLTRIM(oError.Message)+' Nro Error ['+ALLTRIM(STR(oError.ErrorNo))+']'+CHR(13)+;
		 			'Linea: '+ALLTRIM(oError.LineContents))
		
		 	ENDTRY
		ENDIF 
		
		RETURN .t.
	ENDPROC

	PROCEDURE ve_condicion
		parameters vc_condicion,vc_mensaje
		if vc_condicion
		   thisform.cadenaerrores=thisform.cadenaerrores+iif(!empty(thisform.cadenaerrores),chr(13),'')+vc_mensaje
		endif
		return .t. 
	ENDPROC

	PROCEDURE zapfile
		PARAMETERS lcalias,lcOrderActual
		
		LOCAL i
		
		IF 'NATIVE'$LcDataSourceType
			SELECT(lcAlias)
		    FOR i=1 TO 20
			    IF !EMPTY(TAG(i))
		   	       IF UPPER(TAG(i))=UPPER(LcorderActual)
		              SET ORDER TO &LcorderActual
		              GO TOP 
		              EXIT 
		           ENDIF    
		        ENDIF  
		    NEXT
		ENDIF
		
		RETURN .t.
	ENDPROC

