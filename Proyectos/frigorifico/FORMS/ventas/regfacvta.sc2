	PROCEDURE Grid2.AfterRowColChange
		LPARAMETERS nColIndex
		
		DODEFAULT(nColIndex)
		
		* si codigo #0 or (codigo=0 y nombre=0) si paso codigo con 0 cuando digito algo en el nombre es para buscar
		WITH thisform
			.kitbuscarProd.ltextodigitado = .t.
			IF LEN(TRIM(.grid2.column1.text1.Value))#0 OR (LEN(TRIM(.grid2.column1.text1.Value))=0 AND LEN(TRIM(.grid2.column2.text1.Value))=0)
				.kitbuscarProd.ltextodigitado = .f.
			ENDIF 
		ENDWITH 
	ENDPROC

	PROCEDURE Grid2.Column1.Text1.GotFocus
		WITH thisform
			
			
			.lcgotfocus = "thisform.grid2.column1.text1"
			.codigoanterior      = ""	&&---Marcos 23/02
			.idarticuloant = 0
			IF .copiandocomprobante		
				.lnkeyCode = 10			&&--------
			ENDIF 
			IF !.consultandocomprobante
				.ultimocontainer     = "THISFORM.GRID2" 
				.lblayudapie.Caption = "[Esc]Retrocede a Cliente   [ F8 ]Borrar Articulo   [ F10 ]Graba      "+IIF(thisform.tipoform$"N","[ F6 ] Buscar Licitaciones","")
				.lpidocodigo 	 	 = .f.
				.lpidocantidad       = .t.
				.cambioarticulo      = .f.
				.codigoanterior      = this.Value
				.idarticuloant		 = CsrAuxCuerfac.idarticulo
				.cmdSalvar.Visible   = .t.
				.cmdRemito.Visible	= .t.
				*IF thisform.tipoform$"N"
					.CmdLicita.Visible = .t.
				*ENDIF 
				.nCantDigitada		 = 0
				.Temp_save()
				
				ThisForm.Grid2.ReadOnly = .f.
				ThisForm.Containervariedad.Grid1.ReadOnly = .f.
				
				IF CsrAuxCuerfac.escombo=1 AND CsrAuxCuerfac.idprodgenera#0
					ThisForm.Containervariedad.Grid1.ReadOnly = .t.
					ThisForm.Grid2.Column5.ReadOnly = .t.
					ThisForm.Grid2.Column6.ReadOnly = .t.
					ThisForm.Grid2.Column10.ReadOnly = .t.
				ENDIF 
					
				IF CsrAuxCuerfac.idmovlicita <> 0
					ThisForm.Grid2.ReadOnly = .t.
					ThisForm.Containervariedad.Grid1.ReadOnly = .t.
				ENDIF 
				
			ELSE
				.ultimocontainer     = "THISFORM.GRID2" 
				.lblayudapie.Caption = "[Esc]Retrocede a Cliente"   
				.cmdSalvar.Visible   = .f.	
				.cmdRemito.Visible	= .f.
				.cmdLicita.Visible	 = .f.
				.codigoanterior      = "" &&Marcos 23/02
				.idarticuloant		 = 0
			ENDIF 
		ENDWITH
	ENDPROC

	PROCEDURE Grid2.Column1.Text1.InteractiveChange
		thisform.lpidocodigo = .t.
		thisform.cambioarticulo = .t.
		thisform.bloqueocodigo = .f.
	ENDPROC

	PROCEDURE Grid2.Column1.Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		thisform.bloqueocodigo = .f.
	ENDPROC

	PROCEDURE Grid2.Column1.Text1.LostFocus
		
		thisform.ultimocontainer ="THISFORM.GRID2" 
		IF !thisform.consultandocomprobante
			IF  VAL(this.Value)#0  AND strzero(thisform.lnkeycode,3)$"013-009"
			
				*IF thisform.kitbuscarProd.fc_lostfocus(VAL(this.Value))
				
				&&Hay dos invocaciones, otra en el valid
				IF thisform.kitbuscarProd.fccodbarra_lostfocus((this.Value))
					IF thisform.kitbuscarProd.f_lostfocusSay()
						*iF !thisform.verificarbloqueo() &&Falso no blanqueo la linea
				        	IF CsrAuxCuerfac.idarticulo#0 AND CsrAuxCuerfac.preunita # 0
				   	      		*KEYBOARD '{ENTER}'
				        	ENDIF 		
				        *ENDIF 
				    ELSE
				      this.Value=thisform.codigoanterior	     
			        endif
				ELSE
					IF VAL(this.Value)#0
						=Oavisar.usuario("El articulo no existe",0)
						this.SelectOnEntry=.t.
						this.SelStart=0
						this.SelLength=LEN(ALLTRIM(this.Text))
						NODEFAULT 
					ENDIF
					REPLACE idarticulo WITH 0 IN CsrAuxcuerfac		
				ENDIF
			ENDIF
			IF thisform.permiteeditanombre
				thisform.editarproducto()
			ENDIF 
		ELSE
		
			SELECT CsrAuxCuervari
			COUNT ALL FOR idarticulo = CsrAuxCuerfac.idarticulo AND registro=CsrAuxCuerfac.registro TO lnvari
			thisform.lhayvariedad = IIF(lnvari#0,.t.,.f.)
		ENDIF 
	ENDPROC

	PROCEDURE Grid2.Column1.Text1.Valid
		
		*!*	IF ThisForm.hayescape AND NOT thisform.consultandocomprobante
		*!*		ThisForm.hayescape = .f.
		*!*		This.Value = ""
		*!*		replace codigo WITH "" IN CsrAuxCuerfac
		*!*		RETURN .t.
		*!*	ENDIF 
			
		IF THISFORM.BLOQUEOCODIGO AND !thisform.consultandocomprobante
		   RETURN .F.
		ENDIF
		
		IF thisform.consultandocomprobante
		   RETURN .t.
		ENDIF
		
		IF ABS(VAL(This.Value))>0 AND VAL(this.Value) < 0
			thisForm.nCantDigitada = ABS(VAL(this.Value))
			IF LEN(TRIM(thisform.codigoanterior))<>0
				this.Value=thisform.codigoanterior
			ELSE 
				this.Value = ''
				this.Value=thisform.codigoanterior
				this.SelectOnEntry=.t.
				this.SelStart=0
				this.SelLength=LEN(ALLTRIM(this.Text))
				NODEFAULT 
				RETURN .f.
			ENDIF 
		ENDIF 
		
		IF  !strzero(thisform.lnkeycode,3)$"013-009" .and. thisform.cambioarticulo
			this.Value=thisform.codigoanterior
		    RETURN .f.
		ENDIF
		
		thisform.ultimocontainer ="THISFORM.GRID2" 
		IF  LEN(ALLTRIM(this.Value))#0  AND strzero(thisform.lnkeycode,3)$"013-009"
			this.Value = UPPER(this.Value)
			*IF thisform.kitbuscarProd.fc_lostfocus(VAL(this.Value))
			IF thisform.kitbuscarProd.fccodbarra_lostfocus((this.Value))
				IF  !thisform.kitbuscarProd.f_lostfocusSay()
			     		this.Value=thisform.codigoanterior
			     		RETURN .F.
			     ELSE 
					*IF thisform.verificarbloqueo()
			      	*	this.Value=thisform.codigoanterior
			     	*	RETURN .F.
			     	*ENDIF 
			     ENDIF 
		     ELSE
				IF VAL(this.Value)#0
					=Oavisar.usuario("El articulo no existe",0)
					this.SelectOnEntry=.t.
					this.SelStart=0
					this.SelLength=LEN(ALLTRIM(this.Text))
					NODEFAULT 
				ENDIF
		        this.Value=thisform.codigoanterior	
				*REPLACE idarticulo WITH 0 IN CsrAuxcuerfac
				RETURN .F.		
			ENDIF
		ELSE
		
		 IF strzero(thisform.lnkeycode,3)$"013-009" .and. LEN(ALLTRIM(thisform.codigoanterior))<>0
		    this.Value=""
		    thisform.grid2_ponerlineaencero
		 ENDIF
		   	
		ENDIF 	 	
		*Marcos 23/02
		lnPreunita = IIF(thisform.incluyeiva,CsrAuxCuerfac.preunita,CsrAuxCuerfac.preunitasiva)
		lnPreunita = IIF(thisform.copiandocomprobante,0,lnPreunita)
		IF CsrAuxCuerfac.idarticulo#0 AND lnPreunita  # 0 AND strzero(thisform.lnkeycode,3)$"013-009"
			KEYBOARD '{ENTER}'
		ENDIF 		
		RETURN .t.
	ENDPROC

