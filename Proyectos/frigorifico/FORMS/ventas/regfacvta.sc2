	ENDPROC

	PROCEDURE Containerencabeza.KitbuscaoaltaenCtacte.lostfocosay
		LOCAL lok
		
		WITH thisform
			IF !.hayescape and !.leyendopedidos AND !.leyendocuerpedido
				.lnkeycode = 0
				
		*!*			lok = .t.
		*!*			IF this.txtid.Value = 0
		*!*				lok = .f.
		*!*			ENDIF 
				lok = .cargarcabefac()
		      			cleartec()
		      			
				IF !this.lprocesogrillabusqueda AND lok 
					
					
		      			IF lok
						thisform.cmdconsulta.Enabled = .t.
						thisform.containerencabeza.Refresh()
						.containerencabeza._cbocomprobante.SetFocus()
						IF CsrAuxCabefac.idctacte#0 OR CsrAuxCabefac.cnombre=this.lctxtamovernombre
							.containerencabeza._cbocomprobante.click()
							IF .consultandocomprobante
								.containerencabeza._txtparada.SetFocus()
							ENDIF 
						ELSE
							.containerencabeza._txtcdireccion.SetFocus 
							.containerencabeza._txtcdireccion.click() 			
						ENDIF 	
					ENDIF 		
				ENDIF 
				
			    	.containerencabeza.kitbuscaoaltaenCtacte.lrecargatxtnombre = .t.			     
				    
				IF !lok
				 	.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
			 		.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.Click()
				ENDIF 
			ELSE 
				.hayescape = .f.
			ENDIF 		
		ENDWITH
			
	ENDPROC

	PROCEDURE Containerencabeza.KitbuscaoaltaenCtacte.Txtexiste1.GotFocus
		DODEFAULT()
		thisform.cmdconsulta.Enabled = .f.
		
	ENDPROC

	PROCEDURE Containerencabeza.KitbuscaoaltaenCtacte.Txtexiste1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		DODEFAULT( nKeyCode, nShiftAltCtrl)
		
		*!*	 if ISALPHA(chr(nKeyCode))
		*!*	 	DODEFAULT(nKeyCode, nShiftAltCtrl) 
		*!*	 	RETURN 
		*!*	 ENDIF 
		*!*			 		
		*!*	WITH thisform
		*!*		.recorriendopedido = .f.
		*!*		IF .tipoform$'F' AND .tipofactura$'N'
		*!*			DO CASE 
		*!*			CASE CHR(nkeycode)='*' 
		*!*				NODEFAULT
		*!*				.leyendopedidos=.t.
		*!*				loObjeto = CREATEOBJECT("Custom")
		*!*				loObjeto.AddProperty('ok',0)
		*!*				loObjeto.AddProperty('codvendedor',CsrVendedor.numero)
		*!*				DO FORM actualizarpedandroidsql_v2 WITH loObjeto NAME lobjform linked  
		*!*				.leyendopedidos=.f.
		*!*			    
		*!*			    IF VARTYPE(lobjform)='O'
		*!*					IF lobjform.ok=1
		*!*						lobjform.release
		*!*						&&Re definimos el form para mostrar observaciones
		*!*						.armarobserva(1)
		*!*					   	SELECT csropcion
		*!*					   	GO TOP 
		*!*					   	IF !(EOF())
		*!*					  	 	.recorriendopedido = .t.
		*!*					   	 	.importarpedidos()
		*!*					   	ENDIF 
		*!*					ENDIF   
		*!*				ENDIF 
		*!*				loObjeto = null
		*!*				RELEASE lobjform		
		*!*			CASE CHR(nkeycode)$'+'  
		*!*				NODEFAULT
		*!*			      TRY
		*!*			      	IF USED('CsrOpcion')
		*!*			      		lok = .t.
		*!*					  	select csropcion
		*!*					  	SKIP
		*!*					  	IF !EOF()
		*!*					  		.recorriendopedido = .t.
		*!*					 	    lok = .importarpedidos()
		*!*					 	ELSE
		*!*					 	 	 oavisar.usuario('Este es el ULTIMO pedido')    
		*!*					 	endif  
		*!*					 	IF NOT lok 
		*!*					 		oavisar.usuario('NO EXISTEN pedidos')    
		*!*					 	ENDIF 
		*!*					 ENDIF 
		*!*			 	CATCH TO oError
		*!*			 	 	oavisar.usuario('Error: '+ALLTRIM(oError.Details)+' Metodo: '+oError.Procedure+CHR(13)+;
		*!*										'Mensaje: '+ALLTRIM(oError.Message)+' Nro Error ['+ALLTRIM(STR(oError.ErrorNo))+']'+CHR(13)+;
		*!*				 						'Linea: '+ALLTRIM(oError.LineContents))
		
		*!*			 	ENDTRY
		*!*			CASE CHR(nkeycode)$'-' 
		*!*				NODEFAULT
		*!*			     TRY 
		*!*			     	IF USED('CsrOpcion')
		*!*			     		LOK = .T.
		*!*					  	select csropcion
		*!*					  	SKIP -1
		*!*					  	IF !BOF()
		*!*					  		.recorriendopedido = .t.
		*!*				 	    	LOK = .importarpedidos()
		*!*					 	else    
		*!*					 	 	 oavisar.usuario('Este es el PRIMER pedido')
		*!*					 	endif 
		*!*					 	IF NOT lok 
		*!*					 		oavisar.usuario('NO EXISTEN pedidos')    
		*!*					 	ENDIF   
		*!*				 	ENDIF 
		*!*			 	CATCH
		*!*			 		oavisar.usuario('No hay pedidos para visualizar')
		*!*			 	ENDTRY
		*!*			CASE strzero(nkeycode,3)$'013-009'
		*!*			 	*DODEFAULT(nKeyCode, nShiftAltCtrl) 
		*!*			 	*stop()
		*!*			 	this.LostFocus()
		*!*			OTHERWISE
		*!*			 	IF .importandopedidos
		*!*			 		oavisar.usuario("Se cambio la modalidad de pedidos a facturación normal."+CHR(13)+"NO SE ASOCIARA EL PEDIDO",0)
		*!*			 		.armarobserva(0)
		*!*			 	ELSE
		*!*			 		
		*!*			 	ENDIF 
		*!*			 	
		*!*			 	.importandopedidos=.f.
		*!*			ENDCASE
		*!*		ENDIF 
		*!*		.recorriendopedido = .f.
		*!*	ENDWITH 
		
	ENDPROC

	PROCEDURE Containerencabeza.KitbuscaoaltaenCtacte.Txtexiste1.LostFocus
		DODEFAULT()
	ENDPROC

	PROCEDURE Containerencabeza.KitbuscaoaltaenLocalidad.lostfocosay
		LOCAL lcalias
		
		lccpostal = This.parent._txtcpostal.Value
		
		lcalias = ALIAS()
		SELECT Csrprovincia
		LOCATE FOR id = Csrlocalidad.idprovincia
		SELECT(lcalias)
		This.parent._cboprovincia.Refresh()
		This.parent._txtcpostal.Value = IIF(LEN(LTRIM(lccpostal))=0,CsrProvincia.letracpostal+Csrlocalidad.cpostal,lccpostal)
	ENDPROC

	PROCEDURE Containerencabeza._cbocomprobante.GotFocus
		IF thisform.lnidctacteant = CsrAuxCabefac.idctacte AND thisform.lnidcompant#0 AND NOT thisform.consultandocomprobante
			*stop()
			SELECT CsrComprobante
			LOCATE FOR id = thisform.lnidcompant
			this.Value = CsrComprobante.id
		ENDIF 
	ENDPROC

	PROCEDURE Containerencabeza._cbocomprobante.lostfocosay
		
		WITH thisform
			&&Marcos 2015/07/21
			&&En el caso de consultar. Cargamos el talonario del comprobante
			&&Porque si leemos los de la terminal puede no existir.
			IF thisform.consultandocomprobante
				.containerencabeza._cboptovta.Clear
				.containerencabeza._cboptovta.Additem(SUBSTR(.proximonro,2,4),1)
			ELSE	
				.containerencabeza._txtnumcomp.Enabled = .f.
				IF .oFACCAE.es_cae OR .oFACCAE.es_caea
					&&Para determinar el talonario automatico
					&&Debemos saber la LETRA
		*!*				IF thisform.lnidctacteant = CsrAuxCabefac.idctacte AND thisform.lnidcompant#0
		*!*					*stop()
		*!*					SELECT CsrComprobante
		*!*					LOCATE FOR id = thisform.lnidcompant
		*!*					this.Value = CsrComprobante.id
		*!*				ENDIF 
					*stop()
					.oreGFACVTA.letraiva(CsrAuxcabefac.idtipoiva)			
					*agregaobjeto.letractacte(CsrAuxcabefac.idtipoiva)
					replace idcomproba WITH CsrComprobante.id IN CsrAuxMaopera
				
				ENDIF
				**stop() 
				IF NOT thisform.oFACCAE.es_cae
					IF .lnnroautomatico <> 1
						.containerencabeza._txtnumcomp.Enabled = .t.	
						.talonario = Csrparaconfig.talonma2
					ENDIF 
					
					.cargarcomboptovta()
					
					.leerproximonro(CsrComprobante.id,.f.)
				ELSE 
					&&stop()
					.cargarcomboptovta()
					.leerproximonro(CsrComprobante.id,.f.)
				ENDIF
			ENDIF 
		
			.containerencabeza._txtletra.Value = LEFT(.proximonro,1)
			.containerencabeza._txtnumcomp.Value = VAL(RIGHT(.proximonro,8))
			.containerencabeza._txtnumcomp.refresh()	
			
			
			
			&&Si es una facturacion (no es nota de pedido) y no es diferida,ni manual
			IF .tipoform$"F" AND !.tipofactura$"DEM" 
		*!*			IF VARTYPE(.objseteoparam.def_CTRLEXISTENC_FAC)='L'
		*!*				.lpidoexistenc = .objseteoparam.def_ctrlexistenc_fac
		*!*			ENDIF 
				&&Solo sino es nota de credito
				IF CsrComprobante.clase$"C"
					.lpidoexistenc = .f.
				ENDIF 
			ENDIF 
			
		*!*		*Si el comprobante es presupuesto. Solo para facturacion diferida
		*!*		IF .tipoform$"F" AND !.tipofactura$"DE" AND CsrComprobante.clase$'0'
		*!*			oavisar.usuario('Solo se puede hacer PRESUPUESTOS por FACTURACIÓN DIFERIDA')
		*!*		ENDIF 
			&&Marcos 19/03/2015
			&&Si la categoria del cliente es sin remito
			*stop()
			
			
			&&MArcos 02/03/2015
			&&Si el comprobante es un remito, siempre debemos mandarlo a contado pendiente.
			&&Jamas a recibo de cbro, ya que esto toca contabilidad.
			IF CsrComprobante.clase$"HILMNX018" AND ThisForm.RemiCdoPde
				SELECT CsrPlanPago
				LOCATE FOR RTRIM(numero) = 'CP' &&No usamos OscCabefac.idplanpago, pq tiene el de la abmctacte
				replace idplanpago WITH CsrPlanPago.id IN CsrAuxCabefac
				
				thisform.containerencabeza._cboplanpago.Refresh()
			ENDIF 
			
			&&Marcos 05/01/2018
			&&Si el comprobante no admite cuenta corriente no permitimos grabar con el plan de pago
			IF STR(CsrComprobante.id,10)$thisform.idctanada AND RTRIM(CsrPlanPago.numero)='CCT'
				oavisar.usuario('COMPROBANTE NO AUTORIZADO PARA MOVIMIENTOS DE CUENTA CORRIENTE')
				SELECT CsrPlanPago
				LOCATE FOR RTRIM(numero) = 'CP' &&No usamos OscCabefac.idplanpago, pq tiene el de la abmctacte
				replace idplanpago WITH CsrPlanPago.id IN CsrAuxCabefac
				
				thisform.containerencabeza._cboplanpago.Refresh()
			ENDIF 
				
			IF !(.tipofactura $ "EM" OR (.tipofactura$"ED" AND CsrComprobante.clase$'0'))
				IF !thisform.consultandocomprobante
					IF .tipoform='N'
						This.parent.chkesremito.SetFocus()
					ELSE
						IF goapp.codempresa = 13
							this.Parent._txtbonif1.SetFocus()
						ELSE 
							this.Parent._txtreferencia.SetFocus()
						ENDIF 
					ENDIF 
				ELSE
					this.Parent._txtparada.SetFocus()
				ENDIF 
			ENDIF
		ENDWITH
		
		
	ENDPROC

	PROCEDURE Containerencabeza._cbolistapre.lostfocosay
		LOCAL lclista
		nLista = this.Value
		IF nLista > 4
			nLista = 1
		ENDIF 
		lclista = "prevtaf"+LTRIM(STR(nLista))
		thisform.kitbuscarProd.controlsource01 = lclista
		
	ENDPROC

	PROCEDURE Containerencabeza._cboplanpago.lostfocosay
		IF !ThisForm.ValidarPlan()
			RETURN .f.
		ENDIF 
		
		SELECT CsrValor
		LOCATE FOR id = CsrPlanPago.idvalor
		*this.Parent._chkpidovalor.Value = IIF(CsrValor.clasevalor$'C-F',0,1) &&No existe
	ENDPROC

	PROCEDURE Containerencabeza._cboprovincia.LostFocus
		LOCAL lccuit,lnporperce,lnporrete,lcaliascateibto,lnidprovincia
		
		lnidprovincia = CsrAuxCabefac.idprovincia
		lccuit = STRTRAN(CsrAuxCabefac.cuit,"-","")
		lcaliascateibto = ""
		
		STORE 0 TO lnporperce,lnporrete
		
		thisform.agregaobjeto.objobteneribto(lccuit,lnidprovincia,@lcaliascateibto,@lnporperce,@lnporrete)
		
		IF RECCOUNT("CsrCateCtaCte")#0
			REPLACE porperce WITH lnporperce,porrete WITH lnporrete IN CsrCateCtacte
		ENDIF 
	ENDPROC

	PROCEDURE Containerencabeza._cboptovta.lostfocosay
		WITH thisform
			
			.talonario = VAL(this.List(this.Value))
			.containerencabeza._txtptovta.Value = VAL(this.List(this.Value))
		
			.leerproximonro(Csrcomprobante.id,.f.)       
			.containerencabeza._txtletra.Value = LEFT(.proximonro,1)
			.containerencabeza._txtnumcomp.Value = VAL(RIGHT(.proximonro,8))
			.containerencabeza._txtnumcomp.refresh()
			
			SELECT CsrAuxCabefac
			SCATTER NAME OscCabefac
			.verificoTipoCbte(OscCabefac)
			SELECT CsrAuxCabefac
			GATHER NAME OscCabefac
		ENDWITH 	
	ENDPROC

	PROCEDURE Containerencabeza._cbotipoiva.lostfocosay
		WITH thisform
			.cambiocomproba(this.Value)
			.containerencabeza._cbocomprobante.refresh()	
		ENDWITH 
	ENDPROC

	PROCEDURE Containerencabeza._txtcuit.Valid
		LOCAL lok,lccuit
		IF thisform.Hayescape
		   thisform.Hayescape = .f.
		   RETURN .t.
		ENDIF 
		lccuit = cuit(LEFT(pelocuit(this.Value)+strzero(0,11),11))
		lok = .t.
		DO case
			CASE Csrcategoiva.fiscal='I'		&& RI
				lok = vericuit(lccuit)
			CASE Csrcategoiva.fiscal='N'		&& RNI
				lok = vericuit(lccuit)
			CASE Csrcategoiva.fiscal='E'		&& exento
				lok = vericuit(lccuit)
			CASE Csrcategoiva.fiscal='M'		&& monotributo
				lok = vericuit(lccuit)		
		ENDCASE
		
		RETURN lok
	ENDPROC

	PROCEDURE Containerencabeza._txtnumcomp.LostFocus
		WITH thisform
			.proximonro  = .containerencabeza._txtletra.value + strzero(.talonario,4) + strzero(this.Value,8)
		ENDWITH
		DODEFAULT()
		
	ENDPROC

	PROCEDURE Containerencabeza._txtnumcomp.Valid
		WITH thisform	
			IF .tipofactura = "M"
				cNumComp = 	.containerencabeza._txtletra.value + strzero(.talonario,4) + strzero(this.Value,8)
				
				LOCAL lccmd
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT Csrmaopera.id FROM maopera as Csrmaopera
				where Csrmaopera.origen='FAC' and Csrmaopera.numcomp='<<cNumComp>>' 
				and Csrmaopera.estado<>'1' and CsrMaopera.clasecomp<>'K'
				and CsrMaopera.idcomproba = <<CsrComprobante.id>>
				ENDTEXT 
				
				=SaveSQL(lcCmd,this.Name+"_validanum")
				=CrearCursorAdapter("CsrCursor",lcCmd) 
		
				IF USED("Csrcursor")
					IF RECCOUNT("CsrCursor")>0
						NODEFAULT 
						=Oavisar.usuario("Ya existe ese número de comprobante",0)
						RETURN .f.
					ENDIF 
				ENDIF
				IF  VAL(RIGHT(cNumComp,8)) = 0
					oavisar.usuario("El número de comprobante no puede ser cero")
					RETURN .f.
				ENDIF 
			ENDIF 
		ENDWITH 
	ENDPROC

	PROCEDURE Containerencabeza._txtparada.GotFocus
		thisform.lnidctacteant = CsrAuxCabefac.idctacte
		thisform.lnidcompant = CsrAuxMaopera.idcomproba
		thisform.ultimofocoen = UPPER(this.Name)
		DODEFAULT()
	ENDPROC

	PROCEDURE Containerencabeza._txtparada.LostFocus
		thisform.pedirdetacobranza = .f.
		thisform.lpidoimporte = .f.
		thisform.lpidodescuento = .f.
		
		&&El valor por defecto se determina en controlctacte, ya que se lee si esta activo el padron o no.
		
		*thisform.noCalculoIBTO = IIF(goapp.empresarete=1,.f.,.t.) &&Siempre se calcula percepciones
		
		&&Omitimos esto, pq no es vacio, entonces por lo menos muestra 0.
		
		*!*	IF '0'$STR(this.Value) AND CsrComprobante.clase$'C' &&Si es nota credito noCalcula percepciones BsAs
		*!*		*oavisar.usuario(STR(CsrAuxCabefac.idprovincia)+' '+STR(CsrProvincia.id))
		*!*		SELECT CsrParaVario
		*!*		LOCATE FOR idorigen=CsrAuxCabefac.idprovincia AND ALLTRIM(nombre)$'CATEIBBA'
		*!*		IF idorigen=CsrAuxCabefac.idprovincia AND ALLTRIM(nombre)$'CATEIBBA'
		*!*			*oavisar.usuario('No calcula IBTO')
		*!*			thisform.nocalculoibto = .t.
		*!*		ENDIF 
		*!*	ENDIF
		 
		* stop()
		&&Si Nota Credito por el total y La empresa retiene, NO retenemos
		IF '1'$STR(this.Value) AND CsrComprobante.clase$'CB' AND NOT thisform.noCalculoIBTO
			thisform.noCalculoIBTO = .t.
		ENDIF 	
		
		IF '1'$STR(this.Value) AND CsrComprobante.clase$'AI'
			thisform.pedirdetacobranza = .t.
		ENDIF 
		**stop()
		IF '2'$STR(this.Value)
			SELECT CsrComprobante
			LOCATE FOR clase = '0'
			IF FOUND() AND clase$'0'
				replace idcomproba WITH  CsrComprobante.id IN CsrAuxMaopera
			ENDIF 
			this.Parent._cbocomprobante.SetFocus
			this.Parent._cbocomprobante.Click
			this.Parent._cbocomprobante.Refresh()
			
			SELECT CsrPlanPago
			LOCATE FOR numero = 'CDP'
			this.Parent._cboplanpago.SetFocus
			this.Parent._cboplanpago.Click
			this.Parent._cboplanpago.Refresh
		ENDIF 
		
		IF '3'$STR(this.Value)
			thisform.permitemultilineas = .t.
		ENDIF 
		
		IF '4'$STR(this.Value) AND CsrComprobante.clase$'A-X'
			thisform.permitemultilineas = .t.
			lok = thisform.buscarorigen()
			this.value = IIF(!lok,0,this.Value)
		ENDIF 
		
		IF '5'$STR(this.Value)
			SELECT CsrComprobante
			LOCATE FOR clase = 'X'
			IF FOUND() AND clase$'X'
				replace idcomproba WITH  CsrComprobante.id IN CsrAuxMaopera
			ENDIF 
			this.Parent._cbocomprobante.SetFocus
			this.Parent._cbocomprobante.Click
			this.Parent._cbocomprobante.Refresh()
			
			SELECT CsrCategoiva
			LOCATE FOR CsrCategoiva.fiscal$'C'
			IF CsrCategoiva.fiscal$'C'
				replace idtipoiva WITH CsrCategoiva.id IN CsrAuxCabefac
			ENDIF 
			this.Parent._cbotipoiva.SetFocus
			this.Parent._cbotipoiva.Click
			this.Parent._cbotipoiva.Refresh
			thisform.leerproximonro(CsrComprobante.id,.f.)
			
			SELECT CsrPlanPago
			LOCATE FOR numero = 'CDP'
			this.Parent._cboplanpago.SetFocus
			this.Parent._cboplanpago.Click
			this.Parent._cboplanpago.Refresh
		ENDIF
		
		IF '6'$STR(this.Value) OR thisform.regvta_soliimporte OR CsrComprobante.clase='V' &&Licitacion
			thisform.lpidoimporte = .t.
		ENDIF
		
		IF '8'$STR(this.Value)
			thisform.lpidodescuento = .t.
		ENDIF
		
		IF '9'$STR(this.Value)
			*stop()
		    SELECT CsrComprobante
			LOCATE FOR clase = 'C'
			IF FOUND() AND clase$'C'
				replace idcomproba WITH  CsrComprobante.id IN CsrAuxMaopera
			ENDIF 
			*this.Parent._cbocomprobante.SetFocus
			this.Parent._cbocomprobante.Click
			this.Parent._cbocomprobante.Refresh()
		ENDIF
		
		IF thisform.lnkeycode= 13 OR thisform.lnkeycode=9
			SELECT CsrAuxCuerfac
			GO BOTTOM 	
			IF !thisform.leyendocuerpedido
				thisform.totalcomprobante()
				thisform.generarlinea()   && 22=insert
				SELECT CsrAuxCuerfac
				thisform.grid2.Refresh
				thisform.grid2.SetFocus()
			ENDIF 	
		ELSE
			DODEFAULT()
		ENDIF 	
		
	ENDPROC

	PROCEDURE Containerencabeza._txtvence.Valid
		IF thisform.hayescape
			thisform.hayescape = .f.
			RETURN .t.
		ELSE 
			IF this.Value < thisform.containerencabeza._txtfecha.Value
				=Oavisar.usuario("El vencimiento debe se mayor o igual a "+DTOC(thisform.containerencabeza._txtfecha.Value),0)
				RETURN .f.
			ENDIF 		
		ENDIF 
	ENDPROC

	PROCEDURE Containeringreso.Kitbuscaoaltaenarea.lostfocosay
		LOCAL lnidfuerzavta
		
		lnidfuerzavta = this.txtid.Value
		
		IF NOT this.lprocesogrillabusqueda
			WITH thisform
				
				IF VARTYPE(.objseteoparam.SoloContadoPde_Fac)='L'
					.SoloContadoPde = .objseteoparam.SoloContadoPde_Fac
				ENDIF 
				IF LEFT(NVL(CsrFletero.switch,'00000'),1)='1'
					.SoloContadoPde = .f.
				ENDIF 
				IF .tipoform = "N"
					.SoloContadoPde = .t.
				ENDIF 
				
			ENDWITH 
		ENDIF 
		
		IF lnidfuerzavta#0
			WITH thisform
		
				.traerproductofuerzavta(lnidfuerzavta) 
				.traerproductosbloqueados()
				.containerencabeza.Enabled = .t.
				IF .tipofactura$'EM'
					.containerencabeza._txtFecha.SetFocus()	   	
				ELSE 	
					SELECT csrAuxMaopera
					GO TOP 
					.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
				   	.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.Click()
			   ENDIF 
			ENDWITH   
		ENDIF
		
	ENDPROC

	PROCEDURE Containeringreso._txtlostfocus.GotFocus
		thisform.ultimocontainer = UPPER(this.Parent.name)
		thisform.lblayudapie.Caption = "[Esc]Abandona formulario"
		
		thisform.controlinicial()
		IF !thisform.hayescape
			thisform.leerentorno()
		ENDIF 
			
		thisform.cmdconsulta.Enabled = .T.
		
		IF !thisform.tipoform$"N"
			IF thisform.hayescape
				thisform.limpiarcursor(.f.)
				thisform.hayescape = .f.
				thisform.Tomardatosfac = .t.
			ENDIF 		
			this.Parent.kitbuscaoaltaenfletero.txtexiste1.SetFocus()
			this.Parent.kitbuscaoaltaenfletero.txtexiste1.Click()
		ELSE
			IF thisform.hayescape
				thisform.limpiarcursor(.f.)
				SELECT CsrVendedor
				LOCATE FOR id = thisform.lnidvendedor
				
				this.Parent.kitbuscaoaltaenvendedor.txtid.Value = CsrVendedor.id
				this.Parent.kitbuscaoaltaenvendedor.txtexiste1.Value = CsrVendedor.numero
				this.Parent.kitbuscaoaltaenvendedor.txtexiste1.LostFocus()
				thisform.hayEscape = .f.
			ENDIF 
				
			this.Parent.kitbuscaoaltaenvendedor.txtexiste1.SetFocus()
			this.Parent.kitbuscaoaltaenvendedor.txtexiste1.Click()
		ENDIF 
		
	ENDPROC

	PROCEDURE Containerpromoboni.GotFocus
		this.chkbonifica.Value = 0
		this.Chkpromocion.Value = 0
		DODEFAULT()
		
	ENDPROC

	PROCEDURE Containerpromoboni.LostFocus
		LOCAL lnbonifica,lnregistro,lnidcabeunifica,lndecimaluni,lndecimaltot,lok,OscatterCab
		
		lok = .t.
		IF this.Chkbonifica.Value=0 AND this.chkpromocion.Value=0
		   =Oavisar.usuario("Debe aplicar bonificación o promoción o ambas",0)
		   lok = .f.
		ENDIF 
		
		SELECT CsrAuxCabefac
		SCATTER NAME OscatterCab
		
		*!*	* si hay bonificacion por cantidad y unifica codigo busco los unificados iguales y recalculo descuentos	
		IF lok
			WITH thisform
				lndecimaluni    = .ndecimaluni
				lndecimaltot    = .ndecimaltot
				
				SELECT CsrAuxCuerFac
			    SCATTER NAME Oscatter
				
			    lnregistro      = Oscatter.registro	   
			    lnbonifica      = Oscatter.despor
			    lnidcabeunifica = Oscatter.idcabeunifica
			    
			    &&Se suma en la linea del producto la bonifcacion del clienta. Y se guarda como una sola bonif
			      IF (OscatterCab.bonif1#0 OR OscatterCab.bonif2#0)
			       	lnbonifica = lnbonifica + .CalculoBoniCtacte(OscatterCab.bonif1 , OscatterCab.bonif2) 
				ENDIF 
				
			    Oscatter.idprodpromo  = Oscatter.idprodpromo  * this.Chkpromocion.Value     && 1 / 0
			    Oscatter.idprodregalo = Oscatter.idprodregalo * this.Chkpromocion.Value    
			    Oscatter.cada         = Oscatter.cada	   	  * this.Chkpromocion.Value
			    Oscatter.entrega      = Oscatter.entrega      * this.Chkpromocion.Value		  
			    Oscatter.despor   	  = lnbonifica 			  * this.chkbonifica.Value      && 1 / 0
			    
			  	lncantidad = Oscatter.cantidad
			  	lnunibulto = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
			 	lnuniventa = Oscatter.univenta
			   	lnunibulto = IIF(lnuniventa=1,1,lnunibulto)
				lnCantFinal = IIF(lnCantidad=0,1,lnCantidad)
							  
				thisform.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto)
			    	   	      
				Oscatter.total = Red((Oscatter.UniSiva + Oscatter.internofin + Oscatter.ivauni),lndecimaltot)		
					      
			   	GATHER NAME Oscatter 	      
			   	
			    IF Oscatter.idprodpromo#0 AND Oscatter.entrega#0 AND this.chkpromocion.Value=1
			       * agregar registro promocion
			       .cargarpromocion(Oscatter)
			    ENDIF
			    
			    SELECT CsrAuxCuerfac
			    GO top
			    SCAN FOR !EOF()
			      IF registro#lnregistro AND espromocion=0 AND idcabeunifica=lnidcabeunifica AND idcabeunifica#0
					  SCATTER NAME Oscatter
					  
			   	      Oscatter.idprodpromo  = 0 &&Oscatter.idprodpromo  * this.Chkpromocion.Value     && 1 / 0
			  	      Oscatter.idprodregalo = 0 &&Oscatter.idprodregalo * this.Chkpromocion.Value    
			   		  Oscatter.cada         = 0 &&Oscatter.cada	   	    * this.Chkpromocion.Value
			   		  Oscatter.entrega      = 0 &&Oscatter.entrega      * this.Chkpromocion.Value		  
			       	  Oscatter.despor 		= lnbonifica 			* this.chkbonifica.Value      && 1 / 0
				  	  lncantidad = Oscatter.cantidad
				  	  lnunibulto = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
				 	  lnuniventa = Oscatter.univenta
			   	      lnunibulto = IIF(lnuniventa=1,1,lnunibulto)
				 	  lnCantFinal    = lncantidad * lnunibulto
				 	  
					  .unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto)
			          	   	      
					  Oscatter.total = Red((Oscatter.UniSiva + Oscatter.internofin + Oscatter.ivauni),lndecimaltot)
				
			   	      GATHER NAME Oscatter 	      
				   ENDIF
			   	ENDSCAN 
			   	
				SELECT CsrAuxCuerfac
			   	GO BOTTOM 
				this.Visible = .f.
				IF !thisform.leyendocuerpedido
			   		thisform.grid2_procesolinea(13)
			   	ELSE
			   		GO nrecno
			   	ENDIF 
			ENDWITH
		ELSE 
			this.chkpromocion.SetFocus	
		ENDIF 
		
	ENDPROC

