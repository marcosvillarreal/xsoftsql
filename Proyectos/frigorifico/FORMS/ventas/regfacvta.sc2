	PROCEDURE cmdimprimir.Click
		LOCAL limpresora,loimpresoraelegida
		
		*stop()
		IF lentrim(CsrAuxMaopera.numcomp)=0
			oavisar.usuario('El Comprobante no tiene numero. No se puede definir el punto de venta para imprimir')
			RETURN .f.
		ENDIF 
		
		thisform.leerproximonro(Csrcomprobante.id,.f.)  
		
		DO FORM frmelijosalida NAME oFormSalida LINKED TO lotiposalida
		
		IF loTipoSalida>0
			limpresora	= thisform.idimpresora
			cFileName	= RTRIM(CsrComprobante.cabrevia) + ' '+ALLTRIM(CsrAuxMaopera.numcomp)
			IF loTipoSalida = 1
				
				nopc = oavisar.usuario('Desea imprimir un original?',36)
				thisform.Objimpresor.leyendaduplicado = .f.
				IF nopc<>6
					thisform.Objimpresor.leyendaduplicado = .t.
				ENDIF 
					
				DO FORM frmelijoimpresora NAME ofrminicimpre LINKED WITH limpresora TO loimpresoraelegida
		
				IF TYPE('loimpresoraelegida')='O'
					
				
					WITH thisform
						IF loimpresoraelegida.id=0
							RETURN .f.
						ENDIF 
						
						.idimpresora = loimpresoraelegida.id
						.lcimpresora = IIF(LEN(TRIM(loimpresoraelegida.portname))#0,loimpresoraelegida.portname,loimpresoraelegida.puerto)
						.copiastkt   = 1
						**stop()
						IF CsrComprobante.clase='8' AND goapp.codempresa = 10 &&Remito de Entrega
							.generarentrega = .t.
						ENDIF 
						.imprimir(thisform.lcimpresora,loimpresoraelegida.tipo,2)
					ENDWITH	    
				ENDIF
			ENDIF 
			IF loTipoSalida = 2
				thisform.objimpresor.salidaporpdf = .t.
				*thisform.SendEmail1.UpdownFiles(SYS(5)+CURDIR()+IIF(.tipoform='P','PAGOS\','COBROS\')+ALLTRIM(CsrCtacte.cnumero)+"_"+DTOS(CsrAuxMovCtacte.fecha))
				thisform.imprimir(thisform.lcimpresora,thisform.formulario,2)	
				thisform.sendemail1.Send()
				thisform.objimpresor.salidaporpdf = .f.
			ENDIF 
		
		ENDIF 
		SELECT csrauxcabefac
		GO top
		
		
		
	ENDPROC

