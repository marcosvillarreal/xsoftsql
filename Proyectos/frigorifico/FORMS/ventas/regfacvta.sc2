	PROCEDURE Activate
		DODEFAULT()
		IF !thisform.patronseleccionado
			IF thisform.tipoform='D' && descargas
				    thisform.elijopatron()
			ENDIF
			thisform.patronseleccionado=.t.
		endif
	ENDPROC

	PROCEDURE actualizar		&& llama al procedimiento de grabacion
		LOCAL llok
		 
		WITH thisform      
			DO CASE 
			CASE .accion$"A"
				.quetecla = 0
				.lokgrabar = .f.
				*IF .pidofinanciacion('A')		
				IF .pidovalores('A') 
					
					IF .quetecla=27
						RETURN .t.
					ENDIF 
					IF !.validartopecredito()
						RETURN .f.
					ENDIF 
					
					lok = Oavisar.usuario('Confirma el comprobante '+Csrcomprobante.cnombre,36)	
					IF lok#6
						RETURN .f.
					ENDIF    
					 	
				        oCadapter = .obtenercursor('CsrMaopera')
						
							
					IF !.tipoform$"N" AND !.actualizafac.validarasto(.f.,goapp.idejerciciofac,LEFT(DTOS(CsrAuxCabefac.fecha),6))
						RETURN .f.
					ENDIF 
																			
					BEGIN TRANSACTION 
					IF !'NATIVE'$LcDataSourceType
						oCadapter.Datasource.ActiveConnection.Begintrans()
					ENDIF
					lbupdate = IIF(CsrAuxCabefac.solograbar=0,.f.,.t.)
					&&Por defecto, soloimprimir es .f.
					lbupdate = IIF(!thisform.tipoform$"N",lbupdate,.t.)
									
					.leerproximonro(Csrcomprobante.id,lbupdate) 
				 	
					SELECT CsrauxCabefac
					GO TOP 
					lccompromemerc = STR(CsrAuxCabefac.ComprometeMerc,1)
					lcswitchcabefac=LEFT(switch,3)+lccompromemerc +RIGHT(switch,1)
					REPLACE switch WITH lcswitchcabefac IN CsrauxCabefac
					llok = .t.
						
					.lbGeneroHojaConTotal = .T.
					IF CsrComprobante.clase$"ABC"
						IF .oFacCAE.es_caea OR .oFacCAE.es_cae 
							.lbGeneroHojaConTotal = .f.
						ENDIF 
					ENDIF 
					IF this.facturacf 
						.lbGeneroHojaConTotal = .t.
					ENDIF 
			
						
					lnDondeGrabo = 0
			        		DO case			          
					CASE .tipoform$"F" AND .tipofactura$"OP" && presupuesto y orden de venta
						lnDondeGrabo = 1	
					CASE .tipoform$"F" AND CsrComprobante.clase$"0" AND this.tipopresupuesto=1 && presupuesto vta solo imprime
						lnDondeGrabo = 5		
					CASE .tipoform$"F" AND CsrComprobante.clase$"V" && licitacion
						lnDondeGrabo = 6				   	 	   	    		        	
					CASE .tipoform$"FPOD" AND Csrprefitermi.tipoimpresora#3 AND .idimpresora#0  && facturacion, premios
						lnDondeGrabo = 1				   	 	   	    		        	
					CASE .tipoform$"F" AND .tipofactura$"ME" &&facturacion manual
						lnDondeGrabo = 1
					CASE .tipoform$"FPO" AND Csrprefitermi.tipoimpresora=3 AND .puestocaja=0  && fiscal y spooler impresion
						*lnDondeGrabo = 3
						lnDondeGrabo=IIF(.leerproximonro(Csrcomprobante.id,.t.),3,0)   	&&Solo incrementa la numeracion, para mantener corralitividad con fiscal	 			
					CASE .tipoform$"N"      				&& nota pedido
						lnDondeGrabo = 4
						llok = .defragmentarpedido()
					ENDCASE  
						
					IF lnDondeGrabo = 1 OR lnDondeGrabo = 5
						IF .oFacCAE.es_cae AND .tipofactura$"ND" AND lnDondeGrabo = 1&&Normal y Diferido
							SELECT CsrAuxCabefac
							SCATTER NAME OscCabefac
							.VerificoTipoCbte(OscCabefac)
							SELECT CsrAuxCabefac
							OscCabefac.caetipo = IIF(.oFacCAE.es_caea,"CAEA","")
							OscCabefac.cae		= IIF(.oFacCAE.es_caea,OscCabefac.cae,"") &&Marcos. Si no es caea, debo recuperar el cae
							GATHER NAME OscCabefac
						ENDIF 	
						
							*stop()	
				    		DO CASE
				    		CASE .tipofactura$"NDP" AND lnDondeGrabo = 1
			    				&&Si No esta activo el CAE (Entonces Normal o CAEA)
			    				IF NOT .oFacCAE.es_Cae OR NOT CsrComprobante.clase$'ABC'
			    					*stop()
			    					IF CsrAuxCabefac.solograbar=0
			    						replace fechaserver WITH DATETIME() IN CsrAuxMaopera
										llok = .imprimir(thisform.lcimpresora,Csrprefitermi.tipoimpresora,1)
									ENDIF 
								ELSE
									replace proximonro WITH "",talonario WITH thisform.talonario IN CsrAuxCabefac
								
									IF this.facturacf
										thisform.generarhojascf()
									ELSE
										&&Si hay PI,  generamos facturas de 100.000,00
											*stop()
										IF CsrAuxCabefac.PerceIVA5329 #0 AND NVL(CsrCtacte.exentoPI,0) = 1
											.generarhojascf(100000)
											.facturaPiva = .t.
											.lbGeneroHojaConTotal = .t.
										ENDIF 
									ENDIF 
								ENDIF 
							CASE (.tipofactura$"PO" OR lnDondeGrabo = 5) AND .tipoform$"F" 
								llok = .imprimir(thisform.lcimpresora,Csrprefitermi.tipoimpresora,1)
							CASE .tipofactura$"ME" &&Manual
								llok = .t.	
				    		OTHERWISE
								llok = .f.
				    		ENDCASE   	
							IF !llok
								= Oavisar.usuario('El comprobante '+TRIM(Csrcomprobante.cnombre)+' no ha sido impreso'+CHR(13)+'SE CANCELA',0)
								thisform.cadenaerrores = "GRABACIÓN CANCELADA"
							ENDIF 
						ENDIF 
					  			  	  
						IF lnDondeGrabo = 0
							oavisar.programador("EL SISTEMA NO RECONOCE EL DESTINO DE LA GRABACIÓN"+CHR(13);
											+CHR(13)+"ERROR AL GRABAR "+CHR(13)+CHR(13)+"CONSULTE AL PROGRAMADOR")
							llok = .f.
						ENDIF 
						
						IF llok
							oavisar.proceso('S','Grabando.....')
							TRY 
								IF thisform.tipofactura$'ED' 	&&facturacion diferida	(no fiscal, no compromete stock)	
									.odataexistenc.debosalvar	= .f.
									.odatamovstock.debosalvar	= .f.
								ENDIF  
								
								IF CsrComprobante.clase$"08" &&Clase presupuesto - remito de entrega
		
									.OdataTabasto.debosalvar	= .f.
									.OdataTabimpu.debosalvar	= .f.
									.OdataMovCtacte.debosalvar	= .f.
									.OdataCtacte.debosalvar	= .f.
									.OdataMovbcoCar.debosalvar	= .f.
									.odatamovcaja.debosalvar	= .f.
									.odataMovtarjeta.debosalvar	= .f.
		
									.OdataAfectacte.debosalvar	= .f.
									.Odataidasociado.debosalvar	= .f.
									.Odatavendedor.debosalvar	= .f.
									.OdataCabeasi.debosalvar	= .f.
									.OdataMovBcoDEta.debosalvar	= .f.
									*.OdataCabedeta.debosalvar	= .f.
									.OdataAfeCabefac.debosalvar	= .f.
									
									IF goapp.codempresa = 4 &&Quaglia
										.odatacabefac.debosalvar	= .f.
										.odatacuerfac.debosalvar	= .f.
										.Odatacuervari.debosalvar	= .f.
									ENDIF 
		*!*								
		*!*								.odataexistenc.debosalvar	= .t.
		*!*								.odatamovstock.debosalvar	= .t.
		
								ENDIF 
								llok = .f.	    
								DO case 
								CASE lnDondeGrabo = 1 && facturacion, premios,descarga,proforma,orden  (impresora no fiscales)
									llok = .GrabarDato()
								CASE lnDondeGrabo = 2 OR lnDondeGrabo = 3   && fiscal
									llok = .GrabarDiferidoFiscal(lnDondeGrabo)        
								CASE lnDondeGrabo = 4			&& nota pedido
									llok = .GrabarNotaPedido()
								CASE lnDondeGrabo = 6 && licitacion
									llok = .GrabarDatoLic()
								CASE lnDondeGrabo = 5
									llok = .t.		      	   	       
								ENDCASE					   	   	    	
							CATCH TO oError
								this.cadenaerrores =  'Error: '+ALLTRIM(oError.Details)+' Metodo: '+oError.Procedure+CHR(13)+;
								'Mensaje: '+ALLTRIM(oError.Message)+' Nro Error ['+ALLTRIM(STR(oError.ErrorNo))+']'+CHR(13)+;
								'Linea: '+ALLTRIM(oError.LineContents)
								llok = .f.
							ENDTRY  
							
							*IF thisform.tipofactura$'ED' OR CsrAuxMaopera.clasecomp$"0"
								.odataexistenc.debosalvar	= .t.
								.odatamovstock.debosalvar	= .t.
		
								.OdataTabasto.debosalvar	= .t.
								.OdataTabimpu.debosalvar	= .t.
								.OdataMovCtacte.debosalvar	= .t.
								.OdataCtacte.debosalvar	= .t.
								.OdataMovbcoCar.debosalvar	= .t.
								.odatamovcaja.debosalvar	= .t.
								.odataMovtarjeta.debosalvar	= .t.
								
								.odatacabefac.debosalvar	= .t.
								.odatacuerfac.debosalvar	= .t.
								.Odatacuervari.debosalvar	= .t.
								
								.OdataAfectacte.debosalvar	= .t.
								.Odataidasociado.debosalvar	= .t.
								.Odatavendedor.debosalvar	= .t.
								.OdataCabeasi.debosalvar	= .t.
								.OdataMovBcoDEta.debosalvar	= .t.
								.OdataCabedeta.debosalvar	= .t.
								.OdataAfeCabefac.debosalvar	= .t.
			
							*ENDIF  	
							.lokgrabar = llok
							IF llok
								IF !'NATIVE'$LcDataSourceType
									oCadapter.Datasource.ActiveConnection.committrans()
								ENDIF    
								END TRANSACTION 
								IF .oFacCAE.es_cae AND NOT .oFacCAE.es_caea AND CsrComprobante.clase$"ABC"  AND  lnDondeGrabo = 1 &&Generan Solo fac/ndeb/ncred
									&&SolicitoCAE
									**''
									*stop()
									IF CsrComprobante.clase$"A" AND this.generarentrega
										&&Recuperamos el proximonro de remito para imprimir en la factura
										lcProximoNroRto = this.leerproximoremito()
										lcAlias = ALIAS()
										SELECT CsrAuxCabefac
										GO TOP 
										replace proximonro_rto WITH lcProximoNroRto
										SELECT(lcAlias)
									ENDIF 
								
									IF NOT .SolicitaCAE()
										.Release
									ENDIF 							
								ENDIF 
								IF CsrComprobante.clase$"AX" AND this.generarentrega
									
									this.accion = "R"
									this.actualizar()
								ENDIF 
							ELSE
								IF !'NATIVE'$LcDataSourceType
									oCadapter.Datasource.ActiveConnection.rollbacktrans()
								ENDIF    
								ROLLBACK
								IF ! llok 
									=oavisar.usuario("GRABADO CANCELADO"+CHR(13)+this.cadenaerrores,0)
								ENDIF 
							ENDIF
						ELSE
							IF !'NATIVE'$LcDataSourceType
								oCadapter.Datasource.ActiveConnection.rollbacktrans()
							ENDIF    
							ROLLBACK	
							=oavisar.usuario("GRABACIÓN CANCELADA",0)
							IF !EMPTY(.cadenaerrores )
						   		oavisar.usuario(.cadenaerrores )
						   	ENDIF 
						ENDIF 		
						RELEASE oCadapter	    
					ENDIF
		
				CASE .accion$"R"
					.quetecla = 0
					.lokgrabar = .f.
					.actualizafac.lnquestock = 2 &&Nada			
					IF .quetecla=27
						RETURN .t.
					ENDIF 
					
					IF USED('FsrAuxOpera')
						USE IN FsrAuxOpera
					ENDIF 
					CREATE CURSOR FsrAuxOpera (ID N(12),IDMAOPERA N(12))
					INSERT INTO FsrAuxOpera VALUES (CsrCabefac.id,CsrCabefac.idmaopera)
						
			        oCadapter = .obtenercursor('CsrMaopera')
																			
					BEGIN TRANSACTION 
					IF !'NATIVE'$LcDataSourceType
						oCadapter.Datasource.ActiveConnection.Begintrans()
					ENDIF
					
					*stop()
								
					SELECT CsrComprobante
					LOCATE FOR clase='8'
					IF CsrComprobante.id = 0
						oavisar.usuario('NO ESTA DISPONIBLE EL COMPROBANTE TIPO REMITO DE ENTREGA'+CHR(13)+'VERIFIQUE LOS COMPROBANTES HABILITADOS')
						RETURN .F.
					ENDIF 
					
					.leerproximonro(Csrcomprobante.id,.f.,.f.) 
					REPLACE idcomproba WITH CsrComprobante.id,clasecomp WITH CsrComprobante.clase IN CsrAuxMAopera
					 	
					SELECT CsrauxCabefac
					GO TOP 
					lccompromemerc = '0'
					lcswitchcabefac=LEFT(switch,3)+lccompromemerc +RIGHT(switch,1)
					REPLACE switch WITH lcswitchcabefac IN CsrauxCabefac
					llok = .t.
										
					lnDondeGrabo = 1
		
						
					llok = .imprimir(thisform.lcimpresora,Csrprefitermi.tipoimpresora,1)
					IF !llok
						= Oavisar.usuario('El comprobante '+TRIM(Csrcomprobante.cnombre)+' no ha sido impreso'+CHR(13)+'SE CANCELA',0)
						thisform.cadenaerrores = "GRABACIÓN CANCELADA"
					ENDIF 
					
					IF llok
						oavisar.proceso('S','Grabando.....')
							
						IF CsrComprobante.clase$"08" &&Clase presupuesto - remito de entrega
		
							
						ENDIF 
						TRY 
							llok = .GrabarDatoRto()
						CATCH TO oError
							this.cadenaerrores =  'Error: '+ALLTRIM(oError.Details)+' Metodo: '+oError.Procedure+CHR(13)+;
							'Mensaje: '+ALLTRIM(oError.Message)+' Nro Error ['+ALLTRIM(STR(oError.ErrorNo))+']'+CHR(13)+;
							'Linea: '+ALLTRIM(oError.LineContents)
							llok = .f.
						ENDTRY  
									  	
						.lokgrabar = llok
						IF llok
							IF !'NATIVE'$LcDataSourceType
								oCadapter.Datasource.ActiveConnection.committrans()
							ENDIF    
							END TRANSACTION 
						ELSE
							IF !'NATIVE'$LcDataSourceType
								oCadapter.Datasource.ActiveConnection.rollbacktrans()
							ENDIF    
							ROLLBACK
							IF ! llok 
								=oavisar.usuario("GRABADO CANCELADO"+CHR(13)+this.cadenaerrores,0)
							ENDIF 
						ENDIF
					ELSE
						IF !'NATIVE'$LcDataSourceType
							oCadapter.Datasource.ActiveConnection.rollbacktrans()
						ENDIF    
						ROLLBACK	
						=oavisar.usuario("GRABACIÓN CANCELADA",0)
						IF !EMPTY(.cadenaerrores )
					   		oavisar.usuario(.cadenaerrores )
					   	ENDIF 
					ENDIF 		
					RELEASE oCadapter	    
					.actualizafac.lnquestock = .objseteoparam.def_lnquestock
		* borrar 
				CASE .accion$'bB'			
		       		lnok = 6 
		            .CadenaErrores="'NO SERA BORRADO'"
		           	IF CsrAuxmaopera.estado<>'0'				
		           		=Oavisar.usuario('YA ESTA BORRADO'+chr(13);
		           		    	+'Nº comprobante '+left(CsrAuxmaopera.numcomp,1)+' '+subst(CsrAuxmaopera.numcomp,2,4)+'-'+righ(CsrAuxmaopera.numcomp,8);
			                      	+chr(13)+'Nº interno     '+transform(CsrAuxmaopera.id,'999999999999'),0)
					   	lnok = 0
		           	ENDIF
		           	this.anula_delete = .f.
		           	if .verestadovalores(CsrAuxmaopera.id) AND lnok=6
		           		&&Si es Falso, se anula el comprobante, sino se elimina
		           		this.anula_delete = .f.
		           		IF RIGHT(LEFT(CsrAuxCabefac.switch,3),1)<>'1'
			            	IF LEFT(CsrAuxmaopera.switch,1)<>'0' AND .tipoform='N'
								=Oavisar.usuario("El comprobante esta facturado",0)
							  	 lnok = 0
			            	ENDIF
			            	IF lnok=6
				               	lnok = Oavisar.usuario('BORRA el comprobante'+chr(13);
				                      +'Nº comprobante '+left(CsrAuxmaopera.numcomp,1)+' '+subst(CsrAuxmaopera.numcomp,2,4)+'-'+righ(CsrAuxmaopera.numcomp,8);
				                      +chr(13)+'Nº interno     '+transform(CsrAuxmaopera.id,'999999999999');
				                     	,4+32+256)  
				                     		
				              	IF lnok=6 AND thisform.tipofactura$"M"
					   				lok = Oavisar.usuario('Confirma la eliminacion definitiva del comprobante '+Csrcomprobante.cnombre,36)	
									IF lok=6
										this.anula_delete = .t.
									ENDIF        		                                 
							   	ENDIF 
							ENDIF 		   		
						ENDIF   
								                     
					   	if lnok=6 
					      	oCadapter = .obtenercursor('CsrMaopera')
							
							BEGIN TRANSACTION 
							IF !'NATIVE'$LcDataSourceType
								oCadapter.Datasource.ActiveConnection.Begintrans()
							ENDIF
							oavisar.proceso('S','Borrando...')	
							TRY    	  
						      	DO case 
						           	CASE .tipoform$"FPD"      			&& facturacion, premios
						           		IF NOT this.anula_delete
					      	   				llok = .grabarBorrado()
					      	   			ELSE
					      	   				llok = .grabardelete()
					      	   			ENDIF 
								CASE Csrprefitermi.tipoimpresora=3   && fiscal
							      	llok = .GrabarBorradoDiferido()        
					        	CASE .tipoform$"N"      				&& nota pedido
									llok = .GrabarBorradonotapedido()		      	   	       
				   	   	    	ENDCASE
							CATCH TO oError
								.cadenaerrores =  'Error: '+ALLTRIM(oError.Details)+' Metodo: '+oError.Procedure+CHR(13)+;
								'Mensaje: '+ALLTRIM(oError.Message)+' Nro Error ['+ALLTRIM(STR(oError.ErrorNo))+']'+CHR(13)+;
								'Linea: '+ALLTRIM(oError.LineContents)
								llok = .f.
							ENDTRY 
			   	   			oavisar.proceso('N')	
							IF llok
								IF !'NATIVE'$LcDataSourceType
							      	oCadapter.Datasource.ActiveConnection.committrans()
							   	ENDIF    
							   	END TRANSACTION 
							ELSE
								IF !'NATIVE'$LcDataSourceType
							      	oCadapter.Datasource.ActiveConnection.rollbacktrans()
							   	ENDIF    
							   	ROLLBACK
							   	IF !EMPTY(.cadenaerrores )
							   		oavisar.usuario(.cadenaerrores )
							   	ENDIF 
							ENDIF
				            	RELEASE oCadapter	    	  		   
		               		ELSE 
		                   		=Oavisar.usuario('EL COMPROBANTE'+chr(13);
		                      				+'Nº comprobante '+left(CsrAuxmaopera.numcomp,1)+' '+subst(CsrAuxmaopera.numcomp,2,4)+'-'+righ(CsrAuxmaopera.numcomp,8);
		                      				+chr(13)+'Nº interno     '+transform(CsrAuxmaopera.id,'999999999999');
		                     				+chr(13)+.CadenaErrores,0)                                 
		               		ENDIF 
		            	ELSE
		            		=Oavisar.usuario('EL COMPROBANTE'+chr(13);
		                      				+'Nº comprobante '+left(CsrAuxmaopera.numcomp,1)+' '+subst(CsrAuxmaopera.numcomp,2,4)+'-'+righ(CsrAuxmaopera.numcomp,8);
		                      				+chr(13)+'Nº interno     '+transform(CsrAuxmaopera.id,'999999999999');
		                     				+chr(13)+.CadenaErrores,0)  
		            	ENDIF
				CASE .accion$"M"
				   	lok = Oavisar.usuario('Confirma el cambio de pago '+Csrcomprobante.cnombre,36)	
					IF lok#6
						RETURN .f.
					ENDIF    
				 	llok = .t.
				 	IF !this.oCONTABILIDAD.Validar()
						=oavisar.usuario('NO SE CAMBIARA EL PLAN '+CHR(13)+this.oCONTABILIDAD.Cadenaerror,0)
						LLOK = .F.
					ENDIF 
			
			        	oCadapter = .obtenercursor('CsrMaopera')
													
					BEGIN TRANSACTION 
					IF !'NATIVE'$LcDataSourceType
					     oCadapter.Datasource.ActiveConnection.Begintrans()
					ENDIF		
										     
					
					IF .not. (.tipoform $ 'F' AND .tipofactura $ 'NMDE')
				    		llok = .f.
				    	ENDIF 
				    	
				    	IF llok
					    	oavisar.proceso('S','Grabando...')	
					    	TRY   
		      	   	      	llok = .grabarcbiodato()		   	   	    	
						CATCH TO oError
							this.cadenaerrores = ('Error: '+ALLTRIM(oError.Details)+' Metodo: '+oError.Procedure+CHR(13)+;
								'Mensaje: '+ALLTRIM(oError.Message)+' Nro Error ['+ALLTRIM(STR(oError.ErrorNo))+']'+CHR(13)+;
		 						'Linea: '+ALLTRIM(oError.LineContents))
						 	llok = .f.
				   	   	ENDTRY  
			   	   	    	oavisar.proceso('N')	
						IF llok
							IF !'NATIVE'$LcDataSourceType
						      	oCadapter.Datasource.ActiveConnection.committrans()
						   	ENDIF    
						   	END TRANSACTION 
						ELSE
							IF !'NATIVE'$LcDataSourceType
						      	oCadapter.Datasource.ActiveConnection.rollbacktrans()
						   	ENDIF    
						   	ROLLBACK
						   	IF ! llok 
								=oavisar.usuario(this.cadenaerrores,0)
							ENDIF 
						ENDIF
					ELSE
						IF !'NATIVE'$LcDataSourceType
						     	oCadapter.Datasource.ActiveConnection.rollbacktrans()
						ENDIF    
						ROLLBACK
					ENDIF 
			CASE .accion$"C"
				   	lok = Oavisar.usuario('Confirma CONSIGNACION '+Csrcomprobante.cnombre,36)	
					IF lok#6
						RETURN .f.
					ENDIF    
				 	llok = .t.
				 	
				 	oCadapter = .obtenercursor('CsrCabefac')
													
					BEGIN TRANSACTION 
					IF !'NATIVE'$LcDataSourceType
					     oCadapter.Datasource.ActiveConnection.Begintrans()
					ENDIF		
										     
					
					IF .not. (.tipoform $ 'F' AND .tipofactura $ 'NMDE')
				    	llok = .f.
				    ENDIF 
			    	
			    	IF llok
				    	oavisar.proceso('S','Grabando...')	
				    	TRY   
		  	   	      	llok = .grabarconsignacion()		   	   	    	
					CATCH TO oError
						this.cadenaerrores = ('Error: '+ALLTRIM(oError.Details)+' Metodo: '+oError.Procedure+CHR(13)+;
							'Mensaje: '+ALLTRIM(oError.Message)+' Nro Error ['+ALLTRIM(STR(oError.ErrorNo))+']'+CHR(13)+;
		 						'Linea: '+ALLTRIM(oError.LineContents))
					 	llok = .f.
			   	   	ENDTRY  
		   	   	    oavisar.proceso('N')	
					IF llok
						IF !'NATIVE'$LcDataSourceType
					      	oCadapter.Datasource.ActiveConnection.committrans()
					   	ENDIF    
					   	END TRANSACTION 
					ELSE
						IF !'NATIVE'$LcDataSourceType
					      	oCadapter.Datasource.ActiveConnection.rollbacktrans()
					   	ENDIF    
					   	ROLLBACK
					   	IF ! llok 
							=oavisar.usuario(this.cadenaerrores,0)
						ENDIF 
					ENDIF
				ELSE
					IF !'NATIVE'$LcDataSourceType
					     oCadapter.Datasource.ActiveConnection.rollbacktrans()
					ENDIF    
					ROLLBACK
				ENDIF 	 
			ENDCASE            
			.cmdborrar.Visible = .f.    
			.cmdimprimir.visible= .f.
			&&Si lo pone aqui, para que al grabar limpie, pero no pregunte si quiere salir del sistema.
			&&Cosa que el operador no quiere.
			.limpiarcursor()		
			.ultimocontainer="CONTAINERENCABEZA"
			.K_escape()	 
		ENDWITH 
		
		RETURN .t.
		
	ENDPROC

	PROCEDURE agregarcuerfac
		APPEND BLANK IN CsrAuxCuerfac
		REPLACE univenta WITH 0,unibulto WITH 1,oricod WITH "D",registro WITH RECNO(),listaprecio WITH CsrAuxcabefac.listaprecio;
			perceibruto WITH 0,iddeposito WITH thisform.lniddeposito,idenvase WITH 0 , pesable WITH 0;
			,orden WITH thisform.nuevoorden(),oferfecha WITH CTOD('01-01-1900')  IN CsrAuxCuerfac
		replace perceiva5329 WITH 0 IN CsrAuxCuerfac
			
		IF thisform.tipoform$"N"
			&&Para que no genere bonificaciones/promociones
			replace bondigitada WITH 1 IN CsrAuxCuerfac
		ENDIF 
	ENDPROC

	PROCEDURE armarobserva		&& Re definimos el formulario para mostrar observaciones
		PARAMETERS lnTipo
		lnTipo = IIF(PCOUNT()<1,1,lnTipo)
		
		nConst			= 50
		WITH Thisform
			.Activarresize 		= .f.
			.Height 			= oEntorno.Height
			.Image1.Height 		= oEntorno.Image1_H
			.lblayudapie.Top	= oEntorno.AyudaPie_T
			.cmdBorrar.Top		= oEntorno.Boton_T
			.cmdcancelar.Top	= oEntorno.Boton_T
			.Cmdconsulta.Top	= oEntorno.Boton_T
			.Cmdimprimir.Top	= oEntorno.Boton_T
			.CmdSalvar.Top		= oEntorno.Boton_T
			.cmdRemito.Top		= oEntorno.Boton_T
			.CmdLicita.Top		= oEntorno.Boton_T
			._EditObserva.Visible	= oEntorno.EditO_V
			._EditObserva.Width		= .Containertotales.Width
			IF lnTipo = 1		
				.Height 			= oEntorno.Height + nConst
				.Image1.Height 		= oEntorno.Image1_H + nConst
				.lblayudapie.Top	= ._EditObserva.Top + ._EditObserva.Height + 10
				*.lblayudapie.Top	= oEntorno.AyudaPie_T + nConst
				.cmdBorrar.Top		= oEntorno.Boton_T + nConst
				.cmdcancelar.Top	= oEntorno.Boton_T + nConst
				.Cmdconsulta.Top	= oEntorno.Boton_T + nConst
				.Cmdimprimir.Top	= oEntorno.Boton_T + nConst
				.CmdSalvar.Top		= oEntorno.Boton_T + nConst
				.CmdRemito.Top		= oEntorno.Boton_T + nConst
				.CmdLicita.Top		= oEntorno.Boton_T + nConst
				._EditObserva.Visible	= .T.
			ENDIF
			.Activarresize 		= .t.
			*.Resize()
		ENDWITH  
	ENDPROC

	PROCEDURE buscarorigen
		
		IF this.tipoform$'F'
			IF !this.tipofactura$'N' &&Factura/Orden
				RETURN .f.
			ENDIF 
			*---------------
			loObjeto = CREATEOBJECT("CUSTOM")
			loObjeto.AddProperty('claseafectador',CsrComprobante.clase)
			loObjeto.AddProperty('idmaoperaafectado',0)
			loObjeto.AddProperty('idctacte',CsrAuxCabefac.idctacte)
			
			DO FORM PidoPendiente WITH loObjeto NAME loForm LINKED 
			
			IF VARTYPE(loForm)$'XU'
				RETURN .f.
			ENDIF 
			IF VARTYPE(loForm.lccadena)$'XU'
				RETURN .f.
			ENDIF 
			
			lcidmaopera = loForm.lcCadena
			RELEASE loObjeto
			RELEASE loForm 
		
			IF LEN(LTRIM(lcidmaopera))=0
				RETURN .f.
			ENDIF 
		ELSE
			RETURN .f.
		ENDIF 
		
		SELECT CsrComprobante
		LOCATE FOR clase='A'
		IF !CsrComprobante.clase$'A'
			RETURN .f.		
		ENDIF 
		
		lndecimaluni = thisform.ndecimaluni
		lndecimaltot = thisform.ndecimaltot
		
		SET SAFETY OFF 
		SELECT CsrauxCuerfac
		ZAP
		
		SELECT CsrAuxCuerVari
		ZAP
		SET SAFETY ON 
		
		* Cabefac
		SELECT CsrAuxCabefac
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrcabefac.id,CsrCabefac.idmaopera,CsrOpera.clasecomp,CsrCabefac.switch
		,LEFT(CsrOpera.numcomp,1)+' '+RIGHT(LEFT(CsrOpera.numcomp,5),4)+'-'+RIGHT(CsrOpera.numcomp,8) as numcomp
		,CsrComprobante.cnombre as nomcomproba,CsrCabefac.Switch,CsrOpera.clasecomp
		from Maopera as CsrOpera
		left join cabefac as CsrCabefac on CsrOpera.id = CsrCabefac.idmaopera
		left join comprobante as CsrComprobante on CsrOpera.idcomproba = CsrComprobante.id
		where CsrOpera.id in (<<lcidmaopera>>)
		ENDTEXT 
		IF !CrearCursorAdapter('FsrAuxOpera',lcCmd)
			RETURN .f.
		ENDIF 
		
		&&Si se recupero un remito. Esta no compromete mercaderia
		SELECT CsrAuxCabefac
		GO TOP 
		replace ComprometeMerc WITH 1 IN CsrAuxCabefac
		&&Marcos 15/11/2013 La marco como rendida para que no apareza en la rendicion
		
		this.generandorementrega = .f.
		SELECT FsrAuxOpera
		LOCATE FOR clasecomp='8'
		IF clasecomp='8'
			this.generandorementrega = .t.
		ENDIF 		
		* Cuerfac
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrcuerfac.* from Cuerfac as Csrcuerfac where Csrcuerfac.idmaopera in (<<lcidmaopera>>)
		ENDTEXT 
		        
		IF !thisform.obtenerdatos('Csrcuerfac',lccmd)
		  RETURN .f.
		ENDIF
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Csrcuervari.*,Csrsubproducto.nombre as nombre from cuervari as Csrcuervari
		left join subproducto as Csrsubproducto on Csrcuervari.idsubarti = Csrsubproducto.id		
		where Csrcuervari.idmaopera in (<<lcidmaopera>>)
		ENDTEXT 
		        
		IF !thisform.obtenerdatos('Csrcuervari',lccmd)
		  RETURN .f.
		ENDIF
		
		SELECT CsrAuxCabefac
		SCATTER NAME OscatterCab
		
		SELECT CsrauxCuerfac
		SCATTER NAME Oscatter
		
		SELECT CsrauxCuerVari
		SCATTER NAME OscatterVari
		
		SELECT CsrCuerfac
		GO TOP 
		SCAN FOR !EOF()
			SCATTER NAME Oscatter ADDITIVE 
		
			Oscatter.idmaopera = 0
			Oscatter.idcabeza = 0
			
			Oscatter.codextend = Oscatter.codigo
			
			lnunibulto  = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
			lnuniventa  = Oscatter.univenta			
			lnunibulto  = IIF(lnuniventa=1,1,lnunibulto)
			lnCantFinal = IIF(Oscatter.cantidad=0,1,Oscatter.cantidad)
			
			lnCantidad  = lnCantFinal / lnunibulto
			lnpesable 	= Oscatter.pesable
			lnkilos 	= Oscatter.kilos
			IF lnpesable = 0
				lnkilos    = lnkilos / lnCantFinal
			ENDIF 
			lncantkilos = lnkilos 
			lnVolumen	= Oscatter.volumen / lnCantFinal
			
			SELECT CsrauxCuerfac
			LOCATE FOR idarticulo = Oscatter.idarticulo AND preunita=Oscatter.preunita AND preunitasiva = Oscatter.preunitasiva AND despor = Oscatter.despor AND unibulto = Oscatter.unibulto AND pesable=Oscatter.pesable
			IF !(idarticulo = Oscatter.idarticulo AND preunita=Oscatter.preunita AND preunitasiva = Oscatter.preunitasiva AND despor = Oscatter.despor AND unibulto = Oscatter.unibulto AND pesable=Oscatter.pesable)
				APPEND BLANK
				Oscatter.registro = RECNO()	
				Oscatter.cantidad 	= 0
				Oscatter.cantkilos	= 0
				Oscatter.volumen	= 0
			ELSE
				SCATTER NAME Oscatter ADDITIVE 
			ENDIF 
			Oscatter.cantidad 	= Oscatter.cantidad + lnCantidad
			Oscatter.cantkilos	= Oscatter.cantkilos+ lnCantKilos
			Oscatter.volumen	= Oscatter.volumen + lnVolumen
		    GATHER NAME Oscatter 	      
		    
		    *Totalizamos 
		    SCATTER NAME Oscatter 
		    lnCantidad  = Oscatter.cantidad
		    lnKilos		= Oscatter.cantkilos
		    thisform.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
		    Oscatter.total = Red((IIF(this.incluyeiva,Oscatter.UniCiva,Oscatter.UniSiva) + Oscatter.internofin ),lndecimaltot)	
		    GATHER NAME Oscatter 
		    
		    SELECT CsrCuerVari
		    LOCATE FOR idcuerfac = CsrCuerfac.id
		    DO WHILE idcuerfac = CsrCuerfac.id
		    	SCATTER NAME OscatterVari ADDITIVE 
		    	OscatterVari.registro = Oscatter.registro
		    	OscatterVari.idmaopera = 0
		    	
		    	lnunibulto = IIF(CsrAuxCuerfac.unibulto=0,1,CsrAuxCuerfac.unibulto)
				lnuniventa = CsrAuxCuerfac.univenta
				lnunibulto = IIF(lnuniventa=1,1,lnunibulto)
				lnCantFinal = IIF(OscatterVari.cantidad=0,1,OscatterVari.cantidad)
				
				lnCantidad = OscatterVari.cantidad / lnunibulto
				lnKilos    = OscatterVari.kilos / lnCantFinal
				lnVolumen  = oscatterVari.volumen / lnCantFinal
				
				SELECT CsrAuxCuerVari
				LOCATE FOR registro = OscatterVari.registro AND idvariedad = OscatterVari.idvariedad
				IF !(registro = OscatterVari.registro AND idvariedad = OscatterVari.idvariedad)
					APPEND BLANK
					OscatterVari.cantidad 	= 0
					OscatterVari.kilos		= 0
					OscatterVari.volumen	= 0
				ELSE
					SCATTER NAME OscatterVari ADDITIVE 
				ENDIF 
				OscatterVari.cantidad 	= OscatterVari.cantidad + lnCantidad
				OscatterVari.kilos	= OscatterVari.kilos+ lnKilos
				OscatterVari.volumen	= OscatterVari.volumen + lnVolumen
				GATHER NAME OscatterVari
		    	
		    	SELECT CsrCuerVari
		    	SKIP    	
		    ENDDO 
			SELECT CsrCuerfac	
		ENDSCAN
		
		SELECT CsrCuerfac
		GO TOP 
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrCuerfac.* FROM Cuerfac as CsrCuerfac WHERE id < 0
		ENDTEXT 
		thisform.obtenerdatos('CsrCuerfac',lcCmd)
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrCuervari.* FROM Cuervari as CsrCuervari WHERE id < 0
		ENDTEXT 
		thisform.obtenerdatos('CsrCuervari',lcCmd)
		
		
		thisform.generandoloteremito = .t.
		thisform.generarentrega = .f.
		
		thisform.cmdremito.Enabled = .f.
		&&Seteamos el comprobante factura
		thisform.containerencabeza.Refresh()
		
		RETURN .t.
	ENDPROC

	PROCEDURE buscarproducto
		thisform.invocandoform = .t.
		oavisar.proceso('Buscando Productos...')
		
		LOCAL loObjParametro
		
		this.agregaobjeto.objbuscocomproba(@loObjParametro)
		
		
		WITH loObjParametro
			.cTypeSelection = "T"
			.AddProperty("incluyeiva",thisform.incluyeiva)
		ENDWITH 
		
		
		DO FORM busproducto_vta WITH loObjParametro NAME loFormBuscar LINKED
		
		lcidRetorno = IIF(VARTYPE(loObjParametro.cidretorno)$'C',loObjParametro.cidretorno,strtrim(loObjParametro.cidretorno,12))
		
		loObjParametro = null
		
		
		WITH thisform 
			IF LEN(TRIM(lcidretorno))#0
				*oavisar.usuario(lcidretorno)
				**&&''
				oCa = thisform.obtenercursor("CsrProducto")
		
				lcCmdProd = UPPER(Oca.SelectCmd)
				i = AT("WHERE",lcCmdProd)
				lcCmdProd = LEFT(lcCmdProd,i-1)
				lcCmdProd = lcCmdProd + " WHERE Csrproducto.id in (" + lcidretorno + ") "
				 
		*!*			TEXT TO lcCmdProd TEXTMERGE NOSHOW 
		*!*			SELECT Csrproducto.*,ISNULL(Tipoiva.tasa,0) as tasa,ISNULL(rubro.idfuerzavta,0) as idfuerzavta,isnull(left(tipoprod.switch,1),'0') as alcohol
		*!*			,ISNULL(rubro.perceibruto,0) as perceibruto, isnull(CsrAreaNegRubro.idarea,0) as idarea,ISNULL(Rubro.switch,'00000') as SwitchRubro 
		*!*			FROM Producto as Csrproducto 
		*!*			LEFT JOIN Tipoiva on Csrproducto.idiva = Tipoiva.id 
		*!*			LEFT JOIN rubro on Csrproducto.idrubro = rubro.id 
		*!*			LEFT JOIN tipoprod on rubro.idtipoprod = tipoprod.id  
		*!*			LEFT JOIN AreaNegRubro as CsrAreaNegRubro on Rubro.id = CsrAreaNegRubro.idrubro 
		*!*			where Csrproducto.id in (<<lcidretorno>>)
		*!*			ENDTEXT 
				=SaveSQL(lcCmdProd,this.Name+"_buscarprod")
				IF !ThisForm.Obtenerdatos('CsrProducto',lcCmdProd)
					thisform.Release
				ENDIF 
				
				**&&''
				SELECT CsrAuxCuerfac
				GO BOTTOM 
				
				SELECT CsrProducto
				GO top
				SCAN FOR !EOF()
					IF CsrAuxCuerfac.idarticulo <> 0 && insertamos un nuevo producto
						this.agregarcuerfac()
					ENDIF
				
					SELECT CsrProducto
					thisform.lnkeycode = 13
					thisform.grid2.column1.text1.Value = strtrim(CsrProducto.numero,8)
					IF thisform.kitbuscarProd.fc_lostfocus(CsrProducto.numero)		
						thisform.kitbuscarProd.f_lostfocusSay()
					ENDIF 
					
					*this.agregarcuerfac()
				ENDSCAN
			
			ENDIF 
		ENDWITH 
		
		
		thisform.invocandoform = .f.
		
		thisform.grid2.SetFocus()
	ENDPROC

	PROCEDURE calculobonictacte
		LPARAMETERS nBonif1 , nBonif2
		
		*!*	100*bonif1/100 = desc1
		*!*	(100-desc1)*bonif2/100 = desc2
		
		*!*	bonictacte =desc1 + desc2
		
		&&Si alguna bonificacion es 0, entonces debe tomarse alguna bonif
		IF nBonif1 = 0 OR nBonif2 =0
			RETURN nBonif1+nBonif2
		ENDIF 
		
		
		LOCAL nDesc1,nDesc2
		
		nDesc1 = nBonif1
		nDesc2 = (100-nDesc1)*nBonif2/100
		
		RETURN nDesc1 + nDesc2
	ENDPROC

	PROCEDURE calculobonirubro
		STORE 0 TO nBonif
		
		&& Completamos por defecto el bon del rubro y luego si existe por fecha del articulo
		&& Luego buscamos por el cliente y calculamos promociones de entrega
		&& Por ultimo si existe bonif de articulo. 
		
		nBonif = -1
		SELECT CsrBoniRubro
		LOCATE FOR idrubro = thisform.loObjBonifica.idrubro
		IF idrubro = thisform.loObjBonifica.idrubro AND NOT EMPTY(CsrBoniRubro.fecha)
			IF  FechaHoraCero(CsrBoniRubro.fecha)>=FechaHoraCero(CsrAuxCabefac.fecha)
				nBonif = CsrBonirubro.bonifica
			ENDIF 
		ENDIF 
		
		RETURN nBonif
	ENDPROC

	PROCEDURE cambiarcuenta
		LOCAL llok 
		llok = .f.		
		thisform.lcidcuentaa = 0
		thisform.lcidcuentad = 0
				
		TEXT TO lccmd TEXTMERGE NOSHOW 
		SELECT CsrCtactectacon.* FROM Ctactectacon as CsrCtacteCtacon 
		WHERE idctacte = <<CsrCtacte.id>> and idejercicio=<<goapp.idejerciciofac>>
		ENDTEXT 
		thisform.obtenerdatos('CsrctacteCtacon',lccmd)
		if RECCOUNT('CsrCtacteCtacon')#0
				SELECT CsrCtacteCtacon
				
		*!*			SELECT Csrplancue
		*!*			LOCATE FOR id=Csrctactectacon.idctacpra
		*!*			thisform.lcidcuentaa = IIF(id=CsrCtactectacon.idctacpra,CsrCtactectacon.idctacpra,0)
				SELECT Csrplancue
				LOCATE FOR id=Csrctactectacon.idctavta
				thisform.lcidcuentad = IIF(id=CsrCtactectacon.idctavta,CsrCtactectacon.idctavta,0)
				
			    llok = .t.
		ENDIF  
		IF this.lcidcuentad = 0 AND this.lcidcuentaa = 0
			llok = .f.
		ENDIF 
		RETURN llok
	ENDPROC

	PROCEDURE cambiocomproba		&& cambia el tipo de comprobante segun tipo iva ctacte
		PARAMETERS lnidtipoiva,lBuscarComp
		lBuscarComp = IIF(PCOUNT()<1,.f.,lBuscarComp)
		
		*stop()
		*thisform.agregaobjeto.letractacte(lnidtipoiva)
		thisform.oregfacvta.letraiva(lnidtipoiva,lBuscarComp)
		
		SELECT Csrcomprobante
		
		IF this.tipoform$'N' 
			FOR i=1 TO LEN(thisform.lcprioridad)
			    lcbusco = SUBSTR(thisform.lcprioridad,i,1)
				LOCATE FOR clase=lcbusco &&AND (signocta=2 OR signostock=2)
				IF clase=lcbusco
				   EXIT 
				ENDIF 
			NEXT 
		ELSE 
			**''
			IF CsrCategoiva.fiscal#"C" &&Si no es NOTA DE PEDIDO. Es correcto 
				FOR i=1 TO LEN(thisform.lcprioridad)
				    lcbusco = SUBSTR(thisform.lcprioridad,i,1)
					LOCATE FOR clase=lcbusco &&AND (signocta=2 OR signostock=2)
					IF clase=lcbusco
					   EXIT 
					ENDIF 
				NEXT 
			ELSE
				IF This.objseteoparam.CtacteCFaRemito
					LOCATE FOR id = This.lnidcomprobafaccf
					IF id != This.lnidcomprobafaccf
						GO TOP 
					ENDIF 
					IF .tipoform$"F" AND .tipofactura$"NM" AND CsrComprobante.clase$'HX' AND NVL(CsrCateCtacte.remito,0) = 1
						oavisar.usuario('El Cliente no esta habilitado para este tipo de COMPROBANTE.'+CHR(13)+;
										'Consulte las propiedades de la Categoria del Cliente.')
						GO TOP 
					ENDIF 
				ENDIF 
				IF CsrAuxCabefac.ctalogistica = 1 AND thisform.lnidcomremlog<>0
					LOCATE FOR id = thisform.lnidcomremlog
				ENDIF
			ENDIF
		ENDIF 
		
		REPLACE idcomproba WITH Csrcomprobante.id IN CsrAuxMaopera
		REPLACE idtipoiva WITH lnidtipoiva IN CsrAuxCabefac
		
		WITH thisform
			&&''
			.leerproximonro(Csrcomprobante.id,.f.)
			.containerencabeza._txtletra.Value = LEFT(.proximonro,1)
			.containerencabeza._txtnumcomp.Value = VAL(RIGHT(.proximonro,8))
		ENDWITH 
			
	ENDPROC

	PROCEDURE cargarcabefac		&& Carga datos cursor CsrAuxCabefac
		LOCAL lok,lidplanpago
		
		lok = .t.
		WITH thisform 
			
			IF !.containerencabeza.kitbuscaoaltaenCtacte.lprocesogrillabusqueda
				this.lbldatos.Visible	= .f.
				
				.lnidvendedor  = CsrAuxMaopera.idvendedor
				
				
				lnidtipoiva	  = IIF(CsrAuxCabefac.idctacte=0,3,CsrCtacte.tipoiva)
			    lnidcategoria = IIF(CsrAuxCabefac.idctacte=0,1,CsrCtacte.idcategoria)	       
				lnidlocalidad = IIF(CsrAuxCabefac.idctacte=0,.lnidlocalidad,CsrCtacte.idlocalidad)
				lnidprovincia = IIF(CsrAuxCabefac.idctacte=0,.lnidprovincia,CsrCtacte.idprovincia)
				lnidlista1    = IIF(CsrAuxCabefac.idctacte=0,.listadefecto,CsrCtacte.lista)		
				lccuit        = IIF(CsrAuxCabefac.idctacte=0,"",CsrCtacte.cuit)
				lnidcanalvta  = IIF(CsrAuxCabefac.idctacte=0,1,CsrCtacte.idcanalvta)
			    lnidctaotro		= IIF(CsrAuxCabefac.idctacte=0,0,NVL(CsrCtacte.idctaotro,0))
			    	
			    	lok = .controlctacte(CsrAuxCabefac.idctacte,lcCuit,lnidcategoria,lnidprovincia,lnidlocalidad,@lnidlista1,lnidcanalvta,lnidtipoiva,lnidctaotro)
				**''
				IF CsrAuxCabefac.idctacte#0   AND lok
					lidplanpago = .lnidplanpago
				   	IF Csrctacte.idplanpago#0
				      		IF .haycbioplanpago
					     		IF .tipoform#"N"
						 		SELECT Csrplanpago
						 		LOCATE FOR id=Csrctacte.idplanpago
						 	
						   		IF RECCOUNT("Csrplanpago")=0
						   			=Oavisar.usuario("Debe definir al menos un plan de pago"+CHR(13)+"CONTADO, CUENTA CORRIENTE, etc.")
						   	    		lok=.f.
						   		ENDIF 
						   		IF RECCOUNT("Csrvalor")=0
									=Oavisar.usuario("Debe definir al menos un tipo de valor"+CHR(13)+"EFECTIVO, CUENTA CORRIENTE, CHEQUE, etc.")	   	  
									lok = .f.
						   		ENDIF
						   	  	
						   		IF !.SoloContadoPde
							   		IF CsrPlanPago.id=CsrCtacte.idplanpago
							  			lidplanpago = Csrctacte.idplanpago
						  			ELSE
						  	   			=Oavisar.usuario("Debe definir al menos un plan de pago"+CHR(13)+"CONTADO, CUENTA CORRIENTE, etc.")
							   	    		lok=.f.
									ENDIF
								ELSE 							
									&&Leon Son todos Contado Pendiente Excepto los Cuenta Corrtiente
									SELECT CsrValor
									LOCATE FOR id = CsrPlanPago.idvalor
									lidplanpago = CsrPlanPago.id
									IF id=CsrPlanPago.idvalor AND !CsrValor.clasevalor$'C'
										GO TOP 
										lidplanpago = 0
										SCAN 
											SCATTER NAME OscValor
											IF OscValor.clasevalor$"F"
												SELECT CsrPlanPago
												LOCATE FOR idvalor = OscValor.id
												IF idvalor = OscValor.id
													lidplanpago = CsrPlanPago.id
													EXIT 
												ENDIF 
												SELECT CsrValor
											ENDIF 
										ENDSCAN 
									ENDIF 
									IF lidplanpago=0
										=OAvisar.usuario('Debe definir un plan de pago'+CHR(13)+"Para un valor clase CONTADO PENDIENTE")
										thisform.Release()
									ELSE
										SELECT CsrPlanPago
										LOCATE FOR id = lidplanpago
									ENDIF 
								ENDIF 
						 	ENDIF 				  
				 	  	ENDIF
				 	  	IF .SoloContadoPde AND .tipoform="N"
				 	  		SELECT Csrplanpago
						 	LOCATE FOR id=Csrctacte.idplanpago
				 	  		&&2013/08/28 Marcos
							&&No esta permitido facturar de contado. Todo pendiente y a rendir.
							IF ALLTRIM(CsrPlanPago.numero) <> "CP" AND .RemiCdoPde
								SELECT CsrPlanPago	
								LOCATE FOR numero="CP"
								lidplanpago = CsrPlanPAgo.id
								IF lidplanpago=0
									=OAvisar.usuario('Debe definir un plan de pago'+CHR(13)+"Para un valor clase CONTADO PENDIENTE")
									thisform.Release()
								ENDIF 
							ENDIF 
				 	  	ENDIF 
				   	ELSE
				   		=Oavisar.usuario("Debe definir al menos un plan de pago"+CHR(13)+"CONTADO, CUENTA CORRIENTE, etc.")
				   	   	lok=.f.				  
				   	ENDIF
				   	
				   
				   	IF lok		   
						
				      	*lnidtipoiva = CsrCtacte.tipoiva
				      	
				      	IF this.facturacf
						   SELECT CsrCategoiva
						   LOCATE FOR fiscal="C"  
						   lnidtipoiva = CsrCategoiva.id   
					   	ENDIF 
				   	
					   	REPLACE idctacte WITH CsrCtacte.id,cnombre WITH CsrCtacte.cnombre,cdireccion WITH CsrCtacte.cdireccion;
					          ,idtipoiva WITH lnidtipoiva,cuit WITH CsrCtacte.cuit,cpostal WITH CsrCtacte.cpostal,idcategoria WITH lnidcategoria;
					          ,subnumero WITH CsrSubCtacte.subnumero,idlocalidad WITH lnidlocalidad,subcnombre WITH "";
					          ,idprovincia WITH lnidprovincia,ctacte WITH CsrCtacte.cnumero,idplanpago WITH lidplanpago;
					          ,copiatkt WITH IIF(CsrCtacte.copiatkt#0,CsrCtacte.copiatkt,1),listaprecio WITH lnidlista1;
					          ,idrutavdor WITH CSrcuerruta.idrutavdor;
					          ,nropatron WITH "",vencimien WITH TTOD(fecha)+IIF(ISNULL(CsrCtacte.diasvto),0,CsrCtacte.diasvto);
					          ,SaldoCta WITH CsrCtacte.saldo,ctelefono WITH CsrCtacte.ctelefono;
					          ,datosfactura WITH NVL(CsrCtacte.cdatosfac,"") IN CsrAuxcabefac
					    
					    this.containerencabeza._txtvence.Enabled =  IIF(nvl(CsrCtacte.diasvto,0)=0,.t.,.f.)
					    
					    IF this.lnidctacteant <> CsrCtacte.id
					    	replace bonif1 WITH CsrCtacte.bonif1,bonif2 WITH CsrCtacte.bonif2 IN CsrAuxCabefac
					    	
					    ENDIF 
					    thisform.Refresh()
		         			
					   	replace NomProvincia WITH CsrProvincia.impabre,ProvReba WITH CsrProvincia.numero IN CsrAuxCabefac
					   	replace dni WITH NVL(CsrCtacte.dni,"") IN CsrAuxCabefac
					   	replace ctalogistica WITH Csrctacte.ctalogistica IN CsrAuxCabefac
					   	replace canalvta WITH CsrCanalVta.nombre,categoiva WITH CsrCategoiva.abrevia IN CsrAuxCabefac
					   	
					   	IF CsrAuxCabefac.saldocta<>0
					   		this.lbldatos.Caption = strtrim(CsrAuxCabefac.saldoCta,11,2)
					   		this.lbldatos.Visible	= .t.			   		
					   	ENDIF 
					   	IF CsrCanalVta.descuento#0 AND CsrAuxCabefac.bonif1=0
					   		replace bonif1 WITH CsrCanalVta.descuento IN CsrAuxCabefac
					   	ENDIF 
					   	IF RECCOUNT('CsrCtaTransporte')#0
					   		replace transporte WITH ALLTRIM(CsrCtaTransporte.cnombre) IN CsrAuxCabefac
					   	ENDIF 
					ENDIF 	          
				ELSE	
					thisform.containerencabeza.kitbuscaoaltaenCtacte.lrecargatxtnombre = .f.			     
					lccnombre = .containerencabeza.kitbuscaoaltaenCtacte.txtnombre.Value 
				   	
				   	REPLACE idctacte WITH 0,cnombre WITH lccnombre,cdireccion WITH "",idtipoiva WITH lnidtipoiva,cuit WITH "";
				          ,cpostal WITH "",idlocalidad WITH .lnidlocalidad,idprovincia WITH .lnidprovincia,idcategoria WITH lnidcategoria;
				          ,ctacte WITH "",listaprecio WITH .listadefecto,copiatkt WITH IIF(Csrprefijonro.copias#0,Csrprefijonro.copias,1);
				          ,idplanpago WITH .lnidplanpago,bonif1 WITH 0,subnumero WITH "",bonif2 WITH 0,subcnombre WITH "",idrutavdor WITH 0;
				          ,nropatron WITH "",vencimien WITH fecha ,saldocta WITH 0 IN CsrAuxcabefac
				   	replace NomProvincia WITH "",datosfactura WITH "",dni WITH "" IN CsrAuxCabefac
				   	replace ctalogistica WITH 0 ,categoiva WITH "" IN CsrAuxCabefac
				ENDIF 
					
				IF lok
					.cambiocomproba(CsrAuxcabefac.idtipoiva,.t.)
				ENDIF 
			ENDIF 
		ENDWITH 
		
		RETURN lok
		
	ENDPROC

	PROCEDURE cargarcombo
		PARAMETERS Oscatter
		
		lnidarticulo = Oscatter.idarticulo
		lnidcombo 	= Oscatter.Idprodcombo
		&&Recalculamos el combo por la cantidad digitada
		lnCantCombo = Oscatter.cantidad
		
		SET SAFETY OFF
		SELECT CsrAuxCuerCombo
		ZAP
		SCATTER NAME Oscatter ADDITIVE 
		
		SET SAFETY ON
		
		LOCAL lok,lcCmd,lnidproducto,lncantidad,lnunibulto,lndecimaluni,lndecimaltot,OscatterCab,lObjProducto
		
		lndecimaluni = thisform.ndecimaluni
		lndecimaltot = thisform.ndecimaltot
		
		SELECT CsrAuxCabefac
		SCATTER NAME OscatterCab
		
		
		&&Recuperamos el cuerpo del combo para cargarlo
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrCuerCombo.*,ISNULL(CsrSubProducto.id,0) as idsubprod 
		FROM CuerCombo as CsrCuerCombo 
		left join SubProducto as CsrSubProducto on CsrCuerCombo.idvariedad = CsrSubProducto.idvariedad 
												and CsrCuerCombo.idarticulo = CsrSubProducto.idarticulo
		WHERE CsrCuerCombo.idcabecombo = <<lnidcombo>>
		ENDTEXT 
		=CrearCursorAdapter('CsrCuerCombo',lcCmd)
		
		IF RECCOUNT('CsrCuerCombo')=0
			oavisar.usuario('No hay productos asociados al combo')
			RETURN .t.
		ENDIF 
		
		SELECT CsrCuerCombo
		lcidproducto = ""
		lcsep		 = ""
		GO top
		SCAN
			lcidproducto	= lcidproducto + lcsep + strtrim(CsrCuerCombo.idarticulo)
			lcsep			= ","
		ENDSCAN 
		
		
		oCa = thisform.obtenercursor("CsrProducto")
		
		lcCmdProd = UPPER(Oca.SelectCmd)
		i = AT("WHERE",lcCmdProd)
		lcCmdProd = LEFT(lcCmdProd,i-1)
		lcCmdProd = lcCmdProd + " WHERE Csrproducto.id in (" + lcidproducto+ ") " &&and ISNULL(CsrAreaNegRubro.estado,0)=0"
		
		
		*!*	TEXT TO lcCmd TEXTMERGE NOSHOW 
		*!*	SELECT Csrproducto.*,ISNULL(Tipoiva.tasa,0) as tasa,ISNULL(rubro.idfuerzavta,0) as idfuerzavta
		*!*	,left(tipoprod.switch,1) as alcohol,ISNULL(rubro.perceibruto,0) as perceibruto
		*!*	,isnull(rubro.omitirlistas,0) as omitirlistas 
		*!*	FROM Producto as Csrproducto
		*!*	LEFT JOIN Tipoiva on Csrproducto.idiva = Tipoiva.id
		*!*	LEFT JOIN rubro on Csrproducto.idrubro = rubro.id
		*!*	LEFT JOIN tipoprod on rubro.idtipoprod = tipoprod.id
		*!*	where Csrproducto.id in ( <<lcidproducto>> )
		*!*	ENDTEXT 
		
		IF !thisform.obtenerdatos('Csrproducto',lcCmdProd )
		   thisform.Release 
		ENDIF    
		
		SELECT CsrCuerCombo
		GO TOP 
		SCAN 
			SELECT CsrProducto
			LOCATE FOR id = CsrCuerCombo.idarticulo
			
			SCATTER NAME lObjProducto
			Oscatter.escombo  = 1
			Oscatter.idprodgenera = lnidarticulo    && guardo el id del articulo que le dio origen
			Oscatter.idarticulo   = Csrproducto.id
			Oscatter.idsubprod	  = CsrCuerCombo.idsubprod
			Oscatter.idvariedad	  = CsrCuerCombo.idvariedad
			Oscatter.codigo       = LTRIM(STR(Csrproducto.numero))
			Oscatter.codextend	  = LTRIM(STR(Csrproducto.numero))
			Oscatter.nombre       = Csrproducto.nombre
			Oscatter.unibulto     = Csrproducto.unibulto
			Oscatter.univenta     = Csrproducto.idtipovta
			Oscatter.idfuerzavta  = Csrproducto.idfuerzavta
			Oscatter.alcohol      = Csrproducto.alcohol
			Oscatter.perceibruto  = Csrproducto.perceibruto
			Oscatter.nofactura    = Csrproducto.nofactura
			Oscatter.idenvase 	  = CsrProducto.idenvase
			Oscatter.cantidad     = CsrCuerCombo.cantidad * lnCantCombo &&(Cantidad en el combo * Cantidad digitada combo)
			Oscatter.idprodregalo = 0
			Oscatter.despor       = CsrCuerCombo.bonifica
			Oscatter.stock        = 0
			Oscatter.desctoCiva   = 0
			Oscatter.desctoSiva   = 0
			Oscatter.idprodpromo  = 0
			Oscatter.cada         = 0
			Oscatter.entrega      = 0
			Oscatter.UniCiva      = 0
			Oscatter.UniSiva      = 0
			Oscatter.IvaUni       = 0
			OScatter.registro		= 0
			Oscatter.kilos		 	= 0
			Oscatter.cantkilos		= 0
			Oscatter.iddeposito 	= thisform.lniddeposito
			Oscatter.registro		= RECNO('CsrCuerCombo')
					
			SELECT CsrAuxCuerCombo
			APPEND BLANK
			GATHER NAME Oscatter	 
			      
		ENDSCAN 
		
		RELEASE lobjproducto
	ENDPROC

	PROCEDURE cargarcomboptovta		&& carga los puntos de ventas habilitados
		LPARAMETERS bInicarTalonario
		bInicarTalonario = IIF(PCOUNT()<1,.f.,bInicarTalonario)
		
		local lntalon,i,lCargoComp
		lntalon = thisform.talonario
		
		IF CsrAuxCabefac.categoiva = 'CF' AND thisform.talonarioCF#0
			lnTalon = thisform.talonariocf
		ENDIF 
		
		*stop()
		with thisform
		     .containerencabeza._cboptovta.Clear
		     Sele Csrprefitermi
		     go top
		     Scan for !eof()
			lCargoComp = .f.
			for i=1 to .containerencabeza._cboptovta.listcount
				if .containerencabeza._cboptovta.list(i) = strzero(prefijo,4)
					exit
				ENDIF
			ENDFOR 
			&&Marcos 15/01/14
		          &&Agrege la condicion del idcomproba
		          &&Porque esto agregaba todos los prefijos de la terminal.
		          &&Y necesitamos solo los de la terminal y el comprobante seleccionado.   
		*!*	          if i > .containerencabeza._cboptovta.listcount AND idcomproba = CsrAuxMaopera.idcomproba
		*!*	             .containerencabeza._cboptovta.Additem(strzero(prefijo,4),i)  
		*!*	          endif  
				&&Marcos 19/06/15
				&&Si esta activo el cae. Chequeamos por cae/caea para saber el prefijo activo 
				
				IF i > .containerencabeza._cboptovta.listcount AND idcomproba = CsrAuxMaopera.idcomproba
					IF NOT CsrComprobante.clase$"ABC"
					*IF NOT CsrAuxMaopera.clasecomp$"ABC"
					*IF NOT This.oFACCAE.es_cae
						.containerencabeza._cboptovta.Additem(strzero(prefijo,4),i) 
						lCargoComp = .t.   
					ELSE
						IF this.oFaCCAE.es_cae
							IF NOT this.oFaCCAE.es_caea 
							*---Solo CAE
								if NVL(Csrprefitermi.activocae,0)=1 AND Csrprefitermi.letra=.lcLetra AND NOT lCargoComp
		*!*								IF CsrAuxCabefac.categoiva = 'CF' AND thisform.talonarioCF#0
		*!*									IF thisform.talonarioCF = prefijo
		*!*										.containerencabeza._cboptovta.Additem(strzero(prefijo,4),i) 
		*!*										lCargoComp = .t. 
		*!*									ENDIF 
		*!*								ELSE 
										.containerencabeza._cboptovta.Additem(strzero(prefijo,4),i) 
										lCargoComp = .t. 
		*!*								ENDIF 
								endif    
							ELSE
								*--Solo CAEA
								if NVL(Csrprefitermi.activocaea,0)=1 AND Csrprefitermi.letra=.lcLetra AND NOT lCargoComp
									.containerencabeza._cboptovta.Additem(strzero(prefijo,4),i)
									lCargoComp = .t.
								endif    
							ENDIF 
							&&Comprobante pre numerado
							if Csrprefitermi.letra=.lcLetra AND NOT lCargoComp
								.containerencabeza._cboptovta.Additem(strzero(prefijo,4),i)  
								lCargoComp = .t.
							endif   
						ELSE
							if NVL(Csrprefitermi.activocae,0)=1
								LOOP 
							ENDIF 
							if NVL(Csrprefitermi.activocaea,0)=1
								LOOP 
							ENDIF 
							&&Comprobante pre numerado
							if Csrprefitermi.letra=.lcLetra AND NOT lCargoComp
								.containerencabeza._cboptovta.Additem(strzero(prefijo,4),i)  
								lCargoComp = .t.
							endif    
						ENDIF 
					ENDIF  
				ENDIF  
				
		*!*			IF NOT .oFACCAE.es_cae AND NOT .oFacCAE.es_caea
		*!*				if i > .containerencabeza._cboptovta.listcount AND idcomproba = CsrAuxMaopera.idcomproba
		*!*					.containerencabeza._cboptovta.Additem(strzero(prefijo,4),i)  
		*!*				endif     
		*!*			ELSE
		*!*				IF NOT .oFaCCAE.es_caea 
		*!*					*---Solo CAE
		*!*					if i > .containerencabeza._cboptovta.listcount AND idcomproba = CsrAuxMaopera.idcomproba AND NVL(activocae,0)=1 AND letra=.lcLetra
		*!*						.containerencabeza._cboptovta.Additem(strzero(prefijo,4),i)  
		*!*					endif    
		*!*				ELSE
		*!*					*--Solo CAEA
		*!*					if i > .containerencabeza._cboptovta.listcount AND idcomproba = CsrAuxMaopera.idcomproba AND NVL(activocaea,0)=1 AND letra=.lcLetra
		*!*						.containerencabeza._cboptovta.Additem(strzero(prefijo,4),i)  
		*!*					endif    
		*!*				ENDIF 
		*!*			ENDIF  
		
		    endScan
		    &&Marcos 15/01/14
		    &&Iniciamos el talonario por defecto al iniciar.
		    &&Si luego no existe para la terminal se reemplaza arriba.
		    &&Y no debemos volver a iniciarlo.
		    for i=1 to .containerencabeza._cboptovta.listcount
		        if .containerencabeza._cboptovta.list(i) = strzero(lntalon,4)
		           exit
		        endif
		    next   
		    if i > .containerencabeza._cboptovta.listcount AND bInicarTalonario
		    	.containerencabeza._cboptovta.Additem(strzero(lntalon,4),i)  
		    endif   
		                
		    .containerencabeza._cboptovta.value = iif(i>.containerencabeza._cboptovta.listcount,1,i)
			.containerencabeza._cboptovta.refresh()  
			
			.talonario = VAL(.containerencabeza._cboptovta.List(.containerencabeza._cboptovta.Value))  &&Es una propiedad y se cambia la posicion no se actualiza.
		endwith
		
	ENDPROC

	PROCEDURE cargarconcepto		&& Si se factura una nota de credito, debemos ingresarle el tipo de concepto
		WITH thisform
			.accion = "A"
			lok = .t.
			**&&''
		 	IF .tipoform$"S" &&Facturacion Diferida
		 		.actualizafac.lnquestock = 3 &&No afecta nada
		 	ENDIF 
		 	IF .tipoform$"N" &&Nota de Pedido
		 		.actualizafac.lnquestock = 3 && No Afecta 
		 	ENDIF 
		 	IF .tipoform$"F" &&Facturacion 07/02/2012
		 		.actualizafac.lnquestock = .nQueStockFacVta &&0 && Afecta 
		 	ENDIF 
		 	*stop()
		 	IF CsrComprobante.clase$"8" &&Si estamos grabando REMITO de ENTREGA
		 		.generarentrega = .t.
		 		.accion = "R"
		 	ENDIF 
		 	
		 	replace solograbar WITH 0 IN CsrAuxCabefac &&Por defecto hace todo.
		 	
			IF .tipoform$"F" AND CsrComprobante.clase$'C-H-B'
				*.actualizafac.lnquestock = 2
				loObjeto = CREATEOBJECT("Custom")
				loObjeto.AddProperty('origen',"CONCEPTO")
				loObjeto.AddProperty('lccaption',"CONCEPTO DE "+CsrComprobante.cnombre)
				loObjeto.AddProperty('detalle',SPACE(40))
				loObjeto.AddProperty('quetecla',0)
				*loObjeto.addproperty('iddeposito',0)
		   		loObjeto.AddProperty('CompOrig',CsrComprobante.clase)
		   		loObjeto.addproperty('letra',CsrCompAsociado.letra)
				loObjeto.addproperty('talonario',CsrCompAsociado.talonario)
				loObjeto.addproperty('numcomp',CsrCompAsociado.numero)
				loObjeto.addproperty('fecha',CsrCompAsociado.fecha)
				loObjeto.addproperty('clasecomp',CsrCompAsociado.clasecomp)
				loObjeto.addproperty('SoloGrabar',thisform.chkSoloImprimir.Value)
				
				DO FORM pidoconcepto WITH loObjeto name LobjForm linked
		
				IF lobjform.quetecla#27
				   REPLACE idtiponcredito WITH lobjform.idretorno IN CsrAuxCabefac
				   IF CsrComprobante.clase$'C-B'
				   	replace nroasociado WITH lObjForm.nroasociado,fechaaso WITH lObjForm.fechaaso IN CsrAuxCabefac
				   	replace compaso WITH lObjForm.compaso IN CsrAuxCabefac
				   ENDIF 
				 *  stop()
				   replace solograbar WITH lObjForm.solograbar IN CsrAuxCabefac
				   thisform.chkSoloImprimir.Value = lObjForm.solograbar
				ENDIF
		   
				IF CsrAuxCabefac.idtiponcredito=0
					=Oavisar.usuario("No se facturara el credito"+CHR(13)+"debe especificar el concepto de la misma",0)
					lok = .f.
				ELSE
					replace ALL iddeposito WITH lobjform.iddeposito  IN Csrauxcuerfac 
				ENDIF 
				
				loObjeto = null
				RELEASE lobjform
				
			ENDIF 
		
			IF lok
				
				IF NOT this.cargarlicitacion()
					RETURN 
				ENDIF 
				
				IF this.pedirpercepcion
					this.cargarpercepcion()
					RETURN 
				ENDIF 
				IF this.pedirdetacobranza
					this.cargardetacobranza()
					RETURN 
				ENDIF 
				IF .generarentrega OR .facconremito
					this.cargardatosremito()
					RETURN 
				ENDIF 
				this.cargardatosctacte() 
				*.key_43()
				
				.actualizafac.lnquestock = .objseteoparam.def_lnquestock
			ENDIF 		
		ENDWITH 	  
	ENDPROC

	PROCEDURE cargarctaconproducto
		&& le cargaremos al  Auxcuerfac la cuenta contable por la cual se generara el
		&& asiento, debemos verificar primero en la producto y sino en rubro
		&& buscamos los productos a grabar en el CUERFAC
		LPARAMETERS Oscatter
		
		lccidarticulo = Oscatter.idarticulo
		
		IF lccidarticulo != 0
			&&& traemos el prodctacon y el rubroctacon
			TEXT TO lccmd TEXTMERGE NOSHOW 
			SELECT CsrProdctacon.* FROM Prodctacon as CsrProdctacon
			where idarticulo in (<<lccidarticulo>>) and idejercicio = <<goapp.idejerciciofac>>
			ENDTEXT 
			CrearcursorAdapter('CsrProdCtacon',lccmd)
			
		*!*		TEXT TO lccmd TEXTMERGE NOSHOW 
		*!*		SELECT CsrProducto.id as idarticulo
		*!*		, ISNULL(CsrRubroCtacon.idctavta,0) as idctavta, ISNULL(CsrRubroctacon.idctacpra,0) as idctacpra
		*!*		from Producto as CsrProducto
		*!*		left join Rubroctacon as CsrRubroctacon on CsrProducto.idrubro = CsrRubroCtacon.idrubro
		*!*		where CsrProducto.id in (<<lccidarticulo>>) and CsrRubroctacon.idejercicio = <<goapp.idejerciciofac>>
		*!*		ENDTEXT 
		*!*		CrearCursorAdapter('CsrRubroCtacon',lccmd)
			
			SELECT CsrProdCtacon
			LOCATE FOR idarticulo = Oscatter.idarticulo
			IF idarticulo = Oscatter.idarticulo AND idctavta#0
				Oscatter.idctavta = CsrProdCtaCon.idctavta
		*!*			SELECT CsrRubroCtaCon
		*!*			LOCATE FOR idarticulo = Oscatter.idarticulo
		*!*			IF idarticulo = Oscatter.idarticulo
		*!*				Oscatter.idctadto = CsrRubroCtaCon.idctadto
		*!*			ENDIF     		
			ELSE
		*!*			SELECT CsrRubroCtaCon
		*!*			LOCATE FOR idarticulo = Oscatter.idarticulo
		*!*			IF idarticulo = Oscatter.idarticulo
		*!*				Oscatter.idctavta = IIF(Oscatter.idctavta=0,CsrRubroCtacon.idctavta,Oscatter.idctavta)
		*!*	*!*				Oscatter.idctadto = CsrRubroCtaCon.idctadto
		*!*			ENDIF 
			ENDIF 
			
		ENDIF 
	ENDPROC

	PROCEDURE cargardatosctacte
		SELECT CsrAuxCabefac
		SCATTER NAME OscCabefac
		
		&&Solo si es factura , consumidor final y mayor a 1000
		IF NOT this.tipoform$"F"
			this.key_43()
			RETURN 
		ENDIF 
		IF NOT ALLTRIM(CsrCategoiva.abrevia)$'CF'
			this.key_43()
			RETURN 
		ENDIF 
		IF NOT CsrComprobante.clase$"ABC"
			this.key_43()
			RETURN
		ENDIF 
		
		IF this.facturacf &&Se convierte a CF por comprobantes < topecf
			this.key_43()
			RETURN
		ENDIF 
		
		IF OscCabefac.Total < This.TopeCF
			replace SolicitaDNI WITH 1 IN CsrAuxCabefac
			this.key_43()
			RETURN 
		ENDIF 
		
		*!*	IF OscCabefac.Total > 1000 AND CsrAuxCabefac.SolicitaDNI=0
		*!*		replace SolicitaDNI WITH 1 IN CsrAuxCabefac
		*!*		this.key_43()
		*!*		RETURN 
		*!*	ENDIF 
		
		WITH this.contenedordni
			._txtdni.Value = OscCabefac.dni
			.Visible = .t.
			._txtdni.SetFocus()
		ENDWITH 
	ENDPROC

	PROCEDURE cargardatosfacvta		&& Abrimos la venta de datos para inicar la facturacion
		
		WITH thisform
			IF .hayescape
				RETURN 
			ENDIF 
			IF NOT .pidodatosfac
				RETURN 
			ENDIF 
			
			loObjeto = CREATEOBJECT("Custom")
			loObjeto.AddProperty('quetecla',0)
			loObjeto.addproperty('iddeposito',this.lniddeposito)
		   
			DO FORM pidodatosfacvta WITH loObjeto name LobjForm linked
		
			IF lobjform.quetecla#27
			   this.lniddeposito =  lobjform.iddeposito
			   replace ALL iddeposito WITH this.lniddeposito IN CsrAuxMaopera
			   .pidodatosfac = .f.
			   
			   TEXT TO lcCmd TEXTMERGE NOSHOW 
			   SELECT CsrDepoFletero.* FROM DepoFletero as csrDepoFletero
			   where iddeposito = <<this.lniddeposito>>
			   ENDTEXT 
			   IF NOT CrearCursorAdapter('CsrDepoFletero',lcCmd)
			   	oavisar.usuario('No se pudo cargar los datos asociados al deposito')
			   ELSE
			   		IF CsrDepoFletero.idfletero # 0
				   		TEXT TO lccmd TEXTMERGE NOSHOW 
						SELECT CsrFletero.* FROM Fletero as CsrFletero
						Where id = <<CsrDepoFletero.idfletero>>
						ENDTEXT 
						
						.obtenerdatos('CsrFletero',lccmd)
						WITH thisform.containeringreso
							.kitbuscaoaltaenFletero.txtexiste1.value= CsrFletero.numero
							.kitbuscaoaltaenFletero.txtnombre.value = CsrFletero.nombre
							.kitbuscaoaltaenFletero.txtid.value	 = CsrFletero.id
							.kitbuscaoaltaenFletero.txtexiste1.setfocus()
						ENDWITH 
					ENDIF 
					IF CsrDepoFletero.idvendedor # 0
				   		TEXT TO lccmd TEXTMERGE NOSHOW 
						SELECT CsrVendedor.* FROM Vendedor as CsrVendedor
						Where id = <<CsrDepoFletero.idvendedor>>
						ENDTEXT 
						
						.obtenerdatos('CsrVendedor',lccmd)
						WITH thisform.containeringreso
							.kitbuscaoaltaenVendedor.txtexiste1.value= CsrVendedor.numero
							.kitbuscaoaltaenVendedor.txtnombre.value = CsrVendedor.nombre
							.kitbuscaoaltaenVendedor.txtid.value	 = CsrVendedor.id
							.kitbuscaoaltaenVendedor.enabled = .f.
						ENDWITH 
					ENDIF 
					
					replace all idvendedor WITH NVL(CsrDepoFletero.idvendedor,0) IN csrauxmaopera
					replace idfletero WITH NVL(CsrDepoFletero.idfletero,0) IN csrauxcabefac
					
					IF CsrDepoFletero.idvendedor # 0 AND CsrDepoFletero.idfletero # 0
		*!*					lnidfuerzavta = .containeringreso.kitbuscaoaltaenfuerzavta.txtexiste1.Value
		*!*					.traerproductofuerzavta(lnidfuerzavta) 
		*!*					.traerproductosbloqueados()
		*!*					.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
					ENDIF 
			   ENDIF 
			ENDIF
		  	
			loObjeto = null
			RELEASE lobjform
			this.Tomardatosfac  = .f.
		ENDWITH 	  
		
		
		
		
	ENDPROC

	PROCEDURE cargardatosremito
		&&Mostamos para cargar los datos manuales del remito de entrega
		
		
		IF NOT CsrComprobante.clase$'AX8'
			this.key_43()
		ENDIF 
		
		WITH this.contenedorremito
			.Visible = .t.
			This.ultimocontainer="CONTENEDORREMITO"
			._txttransporte.Value = CsrAuxCabefac.transporte
			._txttransporte.SetFocus()
		ENDWITH 
	ENDPROC

	PROCEDURE cargardetacobranza
		&&Mostamos para cargar los datos manuales de un plan de cobro
		&&Si el plan de cobro se confirma con una contraseña
		&&En el caso que sea contado, se cambia a cuenta corriente
		&&El usuario cargara las cuotas,rango entre ellas y contraseña
		
		&&Solo si es factura manual calculo
		IF NOT CsrComprobante.clase$'AI'
			this.key_43()
		ENDIF 
		
		WITH this.contenedorcobranza
			.Visible = .t.
			This.ultimocontainer="CONTENEDORCOBRANZA"
			._txtcuota.SetFocus()
		ENDWITH 
		
	ENDPROC

	PROCEDURE cargarfuerzavta
		IF VARTYPE(thisform.objseteoparam.DEF_FUERZAVTA1)='L'
			IF thisform.objseteoparam.DEF_FUERZAVTA1
				IF RECCOUNT('CsrFuerzaVta')=0
					TEXT TO lcCmdFuerza TEXTMERGE NOSHOW 
					SELECT CsrFuerzaVta.* FROM FuerzaVta as CsrFuerzaVta WHERE numero=1
					ENDTEXT 
					IF !thisform.obtenerdatos('CsrFuerzaVta',lcCmdFuerza)
						RETURN 
					ENDIF 
				ENDIF 			
				
				SELECT CsrFuerzaVta
				LOCATE FOR numero = 1
				IF numero = 1
					WITH this.containeringreso.kitbuscaoaltaenfuerzavta
						.txtexiste1.Value = CsrFuerzaVta.numero
						lbvalor = .buscapornombre 
						.buscapornombre = .t.
						.txtexiste1.LostFocus
						.buscapornombre = lbvalor
						.Refresh()
					ENDWITH 
				ENDIF 
			ENDIF
			cleartec() 
		ENDIF 
	ENDPROC

	PROCEDURE cargarlicitacion
		WITH thisform
			LOCAL lok
			
			lok = .t.
		 	
			IF .tipoform$"F" AND CsrComprobante.clase$'V'
			
				*.accion = "A"
			
			
				loObjeto = CREATEOBJECT("Custom")
				loObjeto.AddProperty('detalle',SPACE(40))
				loObjeto.AddProperty('quetecla',0)
		   
				DO FORM pidodatosliq WITH loObjeto name LobjForm linked
				
				
				IF lobjform.quetecla=27
				   lok = .f.		   
				ENDIF
				
				loObjeto = null
				RELEASE lobjform
				
				RETURN lok
			ENDIF 
		ENDWITH 
	ENDPROC

	PROCEDURE cargarpercepcion
		
		&&Solo si es factura manual calculo
		IF NOT this.tipofactura$"ME"
			this.key_43()
		ENDIF 
		
		*!*	IF NOT this.pedirpercepcion
			this.key_43()
		*!*	ENDIF 
		
		*!*	LOCAL lnimporte,lntasa
		*!*	STORE 0 TO lnimporte,lntasa
		
		*!*	SELECT CsrAuxCabefac
		*!*	SCATTER NAME OscCabefac
		*!*	&&Controlamos cargando los valores que estan en el cabefac
		*!*	FOR i=1 TO 5
		*!*	    lcname = "OscCabefac.nomrete"+STR(i,1)
		*!*	    lcimpu = "OscCabefac.retencion"+STR(i,1)
		*!*	    lctasa = "OscCabefac.tasarete"+STR(i,1)
		*!*	    IF "IBTO"$&lcname   
		*!*			lnimporte   = lnimporte + &lcimpu
		*!*			lntasa      = &lctasa
		*!*		ENDIF
		*!*	NEXT 
		
		*!*	WITH this.contenedorperce
		*!*		._txttasaperce.Value = lnTasa
		*!*		._txtimpuestoperce.Value = lnImporte
		*!*		.Visible = .t.
		*!*		._txttasaperce.SetFocus()
		*!*	ENDWITH 
	ENDPROC

	PROCEDURE cargarperceproducto
		PARAMETERS Oscatter
	ENDPROC

	PROCEDURE cargarpromocion		&& Genera registro para la promocion
		PARAMETERS Oscatter
		
		SET SAFETY OFF
		SELECT CsrAuxCuerPromo
		ZAP
		SET SAFETY ON
		
		LOCAL lok,lcCmd,lnidproducto,lncantidad,lnunibulto,lndecimaluni,lndecimaltot,OscatterCab,lObjProducto
		
		lndecimaluni = thisform.ndecimaluni
		lndecimaltot = thisform.ndecimaltot
		
		SELECT CsrAuxCabefac
		SCATTER NAME OscatterCab
		
		lnidproducto = Oscatter.Idprodpromo
		
		oCa = thisform.obtenercursor("CsrProducto")
		
		lcCmdProd = UPPER(Oca.SelectCmd)
		i = AT("WHERE",lcCmdProd)
		lcCmdProd = LEFT(lcCmdProd,i-1)
		lcCmdProd = lcCmdProd + " WHERE Csrproducto.id in (" + STR(lnidproducto,10) + ") " &&and ISNULL(CsrAreaNegRubro.estado,0)=0"
		
		
		IF !thisform.obtenerdatos('Csrproducto',lcCmdProd )
		   thisform.Release 
		ENDIF    
		
		SELECT Csrproducto
		SCATTER NAME lObjProducto
		Oscatter.espromocion  = 1
		Oscatter.idprodgenera = Oscatter.idarticulo    && guardo el id del articulo que le dio origen
		Oscatter.idarticulo   = Csrproducto.id
		Oscatter.codigo       = LTRIM(STR(Csrproducto.numero))
		Oscatter.codextend	  = LTRIM(STR(Csrproducto.numero))
		Oscatter.nombre       = Csrproducto.nombre
		Oscatter.unibulto     = Csrproducto.unibulto
		Oscatter.univenta     = Csrproducto.idtipovta
		Oscatter.idfuerzavta  = Csrproducto.idfuerzavta
		Oscatter.alcohol      = Csrproducto.alcohol
		Oscatter.perceibruto  = Csrproducto.perceibruto
		Oscatter.nofactura    = Csrproducto.nofactura
		Oscatter.idenvase 	  = CsrProducto.idenvase
		Oscatter.cantidad     = Oscatter.entrega
		Oscatter.kilos = 0
		Oscatter.cantkilos = 0
		Oscatter.idprodregalo = 0
		Oscatter.despor       = 0
		Oscatter.stock        = 0
		Oscatter.desctoCiva   = 0
		Oscatter.desctoSiva   = 0
		Oscatter.idprodpromo  = 0
		Oscatter.cada         = 0
		Oscatter.entrega      = 0
		Oscatter.espromocion  = 1
		Oscatter.UniCiva      = 0
		Oscatter.UniSiva      = 0
		Oscatter.IvaUni       = 0
		OScatter.registro     = 0
		
		thisform.precioprod1.calculaprecio(lObjProducto,@lObjprecio)
					
		Oscatter.tasaiva      = lObjprecio.ivari
		Oscatter.precostosiva = lobjprecio.costoreposicion
		Oscatter.interno      = lObjprecio.interno
		
		LOCAL lnpreunita,lnpreunitasiva,lnprearti,lnpreartisiva
				
		IF NOT thisform.oRegfacvta.preciosnegociados(CsrAuxCuerfac.idarticulo,@lObjprecio)
			thisform.oRegFACVTA.PRECIoporlista(lObjProducto,@lObjprecio)
			thisform.determinarlistaprecio(@lnpreunita,@lnpreunitasiva,@lnprearti,@lnpreartisiva,OScatter.omitirlistas)
		ELSE
			&&Si se encuentran precios negociados,cambiamos las variables del precio
			lnpreunita     = lObjprecio.prevtaciva1   && CsrProducto.prevtaf4
			lnpreunitasiva = lObjprecio.prevta1       && CsrProducto.prevta4
			lnprearti		= ROUND(lnpreunita,2)
			lnpreartisiva	= ROUND(lnpreunitasiva,2)
		ENDIF 
		
				
		Oscatter.prearti		= lnprearti
		Oscatter.preartisiva	= lnpreartisiva
		Oscatter.preunita		= lnpreunita
		Oscatter.preunitasiva	= lnpreunitasiva
		Oscatter.total			= lnpreunita
		
		IF Oscatter.idarticulo=0 AND Oscatter.prearti=0 AND Oscatter.preunita#0
		  IF Csrplanpago.tasa#0
			 Oscatter.preunita = red( ((Oscatter.preunita-Oscatter.interno)*(Csrplanpago.tasa/100)+Oscatter.interno),lndecimaluni)
		  ENDIF      
		ENDIF 
		
		lncantidad     = Oscatter.cantidad
		lnunibulto	   = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
		lnuniventa     = Oscatter.univenta
		lnunibulto     = IIF(lnuniventa=1,1,lnunibulto)
		lnCantFinal    = lncantidad * lnunibulto
				
		thisform.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto)
		
		*Oscatter.total = Red((Oscatter.UniSiva + Oscatter.internofin + Oscatter.ivauni),lndecimaltot)		
		Oscatter.total = Red((IIF(this.incluyeiva,Oscatter.UniCiva,Oscatter.UniSiva) + Oscatter.internofin ),lndecimaltot)	
				
		SELECT CsrAuxCuerPromo
		APPEND BLANK
		GATHER NAME Oscatter	       
		
		RELEASE lobjproducto
	ENDPROC

	PROCEDURE cargarvalores
		
		TEXT TO lcCmdValor TEXTMERGE NOSHOW 
		Select Csrvalor.id,Csrvalor.numero,Csrvalor.nombre,Csrvalor.regisa,Csrvalor.regisb,Csrvalor.regisd,Csrvalor.regisf
		,Csrvalor.regisc,Csrvalor.regisk,Csrvalor.idctabco
		,isnull(Csrvalorctacon.idctaa,0) as idctaa,isnull(Csrvalorctacon.idctab,0) as idctab
		,isnull(Csrvalorctacon.idctad,0) as idctad,isnull(Csrvalorctacon.idctaf,0) as idctaf
		,isnull(Csrvalorctacon.idctac,0) as idctac,isnull(Csrvalorctacon.idctak,0) as idctak
		,Csrclasevalor.numero as clasevalor 
		from valor as Csrvalor 
		left join clasevalor as Csrclasevalor on Csrvalor.idclase = Csrclasevalor.id 
		left join valorctacon as Csrvalorctacon on Csrvalor.id = Csrvalorctacon.idvalor 
		where CsrValor.regisf = 1 and CsrValorCtaCon.idejercicio =
		ENDTEXT 
		
		thisform.actualizafac.cadenavalor = lcCmdValor
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		<<lcCmdValor>> <<goapp.idejerciciofac>>
		ENDTEXT 
		
		IF !thisform.obtenerdatos('CsrValor',lcCmd)
			thisform.Release()
		ENDIF 
	ENDPROC

	PROCEDURE cmdplan_cbioestado
		LPARAMETERS cLeyenda
		&&Si el facturador permite otras planes que contado pde y ctacte. No dejamos el cambio.
		**&&''
		IF ! this.Solocontadopde
			RETURN .t.
		ENDIF
		IF ! this.tipoform $ 'F'
			RETURN .f.
		ENDIF 
		IF ! this.tipofactura $ 'NMDE'
			RETURN .f.
		ENDIF 
		
		cLeyenda = 'a Contado P.'
		
		SELECT CsrPlanPago
		LOCATE FOR id = CsrAuxCabefac.idplanpago
		IF 'CP' $ CsrPlanPago.numero
			cLeyenda = 'a Cta.Cte.'
		ENDIF 
		
		RETURN .t.
	ENDPROC

	PROCEDURE consultalicita
		LOCAL lok
		
		thisform.permitemultilineas = .t.
		*thisform.generandoloteremito = .T.
		lok = thisform.RecuperarComproba()
		IF NOT lok
			SET SAFETY OFF
			SELECT CsrauxCuerfac
			ZAP
		
			SELECT CsrAuxCuerVari
			ZAP
			SET SAFETY ON 
		
			oavisar.usuario("Consulta de Licitaciones CANCELADA")
		ENDIF 
		
		thisform.grid2.SetFocus()
	ENDPROC

	PROCEDURE consultarultimoprecio
		LPARAMETERS lnidarticulo
		
		LOCAL dFecha
		
		dFecha = DATE()
		
		TEXT TO lcCmdVto TEXTMERGE NOSHOW 
		select id,numero,nombre,ISNULL(fechacbio,getdate()) as fechacbio from (
		SELECT csrproducto.id,csrproducto.numero,csrproducto.nombre 
		,(SELECT top 1 CsrCbioPrecio.fecha as fecha FROM CbioPrecio as CsrCbioPrecio
		where csrCbioPrecio.idarticulo = CsrProducto.id
		order by fecha desc) as fechacbio
		FROM producto as csrproducto) as CsrUltimoPrecio
		where id = <<lnidarticulo>>
		ENDTEXT 
		=SaveSQL(lcCmdVto,this.Name+"_ultimoprecio")
		=CrearCursorAdapter('CsrUltimoPrecio',lcCmdVto)
		IF RECCOUNT('CsrUltimoPrecio')=0
			RETURN dFecha
		ELSE
			RETURN TTOD(CsrUltimoPrecio.fechacbio)
		ENDIF 
	ENDPROC

	PROCEDURE contenedorcobranza_pierdofoco
		IF thisform.Hayescape
		   RETURN .t.
		ENDIF 
		LOCAL nCuota,nRango,cPassword
		STORE 0 TO nCuota,nRango
		
		WITH this.contenedorcobranza
			nCuota	= ._txtcuota.Value
			nRango	= ._txtrango.Value
			cPassWord = ._txtpassword.Value
			nValida = IIF(nCuota = 0,.f.,.t.)
			nValida = IIF(nRango = 0,.f.,nValida)
			IF NOT nValida
				oavisar.usuario('Hay información incompleta, vuelva a controlar')
				._txtcuota.SetFocus()
				RETURN 
			ENDIF 
			
			replace plancuota WITH 0, planrango WITH 0,hayplan WITH 0 IN CsrAuxCabefac
			
			IF ALLTRIM(cPassWord)<> ALLTRIM(This.PasswordCobranza)
				nOk = oavisar.usuario('Los datos de la negociación del pago NO se aplican'+;
								CHR(13)+'Contraseña INCORRECTA'+CHR(13)+CHR(13)+;
								'DESEA CONTINUAR?',4+32+256)
				IF nOk <> 6
					._txtcuota.SetFocus()
					RETURN 
				ENDIF 
			ELSE
				replace plancuota WITH nCuota, planrango WITH nRango,hayplan WITH 1 IN CsrAuxCabefac
			ENDIF 
			.Visible = .f.
		ENDWITH 
		*oavisar.usuario('Valido')
		
		&&Esto siempre se convierte a Cuenta Corriente
		SELECT CsrPlanPago
		LOCATE FOR numero = 'CCT'
		replace idplanpago WITH CsrPlanPago.id IN CsrAuxCabefac		
		
		thisform.key_43()
		thisform.grid2.Column1.text1.SetFocus()
		
	ENDPROC

	PROCEDURE contenedordni_pierdofoco
		IF thisform.Hayescape
		   RETURN .t.
		ENDIF 
		LOCAL nDNI
		STORE 0 TO nDNI
		
		WITH this.contenedordni
			cDNI	= ._txtdni.Value
			nDNI	= VAL(STRTRAN(cDNI,".",""))
			
			nValida = IIF(nDNI < 1000000,.f.,.t.)
			nValida = IIF(nDNI = 99999999,.f.,nValida )
		
			IF NOT nValida
				oavisar.usuario('Hay información incompleta, vuelva a controlar')
				._txtdni.SetFocus()
				RETURN 
			ENDIF 
			
			replace dni WITH cDNI,SolicitaDNI WITH 1 IN CsrAuxCabefac
			
			.Visible = .f.
		ENDWITH 
		
		thisform.ultimocontainer="THISFORM.GRID2"
		thisform.key_43()
		*thisform.grid2.Column1.text1.SetFocus()
		
	ENDPROC

	PROCEDURE contenedorperce_pierdofoco
		IF thisform.Hayescape
		   thisform.Hayescape = .f.
		   RETURN .t.
		ENDIF 
		LOCAL nNeto,cBase,nBasePerce,nTasa
		STORE 0 TO nNeto,nBasePerce,nTasa
		
		WITH this.contenedorperce
			nTasa =  ._txttasaperce.Value
			nBasePerce = ._txtimpuestoperce.Value
			.Visible = .f.
		ENDWITH 
		
		SELECT CsrAuxCabefac
		SCATTER NAME OscCabefac
		&&Recuperamos el Neto
		FOR i=1 TO 5
		    cBase = "OscCabefac.basegra"+STR(i,1)
		    *nImporte = &cBase
			nNeto = nNeto +  &cBase
		NEXT 
		
		FOR i=1 TO 5
		    lcname = "OscCabefac.nomrete"+STR(i,1)
		    lcbase = "OscCabefac.baserete"+STR(i,1)
		    lcimpu = "OscCabefac.retencion"+STR(i,1)
		    lctasa = "OscCabefac.tasarete"+STR(i,1)
		    IF LEN(LTRIM(&lcname))=0
				&lcname = "IBTO2"
		    	&lcbase = nNeto
		    	&lcimpu = nBasePerce
		    	&lctasa = nTasa
		    	GATHER NAME OscCabefac
		    	EXIT 
			ENDIF 
		NEXT 	
		
		replace total WITH total + nBasePerce IN CsrAuxCabefac
		
		WITH thisform.containertotales
			._txtpercepcion.Value	 = nBasePerce
			._txttotal.Value		 = CsrAuxCabefac.total
			.refresh
		ENDWITH 
		
		thisform.key_43()
		
	ENDPROC

	PROCEDURE contenedorremito_pierdofoco
		IF thisform.Hayescape
		   RETURN .t.
		ENDIF 
		LOCAL cTransporte
		STORE "" TO cTransporte
		
		WITH this.contenedorremito
			cTransporte	= ._txttransporte.Value
			nValida = IIF(lentrim(cTransporte)=0,.f.,.t.)
			
			IF NOT nValida
				oavisar.usuario('Hay información incompleta, vuelva a controlar')
				._txttransporte.SetFocus()
				RETURN 
			ENDIF 
			
			replace transporte WITH cTransporte IN CsrAuxCabefac
			
			.Visible = .f.
		ENDWITH 
		
		thisform.ultimocontainer="THISFORM.GRID2"
		thisform.key_43()
		*thisform.grid2.Column1.text1.SetFocus()
		
	ENDPROC

	PROCEDURE contenedorvto_pierdofoco
		LPARAMETERS dFechaVto
		
		replace vencimien WITH DTOT(dFechaVto) IN CsrAuxCabefac
		
		thisform.contenedorVto.Enabled = .f.
		thisform.contenedorVto.Visible = .f.
		thisform.generarcbioplan()
		
		
	ENDPROC

	PROCEDURE controlbonificacion		&& Controla las bonificaciones
		LOCAL lok,lncantCuerfac,lncantactual,lnctos,lnidproducto,lbhayunificaciones
		STORE 0 TO lncantCuerfac,lncantactual,lnctos,lnidproducto,lnuniventa,lnunibulto,lnuniventacuerfac
		
		lok = .t.
		
		&& Completamos por defecto el bon del rubro y luego si existe por fecha del articulo
		&& Luego buscamos por el cliente y calculamos promociones de entrega
		&& Por ultimo si existe bonif de articulo. 
		
		This.oRegfacvta.Descuentoscanalvta(thisform.loObjBonifica.idproducto,CsrAuxCabefac.fecha)
		
		IF thisform.loObjBonifica.bonpromo=0	  			
		
			SELECT Csrprodfzavta
			SET ORDER TO tag id
			=SEEK(thisform.loObjBonifica.idproducto,"Csrprodfzavta","id")
			&&Bonificacion de producto por fecha 
			IF !EMPTY(Csrprodfzavta.fecoferta)
				
			  	IF FechaHoraCero(Csrprodfzavta.fecoferta)>=FechaHoraCero(CsrAuxCabefac.fecha) OR DTOS(CsrProdfzavta.fecoferta)$'19000101'
			  		DO CASE  
			  		CASE Csrprodfzavta.min3<=this.loObjBonifica.cantidad AND Csrprodfzavta.min3 > 0
			  			lnbonifica=Csrprodfzavta.desc3
			  			lnminimo=Csrprodfzavta.min3
			  		CASE Csrprodfzavta.min2<=this.loObjBonifica.cantidad AND Csrprodfzavta.min2 > 0
			  			lnbonifica=Csrprodfzavta.desc2
			  			lnminimo=Csrprodfzavta.min2 				
			  		CASE Csrprodfzavta.min1<=this.loObjBonifica.cantidad
			  			lnbonifica=Csrprodfzavta.desc1
			  			lnminimo=Csrprodfzavta.min1				
			  		OTHERWISE 
			  			lnbonifica=0
			  			lnminimo = 0
			  		ENDCASE 
			  		thisform.loObjBonifica.bonpromo 	= lnbonifica
			  		thisform.loObjBonifica.oferminimo	= lnminimo
			  		thisform.loObjBonifica.bonpfecha	= Csrprodfzavta.fecoferta
			  		
			  		
			   	ENDIF 
			ENDIF 
		ENDIF 
		
		SELECT Csrprodfzavta
		&&Combo de Productos
		IF !EMPTY(Csrprodfzavta.fecCombo)
			*stop()
		  	IF FechaHoraCero(Csrprodfzavta.fecCombo)>=FechaHoraCero(CsrAuxCabefac.fecha)
		  		thisform.loObjBonifica.idcombo 	= Csrprodfzavta.idpromocombo
		  		RETURN 
		   	ENDIF 
		ENDIF 
		
		IF NOT this.Usarpromocion
			RETURN .f.
		ENDIF 
		
		* si la categoria del cliente permite promocion
		IF (LEFT(CsrCateCtaCte.switch,1)#'0' AND LEN(ALLTRIM(LEFT(CsrCateCtaCte.switch,1)))#0) OR CsrAuxCabefac.idctacte=0
			RETURN .f.
		ENDIF 
		
		IF RECCOUNT("Csrbonictacte")>0 
		   IF TTOD(CsrBoniCtacte.fecha) >= TTOD(CsrAuxCabefac.fecha)
		      thisform.loObjBonifica.bonctacte = Csrbonictacte.bonifica
		      thisform.loObjBonifica.bonfecha = Csrbonictacte.fecha
		   ENDIF    
		ENDIF 
		
		SELECT Csrprodfzavta
		SET ORDER TO tag id
		* busco unificacion de codigo
		lbhayunificaciones=.f.
		=SEEK(thisform.loObjBonifica.idproducto,"Csrprodfzavta","id")
		IF FOUND()
		   thisform.loObjBonifica.idcabeunifica = Csrprodfzavta.idcabeunifica
		   SET ORDER TO tag idcabuni
		   =SEEK(thisform.loObjBonifica.idcabeunifica,"Csrprodfzavta","idcabuni")
		    IF FOUND() AND thisform.loObjBonifica.idcabeunifica<>0
			  lbhayunificaciones=.t.
			endif
		ENDIF 
		
		* Analizo la unidad de venta
		
		lnuniventa=Csrproducto.idtipovta
		lnunibulto=csrauxcuerfac.unibulto
		lnuniventacuerfac=csrauxcuerfac.univenta
		IF lbhayunificaciones
		   SELECT CsrAuxCuerfac
		   IF lnuniventa=1
		      sum all cantidad*IIF(univenta<>1,unibulto,1) TO lnCantCuerfac FOR registro#thisform.loObjBonifica.registro AND idcabeunifica=thisform.loObjBonifica.idcabeunifica  AND espromocion = 0
		      lncantactual = thisform.loObjBonifica.cantidad*IIF(lnuniventacuerfac<>1,lnunibulto,1) + lnCantCuerfac
		   ELSE
		      sum all cantidad/IIF(univenta=1,unibulto,1) TO lnCantCuerfac FOR registro#thisform.loObjBonifica.registro AND idcabeunifica=thisform.loObjBonifica.idcabeunifica AND espromocion = 0
		      lncantactual = thisform.loObjBonifica.cantidad/IIF(lnuniventacuerfac=1,lnunibulto,1) + lnCantCuerfac
		   endif   
		ELSE
			lncantactual = thisform.loObjBonifica.cantidad + lnCantCuerfac   
		ENDIF
		
		SELECT Csrprodfzavta
		* 1.- busco por unificacion si thisform.loObjBonifica.idcabeunifica#0
		* 2.- busco por producto si thisform.loObjBonifica.idcabeunifica=0
		WITH thisform
			DO CASE 
			   CASE .loObjBonifica.idcabeunifica#0
				     SET ORDER TO tag idcabuni
			        =SEEK(.loObjBonifica.idcabeunifica,"Csrprodfzavta","idcabuni")
			        DO WHILE !EOF() AND Csrprodfzavta.idcabeunifica=.loObjBonifica.idcabeunifica
			           * si existe promocion por cantidad
					   IF TTOD(feccabepromo) >= TTOD(CsrAuxCabefac.fecha) AND Csrprodfzavta.idprodpromo#0;
						   AND lncantactual >= Csrprodfzavta.cada AND Csrprodfzavta.cada!=0
						   .loObjBonifica.cada			= Csrprodfzavta.cada
						   lnctos 						= INT(lncantactual / Csrprodfzavta.cada)
						   .loObjBonifica.entrega      	= Csrprodfzavta.entrega * lnctos
						   .loObjBonifica.idprodpromo  	= Csrprodfzavta.idprodpromo
						   .loObjBonifica.idprodregalo 	= Csrprodfzavta.idprodregalo
						   =.existencpromocion('B')
					   ENDIF 	   
				   	   * si existe % bonificacion por cantidad
				       	IF lncantactual >= Csrprodfzavta.candesde AND lncantactual <= Csrprodfzavta.canhasta;
				   		AND TTOD(Csrprodfzavta.feccuerpromo) >= TTOD(CsrAuxCabefac.fecha)
				 		  .loObjBonifica.bonpromo = Csrprodfzavta.boncuerpromo
				 		  .loObjBonifica.bonpfecha = Csrprodfzavta.feccuerpromo
			  	       	ENDIF  	   
			  	       SKIP 
					ENDDO
		
				OTHERWISE
			        * si existe promocion por cantidad
					SET ORDER TO tag id
					=SEEK(thisform.loObjBonifica.idproducto,"Csrprodfzavta","id")
		
					IF FOUND() AND TTOD(feccabepromo) >= TTOD(CsrAuxCabefac.fecha) AND Csrprodfzavta.idprodpromo#0;
							   AND lncantactual >= Csrprodfzavta.cada AND Csrprodfzavta.cada!=0
						.loObjBonifica.cada 		= Csrprodfzavta.cada
					   	lnctos 						= INT(lncantactual / Csrprodfzavta.cada)
					   	.loObjBonifica.entrega      = Csrprodfzavta.entrega * lnctos
						.loObjBonifica.idprodpromo  = Csrprodfzavta.idprodpromo
						.loObjBonifica.idprodregalo = Csrprodfzavta.idprodregalo
						 =.existencpromocion('B')	   
					ENDIF 
					
			   	    * si existe % bonificacion por cantidad
					DO WHILE !EOF() AND id = thisform.loObjBonifica.idproducto   	    
			  	       IF lncantactual >= Csrprodfzavta.candesde AND lncantactual <= Csrprodfzavta.canhasta;
					          AND TTOD(Csrprodfzavta.feccuerpromo) >= TTOD(CsrAuxCabefac.fecha)
				   		  .loObjBonifica.bonpromo = Csrprodfzavta.boncuerpromo
				   		  .loObjBonifica.bonpfecha = Csrprodfzavta.feccuerpromo
				   		  EXIT 
				       ENDIF   		   
				       SKIP 
					ENDDO 		
			ENDCASE
		ENDWITH 
		SELECT Csrprodfzavta
		SET ORDER TO tag id
		=SEEK(thisform.loObjBonifica.idproducto,"Csrprodfzavta","id")
		
		&&Bonificacion de producto por rubro
		IF !EMPTY(Csrprodfzavta.fecRubro)
		  	IF FechaHoraCero(Csrprodfzavta.fecRubro)>=FechaHoraCero(CsrAuxCabefac.fecha)
		  		thisform.loObjBonifica.bonpromo 	= Csrprodfzavta.bonRubro
		  		thisform.loObjBonifica.bonpfecha	= Csrprodfzavta.FecRubro
		   	ENDIF 
		ENDIF
		
		
		
		
		*!*	* venta producida los viernes % bonificacion
		*!*	SELECT csrprodfzavta
		*!*	 SET ORDER TO tag idcabuni
		*!*	=SEEK(thisform.loObjBonifica.idcabeunifica,"Csrprodfzavta","idcabuni")
		*!*	DO WHILE !EOF() AND Csrprodfzavta.idcabeunifica=thisform.loObjBonifica.idcabeunifica AND CsrProdFzaVta.idcabeunifica != 0
		*!*	   IF Csrprodfzavta.idvendedor = .loObjBonifica.idvendedor 
		*!*	     .loObjBonifica.bonpromo = Csrprodfzavta.bonvdor
		*!*	      EXIT 
		*!*	   ENDIF 
		*!*	   SKIP    
		*!*	ENDDO 
		
		
		
		RETURN lok
		
	ENDPROC

	PROCEDURE controlcaja
		*Controlamos que la caja del ejercicio activo exista
		IF ISNULL(CsrParaconfig.nrocaja)
			oavisar.usuario('ERROR. Nose puede FACTURAR. El ejericio ACTIVO = '+STR(goapp.ejercicio);
							+'No tiene CAJA ACTIVA')
		ENDIF 
	ENDPROC

	PROCEDURE controlcombo
		LPARAMETERS Oscatter
		
		IF NOT this.UsarCombo
			RETURN 
		ENDIF 
		
		thisform.cargarcombo(Oscatter)
		
		SELECT CsrAuxCuerFac
		GO lnrecno
		*!*	SCATTER NAME Oscatter
		
		*!*	&&Recalculamos el combo por la cantidad digitada
		*!*	lnCantidad = Oscatter.cantidad
		
		*!*	REPLACE ALL cantidad WITH cantidad * lnCantidad IN CsrAuxCuerCombo
		*!*		 
		*!*	SELECT CsrAuxCuerFac
		*!*	GO lnrecno 
		
	ENDPROC

	PROCEDURE controlctacte		&& Contrala el cliente con respecto al vendedor, fuerza vta, etc
		PARAMETERS lnidctacte,lccuitI,lnidcategoria,lnidprovincia,lnidlocalidad,lnidlista1,lnidcanalvta,lnidtipoiva,lnidctaotro
		
		
		LOCAL lcCmd,lok,msg,lcnomruta,lcvdor,lccuit,lnporperce,lnporrete,lcaliascateibto
		
		lccuit = STRTRAN(lccuitI,"-","")
		lcaliascateibto = ""
		
		STORE 0 TO lnporperce,lnporrete
		
		lok = .t.
		msg = 'NO SE PUEDE FACTURAR EL CLIENTE '+CHR(13)
		this.pedirpercepcion = .f.
		IF thisform.tipoform="F"
			oError=null
			IF !thisform.agregaobjeto.controlpadronbsas(lnidprovincia,CsrAuxCabefac.fecha,@oError)
				IF this.tipofactura$"EM"
					this.pedirpercepcion = .t.
				ELSE 
					Oavisar.usuario(msg + CHR(13)+oError.cadena,0)
					RETURN .f.
				ENDIF 
			ENDIF 
		ENDIF 
		
		* bonificacion por cliente / producto
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Csrbonirubro.* from bonirubro as Csrbonirubro
		where Csrbonirubro.idctacte =<<lnidctacte>>
		ENDTEXT 
		
		IF !CrearCursorAdapter('CsrboniRubro',lccmd)
		   .Release 
		ENDIF    
			
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select CsrcateCtaCte.*,CAST(0 as numeric(8,3)) as porperce,CAST(0 as numeric(8,3)) as porrete
		from cateCtaCte as CsrcateCtaCte 
		where CsrcateCtaCte.id = <<lnidcategoria>>
		ENDTEXT 
		=CrearCursorAdapter('CsrCateCtaCte',lccmd)
		
		thisform.agregaobjeto.objobteneribto(lccuit,lnidprovincia,@lcaliascateibto,@lnporperce,@lnporrete,LNIDCTACTE)
		
		IF RECCOUNT("CsrCateCtaCte")#0
			REPLACE porperce WITH lnporperce,porrete WITH lnporrete IN CsrCateCtacte
		ELSE 	
		   msg = msg+CHR(13)+"NO TIENE ASIGNADO UNA CATEGORIA"+CHR(13)
		   lok = .f.	
		ENDIF 
		
		this.vtabulto = .f.
		IF SUBSTR(CsrCateCtacte.switch,3,1)='1'
			this.vtabulto = .t.
		ENDIF 
		*stop()
		this.alicuota0 = this.usar_tasa0
		IF NVL(CsrCateCtacte.siva,0) = 1
			this.alicuota0 = .t.
		ENDIF 
		*stop()
		IF thisform.activoPerceIVA5329
			this.Calculopiva5329 = .t.
		ENDIF 
		&&Comentado, pq ahora hay un proceso que al grabar genera facturas menores a 100.000,00
		IF NVL(CsrCtacte.excluido5329,0) = 1 OR NVL(CsrCtacte.exentoPI,0) = 1
			this.Calculopiva5329 = .f.
		ENDIF 
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Csrcuerruta.*,Csrcaberuta.idrutavdor as idrutavdor,Csrcaberuta.dia as dia,ISNULL(Csrrutavdor.idfuerzavta,0) as idfuerzavta
		,ISNULL(Csrrutavdor.idvendedor,0) as idvendedor,ISNULL(Csrruta.nombre,' ') as nomruta,ISNULL(CsrFuerzavta.nombre,' ') as nomfzavta
		,ISNULL(Csrvendedor.nombre,' ') as nomvdor
		from cuerruta as CSrcuerruta
		left join caberuta as Csrcaberuta on Csrcuerruta.idcaberuta = Csrcaberuta.id
		left join rutavdor as Csrrutavdor ON ISNULL(Csrcaberuta.idrutavdor,0) = Csrrutavdor.id
		left join ruta as Csrruta on ISNULL(Csrrutavdor.idruta,0) = Csrruta.id
		left join fuerzavta as Csrfuerzavta on ISNULL(Csrrutavdor.idfuerzavta,0) = Csrfuerzavta.id
		left join vendedor as Csrvendedor on ISNULL(Csrrutavdor.idvendedor,0) = Csrvendedor.id
		where CSrcuerruta.idctacte = <<lnidctacte>>
		ENDTEXT 
		
		IF !thisform.obtenerdatos('Csrcuerruta',lccmd)
		   thisform.Release 
		ENDIF    
		
		SELECT CsrCuerruta
		GO top
		lcnomruta   = ""
		lcfuerzavta = ""
		lcvdor      = ""
		SCAN FOR !EOF()
		     IF !TRIM(nomruta)$UPPER(lcnomruta)
		    	lcnomruta   = lcnomruta + IIF(LEN(TRIM(lcnomruta))=0,"",CHR(13)) + "  "+TRIM(LEFT(nomruta,1)+LOWER(SUBSTR(nomruta,2)))
		     ENDIF 
		     IF !TRIM(nomfzavta)$UPPER(lcfuerzavta)
				lcfuerzavta = lcfuerzavta + IIF(LEN(TRIM(lcfuerzavta))=0,"",CHR(13)) + "  "+TRIM(LEFT(nomfzavta,1)+LOWER(SUBSTR(nomfzavta,2)))
			 ENDIF 
			 IF !TRIM(nomvdor)$UPPER(lcvdor)
				lcvdor      = lcvdor + IIF(LEN(TRIM(lcvdor))=0,"",CHR(13)) + "  "+TRIM(LEFT(nomvdor,1)+LOWER(SUBSTR(nomvdor,2)))
			 ENDIF 		
		ENDSCAN
		
		LOCATE FOR idvendedor = CsrAuxmaopera.idvendedor AND idfuerzavta = CsrAuxcabefac.idfuerzavta
		
		lok = .t.
		
		lVdorFacFueraRuta = .f.
		IF VARTYPE(THISFORM.objseteoparam.factodosvdor)$'L'
			lVdorFacFueraRuta = thisform.objseteoparam.factodosvdor
		ENDIF 
		
		IF NOT lVdorFacFueraRuta &&Sino esta permitido facturar fuera de ruta, CONTROLAMOS
			IF Csrvendedor.id<>csrparaconfig.idvendedor AND lnidctacte<>csrparaconfig.idcta02
				IF CsrAuxmaopera.idvendedor # CsrCuerruta.idvendedor OR CsrAuxcabefac.idfuerzavta # CsrCuerruta.idfuerzavta
				   msg = msg+CHR(13)+"PERTENECE A VENDEDOR "+CHR(13)+lcvdor+CHR(13);
								    +"PERTENECE A FUERZA DE VENTA "+CHR(13)+lcFuerzavta+CHR(13);
				   					+"PERTENECE A LA RUTA(S) "+CHR(13)+lcnomruta+CHR(13);
				   			        +"CUENTAS CORRIENTES \\ARCHIVOS \\GUIA DE VISITAS"+CHR(13)
				   lok = .f.
				ENDIF 
			ENDIF
		ENDIF 
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Csrcanalvta.* from canalvta as Csrcanalvta where Csrcanalvta.id = <<lnidcanalvta>>
		ENDTEXT 
		
		IF !thisform.obtenerdatos('Csrcanalvta',lccmd)
		   thisform.Release 
		ENDIF    
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT * FROM Ctacte WHERE id = <<lnidctaotro>>
		ENDTEXT 
		IF NOT CrearCursorAdapter('CsrCtaTransporte',lcCmd)
			thisform.Release
		ENDIF 
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrCanalVtaNeg.* FROM CanalVtaNeg as CsrCanalVtaNeg WHERE idcanalvta = <<CsrCanalVta.id>>
		ENDTEXT 
		=CrearCursorAdapter('CsrCanalVtaNeg',lcCmd)
		
		
		*Definimos Lista a Facuturar
		lnidlista1    = IIF(lnidlista1=0 and CsrAuxCabefac.idctacte#0,CsrCanalVta.lista,lnidlista1)
		lnidlista1    = IIF(lnidlista1=0 and CsrAuxCabefac.idctacte#0,CsrVendedor.lista,lnidlista1)
		lnidlista1    = IIF(lnidlista1=0 and CsrAuxCabefac.idctacte#0,This.listadefecto,lnidlista1)
		
		*Validamos activar RG5003
		IF  CsrAuxCabefac.fecha >= CTOD('01-07-2021')	
			thisform.orEGFACVTA.rg5003 = .t.
			thisform.agrEGAOBJETO.rg5003 = .t.
			thisform.objIMPRESOR.leyendarg5300 = .t.
		ENDIF 
		
		IF CsrCanalVta.id=0
		   msg = msg+CHR(13)+"NO TIENE ASIGNADO UN CANAL DE VENTA"+CHR(13)
		   lok = .f.
		ENDIF
		
		IF lnidlista1=0 
		   msg = msg+CHR(13)+"CLIENTE / CANAL DE VENTA / VENDEDOR / PARAMETROS GENERALES"+CHR(13)+"NO TIENE ASIGNADO UNA LISTA DE PRECIO"+CHR(13)
		   lok = .f.
		ENDIF
		
		IF lnidlocalidad=0
		   msg = msg+CHR(13)+"FALTA DEFINIR LOCALIDAD"+CHR(13)
		   lok = .f.
		ENDIF
		
		IF lnidprovincia=0
		   msg = msg+CHR(13)+"FALTA DEFINIR PROVINCIA"+CHR(13)
		   lok = .f.
		ENDIF
		
		SELECT CsrCategoiva
		LOCATE FOR id = lnidtipoiva
		IF id = lnidtipoiva
			IF CsrCategoiva.abrevia = "NCA"
				msg = msg+CHR(13)+"EL CLIENTE ES NO CATEGORIZADO"
				LOK = .F.
			ENDIF 
		ENDIF 
		
		IF !lok
		   =Oavisar.usuario(msg,0)
		ENDIF
		
		
		IF lok
			This.oRegfacvta.InitDto(lnidcanalvta)	
		ENDIF 
		
		RETURN lok
		
	ENDPROC

	PROCEDURE controlfactura		&& verifica si se puede facturar o no el producto segun determinadas caracteristicas
		PARAMETERS lntipocontrol
		
		LOCAL lok,msg,lnCtaRenFac,lnregactual
		
		lok = .t.
		msg = 'NO SE PUEDE FACTURAR EL PRODUCTO '+CHR(13)
		IF this.leyendocuerpedido
			msg = msg + CsrProducto.nombre + CHR(13)
		ENDIF 
		SET EXACT ON
		
		DO case
			CASE lntipocontrol=1 
				IF NOT this.permitemultilineas
					STORE 0 TO lnCtaRenfac,lyaelegi
					SELECT CsrAuxCuerfac
					lcnombre = nombre
					lnregistro = registro
					lnnofactura = nofactura
					lnidarticulo = idarticulo		
					lnespromocion = espromocion
					lnregactual = RECNO()
					lyaelegi = .f.
					lnorden=orden
					GO top
					SCAN FOR !EOF()
						IF lnidarticulo=CsrAuxCuerfac.idarticulo AND lnregistro#CsrAuxCuerfac.registro AND lnespromocion=0
				     		&&IF ALLTRIM(lcnombre)=ALLTRIM(CsrAuxCuerfac.nombre) AND lnregistro#CsrAuxCuerfac.registro AND lnespromocion=0
				        		lyaelegi = .t.
				        		lnorden=orden
				        		EXIT 
				     		ENDIF 
				     		lnCtaRenfac = lnCtaRenfac + 1
					ENDSCAN
					GO lnregactual   		
					
					IF lyaelegi AND thisform.tipoform#'N'
						SEEK lnorden IN csrauxcuerfac
					   	IF FOUND()
					   		lnnuevo=RECNO()
					   	  	SCATTER NAME OscCuerfac 
					   	  	
					   	  	GO lnnuevo
					   	  	
					   	  	lnorden = CsrAuxCuerfac.orden
					   	  	lnregistro = CsrAuxCuerfac.registro
					      	DELETE from csrauxcuerfac WHERE orden = lnOrden
					      	DELETE FROM Csrauxcuervari WHERE registro = lnRegistro
					      	
					      	GO lnregactual
					      	GATHER NAME OscCuerfac		      	
					      	REPLACE orden WITH thisform.nuevoorden() IN csrauxcuerfac
				                   
		              			thisform.reordeneproducto= .t.
		              			thisform.grid2.Refresh()
				   		ENDIF 
				  	 	*msg = msg+CHR(13)+TRIM(lcnombre)+' ..... (YA ESTA FACTURADO)'+CHR(13)
				   		RETURN .f.
					ENDIF 
				ENDIF 
				
				IF CsrAuxcabefac.idfuerzavta # CsrAuxCuerFac.idfuerzavta AND CsrAuxCuerFac.idarticulo#0
				   msg = msg+CHR(13)+"NO PERTENECE A LA FUERZA DE VENTA ..... ("+TRIM(CsrFuerzavta.nombre)+")"+CHR(13)
				   lok = .f.
				ENDIF
		
		
				if CsrAuxCuerFac.idarticulo#0 AND LEN(TRIM(CsrAuxCuerFac.alcohol))=0 
				   msg = msg+CHR(13)+'INDIQUE EN TIPO PRODUCTO SI ES VENTA DE ALCOHOL'+CHR(13)
				   lok = .f.
				endif
		
		
				IF CsrComprobante.clase$'ABCUI'	AND CsrAuxCabefac.ProvReba = 2	 
				
					if CsrAuxCuerFac.alcohol='1' AND CsrAuxCuerFac.idarticulo#0 AND LEN(RTRIM(Csrctacte.inscri01))=0
					   msg = msg+CHR(13)+'EL CLIENTE NO POSEE AUTORIZACION P/VENDER ALCOHOL'+CHR(13)
					   lok = .f.
					ENDIF
		
		
					if CsrAuxCuerFac.alcohol='1' AND CsrAuxCuerFac.idarticulo#0 AND LEN(RTRIM(Csrctacte.inscri01))#0 AND thisform.containerencabeza._txtfecha.Value > Csrctacte.fecins01
					   msg = msg+CHR(13)+'EL CLIENTE TIENE VENCIDA LA AUTORIZACION P/VENDER ALCOHOL'+CHR(13)
					   lok = .f.
					ENDIF
					
				ENDIF
				if CsrAuxCuerFac.nofactura#0 AND CsrAuxCuerFac.idarticulo#0
				   msg = msg+CHR(13)+'NO PERMITE SER FACTURADO, VERIFIQUE MARCA FACTURACION'+CHR(13)
				   lok = .f.
				ENDIF
		
			CASE lntipocontrol=2
				IF CsrAuxCuerFac.idarticulo#0 AND CsrAuxCuerFac.prearti#0 AND CsrAuxCuerfac.espromocion#0 AND thisform.tipoform="P"   && premio
				   msg = msg+CHR(13)+'NO ES UN PREMIO, TIENE IMPORTE'+CHR(13)
				   lok = .f.
				ENDIF 	 		   
		ENDCASE
		
		SET EXACT OFF
			
		IF !lok
		   =Oavisar.usuario(msg,0)
		ENDIF
		
		RETURN lok 
		
	ENDPROC

	PROCEDURE controlinicial		&& Controles varios al iniciar el formulario
		WITH thisform
			
			IF .usarcajaactiva
				IF !Leerparametrosdiario(1)
					thisform.Release
				ENDIF 
			ENDIF 
			
			IF .Hayescape
				RETURN 
			ENDIF
			
			IF .tipoform$"N"
		
				ldfecha = DATE()
				lcfecha = "'"+DTOS(ldfecha)+"'"
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				SELECT CsrDetanrocaja.* FROM DetaNrocaja as CsrDetanrocaja
				where fecdesde <= <<lcfecha>> and <<lcfecha>> <=fechasta
				ENDTEXT 
				IF !CrearCursorAdapter('CsrFecPedido',lcCmd)
					.Release
				ENDIF 
				IF RECCOUNT('CsrFecPedido')=0
					=Oavisar.usuario("LA CAJA DEL DIA "+DTOC(ldfecha)+" NO ESTA ABIERTA"+CHR(13)+CHR(13);
				              +'UTILES \\ PARAMETROS \\ PARAMETROS DIARIOS',0)
			   		.Release
				ENDIF 
				REPLACE nrocaja WITH CsrFecPedido.nrocaja IN CsrAuxMaopera
				replace fecha WITH ldfecha IN CsrAuxCabefac
				
				thisform.containerencabeza._txtnrocaja.Refresh()
				thisform.containerencabeza._txtfecha.Refresh()
			ELSE
				
				IF .activarcajadiario
					ldfecha = DATE()
					lcfecha = "'"+DTOS(ldfecha)+"'"
					TEXT TO lcCmd TEXTMERGE NOSHOW 
					SELECT CsrDetanrocaja.* FROM DetaNrocaja as CsrDetanrocaja
					where fecdesde <= <<lcfecha>> and <<lcfecha>> <=fechasta
					ENDTEXT 
					IF !CrearCursorAdapter('CsrFecCaja',lcCmd)
						.Release
					ENDIF 
					llok = .t.
					IF RECCOUNT('CsrFecCaja')=0
						*DO FORM regcajaactiva
						llok = this.oRegFacVta.cajadiaria(ldfecha)
					ENDIF 
					IF llok
						REPLACE nrocaja WITH CsrFecCaja.nrocaja IN CsrAuxMaopera
						replace fecha WITH CsrFecCaja.fecdesde IN CsrAuxCabefac
					ENDIF 
					thisform.containerencabeza._txtnrocaja.Refresh()
					thisform.containerencabeza._txtfecha.Refresh()
				ENDIF 
				
		*!*			cMensaje = 'CONTROL FISCAL'+CHR(13)
		*!*			
		*!*			SELECT CsrParaVario
		*!*			LOCATE FOR nombre='PFISCALPRE'
		*!*			ldpefiscal = CsrParaVario.fecha
		*!*			ldfecha = CTOD("01"+SUBSTR(DTOC(CsrAuxCabefac.fecha),3) )
		*!*			IF (GOMONTH(ldfecha,-1)<ldpefiscal)
		*!*				oavisar.usuario(cMensaje+'La fecha de emisión es menor o igual al ultimo periodo presentado')	
		*!*				.Release
		*!*			ELSE 
		*!*				IF (GOMONTH(ldpefiscal,2)<ldfecha)
		*!*					oavisar.usuario(cMensaje+'El ultimo periodo presentado difiere en mas de dos meses a la fecha de emisión')	
		*!*					.Release
		*!*				ENDIF 
		*!*			ENDIF 
				
				*---La facturacion manual es de talonarios no electronica
				IF .tipoform$"F" AND .tipofactura$"N" AND NOT .oFacCAE.es_caea
					&&MArcos 10/06/2015
					.oFacCAE.p_fecha = TTOD(CsrAuxCabefac.fecha)
					lok = .oFacCAE.fac_controlinicial()
					IF lentrim(.oFacCAE.cadenaerrores)<>0
						oavisar.usuario(.oFACCAE.cadenaerrores)
						.lbltituloform.Caption= "ADVERTENCIA - MODO CAE Anticipado INACTIVO"
					ENDIF 
					IF lok 
						IF .oFacCAE.es_cae
							.lblCAEA.Caption = "CAE / CAEA: "+.oFacCAE.p_cae
						ELSE
							&&Modo tradicional
						ENDIF 			
					ELSE
						.Release
					ENDIF 	
				ENDIF 
				
			ENDIF 
		
			IF RECCOUNT("Csrprefitermi")=0
			   =Oavisar.usuario("FALTA DEFINIR AL MENOS UN PUNTO DE VENTA PARA LA TERMINAL"+CHR(13)+CHR(13);
				              +'ARCHIVOS GENERALES \\ ABM DE PREFIJOS COMPROBANTES',0)
			   .Release
			ENDIF
		
			IF Csrcomprobante.id=0
				=Oavisar.usuario('NO ES POSIBLE ESTABLECER UN TIPO DE COMPROBANTE'+CHR(13)+CHR(13);
								+'VERIFIQUE '+IIF(thisform.tipoform="N",'NOTAS DE PEDIDO','FACTURA / N.DEBITO / N.CREDITO')+CHR(13);
								+'ARCHIVOS GENERALES \\ ABM DE COMPROBANTES'+CHR(13);
				                +'ARCHIVOS GENERALES \\ ABM DE PREFIJOS COMPROBANTES',0)
			   	.release
			ENDIF
		ENDWITH 
		
	ENDPROC

	PROCEDURE controlpromocion
		IF thisform.hayescape
			*oavisar.usuario('Entro')
			RETURN .t.
		ENDIF 
		
		*stop()
		*Cargamos Producto
		SELECT CsrAuxCuerFac
		lnrecno = RECNO()
		SCATTER NAME Oscatter
		
		
		DO CASE
			CASE .loObjBonifica.idcombo#0
				.controlcombo(Oscatter)
				SELECT CsrAuxCuerfac
				GO lnrecno
				
				*this.lbdebugg = .t.
				
				RETURN 	
			CASE .loObjBonifica.cada#0 AND .loObjBonifica.entrega#0 AND .loObjBonifica.bonpromo=0 AND this.Usarpromocion
				.cargarpromocion(Oscatter)
				*RETURN 
			CASE (.loObjBonifica.cada=0 OR .loObjBonifica.entrega=0) AND .loObjBonifica.bonpromo#0	   	     
			CASE .loObjBonifica.cada#0 AND .loObjBonifica.entrega#0 AND .loObjBonifica.bonpromo#0 AND this.Usarpromocion
				.containerpromoboni.Visible = .t.
				.containerpromoboni.Refresh
				.containerpromoboni.SetFocus()
				.containerpromoboni.Click()
		ENDCASE	
		
		
		SELECT CsrAuxCuerFac
		GO lnrecno
		SCATTER NAME Oscatter
		
		*Recalculamos cantidades por proocion
		LOCAL lnidcabeunifica,lnCantCuerfac
		STORE 0 TO lnidcabeunifica,lnCantCuerfac
		lncantidad   = Oscatter.cantidad
		lnunibulto	 = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
		lnpesable	 = Oscatter.pesable
		lnuniventa   = Oscatter.univenta
		lnunibulto   = IIF(lnuniventa=1,1,lnunibulto)
		lnkilos		 = IIF(lnpesable=0,0,Oscatter.cantkilos)
		lnCantidad	 = lnCantidad * IIF(lnpesable = 0, lnunibulto,1)
		
		SELECT Csrprodfzavta
		SET ORDER TO tag id
		* busco unificacion de codigo
		lbhayunificaciones=.f.
		=SEEK(Oscatter.idarticulo,"Csrprodfzavta","id")
		IF FOUND()
		   lnidcabeunifica = Csrprodfzavta.idcabeunifica
		   SET ORDER TO tag idcabuni
		   =SEEK(lnidcabeunifica,"Csrprodfzavta","idcabuni")
		    IF FOUND() AND lnidcabeunifica<>0
			  lbhayunificaciones=.t.
			endif
		ENDIF 
		
		* Analizo la unidad de venta
		lnuniventa			= OScatter.univenta
		lnunibulto			= Oscatter.unibulto
		lnuniventacuerfac	= Oscatter.univenta
		IF lbhayunificaciones
		   SELECT CsrAuxCuerfac
		   IF lnuniventa=1
		      SUM ALL cantidad*IIF(univenta<>1,unibulto,1) TO lnCantCuerfac FOR registro#Oscatter.registro AND idcabeunifica=lnidcabeunifica AND espromocion = 0
		      lncantactual = Oscatter.cantidad*IIF(lnuniventacuerfac<>1,lnunibulto,1) + lnCantCuerfac
		   ELSE
		      SUM ALL cantidad/IIF(univenta=1,unibulto,1) TO lnCantCuerfac FOR registro#Oscatter.registro AND idcabeunifica=lnidcabeunifica AND espromocion = 0
		      lncantactual = Oscatter.cantidad/IIF(lnuniventacuerfac=1,lnunibulto,1) + lnCantCuerfac
		   endif   
		ELSE
			lncantactual = lnCantidad + lnCantCuerfac   
		ENDIF
		
		
		
		SELECT Csrprodfzavta
		* 1.- busco por unificacion si thisform.loObjBonifica.idcabeunifica#0
		* 2.- busco por producto si thisform.loObjBonifica.idcabeunifica=0
		WITH thisform
			DO CASE 
				CASE .loObjBonifica.idcabeunifica#0
					SET ORDER TO tag idcabuni
			        =SEEK(lnidcabeunifica,"Csrprodfzavta","idcabuni")
			        DO WHILE !EOF() AND Csrprodfzavta.idcabeunifica=lnidcabeunifica
			        	* si existe promocion por cantidad
					   	IF TTOD(feccabepromo) >= TTOD(CsrAuxCabefac.fecha) AND Csrprodfzavta.idprodpromo#0
							lnctos		= INT(lncantactual / Csrprodfzavta.cada)
						   	lnentrega   = Csrprodfzavta.entrega * lnctos
						   	SELECT CsrAuxCuerfac
						   	LOCATE FOR idarticulo = CsrProdfzavta.id AND espromocion = 1
						   	IF idarticulo = CsrProdfzavta.id AND espromocion = 1 AND lnEntrega#0
								replace cantidad with lnEntrega   
							ELSE 
								IF lnEntrega=0
									DELETE FOR idarticulo = CsrProdfzavta.id IN CsrAuxCuerVari	
									DELETE IN CsrAuxCuerfac
									SKIP IN csrauxcuerfac
									IF EOF()
									   thisform.agregarcuerfac()	     	 	
									ENDIF
								ENDIF 
						   	ENDIF 	
					   	ENDIF 
						SELECT Csrprodfzavta
			  	       	SKIP 
					ENDDO
		
				OTHERWISE
			        * si existe promocion por cantidad
					SET ORDER TO tag id
					=SEEK(thisform.loObjBonifica.idproducto,"Csrprodfzavta","id")
					
					IF FOUND() AND TTOD(feccabepromo) >= TTOD(CsrAuxCabefac.fecha) AND Csrprodfzavta.idprodpromo#0
						lnctos		= INT(lncantactual / Csrprodfzavta.cada)
						lnentrega   = Csrprodfzavta.entrega * lnctos
						SELECT CsrAuxCuerfac
						LOCATE FOR idarticulo = CsrProdfzavta.id AND espromocion = 1
						IF idarticulo = CsrProdfzavta.id AND espromocion = 1 AND lnEntrega#0
							replace cantidad WITH lnEntrega IN CsrAuxCuerfac
							= this.existencpromocion()
						ELSE 
							IF lnEntrega=0
								DELETE FOR idarticulo = CsrProdfzavta.id IN CsrAuxCuerVari	
								DELETE IN CsrAuxCuerfac 
								SKIP IN csrauxcuerfac
								IF EOF()
								   thisform.agregarcuerfac()	     	 	
								ENDIF
							ENDIF 
						ENDIF 	
					ENDIF 
					
			ENDCASE
		ENDWITH 
		
		
			 
		SELECT CsrAuxCuerFac
		GO lnrecno 
		
	ENDPROC

	PROCEDURE copiarcomprobante
		SET SAFETY off
		CURSORSETPROP("Buffering",3,'Csrprodfzavta')
		SELECT Csrprodfzavta
		INDEX on id TAG id 
		INDEX on idcabeunifica TAG idcabuni
		SET SAFETY ON
		CURSORSETPROP("Buffering",5,'Csrprodfzavta')
		with thisform
			SET SAFETY OFF 
			SELECT CsrCompAsociado 
			ZAP 
			APPEND BLANK
			SET SAFETY ON 
			
			replace letra WITH LEFT(CsrAuxMaopera.numcomp,1),talonario WITH ((SUBSTR(CsrAuxMaopera.numcomp,2,4)));
				,numero WITH ((RIGHT(CsrAuxMaopera.numcomp,8)));
				,fecha WITH CsrAuxCabefac.fecha,clasecomp WITH CsrAuxMaopera.clasecomp
				
			SELECT csrcomprobante
			*op()
			REPLACE fechasis WITH thisform.fechafactura,idcomproba WITH csrcomprobante.id;
			,nrocaja WITH thisform.cajafacturacion,iddetanrocaja WITH thisform.lnidnrocaja;
			,estado WITH '0',origen WITH 'FAC',programa WITH this.Name in CsrAuxMaopera
			
			replace fecha WITH thisform.fechafactura,idtiponcredito WITH 0 IN csrauxcabefac
			
			*eplace vencimien WITH thisform.fechafactura IN csrauxcabefac
			
			replace idmaopera WITH 0,infocae WITH 0,hojaactual WITH 0, hojatotal WITH 0 IN CsrAuxcabefac
			replace cae WITH "",caetipo WITH "",talonario WITH 0,idtipocbte WITH 0 IN CsrAuxcabefac
			
			replace ALL IDMAopera WITH 0,idcabeza WITH 0,hojaactual WITH 0 IN CsrAuxCuerfac
			replace ALL idmaopera WITH 0 IN CsrauxCuerVari 
			
			.LockScreen=.t.
			.copiandocomprobante=.t.
			.ponerpantallamodoedicion		
			.cmdborrar.Visible = .f.    
		    	.cmdimprimir.visible= .f.
			.containerencabeza.Enabled= .T.
			.lnkeycode=13
		    	.Hayescape = .f.
		    	.PERmitemultilineas = .T.
			.consultandocomprobante=.f.
			.accion='A'		    
			.ContainerEnCabeza._txtparada.Value = 3
			.Containerencabeza._cbocomprobante.refresh()
			.refresh()
		
			.LockScreen=.f.
			ThisForm.Containerencabeza.KitbuscaoaltaenCtacte.Txtexiste1.SetFocus()
			thisForm.Containerencabeza.KitbuscaoaltaenCtacte.Txtexiste1.LostFocus()
			
			thisform.ultimocontainer     = "THISFORM.GRID2" 
		ENDwith
		RETURN .t.
	ENDPROC

	PROCEDURE crearcursor		&& Crea los cursores iniciales, se usa en el load del formulario
		SET SAFETY OFF 
		* uso el sele para crear el cursor porque necesito agregar campos que no hay
		SELECT CsrCabefac.*,CAST(0 as n(12,0)) as idctavta1,00000000.00 as ivari1,000000000.00 as Basegra1,000.00 as tasa1;
			   ,CAST(0 as int) as idctavta2,00000000.00 as ivari2,000000000.00 as Basegra2,000.00 as tasa2;
			   ,CAST(0 as int) as idctavta3,00000000.00 as ivari3,000000000.00 as Basegra3,000.00 as tasa3;
			   ,CAST(0 as int) as idctavta4,00000000.00 as ivari4,000000000.00 as Basegra4,000.00 as tasa4;
			   ,CAST(0 as int) as idctavta5,00000000.00 as ivari5,000000000.00 as Basegra5,000.00 as tasa5;
			   ,SPACE(10) as nomrete1,00000000.00 as retencion1,000000000.00 as Baserete1,000.00 as tasarete1;
		   	   ,SPACE(10) as nomrete2,00000000.00 as retencion2,000000000.00 as Baserete2,000.00 as tasarete2;
			   ,SPACE(10) as nomrete3,00000000.00 as retencion3,000000000.00 as Baserete3,000.00 as tasarete3;
		   	   ,SPACE(10) as nomrete4,00000000.00 as retencion4,000000000.00 as Baserete4,000.00 as tasarete4;
		   	   ,SPACE(10) as nomrete5,00000000.00 as retencion5,000000000.00 as Baserete5,000.00 as tasarete5;
		   	   ,00000000.00 as BaseInterno,000000000.00 as BaseDescto,00000000.00 as BaseGra,00000000.00 as BaseIva;
		   	   ,00000000.00 as BaseNocatego,00000000.00 as Perceibto1,00000000.00 as Perceibto2,00000000.00 as SubtotSiva;
		   	   ,000000000.00 as Baseexe,00000000.00 as BaseDesctoSiva,SPACE(20) as NomProvincia,00 as copiatkt,SPACE(3) as subnumero;
		       ,SPACE(25) as subcnombre,0000000000 as idprefijo,00000000.00 as SubtotCiva,SPACE(40) as detalle,0000 as parada;
		       ,SPACE(13) as proximonro,DATETIME(YEAR(DATE()),MONTH(DATE()),DAY(DATE()),0,0,0) as Vencimien;
		       ,CAST(0 as int) as Cuota,SPACE(40) as detaref, 0 as ComprometeMerc, 0 as rendicaja, 0 as esremito,CAST(0 as n(11,2)) as saldocta;
		       ,SPACE(30) as datosfactura,SPACE(30) as detacobranza;
		       ,00 as PlanCuota, 00 as PlanRango, 0 as HayPlan;
		       ,SPACE(20) as detapiecuota01, SPACE(20) as detapiecuota02, SPACE(20) as detapiecuota03,SPACE(20) as detapiecuota04;
		       ,SPACE(20) as detapiecuota05, SPACE(20) as detapiecuota06, SPACE(20) as detapiecuota07,SPACE(20) as detapiecuota08;
		       ,SPACE(20) as detapiecuota09;
		       ,00 as ProvReba,0 as SolicitaDNI,SPACE(2) as TipoCbte, SPACE(50) as CAECheck;
		       ,CAST(0 as numeric(1,0)) as ctalogistica,SPACE(20) as proximonro_rto;
		       ,SPACE(15) as nrocomplic,SPACE(30) as canalvta,SPACE(50) as filePrint,SPACE(50) as transporte;
		       ,SPACE(2) as categoiva,SPACE(13) as nroasociado,DATE() as fechaaso,SPACE(3) as compaso;
		       ,0 as solograbar,CAST(0 as n(16,2)) as PerceIVA5329;
		       FROM CsrCabefac WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxcabefac READWRITE  
		
		CREATE CURSOR CsrCompAsociado (letra c(1),talonario c(5),numero c(8),fecha d, clasecomp c(1))
		
		* datos de la operacion, fecha,terminal,vendedor, etc.
		SELECT Csrmaopera.*,CAST(0 as n(12,0)) as idvdorplan,CAST(0 as int) as iddeposito,00000000 AS nrocaja,SPACE(6) as pefiscal,CAST(0 as int) as idmotanula;
			   ,SPACE(20) as NomOpera,SPACE(2) as clasetipo,SPACE(10) as statusform ;
			   FROM Csrmaopera WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxMaopera READWRITE 
		
		* CsrAuxCuerfac				usado en grid1 para mostrar los productos seleccionados
		SELECT CsrCuerfac.*,0000000.00 as stock,0000000.00 as total,CAST(0 as n(12,0)) as idcuerfac,0000000.000 as desctoCiva;
				,0000000.000 as DesctoSiva,CAST(0 as n(12,0)) as registro,CAST(0 as int) as idfuerzavta,' ' as alcohol;
				,' ' as codvalido,CAST(0 as n(12,0)) as idcabeunifica,CAST(0 as int) as idprodpromo;
				,CAST(0 as int) as idprodregalo,000000 as cada,000000 as entrega,0 as nofactura,00000000.000 as InternoFin;
			   	,CAST(0 as int) as idctavta,00000000.000 as UniCiva,00000000.000 as UniSiva,00000000.000 as IvaUni;
			   	,00000000.000 as UniCiva2,00000000.000 as UniSiva2,00000000.000 as IvaUni2,CAST(0 as int) as idenvase;
			   	,CAST(0 as int) as idprodgenera,0000 as hojaactual,0 as bondigitada, 0000000.000 as cantkilos;
			   	, 00000000.000 as cantorig, 0 as comprome,CAST(0 as int) as idoriginal, 000000 as orden;
			   	,SPACE(10+6) as clavepedido,0 as omitirlistas,SPACE(14) as codextend;
			   	,CAST(0 as numeric(12)) as idmovlicita,CAST(0 as numeric(12)) as idmaopelicita;
			   	,SPACE(30) as nombre02,DATE() as fechaultprecio,0 as cfexentoiva;
			   	,kilos as peso,nombre as nomcomandera,SPACE(15) as codArtProd, kilos as PesoProd ;
			   	,0 as nobonificar, 1 as infstock;
		     FROM CsrCuerfac WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxCuerfac READWRITE 
		
		SELECT Csrauxcuerfac
		INDEX on orden TAG orden
		INDEX on hojaactual TAG hoja
		INDEX on clavepedido TAG kclave
		SET ORDER TO orden       
		
		* CsrAuxCuerPromo, genera un registro con la promocion, si todo OK muevo al CsrAuxCuerfac
		SELECT CsrCuerfac.*,0000000.00 as stock,0000000.00 as total,CAST(0 as n(12,0)) as idcuerfac,0000000.000 as desctoCiva,0000000.000 as DesctoSiva;
		       ,CAST(0 as n(12,0)) as registro,CAST(0 as int) as idfuerzavta,' ' as alcohol,' ' as codvalido,CAST(0 as n(12,0)) as idcabeunifica;
			   ,CAST(0 as int) as idprodpromo,CAST(0 as int) as idprodregalo,000000 as cada,000000 as entrega,00000000.000 as InternoFin;
			   ,0 as nofactura,CAST(0 as int) as idctavta,00000000.000 as UniCiva,00000000.000 as UniSiva,00000000.000 as IvaUni;
			   ,00000000.000 as UniCiva2,00000000.000 as UniSiva2,00000000.000 as IvaUni2,CAST(0 as int) as idenvase,CAST(0 as int) as idprodgenera;
			   ,SPACE(14) as codextend, 0000000.000 as cantkilos;
		     FROM CsrCuerfac WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxCuerPromo READWRITE 
		
		* CsrAuxCuerPromo, genera un registro con la promocion, si todo OK muevo al CsrAuxCuerfac
		SELECT CsrCuerfac.*,0000000.00 as stock,0000000.00 as total,CAST(0 as n(12,0)) as idcuerfac,0000000.000 as desctoCiva,0000000.000 as DesctoSiva;
		       ,CAST(0 as n(12,0)) as registro,CAST(0 as int) as idfuerzavta,' ' as alcohol,' ' as codvalido,CAST(0 as n(12,0)) as idcabeunifica;
			   ,CAST(0 as int) as idprodpromo,CAST(0 as int) as idprodregalo,000000 as cada,000000 as entrega,00000000.000 as InternoFin;
			   ,0 as nofactura,CAST(0 as int) as idctavta,00000000.000 as UniCiva,00000000.000 as UniSiva,00000000.000 as IvaUni;
			   ,00000000.000 as UniCiva2,00000000.000 as UniSiva2,00000000.000 as IvaUni2,CAST(0 as int) as idenvase,CAST(0 as int) as idprodgenera;
		       ,CAST(0 as n(10,0)) as idsubprod,CAST(0 as n(10,0)) as idvariedad;
		       ,SPACE(14) as codextend, 0000000.000 as cantkilos;
		     FROM CsrCuerfac WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxCuerCombo READWRITE 
		     
		* CsrAuxCuervari, variedad del producto
		SELECT CsrCuervari.*,SPACE(20) as nombre ,0 as comprome ,CAST(0 as n(12,0)) as registro FROM CsrCuervari WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxCuervari READWRITE 
		SELECT CsrAuxCuervari
		INDEX on idarticulo TAG idarticulo
		
		* usado para mostrar comprobantes afectados
		CREATE CURSOR CsrAuxMovAfectado (id n(12,0),fecha d,detalle c(40),vence d,importe n(11,2),saldo n(11,2),saldori n(11,2),afecta n(12,2)) 
		
		* para actualizar existencia
		SELECT CsrExistenc.* FROM CsrExistenc WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxExistenc READWRITE 
		SELECT CsrAuxExistenc
		INDEX on STRID(idarticulo,10)+STRID(idsubarti,10)+STRID(iddeposito,10) TAG articulo
		
		*para actualizar datos del pedido
		SELECT CsrPediPda.*,CAST(0 as int) as idmotivo,CAST(0 as int) as idvendedor ;
		FROM CsrPediPda WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxPediPda READWRITE 
		
		
		Create CURSOR CsrimpCab (grupo c(5),Campo001 c(30),Campo002 c(10),Campo003 c(30),Campo004 c(10),Campo005 c(6);
			  				,Campo006 c(40),Campo007 c(40),Campo008 c(40),Campo009 c(30),Campo010 c(13);
							,Campo011 c(50),Campo012 c(50),Campo013 c(50),Campo014 c(50),Campo015 c(50);
							,Campo016 c(13),Campo017 c(13),Campo018 c(13),Campo019 c(30),Campo020 c(30);
							,Campo021 c(30),Campo022 c(30),Campo023 c(30),Campo024 c(30),Campo025 c(30);
							,Campo026 c(30),Campo027 c(30),Campo028 c(30),Campo029 c(13),Campo030 c(13);
							,Campo031 c(13),Campo032 c(13),Campo033 c(13),Campo034 c(13),Campo035 c(13);
							,Campo036 c(13),Campo037 c(20),Campo038 c(20),Campo039 c(100),Campo040 c(100))
		SELECT CsrImpCab
		INDEX on grupo TAG grupo
			  				
		Create CURSOR CsrimpCue (grupo c(5),Campo001 c(10),Campo002 c(10),Campo003 c(50),Campo004 c(10),Campo005 c(13);
							,Campo006 c(8),Campo007 c(13),Campo008 c(13),Campo009 c(1),campo010 c(10), escambio n(1);
							,Campo011 c(8))
		
		SELECT CsrimpCue
		INDEX on grupo TAG grupo
		
		SELECT numero,nombre FROM CsrListaPrecio WHERE LEFT(switch,2) like '_0' INTO CURSOR CsrLista
		INDEX on numero TAG kid
		
		SET SAFETY ON 
		
		
	ENDPROC

	PROCEDURE defragmentarpedido
		
		&&EL grabar toma ahora el numcomp del csrauxcabefac.proximonro y no de this.proximonro
		&&Si no continua el proceso, que genera nuevos cabefac. ya debemos almacenar el valor
		SELECT CsrAuxCabefac
		SCATTER NAME OscCabefac
		OscCabefac.proximonro = this.proximonro 
		GATHER NAME OscCabefac
		
		IF NOT This.objseteoparam.FacPedido_Frio
			RETURN 
		ENDIF 
		
		&&Controlamos los cuerpos.
		&&Si existen condiciones para separarlo.
		&&Se generan nuevos cabefac.
		&&Y se retotalizan
		
		IF !CsrComprobante.clase$'I'		 
			RETURN 
		ENDIF 
		
		SET SAFETY OFF 
		SELECT CsrAuxCabefac
		GO TOP 
		SCATTER NAME OscCabefac
		ZAP
		
		SET SAFETY OFF 
		
		nIdTipoFrioNormal = 0
		SELECT CsrParaVario
		LOCATE FOR nombre='TIPOFRIONORMAL'
		IF nombre='TIPOFRIONORMAL'
			nIdTipoFrioNormal = CsrParaVario.idorigen
		ENDIF 
		
		SELECT distinct idfrio FROM CsrAuxCuerfac WHERE idfrio <> 0 ORDER BY idfrio INTO CURSOR CsrCabeFrio READWRITE 
		
		SELECT CsrCabeFrio 
		GO TOP 
		
		
		&&EL grabar toma ahora el numcomp del csrauxcabefac.proximonro y no de this.proximonro
		&&debemos almacenar el valor del pedido normal el mostrado en pantalla
		SELECT CsrAuxCabefac
		OscCabefac.idfrio = CsrCabeFrio.idfrio
		OscCabefac.proximonro = this.proximonro
		APPEND BLANK IN CsrAuxCabefac
		GATHER NAME OscCabefac
			
		
		SELECT CsrCabeFrio 
		SKIP 
		DO WHILE NOT EOF()
		
			thisform.leerproximonro(Csrcomprobante.id,.t.) 
			OscCabefac.proximonro = this.proximonro
			OscCabefac.idfrio = CsrCabeFrio.idfrio
			APPEND BLANK IN CsrAuxCabefac
			SELECT CsrAuxCabefac
			GATHER NAME OscCabefac
			
			SELECT CsrCabeFrio
			SKIP 
		ENDDO 
		
		nIdUltFrio  = 0
		SELECT CsrAuxCuerfac
		GO TOP 
		SCAN 	
			SCATTER NAME Oscatter
			IF Oscatter.idfrio = 0
				Oscatter.idfrio  = nIdUltFrio
			ENDIF 
			&&Si el frio es 0 o es el definido como normal los agrupamos todos en normal.
			&&Sino hubiera un pedido para 0 y otro normal
			IF nIdTipoFrioNormal = Oscatter.idfrio OR Oscatter.idfrio = 0
				Oscatter.idfrio  = nIdTipoFrioNormal
			ENDIF 
		
			GATHER NAME Oscatter
			nIdUltFrio = Oscatter.idfrio
			
		ENDSCAN 
		
		thisform.totalporhoja(.t.)
		
		SELECT CsrAuxCabefac
		*vista()
		SELECT CsrAuxCuerfac
		*vista()
	ENDPROC

	PROCEDURE determinarlistaprecio
		LPARAMETERS lnpreunita,lnpreunitasiva,lnprearti,lnpreartisiva,lbOmitirListas
		
		LOCAL lcCalias
		
		lcAlias = ALIAS()
		
		
		
		LOCAL nBonif
		nBonif = 0
		*!*	nListaPrecio = CsrAuxCabefac.listaprecio
		*!*	IF !STR(CsrAuxCabefac.listaprecio,1)$'1,2,3,4'
		*!*		lListaDefecto = .t.
		*!*		SELECT CsrListaPrecio
		*!*		LOCATE FOR numero = CsrAuxCabefac.listaprecio
		*!*		IF FOUND() AND RIGHT(LEFT(CsrListaPrecio.switch,2),1)!='2'
		*!*			&&El recargo es negativo, pero para incremetar debe ser positivo
		*!*			*nBonif = CsrListaPrecio.bonif*(-1)
		*!*			&&29/04/15 Se puede omitir el recargo/bonif de la lista 
		*!*			nBonif = IIF(lbOmitirListas=0,CsrListaPrecio.bonif*(-1) ,0)
		*!*			nIdListaAso = CsrListaPrecio.idlistaAso
		*!*			SELECT CsrListaPrecio
		*!*			LOCATE FOR id = nIdListaAso
		*!*			IF id = nIdListaAso
		*!*				lListaDefecto = .f.
		*!*				nListaPrecio = CsrListaPrecio.numero
		*!*				IF !STR(CsrListaPrecio.numero,1)$'1,2,3,4'
		*!*					lListaDefecto = .f.
		*!*				ENDIF 
		*!*			ENDIF 
		*!*		ENDIF 
		*!*		
		*!*		IF lListaDefecto
		*!*			replace listaprecio WITH this.listadefecto IN CsrAuxCabefac
		*!*			nBonif =0&&No calcula incremento.
		*!*			nListaPrecio = CsrAuxCabefac.listaprecio
		*!*		ENDIF 
		*!*	ENDIF 
		
		*!*	DO CASE 
		*!*	CASE nListaPrecio=1			
			lnpreunita     = lObjprecio.prevtaciva1   && CsrProducto.prevtaf1
			lnpreunitasiva = lObjprecio.prevta1       && CsrProducto.prevta1
		*!*	CASE nListaPrecio=2			
		*!*		lnpreunita     = lObjprecio.prevtaciva2   && CsrProducto.prevtaf2
		*!*		lnpreunitasiva = lObjprecio.prevta2       && CsrProducto.prevta2
		*!*	CASE nListaPrecio=3			
		*!*		lnpreunita     = lObjprecio.prevtaciva3    && CsrProducto.prevtaf3
		*!*		lnpreunitasiva = lObjprecio.prevta3       && CsrProducto.prevta3
		*!*	CASE nListaPrecio=4			
		*!*		lnpreunita     = lObjprecio.prevtaciva4   && CsrProducto.prevtaf4
		*!*		lnpreunitasiva = lObjprecio.prevta4       && CsrProducto.prevta4
		*!*	ENDCASE
		lnprearti		= ROUND(lnpreunita,2)
		lnpreartisiva	= ROUND(lnpreunitasiva,2)
		lnpreunita		= ROUND(lnpreunita *(1 + nBonif / 100),2)
		lnpreunitasiva	= ROUND(lnpreunitasiva * (1 + nBonif / 100),2)
			
		SELECT(lcAlias)	
		RETURN
		
	ENDPROC

	PROCEDURE editarproducto
		&&Permitimos modificar la descripcion del articulo.
		&&En el nombre02 guardamos la modificada.
		&&Si esta no esta vacia la reemplazamos.
		&&Si esta vacia, llamamos al pidodescripcion
		
		SELECT Csrprodfzavta
		LOCATE FOR id = CsrAuxCuerfac.idarticulo
		IF id = CsrAuxCuerfac.idarticulo
			IF SUBSTR(Csrprodfzavta.SwitchRubro,4,1)='1' &&Edita Nombre
				IF LEN(LTRIM(CsrAuxCuerfac.nombre02	)) = 0
					PUBLIC loObjeto 
					
					loObjeto = CREATEOBJECT("Custom")
					loObjeto.AddProperty('detalle',CsrAuxCuerfac.nombre)
					
					DO FORM pidodescripcion WITH loObjeto name LobjForm linked
					IF VARTYPE(lobjForm)='O'
						loObjeto.detalle = lObjForm.detalle
						RELEASE loObjForm
					ENDIF 
					IF LEN(LTRIM(loObjeto.detalle))!=0
						replace nombre02 WITH loObjeto.detalle IN CsrAuxCuerfac
					ELSE
						replace nombre02 WITH nombre IN CsrAuxCuerfac
					ENDIF 
					RELEASE loObjeto
				ENDIF 
				
				IF LEN(LTRIM(CsrAuxCuerfac.nombre02	)) != 0
					replace nombre WITH nombre02 IN CsrAuxCuerfac
				ENDIF 
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE elijopatron
		*!*	LOCAL lopatron,lccaja
		*!*	DO FORM frmelijopatron NAME oform LINKED TO lopatron
		*!*	IF TYPE('lopatron')='O'
		*!*	   lccaja=STRzero(YEAR(lopatron.fecha),4)+STRzero(MONTH(lopatron.fecha),2)+STRzero(DAY(lopatron.fecha),2)
		*!*	   REPLACE FECHA WITH lopatron.fecha,idfletero WITH lopatron.idfletero in CsrAuxcabefac
		*!*	   REPLACE fechasis WITH lopatron.fecha,iddetanrocaja WITH lopatron.iddetanrocaja,nrocaja WITH VAL(lccaja) IN CsrAuxMaopera      
		*!*	   thisform.LockScreen=.t.
		*!*	   thisform.containerencabeza.Refresh
		*!*	   thisform.LockScreen=.f.
		*!*	ELSE
		*!*	     =Oavisar.usuario("No seleccionó un patrón, el sistema queda funcionando en modo facturacion y NO descarga",0)
		*!*	     thisform.tipoform="F"
		*!*	endif
	ENDPROC

	PROCEDURE enviocorreo
		*!*	LPARAMETERS cFileName
		
		*!*	IF FILE(cFileName)
		*!*		cEmail	= ""
		*!*		IF USED('CsrCtacte')
		*!*			cEmail =  IIF(TYPE('CsrCtacte.email')='C',CsrCtacte.email,cEmail)
		*!*		ENDIF 
		*!*		cAsunto = Goapp.empresanombre
		*!*		cCuerpo = "Estimado"+CHR(13)+"Le acercamos el comprobante"
