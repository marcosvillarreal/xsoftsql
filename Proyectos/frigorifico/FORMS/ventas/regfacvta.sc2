	ADD OBJECT 'prodfzavta' AS cursoradapter WITH ;
		Alias = "Csrprodfzavta", ;
		CursorSchema = <fb2p_value>ID I, IDFUERZAVTA I, IDCABEPROMO I, IDPRODPROMO I, IDPRODREGALO I, CADA I, ENTREGA I, FECCABEPROMO T, IDCUERPROMO I, CANDESDE I, CANHASTA I, BONCUERPROMO N(9, 3), FECCUERPROMO T, IDBONIVDOR I, IDVENDEDOR I, BONVDOR N(8, 3), DIASVISITA C(7), DIASFACTURA C(7), IDCUERUNIFICA I, IDCABEUNIFICA I</fb2p_value>, ;
		Flags = 0, ;
		Height = 65, ;
		KeyFieldList = , ;
		Left = 272, ;
		Name = "prodfzavta", ;
		SelectCmd = <fb2p_value>
SELECT Csrprodfzavta.id,ISNULL(Csrrubro.idfuerzavta,0) as idfuerzavta,ISNULL(Csrcabepromo.id,0) as idcabepromo,ISNULL(Csrcabepromo.idprodpromo,0) as idprodpromo,ISNULL(Csrcabepromo.idprodregalo,0) as idprodregalo
,ISNULL(Csrcabepromo.cada,0) as cada,ISNULL(Csrcabepromo.entrega,0) as entrega,Csrcabepromo.fechasta as fecCabepromo
,ISNULL(Csrcuerpromo.id,0) as idcuerpromo,ISNULL(Csrcuerpromo.candesde,0) as candesde,ISNULL(Csrcuerpromo.canhasta,0) as canhasta
,ISNULL(Csrcuerpromo.bonifica,0) as bonCuerpromo,Csrcuerpromo.fechasta as fecCuerpromo,ISNULL(CsrBonivdor.id,0) as idBonivdor,ISNULL(CsrBonivdor.idvendedor,0) as idvendedor
,ISNULL(Csrbonivdor.bonifica,0) as bonVdor,ISNULL(Csrbonivdor.diasvisita,'') as Diasvisita,ISNULL(Csrbonivdor.diasfactura,'') as diasfactura
,ISNULL(Csrcuerunifica.id,0) as idcuerunifica,ISNULL(Csrcuerunifica.idcabeunifica,0) as idcabeunifica
 FROM producto as Csrprodfzavta
left join rubro as Csrrubro on Csrprodfzavta.idrubro = Csrrubro.id left join cabepromo as Csrcabepromo on Csrprodfzavta.id = Csrcabepromo.idprodgenera
left join cuerpromo as Csrcuerpromo on CsrCabepromo.id = Csrcuerpromo.idcabepromo
left join bonivdor as Csrbonivdor on Csrprodfzavta.id = Csrbonivdor.idproducto
left join cuerunifica as Csrcuerunifica on Csrprodfzavta.id = Csrcuerunifica.idproducto
where Csrprodfzavta.id < -1
</fb2p_value>, ;
		Tables = producto,rubro,cabepromo,cuerpromo,bonivdor,cuerunifica, ;
		Top = 528, ;
		UpdatableFieldList = , ;
		UpdateNameList = , ;
		UseDeDataSource = .T., ;
		Width = 113
		*< END OBJECT: BaseClass="cursoradapter" />

