	PROCEDURE Grid2.Column5.Text1.InteractiveChange
		WITH thisform 
			.lcsetfocus            = "THISFORM.GRID2.COLUMN10.TEXT1"
			.lcgotfocus            = "THISFORM.GRID2.COLUMN5.TEXT1"
		ENDWITH 	
		
	ENDPROC

	PROCEDURE Grid2.Column5.Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode=13 OR nKeyCode=9
			WITH thisform 
				.lcsetfocus = "THISFORM.GRID2.COLUMN6.TEXT1"
				.lcgotfocus = "THISFORM.GRID2.COLUMN5.TEXT1"
			ENDWITH 	
		ENDIF 	
	ENDPROC

	PROCEDURE Grid2.Column5.Text1.LostFocus
		
		IF thisform.consultandocomprobante AND !thisform.lhayvariedad
			thisform.grid2_procesolinea(1)
			RETURN .t.
		ENDIF
		
		WITH thisform
			IF .lhayvariedad AND !.lpidocantidad   &&this.Value = 0
				.grid2.column6.text1.SetFocus()	
			ELSE 
				IF CsrAuxCuerfac.pesable=0	
					IF !.grid2_lostfocuscant()
					   .grid2.column1.text1.SetFocus()	
					ENDIF 
				ELSE
					.lcsetfocus            = ""
					.lcgotfocus            = "THISFORM.GRID2.COLUMN5.TEXT1"		
					.bloqueocodigo = .t.	
				ENDIF 
			ENDIF					
		ENDWITH 
	ENDPROC

	PROCEDURE Grid2.Column5.Text1.Valid
		IF strzero(thisform.lnkeycode,3)$"003-005-018-024" 
			RETURN .f.
		ELSE
			IF this.value=0
			   this.ForeColor=RGB(255,0,0)
			ELSE
				IF CsrAuxCuerfac.escambio = 0
			   		this.ForeColor=RGB(0,0,0)
			   		IF this.Value > 999999
			   			this.Value = 0
			   			oavisar.usuario('Valore invalido, maximo permitido 999,999.99')
			   		ENDIF 
				ELSE
					this.ForeColor=RGB(0,255,0)	
				ENDIF    		
			endif
			RETURN .t.
		ENDIF 
	ENDPROC

	PROCEDURE Grid2.Column5.Text1.When
		cleartec()
		SELECT CsrSubproducto
		
		WITH thisform
			
			IF (CsrAuxCuerfac.idarticulo=0) 
		*		thisform.LockScreen	 = .t. 
				RETURN .f.
			ENDIF 
			
			IF thisform.consultandocomprobante AND !thisform.lhayvariedad
				KEYBOARD '{DNARROW}'
				RETURN .f.
			ENDIF 
		*	thisform.LockScreen	 = .f.  
		ENDWITH 
	ENDPROC

	PROCEDURE Grid2.Column6.Text1.GotFocus
		IF !thisform.lpidodescto AND !thisform.lpidodescuento
			this.LostFocus()
		ENDIF 
		
		
	ENDPROC

	PROCEDURE Grid2.Column6.Text1.InteractiveChange
		lcSetfocus = ""
		WITH thisform 
			.lcgotfocus            = "THISFORM.GRID2.COLUMN06.TEXT1"
		ENDWITH 	
	ENDPROC

	PROCEDURE Grid2.Column6.Text1.LostFocus
		thisform.grid2_lostfocusdto()
		
	ENDPROC

	PROCEDURE Grid2.Column6.Text1.Valid
		IF strzero(thisform.lnkeycode,3)$"003-005-018-024" 
			RETURN .f.
		ELSE
			RETURN .t. 
		ENDIF 
	ENDPROC

	PROCEDURE Grid2.Column6.Text1.When
		IF thisform.consultandocomprobante
			RETURN .f.
		ENDIF 
	ENDPROC

	PROCEDURE Grid2.Column7.Text1.When
		RETURN .f.
	ENDPROC

	PROCEDURE Grid2.Column9.Text1.When
		RETURN .f.
	ENDPROC

	PROCEDURE Grid2.Init
		DODEFAULT()
		*!*	DODEFAULT()
		*!*	if this.columncount>1
		*!*	*!*		TEXT TO lcBackColor TEXTMERGE NOSHOW 
		*!*	*!*		iif(csrauxcuerfac.escambio=0,
		*!*	*!*			IIF(csrauxcuerfac.cantidad=0 .and. csrauxcuerfac.idarticulo<>0,
		*!*	*!*				RGB(254,254,234),
		*!*	*!*				IIF(CsrAuxCuerfac.escombo=1,RGB(23,23,255),RGB(222,229,235)),
		*!*	*!*			RGB(254,230,218)))
		*!*	*!*		ENDTEXT 
		*!*	*!*		THIS.Setall("DynamicBackColor",;
		*!*	*!*			"iif(csrauxcuerfac.escambio=0,"+;
		*!*	*!*			"	IIF(csrauxcuerfac.cantidad=0 .and. csrauxcuerfac.idarticulo<>0,"+;
		*!*	*!*			"		RGB(254,254,234),"+;
		*!*	*!*			"		IIF(CsrAuxCuerfac.escombo=1"+;
		*!*	*!*			"			,RGB(0,128,255)
		*!*	*!*			"			,IIF("+lcFechaPrecio+"< DATE()"+;
		*!*	*!*			"				,RGB(128,255,128)"+;
		*!*	*!*			"				,RGB(222,229,235)"+;
		*!*	*!*			"			))"+;
		*!*	*!*			"	)"+;
		*!*	*!*			"	,RGB(254,230,218))";
		*!*	*!*			,"Column")
		*!*		THIS.Setall("DynamicForeColor",;
		*!*			"IIF(CsrAuxCuerfac.escombo=1,RGB(255,255,255),RGB(0,0,0))";
		*!*			,"Column")
		*!*	endif
	ENDPROC

	PROCEDURE KitbuscarProd.f_lostfocussay
		
		LOCAL lok,lnpreunita,lndecimaluni,lndecimaltot,lnuniventa,lObjProducto
		
		lndecimaluni = thisform.ndecimaluni
		lndecimaltot = thisform.ndecimaltot
		*lnuniventa   = IIF(CsrAuxCuerfac.univenta=0,Csrproducto.idtipovta,CsrAuxCuerfac.univenta)
		
		lnuniventa   = CsrProducto.idtipovta
		&&Se factura por defecto bulto, si es factura/r.salida
		IF thisform.vtabulto AND CsrComprobante.clase$'AX'
			lnuniventa = 2
		ENDIF 
		
		lnuniventa   = IIF(CsrAuxCuerfac.univenta=0,lnuniventa,CsrAuxCuerfac.univenta)
		
		REPLACE idarticulo WITH Csrproducto.id,codigo WITH LTRIM(STR(Csrproducto.numero)),nombre WITH Csrproducto.nombre;
		,univenta WITH lnuniventa,idctavta WITH 0,unibulto WITH Csrproducto.unibulto,peso WITH CsrProducto.peso;
		,idfuerzavta WITH Csrproducto.idfuerzavta,alcohol WITH IIF(NOT thisform.controlar_reba,'0',CsrProducto.alcohol),kilos WITH Csrproducto.peso,volumen WITH Csrproducto.volumen;
		,perceibruto WITH Csrproducto.perceibruto,nofactura WITH Csrproducto.nofactura,idenvase WITH Csrproducto.idenvase;
		,pesable WITH CsrProducto.vtakilos, idfrio WITH CsrProducto.idfrio,idoriginal WITH Csrproducto.id;
		,espromocion WITH CsrProducto.espromocion,cfexentoiva WITH CsrProducto.cfexentoiva IN CsrAuxCuerfac
		
		replace codArtProd WITH ALLTRIM(CsrProducto.codArtProd),pesoprod WITH CsrProducto.peso IN CsrAuxCuerfac
		replace nobonificar WITH NVL(CsrProducto.nobonificar,0) IN CsrAuxCuerfac
		replace infstock WITH NVL(CsrProducto.infstock,1) IN CsrauxCuerfac
		
		IF thisform.activoperceiva5329
			replace perceiva5329  WITH CsrProducto.perceiva5329 IN CsrAuxCuerfac
			replace perceiva5329  WITH IIF(perceiva5329  =1 AND CsrProducto.excluido5329=1,0,perceiva5329 ) IN CsrAuxCuerfac
		ENDIF 
		
		IF CsrAuxCuerfac.idmovlicita=0	
			replace OMITIRLISTAS WITH NVL(CsrProducto.OMITIRLISTAS,0) IN CsrAuxCuerFac
		ENDIF 
		
		&&Si el modo del facturador debe validar Existencia
		&&Si es N.Credito siempre se omite.
		&&Si es la carga de una n.pediod (en algunas versiones aun se usa aca)
		IF thisform.lpidoexistenc 
			replace infstock WITH 0 IN CsrauxCuerfac
		ENDIF 
			
		IF LEN(LTRIM(CsrAuxCuerfac.codextend))=0
			REPLACE codextend WITH LTRIM(STR(Csrproducto.numero)) IN CsrAuxCuerfac
		ENDIF 
		
		IF thisform.nCantdigitada <> 0
			replace cantidad WITH thisform.nCantdigitada IN CsrAuxCuerfac
		ENDIF 
		IF LEN(LTRIM(CsrProducto.nombulto))#0
			replace nomcomandera WITH CsrProducto.nombulto IN CsrAuxCuerfac
		ENDIF 
		
		SELECT CsrAuxCuerfac
		SCATTER NAME Oscatter
		thisform.cargarperceproducto(@OScatter)
		thisform.cargarctaconproducto(@Oscatter)
		
		Oscatter.fechaultprecio = thisform.consultarultimoprecio(Oscatter.idarticulo)
		
		SELECT CsrAuxCuerfac
		GATHER NAME Oscatter
		
		IF thisform.lpidodescuento
			REPLACE bondigitada WITH 1 IN csrauxcuerfac
		ENDIF 
		
		
		IF LEN(TRIM(CsrAuxCuerfac.nombre))#0
			IF Csrproducto.id#0
				thisform.traerdatosextra(Csrproducto.id,CsrAuxcabefac.idctacte)
			ENDIF 	
				    
			lok = .f.
			*stop()
			IF (thisform.controlfactura(1) OR thisform.leyendocuerpedido) 
				SELECT CsrProducto
				SCATTER NAME lObjProducto
				
				*stop()
				
				IF thisform.idarticuloant = CsrAuxCuerfac.idarticulo
		        	*stop()
		        ENDIF 
		        
				IF thisform.alicuota0 AND NOT LTRIM(CsrComprobante.clase)$'ABCU'
					lObjProducto.tasa = 0
				ENDIF 
				
				
				&&Solo es para comprobantes fiscales
				IF LTRIM(CsrComprobante.clase)$'ABCU'
					thisform.oRegfacvta.ExentoDec567(@lObjProducto,CsrCtacte.autodec567)
				ENDIF 		
				
				thisform.precioprod1.calculaprecio(lObjProducto,@lObjprecio)
				
				
				
				*REPLACE tasaiva WITH lObjprecio.ivari,precostosiva WITH lobjprecio.costoreposicion,interno WITH lObjprecio.interno;
				*			,precosto WITH lobjprecio.costosiniva IN CsrAuxCuerfac
		
				
				LOCAL lnpreunita,lnpreunitasiva,lnprearti,lnpreartisiva
				
				IF NOT thisform.oRegfacvta.preciosnegociados(CsrAuxCuerfac.idarticulo,@lObjprecio)
					thisform.oRegFACVTA.PRECIoporlista(lObjProducto,@lObjprecio)
					thisform.determinarlistaprecio(@lnpreunita,@lnpreunitasiva,@lnprearti,@lnpreartisiva,CsrAuxCuerfac.omitirlistas)
		        ELSE
					&&Si se encuentran precios negociados,cambiamos las variables del precio
					lnpreunita     = lObjprecio.prevtaciva1   && CsrProducto.prevtaf4
					lnpreunitasiva = lObjprecio.prevta1       && CsrProducto.prevta4
					lnprearti		= ROUND(lnpreunita,2)
					lnpreartisiva	= ROUND(lnpreunitasiva,2)
		        ENDIF 
		        
		        RELEASE lobjproducto	
		        
		        &&OR thisform.codigoanterior # CsrAuxCuerfac.codigo
		       	IF thisform.idarticuloant # CsrAuxCuerfac.idarticulo  OR thisform.copiandocomprobante OR (CsrAuxCuerfac.preunita=0 AND thisform.idarticuloant = CsrAuxCuerfac.idarticulo)
		    		REPLACE preunita WITH lnpreunita,preunitasiva WITH lnpreunitasiva,prearti WITH lnprearti,preartisiva WITH lnpreartisiva,total WITH 0 IN CsrAuxCuerfac
		   		ENDIF 
		   		       		    
				IF !thisform.leyendocuerpedido
					lok = .f.   		    
					IF thisform.controlfactura(2)
						lok = .t.	
						thisform.Grid2.Refresh
					ENDIF 
				ENDIF 				
			ENDIF     
			
			IF !lok AND !thisform.leyendocuerpedido
				lok = thisform.reordeneproducto
				IF !thisform.reordeneproducto
			    	thisform.grid2_ponerlineaencero
			    ENDIF 
			    thisform.reordeneproducto= .f.
			    
				thisform.grid2.Refresh()
				* thisform.grid2.column1.text1.SetFocus()
			ENDIF
			
			lok = IIF(!thisform.verificarbloqueo() and lok,.t.,.f.)
					
		ENDIF 		
		RETURN lok
	ENDPROC

	PROCEDURE lbldatos.Init
		this.Visible = .f. &&(_vfp.startmode()#4)
		
	ENDPROC

	PROCEDURE Precioprod1.calculaprecio
		PARAMETERS lObjProducto,lobjprecio
		
		this.cflimpiarprecio()
		lobjprecio.ivari   = lObjProducto.tasa
	ENDPROC

	PROCEDURE Sendemail1.send
		IF USED('CsrCtacte')
			This.Email =  IIF(TYPE('CsrCtacte.email')='C',CsrCtacte.email,cEmail)
		ENDIF 
		ThisForm.MessageEmail = '"Estimado"+CHR(13)+"Le adjuntamos el comprobante de venta"+CHR(13)+"Atte. "+Goapp.empresanombre'
		DODEFAULT()
	ENDPROC

ENDDEFINE
