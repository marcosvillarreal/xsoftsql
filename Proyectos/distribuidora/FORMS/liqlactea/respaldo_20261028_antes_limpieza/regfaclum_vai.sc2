	PROCEDURE Grid1.Column1.Text1.GotFocus
		WITH thisform
		    .prodanterior=this.Value
		    
		    .lblayudapie.Caption = "[Esc]Retrocede a Proveedor   [ + ]Carga cuotas"
		
		    IF SUBSTR(CsrCateCtacte.switch,2,1)="1"
				.lblayudapie.Caption = "[Esc]Retrocede a Productos (Edita Precios)   [ + ]Carga cuotas" 	 
			ENDIF 
			
			.ultimocontainer     ="THISFORM.GRID1" 
			.lpidocodigoCta	 	 = .f.
			.cmdSalvar.Visible   = .t.
			
			SELECT CsrClaseCta
			LOCATE FOR id = CsrauxPlanCue.idclase
			replace idclase WITH CsrClaseCta.id IN CsrauxPlanCue
			thisform.grid1.column3.combo1.Value = CsrClaseCta.id
		  	thisform.grid1.column3.combo1.DisplayValue = CsrClaseCta.cnombre
			SELECT CsrAuxPlanCue		
