	PROCEDURE Grid2.Column13.Text1.GotFocus
		llok = .f.
		IF thisform.editarprecio
			thisform.gridvariedad_when()
			llok = .t.
		ENDIF 
		RETURN llok
	ENDPROC

	PROCEDURE Grid2.Column13.Text1.InteractiveChange
		WITH thisform 
			.lcsetfocus            = ""
			.lcgotfocus            = "THISFORM.GRID2.COLUMN12.TEXT1"
		ENDWITH 	
	ENDPROC

	PROCEDURE Grid2.Column13.Text1.LostFocus
		WITH thisform
			IF .editarprecio 
				IF .lhayvariedad AND !.lpidocantidad   
					IF CsrauxCuerfac.pesable =0
						IF !.grid2_lostfocuscant(1)	
						ENDIF 
						.grid2.column7.text1.SetFocus()
					ENDIF 
					
				ELSE 
					IF CsrauxCuerfac.pesable =0 
						lctipo = IIF(.lhayvariedad,2,1)
						IF thisform.lnkeycode<>19	
								IF !.grid2_lostfocuscant(lctipo)
								ENDIF 
						ENDIF 
					ELSE
						.lcsetfocus            = ""
						.lcgotfocus            = ""		
						.bloqueocodigo = .t.	
						DODEFAULT()
					ENDIF 
				ENDIF
			ENDIF 					
		ENDWITH 
	ENDPROC

	PROCEDURE Grid2.Column13.Text1.When
		RETURN thisform.editarprecio
		
	ENDPROC

	PROCEDURE Grid2.Column14.Text1.InteractiveChange
		thisform.lcsetfocus = "THISFORM.GRID2.COLUMN5.TEXT1"
		thisform.lcgotfocus = "THISFORM.GRID2.COLUMN13.TEXT1"
	ENDPROC

