	PROCEDURE actualizar		&& llama al procedimiento de grabacion
		LOCAL llok
		 
		WITH thisform      
			DO CASE 
		
				CASE .accion$"AM"
			 	 .quetecla = 0
			 	 
			 	
					
				 IF IIF(.tipoform$'FM',.t.,.pidovalores('A'))	&& LUM: sin valores (cuenta corriente por el SP)   
				    IF .quetecla=27
			           RETURN .t.
				    ENDIF 
					
					IF .tipoform$'R'
						.totalregistracion()
					ENDIF 
					
				    lok = Oavisar.usuario('Confirma el comprobante '+Csrcomprobante.cnombre,36)	
					IF lok#6
					   RETURN .f.
					ENDIF    
					
					IF !thisform.actualizafac.validarasto(,,LEFT(DTOS(CsrAuxCabefac.fecha),6))
						RETURN .f.
					ENDIF 
					
				 	WITH thisform.containerencabeza
				 		lnfechacaja = LTRIM(STR(YEAR(._txtfecha.value)))+LTRIM(STRzero(month(._txtfecha.value),2))
						lnperiodo = ._txtperiodo.value
					ENDWITH 
					IF LTRIM(lnfechacaja)<>LTRIM(lnperiodo )
						lok = Oavisar.usuario('El comprobante no corresponde al periodo fiscal, '+CHR(13)+'se reajustara al periodo fiscal.'+CHR(13);
											+CHR(13)+"Fecha emisión "+DTOC(thisform.containerencabeza._txtfecha.Value);
											+"    Periodo facturado "+(thisform.containerencabeza._txtperiodo.Value)+CHR(13);
											+'Confirma el comprobante '+Csrcomprobante.cnombre,36)	
						IF lok#6
					   		RETURN .f.
						ENDIF  
					ENDIF 
					 
			        oCadapter = thisform.obtenercursor('CsrMaopera')
		
					BEGIN TRANSACTION 
					IF !'NATIVE'$LcDataSourceType
					     oCadapter.Datasource.ActiveConnection.Begintrans()
					ENDIF
					
			   	    llok = .t.
		   	    
				    IF Csrprefitermi.tipoimpresora#3 AND thisform.idimpresora#0   AND !thisform.tipoform$'RFM'&& fiscal
				       llok = .imprimir()
				    ENDIF 
				    
			        IF !llok
					    lok = Oavisar.usuario('El comprobante '+TRIM(Csrcomprobante.cnombre)+' no ha sido impreso'+CHR(13)+'LO GRABA IGUAL',36)
						IF lok=6
						   llok =.t.
						ENDIF               
			        ENDIF 
		
				    IF llok		    
				       oavisar.proceso('S','Grabando  ..')
				       	*STOP()
				       	This.ldIni_Fecha = CsrAuxCabefac.fecha
				       	This.lnIni_IDCtacte = CsrAuxCabefac.idctacte
				       	This.lcIni_Ctacte = CsrAuxCabefac.ctacte
				       	This.lnIni_Comproba = CsrAuxMaopera.idcomproba
				       	
				       	TRY 
		   	   	       		llok = .grabardato()	   	   	  
		   	   	       	CATCH TO oError
				 			.cadenaerrores = 'Error: '+ALLTRIM(oError.Details)+' Metodo: '+oError.Procedure+CHR(13)+;
								'Mensaje: '+ALLTRIM(oError.Message)+' Nro Error ['+ALLTRIM(STR(oError.ErrorNo))+']'+CHR(13)+;
		 							'Linea: '+ALLTRIM(oError.LineContents)
				 			llok = .f.
			   	   		ENDTRY   
						IF llok
						   IF !'NATIVE'$LcDataSourceType
						      oCadapter.Datasource.ActiveConnection.committrans()
						   ENDIF    
						   END TRANSACTION 
						ELSE
						   IF !'NATIVE'$LcDataSourceType
						      oCadapter.Datasource.ActiveConnection.rollbacktrans()
						   ENDIF    
						   ROLLBACK
						   IF !EMPTY(.cadenaerrores)
						   		oavisar.usuario(.cadenaerrores,0)
						   ENDIF 
						ENDIF
						oavisar.proceso('N')
				    ELSE
					   IF !'NATIVE'$LcDataSourceType
					      oCadapter.Datasource.ActiveConnection.rollbacktrans()
					   ENDIF    
					   ROLLBACK	
				    ENDIF 		
			        RELEASE oCadapter	    
				 ENDIF   	 
		* borrar 
			CASE .accion$'bB'			
		            lnok = 6 
		            .CadenaErrores = 'NO SERA BORRADO'
		           	IF CsrAuxmaopera.estado<>'0'
					   =Oavisar.usuario('YA ESTA BORRADO'+chr(13);
			                      +'Nº comprobante '+left(CsrAuxmaopera.numcomp,1)+' '+subst(CsrAuxmaopera.numcomp,2,4)+'-'+righ(CsrAuxmaopera.numcomp,8);
			                      +chr(13)+'Nº interno     '+transform(CsrAuxmaopera.id,'999999999999'),0)
					   lnok = 0
		           	ENDIF
		
		            if .verestadovalores(CsrAuxmaopera.id) AND lnok=6
		               lnok = Oavisar.usuario('BORRA el comprobante'+chr(13);
		                      +'Nº comprobante '+left(CsrAuxmaopera.numcomp,1)+' '+subst(CsrAuxmaopera.numcomp,2,4)+'-'+righ(CsrAuxmaopera.numcomp,8);
		                      +chr(13)+'Nº interno     '+transform(CsrAuxmaopera.id,'999999999999');
		                     ,4+32+256)
		                     
		               if lnok=6 
		
					        oCadapter = thisform.obtenercursor('CsrMaopera')
		
							BEGIN TRANSACTION 
							IF !'NATIVE'$LcDataSourceType
							     oCadapter.Datasource.ActiveConnection.Begintrans()
							ENDIF
							oavisar.proceso('S','Borrando...')
							TRY 
		   	   	       			llok = .grabarborrado()	   	   	  
		   	   	       		CATCH TO oError
					 			.cadenaerrores = 'Error: '+ALLTRIM(oError.Details)+' Metodo: '+oError.Procedure+CHR(13)+;
									'Mensaje: '+ALLTRIM(oError.Message)+' Nro Error ['+ALLTRIM(STR(oError.ErrorNo))+']'+CHR(13)+;
		 							'Linea: '+ALLTRIM(oError.LineContents)
				 				llok = .f.
			   	   			ENDTRY   
			   	   			oavisar.proceso('N')
							IF llok
							   IF !'NATIVE'$LcDataSourceType
							      oCadapter.Datasource.ActiveConnection.committrans()
							   ENDIF    
							   END TRANSACTION 
							ELSE
								IF !'NATIVE'$LcDataSourceType
							    	oCadapter.Datasource.ActiveConnection.rollbacktrans()
							   	ENDIF     
							   	ROLLBACK
							   	IF !EMPTY(.cadenaerrores)
						   			oavisar.usuario(.cadenaerrores,0)
						   		ENDIF 
							ENDIF
				            RELEASE oCadapter	    	  		   
		               ELSE 
		                   =oavisar.usuario('EL COMPROBANTE'+chr(13);
		                      +'Nº comprobante '+left(CsrAuxmaopera.numcomp,1)+' '+subst(CsrAuxmaopera.numcomp,2,4)+'-'+righ(CsrAuxmaopera.numcomp,8);
		                      +chr(13)+'Nº interno     '+transform(CsrAuxmaopera.id,'999999999999');
		                     +chr(13)+.CadenaErrores,0)                                 
		               ENDIF  
		            ELSE 
		            	  =oavisar.usuario('EL COMPROBANTE'+chr(13);
		                      +'Nº comprobante '+left(CsrAuxmaopera.numcomp,1)+' '+subst(CsrAuxmaopera.numcomp,2,4)+'-'+righ(CsrAuxmaopera.numcomp,8);
		                      +chr(13)+'Nº interno     '+transform(CsrAuxmaopera.id,'999999999999');
		                     +chr(13)+.CadenaErrores,0)   
		            ENDIF
		    ENDCASE         
			.cmdborrar.Visible = .f.  
			.containerencabeza._txtfecha.SetFocus()  
			.limpiarcursor()	
			.containerencabeza._txtfecha.SetFocus()  
			.containerencabeza._txtfecha.Click()  
		ENDWITH 
		
		RETURN .t.
		
	ENDPROC

	PROCEDURE agregarcuerord
		APPEND BLANK IN CsrAuxCuerfac
		REPLACE univenta WITH 0,unibulto WITH 1,oricod WITH "D",registro WITH RECNO();
		,iddeposito WITH thisform.lniddeposito,idenvase WITH 0, cantkilos WITH 0000.0000 ;
		,bonif1 WITH 0, bonif2 WITH 0,bonif3 WITH 0, bonif4 WITH 0;
		,cantreal WITH 0, kilosreal WITH 0000.000 IN CsrAuxCuerfac
		
	ENDPROC

	PROCEDURE borrargrid1		&& Borra una linea del grid1, cuentas contables
		DELETE IN CsrAuxPlancue
		
		thisform.totalcomprobante(2)
		thisform.grid1.Refresh
	ENDPROC

	PROCEDURE borrargrid2		&& Borra una linea del grid2, productos elegidos
		DELETE FOR idarticulo = CsrAuxCuerfac.idarticulo AND pos=RECNO('CsrAuxCuerfac') IN CsrAuxCuerVari	
		DELETE IN CsrAuxCuerfac
		
		WITH thisform
			.totalcomprobante(1)
			.grid2.Refresh
			.grid2_generarlinea()   && 22=insert
			.grid2.column1.text1.SetFocus 
		ENDWITH 
	ENDPROC

	PROCEDURE buscarcajames		&& Busca la ultima caja abierta del mes de la fecha y la asigna al comprobante
		PARAMETERS ldfecha
		LOCAL lcCmd,lnDesde,lnHasta,lcalias
		
		IF EMPTY(ldfecha)
			RETURN .t.
		ENDIF
		lcalias = ALIAS()
		&& el numero de caja es la fecha AAAAMMDD
		lnDesde = YEAR(ldfecha)*10000 + MONTH(ldfecha)*100
		lnHasta = lnDesde + 99
		
		TEXT TO lcCmd TEXTMERGE NOSHOW
		SELECT TOP 1 CsrDetaNroCaja.* FROM DetaNroCaja as CsrDetaNroCaja
		WHERE CsrDetaNroCaja.nrocaja BETWEEN <<lnDesde>> AND <<lnHasta>>
		AND CsrDetaNroCaja.idejercicio = <<goapp.idejercicio>> AND LEFT(CsrDetaNroCaja.switch,1) <> '1'
		ORDER BY CsrDetaNroCaja.nrocaja DESC
		ENDTEXT
		IF NOT CrearCursorAdapter("FsrCajaMes",lcCmd)
			thisform.Release
			RETURN .f.
		ENDIF
		
		IF RECCOUNT('FsrCajaMes')=0
			oavisar.usuario("No hay una caja ABIERTA del mes "+STRZERO(MONTH(ldfecha),2)+"/"+STR(YEAR(ldfecha),4);
							+" en el ejercicio actual."+CHR(13)+"Abra una caja del periodo a registrar.",0)
		ELSE
			replace nrocaja WITH FsrCajaMes.nrocaja,iddetanrocaja WITH FsrCajaMes.id IN CsrAuxMaopera
			thisform.containerencabeza._txtnrocaja.Refresh()
		ENDIF
		USE IN FsrCajaMes
		
		IF !EMPTY(lcalias) AND USED(lcalias)
			SELECT (lcalias)
		ENDIF
		
	ENDPROC

	PROCEDURE ocultargrillasliq		&& LUM: oculta grillas detras de ContenedorLiq (es transparente, el clic caia en ellas)
		WITH thisform
			.grid1.Visible = .f.
			.grid2.Visible = .f.
			.contenedorRegistro.grid1.Visible = .f.
			.contenedorRegistro.grid3.Visible = .f.
			.contenedorRegistro.grid4.Visible = .f.
		ENDWITH
	ENDPROC

	PROCEDURE existenumliq		&& LUM: .T. si el comprobante + numero ya esta grabado en maopera (no anulado)
		LOCAL lccmd,llexiste

		TEXT TO lcCmd TEXTMERGE NOSHOW
		SELECT Csrmaopera.id FROM maopera as Csrmaopera
		where Csrmaopera.idcomproba=<<STRID(thisform.containerencabeza._cbocomprobante.Value)>>
		and Csrmaopera.numcomp='<<thisform.proximonro>>'
		and Csrmaopera.estado<>'1'
		ENDTEXT

		IF USED("CsrNroLiq")
			USE IN CsrNroLiq
		ENDIF
		IF NOT CrearCursorAdapter("CsrNroLiq",lcCmd)
			&& sin poder controlar no se deja seguir; igual el SP lo vuelve a controlar al grabar
			=Oavisar.usuario("No se pudo controlar si el número de comprobante ya está grabado.",0)
			RETURN .t.
		ENDIF
		llexiste = RECCOUNT("CsrNroLiq")>0
		USE IN CsrNroLiq
		RETURN llexiste
	ENDPROC

	PROCEDURE liqpasarvaloractivo		&& LUM: pasa a LiqDatos lo tipeado en el textbox activo (el + del KeyPreview llega antes)
		LOCAL loCtrl,lcCS

		IF TYPE('thisform.ActiveControl')#'O'
			RETURN .t.
		ENDIF
		&& el control activo puede estar dentro de un contenedor (ContenedorLiq)
		loCtrl = thisform.ActiveControl
		DO WHILE PEMSTATUS(loCtrl,'ActiveControl',5) AND TYPE('loCtrl.ActiveControl')='O'
			loCtrl = loCtrl.ActiveControl
		ENDDO
		IF !PEMSTATUS(loCtrl,'ControlSource',5) OR !PEMSTATUS(loCtrl,'Value',5)
			RETURN .t.
		ENDIF
		lcCS = ALLTRIM(loCtrl.ControlSource)
		IF UPPER(LEFT(lcCS,9))#'LIQDATOS.'
			RETURN .t.
		ENDIF
		replace (lcCS) WITH loCtrl.Value IN LiqDatos
		&& sugerencias del campo editado (como su LostFocus)
		IF UPPER(loCtrl.BaseClass)='TEXTBOX'
			thisform.controlliqdatos(SUBSTR(loCtrl.Name,5))
		ENDIF
		RETURN .t.
	ENDPROC

	PROCEDURE temp_save		&& LUM: al grabar guarda LiqDatos en Temporal\LUM<terminal>.XML
		&&Guardamos en un archivo temporal lo cargado de la liquidacion (como regfacvta.temp_save)
		LOCAL cRuta,cFile,lcalias

		IF RECCOUNT('LiqDatos')=0 OR (LiqDatos.total=0 AND LiqDatos.litros=0)
			RETURN .t.
		ENDIF
		lcalias = ALIAS()

		cRuta  =SYS(5)+CURDIR()+'Temporal'
		IF !DIRECTORY(cRuta)
			MKDIR SYS(5)+CURDIR()+'Temporal'
		ENDIF

		cFile = ADDBS(cRuta)+"LUM"+strzero(goapp.terminal,3)+".XML"

		SET SAFETY OFF
		CursorAdapterToXML('LiqDatos',cFile )
		SET SAFETY ON
		SELECT LiqDatos
		GO TOP		&& CURSORTOXML deja el puntero en EOF (los controles y la validacion leian vacio)

		IF !EMPTY(lcalias) AND USED(lcalias)
			SELECT (lcalias)
		ENDIF
		RETURN .t.
	ENDPROC

	PROCEDURE temp_load		&& LUM: recupera LiqDatos guardado por temp_save (Temporal\LUM<terminal>.XML)
		LOCAL cRuta,cFile,loAnt

		cRuta  =SYS(5)+CURDIR()+'Temporal'
		cFile = ADDBS(cRuta)+"LUM"+strzero(goapp.terminal,3)+".XML"
		IF !FILE(cFile)
			oavisar.usuario('No hay una liquidación guardada para recuperar en esta terminal.')
			RETURN .f.
		ENDIF

		IF RECCOUNT('LiqDatos')#0 AND (LiqDatos.total#0 OR LiqDatos.litros#0)
			IF oavisar.usuario('Tiene datos de la liquidación cargados, esta seguro de recuperar el archivo?',36) <> 6
				oavisar.usuario('Recuperacion cancelada')
				RETURN .f.
			ENDIF
		ENDIF

		SET SAFETY OFF
		SELECT LiqDatos
		ZAP
		XMLTOCURSOR(cFile ,"LiqDatos",512+8192)
		SET SAFETY ON
		SELECT LiqDatos
		IF RECCOUNT('LiqDatos')=0
			APPEND BLANK
		ENDIF
		GO TOP

		&& NC / ND: la liquidacion original se vuelve a validar contra la cuenta actual; en la liquidacion no va
		IF CsrComprobante.clase$'BC'
			thisform.buscarliqoriginal()
			IF EMPTY(LiqDatos.tipoajuste)
				replace tipoajuste WITH thisform.ContenedorLiq._cbotipoajuste.List(1) IN LiqDatos
			ENDIF
		ELSE
			replace ptovtaliq WITH 0, nroliq WITH 0, idmaoperaliq WITH 0, caeajuste WITH "", tipoajuste WITH "" IN LiqDatos
		ENDIF

		&& foto para las sugerencias y totales recalculados
		IF !PEMSTATUS(thisform,'oliqant',5)
			thisform.AddProperty('oliqant',.NULL.)
		ENDIF
		SELECT LiqDatos
		SCATTER NAME loAnt
		thisform.oliqant = loAnt
		thisform.controlliqdatos()
		thisform.ContenedorLiq._txtlitros.SetFocus()

		oavisar.usuario('Recuperación Exitosa!')
		RETURN .t.
	ENDPROC

	PROCEDURE grabarliqlactea		&& LUM: arma los datos y graba con actualizafac.grabarliqlactea (SP sp_gms_liqlactea_grabar)
		LOCAL loNeg,loDat,llajuste

		loNeg = thisform.GetRefObjneg('thisform.Odatamaopera')
		llajuste = CsrComprobante.clase$'BC'
		loDat = CREATEOBJECT('Empty')
		WITH thisform
			&& comprobante y operacion
			ADDPROPERTY(loDat,'prefijo',IIF(goapp.sucursal10#0,STR(goapp.sucursal10+10,2),''))
			ADDPROPERTY(loDat,'idcomproba',.containerencabeza._cbocomprobante.Value)
			ADDPROPERTY(loDat,'numcomp',.proximonro)
			ADDPROPERTY(loDat,'ptovta',VAL(SUBSTR(.proximonro,2,4)))
			ADDPROPERTY(loDat,'fecha',.containerencabeza._txtfecha.Value)
			ADDPROPERTY(loDat,'periodo',ALLTRIM(.containerencabeza._txtperiodo.Value))
			ADDPROPERTY(loDat,'idctacte',CsrAuxCabefac.idctacte)
			ADDPROPERTY(loDat,'tipoform',.tipoform)
			ADDPROPERTY(loDat,'idliqlacteo',IIF(.tipoform='F' AND USED('CsrLiqLacteo') AND RECCOUNT('CsrLiqLacteo')#0,CsrLiqLacteo.id,0))
		ENDWITH
		ADDPROPERTY(loDat,'programa',CsrAuxMaopera.programa)
		ADDPROPERTY(loDat,'sucursal',CsrAuxMaopera.sucursal)
		ADDPROPERTY(loDat,'terminal',CsrAuxMaopera.terminal)
		ADDPROPERTY(loDat,'sector',CsrAuxMaopera.sector)
		ADDPROPERTY(loDat,'idoperador',CsrAuxMaopera.idoperador)
		ADDPROPERTY(loDat,'idvendedor',CsrAuxMaopera.idvendedor)
		ADDPROPERTY(loDat,'iddetanrocaja',CsrAuxMaopera.iddetanrocaja)
		ADDPROPERTY(loDat,'turno',CsrAuxMaopera.turno)
		ADDPROPERTY(loDat,'puestocaja',CsrAuxMaopera.puestocaja)
		ADDPROPERTY(loDat,'idcotizadolar',CsrAuxMaopera.idcotizadolar)
		&& liquidacion (LiqDatos)
		ADDPROPERTY(loDat,'litros',LiqDatos.litros)
		ADDPROPERTY(loDat,'grasa',LiqDatos.grasa)
		ADDPROPERTY(loDat,'proteina',LiqDatos.proteina)
		ADDPROPERTY(loDat,'kggrasa',LiqDatos.kggrasa)
		ADDPROPERTY(loDat,'kgproteina',LiqDatos.kgproteina)
		ADDPROPERTY(loDat,'total',LiqDatos.total)
		ADDPROPERTY(loDat,'pctiva',LiqDatos.pctiva)
		ADDPROPERTY(loDat,'iva',LiqDatos.iva)
		ADDPROPERTY(loDat,'baseperiva',LiqDatos.baseperiva)
		ADDPROPERTY(loDat,'pctperiva',LiqDatos.pctperiva)
		ADDPROPERTY(loDat,'periva',LiqDatos.periva)
		ADDPROPERTY(loDat,'baseperiibb',LiqDatos.baseperiibb)
		ADDPROPERTY(loDat,'pctperiibb',LiqDatos.pctperiibb)
		ADDPROPERTY(loDat,'periibb',LiqDatos.periibb)
		ADDPROPERTY(loDat,'neto',LiqDatos.neto)
		ADDPROPERTY(loDat,'cae',LiqDatos.cae)
		ADDPROPERTY(loDat,'vtocae',LiqDatos.vtocae)
		&& NC / ND: liquidacion original
		ADDPROPERTY(loDat,'idmaoperaliq',IIF(llajuste,LiqDatos.idmaoperaliq,0))
		ADDPROPERTY(loDat,'tipoajuste',IIF(llajuste,LiqDatos.tipoajuste,''))
		&& salida
		ADDPROPERTY(loDat,'idmaopera',0)

		IF !thisform.actualizafac.grabarliqlactea(loNeg,loDat)
			thisform.cadenaerrores = loNeg.cadenaerror
			loNeg = null
			RETURN .f.
		ENDIF
		replace id WITH loDat.idmaopera, numcomp WITH loDat.numcomp IN CsrAuxMaopera
		loNeg = null
		RETURN .t.
	ENDPROC

	PROCEDURE buscarliqoriginal		&& NC/ND: verifica la liquidacion original (pto vta + numero) y guarda su idmaopera y CAE
		LOCAL lcCmd,lcnumcomp,lcidcomprobas,lcalias

		replace idmaoperaliq WITH 0, caeajuste WITH "" IN LiqDatos
		thisform.ContenedorLiq.lblLiqOrigCae.Caption = ""
		IF NOT CsrComprobante.clase$'BC' OR LiqDatos.ptovtaliq=0 OR LiqDatos.nroliq=0
			RETURN .t.
		ENDIF
		lcalias = ALIAS()

		&& comprobantes de liquidacion (clase A) habilitados en este form
		lcidcomprobas = ""
		SELECT CsrComprobante
		lnrecno = RECNO()
		SCAN FOR clase='A'
			lcidcomprobas = lcidcomprobas + IIF(EMPTY(lcidcomprobas),"",",") + STRID(CsrComprobante.id)
		ENDSCAN
		GO lnrecno
		IF EMPTY(lcidcomprobas)
			RETURN .t.
		ENDIF

		lcnumcomp = LEFT(thisform.containerencabeza._txtletra.Value,1)+STRZERO(LiqDatos.ptovtaliq,4)+STRZERO(LiqDatos.nroliq,8)

		TEXT TO lcCmd TEXTMERGE NOSHOW
		SELECT TOP 1 CsrOpera.id, ISNULL(CsrLiq.cae,'') as cae
		FROM maopera as CsrOpera
		inner join cabeLiq as CsrLiq on CsrLiq.idmaopera = CsrOpera.id
		WHERE CsrOpera.idcomproba in (<<lcidcomprobas>>) AND CsrOpera.numcomp = '<<lcnumcomp>>'
		AND CsrOpera.estado <> '1' AND CsrLiq.idctacte = <<CsrAuxCabefac.idctacte>>
		ENDTEXT
		IF NOT CrearCursorAdapter('FsrLiqOrig',lcCmd)
			thisform.Release
			RETURN .f.
		ENDIF

		IF RECCOUNT('FsrLiqOrig')=0
			oavisar.usuario("No existe la liquidación "+LEFT(lcnumcomp,1)+" "+STRZERO(LiqDatos.ptovtaliq,4)+"-"+STRZERO(LiqDatos.nroliq,8);
							+CHR(13)+"para esta cuenta (o está anulada).",0)
		ELSE
			replace idmaoperaliq WITH FsrLiqOrig.id, caeajuste WITH FsrLiqOrig.cae IN LiqDatos
			thisform.ContenedorLiq.lblLiqOrigCae.Caption = "CAE "+ALLTRIM(FsrLiqOrig.cae)
		ENDIF
		USE IN FsrLiqOrig

		IF !EMPTY(lcalias) AND USED(lcalias)
			SELECT (lcalias)
		ENDIF

	ENDPROC

	PROCEDURE buscarliqlacteo		&& Busca en liqlacteo la liquidacion mensual del tambo de la ctacte para el periodo
		&& Deja el resultado en CsrLiqLacteo (0 o 1 fila). Liquidacion declarada (origen L), mensual (tipo M),
		&& del tambo de la ctacte elegida y del periodo fiscal del comprobante, todavia no emitida (idmaopera = 0).
		LOCAL lcCmd,lcperiodo,lnidctacte,lcalias
		
		lcalias    = ALIAS()
		lnidctacte = CsrAuxCabefac.idctacte
		lcperiodo  = ALLTRIM(thisform.containerencabeza._txtperiodo.Value)
		
		IF USED('CsrLiqLacteo')
			USE IN CsrLiqLacteo
		ENDIF 
		
		IF lnidctacte#0 &&AND LEN(lcperiodo)=6
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT CsrLiq.*,CsrTambo.numero as nrotambo,CsrTambo.nombre as nomtambo
			FROM liqlacteo as CsrLiq
			inner join tambo as CsrTambo on CsrLiq.idtambo = CsrTambo.id
			WHERE CsrTambo.idctacte = <<lnidctacte>> AND CsrLiq.periodo = '<<lcperiodo>>'
			AND CsrLiq.origen = 'L' AND CsrLiq.tipo = 'M' AND CsrLiq.idmaopera = 0
			ENDTEXT 
			IF NOT CrearCursorAdapter('CsrLiqLacteo',lcCmd)
				thisform.Release
				RETURN .f.
			ENDIF 
			SELECT CsrLiqLacteo
			*vista()
		ENDIF 
		
		thisform.mostrarliqlacteo()
		
		IF !EMPTY(lcalias) AND USED(lcalias)
			SELECT (lcalias)
			
		ENDIF 
		
	ENDPROC

	PROCEDURE buscarorigen
		
		thisform.generandolote = .f.
		
		IF this.tipoform$'F'
		*!*		IF !this.tipofactura$'N' &&Factura/Orden
		*!*			RETURN .f.
		*!*		ENDIF 
			*---------------
			loObjeto = CREATEOBJECT("CUSTOM")
			loObjeto.AddProperty('claseafectador',CsrComprobante.clase)
			loObjeto.AddProperty('idmaoperaafectado',0)
			loObjeto.AddProperty('idctacte',CsrAuxCabefac.idctacte)
			loObjeto.AddProperty('origen',CsrAuxMaopera.origen)
			
			DO FORM PidoPendiente WITH loObjeto NAME loForm LINKED 
			
			IF VARTYPE(loForm)$'XU'
				RETURN .f.
			ENDIF 
			IF VARTYPE(loForm.lccadena)$'XU'
				RETURN .f.
			ENDIF 
			
			lcidmaopera = loForm.lcCadena
			RELEASE loObjeto
			RELEASE loForm 
		
			IF LEN(LTRIM(lcidmaopera))=0
				RETURN .f.
			ENDIF 
		ELSE
			RETURN .f.
		ENDIF 
		
		SELECT CsrComprobante
		LOCATE FOR clase='A'
		IF !CsrComprobante.clase$'A'
			RETURN .f.		
		ENDIF 
		
		lndecimaluni = thisform.ndecimaluni
		lndecimaltot = thisform.ndecimaltot
		
		SET SAFETY OFF 
		SELECT CsrauxCuerfac
		ZAP
		
		SELECT CsrAuxCuerVari
		ZAP
		SET SAFETY ON 
		
		
		* Cabefac
		SELECT CsrAuxCabefac
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrcabeza.id,CsrCabeza.idmaopera,CsrOpera.clasecomp,CsrCabeza.switch
		,LEFT(CsrOpera.numcomp,1)+' '+RIGHT(LEFT(CsrOpera.numcomp,5),4)+'-'+RIGHT(CsrOpera.numcomp,8) as numcomp
		,CsrComprobante.cnombre as nomcomproba,CsrOpera.clasecomp
		from Maopera as CsrOpera
		left join cabeord as CsrCabeza on CsrOpera.id = CsrCabeza.idmaopera
		left join comprobante as CsrComprobante on CsrOpera.idcomproba = CsrComprobante.id
		where CsrOpera.id in (<<lcidmaopera>>)
		ENDTEXT 
		IF !CrearCursorAdapter('FsrAuxOpera',lcCmd)
			RETURN .f.
		ENDIF 
		
		&&Si se recupero un remito. Esta no compromete mercaderia
		SELECT CsrAuxCabefac
		GO TOP 
		*replace ComprometeMerc WITH 1 IN CsrAuxCabefac
		
		
		*!*	this.generandorementrega = .f.
		*!*	SELECT FsrAuxOpera
		*!*	LOCATE FOR clasecomp='8'
		*!*	IF clasecomp='8'
		*!*		this.generandorementrega = .t.
		*!*	ENDIF 		
		* Cuerfac
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrcuerord.* from Cuerord as Csrcuerord where Csrcuerord.idmaopera in (<<lcidmaopera>>)
		ENDTEXT 
		IF !CrearCursorAdapter('Csrcuerord',lccmd)
		  RETURN .f.
		ENDIF
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Csrcuervariord.*,Csrsubproducto.nombre as nombre from cuervariord as Csrcuervariord
		left join subproducto as Csrsubproducto on Csrcuervariord.idsubarti = Csrsubproducto.id		
		where Csrcuervariord.idmaopera in (<<lcidmaopera>>)
		ENDTEXT 
		        
		IF !CrearCursorAdapter('Csrcuervariord',lccmd)
		  RETURN .f.
		ENDIF
		
		SELECT CsrAuxCabefac
		SCATTER NAME OscatterCab
		
		SELECT CsrauxCuerfac
		SCATTER NAME Oscatter
		
		SELECT CsrauxCuerVari
		SCATTER NAME OscatterVari
		
		
		*stop() 
		
		SELECT CsrCuerord
		GO TOP 
		SCAN FOR !EOF()
			SCATTER NAME Oscatter ADDITIVE 
		
			Oscatter.idmaopera = 0
			Oscatter.idcabeza = 0
			
			*Oscatter.codextend = Oscatter.codigo
			
			lnunibulto  = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
			lnuniventa  = Oscatter.univenta			
			lnunibulto  = IIF(lnuniventa=1,1,lnunibulto)
			lnCantFinal = IIF(Oscatter.cantidad=0,1,Oscatter.cantidad)
			
			lnCantidad  = lnCantFinal / lnunibulto
			lnpesable 	= Oscatter.pesable
			lnkilos 	= Oscatter.kilos
			IF lnpesable = 0
				lnkilos    = lnkilos / lnCantFinal
			ENDIF 
			lncantkilos = lnkilos 
			lnVolumen	= Oscatter.volumen / lnCantFinal
			
			SELECT CsrauxCuerfac
			LOCATE FOR idarticulo = Oscatter.idarticulo AND preunita=Oscatter.preunita AND preunitasiva = Oscatter.preunitasiva AND despor = Oscatter.despor AND unibulto = Oscatter.unibulto AND pesable=Oscatter.pesable
			IF !(idarticulo = Oscatter.idarticulo AND preunita=Oscatter.preunita AND preunitasiva = Oscatter.preunitasiva AND despor = Oscatter.despor AND unibulto = Oscatter.unibulto AND pesable=Oscatter.pesable)
				APPEND BLANK
				Oscatter.registro = RECNO()	
				Oscatter.cantidad 	= 0
				Oscatter.cantkilos	= 0
				Oscatter.volumen	= 0
			ELSE
				SCATTER NAME Oscatter ADDITIVE 
			ENDIF 
			Oscatter.cantidad 	= Oscatter.cantidad + lnCantidad
			Oscatter.cantkilos	= Oscatter.cantkilos+ lnCantKilos
			Oscatter.volumen	= Oscatter.volumen + lnVolumen
		    GATHER NAME Oscatter 	      
		    
		    *Totalizamos 
		    SCATTER NAME Oscatter 
		    lnCantidad  = Oscatter.cantidad
		    lnKilos		= Oscatter.cantkilos
		    thisform.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
		    Oscatter.total = Red((IIF(this.incluyeiva,Oscatter.UniCiva,Oscatter.UniSiva) + Oscatter.internofin ),lndecimaltot)	
		    Oscatter.preorig = IIF(thisform.incluyeiva,Oscatter.preunita,Oscatter.preunitasiva)
		    GATHER NAME Oscatter 
		    
		    SELECT CsrCuerVariOrd
		    LOCATE FOR idcuerfac = CsrCuerOrd.id
		    DO WHILE idcuerfac = CsrCuerOrd.id
		    	SCATTER NAME OscatterVari ADDITIVE 
		    	OscatterVari.registro = Oscatter.registro
		    	OscatterVari.idmaopera = 0
		    	
		    	lnunibulto = IIF(CsrAuxCuerfac.unibulto=0,1,CsrAuxCuerfac.unibulto)
				lnuniventa = CsrAuxCuerfac.univenta
				lnunibulto = IIF(lnuniventa=1,1,lnunibulto)
				lnCantFinal = IIF(OscatterVari.cantidad=0,1,OscatterVari.cantidad)
				
				lnCantidad = OscatterVari.cantidad / lnunibulto
				lnKilos    = OscatterVari.kilos / lnCantFinal
				lnVolumen  = oscatterVari.volumen / lnCantFinal
				
				SELECT CsrAuxCuerVari
				LOCATE FOR registro = OscatterVari.registro AND idvariedad = OscatterVari.idvariedad
				IF !(registro = OscatterVari.registro AND idvariedad = OscatterVari.idvariedad)
					APPEND BLANK
					OscatterVari.cantidad 	= 0
					OscatterVari.kilos		= 0
					OscatterVari.volumen	= 0
				ELSE
					SCATTER NAME OscatterVari ADDITIVE 
				ENDIF 
				OscatterVari.cantidad 	= OscatterVari.cantidad + lnCantidad
				OscatterVari.kilos	= OscatterVari.kilos+ lnKilos
				OscatterVari.volumen	= OscatterVari.volumen + lnVolumen
				GATHER NAME OscatterVari
		    	
		    	SELECT CsrCuerVariOrd
		    	SKIP    	
		    ENDDO 
			SELECT CsrCuerOrd	
		ENDSCAN
		
		thisform.totalcomprobante(1)
		
		SELECT CsrCuerOrd
		GO TOP 
		
		USE IN CsrCuerOrd
		USE IN CsrCuerVariOrd
		
		*!*	TEXT TO lcCmd TEXTMERGE NOSHOW 
		*!*	SELECT CsrCuerfac.* FROM Cuerfac as CsrCuerfac WHERE id < 0
		*!*	ENDTEXT 
		*!*	thisform.obtenerdatos('CsrCuerfac',lcCmd)
		
		*!*	TEXT TO lcCmd TEXTMERGE NOSHOW 
		*!*	SELECT CsrCuervari.* FROM Cuervari as CsrCuervari WHERE id < 0
		*!*	ENDTEXT 
		*!*	thisform.obtenerdatos('CsrCuervari',lcCmd)
		
		
		thisform.generandolote = .t.
		
		&&Seteamos el comprobante factura
		thisform.containerencabeza.Refresh()
		
		RETURN .t.
	ENDPROC

	PROCEDURE buscarproducto
		*thisform.invocandoform = .t.
		oavisar.proceso('Buscando Productos...')
		
		LOCAL loObjParametro
		
		this.agregaobjeto.objbuscocomproba(@loObjParametro)
		
		*stop()
		WITH loObjParametro
			.cTypeSelection = "T"
			.AddProperty("solocosto",.t.)
			IF This.ProdProvee 
				.AddProperty("FiltroProveedor",CsrCtacte.id)
			ENDIF 
		ENDWITH 
		
		
		DO FORM busproducto_cpr WITH loObjParametro NAME loFormBuscar LINKED
		
		lcidRetorno = IIF(VARTYPE(loObjParametro.cidretorno)$'C',loObjParametro.cidretorno,strtrim(loObjParametro.cidretorno,12))
		
		loObjParametro = null
		
		
		WITH thisform 
			IF LEN(TRIM(lcidretorno))#0
				*oavisar.usuario(lcidretorno)
				*stop()
				oCa = thisform.obtenercursor("CsrProducto")
				
				stop()
				
				lcCmdProd = UPPER(Oca.SelectCmd)
				i = AT("WHERE",lcCmdProd)
				lcCmdProd = LEFT(lcCmdProd,i-1)
				lcCmdProd = lcCmdProd + " WHERE Csrproducto.id in (" + lcidretorno + ") "
				 
		*!*			TEXT TO lcCmdProd TEXTMERGE NOSHOW 
		*!*			SELECT Csrproducto.*,ISNULL(Tipoiva.tasa,0) as tasa,ISNULL(rubro.idfuerzavta,0) as idfuerzavta,isnull(left(tipoprod.switch,1),'0') as alcohol
		*!*			,ISNULL(rubro.perceibruto,0) as perceibruto, isnull(CsrAreaNegRubro.idarea,0) as idarea,ISNULL(Rubro.switch,'00000') as SwitchRubro 
		*!*			FROM Producto as Csrproducto 
		*!*			LEFT JOIN Tipoiva on Csrproducto.idiva = Tipoiva.id 
		*!*			LEFT JOIN rubro on Csrproducto.idrubro = rubro.id 
		*!*			LEFT JOIN tipoprod on rubro.idtipoprod = tipoprod.id  
		*!*			LEFT JOIN AreaNegRubro as CsrAreaNegRubro on Rubro.id = CsrAreaNegRubro.idrubro 
		*!*			where Csrproducto.id in (<<lcidretorno>>)
		*!*			ENDTEXT 
				=SaveSQL(lcCmdProd,this.Name+"_buscarprod")
				IF !ThisForm.Obtenerdatos('CsrProducto',lcCmdProd)
					thisform.Release
				ENDIF 
				
				*stop()
				SELECT CsrAuxCuerfac
				GO BOTTOM 
				
				SELECT CsrProducto
				GO top
				*vista()
				SCAN FOR !EOF()
					IF CsrAuxCuerfac.idarticulo <> 0 && insertamos un nuevo producto
						this.agregarcuerord()
					ENDIF
				
					SELECT CsrProducto
					thisform.lnkeycode = 13
					thisform.grid2.column1.text1.Value = strtrim(CsrProducto.numero,8)
					IF thisform.kitbuscarProd.fc_lostfocus(CsrProducto.numero)		
						thisform.kitbuscarProd.f_lostfocusSay()
					ENDIF 
					
					*this.agregarcuerfac()
				ENDSCAN
			
			ENDIF 
		ENDWITH 
		
		
		*thisform.invocandoform = .f.
		
		thisform.grid2.SetFocus()
	ENDPROC

	PROCEDURE cambiarcuenta
		LOCAL llok 
		llok = .f.		
		
		thisform.lcidcuentaa = 0
		thisform.lcidcuentad = 0 	
		
		*Si se cargo alguna cuenta a mano. Puede que el plancue tenga un solo registro
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		select csrplancue.*,isnull(csrclasecta.cnumero,' ') as clasecta 
		from plancue as csrplancue 
		left join clasecta as csrclasecta on csrplancue.idclase = csrclasecta.id where imputable=1
		and csrplancue.idejercicio = <<goapp.idejercicio>>
		ENDTEXT 
		IF !thisform.obtenerdatos('CsrPlanCue',lccmd)
			thisform.Release
		ENDIF
				
		TEXT TO lccmd TEXTMERGE NOSHOW 
		SELECT CsrCtactectacon.* FROM Ctactectacon as CsrCtacteCtacon WHERE idctacte = <<CsrCtacte.id>>	
		and idejercicio = <<goapp.idejercicio>>	
		ENDTEXT 
		thisform.obtenerdatos('CsrctacteCtacon',lccmd)
		if RECCOUNT('CsrCtacteCtacon')#0
			SELECT CsrCtacteCtacon
				
			SELECT Csrplancue
			LOCATE FOR id=Csrctactectacon.idctacpra
			thisform.lcidcuentaa = IIF(id=Csrctactectacon.idctacpra,CsrPlancue.id,0)
			
			SELECT Csrplancue
			LOCATE FOR id=Csrctactectacon.idctavta
			thisform.lcidcuentad = IIF(id=Csrctactectacon.idctavta,CsrPlancue.id,0)
		
			llok = .t.
		ENDIF  
		
		IF thisform.lcidcuentaa=0 AND thisform.lcidcuentad=0
			llok = .f.
		ENDIF 
				
		RETURN llok
		
	ENDPROC

	PROCEDURE cambiarletra
		
		*Si el proveedor es RI y no tiene cbu informada (Preguntar)
		*Se permite editar la letra. Igual los valores son E M o A
		this.cambioletrari = .f.
		this.containerencabeza._txtletra.Enabled = .f.
		IF ALLTRIM(CsrCategoiva.abrevia)$'RI'
			this.containerencabeza._txtletra.Enabled = .t.
		ENDIF 
	ENDPROC

	PROCEDURE cargarafectar		&& 'A CUENTA  O S/IMPUTAR'
		
		SET SAFETY OFF 
		IF USED('CsrAuxMovAfectado')
			SELECT CsrAuxMovAfectado
			ZAP
		ENDIF 
		SET SAFETY ON 
		
		lcdetalle = "SIN IMPUTAR "
		SELECT CsrAuxMovAfectado 
		APPEND BLANK      
		REPLACE id WITH 0,detalle WITH lcdetalle,importe WITH 0
		
		
	ENDPROC

	PROCEDURE cargarcabefac		&& Carga datos cursor CsrAuxCabefac
		LOCAL lok,lidplanpago
		
		lok = .t.
		WITH thisform
			IF !.containerencabeza.kitbuscaoaltaenCtacte.lprocesogrillabusqueda
				
				lnidtipoiva = 3
				lnidcategoria	= IIF(CsrAuxCabefac.idctacte=0,1,CsrCtacte.idcategoria)
				lnidlocalidad	= IIF(CsrAuxCabefac.idctacte=0,.lnidlocalidad,CsrCtacte.idlocalidad)
				lnidprovincia	= IIF(CsrAuxCabefac.idctacte=0,.lnidprovincia,CsrCtacte.idprovincia)
				lnidprovRecep   = CsrCentroRecep.idprovincia
				lccuit        	= IIF(CsrAuxCabefac.idctacte=0,"",CsrCtacte.cuit)
				.esbonifica		= IIF(CsrCtacte.totalizabonif=1,.f.,.t.)
				.esrecodevol 	= IIF(CsrCtacte.esrecodevol=1,.t.,.f.)
				lnidcuenta	 	= IIF(!.CambiarCuenta(),0,.lcidcuentaa)
			    
			    lok = .controlctacte(CsrAuxCabefac.idctacte,lcCuit,lnidcategoria,lnidprovincia,lnidlocalidad)
		
				IF thisform.tipoform<>'R'
					SELECT CsrProvincia
					LOCATE FOR numero = 2 &&Harckodeado
					lnidprovincia = CsrProvincia.id
				ENDIF 
					
				IF CsrAuxCabefac.idctacte#0   AND lok
					lidplanpago = .lnidplanpago
				   	IF Csrctacte.idplanpago#0
				   		SELECT Csrplanpago
				   	  	IF RECCOUNT("Csrplanpago")=0
				   	     	=Oavisar.usuario("Debe definir al menos un plan de pago"+CHR(13)+"CONTADO, CUENTA CORRIENTE, etc.")
				   	     	lok=.f.
				   	  	ENDIF 
				   	  	IF RECCOUNT("Csrvalor")=0
							=Oavisar.usuario("Debe definir al menos un tipo de valor"+CHR(13)+"EFECTIVO, CUENTA CORRIENTE, CHEQUE, etc.")	   	  
						 	lok = .f.
				   	  	ENDIF 	   	  
				   	  
				   	  	LOCATE FOR id=Csrctacte.idplanpago
				   	  	IF !EOF() AND id=CsrCtacte.idplanpago
				  	     	lidplanpago = Csrctacte.idplanpago
				  	     	&&Agregado por Marcos 10/12. Si el plan de pago es CTACTE, le damos la opcion de no pedir valores
				  	     	&&Para agilizar la registración.
				  	     	SELECT CsrValor
				  	     	LOCATE FOR id = CsrPlanPago.idvalor
				  	     	thisform.containerencabeza._chkpidovalor.Value = IIF(CsrValor.clasevalor$'C',0,1)		  	     
			  		  	ELSE
			  	   	     	=Oavisar.usuario("Debe definir al menos un plan de pago"+CHR(13)+"CONTADO, CUENTA CORRIENTE, etc.")
				   	     	lok=.f.
					  	ENDIF 	  	     
				   	ELSE
				   	 	=Oavisar.usuario("Debe definir al menos un plan de pago"+CHR(13)+"CONTADO, CUENTA CORRIENTE, etc.")
				   	   	lok=.f.				  
				   	ENDIF
				   
				   	IF lok	
				   		lcCuit = STRTRAN(lcCuit,"-","")
				   		lcCuit = LEFT(lcCuit,2)+"-"+SUBSTR(lcCuit,3,8)+"-"+SUBSTR(lcCuit,11,1)
						REPLACE idctacte WITH CsrCtacte.id,cnombre WITH CsrCtacte.cnombre,cdireccion WITH CsrCtacte.cdireccion;
					          ,idtipoiva WITH CsrCtacte.tipoiva,cuit WITH CsrCtacte.cuit,cpostal WITH CsrCtacte.cpostal,idcategoria WITH lnidcategoria;
					          ,idlocalidad WITH CsrCtacte.idlocalidad,idprovincia WITH lnidprovincia,ctacte WITH CsrCtacte.cnumero;
					          ,idplanpago WITH lidplanpago,copiatkt WITH IIF(CsrCtacte.copiatkt#0,CsrCtacte.copiatkt,1);
					          ,idcuenta WITH lnidcuenta,idprovRecep WITH lnidprovRecep IN CsrAuxcabefac
					ENDIF 	          
				ELSE	
					.containerencabeza.kitbuscaoaltaenCtacte.lrecargatxtnombre = .f.
				   	lccnombre = .containerencabeza.kitbuscaoaltaenCtacte.txtnombre.Value		   
				   	REPLACE idctacte WITH 0,cnombre WITH lccnombre,cdireccion WITH "",idtipoiva WITH lnidtipoiva,cuit WITH "";
				          ,cpostal WITH "",idlocalidad WITH lnidlocalidad,idprovincia WITH lnidprovincia,idcategoria WITH lnidcategoria;
				          ,ctacte WITH "",copiatkt WITH IIF(Csrprefijonro.copias#0,Csrprefijonro.copias,1);
				          ,idplanpago WITH .lnidplanpago IN CsrAuxcabefac
				ENDIF 
				
				.cargartambodatos(CsrAuxCabefac.idctacte)
				
				WITH thisform
					.grid1.Visible = .f.
					IF .tipoform <> 'R' && si el form trabaja como facturador normal
						IF !SUBSTR(CsrCateCtacte.switch,2,1)="1"      && el proveedor pide productos
							.grid1.Visible = .t.
						ENDIF 			
					ELSE
						&& el form trabaja como registracion de notas de creditos
						.grid2.visible = .f. &&cuerfac
						.grid1.visible = .f. &&impuestos
			
						.contenedorRegistro.grid1.visible = .t.
						.contenedorRegistro.grid3.visible = .f.
						.contenedorRegistro.grid4.visible = .f.
					
					ENDIF 
				
				ENDWITH 	
			ENDIF 
		ENDWITH 
		
		RETURN lok
		
	ENDPROC

	PROCEDURE cargarctaconproducto
		&& le cargaremos al  Auxcuerfac la cuenta contable por la cual se generara el
		&& asiento, debemos verificar primero en la producto y sino en rubro
		PARAMETERS lnid
		
		IF lnid=0
			RETURN 
		ELSE
		
			&&& traemos el prodctacon y el rubroctacon
			TEXT TO lccmd TEXTMERGE NOSHOW 
			SELECT CsrProdCtacon.idarticulo,isnull(CsrPlanVta.id,0) as idctavta,isnull(CsrPlanCpra.id,0) as idctacpra 
			FROM Prodctacon as CsrProdctacon
			left join PlanCue as CsrPlanVta  on CsrProdCtacon.idctavta = CsrPlanVta.id
			left join PlanCue as CsrPlanCpra  on CsrProdCtacon.idctacpra = CsrPlanCpra.id
			where CsrProdCtacon.idarticulo in (<<lnid>>)  and CsrProdCtacon.idejercicio = <<goapp.idejercicio>>
			ENDTEXT 
			CrearcursorAdapter('CsrCtacon',lccmd)
				
			SELECT Csrauxcuerfac
			IF idarticulo=0 AND LEN(TRIM(nombre))=0 AND cantidad=0 AND preunita=0
		   		LOOP 
		   	ENDIF 
		    llok = .t.
		    
		   	IF RECCOUNT('CsrCtaCon')#0		
		   		SELECT CsrCtacon
		   		LOCATE FOR idarticulo = CsrAuxCuerfac.idarticulo
		   		IF idarticulo = CsrAuxCuerfac.idarticulo 
		   			IF  CsrCtaCon.idctacpra#0
		   				replace idctavta WITH CsrCtacon.idctavta,idctacpra WITH CsrCtacon.idctacpra IN CsrauxCuerfac
		   				llok = .f.
		   			ENDIF 
		   		ENDIF 
		   	ENDIF 
		   	IF RECCOUNT('CsrCtaCon')=0	OR  llok
		   		SELECT CsrParaconta
		   		* Cuenta compra mercaderia nacional
		   		LOCATE FOR numero = 19
		   		IF numero = 19 
		   			replace idctavta WITH CsrParaConta.idcuenta,idctacpra WITH CsrParaConta.idcuenta IN Csrauxcuerfac
		   		ELSE
		   			oavisar.usuario('Falta definir Cuenta para Cuenta Compra Mercaderia Nacional - 19')
		   		ENDIF 
		   	ENDIF 
		   	USE IN CsrCtaCon
		ENDIF 
	ENDPROC

	PROCEDURE cargarplancue
		&& cargamos para la registracion el plancue con valores
		
		
		&&CATEIBRN
		
		lcorigen = 'A'
		WITH thisform.ContenedorRegistro
		
			_screen.LockScreen = .t.
			
			.grid1.RecordSource = ''
			.grid3.RecordSource = ''
			.grid4.RecordSource = ''
			
			SET SAFETY OFF
			SELECT CsrauxPlancue
			ZAP
			SELECT CsrAuxPlanGravado
			ZAP 
			SELECT CsrAuxCuotas
			ZAP 
			SET SAFETY ON
			
			.grid1.RecordSource = 'CsrAuxPlanCue'
			.grid3.RecordSource = 'CsrAuxPlanGravado'
			.grid4.RecordSource = 'CsrAuxCuotas'
			.grid1.coLUMN3.combo1.RowSource = "CsrClaseCta.cnombre,id"
			
			.grid3.column1.ControlSource = "CsrAuxPlanGravado.cuenta"
			.grid3.column2.ControlSource = "CsrAuxPlanGravado.nombre"
			.grid3.column4.ControlSource = "CsrAuxPlanGravado.detalle"
			.grid3.column5.ControlSource = "CsrAuxPlanGravado.gravado"
			.grid3.column6.ControlSource = "CsrAuxPlanGravado.exento"
			.grid3.column7.ControlSource = "CsrAuxPlanGravado.tipoconce"
			.grid3.column8.ControlSource = "CsrAuxPlanGravado.idcuenta"
			
			&&Controlamos que el paraconta sea del ejercicio
			SELECT CsrParaConta
			GO TOP 
			
			IF CsrParaConta.idejercicio != goapp.idejercicio
				
			
				TEXT TO lccmdParaConta TEXTMERGE NOSHOW 
				Select Csrparaconta.* from paraconta as Csrparaconta 
				Where idejercicio = <<goapp.idejercicio>> order by numero
				ENDTEXT
				IF !thisform.obtenerdatos('CsrParaConta',lccmdParaConta)
					thisform.Release
				ENDIF 
			
		
				TEXT TO lcCmdProv TEXTMERGE NOSHOW 
				Select CsrProvCtacon.* from ProvCtacon as CsrProvCtacon 
				where idejercicio = <<goapp.idejercicio>>
				ENDTEXT 
				IF !thisform.obtenerdatos('CsrProvCtacon',lcCmdProv)
					thisform.Release
				ENDIF 
				
			ENDIF 
			
			TEXT TO lccmd TEXTMERGE NOSHOW 
			Select Csrplancue.*,isnull(Csrclasecta.cnumero,' ') as clasecta 
			from plancue as Csrplancue 
			left join clasecta as Csrclasecta on Csrplancue.idclase = Csrclasecta.id where imputable=1
			AND Csrplancue.IDEJERCICIO = <<GOAPP.IDEJERCICIO>>
			ENDTEXT 
			IF !thisform.obtenerdatos('CsrPlanCue',lccmd)
				thisform.Release
			ENDIF 
			
			lnidprovctacte = CsrProvincia.id
			*stop()
			&&Cargamos iva modificable	
			SELECT CsrParaconta
			LOCATE FOR numero = 13
			IF numero = 13 AND NOT ThisForm.containerencabeza._txtletra.Value$"C"
				SELECT CsrPlanCue
				LOCATE FOR id = CsrParaconta.idcuenta
				IF FOUND() AND id = CsrParaconta.idcuenta
					SELECT CsrClaseCta
					LOCATE FOR cnumero=ALLTRIM('IG')
					thisform.grid1b_generarlinea()
					.grid1.column1.text1.Value =  CsrPlanCue.cuenta
					.grid1.column4.text1.Value = CsrParaconta.cnombre
					.grid1.column6.text1.value = IIF(CsrCategoIva.fiscal$'M',0,21) && iva 21% por defecto
					.grid1.column1.text1.LostFocus()
					replace tipoconce WITH 'IG', origen WITH lcorigen,idclase WITH CsrClaseCta.id IN CsrauxPlanCue
				ENDIF 
			ENDIF 
			
			SELECT CsrParaconta
			LOCATE FOR numero = 13
			IF numero = 13 AND NOT ThisForm.containerencabeza._txtletra.Value$"C"
				SELECT CsrPlanCue
				LOCATE FOR id = CsrParaconta.idcuenta
				IF FOUND() AND id = CsrParaconta.idcuenta
					SELECT CsrClaseCta
					LOCATE FOR cnumero=ALLTRIM('IG')
					thisform.grid1b_generarlinea()
					.grid1.column1.text1.Value =  CsrPlanCue.cuenta
					.grid1.column4.text1.Value = CsrParaconta.cnombre
					.grid1.column6.text1.value = IIF(CsrCategoIva.fiscal$'M',0,10.5) && iva 21% por defecto
					.grid1.column1.text1.LostFocus()
					replace tipoconce WITH 'IG', origen WITH lcorigen,idclase WITH CsrClaseCta.id IN CsrauxPlanCue
				ENDIF 
			ENDIF 
			
			SELECT CsrParaconta
			LOCATE FOR numero = 13
			IF numero = 13 AND NOT ThisForm.containerencabeza._txtletra.Value$"C"
				SELECT CsrPlanCue
				LOCATE FOR id = CsrParaconta.idcuenta
				IF FOUND() AND id = CsrParaconta.idcuenta
					SELECT CsrClaseCta
					LOCATE FOR cnumero=ALLTRIM('IG')
					thisform.grid1b_generarlinea()
					.grid1.column1.text1.Value =  CsrPlanCue.cuenta
					.grid1.column4.text1.Value = CsrParaconta.cnombre
					.grid1.column6.text1.value = IIF(CsrCategoIva.fiscal$'M',0,27) && iva 21% por defecto
					.grid1.column1.text1.LostFocus()
					replace tipoconce WITH 'IG', origen WITH lcorigen,idclase WITH CsrClaseCta.id IN CsrauxPlanCue
				ENDIF 
			ENDIF 
			&&Cargamos otro iva
			SELECT CsrParaconta
			LOCATE FOR numero =34
			IF numero = 34 AND NOT ThisForm.containerencabeza._txtletra.Value$"C"
				SELECT CsrPlanCue
				LOCATE FOR id = CsrParaconta.idcuenta
				IF FOUND() AND id = CsrParaconta.idcuenta
					SELECT CsrClaseCta
					LOCATE FOR cnumero=ALLTRIM('OI')
					thisform.grid1b_generarlinea()
					.grid1.column1.text1.Value =  CsrPlanCue.cuenta
					.grid1.column4.text1.Value = CsrParaconta.cnombre
					.grid1.column6.text1.value = 0 && iva 21% por defecto
					.grid1.column1.text1.LostFocus()
					replace tipoconce WITH 'OI', origen WITH lcorigen,idclase WITH CsrClaseCta.id IN CsrauxPlanCue
				ENDIF 
			ENDIF 
			
			&&cargamos internos
			SELECT CsrParaconta
			LOCATE FOR numero = 21
			IF numero = 21
				SELECT CsrPlanCue
				LOCATE FOR id = CsrParaconta.idcuenta
				IF FOUND() AND id = CsrParaconta.idcuenta
					SELECT CsrClaseCta
					LOCATE FOR cnumero=ALLTRIM('II')
					thisform.grid1b_generarlinea()
					.grid1.column1.text1.Value =  CsrPlanCue.cuenta
					.grid1.column4.text1.Value = CsrParaconta.cnombre
					.grid1.column1.text1.LostFocus()
					replace tipoconce WITH 'II', origen WITH lcorigen,idclase WITH CsrClaseCta.id IN CsrauxPlanCue
				ENDIF 
			ENDIF 
			
			&&Cargamos Perc IVA
			SELECT CsrParaConta
			LOCATE FOR numero=6
			IF numero=6
				SELECT CsrPlanCue
				LOCATE FOR id = CsrParaconta.idcuenta
				IF FOUND() AND id = CsrParaconta.idcuenta
					SELECT CsrClaseCta
					LOCATE FOR cnumero=ALLTRIM('PI')
					thisform.grid1b_generarlinea()
					.grid1.column1.text1.Value =  CsrPlanCue.cuenta
					.grid1.column4.text1.Value = CsrParaconta.cnombre
					.grid1.column1.text1.LostFocus()
					replace tipoconce WITH 'PI', origen WITH lcorigen,idclase WITH CsrClaseCta.id IN CsrauxPlanCue
				ENDIF 
			ENDIF 
			
			&&Cargamos Perc Ganancia
			SELECT CsrParaconta
			LOCATE FOR numero = 11
			IF numero = 11
				SELECT CsrPlanCue
				LOCATE FOR id = CsrParaconta.idcuenta
				IF FOUND() AND id = CsrParaconta.idcuenta
					SELECT CsrClaseCta
					LOCATE FOR cnumero=ALLTRIM('PG')
					thisform.grid1b_generarlinea()
					.grid1.column1.text1.Value =  CsrPlanCue.cuenta
					.grid1.column4.text1.Value = CsrParaconta.cnombre
					.grid1.column1.text1.LostFocus()
					replace tipoconce WITH 'PG', origen WITH lcorigen,idclase WITH CsrClaseCta.id IN CsrauxPlanCue
				ENDIF 
			ENDIF
			 
			 *===================================================
			*Marcos 14/2/13
			*Cargamos las provincias de todas las que tengan una cuenta contable
			*No la sacamos del paraconta ni paravario
			*===================================================
			&&Cargamos Perc. IB Por provincias. Todas!!!!
			SELECT CsrProvcontable
			GO TOP 
			SCAN 
				*solo para recuperar el nombre del paraconta
				SELECT CsrParaconta
				LOCATE FOR numero = 8
				*Cuenta contablae asociada por provincia
				SELECT CsrProvCtaCon
				LOCATE FOR idprovincia = CsrProvcontable.id
				IF  CsrProvCtaCon.idctaperce=0
					SELECT CsrProvcontable
					LOOP 
				ENDIF 
				SELECT CsrPlanCue
				LOCATE FOR id = CsrProvCtaCon.idctaperce
				IF id != CsrProvCtaCon.idctaperce 
					SELECT CsrProvcontable
					LOOP
				ENDIF 
				lnidcuenta = CsrPlanCue.id
				
				SELECT CsrClaseCta
				LOCATE FOR cnumero=ALLTRIM('PB')
					
				thisform.grid1b_generarlinea()
				.grid1.column1.text1.Value =  CsrPlanCue.cuenta
				.grid1.column4.text1.Value = ALLTRIM(CsrParaconta.cnombre)+" "+ALLTRIM(CsrProvcontable.nombre)
				.grid1.column1.text1.LostFocus()
				replace tipoconce WITH 'PB', origen WITH lcorigen , nombreobjeto WITH "IBTO2";
						,idprovincia WITH CsrProvcontable.id,idclase WITH CsrClaseCta.id IN CsrauxPlanCue
				SELECT CsrProvcontable
			ENDSCAN
			  
			IF this.cuentaRG
				SELECT CsrParaconta
				LOCATE FOR numero = 10
				IF numero = 10
					SELECT CsrPlanCue
					LOCATE FOR id = CsrParaconta.idcuenta
					IF FOUND() AND id = CsrParaconta.idcuenta
						SELECT CsrClaseCta
						LOCATE FOR cnumero=ALLTRIM('RG')
						thisform.grid1b_generarlinea()
						.grid1.column1.text1.Value =  CsrPlanCue.cuenta
						.grid1.column4.text1.Value = CsrParaconta.cnombre
						.grid1.column1.text1.LostFocus()
						replace tipoconce WITH 'RG', origen WITH lcorigen,idclase WITH CsrClaseCta.id IN CsrauxPlanCue
					ENDIF 
				ENDIF
			ENDIF 
		*!*	*!*		IF this.cuentaRI
		*!*	*!*			SELECT CsrParaconta
		*!*	*!*			LOCATE FOR numero = 29
		*!*	*!*			IF numero = 29
		*!*	*!*				SELECT CsrPlanCue
		*!*	*!*				LOCATE FOR id = CsrParaconta.idcuenta
		*!*	*!*				IF FOUND() AND id = CsrParaconta.idcuenta
		*!*	*!*					SELECT CsrClaseCta
		*!*	*!*					LOCATE FOR cnumero=ALLTRIM('RI')
		*!*	*!*					thisform.grid1b_generarlinea()
		*!*	*!*					.grid1.column1.text1.Value =  CsrPlanCue.cuenta
		*!*	*!*					.grid1.column4.text1.Value = CsrParaconta.cnombre
		*!*	*!*					.grid1.column1.text1.LostFocus()
		*!*	*!*					replace tipoconce WITH 'RI', origen WITH lcorigen,idclase WITH CsrClaseCta.id IN CsrauxPlanCue
		*!*	*!*				ENDIF 
		*!*	*!*			ENDIF
		*!*	*!*		ENDIF 
		*!*	*!*		IF this.cuentaRB
		*!*	*!*			SELECT CsrParaconta
		*!*	*!*			LOCATE FOR numero = 9
		*!*	*!*			IF numero = 9
		*!*	*!*				SELECT CsrPlanCue
		*!*	*!*				LOCATE FOR id = CsrParaconta.idcuenta
		*!*	*!*				IF FOUND() AND id = CsrParaconta.idcuenta
		*!*	*!*					SELECT CsrClaseCta
		*!*	*!*					LOCATE FOR cnumero=ALLTRIM('RB')
		*!*	*!*					thisform.grid1b_generarlinea()
		*!*	*!*					.grid1.column1.text1.Value =  CsrPlanCue.cuenta
		*!*	*!*					.grid1.column4.text1.Value = CsrParaconta.cnombre
		*!*	*!*					.grid1.column1.text1.LostFocus()
		*!*	*!*					replace tipoconce WITH 'RB', origen WITH lcorigen,idclase WITH CsrClaseCta.id IN CsrauxPlanCue
		*!*	*!*				ENDIF 
		*!*	*!*			ENDIF
		*!*	*!*		ENDIF 
		*!*		&&Cargamos Perc. IB RN
		*!*		SELECT CsrParaconta
		*!*		LOCATE FOR numero = 8
		*!*		IF numero = 8
		*!*			SELECT CsrParavario
		*!*			LOCATE FOR nombre="CATEIBRN"
		*!*			SELECT CsrProvincia
		*!*			LOCATE FOR id=CsrParaVario.idorigen
		*!*			*cuenta asociada al paraconta
		*!*			SELECT CsrPlanCue
		*!*			LOCATE FOR id = CsrParaconta.idcuenta
		*!*			lnidcuenta = CsrPlanCue.id
		*!*			*Cuenta contablae asociada por provincia
		*!*			SELECT CsrProvCtaCon
		*!*			LOCATE FOR idprovincia = CsrProvincia.id
		*!*			SELECT CsrPlanCue
		*!*			LOCATE FOR id = CsrProvCtaCon.idctaperce
		*!*			IF id = CsrProvCtaCon.idctaperce AND CsrPlanCue.id#0
		*!*				lnidcuenta = CsrPlanCue.id
		*!*			ENDIF 
		*!*			IF FOUND() AND id = lnidcuenta
		*!*				
		*!*				thisform.grid1b_generarlinea()
		*!*				.grid1.column1.text1.Value =  CsrPlanCue.cuenta
		*!*				.grid1.column4.text1.Value = ALLTRIM(CsrParaconta.cnombre)+" "+ALLTRIM(CsrProvincia.nombre)
		*!*				.grid1.column1.text1.LostFocus()
		*!*				replace tipoconce WITH 'PB', origen WITH lcorigen , nombreobjeto WITH "IBRN" ;
		*!*				,idprovincia WITH CsrProvincia.id IN CsrauxPlanCue
		*!*			ENDIF 
		*!*		ENDIF 
		*!*		
		*!*		&&Cargamos Perc. IB BA
		*!*		SELECT CsrParaconta
		*!*		LOCATE FOR numero = 8
		*!*		IF numero = 8
		*!*			SELECT CsrParavario
		*!*			LOCATE FOR nombre="CATEIBBA"
		*!*			SELECT CsrProvincia
		*!*			LOCATE FOR id=CsrParaVario.idorigen
		*!*			*cuenta asociada al paraconta
		*!*			SELECT CsrPlanCue
		*!*			LOCATE FOR id = CsrParaconta.idcuenta
		*!*			lnidcuenta = CsrPlanCue.id
		*!*			*Cuenta contablae asociada por provincia
		*!*			SELECT CsrProvCtaCon
		*!*			LOCATE FOR idprovincia = CsrProvincia.id
		*!*			SELECT CsrPlanCue
		*!*			LOCATE FOR id = CsrProvCtaCon.idctaperce
		*!*			IF id = CsrProvCtaCon.idctaperce AND CsrPlanCue.id#0
		*!*				lnidcuenta = CsrPlanCue.id
		*!*			ENDIF 
		*!*			IF FOUND() AND id = lnidcuenta
		*!*				SELECT CsrClaseCta
		*!*				LOCATE FOR cnumero=ALLTRIM('PB')
		*!*				thisform.grid1b_generarlinea()
		*!*				.grid1.column1.text1.Value =  CsrPlanCue.cuenta
		*!*				.grid1.column4.text1.Value = ALLTRIM(CsrParaconta.cnombre)+" "+ALLTRIM(CsrProvincia.nombre)
		*!*				.grid1.column1.text1.LostFocus()
		*!*				replace tipoconce WITH 'PB', origen WITH lcorigen , nombreobjeto WITH "IBBA" ;
		*!*				,idprovincia WITH CsrProvincia.id IN CsrauxPlanCue 
		*!*			ENDIF 
		*!*		ENDIF 
			
			&&Cargamos Modelocontable
			*thisform.agregaobjeto.objctacontable('CsrAuxPlanCue',CsrAuxCabefac.idctacte,'thisform.contenedorRegistro.grid1.column3.combo1',0,.t.)
			
			thisform.omodeloctacon1.regisr = 1
			thisform.omodeloctacon1.nidctacte = CsrauxCabefac.idctacte
			thisform.omodeloctacon1.cgrillacombo = 'thisform.contenedorRegistro.grid1.column3.combo1'
			thisform.omodeloctacon1.cargarmodelo()
			&&Este usa el nomprov como detalle
			replace nomprov WITH detalle FOR origen="Z" IN CsrAuxPlanCue
			
			.grid1.Refresh
			SELECT CsrAuxPlanCue
			GO TOP 
			SCAN 
				SELECT CsrClaseCta
				LOCATE FOR ALLTRIM(cnumero) = ALLTRIM(CsrAuxPlanCue.tipoconce)
				cclase		= CsrClaseCta.cnumero
				cnomclase	= CsrClaseCta.cnombre
				.grid1.column3.combo1.Value = cclase
				.grid1.column3.combo1.DisplayValue = cnomclase
				SELECT CsrClaseCta
				.grid1.column3.combo1.lostfocus()
				SELECT CsrAuxPlanCue
			ENDSCAN 
			GO TOP 
			&&Cargamos la cuenta contable del proveedor
			SELECT CsrPlanCue
			LOCATE FOR id = CsrAuxCabefac.idcuenta
			SELECT CsrAuxPlanGravado
			LOCATE FOR id = CsrPlanCue.id
			IF CsrPlanCue.id#CsrAuxPlanGravado.id
				thisform.grid3_generarlinea()
				.grid3.column1.text1.Value =  CsrPlanCue.cuenta
				.grid3.column1.text1.LostFocus()
			ENDIF 
			GO TOP 
			_screen.LockScreen = .f.
			
			SELECT CsrProvincia
			LOCATE FOR id = lnidprovctacte
		ENDWITH 
		
	ENDPROC

	PROCEDURE cargartambodatos		&& Carga el cursor TamboDatos con los datos del tambo de la ctacte
		PARAMETERS lnidctacte
		LOCAL lcCmd,ldvtobruc,ldvtotuber,lcalias
		
		lcalias = ALIAS()
		SET SAFETY OFF
		SELECT TamboDatos
		ZAP
		SET SAFETY ON
		
		IF lnidctacte#0
			&& si la ctacte tiene mas de un tambo, se toma el de menor numero
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT TOP 1 CsrTambo.renspa,CsrTambo.iibb,CsrTambo.vtobrucelosis,CsrTambo.vtotuberculosis
			,CsrTambo.partido,CsrTambo.codlocarca,isnull(CsrProvincia.CodARCALUM,'') as codprovarca
			FROM tambo as CsrTambo
			left join provincia as CsrProvincia on CsrTambo.idprovincia = CsrProvincia.id
			WHERE CsrTambo.idctacte = <<lnidctacte>>
			ORDER BY CsrTambo.numero
			ENDTEXT 
			IF CrearCursorAdapter('CsrTamboAux',lcCmd)
				SELECT CsrTamboAux
				GO TOP 
				IF !EOF()
					ldvtobruc  = IIF(VARTYPE(CsrTamboAux.vtobrucelosis)='T',TTOD(CsrTamboAux.vtobrucelosis),CsrTamboAux.vtobrucelosis)
					ldvtotuber = IIF(VARTYPE(CsrTamboAux.vtotuberculosis)='T',TTOD(CsrTamboAux.vtotuberculosis),CsrTamboAux.vtotuberculosis)
					ldvtobruc  = IIF(YEAR(ldvtobruc)<=1900,{},ldvtobruc)
					ldvtotuber = IIF(YEAR(ldvtotuber)<=1900,{},ldvtotuber)
					INSERT INTO TamboDatos (renspa,iibb,vtobruc,vtotuber,partido,codlocalidad,codprovincia);
						VALUES (CsrTamboAux.renspa,CsrTamboAux.iibb,ldvtobruc,ldvtotuber;
						,CsrTamboAux.partido,CsrTamboAux.codlocarca,CsrTamboAux.codprovarca)
				ENDIF 
				USE IN CsrTamboAux
			ENDIF 
		ENDIF 
		
		IF !EMPTY(lcalias) AND USED(lcalias)
			SELECT (lcalias)
		ENDIF 
		thisform.containerencabeza.Refresh()
		
	ENDPROC

	PROCEDURE cargarvalores
		TEXT TO lcCmdValor TEXTMERGE NOSHOW 
		Select Csrvalor.id, Csrvalor.numero, Csrvalor.nombre, Csrvalor.regisa, Csrvalor.regisb, Csrvalor.regisd, Csrvalor.regisf
		, Csrvalor.regisc,Csrvalor.regisk,Csrvalor.idctabco
		,isnull(Csrvalorctacon.idctaa,0) as idctaa,isnull(Csrvalorctacon.idctab,0) as idctab
		,isnull(Csrvalorctacon.idctad,0) as idctad,isnull(Csrvalorctacon.idctaf,0) as idctaf
		,isnull(Csrvalorctacon.idctac,0) as idctac,isnull(Csrvalorctacon.idctak,0) as idctak
		,Csrclasevalor.numero as clasevalor 
		from valor as Csrvalor 
		left join clasevalor as Csrclasevalor on Csrvalor.idclase = Csrclasevalor.id 
		left join valorctacon as Csrvalorctacon on Csrvalor.id = Csrvalorctacon.idvalor 
		where csrvalor.regisa=1 and CsrValorCtaCon.idejercicio = 
		ENDTEXT 
		
		thisform.actualizafac.cadenavalor = lcCmdValor
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		<<lcCmdValor>>  <<goapp.idejercicio>>
		ENDTEXT 
		
		IF !thisform.obtenerdatos('CsrValor',lcCmd)
			thisform.Release
		ENDIF 
		
	ENDPROC

	PROCEDURE cargarvaloresgravado		&& le asigamos al gravado y el exento los importes de otras cuentas
		&& le cargamos a la cuenta asignada al gravado la sumatoria de las ingresadas
		&& en la grid3
		*GRAVADO
		
		lcidcuenta = "0"
		SELECT CsrAuxPlanGravado
		GO TOP 
		SCAN 
			lcidcuenta = LTRIM(lcidcuenta) + IIF(LEN(LTRIM(lcidcuenta))#0,",",'') + str(CsrAuxPlanGravado.idcuenta,10)
		ENDSCAN 
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Csrplancue.*,isnull(Csrclasecta.cnumero,' ') as clasecta
		from plancue as Csrplancue
		left join clasecta as Csrclasecta on Csrplancue.idclase = Csrclasecta.id
		where (Csrplancue.id in (<<lcidcuenta>>) or CsrPlanCue.id > 0) 
		and CsrPlanCue.idejercicio = <<goapp.idejercicio>> and imputable=1
		ENDTEXT 
		
		IF !thisform.obtenerdatos('CsrPlancue',lccmd)
			thisform.Release 
		ENDIF    
				
		LOCAL lnTotalNG
		lnTotalNG = 0
		SELECT CsrAuxPlanCue
		GO BOTTOM 
		
		SELECT CsrAuxPlanGravado
		GO TOP 
		SCAN 
			IF CsrAuxPlanGravado.gravado=0 AND CsrAuxPlanGravado.exento = 0
				LOOP 
			ENDIF 
			SELECT CsrPlanCue
			LOCATE FOR id = CsrAuxPlanGravado.idcuenta
			IF id = CsrAuxPlanGravado.idcuenta
				lctipo='EX'
				lnEXE	= CsrAuxPlanGravado.exento
				lnNG	= CsrAuxPlanGravado.gravado
				DO WHILE !EMPTY(lctipo)
					IF lctipo='EX' AND lnEXE=0
						lctipo='NG'
						LOOP 
					ENDIF 
					IF lctipo='NG' AND lnNG=0
						EXIT  
					ENDIF 
					thisform.grid1b_generarlinea()
					SELECT CsrPlanCue
					LOCATE FOR id = CsrAuxPlanGravado.idcuenta
					
					.grid1.column1.text1.Value =  CsrPlanCue.cuenta
					.grid1.column2.text1.Value =  CsrPlanCue.nombre
					.grid1.column4.text1.Value = CsrAuxPlanGravado.detalle &&IIF(lctipo='EX','Exento','Gravado')
					.grid1.column5.text1.Value = IIF(lctipo='EX',lnEXE,lnNG)
					.grid1.column1.text1.LostFocus()
		
					replace tipoconce WITH lctipo, origen WITH 'B', detalle WITH  IIF(lctipo='EX','Exento','Gravado');
					,nomprov WITH CsrAuxPlanGravado.detalle,idcuenta WITH CsrAuxPlanGravado.idcuenta ;
					,idprovincia WITH CsrProvincia.id,nombreobjeto WITH lctipo ;
					,tipoconce WITH lctipo IN CsrauxPlanCue
					
					lctipo	= IIF(lctipo='NG','',lctipo)
					lctipo	= IIF(lctipo='EX','NG',lctipo)
				ENDDO 
			ENDIF 
			SELECT CsrAuxPlanGravado
		ENDSCAN 
		
		**************************************
		*** Sugerimos importe iva***************
		************************************
		SELECT CsrAuxPlanCue 
		SUM ALL importe FOR tipoconce='NG' TO lnBaseGra
		SUM ALL tasa FOR tipoconce='IG' AND tasa=21 TO lnBaseIva
		LOCATE FOR numero = 13 AND tasa=21
		IF FOUND()
			lnBaseIva = (lnBaseGra*lnBaseIva)/100
			replace importe WITH lnBaseIVA IN CsrAuxPlanCue
		ENDIF 
		******************************************************
		**	Recorremos la tabla, para actualizar los combos	**
		******************************************************
		_screen.LockScreen = .t.
		SELECT CsrAuxPlanCue
		GO TOP 
		lnRecno = RECNO()
		WITH thisform.contenedorRegistro
		*!*		SCAN 
		*!*			SELECT CsrClaseCta
		*!*			LOCATE FOR cnumero = CsrAuxPlanCue.tipoconce
		*!*			.grid1.column3.combo1.Value = CsrClaseCta.id
		*!*			.grid1.column3.combo1.DisplayValue = CsrClaseCta.cnombre
		*!*			.grid1.column3.combo1.LostFocus()
		*!*			.grid1.column3.combo1.refresh()
		*!*			SELECT CsrAuxPlanCue
		*!*		ENDSCAN 
			SCAN 
				SELECT CsrClaseCta
				LOCATE FOR ALLTRIM(cnumero) = ALLTRIM(CsrAuxPlanCue.tipoconce)
				cclase		= CsrClaseCta.cnumero
				cnomclase	= CsrClaseCta.cnombre
				.grid1.column3.combo1.Value = cclase
				.grid1.column3.combo1.DisplayValue = cnomclase
				SELECT CsrClaseCta
				.grid1.column3.combo1.lostfocus()
				SELECT CsrAuxPlanCue
			ENDSCAN 
		ENDWITH 
		GO lnRecno
		
		_screen.LockScreen = .f.
		
		thisform.ultimocontainer='THISFORM.GRID1'
		
		thisform.grid1b_losfocusimporte()
		
		SELECT CsrauxPlanCue
		GO TOP 
		SKIP 
		thisform.Refresh()
		thisform.KeyPress(18,0)
		
		thisform.contenedorRegistro.grid1.column5.text1.SetFocus()
		thisform.contenedorRegistro.grid1.column5.text1.Click()
			
			
	ENDPROC

	PROCEDURE controlcajacontable
		&&Controlamos que el periodo fiscal pertenezca al ejercicio. Siempre que el pago sea de contado.
		*stop()
		SELECT CsrPlanPago
		LOCATE FOR id = CsrAuxCabefac.idplanpago
		IF NOT CsrPlanPAgo.numero$'CDO'
			RETURN .t.
		ENDIF 
		
		LOCAL lnidejercicio,lnejercicio
		STORE 0 TO lnidejercicio,lnejercicio
		lnidejercicio = 0
		lnejercicio = 0
		lcperiodo 	= RTRIM(CsrAuxmaopera.pefiscal)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrControlEje.id,CsrControlEje.ejercicio FROM DetaConta as CsrControlEje 
		WHERE (CsrControlEje.fecdesde <= '<<lcperiodo+'01'>>' and 
		'<<lcperiodo+'01'>>' <=CsrControlEje.fechasta)
		ENDTEXT 
		IF !CrearCursorAdapter('CsrControlEje',lcCmd)
			RETURN .f.
		ENDIF 
		IF RECCOUNT('CsrControlEje')=0
			oavisar.usuario('OBSERVACIÓN:'+CHR(13);
							+'NO SE ENCONTRO UN EJERCICIO CORRESPONDIENTE AL PERIODO.'+CHR(13);
							+'CONSULTE AL PROGRAMADOR')
			THISFORM.Release
			RETURN .f.
		ENDIF 
		lnidejercicio = CsrControlEje.id
		&&Si el ejercicio del periodo fiscal no es el mismo que el de la caja. No podemos permitirlo
		IF lnidejercicio != goapp.idejercicio
			RETURN .f.
		ENDIF 
		RETURN .t.
		
	ENDPROC

	PROCEDURE controlctacte		&& Contrala el cliente con respecto al vendedor, fuerza vta, etc
		PARAMETERS lnidctacte,lccuitI,lnidcategoria,lnidprovincia,lnidlocalidad
		
		LOCAL lcCmd,lok,msg,lcnomruta,lcvdor,lccuit,lnporperce,lnporrete,lcaliascateibto
		
		*lccuit = STRTRAN(lccuitI,"-","")
		lccuit = STRTRAN(goapp.empresacuit,"-","")
		lcaliascateibto = ""
		
		STORE 0 TO lnporperce,lnporrete
		
		lok = .t.
		msg = 'NO SE PUEDE FACTURAR EL PROVEEDOR '+CHR(13)
		
		*!*	oError=null
		*!*	IF !thisform.agregaobjeto.controlpadronbsas(lnidprovincia,CsrAuxCabefac.fecha,@oError)
		*!*		Oavisar.usuario(msg + CHR(13)+oError.cadena,0)
		*!*		RETURN .f.
		*!*	ENDIF 
		
		TEXT TO lccmd TEXTMERGE NOSHOW 
		SELECT CsrCtacteFlete.* FROM CtacteFlete as CsrCtacteFlete WHERE CsrCtacteFlete.idctacte = <<CsrCtacte.id>>
		ENDTEXT 
		CrearCursorAdapter('CsrCtacteFlete',lccmd)
		IF !RECCOUNT('CsrCtacteFlete')#0
			APPEND BLANK IN CsrCtacteFlete
			replace idctacte WITH CsrCtacte.id, importe WITH 0
		ENDIF 
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select CsrcateCtaCte.*,CAST(0 as numeric(8,3)) as porperce,CAST(0 as numeric(8,3)) as porrete
		from cateCtaCte as CsrcateCtaCte 
		where CsrcateCtaCte.id = <<lnidcategoria>>
		ENDTEXT 
		
		IF USED("CsrCateCtaCte")
			USE IN CsrCateCtaCte
		ENDIF
		
		=CrearCursorAdapter('CsrCateCtaCte',lccmd)
		
		thisform.agregaobjeto.objobteneribto(lccuit,lnidprovincia,@lcaliascateibto,@lnporperce,@lnporrete)
		
		IF RECCOUNT("CsrCateCtaCte")#0
			REPLACE porperce WITH lnporperce,porrete WITH lnporrete IN CsrCateCtacte
		ELSE 	
		   msg = msg+CHR(13)+"NO TIENE ASIGNADO UNA CATEGORIA"+CHR(13)
		   lok = .f.	
		ENDIF 
		
		IF lnidlocalidad=0
		   msg = msg+CHR(13)+"FALTA DEFINIR LOCALIDAD"+CHR(13)
		   lok = .f.
		ENDIF
		
		IF lnidprovincia=0
		   msg = msg+CHR(13)+"FALTA DEFINIR PROVINCIA"+CHR(13)
		   lok = .f.
		ENDIF
		
		IF !lok
		   =Oavisar.usuario(msg,0)
		ENDIF
		
		RETURN lok
		
	ENDPROC

	PROCEDURE controlinicial		&& Controles varios al iniciar el formulario
		IF this.usarcajaactiva
			IF !Leerparametrosdiario(2)
				thisform.Release
			ENDIF 
		ENDIF 
		IF RECCOUNT("Csrprefitermi")=0
		   =Oavisar.usuario("FALTA DEFINIR AL MENOS UN PUNTO DE VENTA PARA LA TERMINAL"+CHR(13)+CHR(13);
		   					+"CONFIGURACION \\ ABM DE PREFIJOS COMPROBANTES")
		   thisform.Release
		ENDIF
		
		IF Csrcomprobante.id=0
			=Oavisar.usuario('NO ES POSIBLE ESTABLECER UN TIPO DE COMPROBANTE'+CHR(13)+CHR(13);
							+'ARCHIVOS GENERALES \\ ABM DE COMPROBANTES'+CHR(13);
			                +'ARCHIVOS GENERALES \\ ABM DE PREFIJOS COMPROBANTES',0)
		   	thisform.release
		ENDIF
		
		
		IF !thisform.pidovendedor()
			RETURN .f.
		ENDIF 
	ENDPROC

	PROCEDURE crearcursor		&& Crea los cursores iniciales, se usa en el load del formulario
		* uso el sele para crear el cursor porque necesito agregar campos que no hay
		SELECT CsrCabecpra.*,00 as copiatkt,0 as idsubcta,SPACE(3) as subnumero,SPACE(40) as detalle,DATETIME() as Vencimien;
		       ,000.00 as bonif1,000.00 as bonif2;
		       ,CAST(0 as numeric(12,0)) as idcuenta;
		       FROM CsrCabecpra WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxcabefac READWRITE  
		
		* datos de la operacion, fecha,terminal,vendedor, etc.
		*
		SELECT Csrmaopera.*,0000000000 as idvdorplan,CAST(0 as int) as iddeposito,SPACE(6) as pefiscal;
				,00000000 AS nrocaja,SPACE(1) as lcoriginal FROM Csrmaopera WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxMaopera READWRITE 
		
		* CsrAuxCuerfac				usado en grid1 para mostrar los productos seleccionados
		SELECT CsrCuercpra.* ,0000000.00 as stock ,CAST(0 as numeric(12,2)) as total ,CAST(0 as n(12,0)) as idcuerfac;
				,CAST(0 as numeric(12,3)) as desctoCiva ,CAST(0 as numeric(12,3)) as DesctoSiva ,000.00 as despor;
				,'  ' as univentachar ,CAST(0 as int) as registro ,' ' as alcohol ,' ' as codvalido;
				,CAST(0 as numeric(12,3)) as internofin ,0 as nofactura ,CAST(0 as int) as idctavta;
				,CAST(0 as numeric(12,3)) as UniCiva ,CAST(0 as numeric(12,3)) as UniSiva ,CAST(0 as numeric(12,3)) as IvaUni;
			   	,CAST(0 as numeric(12,3)) as UniCiva2 ,CAST(0 as numeric(12,3)) as UniSiva2 ,CAST(0 as numeric(12,3)) as IvaUni2;
			   	,CAST(0 as int) as idenvase ,CAST(0 as numeric(12,3)) as cantkilos ,CAST(0 as int) as idctacpra;
			   	,CAST(0 as numeric(12,3)) as preorig ,000.000 as obonif1 ,000.000 as obonif2 ,000.000 as obonif3;
			   	,000.000 as obonif4 ,CAST(0 AS numeric(12,3)) as cantreal ,CAST(0 as numeric(12,3)) as kilosreal;
			   	,CAST(0 as numeric(12,3)) as TotalBonif ,CAST(0 as numeric(12,3)) as Basegra;
				,CAST(0 as numeric(12,3)) as BaseInterno ,CAST(0 as numeric(12,3)) as Baseexe ,0 as VtaKilos;
		     FROM CsrCuercpra WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxCuerfac READWRITE 
		
		* CsrAuxCuervari, variedad del producto
		SELECT CsrCuervaricpra.*, 000 as pos,CAST(0 AS numeric(12,3)) as cantreal FROM CsrCuervaricpra WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxCuervari READWRITE 
		
		* usado para mostrar comprobantes afectados
		CREATE CURSOR CsrAuxMovAfectado (id N(12,0),fecha d,detalle c(40),vence d,importe n(11,2),saldo n(11,2),saldori n(11,2),afecta n(12,2)) 
		
		
		* usado impuestos ya cargados
		CREATE CURSOR CsrAuxPlancue (cuenta n(5),nombre c(80),detalle c(80),nomprov c(40),importe n(11,2),tasa n(5,2);
				,impuesto n(11,2),idprovincia i,idcuenta n(12,0),tipoconce c(2),registro i AUTOINC,origen c(1),id n(12,0);
				,nombreobjeto C(5),numero i,idclase i, bonif n(11,2))
				
		* usado para cargar cuentas que afecten gravado y exento
		
		CREATE CURSOR CsrAuxPlanGravado (cuenta n(5),nombre c(40),detalle c(40),nomprov c(20),gravado n(11,2),exento n(11,2);
				,idcuenta n(12,0),tipoconce c(2),registro i AUTOINC,origen c(1),id i,nombreobjeto C(5))
		
		* para actualizar existencia
		SELECT CsrExistenc.* FROM CsrExistenc WHERE RECNO()=1 AND id=0 INTO CURSOR CsrAuxExistenc READWRITE 
		SELECT CsrAuxExistenc
		INDEX on STRID(idarticulo,10)+STRID(idsubarti,10)+STRID(iddeposito,10) TAG articulo
		
		Create CURSOR CsrimpCab (grupo c(1),Campo001 c(30),Campo002 c(10),Campo003 c(30),Campo004 c(15),Campo005 c(15);
			  				,Campo006 c(40),Campo007 c(40),Campo008 c(40),Campo009 c(30),Campo010 c(13);
							,Campo011 c(50),Campo012 c(50),Campo013 c(50),Campo014 c(50),Campo015 c(50);
							,Campo016 c(13),Campo017 c(13),Campo018 c(13),Campo019 c(30),Campo020 c(30);
							,Campo021 c(30),Campo022 c(30),Campo023 c(30),Campo024 c(30),Campo025 c(30);
							,Campo026 c(30),Campo027 c(30),Campo028 c(30),Campo029 c(13),Campo030 c(13);
							,Campo031 c(13),Campo032 c(13),Campo033 c(13),Campo034 c(13),Campo035 c(13),Campo036 c(13))
		SELECT CsrImpCab
		INDEX on grupo TAG grupo
		
			  				
		Create CURSOR CsrimpCue (grupo c(1),Campo001 c(10),Campo002 c(10),Campo003 c(50),Campo004 c(17),Campo005 c(13);
					,Campo006 c(8),Campo007 c(13),Campo008 c(13),campo009 c(15),pos i)
		SELECT CsrimpCue
		INDEX on grupo+campo001+STR(pos) TAG grupo
		INDEX on pos TAG POS
		
		&& para cargar las cuotas en registracion
		CREATE CURSOR CsrauxCuotas (cuota n(3,0),vencimien d,total n(13,2))
		
		&& datos del tambo de la ctacte (RENSPA, IIBB, vencimientos, ubicacion ARCA)
		CREATE CURSOR TamboDatos (renspa c(20),iibb c(20),vtobruc d,vtotuber d,partido c(100),codlocalidad n(6),codprovincia c(2))

		&& Datos de la liquidacion que se envian a ARCA (ContenedorLiq). F = de liqlacteo; M = los carga el operador del impreso
		CREATE CURSOR LiqDatos (litros n(13,2),grasa n(7,2),proteina n(7,2),kggrasa n(13,2),kgproteina n(13,2),preciokg n(13,2);
			,total n(15,2),pctiva n(5,2),iva n(15,2);
			,baseperiva n(15,2),pctperiva n(5,2),periva n(15,2);
			,baseperiibb n(15,2),pctperiibb n(5,2),periibb n(15,2);
			,totimpuestos n(15,2),neto n(15,2),cae c(14),vtocae d;
			,ptovtaliq n(4),nroliq n(8),idmaoperaliq n(12),caeajuste c(14),tipoajuste c(10))	&& NC/ND: liquidacion original (cabeLiq.idmaoperaliq / caeajuste)
		APPEND BLANK IN LiqDatos
	ENDPROC

	PROCEDURE editartotales		&& Permite editar los totales
		PARAMETERS lntipo
		lntipo = IIF(PCOUNT()<1,1,lntipo)
		&& =1 habilito txtbox
		&& =2 recalculo plancue
		*thisform.ultimocontainer='THISFORM.GRID2'
		lbcalculo = .f.
		
		IF thisform.consultando
			lntipo = 0
		ENDIF 
		
		IF lntipo=1
			WITH thisform.containertotales
				llok = .t.
				IF !thisform.esbonifica
					thisform.ultimocontainer='CONTAINERTOTALES'
					lbcalculo = llok
					.enabled = llok
					._txtsubtotalNG.enabled = llok
					._txtbonifNG.enabled = llok
					._txtsubtotalEX.enabled = llok
					._txtbonifEX.enabled = llok
				ENDIF 
				IF thisform.esrecodevol
					thisform.ultimocontainer='CONTAINERTOTALES'
					lbcalculo = llok
					.enabled = llok
					._txtsubtotalNG.enabled = llok
					._txtrecodevolNG.enabled = llok
					._txtsubtotalEX.enabled = llok
					._txtrecodevolEX.enabled = llok
				ENDIF 
				
				._txtSubtotalNG.setfocus()
			ENDWITH 
		ENDIF 
		
		IF lntipo=2
			SELECT CsrAuxPlanCue
			WITH thisform.containertotales
				lnsubtotal 	= ._txtSubTotalNG.Value
				lnbonif		= ._txtBonifNG.Value
				lnRecon		= ._txtRecoDevolNG.Value
				._txtTotalNG.Value	= ROUND(lnSubtotal - (lnBonif + lnRecon),3)
				replace ALL importe WITH ._txtTotalNG.Value FOR tipoconce = 'NG' AND origen='A'
				replace ALL impuesto WITH importe * tasa / 100 FOR tipoconce = 'NG' AND origen='A'
				lnsubtotal 	= ._txtSubTotalEX.Value
				lnbonif		= ._txtBonifEX.Value
				lnRecon		= ._txtRecoDevolEX.Value
				._txtTotalEX.Value	= ROUND(lnSubtotal - (lnBonif + lnRecon),3)
				replace ALL importe WITH ._txtTotalEX.Value FOR tipoconce = 'EX' AND origen='A'
				lbcalculo = .f.
			ENDWITH 
		ENDIF 
					
		IF !lbcalculo
			cleartec()
			WITH thisform.containertotales
				llok = lbCalculo
				.enabled = llok
				._txtsubtotalNG.enabled = llok
				._txtbonifNG.enabled = llok
				._txtsubtotalEX.enabled = llok
				._txtbonifEX.enabled = llok
				._txtrecodevolNG.enabled = llok
				._txtrecodevolEX.enabled = llok
				
			ENDWITH 
			WITH thisform
				*.ultimocontainer='THISFORM.GRID2'
				IF lntipo#0
					.totalcomprobante(3)
				ENDIF 
				.grid1.Visible = .t.
				.grid1_generarlinea()	   
				.grid1.column1.text1.SetFocus 
				.grid1.column1.text1.Click()
			ENDWITH 
			GO BOTTOM  IN CsrAuxPlanCue
		ENDIF 
	ENDPROC

	PROCEDURE generarcuotas
		&& segun el importe total y la cantidad de cuotas generamos las cuotas
		LOCAL lnnrocuota , lndifdias , lnimporte, lntotal, lnnro
		STORE 0 TO lnnrocuota , lndifdias , lnimporte, lntotal, lnro
		
		WITH thisform.ContainerEnCabeza
			this.lblayudapie.Caption = "[Esc]Retrocede a Impuestos   [ + ]Graba"
			lnnrocuotas	 = IIF(._txtnrocuotas.value=0,1,._txtnrocuotas.value)
			lndifdias	 = IIF(._txtdias.value=0,0,._txtdias.value)
			
		ENDWITH 
		lnimporte = thisform.containertotales._txttotal.Value
		IF lnimporte=0
			oavisar.usuario("No se registraron importes a registrar")
			thisform.ultimocontainer = "THISFORM.GRID2"
			thisform.k_escape()
			RETURN 
		ENDIF 
		
		thisform.contenedorRegistro.grid4.recordsource = ""
		SET SAFETY OFF 
		SELECT CsrAuxCuotas
		ZAP 
		SET SAFETY ON
		
		thisform.contenedorRegistro.grid4.recordsource= "CsrAuxCuotas"
		ldfechafac    = TTOD(CsrAuxCabefac.fecha)
		lndifdias	 = IIF(lndifdias = 0,TTOD(Csrauxcabefac.vencimien) - ldfechafac,lndifdias)
		lntotal = lnimporte / lnnrocuotas
		lntotalfac= lnimporte
		* recorremos todas menos la ultima, donde compensaremos diferencias al dividir
		
		FOR lnro = 1 TO lnnrocuotas - 1
			thisform.grid4_generarlinea(lnro,lntotal,ldfechafac)
			ldfechafac = ldfechafac + lndifdias
			lntotalfac = lntotalfac - lntotal
		ENDFOR 
		lntotal = lntotalfac
		thisform.grid4_generarlinea(lnro,lntotal,ldfechafac)
		
		thisform.ultimocontainer ='THISFORM.GRID4'
		SELECT CsrauxCuotas
		GO TOP 
		SUM ALL total TO lntotal 
		lndif = lnimporte - lntotal 
		
		*si el total de cuotas difiere del total comprobante. sumamos a la primera cuota la diferencia
		IF lndif<>0
			SELECT CsrAuxCuotas
			GO TOP 
			replace total WITH total + lndif 
		ENDIF 
		SELECT CsrAuxCuotas
		SUM ALL total TO lntotal 
		GO TOP 
		
		WITH thisform.contenedorRegistro
			.grid4.recordsource= "CsrAuxCuotas"
			.grid4.column1.ControlSource = "CsrAuxCuotas.cuota"
			.grid4.column2.ControlSource = "CsrAuxCuotas.vencimien"
			.grid4.column3.ControlSource = "CsrAuxCuotas.total"
			.grid4.Visible = .t.
			.grid4.column2.text1.SetFocus()
			._texttotal.Value = lntotal
			._texttotal.visible = .t.
		ENDWITH 
		
	ENDPROC

	PROCEDURE grabarborrado
		LOCAL lcidmaopera,ldfechaserver,lok,ldfechafac
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		WITH thisform
			loObjNeg        = .GetRefObjneg('thisform.Odatamaopera')
			loObjTabasto    = .GetRefObjneg('thisform.OdataTabasto')
			loObjTabimpu    = .GetRefObjneg('thisform.OdataTabimpu')
			loObjMovCtacte  = .Getrefobjneg('thisform.OdataMovCtacte')
			loObjMovBcoCar  = .getrefobjneg('thisform.OdataMovbcoCar')
			loObjMovCaja    = .getrefobjneg('thisform.odatamovcaja')
			loObjCabefac    = .getrefobjneg('thisform.odatacabefac')
			loObjMovstock   = .getrefobjneg('thisform.odatamovstock')
			loObjExistenc   = .getrefobjneg('thisform.odataexistenc')
			loObjAfeCtacte  = .getrefobjneg('thisform.OdataAfectacte')
			loObjanmaopera  = .getrefobjneg('thisform.Odataanmaopera')
			loObjidasociado = .getrefobjneg('thisform.Odataidasociado')
			loObjAfebcocar  = .getrefobjneg('thisform.OdataAfebcocar')
			loObjCabeAsi    = .GetRefObjneg('thisform.OdataCabeasi')
			loObjMovBcoDeta    = .GetRefObjneg('thisform.OdataMovBcoDeta')
			
			lObjParametro = .objgrabadato
			lObjParametro.lcaliasComp  = "CsrCompAux"
			lObjParametro.clasecomp    = Csrcomprobante.clase
			lObjparametro.compabrevia  = Csrcomprobante.cabrevia
			lObjParametro.lcintablaori = "FACP"
			
			SELECT CsrAuxMaopera
			lcidmaopera = ""
			GO TOP 
			SCAN 
				lcidmaopera  = LTRIM(lcidmaopera)+IIF(LEN(LTRIM(lcidmaopera ))#0,',',"")+STRid(csrauxmaopera.id)
			ENDSCAN 
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT CsrMaopera.* FROM Maopera as CsrMaopera WHERE id in (<<lcidmaopera>>)
			ENDTEXT 
			IF !thisform.obtenerdatos('CsrMaopera',lcCmd)
				this.cadenaerrores = ""
				RETURN .f.
			ENDIF 
			
			lbDeboLeerAsto = .t.
			SELECT CsrAuxMaopera
			SCAN 
					
				lcidmaopera  = CsrAuxMaopera.id
		
				SELECT CsrAuxMaopera
				SCATTER NAME Oscmaopera
				
				SELECT CsrMaopera
				LOCATE FOR id = CsrAuxMaopera.id
				* operacion actual marco como anulado
				REPLACE estado WITH "1" IN Csrmaopera	
						
			    OscMaopera.pefiscal    = CsrPARACONFIG.pefiscal	
				OscMaopera.idcomproba  = VAL(.idcompanulacion)
				OscMaopera.clasecomp   = 'K'
				OscMaopera.fechasis    = ldfechasis
				OscMaopera.fechaserver = ldfechaserver
				
				loObjNeg.agregar
				SELECT CsrMaopera
				GATHER NAME OscMaopera FIELDS EXCEPT id
		
				SCATTER NAME Oscmaopera ADDITIVE 
						
				loObjanmaopera.agregar
				REPLACE idmaopera WITH OscMaopera.id,idafecta WITH lcidmaopera,detalle WITH OscMaopera.numcomp,idmotanula WITH 0 IN Csranmaopera
				
				&&Es lo primero que hacemos para usar la fecha contable como la de anulacion
				IF !.actualizafac.controlcajaactiva(OscMaopera)
					.cadenaerrores ='Se CANCELO la grabación' +CHR(13)+'Porque se CERRO LA CAJA.'
					RETURN .f.
				ENDIF 	
						
				SELECT CsrAuxCabefac
				SCATTER NAME OscCabefac
				
				lObjParametro.idctacte  = OscCabefac.idctacte
				lObjParametro.ctacte    = OscCabefac.ctacte
				lObjParametro.subnumero = OscCabefac.subnumero
				lObjParametro.idsubcta  = OscCabefac.idsubcta
				lObjparametro.cnombre   = OscCabefac.cnombre
				lObjparametro.idorigen  = OscMaopera.id
				lObjParametro.importe   = OscCabefac.total
				lObjParametro.total     = OscCabefac.total
				
				lObjParametro.detalle	= 'Anula '+OscMaopera.detalle
				lObjParametro.fecha     = FechaHoraCero(OscMaopera.fechasis)&&FechaHoraCero(ldfechaserver)
				
				IF CsrAuxMaopera.lcOriginal='B'
					* en el auxmaopera, tiene los maopera de los asientos relacionados
					*.actualizafac.grabarcabeasi(OscMaopera,lObjParametro,lbDeboLeerAsto)
					.actualizafac.borroasto(lcidmaopera,OscMaopera,lObjParametro,lbDeboLeerAsto)
					lbDeboLeerAsto = .f.
					LOOP 
				ENDIF 
				
				.actualizafac.leerctacte()			
				.actualizafac.borromovctacte(lcidmaopera,OscMaopera,lObjParametro)
				.actualizafac.borromovbco(lcidmaopera,OscMaopera,lObjParametro,.f.)		
				.actualizafac.borrostock(lcidmaopera,OscMaopera)
				*.actualizafac.grabarcabeasi(OscMaopera,lObjParametro,lbDeboLeerAsto)
				.actualizafac.borroasto(lcidmaopera,OscMaopera,lObjParametro,lbDeboLeerAsto)
				SELECT CsrAuxMaopera
				lbDeboLeerAsto = .f.
			ENDSCAN 
			
			.actualizafac.grabarexistencia()
			
			cCadena = ""
			IF NOT this.Actualizafac.controlasto(@cCadena)
				.cadenaerrores = cCadena
				RETURN .f.
			ENDIF 
			
			
			llok = loObjNeg.Salvar('CsrMaopera')
		                    
			IF !llok
		   		=.cadenaerrores = loObjNeg.cadenaerror
			ENDIF 
			 
		ENDWITH
		
		loObjNeg       = null 	       
		loObjTabasto   = null 
		loObjTabimpu   = null
		loObjMovCtacte = null
		loObjMovBcoCar = null 
		loObjMovCaja   = null
		loObjCabefac   = null
		loObjMovstock  = null
		loObjExistenc  = null
		loObjAfeCtacte = null
		loObjanmaopera = null
		loObjidasociado = null
		lObjparametro  = null
		loObjAfebcocar = null 
		loObjCabeAsi    = null
		loObjMovBcoDeta  = null
		
		RETURN llok
		
	ENDPROC

	PROCEDURE grabardato		&& Graba datos

		&& LUM (F normal / M manual): la grabacion la hace el SP sp_gms_liqlactea_grabar
		IF thisform.tipoform$'FM'
			RETURN thisform.grabarliqlactea()
		ENDIF

		LOCAL ldfechaserver,lok,ldfechafac,lntipoasto,ldfechaemision
		
		ldfechaserver = Csrparaconfig.fechaserver
		ldfechafac    = FechaHoraCero(Csrparaconfig.fechafac)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Getdate() as fecha
		ENDTEXT
		IF USED("Servidor")
			USE IN Servidor
		ENDIF
		lok =CrearCursorAdapter("Servidor",lcCmd) 
		IF lok
			ldfechaserver = Servidor.fecha
			IF USED("Servidor")
				USE IN Servidor
			ENDIF
		ENDIF
		
		ldfechasis 	  = FechaHoraCero(ldfechaserver)
		
		loObjNeg        = thisform.GetRefObjneg('thisform.Odatamaopera')
		loObjTabasto    = thisform.GetRefObjneg('thisform.OdataTabasto')
		loObjTabimpu    = thisform.GetRefObjneg('thisform.OdataTabimpu')
		loObjMovCtacte  = thisform.Getrefobjneg('thisform.OdataMovCtacte')
		loObjCtacte     = thisform.getrefobjneg('thisform.OdataCtacte')
		loObjMovBcoCar  = thisform.getrefobjneg('thisform.OdataMovbcoCar')
		loObjMovCaja    = thisform.getrefobjneg('thisform.odatamovcaja')
		loObjMovTarjeta = thisform.getrefobjneg('thisform.odataMovtarjeta')
		loObjCabefac    = thisform.getrefobjneg('thisform.odatacabefac')
		loObjCuerfac    = thisform.getrefobjneg('thisform.odatacuerfac')
		loObjMovstock   = thisform.getrefobjneg('thisform.odatamovstock')
		loObjExistenc   = thisform.getrefobjneg('thisform.odataexistenc')
		loObjAfeCtacte  = thisform.getrefobjneg('thisform.OdataAfectacte')
		loObjCabedeta   = thisform.Getrefobjneg('thisform.OdataCabedeta')
		loObjidasociado = thisform.getrefobjneg('thisform.Odataidasociado')
		loObjAfebcocar  = thisform.getrefobjneg('thisform.OdataAfebcocar')
		loObjCabeAsi    = thisform.GetRefObjneg('thisform.OdataCabeasi')
		loObjCuervari   = thisform.getrefobjneg('thisform.odatacuervari')
		loObjProducto  	= thisform.GetRefObjneg('thisform.OdataProducto')
		loObjCbioPrecio = thisform.GetRefObjneg('thisform.OdataCbioPRecio')
		loObjAlerta 	= thisform.GetRefObjneg('thisform.OdataAlertas')
		loObjMovBcoDeta = thisform.GetRefObjneg('thisform.OdataMovBcoDeta')
		loObjAfeasto	= thisform.GetRefObjneg('thisform.OdataAfeasto')
		loObjAfeCabeCpra	= thisform.GetRefObjneg('thisform.OdataAfeCabeCpra')
		
		lObjParametro = thisform.objgrabadato
		lObjParametro.lcaliasComp  = "CsrCompAux"
		lObjParametro.clasecomp    = Csrcomprobante.clase
		lObjparametro.compabrevia  = Csrcomprobante.cabrevia
		lObjParametro.lcintablaori = "FACP"
		lObjParametro.switchctacte = "00000" &&23/01/2012
		
		lObjTotalizador = null
		thisform.agregaobjeto.objtotalizador(@lObjTotalizador)
		WITH thisform.containertotales
			lObjTotalizador.TotalNG = ._txtSubTotalNG.Value	
			lObjTotalizador.BonifNG = ._txtbonifNG.value		
			lObjTotalizador.DevolNG = ._txtrecodevolNG.value	
			lObjTotalizador.TotalEX = ._txtSubTotalEX.Value	
			lObjTotalizador.BonifEX = ._txtbonifEX.value		
			lObjTotalizador.DevolEX = ._txtrecodevolEX.value	
		ENDWITH 
		
		SELECT CsrAuxMaopera
		SCATTER NAME Oscmaopera
		Oscmaopera.detalle=Lobjparametro.detalle
		OscMaopera.idcomproba  = thisform.containerencabeza._cbocomprobante.Value
		OscMaopera.clasecomp   = Csrcomprobante.clase
		OscMaopera.numcomp 	   = thisform.proximonro
		OscMaopera.fechasis    = ldfechasis
		OscMaopera.fechaserver = ldfechaserver
		OscMaopera.switch = '00000'
		IF thisform.tipoform = 'R'
			OscMaopera.switch = '00001'
		ENDIF 	
		loObjNeg.agregar
		SELECT CsrMaopera
		GATHER NAME OscMaopera FIELDS EXCEPT id
		
		SCATTER NAME Oscmaopera ADDITIVE 
		
		* actualizafac esta en clase odata
		
		SELECT CsrauxCabefac
		REPLACE pefiscal WITH OscMaopera.pefiscal
		SCATTER NAME OscCabefac
		lObjparametro.cnombre 	= OscCabefac.cnombre
		lObjparametro.detalle	= ALLTRIM(lObjparametro.compabrevia+' '+OscMaopera.numcomp+' - '+lObjparametro.cnombre)
		Oscmaopera.detalle		= lObjparametro.detalle
		lObjParametro.fecha		= OscCabefac.fecha	
		
		SELECT CsrMaopera
		Oscmaopera.detalle=Lobjparametro.detalle
		GATHER NAME OScMaopera FIELDS EXCEPT id
		SCATTER NAME Oscmaopera ADDITIVE 
		
		OscMaopera.fechasis		= OscCabefac.fecha &&Cabeasi
		
		WITH thisform
			IF !.actualizafac.controlcajaactiva(OscMaopera)
				.cadenaerrores ='Se CANCELO la grabación' +CHR(13)+'Porque se CERRO LA CAJA.'
				RETURN .f.
			ENDIF 	
			
			.actualizafac.grabarcabecpra(OscMaopera)
			lObjParametro.idorigen = OscCabefac.id
			.actualizafac.leerctacte()
			.actualizafac.leermovctacte(OscCabefac)
			
			IF RECCOUNT('CsrAuxCuotas')#0
				*stop()
				SELECT CsrAuxCuotas
				lntotcuota = .ContainerEnCabeza._txtnrocuotas.Value
				.actualizafac.generarcuotactacte(OscMaopera,OscCabefac,lObjparametro,lntotcuota)
			ELSE 
				*stop()
				.actualizafac.generarctacte(OscMaopera,OscCabefac,lObjparametro)
			ENDIF 
			lntipoasto=IIF(.tipoform='R',2,1) && Depende de como registro hago el asiento
			IF lntipoasto=2
				&&le cargamos en el nombre de concepto la provincia para los totales de percepciones.
				&&ahora para grabar le ponemos IBTO2 para los reportes
				replace ALL nombre WITH "",detalle WITH nomprov IN CsrAuxPlanCue
				replace ALL nombre WITH 'IBTO2' FOR tipoconce='PB' IN CsrAuxPlanCue
			ENDIF 
			.actualizafac.grabarpago(OscMaopera,lObjparametro)
			.actualizafac.grabarcabeasi(OscMaopera,lObjParametro)
			.actualizafac.grabarastocpra(OscMaopera,lObjparametro,lntipoasto)
			.actualizafac.grabarotrostotales(OScMaopera,lObjParametro,lObjTotalizador)
			.actualizafac.grabarexistencia()
			*stop()
			lSoloCbioPost = IIF(goapp.codempresa = 7, .t.,.f.)
			.actualizafac.cbioprecio(OscMaopera,lObjparametro,thisform.incluyeiva)
			
			ldfecha = .containerencabeza._txtfecha.value
			lnfechacaja = LTRIM(STR(YEAR(ldfecha)))+LTRIM(STRzero(month(ldfecha),2))
			lnperiodo = .containerencabeza._txtperiodo.value
			.actualizafac.controlperiodo(OscMaopera,lObjparametro,lnfechacaja,lnperiodo)
			
			
			&&Si existe un comprobante original
			IF this.generandolote AND USED('FsrAuxOpera')
				*1-El lote es unico, no se acarrea.
				*2-Selete max nrolote para un nuevo
				TEXT TO lcCmdMax TEXTMERGE NOSHOW 
				SELECT 'B' as orden,MAX(nrolote) as nrolote FROM AfeCabeCpra as CsrAfeCabeCpra 
				ENDTEXT 
				IF !CrearCursorAdapter('CsrMaxNroLote',lcCmdMax)
					RETURN .f.
				ENDIF 
				lnNroLote = 1
				IF RECCOUNT('CsrMaxNroLote')#0
					*Solo puede ser A o B. Si no existe A, hago por B, para asegurar q halla un valor.
					SELECT CsrMaxNroLote
					LOCATE FOR orden='A'
					IF !orden='A'
						LOCATE FOR orden='B'
					ENDIF 
					lnNroLote = NVL(CsrMaxNroLote.nrolote,0) + 1
				ENDIF 
				SELECT FsrAuxOpera
				GO TOP 
				SCAN 
					loObjAfeCabecpra.agregar
					replace idorigen WITH OscCabefac.id,idmaoperao WITH OscMaopera.id;
							,idafecta WITH FsrAuxOpera.id,idmaoperaa WITH FsrAuxOpera.idmaopera;
							,nrolote WITH lnNroLote,switch WITH '00000' IN CsrAfeCabeCpra
				ENDSCAN 
			ENDIF 
			
		ENDWITH
		
		SELECT CsrCbioPrecio
		vista()
		
		llok = loObjNeg.Salvar('CsrMaopera')
		IF !llok
			 thisform.cadenaerrores = loObjNeg.cadenaerror
		ENDIF 
		
		loObjNeg       = null 	       
		loObjTabasto   = null 
		loObjTabimpu   = null
		loObjMovCtacte = null
		loObjCtacte    = null 
		loObjMovBcoCar = null 
		loObjMovCaja   = null
		loObjMovTarjeta = null
		loObjCabefac   = null
		loObjCuerfac   = null
		loObjMovstock  = null
		loObjExistenc  = null
		loObjAfeCtacte = null
		loObjCabedeta  = null	    
		loObjidasociado = null
		loObjAfebcocar = null
		lObjparametro  = null
		loObjCuervari  = null
		loObjCabeAsi    = null
		loObjProducto  	= null
		loObjCbioPrecio = null
		loObjMovBcoDeta    = null
		
		RETURN llok
		
	ENDPROC

	PROCEDURE grid1b_generarlinea
		LOCAL Oscatter,lcCtrlSource,lcalias,AcolOdataNavega,lnkeyCode,lcnombre
		STORE '' TO lcCtrlSource,AcolOdataNavega
		lcAlias = "CsrAuxPlancue"
		
		WITH thisform
		
			_screen.LockScreen = .t.
		    .bindergridoff('thisform.contenedorregistro.grid1',@lcalias,@lcCtrlSource,@AcolOdataNavega)
			
		*!*		SET SAFETY OFF 
			SELECT CsrAuxPlancue
		*!*		ZAP 
		*!*		SET SAFETY ON 
			
		    lcnombre = nombre
		    lnkeyCode = 13
		    SKIP 
		    IF (EOF() AND BOF()) OR (EOF() AND LEN(TRIM(lcnombre))#0)
		   	   lnKeycode = 22
		    ENDIF 
			IF lnKeyCode=22			&&insert
				APPEND BLANK 
				replace numero WITH  CsrParaConta.numero,idprovincia WITH CsrAuxCabefac.idprovincia IN CsrAuxPlancue
				
			ENDIF 				
				lnrecno = RECNO() 			
			GO TOP 
		    .grid1.coLUMN3.combo1.RowSource = "CsrClaseCta.cnombre,id"
		    .bindergridon('thisform.contenedorregistro.grid1',lcalias,lcCtrlSource,AcolOdataNavega)
			GO lnrecno
			.grid1.coLUMN3.combo1.refresh()
			.grid1.refresh()
			_screen.LockScreen = .f.
			GO TOP 
			GO BOTTOM 
			.grid1.column1.text1.SetFocus 
		ENDWITH 
	ENDPROC

	PROCEDURE grid1b_keypress
		PARAMETERS nKeyCode
		LOCAL llok
		llok = .f.
		WITH thisform
			IF ALLTRIM(strzero(nkeyCode,3))$"004" 
				IF STRzero(CsrAuxPlanCue.numero,2)$'13-34'
					llok = .t.
					.contenedorRegistro.grid1.column6.enabled = .t.
					.contenedorRegistro.grid1.column6.SetFocus()
				ELSE 
					.contenedorRegistro.grid1.column6.enabled = .F.
					.ContenedorRegistro.Grid1.Column5.text1.Setfocus()
					.ContenedorRegistro.Grid1.Column5.text1.Click()
					*KEYBOARD '{DNARROW}'
					
				ENDIF 
			ENDIF 
		ENDWITH 
		RETURN llok 
	ENDPROC

	PROCEDURE grid1b_losfocus
	ENDPROC

	PROCEDURE grid1b_losfocusimporte
		&& si el campo es de gravado entonces abrimos la ventana
		thisform.lblayudapie.Caption = "[Esc]Retrocede a Proveedor   [ + ]Graba   [F3] Cargar Gravado/Exento" 	 
		thisform.ultimocontainer     ="THISFORM.GRID1" 
		
		WITH thisform.contenedorRegistro
			.grid1.column7.visible = .f.
			.grid1.column8.visible = .f.
			.grid1.column9.visible = .f.
			.grid1.column1.text1.Enabled = .f.
			.grid1.column4.text1.Enabled = .f.
			.grid1.column7.text1.Enabled = .f.
			.grid1.column8.text1.Enabled = .f.
			.grid1.column9.text1.Enabled = .f.
			IF CsrAuxPlanCue.numero=13  &&AND CsrAuxPlancue.tasa<>0 AND CsrauxPlanCue.importe = 0
				.grid3.column6.text1.enabled = .t.
				.grid3.column6.text1.SetFocus()
				.grid3.column5.text1.Enabled = .f.
				.grid3.column6.text1.SetFocus()
			ENDIF 
		ENDWITH 
	ENDPROC

	PROCEDURE grid1b_lostfocustasa
		&& en el caso del iva que es cambiable, despues de cargarlo vuelvo al
		&& uso normal
		WITH thisform.contenedorRegistro.grid1
			lnrecno = RECNO()
			IF !CsrCategoiva.fiscal$'M' AND CsrAuxPlanCue.tipoconce$"NG-IG"
			 	SELECT CsrauxPlancue
				SUM importe FOR tipoconce='NG' TO lnimporte
				LOCATE FOR numero = 13
				GO lnrecno
				
				replace importe WITH (lnimporte*tasa)/100
				*.column5.text1.Value = (lnimporte*.column6.text1.Value)/100
			ELSE
				IF CsrCategoiva.fiscal$'M' 
					SELECT CsrauxPlancue
					LOCATE FOR numero = 13
					replace tasa WITH 0 IN CsrAuxPlanCue
					.column6.text1.Value = 0
					GO 	lnrecno
				ENDIF 
			ENDIF 
			
			SKIP IN CsrAuxPlanCue
			.column5.text1.Enabled = .t.
			.column5.text1.SetFocus()
			.column6.text1.Enabled = .f.
		ENDWITH 
	ENDPROC

	PROCEDURE grid1b_procesarlinea
		PARAMETERS lnKeyCode
		
		LOCAL lok
		
		lok = IIF(lnKeyCode = 27,.f.,.t.)
		
		IF lok 
		    *thisform.totalcomprobante(2)
			thisform.grid1b_generarlinea() 
			*thisform.totalregistracion()  
		ELSE
			thisform.containerencabeza._txtfecha.SetFocus
			thisform.containerencabeza._txtfecha.Click
			*thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
			*thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.Click()   
		ENDIF    
	ENDPROC

	PROCEDURE grid1_controllinea		&& controles de la grid1 para procesar
		&&Controles de la grilla
		LOCAL llok
		llok = .t.
		
		SELECT CsrAuxPlanCue
		lnrecno = RECNO()
		
		IF CsrAuxPlanCue.tasa< 0
			replace tasa WITH 0, impuesto WITH 0
		ENDIF 
		
		GO lnrecno
		RETURN llok 
		
	ENDPROC

	PROCEDURE grid1_generarlinea		&& Genera el registro para inserccion / modificacion producto, sobre cursor Csrauxplancue
		*!*	LOCAL Oscatter,lcCtrlSource,lcalias,AcolOdataNavega,lnkeyCode,lcnombre
		*!*	STORE '' TO lcCtrlSource,AcolOdataNavega
		*!*	lcAlias = "CsrAuxPlancue"
		
		*!*	WITH thisform
		*!*		.grid1.coLUMN3.combo1.RowSource = "" && gabriel
		*!*		_screen.LockScreen = .t.
		*!*		.bindergridoff('thisform.grid1',@lcalias,@lcCtrlSource,@AcolOdataNavega)
		*!*		SELECT CsrAuxPlancue
		*!*		lnrecno = RECNO()
		*!*		lcnombre = nombre	
		*!*		lnkeyCode = 13
		*!*	    SKIP 
		*!*	    IF (EOF() AND BOF()) OR (EOF() AND LEN(TRIM(lcnombre))#0)
		*!*	   	   lnKeycode = 22
		*!*	    ENDIF 
		*!*		IF lnKeyCode=22			&&insert
		*!*			APPEND BLANK 
		*!*			replace idprovincia WITH CsrAuxCabefac.idprovincia
		*!*		ENDIF 				
		*!*		*lnrecno = RECNO() 			
		*!*		GO TOP 
		*!*	    .grid1.coLUMN3.combo1.RowSource = "CsrClaseCta.cnombre,id"
		*!*	    .bindergridon('thisform.grid1',lcalias,lcCtrlSource,AcolOdataNavega)
		*!*		GO lnrecno
		*!*		*SKIP 
		*!*		.grid1.coLUMN3.combo1.refresh()
		*!*		.grid1.refresh()
		*!*		_screen.LockScreen = .f.
		*!*		GO TOP 
		*!*		GO lnrecno
		*!*		SKIP 
		*!*		.grid1.column1.text1.SetFocus 
		*!*	ENDWITH 
		
		PARAMETERS lnkeyCode
		lnKeyCode = IIF(PCOUNT()<1,22,lnKeyCode)
		
		
		LOCAL Oscatter,lcCtrlSource,lcalias,AcolOdataNavega
		STORE '' TO lcCtrlSource,AcolOdataNavega
		lcAlias = "CsrAuxPlancue"
		
		SELECT CsrAuxPlancue
		IF RECNO()<RECCOUNT() AND RECCOUNT()#0 
			*lnKeyCode = 13
			GO RECCOUNT()
			*RETURN 
		ENDIF  
		
		WITH thisform
			_screen.LockScreen = .t.
		    .bindergridoff('thisform.grid1',@lcalias,@lcCtrlSource,@AcolOdataNavega)
			DO CASE 
				CASE lnKeyCode=22			&&insert
					SELECT CsrAuxPlancue
					IF idcuenta#0 OR LEN(TRIM(nombre))#0 OR RECCOUNT()=0
						APPEND BLANK 
						replace tipoconce WITH ""
					ENDIF 	
					
				OTHERWISE 
					SKIP
			ENDCASE
			lnrecno = RECNO() 			
			GO TOP 
		    .grid1.coLUMN3.combo1.RowSource =  "CsrClaseCta.cnombre,id"
		    .bindergridon('thisform.grid1',lcalias,lcCtrlSource,AcolOdataNavega)
			GO lnrecno
			_screen.LockScreen = .f.
		
			.grid1.column1.text1.SetFocus 
		ENDWITH 
		
	ENDPROC

	PROCEDURE grid1_lostfocusimpuesto
		WITH thisform   
			*stop() 	  
			IF !strzero(.lnkeycode,3)$"003-005-018-024"
				IF .grid1_controllinea()
					*stop()
					.grid1_procesolinea(22)
				ENDIF 
			ENDIF 		
		ENDWITH
	ENDPROC

	PROCEDURE grid1_procesolinea
		PARAMETERS lnKeyCode
		
		LOCAL lok
		
		lok = IIF(lnKeyCode = 27,.f.,.t.)
		
		IF lok 
			thisform.totalcomprobante(2)
			*GO BOTTOM in CsrAuxPlanCue
			SELECT CsrAuxPlanCue
			*SET FILTER TO
			*vista()
			thisform.grid1_generarlinea()   
		ELSE
			thisform.grid1.Visible = .f.
		    IF SUBSTR(CsrCateCtacte.switch,2,1)="1"      && el proveedor pide productos
			    thisform.grid2.column1.text1.SetFocus()
			    thisform.grid2.column1.text1.Click()   
			ELSE
				thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
				thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.Click()   
			ENDIF 		
		ENDIF    
		
	ENDPROC

	PROCEDURE grid1_refrescar
		******************************************************
		**	Recorremos la tabla, para actualizar los combos	**
		******************************************************
		_screen.LockScreen = .t.
		SELECT CsrAuxPlanCue
		GO TOP 
		lnRecno = RECNO()
		WITH thisform.contenedorRegistro
			SCAN 
				SELECT CsrClaseCta
				LOCATE FOR cnumero = CsrAuxPlanCue.tipoconce
				.grid1.column3.combo1.Value = CsrClaseCta.id
				.grid1.column3.combo1.DisplayValue = CsrClaseCta.cnombre
				.grid1.column3.combo1.LostFocus()
				.grid1.column3.combo1.refresh()
				SELECT CsrAuxPlanCue
			ENDSCAN 
		ENDWITH 
		GO lnRecno
		_screen.LockScreen = .f.
	ENDPROC

	PROCEDURE grid2_control
		PARAMETERS lcSetfocus,lcGotfocus
		
		IF thisform.accion#'A'
			RETURN .t.
		ENDIF
		
		LOCAL lncantidad,lnunibulto,lnuniventa,lnunitario,lntotal,lndescto,lcCmd,lnbonifica
		LOCAL  lndecimaluni,lndecimaltot,lncalculo,lok,OscatterCab
		
		lok = .t.
		
		SELECT CsrAuxCabefac
		SCATTER NAME OscatterCab
		
		SELECT CsrAuxCuerFac
		lnrecno = RECNO()
		SCATTER NAME Oscatter
		
		WITH thisform
			 lndecimaluni              = .ndecimaluni
			 lndecimaltot              = .ndecimaltot
		
			 IF Oscatter.idarticulo#0 AND UPPER("ThisForm.Grid2.Column5.Text1")$UPPER(lcGotFocus)
				IF Oscatter.cantidad<=0
					=Oavisar.usuario("La cantidad no puede ser 0, ni negativa",0)
					thisform.grid2.column5.SetFocus
					RETURN .f.
				ENDIF	
			ENDIF
		
			 IF Oscatter.idarticulo#0 AND UPPER("ThisForm.Grid2.Column4.Text1")$UPPER(lcGotFocus)
				IF Oscatter.preunita=0 AND !.tipoform#"FN"   && facturacion, nota pedido
					=Oavisar.usuario("El precio unitario no puede ser 0.00",0)
					thisform.grid2.column4.SetFocus
					RETURN .f.
				ENDIF 			
			ENDIF
		
			IF lok	
				
				lncantidad     	= IIF(Oscatter.cantidad=0,1,Oscatter.cantidad)
				lnunibulto	   	= IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
				lnuniventa     	= Oscatter.univenta
				lnunibulto     	= IIF(lnuniventa=1,1,lnunibulto)
				lnCantFinal		= lncantidad * lnunibulto
				lnpesable		= Oscatter.pesable
				lnkilos			= Oscatter.CantKilos
				&&Calcular Totales
				IF Oscatter.pesable=0
					Oscatter.CantKilos = Oscatter.kilos*lnCantidad
				ENDIF 
				IF !.editarprecio
					Oscatter.Kilosreal = Oscatter.cantkilos
				ENDIF 
				IF !.esbonifica
					*Total Sin Bonificacion (Neto)
					.esbonifica = .t.
					.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
					Oscatter.totalBonif= Red((Oscatter.UniSiva + Oscatter.internofin),lndecimaltot)	
					
					*Total Bonificado
					.esbonifica 		= .f.
					.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
					IF Oscatter.bonif2=0
						Oscatter.total = Red((Oscatter.UniSiva + Oscatter.internofin),lndecimaltot)
					ELSE 
						lcUniSiva 			=  ALLTRIM(STR(Oscatter.UniSiva,11,3))
						Oscatter.UniSiva 	= VAL(LEFT(lcUniSiva,LEN(lcUniSiva)-1))
						lcInternoFin 		=  ALLTRIM(STR(Oscatter.InternoFin,11,3))
						Oscatter.InternoFin = VAL(LEFT(lcInternoFin,LEN(lcInternoFin)-1))
						
						Lntotal = Red((Oscatter.UniSiva + Oscatter.internofin),3)
						lcTotal = ALLTRIM(STR(lnTotal,11,3))
						Oscatter.Total = VAL(LEFT(lcTotal,LEN(lcTotal)-1))
					ENDIF 
					*Mostramos en el cuerpo. El total Sin las bonificaciones que se hacen para totalizar
					*El total de bonificaciones es la Diferencia entre 
					Oscatter.TotalBonif =  Oscatter.Total - Oscatter.TotalBonif
				ELSE
					*Total Bonificado
					.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
					Oscatter.total = Red((Oscatter.UniSiva + Oscatter.internofin),lndecimaltot)
				ENDIF 
		
				
				.grid2.column4.enabled = .f.
				IF Oscatter.cantidad<>0
					.grid2.column4.enabled = .t.
				ENDIF 
					 
			    SELECT  CsrAuxCuerFac
			    GO lnrecno
				GATHER NAME Oscatter 		
			ENDIF 
		ENDWITH
		
		RETURN lok
		
	ENDPROC

	PROCEDURE grid2_controllinea		&& verifica si se puede facturar o no el producto segun determinadas caracteristicas
		PARAMETERS lntipocontrol
		
		LOCAL lok,msg,lnCtaRenFac,lnregactual,lncantidad,lnunibulto,lnuniventa
		
		lok = .t.
		thisform.RepetirCodigo = .f.
		msg = 'NO SE PUEDE FACTURAR EL PRODUCTO '+CHR(13)
		
		SET EXACT ON
		
		DO case
			CASE lntipocontrol=1 AND !thisform.permitemulticodigo
				STORE 0 TO lnCtaRenfac,lyaelegi
				SELECT CsrAuxCuerfac
				lcnombre = nombre
				lnregistro = registro
				lnnumero = codigo
				lnnofactura = nofactura
				lnidarticulo = idarticulo		
				lnregactual = RECNO()
				lyaelegi = .f.
				
				GO top
				SCAN FOR !EOF()
				     IF ALLTRIM(lcnombre)=ALLTRIM(CsrAuxCuerfac.nombre) AND lnnumero=CsrAuxCuerfac.codigo AND lnregistro#CsrAuxCuerfac.registro
				        lyaelegi = .t.
				     ENDIF 
				     lnCtaRenfac = lnCtaRenfac + 1
				ENDSCAN
				GO lnregactual
		
				IF lyaelegi
				   *msg = msg+CHR(13)+TRIM(lcnombre)+' ..... (YA ESTA FACTURADO)'+CHR(13)
				   thisform.RepetirCodigo = .t.
				   lok = .f.
				ENDIF 
			CASE lntipocontrol=2
				SELECT CsrAuxCabefac
				SCATTER NAME OscatterCab
		
				SELECT CsrAuxCuerFac
				lnrecno = RECNO()
				SCATTER NAME Oscatter
		
				WITH thisform
					 lndecimaluni  = .ndecimaluni
					 lndecimaltot  = .ndecimaltot
					 lncantidad    = IIF(Oscatter.cantidad=0,1,Oscatter.cantidad)
					 lnunibulto	   = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
					 lnuniventa    = Oscatter.univenta
					 lnunibulto    = IIF(lnuniventa=1,1,lnunibulto)
					 lnpesable	   = Oscatter.pesable
				  	 lnkilos	   = Oscatter.CantKilos
		
					IF Oscatter.pesable=0
						Oscatter.CantKilos = Oscatter.kilos*lnCantidad
					ENDIF 
					IF !.editarprecio
						Oscatter.Kilosreal = Oscatter.cantkilos
					ENDIF 				
					IF !.esbonifica
						*Total Sin Bonificacion (Neto)
						.esbonifica = .t.
						.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
						Oscatter.totalBonif= Red((Oscatter.UniSiva + Oscatter.internofin),lndecimaltot)	
						*Total Bonificado
						.esbonifica 		= .f.
						.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
						IF Oscatter.bonif2=0
							Oscatter.total = Red((Oscatter.UniSiva + Oscatter.internofin),lndecimaltot)
						ELSE 
							lcUniSiva 			=  ALLTRIM(STR(Oscatter.UniSiva,11,3))
							Oscatter.UniSiva 	= VAL(LEFT(lcUniSiva,LEN(lcUniSiva)-1))
							lcInternoFin 		=  ALLTRIM(STR(Oscatter.InternoFin,11,3))
							Oscatter.InternoFin = VAL(LEFT(lcInternoFin,LEN(lcInternoFin)-1))
							
							Lntotal = Red((Oscatter.UniSiva + Oscatter.internofin),3)
							lcTotal = ALLTRIM(STR(lnTotal,11,3))
							Oscatter.Total = VAL(LEFT(lcTotal,LEN(lcTotal)-1))
						ENDIF 
						*Mostramos en el cuerpo. El total Sin las bonificaciones que se hacen para totalizar
						*El total de bonificaciones es la Diferencia entre 
						Oscatter.TotalBonif =  Oscatter.Total - Oscatter.TotalBonif
					ELSE
						*Total Bonificado
						.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
						Oscatter.total= Red((Oscatter.UniSiva + Oscatter.internofin),lndecimaltot)
					ENDIF 
					 .grid2.column4.enabled = .f.
					 IF Oscatter.cantidad<>0
					 	.grid2.column4.enabled = .t.
					 ENDIF 
					 
				     SELECT  CsrAuxCuerFac
				     GO lnrecno
					 GATHER NAME Oscatter 		
					 
				ENDWITH
		ENDCASE
		
		SET EXACT OFF
			
		IF !lok AND !thisform.RepetirCodigo
		   =Oavisar.usuario(msg,0)
		ENDIF
		
		RETURN lok 
		
	ENDPROC

	PROCEDURE grid2_generarlinea
		LOCAL Oscatter,lcCtrlSource,lcalias,AcolOdataNavega,lcnombre,lnkeyCode
		STORE '' TO lcCtrlSource,AcolOdataNavega
		lcAlias = "CsrAuxCuerfac"
		
		WITH thisform
			_screen.LockScreen = .t.
		    .bindergridoff('thisform.grid2',@lcalias,@lcCtrlSource,@AcolOdataNavega)
		    
			SELECT CsrAuxCuerfac
		    lcnombre = nombre
		    lnkeyCode = 13
		    SKIP 
		    IF (EOF() AND BOF()) OR (EOF() AND LEN(TRIM(lcnombre))#0)
		   	   lnKeycode = 22
		    ENDIF 
			
			IF lnKeyCode=22			&&insert
				.agregarcuerord()
			ENDIF
			lnrecno = RECNO() 			
			GO TOP 
		    .grid2.coLUMN3.combo1.RowSource = "U,1,B,2"
		    .bindergridon('thisform.grid2',lcalias,lcCtrlSource,AcolOdataNavega)
			GO lnrecno
			_screen.LockScreen = .f.
			
			.lhayvariedad = .f.		    
			.lcsetfocus = ""
			.lcgotfocus = ""
			.bloqueocodigo = .f.
			.grid2.column1.text1.SetFocus 
		ENDWITH 
		
	ENDPROC

	PROCEDURE grid2_lostfocusbonif
		PARAMETERS lctipo
		lctipo = IIF(PCOUNT()<1,0,lctipo)
		lcSetfocus = thisform.lcsetfocus
		lcGotfocus = thisform.lcgotfocus
		WITH thisform    	  
			IF .grid2.column3.Enabled 
				IF !strzero(.lnkeycode,3)$"003-005-018-024"
					IF !.grid2_control(lcSetFocus,lcGotFocus)
						.grid2.column10.text1.SetFocus()
					ENDIF 
					IF lctipo=1
						.grid2_procesolinea(13)		
					ENDIF 
				ENDIF 			
			ENDIF 
		ENDWITH
		
	ENDPROC

	PROCEDURE grid2_lostfocuscant
		PARAMETERS lctipo
		lctipo = IIF(PCOUNT()<1,1,lctipo)
		lcSetfocus = thisform.lcsetfocus
		lcGotfocus = thisform.lcgotfocus
		
		WITH thisform    	  
			IF .grid2.column3.Enabled 
				IF !strzero(.lnkeycode,3)$"003-005-018-024"
					IF !.grid2_control(lcSetFocus,lcGotFocus)
						.grid2.column4.text1.SetFocus()
					ENDIF 
					IF lctipo= 1 AND !thisform.editarprecio
						.grid2_procesolinea(13)		
					ENDIF
				ENDIF 			
			ENDIF 
		ENDWITH
		
		
	ENDPROC

	PROCEDURE grid2_lostfocusimp
		lcSetfocus = thisform.lcsetfocus
		lcGotfocus = thisform.lcgotfocus
		WITH thisform 
			IF .grid2.column4.Enabled 
				IF !.grid2_control(lcSetFocus,lcGotfocus)
					.grid2.column4.text1.SetFocus
				ENDIF 
			ENDIF 
		ENDWITH 	
		
	ENDPROC

	PROCEDURE grid2_lostfocuskilos
		LPARAMETERS lctipo
		lctipo = IIF(PCOUNT()<1,1,lctipo)
		lcSetfocus = thisform.lcsetfocus
		lcGotfocus = thisform.lcgotfocus
		
		WITH thisform    	  
			IF .grid2.column3.Enabled 
				IF !strzero(.lnkeycode,3)$"003-005-018-024"
					IF !.grid2_control(lcSetFocus,lcGotFocus)
						.grid2.column10.text1.SetFocus()
					ENDIF 
					IF lctipo= 1 AND !thisform.editarprecio
						.grid2_procesolinea(13)		
					ENDIF
				ENDIF 			
			ENDIF 
		ENDWITH
		
	ENDPROC

	PROCEDURE grid2_procesolinea
		PARAMETERS lnKeyCode
		
		LOCAL lok
		
		lok = IIF(lnKeyCode = 27,.f.,.t.)
		
		cleartec()
		
		IF lok 
			thisform.hacerfocoen  = ''
		    thisform.totalcomprobante(1)
			thisform.grid2_generarlinea()   
		ELSE
			thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
			thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.Click()   
		ENDIF    
		
	ENDPROC

	PROCEDURE grid3_control
		&& controlamos que el campo gravado y exento tengan valores
		WITH thisform.contenedorRegistro.grid3
		 	llok = .t.
			IF .column5.text1.Value =0 AND .column6.text1.Value =0
				llok = .f.
			ENDIF 
		ENDWITH 
		
		RETURN llok
	ENDPROC

	PROCEDURE grid3_generarlinea
		LOCAL Oscatter,lcCtrlSource,lcalias,AcolOdataNavega,lnkeyCode,lcnombre
		STORE '' TO lcCtrlSource,AcolOdataNavega
		lcAlias = "CsrAuxPlanGravado"
		
		WITH thisform
			_screen.LockScreen = .t.
		    .bindergridoff('thisform.ContenedorRegistro.grid3',@lcalias,@lcCtrlSource,@AcolOdataNavega)
			SELECT CsrAuxPlangravado
		    lcnombre = nombre
		    lnkeyCode = 13
		    SKIP 
		    IF (EOF() AND BOF()) OR (EOF() AND LEN(TRIM(lcnombre))#0)
		   	   lnKeycode = 22
		    ENDIF 
			IF lnKeyCode=22			&&insert
				APPEND BLANK 
				replace gravado WITH 0, exento WITH 0 
			ENDIF 				
			lnrecno = RECNO() 			
			GO TOP 
		    *.grid1.coLUMN3.combo1.RowSource = "Csrprovincia.nombre,id"
		    .bindergridon('thisform.ContenedorRegistro.grid3',lcalias,lcCtrlSource,AcolOdataNavega)
			GO lnrecno
			_screen.LockScreen = .f.
		
			.contenedorregistro.grid3.column1.text1.SetFocus 
		ENDWITH 
	ENDPROC

	PROCEDURE grid3_procesolinea
		PARAMETERS lnKeyCode
		
		LOCAL lok
		
		lok = IIF(lnKeyCode = 27,.f.,.t.)
		
		IF lok 
		    *thisform.totalcomprobante(2)
			thisform.grid3_generarlinea() 
			*thisform.totalregistracion()  
		ELSE
			thisform.contenedorregistro.Grid3.Visible = .f.
		    thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
			thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.Click()   
				
		ENDIF    
		
	ENDPROC

	PROCEDURE grid3_show		&& mostramos en pantalla el grid3
		thisform.ultimocontainer='THISFORM.GRID3'
		thisform.lblayudapie.Caption = "[Esc]Aborta [+] Aceptar cuentas afectadas"
		
		WITH thisform.contenedorRegistro
			.grid3.Visible = .t.
			UPDATE CsrAuxPlanCue SET importe=0 
			*A= parametros contables parametrizados, Z= cuentas parametrizada por proveedor (modelos)
			DELETE FROM CsrAuxPlanCue WHERE !origen in ('A','Z')
			
			thisform.grid3_vizualisar()
			thisform.grid3_generarlinea()
			.grid1.enabled = .f.
		
			SELECT CsrAuxPlanGravado
			.grid3.Column1.text1.SetFocus()
			
			GO TOP 
		ENDWITH 
	ENDPROC

	PROCEDURE grid3_vizualisar
		WITH thisform.contenedorRegistro.grid3
			.column5.enabled = .t.
			.column6.enabled = .t.
			.column7.Visible = .f.
			.column8.Visible = .f.
			.column3.visible = .f.
			.column9.Visible = .f.
		ENDWITH 
		
	ENDPROC

	PROCEDURE grid4_control
		&& como es posible el cambio manual de la fecha y los importes
		&& debemos controlar que estos cumplan con los totales ingresados
		SELECT CsrauxCuotas
		SUM ALL total TO lntotalcuo
		llok = .t.
		IF thisform.containertotales._txttotal.Value#lntotalcuo
			oavisar.usuario("Los Importes no coinciden con la registración")
			thisform.generarcuotas()
			llok = .f.
		ENDIF
		RETURN llok 
		
		
	ENDPROC

	PROCEDURE grid4_generarlinea
		PARAMETERS lncuota, lnimporte,ldfecha
		LOCAL Oscatter,lcCtrlSource,lcalias,AcolOdataNavega,lnkeyCode,lcnombre
		STORE '' TO lcCtrlSource,AcolOdataNavega
		lcAlias = "CsrAuxCuotas"
		
		WITH thisform
			_screen.LockScreen = .t.
		    .bindergridoff('thisform.ContenedorRegistro.grid4',@lcalias,@lcCtrlSource,@AcolOdataNavega)
			SELECT CsrAuxCuotas
		    lnkeyCode = 13
		    SKIP 
		    IF (EOF() AND BOF()) OR (EOF() AND lnimporte#0)
		   	   lnKeycode = 22
		    ENDIF 
			IF lnKeyCode=22			&&insert
				APPEND BLANK 
				replace cuota WITH lncuota, total WITH lnimporte, vencimien WITH ldfecha
			ENDIF 				
			lnrecno = RECNO() 			
			GO TOP 
		    *.grid1.coLUMN3.combo1.RowSource = "Csrprovincia.nombre,id"
		    .bindergridon('thisform.ContenedorRegistro.grid4',lcalias,lcCtrlSource,AcolOdataNavega)
			GO lnrecno
			_screen.LockScreen = .f.
		
			*.contenedorregistro.grid4.column1.text1.SetFocus 
		ENDWITH 
	ENDPROC

	PROCEDURE gridvariedad_when
		WITH thisform
			*IF !thisform.consultando
				IF .lhayvariedad AND .lpidocantidad   &&this.Value = 0
					.ultimocontainer = "CONTAINERVARIEDAD"
					.lblayudapie.Caption = "[ + ]Cierra     [Fl.Arriba/Abajo]Elije variedad"
					.containervariedad.Visible = .t.
					.containervariedad.grid3.Visible = .t.					
					.containervariedad.Refresh
					.containervariedad.grid3.column2.text1.SetFocus()
					RETURN .f.
				ELSE
				    RETURN .t.	
				ENDIF
			*ENDIF 
		ENDWITH 
	ENDPROC

	PROCEDURE imprimir		&& Determina el medio de impresion
		&& armamos el encabezado del comprobante
		SET SAFETY OFF
		SELECT CsrImpCab
		ZAP
		SELECT Csrimpcue
		ZAP
		SET SAFETY ON 
		lncomprobante =CsrAuxMaopera.numcomp
		SELECT csrcomprobante
		LOCATE FOR id = CsrAuxMaopera.idcomproba
		SELECT CsrauxCabefac
		lcfecha = DTOC(CsrauxCabefac.fecha)
		INSERT INTO Csrimpcab (grupo ,Campo001 ,Campo002 ,Campo003,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008  );
					values  ('1',Csrcomprobante.cnombre,CsrauxCabefac.ctacte,ALLTRIM(CsrauxCabefac.cnombre),CsrauxCabefac.cuit;
					,lcfecha,ALLTRIM(CsrauxCabefac.detalle),lncomprobante," ")
		
		&&inicializo contadores
		lnsumaciva = 0
		lnsumasiva = 0
		lniva = 0
		lnsumafactura =0
		&& mcargo todos los articulos primarios (secundarios = variedades)
		SELECT CsrAuxCuerfac
		DELETE FOR idarticulo=0
		SELECT CsrAuxCuerfac
		
		SCAN
			lnsumaciva = lnsumaciva + CsrAuxCuerfac.uniciva + CsrAuxCuerfac.internofin
			lnsumasiva = lnsumasiva + CsrAuxCuerfac.unisiva
			lniva = CsrAuxCuerfac.uniciva - CsrAuxCuerfac.unisiva
			INSERT INTO CsrimpCue (grupo ,Campo001 ,Campo002 ,Campo003 ,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008, campo009, pos );
			VALUES ('1',STR(CsrAuxCuerfac.idarticulo),CsrAuxCuerfac.codigo,CsrAuxCuerfac.nombre,STR(CsrAuxCuerfac.cantidad,11,2);
			,STR(CsrAuxCuerfac.total,11,2),'',STR(lniva,11,3),'1',STR(CsrAuxCuerfac.uniciva,11,2),RECNO('CsrAuxCuerfac'))
		ENDSCAN 
		&& recupero nos nombres de las variedades
		SELECT CsrAuxCuervari
		lcidsubarti =''
		SCAN
			lcidsubarti = ALLTRIM(lcidsubarti)	+ IIF(EMPTY(lcidsubarti),'',',')+ALLTRIM(STR(CsrAuxCuervari.idsubarti))
		ENDSCAN 
		IF EMPTY(lcidsubarti)
			lcidsubarti = '0'
		ENDIF 
		TEXT TO lccmd TEXTMERGE NOSHOW 
		SELECT id,nombre ,subnumero,idarticulo FROM Subproducto as CsrVarie
		where id in (<<lcidsubarti>>)
		ENDTEXT 
		crearCursorAdapter('CsrVarie',lccmd)
		&& cargo los subproductos
		SELECT CsrAuxCuervari
		SCAN 
			SELECT CsrVarie
			LOCATE FOR id = CsrAuxcuervari.idsubarti &&AND idarticulo = CsrAuxCuervari.idarticulo
			
			SELECT CsrAuxcuervari
			INSERT INTO  CsrimpCue (grupo ,Campo001 ,Campo002 ,Campo003 ,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008, campo009,pos );
			VALUES('1',STR(CsrAuxcuervari.idarticulo),STR(CsrVarie.subnumero),CsrVarie.nombre,STR(CsrAuxcuervari.cantidad,11,2),'','','','2','',CsrAuxCuerVari.pos)
		ENDSCAN 
		
		
		SELECT CsrAuxplancue
		GO top
		SCAN WHILE !EOF()
		  IF tipoconce$'EX-NG-ZZ'
		      lnsumafactura = lnsumafactura + Csrauxplancue.importe
		  ENDIF 
		  IF tasa#0
		      lnsumafactura = lnsumafactura + Csrauxplancue.impuesto
		  ENDIF 
		ENDSCAN
		
		&&& total diferencia de maquina y factura
		
		INSERT INTO  CsrimpCue (grupo ,Campo001 ,Campo002 ,Campo003 ,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008, campo009,pos );
		VALUES ('2','1','','Total Factura:',STR(lnsumafactura,12,3),'','1','','','',0)
		INSERT INTO  CsrimpCue (grupo ,Campo001 ,Campo002 ,Campo003 ,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008, campo009,pos );
		VALUES ('2','2','','Total Maquina:',STR(lnsumaciva,12,3),'','-1','','','',0)
		
		&&cargamos las rtetenciones
		SELECT CsrAuxPlancue
		GO TOP 
		*lnsumasiva
		INSERT INTO  CsrimpCue (grupo ,Campo001 ,Campo002 ,Campo003 ,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008, campo009, pos );
		VALUES ('3','','1','SUBTOTAL DE FACTURA DE '+ Csrimpcab.campo003	,'',STR(lnsumasiva,11,2),'1','','','',0)
		WITH thisform.containertotales
			IF ._txtbonifNG.Value#0 OR ._txtbonifEX.Value#0
				INSERT INTO  CsrimpCue (grupo ,Campo001 ,Campo002 ,Campo003 ,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008, campo009,pos );
				VALUES ('3','','2','Bonificaciones:','',STR((._txtbonifNG.Value+._txtbonifEX.Value)*-1,12,3),'-1','','','',0)
			ENDIF 
			IF ._txtRecoDevolNG.value#0 OR ._txtRecoDevolEX.value#0
				INSERT INTO  CsrimpCue (grupo ,Campo001 ,Campo002 ,Campo003 ,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008, campo009,pos );
				VALUES ('3','','3',' Reconocimiento por devolución:','',STR((._txtRecoDevolEX.value+._txtRecoDevolNG.value)*-1,12,3),'-1','','','',0)
			ENDIF
		ENDWITH 
		
		SELECT CsrAuxPlancue
		GO TOP
		*!*	INSERT INTO  CsrimpCue (grupo ,Campo001 ,Campo002 ,Campo003 ,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008, campo009, pos );
		*!*	VALUES ('4','','1','SUBTOTAL DE FACTURA DE '+ Csrimpcab.campo003	,'',STR(CsrAuxPlancue.importe,11,2),'','','','',0)
		SCAN 
		 IF importe<>0 or impuesto<>0 then
		*!*	 	IF origen='F'
		*!*	 		INSERT INTO  CsrimpCue (grupo ,Campo001 ,Campo002 ,Campo003 ,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008, campo009,pos );
		*!*			VALUES ('4',STR(CsrAuxPlancue.cuenta),STR(CsrAuxPlancue.cuenta);
		*!*			,ALLTRIM(CsrAuxPlancue.nombre) + IIF(!EMPTY(CsrAuxPlancue.detalle), ' ,'+ALLTRIM(CsrAuxPlancue.detalle),'');
		*!*			,STR(CsrAuxPlancue.importe,11,2),STR(CsrAuxPlancue.importe,11,2),'','','',STR(CsrAuxPlancue.impuesto,11,2),0)
		*!*		ENDIF 
			IF tasa>0
				INSERT INTO  CsrimpCue (grupo ,Campo001 ,Campo002 ,Campo003 ,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008, campo009,pos );
				VALUES ('4',STR(CsrAuxPlancue.cuenta),STR(CsrAuxPlancue.cuenta);
				,ALLTRIM(CsrAuxPlancue.nombre) + IIF(!EMPTY(CsrAuxPlancue.detalle), ' ,'+ALLTRIM(CsrAuxPlancue.detalle),'')+'('+STR(CsrAuxPlancue.tasa,5,2)+')';
				,STR(CsrAuxPlancue.importe,11,2),STR(IIF(CsrAuxPlancue.impuesto = 0,CsrAuxPlancue.importe,CsrAuxPlancue.impuesto),11,2),'','','',STR(CsrAuxPlancue.impuesto,11,2),0)
			ELSE
				&&cargamos los descuentos que nos realizan
				INSERT INTO  CsrimpCue (grupo ,Campo001 ,Campo002 ,Campo003 ,Campo004 ,Campo005 ,Campo006 ,Campo007 ,Campo008, campo009, pos );
				VALUES ('4',STR(CsrAuxPlancue.cuenta),STR(CsrAuxPlancue.cuenta);
				,ALLTRIM(CsrAuxPlancue.nombre) + IIF(!EMPTY(CsrAuxPlancue.detalle), ' ,'+ALLTRIM(CsrAuxPlancue.detalle),'')+'('+STR(CsrAuxPlancue.tasa,5,2)+')';
				,STR(CsrAuxPlancue.importe,11,2) ,STR(IIF(CsrAuxPlancue.impuesto = 0,CsrAuxPlancue.importe,CsrAuxPlancue.impuesto),11,2),'','','',STR(CsrAuxPlancue.impuesto,11,2),0)
			ENDIF 
		 endif	
		ENDSCAN 
		SELECT * FROM Csrimpcue ORDER BY grupo, campo001,pos INTO CURSOR Csrimpcue READWRITE 
		SELECT Csrimpcue
		
		TRY
			REPORT FORM ('regfaccpra.frx') TO PRINTER PROMPT PREVIEW 	
		CATCH 
		  	RETURN .f.
		ENDTRY     
		
		RETURN .t.  
		  
	ENDPROC

	PROCEDURE iniciarseteos
		local oObjeto as object
		local oObjParam as object
		store null to oObjeto,oObjParam
		
		with This
			&&Propiedades
			.incluyeiva = goapp.empresaincluyeiva
		 	
		 	.agregaobjeto.objgrabadato(@oObjeto)
			.AddProperty("objgrabadato",oObjeto)
		 	
			.agregaobjeto.objseteoparam(@oObjParam)
			.AddProperty("objseteoparam",oObjParam)
		
			 IF VARTYPE(.objseteoparam.defAutoTotalPerceIVA)$'L'
			 	.totalizaperceiva = .objseteoparam.defAutoTotalPerceIVA
			 ENDIF 
			 IF VARTYPE(.objseteoparam.defAutoTotalPerceIBTO)$'L'
			 	.totalizaperceibto = .objseteoparam.defAutoTotalPerceIBTO
			 ENDIF 
			 IF VARTYPE(.objseteoparam.faccpra_cuentaRG)$'L'
			 	.cuentaRG = .objseteoparam.faccpra_cuentaRG
			 ENDIF 
			 IF VARTYPE(.objseteoparam.faccpra_cuentaRI)$'L'
			 	.cuentaRI = .objseteoparam.faccpra_cuentaRI
			 ENDIF 
			 IF VARTYPE(.objseteoparam.faccpra_cuentaRB)$'L'
			 	.cuentaRB = .objseteoparam.faccpra_cuentaRB
			 ENDIF 
			 IF VARTYPE(.objseteoparam.faccpra_proveedor)$'L'
			 	.ProdProvee = .objseteoparam.faccpra_proveedor
			 ENDIF 
			 &&Controladores
			.grid1.visible = .f.
		 	.grid2.visible = .f.
		 	.contenedorregistro.grid3.visible = .f.
		 	.contenedorregistro.grid1.visible = .f.
		 	.contenedorregistro.grid4.visible = .f.
			.contenedorRegistro.Visible = .t.
			IF .tipoform <> 'R'
		     	.grid2.Visible = !.tipoform$'FM'	&& LUM: ContenedorLiq (transparente) va en ese lugar
		 		.containerencabeza._chkpidovalor.Visible = .f.
		 		*stop()
		 		WITH this.kitbuscarProd
		 			.filtrar	= "AND nofactura=0 and idestado=1"
		 			.filtrar2	= ""
		 			IF This.ProdProvee 
						.filtrar	=  .filtrar + " and idctacte="
		 				.filtrar2	= "CsrCtacte.id"
					ENDIF 
			 	ENDWITH 
				
				TEXT TO lcCmdArti TEXTMERGE NOSHOW 
				SELECT 0 as ok,t.*
				FROM (Select CsrProducto.numero as codigo,CsrProducto.nombre as NomArticulo,CsrProducto.id
				,CsrProducto.codartprod,CsrProducto.costo,CsrProducto.prevtaf1,CsrProducto.prevta1
				,CsrCtacte.cnombre as NomProveedor,CsrCtacte.id as idctacte
				,ISNULL(CsrMarca.nombre,SPACE(20)) as nommarca
				,ISNULL(CsrRubro.nombre,SPACE(20)) as nomrubro
				,convert(char(10),ISNULL(CsrProducto.fecmodi,getdate()),105) as fechamodif
				,CAST(0 as numeric(11,0)) as cantstock
				,CAST(0 as numeric(11,0)) as cantreserva
				,ISNULL((select SUM(existe) from Existenc as CsrExistenc where CsrProducto.id = CsrExistenc.idarticulo
				and CsrExistenc.iddeposito = <<CsrParaConfig.iddeposito>> ),CAST(0 as numeric(11,0))) as existe
				,ISNULL((select SUM(existedisp) from Existenc as CsrExistenc where CsrProducto.id = CsrExistenc.idarticulo
				and CsrExistenc.iddeposito = <<CsrParaConfig.iddeposito>> ),CAST(0 as numeric(11,0))) as existedisp
				From Producto as CsrProducto
				LEFT JOIN Ctacte as CsrCtacte on CsrProducto.idctacte = CsrCtacte.id
				LEFT JOIN Marca as CsrMarca on CsrProducto.idmarca = CsrMarca.id
				LEFT JOIN Rubro as CsrRubro on CsrProducto.idrubro = CsrRubro.id 
				WHERE CsrProducto.idestado=1 and CsrProducto.nofactura=0) as t 
				ORDER BY t.NomArticulo
				ENDTEXT
				=SaveSQL(lcCmdArti,this.Name+"_BuscarProd")
				IF NOT CrearCursorAdapter('CsrAuxBuscar',lcCmdArti)
					thisform.Release
				ENDIF 
				SELECT * FROM CsrAuxBuscar INTO CURSOR CsrBusProd READWRITE 
				replace ALL cantstock WITH existe, cantreserva WITH existe-existedisp IN CsrBusProd
				
				SET SAFETY OFF 
				SELECT CsrBusProd
				INDEX on nomarticulo TAG knombre
				INDEX on codigo TAG kcodigo
				SET SAFETY ON 
			
		 	ELSE
		 		.ocultartotalizadores()
		 		.contenedorRegistro.Visible = .t.
		 		.contenedorRegistro.grid1.visible = .t.
			   	WITH This.Containertotales
			 			.lbl01.caption = 'Interno'
			 			.lbl02.caption = 'Perc. ganancia'
			 			.lbl03.caption = 'Perc. IVA'
			 			.lbl04.caption = 'Perc. IBtos '
			 			.lbl05.caption = ''
			 			.lbl06.caption = 'Otros'		
				ENDWITH 
				WITH this.kitbuscarPlancue
				 	.objetoid = "thisform.contenedorRegistro.grid1.column9.text1"
				 	.objetonom ="thisform.contenedorRegistro.grid1.column2.text1"
				 	.objetonro ="thisform.contenedorRegistro.grid1.column1.text1"
			 	ENDWITH 
		    ENDIF 
		endwith 
	ENDPROC

	PROCEDURE iniciavariables		&& Seteo de variables, llamado por init del formulario
		
		WITH thisform 
			TEXT TO lcCmd TEXTMERGE noshow
			SELECT CsrParaConta.* FROM PAraConta as CsrPAraConta WHERE idejercicio = <<goapp.idejercicio>>
			ENDTEXT 
			IF !.obtenerdatos('CsrParaConta',lcCmd)
				.Release
			ENDIF 
			
			TEXT TO lccmd TEXTMERGE NOSHOW 
			Select Csrparaconfig.*,isnull(Csrlocalidad.idprovincia,0) as idprovincia
			,isnull(Csrdetanrocaja.idejercicio,cast(0 as int)) as idejerciciocaja
			,ISNULL(Csrdetanrocaja.nrocaja,0) as nrocaja,isnull(Csrdetanrocaja.fecdesde,'19000101') as fecdesde
			,isnull(Csrdetanrocaja.fechasta,'19000101') as fechasta
			,isnull(Csrdetanrocaja.pefiscal,0) as pefiscal,Csrcotizadolar.fechacoti as fechacoti,Csrcotizadolar.preciocpra as preciocpra
			,Csrcotizadolar.preciovta as preciovta
			 from paraconfig as Csrparaconfig 
			left join detanrocaja as Csrdetanrocaja on Csrparaconfig.iddetanrocaja = CsrDetanrocaja.id 
			left join Cotizadolar as Csrcotizadolar on Csrparaconfig.idcotizadolar = Csrcotizadolar.id   
			left join localidad as Csrlocalidad on Csrparaconfig.idlocalidad = Csrlocalidad.id
			ENDTEXT 
			IF !.obtenerdatos('CsrParaConfig',lcCmd)
				.Release
			ENDIF 
			
			TEXT TO lccmd TEXTMERGE NOSHOW 
			SELECT CsrCentroRecep.* FROM CentroRecep as CsrCentroRecep WHERE id  = <<CsrParaConfig.idcentrorecep>>
			ENDTEXT 
			IF NOT .obtenerdatos('CsrCentroRecep',lccmd)
				.Release
			ENDIF 
			
			=LeerCajaActivaOtroEjercicio(thisform)
			
			.bloqueocodigo = .f. 
			.cargarvalores()
			.leerparametrosconfig()
		    .leerseteoterminal()
		    .leerprefijoterminal(.lnidterminal)
		    .lnidvendedor = 0
		    .Containerencabeza._txtptovta.value=1
			
			WITH thisform.containertotales
				._txtiva.Value			 = 0
				._txtnetoexento.Value	 = 0
				._txtnetogravado.Value	 = 0
				._txtCantKilos.Value	 = 0
				._txttotal.Value		 = 0
				._txtaccion.Value		 = 0
				._txtctacte.Value		 = 0
				._txtSubTotalNG.Value	 = 0
				._txtbonifNG.value		 = 0
				._txtTotalNG.value	 	 = 0
				._txtRecoDevolNG.value	 = 0
				._txtSubTotalEX.Value	 = 0
				._txtbonifEX.value		 = 0
				._txtTotalEX.value	 	 = 0
				._txtRecoDevolEX.value	 = 0
				.lbl7.caption = IIF(thisform.tipoform$'R','Entregas',.lbl7.caption)
				.refresh		
			ENDWITH 
			IF !.incluyeiva
				&&Modificamos en ejecucion el ControlSource del la columna de preciop
		   		&&Para que se modifique el preunita/preunitasiva
		   		&&Porque el calcularimpuesto diferencia de donde debe sacar la informacion
		   		&&Si esta se modifica en el campo incorreto, no recalcula al EditarPrecio = true
				thisform.grid2.column4.ControlSource='CsrAuxCuerfac.preunitasiva'
			ENDIF 
			lccuit = GOapp.empresacuit
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT CsrProvincia.*,CAST(0 as numeric(12,2)) as porperce FROM Provincia as CsrProvincia 
			inner join ProvCtaCon as CsrProvCtaCon on CsrProvincia.id = CsrProVCtaCon.idprovincia
			where CsrProvCtaCon.idctaperce <> 0 and idejercicio = <<goapp.idejercicio>>
			ENDTEXT 
			CrearCursorAdapter('CsrProvEmpresa',lcCmd)
			LOCAL lcaliascateibto,lnporperce,lnporrete
			lcaliascateibto = "" 
			lnporperce = 0
			lnporrete = 0
			
			SELECT CsrProvEmpresa
			GO TOP 
			SCAN 	
				.agregaobjeto.objobteneribto(lccuit,CsrProvEmpresa.id,@lcaliascateibto,@lnporperce,@lnporrete)
				replace porperce WITH lnporperce IN CsrProvEmpresa
			ENDSCAN 
			*vista()
		ENDWITH
	ENDPROC

	PROCEDURE Init
		PARAMETERS lctipoform
		* F = NORMAL , M=MANUAL 
		this.tipoform = IIF(PCOUNT()<1,"M",UPPER(lctipoform))
		*thisform.tipoform = 'F'
		this.lbltituloform.Caption =This.lbltituloform.Caption +  IIF(This.tipoform="F",""," MANUAL")
		DODEFAULT()
			 
		WITH thisform 
			SET FUNCTION F10 TO CHR(255)   && asigno chr(255) 
			 
			.iniciarseteos()
			.iniciavariables()   
		    .insertacursor()
		    .leercomprobante()
		         
			.ldIni_Fecha = .ultimodiamesanterior()
			.lnIni_IDCtacte = 0
			.lcIni_Ctacte = ""
			.lnIni_Comproba = 0
				       	
		     .ponerpantallamodoedicion()
		     .refresh()
		ENDWITH 
		
	ENDPROC

	PROCEDURE insertacursor		&& Crea registro iniciales,  CsrAuxmaopera, CsrauxCabefac.
		parameters lsolocabefac,lbIniciarDatos
		
		lsolocabefac = iif(pcount()<1,.f.,lsolocabefac)
		lbIniciarDatos = IIF(PCOUNT()<2,.f.,lbIniciarDatos)
		
		WITH this
			
			.ldIni_Fecha 	 = IIF(not lbIniciarDatos,.ultimodiamesanterior(),.ldIni_Fecha)	&& sugerimos el ultimo dia del mes anterior
			.lnIni_IDCtacte = IIF(not lbIniciarDatos,0,.lnIni_IDCtacte)
			.lcIni_Ctacte = IIF(not lbIniciarDatos,"",.lcIni_Ctacte)
			.lnIni_Comproba = IIF(not lbIniciarDatos,0,.lnIni_Comproba)
		 
			
			Set safe off
			if !lsolocabefac
			    SELECT CsrAuxMaopera
			    ZAP
			    INSERT INTO CsrAuxmaopera (origen,programa,terminal,fechasis,idoperador,idvendedor,numcomp,iddetanrocaja,turno,switch;
			    ,sucursal,sector,puestocaja,idcotizadolar,nrocaja,iddeposito,pefiscal,estado,detalle,idcomproba);
			    VALUES ('CPR',UPPER(thisform.name),Goapp.terminal,CsrPARACONFIG.fechaserver,goapp.idusuario,thisform.lnidvendedor;
				,'B000100000000',thisform.lnidnrocaja,CsrPARACONFIG.turno,"00000",Goapp.sucursal,thisform.sectorterminal;
				,thisform.puestocaja,CsrPARACONFIG.idcotizadolar,CsrPARACONFIG.nrocaja,thisform.lniddeposito,CsrPARACONFIG.pefiscal;
				,'0',"",.lnIni_Comproba)
			ENDIF 
			    
			SELECT  CsrAuxcabefac
			zap
			INSERT INTO  CsrAuxcabefac (fecha,idtipoiva,idplanpago,switch,copiatkt,vencimien,idlocalidad,idprovincia,idctacte,ctacte;
					,idcentrorecep,idprovrecep);
			VALUES (.ldIni_Fecha ,3,thisform.lnidplanpago,thisform.tipoform+"0000",1,DATE(),thisform.lnidlocalidad;
					,thisform.lnidprovincia,.lnIni_IDCtacte,.lcIni_Ctacte,CsrParaConfig.idcentrorecep,CsrCentroRecep.idprovincia)
			
			IF lbIniciarDatos
				SELECT CsrComprobante
				LOCATE FOR id = CsrAuxMaopera.idcomproba
			ENDIF 
				
		ENDWITH
		
		SELECT CsrAuxCuerfac
		ZAP
		
		SELECT Csrauxcuervari
		ZAP
		
		SELECT CsrAuxMovAfectado
		ZAP
		
		SELECT CsrAuxplancue
		ZAP
		
		IF USED('CsrPago')
			SELECT CsrPago
			ZAP 
		ENDIF 
		WITH thisform
			.contenedorRegistro.grid4.Visible = .f.
			.contenedorRegistro._texttotal.Visible = .f.
			.accion 								 = "A"
			.containertotales._txtnetogravado.Value  = 0
			.containertotales._txtnetoexento.Value   = 0
			.containertotales._txtiva.Value          = 0
			.containertotales._txt01.Value           = 0
			.Containertotales._txt02.Value           = 0
			.Containertotales._txt03.Value           = 0
			.Containertotales._txt04.Value           = 0
			.Containertotales._txt05.Value           = 0
			.Containertotales._txt06.Value           = 0	
			.containertotales._txttotal.Value        = 0
			.containertotales._txtSubTotalNG.Value	 = 0
			.containertotales._txtbonifNG.value		 = 0
			.containertotales._txtTotalNG.value	 	 = 0
			.containertotales._txtRecoDevolNG.value	 = 0
			.containertotales._txtSubTotalEX.Value	 = 0
			.containertotales._txtbonifEX.value		 = 0
			.containertotales._txtTotalEX.value	 	 = 0
			.containertotales._txtRecoDevolEX.value	 = 0
			.containertotales._txtCantKilos.Value	 = 0
			.containerencabeza._txtletra.Value       = " "
			.containerencabeza._txtptovta.Value = .talonario
			.containerencabeza._txtnumcomp.Value     = .containerencabeza._txtnumcomp.Value + 1
			.containerencabeza._txtparada.Value = ""
			.cargarafectar()
		ENDWITH 		
		
		thisform.refresh()
		
		set safe on
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		WITH thisform
			.lnkeycode = nKeycode
			.kitbuscarProd.tecla = nKeyCode
			.kitbuscarPlancue.tecla = nKeyCode
			.kitbuscarPlanGravado.tecla = nKeyCode
			
			DO CASE    			
			   CASE nKeyCode = 27  AND (!.ultimocontainer= "CONTAINERVARIEDAD" AND !.ultimocontainer='THISFORM.GRID3' AND !.ultimocontainer='THISFORM.GRID4')
			   	    NODEFAULT 
			   	    thisform.bloqueocodigo=.f.
			   	    .k_escape()   		
			   CASE UPPER(.ultimocontainer)="CONTAINERENCABEZA"
			   		IF .accion="A"
				        IF nKeyCode = -3
					   		NODEFAULT 
				   			.key_f4()
						ENDIF
					ELSE
						IF nKeyCode=43 OR nKeyCode=45
							NODEFAULT 
							.VerComprobante(nKeyCode)
						ENDIF 					
					ENDIF 				   
			   CASE UPPER(.ultimocontainer)="CONTENEDORLIQ"
			   		IF nKeyCode=43
			   			NODEFAULT
			   			.liqpasarvaloractivo()	&& el + llega antes de que el textbox pase lo tipeado a LiqDatos
			   			.controlliqdatos()
			   			.key_43(2)	&& + Graba
			   		ENDIF
			   CASE .ultimocontainer ="THISFORM.GRID2"

			   		DO CASE  
			   		    CASE nKeyCode = -7  	AND !thisform.consultando											&& F8
					   		NODEFAULT 
					   		thisform.bloqueocodigo=.f.
					   		.borrargrid2()
						CASE nKeyCode=5 OR nKeyCode=19
							IF .ultimofocoen="_TXTDETALLE" AND RECCOUNT("CsrAuxCuerfac")=0
						        NODEFAULT
								.containerencabeza._txtdetalle.SetFocus 
							ELSE 
								DODEFAULT()
							ENDIF 
							
						CASE nKeyCode=255 AND thisform.grid2.ActiveColumn=1
					       	 NODEFAULT 
					         .bloqueocodigo=.f.  
					       	 .key_43(1) && + a cuenta contable
					    CASE nKeyCode=255 AND thisform.grid2.ActiveColumn#1
					       	 NODEFAULT 
					    CASE nKeyCode=43
					   		NODEFAULT 	
					   	 CASE nKeyCode=9 AND thisform.grid2.ActiveColumn=1 AND NOT thisform.consultando 
					    	NODEFAULT 
					    	.buscarproducto()						
					ENDCASE 
			   CASE .ultimocontainer = "THISFORM.GRID1" 
			   		DO CASE 
			   		    CASE nKeyCode = -7  AND .tipoform <> 'R' && F8
					   		NODEFAULT 
					   		.borrargrid1()
					    CASE nKeyCode=43 AND .tipoform <> 'R'AND thisform.grid1.ActiveColumn=1
					        NODEFAULT         
					        .key_43(2) && + Graba
					    CASE nKeyCode=43 AND .tipoform <> 'R'AND thisform.grid1.ActiveColumn#1
					       	NODEFAULT 
					    CASE nkeycode = 13 AND .TIPOFORM ='R' AND .contenedorRegistro.grid1.ActiveColumn=5
					    	NODEFAULT
					    	SKIP IN CsrAuxPlanCue
		*!*				    CASE nKeyCode=43 AND .tipoform$'R'AND thisform.grid1.ActiveColumn=5
		*!*				        NODEFAULT         
		*!*				        .key_43(4) && + Graba
		*!*				    CASE nKeyCode=43 AND .tipoform$'R'AND thisform.grid1.ActiveColumn#5
		*!*				       	NODEFAULT 
					    CASE nKeyCode= 27 AND .tipoform ='R'
					    	NODEFAULT 
					    	.k_escape()
					    CASE  nKeyCode = -2 AND .tipoform ='R'&&f3
							NODEFAULT 
							.grid3_show()
					 CASE .tipoform$"R"  AND .contenedorRegistro.grid1.ActiveColumn=5
							cleartec()
						 
			ENDCASE 
			   CASE .ultimocontainer ="CONTAINERVARIEDAD" 
			   		IF nKeyCode=43 .or. nkeycode=27
			   			thisform.bloqueocodigo=.f.
				        NODEFAULT         
			    	    .key_grid3(nKeyCode, nShiftAltCtrl)
					ENDIF    
					
				CASE .ultimocontainer ="THISFORM.GRID4" 
			   		IF  nkeycode=27
				        NODEFAULT         
			    	    .k_escape()
					ENDIF   
					IF nkeyCode = 43 
						NODEFAULT 
						.key_43(5)
					ENDIF	 	
				CASE .ultimocontainer = "THISFORM.GRID3"
					DO CASE 
						CASE  nkeycode=43 AND .contenedorRegistro.grid3.ActiveColumn#1
							NODEFAULT 
						CASE  (nkeycode=43 OR nkeyCode=27) AND .contenedorRegistro.grid3.ActiveColumn=1
							NODEFAULT 
							.contenedorregistro.grid3.visible = .f.
							.ultimocontainer='THISFORM.GRID1'
							.lblayudapie.Caption = "[Esc]Retrocede a Proveedor   [ + ]Graba   [F3] Cargar Gravado/Exento" 
							.contenedorregistro.grid1.Visible = .t.
							.contenedorregistro.grid1.enabled = .t.
							.cargarvaloresgravado()
							
							.REFRESH()
							IF .tipoform ='R'
								.contenedorregistro.grid1.column5.text1.SetFocus
							ELSE 
								.Containervariedad.grid1.column1.text1.SetFocus
							ENDIF      
					ENDCASE  
					IF .tipoform ='R' AND nKeycode = 13 
						
						IF .grid3_control() AND .contenedorregistro.grid3.ActiveColumn=6
							NODEFAULT 
							.grid3_generarlinea()
							replace gravado WITH 0.00, exento WITH 0.00 IN CsrauxPlanGravado
							.contenedorregistro.grid3.SetFocus()
						ENDIF 
					ENDIF 
		
				OTHERWISE 
			ENDCASE 
		ENDWITH 
		
	ENDPROC

	PROCEDURE key_43		&& Tecla  + para grabar
		PARAMETERS lnopcion
		
		WITH thisform 
			IF .Hayescape
			   .Hayescape = .f.
			   RETURN .t.
			ENDIF 
		
			DO case
				* + en grid productos
			   CASE lnopcion = 1
					.EditarTotales()
				* - en grid cuentas			
			   CASE lnopcion = 2 AND .tipoform$'FM'
			   		&& LUM: sin cuotas ni valores (la cuenta corriente la graba el SP); valida y graba
			   		.temp_save()		&& lo cargado queda en Temporal\LUM<terminal>.XML (boton Recuperar)
			   		IF .validarcomproba()
			   			.actualizar()
			   		ENDIF
			   CASE lnopcion = 2
			   		.grid1.Visible = .f.
			   		.generarcuotas()	
				* boton borrar			
			   CASE lnopcion = 3 
			   		IF LTRIM(CsrAuxMaopera.estado)='1'
						=Oavisar.usuario("No se anulara el comprobante"+CHR(13)+" ya ha sido anulado anteriormente ",0)
						RETURN .f.
					ENDIF 
		
					SELECT CsrParaVario
					LOCATE FOR nombre='PFISCALPRE'
					ldpefiscal = CsrParaVario.fecha
					ldpeconfig = CTOD("01-"+RIGHT(CsrParaConfig.pefiscal,2)+"-"+LEFT(CsrParaConfig.pefiscal,4))
		
		*!*				IF (GOMONTH(ldpeconfig,-1)<ldpefiscal) OR (GOMONTH(ldpefiscal,2)<ldpeconfig)
		*!*					=Oavisar.usuario("ERROR"+CHR(13)+"PROCESO CANCELADO"+CHR(13)+"el comprobante"+CHR(13)+" el ultimo periodo presentado difiere en mas de dos mes con el actual",0)
		*!*					RETURN .f.
		*!*				ENDIF 
					
					ldfecha = CTOD("01-"+RIGHT(CsrAuxCabefac.pefiscal,2)+"-"+LEFT(CsrAuxCabefac.pefiscal,4))
		
					IF (GOMONTH(ldfecha,-1)<ldpefiscal) OR (GOMONTH(ldpefiscal,2)<ldfecha)
						=Oavisar.usuario("ERROR"+CHR(13)+"PROCESO CANCELADO"+CHR(13)+" el periodo facturado es menor o igual al ultimo periodo presentado ";
						+CHR(13)+'o el periodo facturado difiere de mas de dos meses con el presentado',0)
						RETURN .f.
					ENDIF 
			
					.actualizar()
				* + en form registracion grid 1 (confirma los valores de los plan	
				CASE lnopcion = 4
					IF .recalcular()
						.generarcuotas()
					ENDIF 
				*+ en la grilla de cuotas, se acepta el grabado
				CASE lnopcion = 5
					.contenedorRegistro.grid4.Visible = .f.
					.contenedorRegistro._texttotal.visible = .f.
					IF .grid4_control() AND .validarcomproba()
						.actualizar()
					ELSE
						=Oavisar.usuario("Verifique los siguientes errores"+CHR(13)+CHR(13)+.cadenaerrores,0)
						.grid1.column1.text1.setfocus
					ENDIF	
			ENDCASE
		ENDWITH 
	ENDPROC

	PROCEDURE key_f4		&& Consulta comprobantes
		
		LOCAL lcCtrlSource,lcalias,AcolOdataNavega,loObjCabefac,oca,lccmdCampos,lcIdretorno,lcorigen,loObjeto
		STORE '' TO lcCtrlSource,AcolOdataNavega,lccmdSelect,lcIdretorno
		
		*!*	loObjeto = CREATEOBJECT("Custom")
		*!*	loObjeto.AddProperty('idcompanulacion',thisform.idcompanulacion)
		
		loObjCabefac   = thisform.getrefobjneg('thisform.odatacabefac')
		lcalias = loObjCabefac.calias  && alias del objeto de negocio
		SELECT (lcalias)
		oca=thisform.obtenercursor(lcalias)
		
		public pndatasessionid
		pndatasessionid = thisform.datasessionid
		
		lcCmdCampos = 'CTACTE\FECHA\CNOMBRE\NUMCOMP\CUIT'   && campos a leer del archivo principal
		lcTypeData  = 'C\T\C\C\C'				&& tipo de dato de cada campo
		lcCmdMuestra     = 'NRO PROVEEDOR\FECHA\NOMBRE\NRO COMPROBANTE\CUIT'       && campos a mostrar
		lcCmdOperador    = '1\1\1\5\5'		        && igual\;no igual\;más que\;menos que\;contiene\;en
		lcCmdDatoInicial = " \ \ \ \ \ "
		
		lcOrigen = IIF(thisform.tipoform<>'R',"CPR","CPRREG")
		
		*!*	DO FORM buscompro WITH lcOrigen,oca,lcCmdCampos,lcTypeData,"A",loObjeto,lcCmdMuestra,lcCmdOperador,lcCmdDatoInicial TO lcIdretorno
		*!*	loObjeto = null
		
		LOCAL loObjParametro
		this.agregaobjeto.objbuscocomproba(@loObjParametro)
		
		WITH loObjParametro
			.oObjOca=oca
			.AddProperty('idcompanulacion',thisform.idcompanulacion)
			.cCmdCampos      = lcCmdCampos 
			.cTypeData       = lcTypeData
			.cCmdMuestra     = lcCmdMuestra
			.cCmdOperador    = lcCmdOperador
			.cCmdDatoInicial = lcCmdDatoInicial
			.cOrigen 		 = lcOrigen
			.cTypeSelection = "A"
		ENDWITH 
		
		&& "A" tipo eleccion permite elegir un solo comprobante de salida
		
		DO FORM buscompro WITH loObjParametro 
		lcidRetorno = loObjParametro.cidretorno
		loObjParametro = null
		
		IF LEN(TRIM(lcidretorno))#0
			thisform.accion = "C"
			thisform.cmdSalvar.Visible = .f.    	
			thisform.cmdborrar.Visible = .t.
			IF USED("CsrCurConsulta")
				GO TOP IN CsrCurConsulta
				lcidretorno = STRID(CsrCurConsulta.idmaopera)
			ENDIF 	
			thisform.bloqueocodigo = .f.
			thisform.consultando=.t.
			thisform.muestracomprobante(lcidretorno)
			thisform.ponerpantallamodoconsulta()
		ENDIF 
	ENDPROC

	PROCEDURE key_grid3		&& Grilla variedades
		LPARAMETERS lnKeyCode, lnShiftAltCtrl
		
		*DO CASE 
			*CASE lnKeyCode=43		
				WITH thisform 
					.lpidocantidad       = .f.
					.lcsetfocus          = "THISFORM.GRID2.COLUMN4.TEXT1"
					.lcgotfocus          = "THISFORM.GRID2.COLUMN5.TEXT1"
					.ultimocontainer     = "THISFORM.GRID2"
					.lblayudapie.Caption = "[Esc]Retrocede a Proveedor(Cancela editor precios)     [ + ]Graba"
					.containervariedad.LostFocus()
				 	.containervariedad.Visible = .f.
					.containervariedad.grid3.Visible = .f.	
					.containervariedad.Refresh
					.containerencabeza.Enabled= .t.
					
					.cmdasiento.Enabled = .t.
					.CmdBorrar.Enabled=.t.
					.cmdconsulta.Enabled=.t.
					.cmdimprimir.Enabled=.t.
					.cmdSalvar.Enabled=.t.
					.grid2.Enabled=.t.			
					
				    IF .Hayescape
				       .Hayescape = .f.
				       RETURN .t.
				    ENDIF 
				ENDWITH
		
				LOCAL lncantidad,Oscatter
		
				lncantidad = 0
				lncantreal = 0
				SELECT CsrSubproducto
				GO top
				SCAN FOR !EOF()
					SCATTER NAME Oscatter
					IF !.editarprecio &&AND Oscatter.cantreal=0
						oscatter.cantreal = Oscatter.cantidad
					ENDIF 
					SELECT CsrAuxCuerVari
					LOCATE FOR idsubarti = Oscatter.id AND pos =Oscatter.pos
					IF EOF() AND Oscatter.cantidad#0
					   	APPEND BLANK 
					   	
				  	   	REPLACE idsubarti WITH Oscatter.id,idarticulo WITH Oscatter.idarticulo,idvariedad WITH Oscatter.idvariedad;
				  	   		  ,cantidad WITH Oscatter.cantidad,kilos WITH Oscatter.kilos,volumen WITH Oscatter.volumen;
				  	   		  ,pos WITH Oscatter.pos,cantreal WITH oscatter.cantreal
				  	ELSE 
				  	   IF !EOF()
						  REPLACE cantidad WITH Oscatter.cantidad,kilos WITH Oscatter.kilos;
						  ,volumen WITH Oscatter.volumen,cantreal WITH oscatter.cantreal
				  	   ENDIF    
					ENDIF 			
					lncantidad = lncantidad + Oscatter.cantidad	
					lncantreal = lncantreal + Oscatter.cantreal
					
					SELECT Csrsubproducto
				ENDSCAN 	
		
				WITH thisform
					lbmodf = .f.
					IF !.editarprecio
						lncantreal = lncantidad
						lbmodf = .t.
					ENDIF 
					.editarprecio= lbmodf
					.grid2.column5.text1.value = lncantidad
					.grid2.column13.text1.value = lncantreal
					*.grid2.column13.text1.lostfocus()
					.editarprecio= !lbmodf
				    .hacerfocoen = ""
			    	.grid2.column5.text1.SetFocus 
			    	.grid2.column5.text1.Lostfocus()	
			    	*KEYBOARD '{TAB}'
				ENDWITH			
		*ENDCASE  
		
	ENDPROC

	PROCEDURE k_escape
		LOCAL lok
		
		thisform.hayescape = .t.
		DO CASE 
		   CASE UPPER(thisform.ultimocontainer)=UPPER("containeringreso")
		   	  thisform.limpiarcursor()
		      IF thisform.salirigual
		        lok = 6
		      ELSE 
		        lok = Oavisar.usuario('Desea abandonar la registración',36)
		      ENDIF   
		      IF lok=6       
		         thisform.Release
			  ELSE
			  	 thisform.containerencabeza._txtfecha.SetFocus          
		      ENDIF   
		             
		   CASE UPPER(thisform.ultimocontainer)=UPPER("containerencabeza") 	  
		   		thisform.containerencabeza._txtfecha.SetFocus 
		   		 
		   CASE UPPER(thisform.ultimocontainer)="CONTENEDORLIQ"
		   		thisform.cmdSalvar.Visible = .f.
		   		thisform.cmdrecuperar.Visible = .f.
		   		thisform.ultimocontainer = 'CONTAINERENCABEZA'
		   		thisform.containerencabeza._txtparada.SetFocus()

		   CASE UPPER(thisform.ultimocontainer)="THISFORM.GRID2"
		   		thisform.grid2_procesolinea(27)
		   		
		   CASE UPPER(thisform.ultimocontainer)="CONTAINERVARIEDAD"   
		   		WITH thisform
		   			.containervariedad.LostFocus()
			 		.containervariedad.Visible 			= .f.
					.containervariedad.grid3.Visible 	= .f.	
					.containervariedad.Refresh
					.CmdBorrar.Enabled					= .t.
					.cmdconsulta.Enabled				= .t.
					.cmdimprimir.Enabled				= .t.
					.cmdSalvar.Enabled					= .t.
					.grid2.Enabled						= .t.			
					.cmdAsiento.Enabled					= .t.
					.lhayvariedad 						= .f.
				ENDWITH 		
		   		thisform.grid2_procesolinea(27)      
		   		
		   CASE UPPER(thisform.ultimocontainer)="THISFORM.GRID1" 
		   		thisform.grid1.Visible = .f.
			   	thisform.grid1.Refresh 
			   	thisform.cmdasiento.Visible = .f.
			   	thisform.ponerpantallamodoeditarprecio(IIF(thisform.consultando,0,1))
			   	
			   	IF THISFORM.TIPOform <> 'R'
		   			thisform.grid1_procesolinea(27)
		   		ELSE
		   			thisform.grid1b_procesarlinea(27)
		   		ENDIF 
		   		
		   CASE UPPER(thisform.ultimocontainer)= "CONTAINERTOTALES"
		   			   	
			   	IF THISFORM.TIPOform <> 'R'
		   			thisform.grid2.Column1.text1.SetFocus()
		   		ELSE
		   			thisform.contenedorRegistro.grid1.column5.text1.SetFocus()
		   		ENDIF 	
		   		
		   CASE UPPER(thisform.ultimocontainer)="THISFORM.GRID4" 
		   		WITH thisform.contenedorRegistro
		   			.grid4.visible = .f.
		   			._texttotal.visible = .f.
		   			thisform.ultimocontainer="THISFORM.GRID1" 
		   			IF thisform.tipoform='R'
		   				.grid1.Visible = .t.
		   				.grid1.SetFocus()
		   			ELSE
		   				thisform.grid1.Visible = .t.
		   				thisform.grid1.SetFocus()
		   			ENDIF 
		   		ENDWITH 
		   				
		   OTHERWISE 
		     IF !EMPTY(thisform.hacerfocoen)
				lchacerfoco = thisform.hacerfocoen+'.setfocus'
				&lchacerfoco
				thisform.hacerfocoen = ''
		     ENDIF 
		ENDCASE 
		
	ENDPROC

	PROCEDURE leercomprobante		&& Lee comprobante, valido para la terminal , vendedor
		LOCAL lcidcomprobante
		
		STORE "" TO lcidcomprobante
		
		thisform.agregaobjeto.objcomprobante(@lcidcomprobante)
		lcidcomprobante	= IIF(LEN(TRIM(lcidcomprobante))=0,'0',lcidcomprobante)
		
		IF LEN(TRIM(lcidcomprobante))#0
		   TEXT TO lcCmd TEXTMERGE NOSHOW 
		   SELECT Csrcomprobante.* FROM comprobante as Csrcomprobante 
		   WHERE Csrcomprobante.id in (<<lcidcomprobante>>) AND regisl=1 order by cnombre
		   ENDTEXT 
		ENDIF 
		
		IF !thisform.obtenerdatos('Csrcomprobante',lccmd)
		   thisform.Release 
		ENDIF    
			
		
		LOCAL i,lcbusco
		*				   'UABCVI'  && ticket, factura, n.dto., n.cre., receta, n.pedido
		thisform.lcprioridad = '1ABCVUI'  && factura, n.dto., n.cre., receta, ticket, n.pedido
		
		SELECT Csrcomprobante
		FOR i=1 TO LEN(thisform.lcprioridad)
		    lcbusco = SUBSTR(thisform.lcprioridad,i,1)
			LOCATE FOR clase=lcbusco
			IF clase=lcbusco
			   EXIT 
			ENDIF 
		NEXT 
		
		REPLACE idcomproba WITH Csrcomprobante.id IN CsrAuxMaopera
		
		RETURN .t.
	ENDPROC

	PROCEDURE leerparametrosconfig		&& lee parametros configuracion general y diarios
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Csrplancue.*,isnull(Csrclasecta.cnumero,' ') as clasecta 
		from plancue as Csrplancue 
		left join clasecta as Csrclasecta on Csrplancue.idclase = Csrclasecta.id 
		where CsrPlanCue.id <-1 and imputable=1
		AND Csrplancue.IDEJERCICIO = <<GOAPP.IDEJERCICIO>>
		ENDTEXT 
		Oavisar.proceso('S','Cargando datos....')
		IF !thisform.obtenerdatos('CsrPlanCue',lcCmd)
			thisform.Release
		ENDIF 
		oavisar.proceso('N')
		
		SELECT CsrValor
		LOCATE FOR clasevalor="F"   && contado pendiente
		SELECT Csrplanpago
		LOCATE FOR idvalor=Csrvalor.id
		
		WITH thisform
			.lnidnrocaja	 = CsrPARACONFIG.iddetanrocaja
			.lnidejercicio	 = CsrPARACONFIG.idejercicio
			.talonario 	     =  IIF(.talonario!=0,.talonario,Csrparaconfig.talonpc1)
			.lniddeposito 	 = Csrparaconfig.iddeposito
			.lnidlocalidad   = Csrparaconfig.idlocalidad
			.lnidprovincia   = Csrparaconfig.idprovincia
			.listadefecto    = Csrparaconfig.listadefecto
			.lnidplanpago    = Csrplanpago.id
			
			
				       	
				       	
		ENDWITH
		
		
	ENDPROC

	PROCEDURE leerprefijoterminal		&& Leer archivo prefitermi para la terminal
		PARAMETERS lnidleer
		
		LOCAL lcCmd
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select Csrprefitermi.*,ISNULL(Csrprefijo.prefijo,-1) as prefijo,ISNULL(Csrprefijo.letra,' ') as letra,ISNULL(Csrprefijo.idimpresora,0) as idimpresora
		,ISNULL(Csrimpresora.nombre,SPACE(40)) as nomimpresora,ISNULL(Csrimpresora.tipo,0) as tipoimpresora,ISNULL(Csrimpresora.modelofis,0) as modelofis
		,ISNULL(Csrimpresora.puerto,0) as puerto,ISNULL(Csrimpresora.direccionip,SPACE(20)) as direccionip,ISNULL(Csrimpresora.portname,SPACE(40)) as nompuerto
		from prefitermi as Csrprefitermi
		left join prefijonro as Csrprefijo on Csrprefitermi.idprefijonro = Csrprefijo.id
		left join impresora as Csrimpresora on ISNULL(Csrprefijo.idimpresora,0) = Csrimpresora.id 
		where Csrprefitermi.idterminal = <<lnidleer>>
		ENDTEXT
		
		IF !thisform.obtenerdatos('Csrprefitermi',lccmd)
		   thisform.Release
		ENDIF
		
	ENDPROC

	PROCEDURE leerproximonro		&& Genera proximo nro comprobante
		PARAMETERS lnidleer,llupdate
		
		LOCAL lnidprefijo,lcCmd,ldebociclar
		
		WITH thisform
			.agregaobjeto.letracpra(CsrAuxcabefac.idtipoiva)
			lcCmd = "select Csrprefijonro.* from prefijonro as Csrprefijonro where letra= '"+.lcLetra+"'"
			IF !.obtenerdatos('Csrprefijonro',lccmd)
			   Oavisar.usuario('NO PUEDE LEER EL PREFIJO ESPECIFICADO '+.lcLetra,0)
			   RETURN .f. 
			ENDIF
		
			lnidprefijo = 0
			
			SELECT Csrprefitermi
			LOCATE FOR lnidleer=idcomproba
			lnidprefijo=idprefijonro
			
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			Select Csrprefijonro.*,Csrformulario.diseno as diseno
			from prefijonro as Csrprefijonro
			left join formulario as Csrformulario on Csrprefijonro.formulario = Csrformulario.id
			where Csrprefijonro.id =<<lnidprefijo>>
			ENDTEXT
		
			IF !.obtenerdatos('Csrprefijonro',lccmd)
			   Oavisar.usuario('NO PUEDE LEER EL PREFIJO ESPECIFICADO '+STRID(lnidprefijo),0)
			   .Release
			   RETURN .f.
			ENDIF

			&& F = NORMAL: se sugiere prefijonro.numero + 1 (numero = ultimo usado), no editable
			&& M = MANUAL: el numero lo carga el operador en _txtnumcomp
			IF .tipoform = 'F'
				IF lnidprefijo = 0 OR RECCOUNT('Csrprefijonro') = 0
					Oavisar.usuario('NO ES POSIBLE ESTABLECER EL PROXIMO NUMERO'+CHR(13);
									+'PARA    '+TRIM(Csrcomprobante.cnombre)+CHR(13);
									+'DEBE ASIGNAR UN PREFIJO AL COMPROBANTE PARA LA TERMINAL',0)
					RETURN .f.
				ENDIF
				.talonario = Csrprefijonro.prefijo
				.containerencabeza._txtptovta.Value = .talonario
				&& se sugiere el ultimo + 1; el numero real (y prefijonro.numero) se ajusta luego con lo que devuelve ARCA
				.containerencabeza._txtnumcomp.Value = Csrprefijonro.numero + 1
				.containerencabeza._txtnumcomp.Refresh()
			ENDIF

			.proximonro  = .lcletra + strzero(.talonario,4) + strzero(.containerencabeza._txtnumcomp.Value,8)
			.containerencabeza._txtletra.Value = LEFT(.proximonro,1)
		
			SELECT Csrprefitermi
			LOCATE FOR idprefijonro = lnidprefijo
		    
			.idimpresora = Csrprefijonro.idimpresora
			.formulario  = VAL(Csrprefijonro.diseno)
			.lcimpresora = IIF(LEN(TRIM(Csrprefitermi.nompuerto))#0,Csrprefitermi.nompuerto,Csrprefitermi.nomimpresora)
			.copiastkt   = Csrprefijonro.copias
			.canlinea    = Csrprefijonro.cantlinea
		ENDWITH 
		
	ENDPROC

	PROCEDURE leerseteoterminal		&& Leer archivo seteotermi
		
		lcCmd = 'select CsrSeteotermi.* from seteotermi as Csrseteotermi where numero ='+str(Goapp.terminal)
		thisform.obtenerdatos('Csrseteotermi',lccmd)
		thisform.lnidterminal   = Csrseteotermi.id
		thisform.sectorterminal = Csrseteotermi.sector
		thisform.puestocaja     = Csrseteotermi.puestocaja
		
		IF thisform.lnidterminal=0
		   thisform.Release 
		ENDIF
		
		RETURN .t.
	ENDPROC

	PROCEDURE limpiarcursor		&& Limpia los cursores despues de grabar
		
		WITH thisform
			.grid1.Visible = .f.
			.ultimocontainer = UPPER("containerencabeza")
			.iniciavariables()
			.insertacursor(.f.,.t.)
			.leercomprobante()
			
			IF this.lnini_comproba != 0
				SELECT CsrComprobante
				LOCATE FOR id = .lnini_comproba
				replace idcomproba WITH CsrComprobante.id IN CsrAuxMaopera
			ENDIF 
			
			.accion = "A"
			.cmdSalvar.Visible = .t.    	
			.cmdborrar.Visible = .f.
			.cmdImprimir.Visible = .f.
			.cmdasiento.Visible = .f.
			&&.pulseborrar = .f.
			.ponerpantallamodoedicion()   
			
			TEXT TO lcCmd TEXTMERGE NOSHOW    
		   	Select CsrMovctacte.*,Csrmaopera.idcomproba as idcomproba
		   	from Movctacte as CsrMovctacte
		   	left join maopera as Csrmaopera on CsrMovctacte.idmaopera = Csrmaopera.id
		   	where CsrMovCtacte.id < 0 
		   	ENDTEXT 
		   	thisform.obtenerdatos('CsrMovctacte',lccmd)
		ENDWITH
		
	ENDPROC

	PROCEDURE limpiarpagos
		SET SAFETY OFF 
		IF USED('CsrPAgo')
			SELECT CsrPAgo
			ZAP 
		ENDIF 
		SET SAFETY ON 
		thisform.containertotales._txttotal.Value = 0
		thisform.containertotales._txtaccion.Value = 0
		thisform.containertotales._txtctacte.Value = 0
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		thisform.crearcursor()
		
		
	ENDPROC

	PROCEDURE mostrarliqlacteo		&& Llena LiqDatos (ContenedorLiq) con la liquidacion de CsrLiqLacteo (lo que se envia a ARCA)
		LOCAL loCtrl,lcperiodo,lnkg,lcalias,llajuste,loAnt
		
		lcalias = ALIAS()
		lcperiodo = ALLTRIM(thisform.containerencabeza._txtperiodo.Value)

		SET SAFETY OFF
		SELECT LiqDatos
		ZAP
		SET SAFETY ON
		APPEND BLANK

		IF USED('CsrLiqLacteo') AND RECCOUNT('CsrLiqLacteo')>0
			SELECT CsrLiqLacteo
			GO TOP
			lnkg = CsrLiqLacteo.kggrasa + CsrLiqLacteo.kgproteina
			&& un solo precio por kg de solidos utiles = total / (kg grasa + kg proteina)
			&& (liqlacteo.preciokg es solo de grasa y solo del basico, no se usa)
			&& base de percepciones truncada a entero, como las LUM emitidas
			replace litros WITH CsrLiqLacteo.litrosfactura, grasa WITH CsrLiqLacteo.grasa, proteina WITH CsrLiqLacteo.proteina;
					,kggrasa WITH CsrLiqLacteo.kggrasa, kgproteina WITH CsrLiqLacteo.kgproteina;
					,preciokg WITH IIF(lnkg=0,0,ROUND(CsrLiqLacteo.subtotal/lnkg,2));
					,total WITH CsrLiqLacteo.subtotal, pctiva WITH CsrLiqLacteo.pctiva, iva WITH CsrLiqLacteo.iva;
					,baseperiva WITH INT(CsrLiqLacteo.subtotal), pctperiva WITH CsrLiqLacteo.pctretiva, periva WITH CsrLiqLacteo.retiva;
					,baseperiibb WITH INT(CsrLiqLacteo.subtotal), pctperiibb WITH CsrLiqLacteo.pctiibb, periibb WITH CsrLiqLacteo.retiibb;
					,totimpuestos WITH CsrLiqLacteo.retiva + CsrLiqLacteo.retiibb, neto WITH CsrLiqLacteo.neto IN LiqDatos

			thisform.ContenedorLiq.lblLiqTitulo.Caption = "Liquidación a enviar a ARCA:  Tambo "+ALLTRIM(STR(CsrLiqLacteo.nrotambo));
									+" "+ALLTRIM(CsrLiqLacteo.nomtambo)+"  -  Período "+LEFT(CsrLiqLacteo.periodo,4)+"/"+RIGHT(CsrLiqLacteo.periodo,2)
			thisform.ContenedorLiq.lblLiqTitulo.ForeColor = RGB(0,0,128)
		ELSE
			&& sin liquidacion: en M el operador carga todo (incluidos los %) del impreso
			thisform.ContenedorLiq.lblLiqTitulo.Caption = "No hay liquidación mensual grabada (sin emitir) para el tambo de la cuenta en el período ";
									+IIF(LEN(lcperiodo)=6,LEFT(lcperiodo,4)+"/"+RIGHT(lcperiodo,2),lcperiodo);
									+IIF(thisform.tipoform = 'M',"  -  cargue los datos a mano","")
			thisform.ContenedorLiq.lblLiqTitulo.ForeColor = RGB(192,0,0)
			IF thisform.tipoform = 'M'
				&& porcentajes sugeridos para la carga manual (se pueden cambiar)
				replace pctiva WITH 21, pctperiva WITH 1, pctperiibb WITH 0.5 IN LiqDatos
			ENDIF
		ENDIF

		IF !PEMSTATUS(thisform,'oliqant',5)
			thisform.AddProperty('oliqant',.NULL.)
		ENDIF
		SELECT LiqDatos
		SCATTER NAME loAnt
		thisform.oliqant = loAnt

		&& en M (manual) se editan; total otros impuestos y neto siempre se calculan
		WITH thisform.ContenedorLiq
			FOR EACH loCtrl IN .Controls
				IF UPPER(loCtrl.BaseClass)='TEXTBOX'
					loCtrl.Enabled = (thisform.tipoform = 'M') AND !INLIST(UPPER(loCtrl.Name),'_TXTTOTIMPUESTOS','_TXTNETO','_TXTPTOVTALIQ','_TXTNROLIQ')
				ENDIF
			ENDFOR
			&& NC / ND: se carga la liquidacion original (punto de venta + numero)
			llajuste = CsrComprobante.clase$'BC'
			STORE llajuste TO .lblLiqOrig.Visible, ._txtptovtaliq.Visible, ._txtnroliq.Visible, .lblLiqOrigCae.Visible
			STORE llajuste TO ._txtptovtaliq.Enabled, ._txtnroliq.Enabled
			STORE llajuste TO .lblTipoAjuste.Visible, ._cbotipoajuste.Visible, ._cbotipoajuste.Enabled
			IF llajuste
				replace tipoajuste WITH ._cbotipoajuste.List(1) IN LiqDatos	&& unica opcion por ahora
			ENDIF 
			.lblLiqOrigCae.Caption = ""
			.Refresh()
		ENDWITH

		IF !EMPTY(lcalias) AND USED(lcalias)
			SELECT (lcalias)
		ENDIF

	ENDPROC

	PROCEDURE controlliqdatos		&& Modo M: sugiere lo que depende del campo editado y recalcula otros impuestos y neto
		LPARAMETERS lcCampo
		LOCAL loAnt

		IF thisform.tipoform # 'M'
			RETURN .t.
		ENDIF

		&& Sugerencias (todo se puede editar): solo si el campo cambio respecto de la ultima vez,
		&& para no pisar lo que el operador corrigio a mano en los campos que dependen de el
		lcCampo = LOWER(ALLTRIM(IIF(VARTYPE(lcCampo)='C',lcCampo,'')))
		IF !PEMSTATUS(thisform,'oliqant',5)
			thisform.AddProperty('oliqant',.NULL.)
		ENDIF
		IF !EMPTY(lcCampo) AND VARTYPE(thisform.oliqant)='O' AND TYPE('LiqDatos.'+lcCampo)='N';
				AND EVALUATE('LiqDatos.'+lcCampo) # EVALUATE('thisform.oliqant.'+lcCampo)
			SELECT LiqDatos
			&& kg o precio -> total (una linea por componente, cada una redondeada, como ARCA)
			IF INLIST(lcCampo,'kggrasa','kgproteina','preciokg')
				replace total WITH ROUND(kggrasa*preciokg,2) + ROUND(kgproteina*preciokg,2) IN LiqDatos
				lcCampo = 'total'
			ENDIF
			&& total -> IVA y bases de las retenciones
			IF lcCampo == 'total'
				replace baseperiva WITH total, baseperiibb WITH total IN LiqDatos
			ENDIF
			IF INLIST(lcCampo,'total','pctiva')
				replace iva WITH ROUND(total*pctiva/100,2) IN LiqDatos
			ENDIF
			IF INLIST(lcCampo,'total','baseperiva','pctperiva')
				replace periva WITH ROUND(baseperiva*pctperiva/100,2) IN LiqDatos
			ENDIF
			IF INLIST(lcCampo,'total','baseperiibb','pctperiibb')
				replace periibb WITH ROUND(baseperiibb*pctperiibb/100,2) IN LiqDatos
			ENDIF
		ENDIF

		replace totimpuestos WITH LiqDatos.periva + LiqDatos.periibb IN LiqDatos
		replace neto WITH LiqDatos.total + LiqDatos.iva - LiqDatos.totimpuestos IN LiqDatos

		&& foto de los valores para detectar el proximo cambio
		SELECT LiqDatos
		SCATTER NAME loAnt
		thisform.oliqant = loAnt

		thisform.ContenedorLiq.Refresh() 
		
	ENDPROC

	PROCEDURE muestracomprobante		&& muestra el comprobante elegido para modificar o borrar
		PARAMETERS lcidmaopera
		
		LOCAL lcCmd,Oscatter,OscatterCab,lok,lcaliascateibto,lnporperce,lnporrete
		
		lcidmaopera = CHRTRAN(lcidmaopera,",","")
		
		lndecimaluni = thisform.ndecimaluni
		lndecimaltot = thisform.ndecimaltot
		lok          = .f.
		
		SET SAFETY OFF 
		
		SELECT CsrAuxmaopera
		ZAP
		
		SELECT CsrAuxCabefac
		ZAP 
		
		SELECT CsrauxCuerfac
		ZAP
		
		SELECT CsrAuxplancue
		ZAP
		
		SELECT CsrAuxCuerVari
		ZAP
		
		SET SAFETY ON
		
		* maopera
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrmaopera.*,ISNULL(Csrdetanrocaja.nrocaja,0) as nrocaja,'A' as lcOriginal
		from maopera as Csrmaopera
		left join detanrocaja as Csrdetanrocaja on Csrmaopera.iddetanrocaja = Csrdetanrocaja.id
		where Csrmaopera.id = <<lcidmaopera>>
		ENDTEXT 
				
		lok=thisform.obtenerdatos('Csrmaopera',lccmd)
		        
		IF !lok
		  RETURN .f.
		ENDIF
		
		SELECT Csrmaopera
		GO TOP 
		SCATTER NAME Oscatter
			   
		SELECT CsrAuxmaopera
		APPEND BLANK
		GATHER NAME Oscatter		
		
		* afeasto
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrmaopera.*,ISNULL(Csrdetanrocaja.nrocaja,0) as nrocaja,'B' as lcOriginal
		from afeasto as CsrAfeasto
		left join maopera as CsrMaopera on CsrAfeasto.idmaoperaa = CsrMaopera.id
		left join detanrocaja as Csrdetanrocaja on Csrmaopera.iddetanrocaja = Csrdetanrocaja.id
		where CsrAfeAsto.idmaoperao = <<lcidmaopera>>
		ENDTEXT 
			
		IF !CrearCursorAdapter('Csrmaopeasto',lccmd)
		    RETURN .f.
		ENDIF     
		      
		SELECT Csrmaopeasto
		GO TOP 
		SCAN 
			SCATTER NAME Oscatter
			   
			SELECT CsrAuxmaopera
			APPEND BLANK
			GATHER NAME Oscatter  
		ENDSCAN 
		
		* Cabecpra
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrcabecpra.* from cabecpra as Csrcabecpra where Csrcabecpra.idmaopera in (<<lcidmaopera>>)
		ENDTEXT 
		IF !thisform.obtenerdatos('Csrcabecpra',lccmd)
		   RETURN .f.
		ENDIF
				
		SELECT CsrAuxCabefac
		SCATTER NAME OscatterCab
		
		SELECT CsrCabecpra
		SCATTER NAME OscatterCab ADDITIVE 
		OscatterCab.vencimien = OscatterCab.fecha
		
		* Datos del detalle
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrcabedeta.* from cabedeta as Csrcabedeta 
		where Csrcabedeta.idmaopera in (<<lcidmaopera>>)
		order by id
		ENDTEXT 
		IF !thisform.obtenerdatos('Csrcabedeta',lccmd)
		  RETURN .f.
		ENDIF
		SELECT CsrCabeDeta
		OscatterCab.detalle = CsrCabeDeta.detalle
						
		SELECT CsrAuxCabefac
		APPEND BLANK
		GATHER NAME OscatterCab
		
		replace pefiscal WITH OscatterCab.pefiscal IN CsrAuxMaopera
		
		*thisform.agregaobjeto.letractacte(CsrAuxcabefac.idtipoiva)
		thisform.agregaobjeto.letracpra(CsrAuxcabefac.idtipoiva)
		
		*lccuit = STRTRAN(CsrAuxcabefac.cuit,"-","")
		lccuit = STRTRAN(goapp.empresacuit,"-","")
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select CsrcateCtaCte.*,CAST(0 as numeric(8,3)) as porperce,CAST(0 as numeric(8,3)) as porrete
		from cateCtaCte as CsrcateCtaCte 
		where CsrcateCtaCte.id = <<OscatterCab.idcategoria>>
		ENDTEXT 
		
		IF USED("CsrCateCtaCte")
			USE IN CsrCateCtaCte
		ENDIF
		
		=CrearCursorAdapter('CsrCateCtaCte',lccmd)
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		Select CsrCtacteFlete.*
		from CtacteFlete as CsrCtacteFlete
		where CsrCtacteFlete.idctacte = <<OscatterCab.idctacte>>
		ENDTEXT 
		CrearCursorAdapter('CsrCtacteFlete',lccmd)
		
		TEXT TO lccmd TEXTMERGE NOSHOW 
		SELECT CsrCtacte.* FROM Ctacte as CsrCtacte WHERE CsrCtacte.id = <<OscatterCab.idctacte>>
		ENDTEXT 
		thisform.obtenerdatos('CsrCtacte',lccmd)
		thisform.cargartambodatos(OscatterCab.idctacte)
		thisform.esbonifica	 = IIF(CsrCtacte.totalizabonif=1,.f.,.t.)
		thisform.esrecodevol = IIF(CsrCtacte.esrecodevol=1,.t.,.f.)
		
		lcaliascateibto= ""
		STORE 0 TO lnporperce,lnporrete
		
		WITH Thisform 
			.agregaobjeto.objobteneribto(lccuit,OscatterCab.idprovincia,@lcaliascateibto,@lnporperce,@lnporrete)
			IF RECCOUNT("CsrCateCtaCte")#0
				REPLACE porperce WITH lnporperce,porrete WITH lnporrete IN CsrCateCtacte
			ENDIF 
		
			.containerencabeza._txtletra.Value   = left(CsrAuxmaopera.numcomp,1)
			.containerencabeza._txtptovta.value  = VAL(subs(CsrAuxmaopera.numcomp,2,4))
			.containerencabeza._txtnumcomp.Value = VAL(righ(CsrAuxmaopera.numcomp,8))
			.talonario 							 = .containerencabeza._txtptovta.value
		ENDWITH
		
		* Cuercpra
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrcuercpra.* from Cuercpra as Csrcuercpra where Csrcuercpra.idmaopera in (<<lcidmaopera>>)
		ENDTEXT 
				        
		IF !thisform.obtenerdatos('Csrcuercpra',lccmd)
		  RETURN .f.
		ENDIF
		
		SELECT CsrauxCuerfac
		SCATTER NAME Oscatter
		
		
		
		SELECT CsrCuercpra
		GO top
		SCAN FOR !EOF()
			SCATTER NAME Oscatter ADDITIVE 
					
			lncantidad = IIF(Oscatter.cantidad=0,1,Oscatter.cantidad)
			lnunibulto = IIF(Oscatter.unibulto=0,1,Oscatter.unibulto)
			lnuniventa = Oscatter.univenta			
			lnunibulto = IIF(lnuniventa=1,1,lnunibulto)
			lnCantFinal = IIF(lnCantidad=0,1,lnCantidad)
			lnCantidad = lnCantidad / lnunibulto
			Oscatter.cantidad = lnCantidad
			lnpesable		= Oscatter.pesable
			lnkilos			= Oscatter.Kilos
			Oscatter.kilos    = Oscatter.kilos / lnCantFinal
			Oscatter.volumen  = Oscatter.volumen / lnCantFinal
			
			IF Oscatter.pesable=0
				Oscatter.CantKilos = Oscatter.kilos*lnCantidad
			ENDIF 
			WITH thisform
				IF !.esbonifica
					*Total Bonificado
					.esbonifica = .t.
					.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
					Oscatter.totalBonif= Red((Oscatter.UniSiva + Oscatter.internofin),lndecimaltot)
					*Total Sin Bonificacion (Neto)
					.esbonifica = .f.
					.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
					Oscatter.total= Red((Oscatter.UniSiva + Oscatter.internofin),lndecimaltot)	
						
					Oscatter.TotalBonif = Oscatter.Total - Oscatter.TotalBonif
				ELSE
					*Total Bonificado
					.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)
					Oscatter.total= Red((Oscatter.UniSiva + Oscatter.internofin),lndecimaltot)
				ENDIF 
		 
				
				
		*!*			.unitariofac.Calculaimpuesto(Oscatter,OscatterCab,lnCantidad,lnunibulto,lnpesable,lnkilos)	
		*!*			Oscatter.total = Red((Oscatter.UniSiva + Oscatter.internofin),lndecimaltot)		
			ENDWITH 		
			SELECT CsrauxCuerfac
			APPEND BLANK
		    GATHER NAME Oscatter 	      
			    
			SELECT CsrCuercpra
		ENDSCAN
		
				
				
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrcuervaricpra.* from Cuervaricpra as Csrcuervaricpra where Csrcuervaricpra.idmaopera in (<<lcidmaopera>>)
		ENDTEXT 
		        
		IF !thisform.obtenerdatos('Csrcuervaricpra',lccmd)
		  RETURN .f.
		ENDIF
		
		SELECT CsrCuerVaricpra
		GO top
		SCAN FOR !EOF()
		 	SCATTER NAME Oscatter ADDITIVE 
			SELECT CsrAuxCuerfac
			LOCATE FOR id=Oscatter.idcuerfac
			IF id=Oscatter.idcuerfac
				lnunibulto = IIF(CsrAuxCuerfac.unibulto=0,1,CsrAuxCuerfac.unibulto)
				lnuniventa = CsrAuxCuerfac.univenta
				lnunibulto = IIF(lnuniventa=1,1,lnunibulto)
				lnCantFinal = IIF(Oscatter.cantidad=0,1,Oscatter.cantidad)
				Oscatter.cantidad = Oscatter.cantidad / lnunibulto
				Oscatter.kilos    = Oscatter.kilos / lnCantfinal
				Oscatter.volumen  = oscatter.volumen / lnCantFinal
			ENDIF 
						
			SELECT CsrauxCuervari
			APPEND BLANK
		    GATHER NAME Oscatter 	      
		    
			SELECT CsrCuervaricpra
		ENDSCAN	   
		
		** sacamos del movstock... las cantidades reales
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrMovStock.* from MovStock as CsrMovStock where CsrMovStock.idmaopera in (<<lcidmaopera>>)
		ENDTEXT 
				        
		IF !thisform.obtenerdatos('CsrMovStock',lccmd)
		  RETURN .f.
		ENDIF
		
		SELECT CsrauxCuerfac
		SCATTER NAME Oscatter
		
		SELECT CsrMovStock
		GO top
		SCAN FOR !EOF()
			SCATTER NAME Oscatter ADDITIVE 
			SELECT CsrAuxCuerfac
			LOCATE FOR id=Oscatter.idorigen
			IF id=Oscatter.idorigen
				replace CantReal WITH  CantReal + Oscatter.cantidad;
				, KilosReal WITH KilosReal + Oscatter.kilos IN CsrAuxCuerfac
			ENDIF 			
		    
			SELECT CsrMovStock
		ENDSCAN
		
		* Tablaimp
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrtablaimp.*,ISNULL(Csridasociado.idpadre,0) as idpadre,ISNULL(Csridasociado.idhijo,0) as idhijo
		,ISNULL(Csrplancue.cuenta,0) as cuenta,ISNULL(Csrplancue.nombre,' ') as Nomcta,ISNULL(Csrprovincia.nombre,' ') as nomprov
		from Tablaimp as Csrtablaimp
		left join idasociado as Csridasociado on Csrtablaimp.id = Csridasociado.idhijo
		left join cabeasi as CsrCabeAsi on Csrtablaimp.idmaopera = csrcabeasi.idmaopera
		left join plancue as Csrplancue on Csrtablaimp.idcuenta = Csrplancue.id and CsrCabeasi.idejercicio = CsrPlanCue.idejercicio
		left join provincia as Csrprovincia on ISNULL(Csrtablaimp.idprovincia,0)=Csrprovincia.id
		where Csrtablaimp.idmaopera in (<<lcidmaopera>>)
		order by tipoconce
		ENDTEXT 
		
		IF !thisform.obtenerdatos('Csrtablaimp',lccmd)
		  RETURN .f.
		ENDIF
		
		thisform.totPlancue = 0
		IF thisform.tipoform#'R'
			SELECT Csrtablaimp
			GO top
			SCAN FOR !EOF()
				* safo lo q no tenga asiento
				IF idasiento = 0
					LOOP 
				ENDIF 
				
				* safo la linea de iva			
			 	IF tipoconce="IG"
		        	LOOP 
			 	ENDIF         
		     	SCATTER NAME OScatter        
			 	OsCatter.nombre = nomcta
			 		
			 	SELECT CsrAuxPlancue
			 	APPEND BLANK
			 	thisform.totPlancue = thisform.totPlancue + 1
		     	GATHER NAME Oscatter 
			 	IF !Oscatter.tipoconce$"NG-EX-II"
			 		REPLACE importe WITH Oscatter.baseimp,impuesto WITH Oscatter.importe, origen WITH 'A'
		 	 	ENDIF
		
			 	SELECT CsrTablaimp
			ENDSCAN
		
			SELECT CsrAuxplancue
			GO top
			SCAN FOR !EOF()
				 IF tipoconce#"NG"
				 	loop
				 ENDIF 
				 SELECT Csrtablaimp
				 LOCATE FOR idpadre = CsrAuxplancue.id
				 IF idpadre=CsrAuxplancue.id
				    REPLACE tasa WITH CsrTablaimp.tasa,impuesto WITH Csrtablaimp.importe , origen WITH 'A' IN CsrAuxplancue
				 ENDIF 
				 SELECT CsrAuxplancue	 
			ENDSCAN
			
			STORE 0 TO lnRecoDevol,lnTotalSubNG,lnTotalBonifNG,lnTotalRecoNG,lnTotalSubEX,lnTotalBonifEX,lnTotalRecoEX	
			
			SELECT CsrTablaImp
			GO TOP 
			SCAN FOR !EOF()
				lnTotalSubNG 	= IIF(CsrTablaImp.tipoconce$'NT',CsrTablaImp.importe,lnTotalSubNG)
				lnTotalBonifNG	= IIF(CsrTablaImp.tipoconce$'NB',CsrTablaImp.importe,lnTotalBonifNG)
				lnTotalRecoNG	= IIF(CsrTablaImp.tipoconce$'ND',CsrTablaImp.importe,lnTotalRecoNG)
				
				lnTotalSubEX 	= IIF(CsrTablaImp.tipoconce$'ET',CsrTablaImp.importe,lnTotalSubEX)
				lnTotalBonifEX	= IIF(CsrTablaImp.tipoconce$'EB',CsrTablaImp.importe,lnTotalBonifEX)
				lnTotalRecoEX	= IIF(CsrTablaImp.tipoconce$'ED',CsrTablaImp.importe,lnTotalRecoEX)
			ENDSCAN 
			
			Thisform.Containertotales._txtSubTotalNG.Value	= ROUND(lnTotalSubNG,3)
			Thisform.Containertotales._txtbonifNG.value		= ROUND(lnTotalBonifNG,3)
			Thisform.Containertotales._txtrecodevolNG.value	= ROUND(lnTotalRecoNG,3)
			Thisform.Containertotales._txtTotalNG.Value	= ROUND(lnTotalSubNG - (lnTotalBonifNG + lnTotalRecoNG),lndecimaltot)
			Thisform.Containertotales._txtSubTotalEX.Value	= ROUND(lnTotalSubEX,3)
			Thisform.Containertotales._txtbonifEX.value		= ROUND(lnTotalBonifEX,3)
			Thisform.Containertotales._txtrecodevolEX.value	= ROUND(lnTotalRecoEX,3)
			Thisform.Containertotales._txtTotalEX.Value	= ROUND(lnTotalSubEX - (lnTotalBonifEX + lnTotalRecoEX),lndecimaltot)
			
			this.muestratotales()
			
		ELSE
			SELECT Csrtablaimp
			GO top
			SCAN FOR !EOF()
				 SCATTER NAME OScatter        
				 OsCatter.nombre = nomcta
				 	      
				 SELECT CsrAuxPlancue
				 APPEND BLANK
				 thisform.totPlancue = thisform.totPlancue + 1
			   	  GATHER NAME Oscatter 
				 IF !Oscatter.tipoconce$"NG-EX"
				 	REPLACE importe WITH Oscatter.importe,tasa WITH Oscatter.tasa, origen WITH 'A'
			 	 ENDIF 
			ENDSCAN
		ENDIF 
		
		
		
				
		IF thisform.tipoform$"R"
			lcname = "thisform.contenedorRegistro"
			lObjeto = &lcname
		ELSE
			lcname = "thisform"
			lObjeto = &lcname
		ENDIF 
		
		SELECT CsrAuxPlanCue
		GO TOP 
		lnRecno = RECNO()
		SCAN 
			SELECT CsrClaseCta
			LOCATE FOR cnumero = CsrAuxPlanCue.tipoconce
			lObjeto.grid1.column3.combo1.Value = CsrClaseCta.id
			lObjeto.grid1.column3.combo1.DisplayValue = CsrClaseCta.cnombre
			lObjeto.grid1.column3.combo1.refresh()
			SELECT CsrAuxPlanCue
		ENDSCAN 
			
		lObjeto = null	
		
		GO lnRecno
		
		IF USED("Csrcursor")
		   USE IN Csrcursor
		ENDIF
		* nro de cuotas
		TEXT TO LCCMD TEXTMERGE NOSHOW 
		SELECT  COUNT(CsrMovctacte.ID) AS NROCUOTA from MOVCTACTE  as CsrMovctacte WHERE IDMAOPERA in (<<lcidmaopera>>)
		ENDTEXT 
		=CrearCursorAdapter('CsrNroCuota',lccmd)
		IF RECCOUNT('CsrNroCuota')#0
			thisform.ContainerEnCabeza._txtnrocuotas.Value = CsrNroCuota.nrocuota
		ENDIF 
		*Movbcocar
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrmovbcocar.*,CsrMovBcodeta.* from Movbcocar as CsrMovbcocar
		left join movbcodeta as CsrMovBcoDeta on CsrMovBcocar.id = CsrMovBcodeta.idmovbcocar
		where Csrmovbcocar.idmaopera in (<<lcidmaopera>>)
		ENDTEXT 
		
		=CrearCursorAdapter("Csrcursor",lccmd)
		
		IF USED("CsrPago")
			USE IN CsrPago
		ENDIF
		
		SELECT id as id,idmaopera as idmaopera,importe as importe,numero as nrocheque,idctabco as idctabco,banco as banco,localidad as localidad;
		,fechavto as fechavto,cuit as cuit,titular as titular,recibido as recibido,entregado as entregado,fecha as fecha;
		,000 as numero,SPACE(25) as cnombre,CAST(0 as int) as idcuenta,SPACE(6) as ctactebco,CAST(0 as int) as idtipobco;
		,CAST(0 as int) as idvalor,CAST(0 as int) as idprovincia,'  ' as tipocaja,' ' as esclase,SPACE(15) as nrotarjeta;
		,SPACE(15) as cupon,00 as cuota,SPACE(254) as idcheque,SPACE(50) as detalle;
		,idbanco,idctaentrega as IdctaEntregado,idctarecibido,idctatitular,idlocalidad,codbarra as nroidentificador,cuit as lccuit;
		FROM Csrcursor INTO CURSOR CsrPago READWRITE 
		
		IF thisform.tipoform$"R"
			thisform.totalregistracion()
			thisform.contenedorRegistro.grid1.Visible = .t.
			thisform.grid1.Visible = .f.
			thisform.contenedorRegistro.grid1.coluMN1.Enabled = .t.
		ELSE 
			thisform.totalcomprobante(2)
			*thisform.grid1.Visible = .t.
		ENDIF 
		
		SELECT CsrAuxCuerfac
		GO top
		
		*Cierre de ejericio
		IF !this.oCONTABILIDAD.Validar()
			this.cmdBorrar.Visible = .f.
		ENDIF 
		
		* para que repinte el comprobante
		thisform.containerencabeza._cbocomprobante.SetFocus
		thisform.containerencabeza._cbocomprobante.Click
		
		thisform.Refresh
		thisform.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
		
		RETURN .t.
		
	ENDPROC

	PROCEDURE muestratotales
		WITH thisform.containertotales
			lndecimaluni = thisform.ndecimaluni
			lndecimaltot = thisform.ndecimaltot
			
			STORE 0 TO lnBaseGra,lnBaseExe,lnBaseIva,lnBasePercepcion,lnBaseOtros,lnBasePIVA
			
			SELECT CsrAuxPlanCue
			GO TOP 
			SCAN 
				SCATTER NAME Oscatter
				DO CASE 
				CASE Oscatter.tipoconce='PB'
					.lbl01.caption   = PROPER(LEFT(Oscatter.nombre,11))
				CASE !Oscatter.tipoconce$'PB-NG-EX-PI'
					.lbl02.caption  = PROPER(LEFT(Oscatter.nombre,11))
				CASE Oscatter.tipoconce='PI'
					.lbl03.caption	= PROPER(LEFT(Oscatter.nombre,11))
				ENDCASE 
				lnBaseOtros = lnBaseOtros + IIF(!Oscatter.tipoconce$'PB-NG-EX-IG-PI',Oscatter.importe,0)
				lnBasePIVA = lnBasePIVA + IIF(Oscatter.tipoconce='PI',Oscatter.impuesto,0)
				lnBasePercepcion = lnBasePercepcion + IIF(Oscatter.tipoconce='PB',Oscatter.impuesto,0)
				lnBaseGra = lnBaseGra + IIF(Oscatter.tipoconce='NG',Oscatter.importe,0)
				lnBaseExe = lnBaseExe + IIF(Oscatter.tipoconce='EX',Oscatter.importe,0)
				lnBaseIva = lnBaseIva + IIF(Oscatter.tipoconce='NG',Oscatter.impuesto,0)
			ENDSCAN 
			
			._txtiva.Value			 = ROUND(lnBaseiva,lndecimaltot)
			._txtnetoexento.Value	 = ROUND(lnBaseExe,lndecimaltot)
			._txtnetogravado.Value	 = ROUND(lnBaseGra,lndecimaltot)
			._txttotal.Value		 = lnBaseGra+lnBaseExe+lnBaseIva+lnBasePercepcion+lnBaseOtros+lnBasePIVA
			._txt01.value			 = ROUND(lnBasePercepcion,lndecimaltot)
			._txt02.value			 = ROUND(lnBaseOtros,lndecimaltot)
			._txt03.value			 = ROUND(lnBasePiva,lndecimaltot)
		ENDWITH 
	ENDPROC

	PROCEDURE ocultartotalizadores
		lparameter locultar
		locultar = iif(pcount()<1,.f.,locultar)
		
		WITH This.Containertotales
			._txtSubtotalNG.visible		= lOcultar
			._txtBonifNG.visible 		= lOcultar
			._txtrecodevolNG.visible 	= lOcultar
			._txtTotalNG.visible 		= lOcultar
			._txtSubtotalEX.visible 		= lOcultar
			._txtBonifEX.visible 		= lOcultar
			._txtrecodevolEX.visible 	= lOcultar
			._txtTotalEX.visible 		= lOcultar
			._txtCantKilos.visible		= lOcultar
			.lblSubNG.visible 			= lOcultar
			.lblSubEX.visible 			= lOcultar
			.lblBoniNG.visible 			= lOcultar
			.lblBoniEX.visible 			= lOcultar
			.lblDevNG.visible 			= lOcultar
			.lblDevEX.visible 			= lOcultar
			.lblNG.visible 				= lOcultar
			.lblEX.visible 				= lOcultar
			.lblExento.visible 			= lOcultar
			.lblNeto.visible 				= lOcultar
			.lblTotKilos.visible 			= lOcultar
			._txtCantKilos.visible 		= lOcultar
		ENDWITH 
	ENDPROC

	PROCEDURE pidototalesfac
		WITH thisform
			.accion = "T"
			lok = .t.
		
		 	IF NOT this.consultando
		 		RETURN 
		 	ENDIF 
		 	
		 	IF NOT RTRIM(CsrComprobante.clase)$'ABC'
		 		RETURN .t.
		 	ENDIF 
		 	
			SELECT CsrAuxCabefac
			SCATTER NAME OscCabefac
			
			oParametros= CREATEOBJECT("custom")
			oParametros.AddProperty('origen','CPRA')
			oParametros.AddProperty('Comprobante',thisform.proximonro)
			
			DO FORM pidototalfac WITH oParametros,OscCabefac name LobjForm linked
			
			
			IF lobjform.quetecla<>27
				SELECT CsrAuxCabefac
				GATHER NAME OscCabefac
				*vista()
				
		*!*			**&&''
		*!*			STORE 0 TO lnBaseNocatego,lnBasePercep1,lnBasePercep2,lnBaseGra,lnBaseIva,lnBaseInterno
		*!*			
		*!*			lnBaseGra		= OscCabefac.BaseGra1 + OscCabefac.BaseGra2 + OscCabefac.BaseGra3 + OscCabefac.BaseGra4 + OscCabefac.BaseGra5
		*!*			lnBaseIva		= red(OscCabefac.ivari1,lndecimaltot) + red(OscCabefac.ivari2,lndecimaltot) + red(OscCabefac.ivari3,lndecimaltot) + red(OscCabefac.ivari4,lndecimaltot) + red(OscCabefac.ivari5,lndecimaltot) 
		*!*			lnBaseInterno	= red(OscCabefac.BaseInterno,lndecimaltot)
		*!*			lnBaseExe		= red(OscCabefac.BaseExe,lndecimaltot)
		*!*			
		*!*			FOR i=1 TO 5
		*!*			    lcname = "OscCabefac.nomrete"+STR(i,1)
		*!*			    lcimpu = "OscCabefac.retencion"+STR(i,1)
		*!*				lnimporte   = &lcimpu
		*!*			    IF "IBTO1"$&lcname   				
		*!*					lnBasePercep1 = lnBasePercep1 +lnimporte
		*!*				ENDIF
		*!*				 IF "IBTO2"$&lcname   				
		*!*					lnBasePercep1 = lnBasePercep1 +lnimporte
		*!*				ENDIF
		*!*				 IF "NOCATEGORI"$&lcname   				
		*!*					lnBaseNocatego = lnBaseNocatego +lnimporte
		*!*				ENDIF
		*!*			NEXT 	
		
		*!*			
		*!*			lnBasePercepcion = lnBasePercep1 + lnBasePercep2
		*!*			
		*!*			lnBaseSubSiva  = lnBaseGra + lnBaseExe + lnBaseInterno
		*!*			lnBaseSubCiva  = lnBaseGra + lnBaseExe + lnBaseInterno + lnBaseIva 
		*!*			lnTotalFac     = lnBaseGra + lnBaseExe + lnBaseInterno + lnBaseIva + lnBasePercepcion + lnBaseNocatego
		*!*			
		*!*			REPLACE BaseExe WITH lnBaseExe,BaseInterno WITH lnBaseInterno;
		*!*			   ,BaseGra WITH lnBaseGra,BaseIva WITH lnBaseiva,BaseNocatego WITH lnBaseNocatego,Perceibto1 WITH lnBasePercep1,Perceibto2 WITH lnBasePercep2;
		*!*			   ,SubtotSiva WITH lnBaseSubSiva,SubtotCiva WITH lnBaseSubCiva,total WITH lnTotalFac IN CsrAuxCabefac
		*!*			
		*!*			SCATTER NAME OscCabefac
		*!*			
		*!*			WITH thisform.containertotales
		*!*				._txtsubtotal.Value		 = OscCabefac.SubtotSiva
		*!*				._txtbonificacion.Value  = IIF(thisform.incluyeiva,OscCabefac.BaseDescto ,OscCabefac.BaseDesctoSiva)
		*!*				._txtinterno.Value		 = OscCabefac.BaseInterno
		*!*				._txtiva.Value			 = OscCabefac.BaseIva
		*!*				._txtnetoexento.Value	 = OscCabefac.BaseExe
		*!*				._txtnetogravado.Value	 = OscCabefac.BaseGra
		*!*				._txtpercepcion.Value	 = OscCabefac.Perceibto2 + OscCabefac.Perceibto1
		*!*				._txtnocatego.value      = OscCabefac.BaseNocatego
		*!*				._txttotal.Value		 = OscCabefac.total
		*!*				.refresh
		*!*			ENDWITH 
		
			ENDIF
		   
				
			loObjeto = null
			RELEASE lobjform
				
		
			RETURN lok
				
		ENDWITH 	  
	ENDPROC

	PROCEDURE pidovalores		&& llama al form para cargar los valores
		parameters lcaccion
		
		=CrearCursordbf('Csrpago')
		
		local lcdias,i,lndias,lcclasevalor,ldfecha,lnimpcuota,lncuota,lntotcuota,lntotalcomp,lnimporte
		local lccid,lctipocaja,haycambios,lcidcliente,lcorigencta
		LOCAL lcclaseorig,lnimporte,lnidvalororig,lnidplanorig
		STORE 0 TO lnimporte
		
		lcidcliente = Csrauxcabefac.idctacte
		ldfecha     = CsrAuxCabefac.fecha
		
		haycambios = .t.
		
		&&Agregado por marcos. Chk si solicta valores segun el plan de pago.
		lbSolicitaValor = IIF(thisform.containerencabeza._chkpidovalor.Value = 1,.t.,.f.)
			
		if lcaccion='A' or haycambios
			lcdias = CsrPlanpago.dias
			i=1
			lncuota = 0
			do while i <= len(lcdias)
			   lndias = val(subs(lcdias,i,3))
			   if len(trim(subs(lcdias,i,3)))<>0
			      lncuota = lncuota + 1 
			   endif   
			   i=i+4
			enddo
		
			lntotalcomp = thisform.containertotales._txtctacte.Value
			lnimpcuota = iif(lncuota=0,lntotalcomp,round(lntotalcomp/lncuota,2))
			lntotcuota = 0
			
			SELECT Csrvalor
			LOCATE FOR id=Csrplanpago.idvalor
			
			lcclaseorig 	= Csrvalor.clasevalor
			lcclasevalor 	= CsrValor.clasevalor
			lnimporte 		= lntotalcomp
			lnidvalororig 	= CsrValor.id
			lnidplanorig	= CsrPlanPAgo.id
			
			SELECT Csrplancue
			LOCATE FOR id=CsrValor.idctaa
			lctipocaja = iif('C'$lcclasevalor,'CC','CA')   && ctacte, caja
			
			IF 'C'$lcclasevalor AND lbSolicitaValor
				&&Si es una registración con un plan de pago Ctacte.
				&&Mandamos el valor como caja y la diferencia final a Ctacte
				
				lnidvalororig = CsrValor.id
				lnidplanorig = CsrPlanPago.id
				&&cargamos cuenta Efectivo
				lnidefectivo = 0
				lnidotro = 0
				SELECT CsrPlanPago
				SCAN 
					SELECT CsrValor
					LOCATE FOR clasevalor='E'
					lcclasevalor = CsrValor.clasevalor
					lnidotro	 = IIF(('E'$lcclasevalor) or ('C'$lcclasevalor),0,CsrValor.id)
					IF 'E'$lcclasevalor
						lnidefectivo = CsrValor.id
						lnidplanpago = CsrPlanPago.id
						EXIT 
					ENDIF 
				ENDSCAN 
				IF lnidefectivo = 0
					lnidefectivo = lnidotro
					SELECT CsrPlanPago
					LOCATE FOR idvalor = lnidotro
				ENDIF 
				SELECT CsrValor
				LOCATE FOR id = lnidefectivo
			ENDIF 
		
			local lcidcuenta
		
			WITH thisform
				SELECT CsrParaConta
				LOCATE FOR numero = 3
				
				lcidcuenta = CsrValor.idctaa&&IIF(!.cambiarcuenta(),CsrValor.idctaa,.lcidcuentaa)
				lcidcuenta = IIF(lcidcuenta=0,CsrParaConta.idcuenta,lcidcuenta)
		   	ENDWITH 
		   		
		    IF lcidcuenta=0 
		   		Oavisar.usuario('NO SE ENCONTRO UNA CUENTA CONTABLE ASOCIADA AL VALOR ';
		   			+CHR(13)+'CONSULTE ARCHIVOS GENERALES'+CHR(13)+'	ABM VALORES.';
		   			+CHR(13)+CHR(13)+'NO SE ENCONTRO UNA CUENTA CONTABLE PARA PROVEEDORES ';
		   			+CHR(13)+'CONSULTE ARCHIVOS GENERALES'+CHR(13)+'	ABM PARAMETROS CONTABLES.',0)
		   		RETURN .f.
		  	ENDIF 
		   
			i=1
			do while i <= len(lcdias)
			   lndias = val(subs(lcdias,i,3))
			   if len(trim(subs(lcdias,i,3)))=0 
			      i=i+4
			      loop
			   endif
		
			   lccid = i
				
			   Insert into Csrpago (numero,cnombre,fecha,importe,idcuenta,ctactebco,idprovincia,titular,banco;
			              	,localidad,nrocheque,fechavto,entregado,idvalor,idtipobco,tipocaja,idctabco,esclase,recibido;
			              	,idlocalidad,idbanco,idctatitular,idctarecibido,idctaentregado,nroidentificador);
			          Value (Csrvalor.numero,Csrvalor.nombre,ldfecha+lndias,lnimpcuota,lcidcuenta;
			              ,"",0,CsrAuxCabefac.cnombre,"","",0,ldfecha+lndias,CsrAuxCabefac.cnombre,Csrplanpago.idvalor,0;
			              ,lctipocaja,0,lcclasevalor,CsrAuxCabefac.cnombre,0,0,CsrAuxCabefac.idctacte,CsrAuxCabefac.idctacte;
			              ,0,"0")
			          
			   lntotcuota=lntotcuota + lnimpcuota
			   i=i+4            
			enddo
		
			Sele Csrpago
			go top
			if eof()
			   lccid = 1
			   Insert into Csrpago (numero,cnombre,fecha,importe,idcuenta,ctactebco,idprovincia,titular,banco;
			               ,localidad,nrocheque,fechavto,entregado,idvalor,idtipobco,tipocaja,idctabco,esclase,recibido;
			               ,idlocalidad,idbanco,idctatitular,idctarecibido,idctaentregado,nroidentificador);
			          Value (Csrvalor.numero,Csrvalor.nombre,ldfecha+lndias,lntotalcomp,lcidcuenta;
			              ,"",0,"","","",0,ldfecha+lndias,CsrAuxCabefac.cnombre,Csrplanpago.idvalor,0;
			              ,lctipocaja,0,lcclasevalor,CsrAuxCabefac.cnombre,0,0,CsrAuxCabefac.idctacte,CsrAuxCabefac.idctacte;
			              ,0,"")
			else              
			   if lntotcuota<>lntotalcomp
			      go top
			      lnimporte = (lntotalcomp-lntotcuota)
			      lnimporte = iif(importe=0,lntotalcomp,(importe+lnimporte))
			      repl importe with lnimporte
			   endif
			endif
			go top
		endif
		
		store "" to lcid,lcsalidavalida
		public pndatasessionid
		pndatasessionid = thisform.datasessionid
		
		*!*	F	CONTADO PENDIENTE             
		*!*	C	CUENTA CORRIENTE    
		*!*	A	TARJETA DE CREDITO   
		
		if haycambios AND (thisform.tipoform$"F-R" and !lcclasevalor$'F')AND lntotalcomp#0             
		*if haycambios AND ((thisform.tipoform#"N" and !lcclasevalor$'CX') OR (thisform.tipoform$"R" AND !lcclasevalor$'X'))  AND lntotalcomp#0    
		   	SELECT Csrvalor.* FROM Csrvalor WHERE regisa=1 AND !clasevalor$'ACF' INTO CURSOR CsrAuxValor
		    lcfiltro = "AND CsrValor.regisa=1 AND not CsrClaseValor.numero in ('C','A','F') and  Csrvalorctacon.idejercicio="+STR(Goapp.idejercicio)
			
			thisform.grid2.SetFocus()
		   	loObjValor = CREATEOBJECT("Custom")
		   	loObjValor.AddProperty('totalcomp',lntotalcomp)
		   	loObjValor.AddProperty('origencomp',"CPR")
		   	loObjValor.AddProperty('idbcocompcheque',thisform.idbcocompcheque)
		   	loObjValor.AddProperty('lcfiltro',lcfiltro)     
		   	lbverifitope = IIF(lcclaseorig='C',.f.,.t.)
		
			IF lbSolicitaValor 
		   		DO FORM pidopagos WITH lcid,loObjValor,lbverifitope TO thisform.quetecla  
		   		thisform.cargarvalores()
		   		
		   		&&Si es 0, quiere decir que no llego a cargarse el form.
		   		IF thisform.quetecla=0 OR thisform.quetecla=43
		   			replace ALL importe WITH 0 IN CsrPago
		   			thisform.quetecla = 27 
		   			RETURN .t.
		   		ENDIF  
		    ELSE
		    	&&Si es PLAN DE PAGO es CTACTE, se mando anteriormente a EFECTIVO
		    	IF !lcclaseorig$'C'
		    		&&Mandamos el importe total a cuenta corriente. Ya que contado pendiente no entra.
		    	
		    		lcclaseorig = 'C'
		    		SELECT CsrValor
		    		LOCATE FOR clasevalor=lcclaseorig
		    		SELECT CsrPlanPago
		    		LOCATE FOR idvalor = CsrValor.id
		    		lnidplanorig = CsrPlanPago.id
		    		lnidvalororig= CsrPlanPago.idvalor
		    	
		    		replace idplanpago WITH lnidPlanOrig IN CsrAuxCabefac
		    		    	
		    		oavisar.usuario('Al no solicitar valores.'+CHR(13)+;
		    						'Se cambio el PLAN DE PAGO a '+UPPER(CsrPlanPago.nombre))
		    	ENDIF 
		    	replace ALL importe WITH 0 FOR idvalor <> lnidvalororig IN CsrPago
		    ENDIF 	
		    
		   	loObjValor = null
		
		   	IF 'C'$lcclaseorig AND lbSolicitaValor
		
				&&Si es una registración con un plan de pago Ctacte.
				&&Mandamos la diferencia a cuenta corriente
				SELECT CsrPago
				SUM ALL importe FOR idvalor <> lnidvalororig TO lnentregado
				
				&&Marcos 14/11/2014
		   		&&Error de logica. Si restamos el totlcomp ($2000) lo entregado ($100)
		   		&&Al grabar genera un movimiento con importe $1900 y entregado $100 dando saldo $1800
		   		&&De esta manera se comento el recualculo del importe a ctacte.
				&&-----
				&&lnimporte = lnimporte-lnentregado
				IF lnentregado < 0
					oavisar.usuario('No puede entregar mas de lo facturado.')
					RETURN .f.
				ENDIF 
					
				SELECT CsrPlanPago
				LOCATE FOR id = lnidplanorig
				
				IF lnimporte = 0
					RETURN .t.
				ENDIF 
				
				SELECT CsrValor
				LOCATE FOR id = CsrPlanPago.idvalor		
				
				SELECT Csrplancue
				LOCATE FOR id=CsrValor.idctaa
				lcidcuenta = CsrPlanCue.id
				
				lctipocaja = 'CC'
				Insert into Csrpago (numero,cnombre,fecha,importe,idcuenta,ctactebco,idprovincia,titular,banco;
			               ,localidad,nrocheque,fechavto,entregado,idvalor,idtipobco,tipocaja,idctabco,esclase,recibido);
			          Value (Csrvalor.numero,Csrvalor.nombre,ldfecha+lndias,lnimporte,lcidcuenta;
			              ,"",0,"","","",0,ldfecha+lndias,"",Csrplanpago.idvalor,0,lctipocaja,0,lcclasevalor,"")
			              
				
			ENDIF 
			
		ENDIF 
		
		RETURN .t.
		
	ENDPROC

	PROCEDURE pidovendedor
		LOCAL llok
		llok = .f.
		
		IF goapp.codempresa <> 13
			RETURN .t.
		ENDIF 
		
		oavisar.proceso('Cargando Vendedores...')
		DO FORM PidoVendedor NAME loForm LINKED
		IF TYPE('loObPidoVdor')$'O'
			IF loObPidoVdor.idretorno <> 0
				replace idvendedor WITH loObPidoVdor.idretorno IN CsrAuxMaopera
				*replace retiro WITH loObPidoVdor.retiro,autorizo WITH loObPidoVdor.autorizo IN CsrAuxCabefac
				llok = .t.
			ENDIF
		ENDIF 
				
		RETURN llok
	ENDPROC

	PROCEDURE ponerpantallamodoconsulta
		WITH thisform
		thisform.LockScreen=.t.
			.containerencabeza.Enabled=.f.
			.containersistema.Enabled=.f.
			.containertotales.Enabled=.f.
			.grid2.ReadOnly=.t.
			.grid1.ReadOnly=.t.
			.cmdimprimir.Visible=.t.
			.cmdasiento.Visible	= .t.
			.cmdrecuperar.Visible = .f.
			.consultando = .t.
			.grid1.Column8.Visible = .f.
			.grid1.Column9.Visible = .f.
		ENDWITH 
		WITH thisform.contenedorRegistro
			.Enabled = .f.
			.grid1.ReadOnly = .t.
			.grid4.ReadOnly = .t.
			.grid3.ReadOnly = .t.
			.grid1.Column8.Visible = .f.
			.grid1.Column9.Visible = .f.
			.grid1.Column7.Visible = .f.
		ENDWITH 
		IF !thisform.tipoform$'R'
			
		ENDIF 
		thisform.LockScreen=.f.
	ENDPROC

	PROCEDURE ponerpantallamodoedicion
		WITH thisform
		thisform.LockScreen=.t.
			.containerencabeza.Enabled	=.t.
			.containersistema.Enabled	=.t.
			.containertotales.Enabled	=.t.
			.grid2.ReadOnly				=.f.
			.grid1.ReadOnly				=.f.
			.cmdSalvar.Visible 			=.f.
			.cmdrecuperar.Visible		=.f.
			.cmdborrar.Visible 			=.f.
			.cmdImprimir.Visible 		=.f.
			.cmdAsiento.Visible			=.f.
			.consultando 				=.f.
			.grid1.Column8.Visible = .f.
			.grid1.Column9.Visible = .f.
		ENDWITH 
		WITH thisform.contenedorRegistro
			.Enabled = .t.
			.grid1.ReadOnly = .f.
			.grid4.ReadOnly = .f.
			.grid3.ReadOnly = .f.
			.grid1.Column8.Visible = .f.
			.grid1.Column9.Visible = .f.
			.grid1.Column7.Visible = .f.
		ENDWITH 
		IF !thisform.tipoform$'R'
			This.ocultartotalizadores(.t.)
		ENDIF 
		thisform.LockScreen=.f.
	ENDPROC

	PROCEDURE ponerpantallamodoeditarprecio		&& Activamos el formulario para editar cantidades reales , precios, o bonifcaciones. Parametros lnOpcion. Si lnOpcion=1 activa la edicion. lnOpcion=0 (sin parametros) cancela edicion.
		PARAMETERS lnOpcion
		lnOpcion = IIF(PCOUNT()<1,0,lnOpcion)
		
		IF this.consultando
			RETURN
		ENDIF 
		
		thisform.LockScreen = .t.
		thisform.grid2.HighlightBackColor = IIF(lnOpcion=1,RGB(255,252,234),RGB(165,185,201))
		FOR i=1 TO thisform.grid2.ColumnCount
			WITH thisform.grid2.Columns[i]
				.BackColor = IIF(lnOpcion=1,RGB(233,237,233),RGB(222,229,235))
			ENDWITH 
		ENDFOR 
		
		thisform.LockScreen = .f.
		thisform.editarprecio = IIF(lnOpcion=1,.t.,.f.)
	ENDPROC

	PROCEDURE recalcular
		SELECT CsrAuxPlanCue
		GO TOP 
		
		thisform.totalregistracion()
		RETURN thisform.validarimpuestos()
		
	ENDPROC

	PROCEDURE totalcomprobante		&& Totaliza afectado, retenciones y gastos, obtiene total para caja
		PARAMETERS lnopcion
		
		LOCAL lnrecno,lnTotalFac,lnTotalPagar,lnBaseSubtotal,lndecimaluni,lndecimaltot,lntasa,lnCalculo,lninterno,lnpreunita
		LOCAL lnBaseGra,lnBaseExe,i,lnbase,lnUniCiva,lnBaseInterno,lnBaseIva,lnBaseCiva,lnBaseDescuento,lnIvaUni,lnidctavta
		LOCAL lnotrosimportes, lnBasePIVA
		
		STORE 0 TO lnTotalFac,lnTotalPagar,lnBaseGra,lnBaseExe,lnBase,lnUniCiva,lntasa,lnCalculo,lnBasedescuento,lnBaseIva
		STORE 0 TO lninterno,lnpreunita,lnIvaUni,lnBaseDesctoSiva,lnidctavta,lnBaseCiva,lnBaseSubtotal,lnBaseInterno,lnidcuenta,lnotrosimportes
		
		STORE 0 TO lnidprovincia, lnBasePIVA
		
		STORE 0 TO lnTotalSubEX,lnTotalBonifEX,lnTotalRecoEX,lnTotalSubNG,lnTotalBonifNG,lnTotalRecoNG,lnTotalModelo,lnTotalKilos,lnCantKilos
		
		loObjiva       	= null
		loObjPercepcion = null
		loObjInterno	= null
		
		WITH thisform
			IF .consultando
				RETURN .t.
			ENDIF 
			lndecimaluni = .ndecimaluni
			lndecimaltot = .ndecimaltot
		    .agregaobjeto.objimpuestovta(@loObjIva,@loObjpercepcion)
		    .agregaobjeto.objimpuestovta(@loObjInterno)
		ENDWITH
		
		* proceso cuerpo factura
		lnregplancue = RECNO('CsrAuxPlanCue')
		IF lnopcion=1	
			STORE 0 TO lnTotalSubEX,lnTotalBonifEX,lnTotalRecoEX,lnTotalSubNG,lnTotalBonifNG,lnTotalRecoNG
			lnregplancue = 1
			DELETE FROM CsrAuxPlancue WHERE origen IN ("A","Z","F") OR cuenta=0
		ENDIF 
			
		IF lnopcion = 3
			
			WITH thisform.containertotales
				lnTotalSubEX = ._txtsubtotalEx.value
				lnTotalBonifEX  = ._txtbonifEx.value
				lnTotalRecoEX = ._txtrecodevolEx.value
				lnTotalSubNG = ._txtsubtotalNG.value
				lnTotalBonifNG = ._txtbonifNG.value
				lnTotalRecoNG= ._txtrecodevolNG.value
			ENDWITH 
			DELETE FROM CsrAuxPlancue WHERE !(tipoconce IN ("NG","EX") AND  origen='A')
		ENDIF 
		
		SET SAFETY OFF 	
		SELECT CsrAuxPlancue
		PACK 
		SET SAFETY ON 
		
		lnrecno = RECNO('CsrAuxCuerfac')
		
		loObjTotales = CREATEOBJECT("Custom")
		loObjTotales.AddProperty("lnBaseInterno",0)
		loObjTotales.AddProperty("lnBaseCiva",0)
		loObjTotales.AddProperty("lnBaseDescuento",0)
		loObjTotales.AddProperty("lnBaseDesctoSiva",0)
		loObjTotales.AddProperty("lnTotalSubNG",0)
		loObjTotales.AddProperty("lnTotalBonifNG",0)
		loObjTotales.AddProperty("lnTotalRecoNG",0)
		loObjTotales.AddProperty("lnTotalSubEX",0)
		loObjTotales.AddProperty("lnTotalBonifEX",0)
		loObjTotales.AddProperty("lnTotalRecoEX",0)
		loObjTotales.AddProperty("lnCantKilos",0)
		
		*!*	IF lnopcion=2
		*!*		stop()
		*!*	ENDIF 
		
		ThisForm.totalcomproba_basico(lnOpcion,@loObjTotales,@loObjInterno) &&Cargamos NG,IG,II,EX
		
		loObjTotales.AddProperty("lnTotalKilos",0)
		loObjTotales.AddProperty("lnTotalFlete",0)
		
		ThisForm.totalcomproba_fletecpra(lnOpcion,@loObjTotales) &&Cargamos fletes de compra
		
		loObjTotales.AddProperty("lnBaseGra",0)
		loObjTotales.AddProperty("lnBaseIva",0)
		loObjTotales.AddProperty("lnBaseExe",0)
		
		this.totalcomproba_neto(lnOpcion,@loObjTotales)
		
		this.totalcomproba_perceiva(lnOpcion,@loObjTotales,@loObjPercepcion)
		
		this.totalcomproba_perceibto(lnOpcion,@loObjTotales,@loObjPercepcion)
		
		lnBaseGra 		= loObjTotales.lnBaseGra
		lnBaseExe 		= loObjTotales.lnBaseExe
		lnBaseIva 		= loObjTotales.lnBaseIva
		lnBaseInterno 	= loObjTotales.lnBaseInterno
		lnTotalSubNG 	= loObjTotales.lnTotalSubNG
		lnTotalBonifNG 	= loObjTotales.lnTotalBonifNG
		lnTotalRecoNG	= loObjTotales.lnTotalRecoNG
		lnTotalSubEX	= loObjTotales.lnTotalSubEX
		lnTotalBonifEX	= loObjTotales.lnTotalBonifEX
		lnTotalRecoEX	= loObjTotales.lnTotalRecoEX
		lnCantKilos		= loObjTotales.lnCantKilos
		
		GO lnregplancue IN CsrAuxPlanCue
		IF lnopcion=1
			GO TOP IN CsrAuxPlanCue	
		ENDIF 
		
		IF GOapp.empresatipoiva#1
		   lnBaseExe = lnBaseExe + lnBaseGra
		   lnBaseGra = 0
		   lnBaseiva = 0
		ENDIF
		
		lnBaseSubSiva  = lnBaseGra + lnBaseExe + lnBaseInterno
		lnBaseSubCiva  = lnBaseGra + lnBaseExe + lnBaseInterno + lnBaseIva
		
		WITH loObjpercepcion
			lnBaseOtros = IIF(!ALLTRIM(.nombre1)$'IBTO1-IBTO2-PI',.impuesto1,0)
			lnBaseOtros = lnBaseOtros + IIF(!ALLTRIM(.nombre2)$'IBTO1-IBTO2-PI',.impuesto2,0)
			lnBaseOtros = lnBaseOtros + IIF(!ALLTRIM(.nombre3)$'IBTO1-IBTO2-PI',.impuesto3,0)
			lnBaseOtros = lnBaseOtros + IIF(!ALLTRIM(.nombre4)$'IBTO1-IBTO2-PI',.impuesto4,0)
			lnBaseOtros = ROUND(lnBaseOtros + IIF(!ALLTRIM(.nombre5)$'IBTO1-IBTO2-PIVA',.impuesto5,0),lndecimaltot)
		
			lnBasePercepcion = IIF('IBTO'$.nombre1,.impuesto1,0)
			lnBasePercepcion = lnBasePercepcion + IIF('IBTO'$.nombre2,.impuesto2,0)
			lnBasePercepcion = lnBasePercepcion + IIF('IBTO'$.nombre3,.impuesto3,0)
			lnBasePercepcion = lnBasePercepcion + IIF('IBTO'$.nombre4,.impuesto4,0)
			lnBasePercepcion = ROUND(lnBasePercepcion + IIF('IBTO'$.nombre5,.impuesto5,0),lndecimaltot)
		
			lnBasePIVA = IIF(.nombre1='PI',.impuesto1,0)
			lnBasePIVA = lnBasePIVA + IIF(.nombre2='PI',.impuesto2,0)
			lnBasePIVA = lnBasePIVA + IIF(.nombre3='PI',.impuesto3,0)
			lnBasePIVA = lnBasePIVA + IIF(.nombre4='PI',.impuesto4,0)
			lnBasePIVA = ROUND(lnBasePIVA + IIF(.nombre5='PI',.impuesto5,0),lndecimaltot)
		
		ENDWITH 
		
		IF lnBasePercepcion < 0
		   lnBasePercepcion = 0
		ENDIF
		IF lnBasePIVA < 0
		   lnBasePIVA = 0
		ENDIF
		
		lnTotalFac  = lnBaseGra + lnBaseExe + lnBaseIva + lnBasePercepcion + lnBaseOtros + lnBasePIVA + lnBaseInterno&&+  lnotrosimportes
		
		this.grid1_refrescar()
			
		* lnBaseInterno no lo sumo a lnTotalFac porque ya esta en lnBaseretencion
		WITH thisform.containertotales
			._txtiva.Value			 = ROUND(lnBaseiva,lndecimaltot)
			._txtnetoexento.Value	 = ROUND(lnBaseExe,lndecimaltot)
			._txtnetogravado.Value	 = ROUND(IIF(CsrCtacteFlete.importe#0,lnBaseGra-lnTotalKilos,lnBaseGra),lndecimaltot)
			._txttotal.Value		 = lnTotalFac
			.lbl01.caption           = PROPER(loObjpercepcion.nomlargo1)
			._txt01.value			 = ROUND(loObjpercepcion.impuesto1,lndecimaltot)
			.lbl02.caption           = PROPER(loObjpercepcion.nomlargo2)
			._txt02.value			 = ROUND(loObjpercepcion.impuesto2,lndecimaltot)
			.lbl03.caption           = PROPER(loObjpercepcion.nomlargo3)
			._txt03.value			 = ROUND(loObjpercepcion.impuesto3,lndecimaltot)
			.lbl04.caption           = PROPER(loObjpercepcion.nomlargo4)
			._txt04.value			 = ROUND(loObjpercepcion.impuesto4,lndecimaltot)
			.lbl05.caption           = PROPER(loObjpercepcion.nomlargo5)
			._txt05.value			 = ROUND(loObjpercepcion.impuesto5,lndecimaltot)
			
			.lbl06.caption           = IIF(lnBaseInterno#0,PROPER('Impuesto Interno'),'')
			._txt06.value			 = IIF(lnBaseInterno#0,ROUND(lnBaseInterno,lndecimaltot),0)
			.lbl07.caption           = IIF(CsrCtacteFlete.importe#0,PROPER('Flete'),'')
			._txt07.value			 = IIF(CsrCtacteFlete.importe#0,ROUND(lnTotalKilos,lndecimaltot),0)
			.lbl07.visible			 = IIF(CsrCtacteFlete.importe#0,.t.,.f.)
			._txt07.visible			 = IIF(CsrCtacteFlete.importe#0,.t.,.f.)
			
			._txtCantKilos.Value	= lnCantKilos
			._txtaccion.Value		= lnotrosimportes
			._txtctacte.Value		= lntotalfac + lnotrosimportes
			
			IF lnopcion=1
				._txtSubTotalNG.Value	= ROUND(lnTotalSubNG,3)
				._txtbonifNG.value		= ROUND(lnTotalBonifNG,3)
				._txtrecodevolNG.value	= ROUND(lnTotalRecoNG,3)
				._txtTotalNG.Value	= ROUND(lnTotalSubNG - (lnTotalBonifNG + lnTotalRecoNG),lndecimaltot)
				._txtSubTotalEX.Value	= ROUND(lnTotalSubEX,3)
				._txtbonifEX.value		= ROUND(lnTotalBonifEX,3)
				._txtrecodevolEX.value	= ROUND(lnTotalRecoEX,3)
				._txtTotalEX.Value	= ROUND(lnTotalSubEX - (lnTotalBonifEX + lnTotalRecoEX),lndecimaltot)
			ENDIF 
			.refresh
		ENDWITH 
		
		REPLACE total WITH lnTotalFac IN CsrAuxCabefac
		loObjiva       = null
		loObjpercepcion = null
		
	ENDPROC

	PROCEDURE totalcomproba_basico
		PARAMETERS lnOpcion,loObjTotales,loObjInterno
		
		lndecimaluni = this.ndecimaluni
		lndecimaltot = this.ndecimaltot
		
		STORE 0 TO lnCantKilos,lnBaseInterno,lnBaseCIVa,lnBaseDesctoSiva,lnBaseDescuento
		STORE 0 TO lnTotalSubNG ,lnTotalBonifNG ,lnTotalRecoNG ,lnTotalSubEX ,lnTotalBonifEX ,lnTotalRecoEX 
		
		lnrecno = RECNO('CsrAuxCuerfac')
		
		SELECT CsrAuxCuerfac
		GO Top
		SCAN FOR !EOF() 
			 STORE 0 TO lnTasa,lnCuenta
			 IF CsrAuxCuerfac.idarticulo=0
			 	LOOP 
			 ENDIF 
		
			 lnCantKilos = lnCantKilos + CsrAuxCuerfac.CantKilos
			 lnCant      = CsrAuxCuerfac.cantidad
		     lnDesctoCiva = CsrAuxCuerfac.desctoCiva
		     lnDesctoSiva = CsrAuxCuerfac.desctoSiva     
		     lninterno   = CsrAuxCuerfac.internofin
		     lnpreunita  = CsrAuxCuerfac.preunita
		     lnUniSiva   = CsrAuxCuerfac.UniSiva
		     lnUniCiva   = CsrAuxCuerfac.UniCiva
			 lnuniventa  = CsrAuxCuerfac.univenta
		     lnunibulto  = IIF(CsrAuxCuerfac.unibulto=0,1,CsrAuxCuerfac.unibulto)
		 	 lnunibulto  = IIF(lnuniventa=1,1,lnunibulto)
			 lntasa      = CsrAuxCuerfac.tasaiva	
			 lnIvaUni    = CsrAuxCuerfac.Ivauni
		     lntotalLine = CsrAuxCuerfac.total
		     thisform.cargarctaconproducto(CsrauxCuerfac.idarticulo)
			 lnidctavta  = CsrAuxCuerfac.idctavta
			 lnidctacpra  = CsrAuxCuerfac.idctacpra
			 lnpesable = CsrauxCuerfac.pesable
			 	      	            
		     lnAbase   = red(lnUniSiva,lndecimaltot) 
		     lnCalculo = 0
		     IF lntasa#0
		        lnCalculo = Red(lnIvaUni,lndecimaltot)        
		     ENDIF    
		     
		     lnBaseInterno    = lnBaseInterno    + Red(lninterno,lndecimaltot)     
		     lnBaseCiva       = lnBaseCiva       + Red(lnUniCiva,lndecimaltot)     
		     lnBaseDescuento  = lnBaseDescuento  + Red(lndesctoCiva,lndecimaltot)
		     lnBaseDesctoSiva = lnBaseDesctoSiva + Red(lndesctoSiva,lndecimaltot)
		
			SELECT CsrPlanCue
			LOCATE FOR id = lnidctacpra
			*Si no tiene cuenta asociada al producto, busco la asociada la paraconta
			IF id#lnIdCtaCpra
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				Select Csrplancue.*,isnull(Csrclasecta.cnumero,' ') as clasecta
				from plancue as Csrplancue
				left join clasecta as Csrclasecta on Csrplancue.idclase = Csrclasecta.id
				where (Csrplancue.id = <<lnidctacpra>> or CsrPlanCue.id > 0) 
				and CsrPlanCue.idejercicio = <<goapp.idejercicio>> and imputable=1
				ENDTEXT 
				
				IF !thisform.obtenerdatos('CsrPlancue',lccmd)
					thisform.Release 
				ENDIF    
				SELECT CsrPlanCue
				LOCATE FOR id =  lnidctacpra
			ENDIF 	
			lnidCtaCpra = CsrPlanCue.id 
			*Si no tiene cuenta asociada al producto, busco la asociada la paraconta
			IF lnidctacpra=0
				lncuenta = IIF(lntasa#0,19,24)
				SELECT CsrParaConta
				LOCATE FOR numero = lncuenta
				lnidctacpra = CsrParaConta.idcuenta
				
				SELECT CsrPlanCue
				LOCATE FOR id = lnidctacpra
				lnidctacpra = CsrPlanCue.id
			ENDIF 
			*Sino existe ninguna, informar que debe cargar en el paraconta
			IF lnidctacpra=0
				Oavisar.usuario('NO SE ENCONTRO UNA CUENTA CONTABLE PARA COMPRA DE MERCADERIA GRAVADA / EXENTA ';
		   			+CHR(13)+'CONSULTE ARCHIVOS GENERALES'+CHR(13)+'	ABM PARAMETROS CONTABLES.',0)
		   		RETURN .f.
			ENDIF 
			IF lnidctacpra#0 AND lnopcion=1
			
				lnBonif = CsrAuxCuerfac.TotalBonif
				
				SELECT CsrAuxPlancue    && por si ya lei
				LOCATE FOR idcuenta=lnidctacpra AND tasa=lntasa AND tipoconce<>'II'
				IF idcuenta#lnidctacpra OR tasa#lntasa AND tipoconce<>'II'
					APPEND BLANK
					lctipoconce = 'EX'
					IF lntasa#0
						lctipoconce = 'NG'
					ENDIF 
							
					thisform.totPlancue = thisform.totPlancue + 1
					REPLACE id WITH 0,idcuenta WITH lnidctacpra,cuenta WITH Csrplancue.cuenta,nombre WITH Csrplancue.nombre,detalle WITH "",tasa WITH lntasa;
							,idprovincia WITH 0,nomprov WITH "",tipoconce WITH lctipoconce,origen WITH "A" IN CsrAuxPlancue
					SELECT CsrClaseCta
					LOCATE FOR cnumero=LCtipoconce
					replace idclase WITH CsrClaseCta.id IN CsrauxPlanCue
					thisform.grid1.column3.combo1.Value = CsrClaseCta.id
		  			thisform.grid1.column3.combo1.DisplayValue = CsrClaseCta.cnombre
				ENDIF
				IF !thisform.esbonifica
					IF thisform.modbonifpie
						IF CsrAuxPlanCue.tipoconce='NG'
							lnTotal			= lnAbase
							lnRecoDevol		= lnTotal * CsrAuxCabefac.RecoDevol / 100
							lnTotalSubNG	= lnTotalSubNG + lnAbase
							lnTotalBonifNG	= lnTotalBonifNG + lnBonif
							lnTotalRecoNG	= lnTotalRecoNG + lnRecoDevol
							lnAbase			= lnTotal - ( lnBonif + lnRecoDevol)
							lnCalculo 		= Red(lnAbase * (1 + lnTasa/100) - lnABase,lndecimaltot) 
						ELSE
							lnTotal			= lnAbase
							lnRecoDevol		= lnTotal * CsrAuxCabefac.RecoDevol / 100
							lnTotalSubEX	= lnTotalSubEX + lnAbase
							lnTotalBonifEX	= lnTotalBonifEX + lnBonif
							lnTotalRecoEX	= lnTotalRecoEX + lnRecoDevol
							lnAbase			= lnTotal - ( lnBonif + lnRecoDevol)
							lnCalculo 		= Red(lnAbase * (1 + lnTasa/100) - lnABase,lndecimaltot) 
						ENDIF				 			
					ENDIF 
				ENDIF 
				REPLACE importe WITH importe + lnAbase,impuesto WITH impuesto + lnCalculo IN CsrAuxPlancue
			ENDIF 
			&&IMPUESTOS INTERNOS USAN LA MISMA CUENTA CONTABLE DEL NG/EX QUE EL PRODUCTO.
			IF lnidctacpra#0 AND lnBaseInterno#0
				*thisform.unitariofac.Acumulaimpuesto(@loObjInterno,"ITENO",0,0,lnBaseinterno,LEFT(Csrplancue.nombre,11),0)
				IF (lnopcion=1 OR lnopcion=3)
					SELECT CsrAuxPlancue
					LOCATE FOR idcuenta=lnidctacpra AND tipoconce='II'
					IF !(idcuenta=lnidctacpra AND tipoconce='II')
						APPEND BLANK
						thisform.totPlancue = thisform.totPlancue + 1
						REPLACE id WITH 0,idcuenta WITH lnidctacpra,cuenta WITH Csrplancue.cuenta,nombre WITH Csrplancue.nombre,detalle WITH "",tasa WITH 0;
								,idprovincia WITH 0,nomprov WITH "",tipoconce WITH "II",origen WITH "A",nombreobjeto WITH "ITENO" IN CsrAuxPlancue
					ENDIF
					REPLACE importe WITH importe + lnBaseInterno IN CsrAuxPlancue 
					
					
				ELSE 
					&&si la opcion = 2, entonces se esta cargando desde la modificacion de asientos. Puede no haber Internos.
					lnBaseInterno = 0
					SELECT CsrAuxplancue
					GO TOP 
					SCAN FOR !EOF()
					  	IF origen='A' OR origen='F' OR origen='' OR origen='Z'
							IF tipoconce$"II"
						    	lnBaseInterno    = lnBaseInterno + CsrAuxPlanCue.importe
							ENDIF 
						ENDIF
					ENDSCAN 
				ENDIF 
			ENDIF 
			
			SELECT CsrAuxCuerfac		 
		ENDSCAN
		
		GO lnrecno IN CsrAuxCuerfac
		
		WITH loObjTotales
			.lnBaseInterno    = lnBaseInterno    
		    .lnBaseCiva       = lnBaseCiva       
		    .lnBaseDescuento  = lnBaseDescuento  
		    .lnBaseDesctoSiva = lnBaseDesctoSiva 
		    .lnTotalSubNG	= lnTotalSubNG 
			.lnTotalBonifNG	= lnTotalBonifNG 
			.lnTotalRecoNG	= lnTotalRecoNG 
			.lnTotalSubEX	= lnTotalSubEX 
			.lnTotalBonifEX	= lnTotalBonifEX 
			.lnTotalRecoEX	= lnTotalRecoEX 
			.lnCantKilos = lnCantKilos
		ENDWITH 
	ENDPROC

	PROCEDURE totalcomproba_fletecpra
		PARAMETERS lnOpcion,loObjTotales
		
		lndecimaluni = this.ndecimaluni
		lndecimaltot = this.ndecimaltot
		
		IF !(lnopcion=1  OR lnopcion=3)
			RETURN 
		ENDIF 
		
		STORE 0 TO lnTotalKilos,lnTotalFlete
		lnCantKilos = loObjTotales.lnCantKilos
		
		IF lnCantKilos#0 AND CsrCtacteFlete.importe#0
			&&Cargamos el Flete de compra
			SELECT CsrParaConta
			LOCATE FOR numero=32 &&Cuenta de flete de compra
			IF FOUND() AND numero=32
				SELECT CsrPlancue    && por si ya lei
				LOCATE FOR id=CsrParaconta.idcuenta
				lnIdCuenta = CsrParaconta.idcuenta
				IF id#lnIdCuenta
					TEXT TO lcCmd TEXTMERGE NOSHOW 
					Select Csrplancue.*,isnull(Csrclasecta.cnumero,' ') as clasecta
					from plancue as Csrplancue
					left join clasecta as Csrclasecta on Csrplancue.idclase = Csrclasecta.id
					where (Csrplancue.id = <<lnIdCuenta>> or CsrPlanCue.id > 0) 
					and CsrPlanCue.idejercicio = <<goapp.idejercicio>> and imputable=1
					ENDTEXT 
					IF !thisform.obtenerdatos('CsrPlancue',lccmd)
					   thisform.Release 
					ENDIF  
					SELECT CsrPlanCue
					LOCATE FOR id = lnidCuenta
					lnidCuenta = CsrPlanCue.id
				ENDIF 
				lnTasa = CsrParaConfig.tasa1
				IF lnidCuenta#0			
					SELECT CsrAuxPlanCue
					LOCATE FOR idcuenta=lnidCuenta
					IF idcuenta#lnIdCuenta
						APPEND BLANK IN CsrAuxPlanCue
						lctipoconce = CsrPlanCue.clasecta
						thisform.totPlancue = thisform.totPlancue + 1
						REPLACE id WITH 0,idcuenta WITH CsrParaconta.idcuenta,cuenta WITH Csrplancue.cuenta;
						,nombre WITH Csrplancue.nombre,detalle WITH "CONCEPTO FLETE",tasa WITH lntasa,idprovincia WITH 0;
						,nomprov WITH CsrProvincia.nombre,tipoconce WITH lctipoconce,origen WITH "F";
						,nombreobjeto WITH lctipoconce IN CsrAuxPlancue
					ENDIF 
					
					SELECT CsrClaseCta
					LOCATE FOR cnumero$ALLTRIM(CsrAuxPlanCue.tipoconce)
					replace idclase WITH CsrClaseCta.id,tipoconce WITH CsrClaseCta.cnumero IN CsrauxPlanCue
					thisform.grid1.column3.combo1.Value = CsrAuxPlanCue.idclase &&CsrClaseCta.id
			  		thisform.grid1.column3.combo1.DisplayValue = CsrClaseCta.cnombre
					thisform.grid1.column3.combo1.LostFocus()
						
					lnTotalKilos = lnCantKilos*CsrCtacteFlete.importe
					lnTotalFlete = lnTotalKilos*lntasa/100
					REPLACE impuesto WITH lnTotalFlete, importe WITH lnTotalKilos IN CsrAuxPlanCue
					lnTotalKilos = CsrAuxPlanCue.importe
					lnTotalFlete = CsrAuxPlanCue.impuesto
				ENDIF 
			ENDIF 
		ENDIF 
		
		loObjTotales.lnTotalKilos = lnTotalKilos
		loObjTotales.lnTotalFlete = lnTotalFlete
	ENDPROC

	PROCEDURE totalcomproba_neto
		PARAMETERS lnOpcion,loObjTotales
		
		STORE 0 TO lnBaseGra,lnBaseIva,lnBaseExe
		
		lndecimaluni = This.ndecimaluni
		lndecimaltot = This.ndecimaltot
		
		SELECT CsrAuxplancue
		GO TOP 
		SCAN FOR !EOF()
		  	IF origen='A' OR origen='F' OR origen='' OR origen='Z'
				IF tipoconce$"NG-EX"
			    	IF CsrAuxplancue.tasa#0 AND Csrauxplancue.impuesto#0
				    	thisform.unitariofac.acumulaimpuesto(@loObjIva,TRANSFORM(Csrauxplancue.idcuenta,"9999999999")+TRANSFORM(Csrauxplancue.tasa,"99.99");
				    	,Csrauxplancue.importe,Csrauxplancue.tasa,Csrauxplancue.impuesto,"IVA "+TRANSFORM(Csrauxplancue.tasa,"99.99"),Csrauxplancue.idcuenta)
					ELSE
				   		lnBaseExe = lnBaseExe + CsrAuxplancue.importe
					ENDIF 
				ELSE
					thisform.unitariofac.Acumulaimpuesto(@loObjpercepcion,Csrauxplancue.nombreobjeto,CsrAuxPlanCue.importe;
		     		,CsrAuxPlanCue.tasa,CsrAuxPlancue.impuesto,LEFT(Csrauxplancue.nombre,11),Csrauxplancue.idcuenta) 
				ENDIF 
			ENDIF
		ENDSCAN 
		lnBaseGra = loObjIva.base1     + loObjIva.base2     + loObjIva.base3     + loObjIva.base4     + loObjIva.base5
		lnBaseIva = loObjIva.impuesto1 + loObjIva.impuesto2 + loObjIva.impuesto3 + loObjIva.impuesto4 + loObjIva.impuesto5
		
		IF thisform.tipoform#'R' AND (lnopcion=1  OR lnopcion = 3)
			*stop()
			*thisform.agregaobjeto.objctacontable('CsrAuxPlanCue',CsrAuxCabefac.idctacte,'thisform.grid1.column3.combo1',0,@lnTotalModelo,.t.)
			thisform.omodeloctacon1.regish = 1
			thisform.omodeloctacon1.nidctacte = CsrauxCabefac.idctacte
			thisform.omodeloctacon1.cgrillacombo = 'thisform.grid1.column3.combo1'
			thisform.omodeloctacon1.cargarmodelo()
		ENDIF 
		
		&&ReCalculamos. Por si se agregaron nuevos Ajustes contables. Automaticos
		SELECT CsrAuxplancue
		GO TOP 
		SCAN FOR !EOF() AND lnopcion<>2
		  	IF origen='Z'
				IF !(tipoconce$"NG-EX")
			 	 	lnimpuesto 	= CsrAuxPlanCue.impuesto
			 		lntasa		= CsrAuxPlanCue.tasa
			 		lnimporte	= CsrAuxPlanCue.importe
			 		IF tipoconce$"ZZ"
			 			lnimpuesto  = 0
			 			lnimporte 	= CsrAuxPlanCue.importe
			 			lntasa		= 0
			     	ENDIF  
			    	thisform.unitariofac.Acumulaimpuesto(@loObjpercepcion,Csrauxplancue.nombreobjeto,lnimporte;
		     		,lntasa,lnimpuesto,LEFT(Csrauxplancue.nombre,11),Csrauxplancue.idcuenta) 
		     	ELSE 
		     		lnBaseExe = lnBaseExe + IIF(tipoconce$'EX',CsrAuxPlanCue.importe,0)
		     		lnBaseGra = lnBaseGra + IIF(tipoconce$'NG',CsrAuxPlanCue.importe,0)
		     		lnBaseIva = lnBaseIVA + IIF(tipoconce$'NG',CsrAuxPlanCue.impuesto,0)
		     	ENDIF 
		    ENDIF 			     
		ENDSCAN
		
		
		loObjTotales.lnBaseGra = lnBaseGra
		loObjTotales.lnBaseIva = lnBaseIva
		loObjTotales.lnBaseExe = lnBaseExe
	ENDPROC

	PROCEDURE totalcomproba_perceibto
		PARAMETERS lnOpcion,loObjTotales,loObjPercepcion
		
		IF !(lnopcion=1 OR lnopcion=3)
			RETURN 
		ENDIF 
		IF !this.totalizaperceibto
			RETURN 
		ENDIF 
		*stop()
		lndecimaluni = This.ndecimaluni
		lndecimaltot = This.ndecimaltot
		
		lnBaseIBTO = loObjTotales.lnBaseGra&&loObjTotales.lnBaseExe
		
		SELECT CsrProvEmpresa &&Cursor con las provincias que se calculan percepciones de ibto
		GO TOP 
		SCAN
		   	SELECT Csrparaconta
			LOCATE FOR numero=8
			SELECT Csrplancue
			LOCATE FOR id=Csrparaconta.idcuenta
			lnidctaperce = CsrPlanCue.id
			
			*Buscamos la cuenta asociada a la percepcion por la provincia
			SELECT CsrProvCtaCon
			LOCATE FOR idprovincia = CsrProvEmpresa.id
			
			SELECT CsrPlanCue
			LOCATE FOR id = CsrProvCtaCon.idctaperce
			IF id = CsrProvCtaCon.idctaperce AND CsrPlanCue.id#0
				lnidctaperce = CsrPlanCue.id
			ENDIF 
			
			STORE 1 TO lnTasaConv,lnDividendo
			
			IF CsrProvEmpresa.idcuenta#0 AND CsrProvEmpresa.convenio#0
				lnTasaConv	= CsrProvEmpresa.convenio
				lndividendo = 100
				SELECT CsrPlanCue
				LOCATE FOR id = CsrProvEmpresa.idcuenta
				IF id = CsrProvEmpresa.idcuenta AND CsrPlanCue.id#0
					lnIdCtaPerce= CsrProvEmpresa.idcuenta&&Cuenta contable del convenop
				ENDIF 
			ENDIF 
			
			SELECT CsrPlanCue
			LOCATE FOR id=lnIdCtaPerce
		   	IF id#lnidctaperce
				TEXT TO lcCmd TEXTMERGE NOSHOW 
				Select Csrplancue.*,isnull(Csrclasecta.cnumero,' ') as clasecta
				from plancue as Csrplancue
				left join clasecta as Csrclasecta on Csrplancue.idclase = Csrclasecta.id
				where (Csrplancue.id = <<lnidctaperce>> or CsrPlanCue.id >0) 
				and CsrPlanCue.idejercicio = <<goapp.idejercicio>> and imputable=1
				ENDTEXT 
		
				IF !thisform.obtenerdatos('CsrPlancue',lccmd)
			   		thisform.Release 
				ENDIF
				SELECT CsrPlanCue
				LOCATE FOR id =  lnidctaperce  
				lnIdCtaPerce = CsrPlanCue.id 
			ENDIF 
			
			IF lnIdCtaPerce=0
				LOOP 
			ENDIF 
			
			lnTasa = CsrProvEmpresa.porperce
			lnPerceibto = lnBaseIBTO*lntasa/100
			lnPerceibto = red(lnPerceIBTO * lntasaconv / lndividendo ,lndecimaltot)&&Convenio.Sino hay. lnPerceIBTO * 1 / 1
			
			IF lntasa=<0
				lnPerceibto = 0
				lnBaseIBTO = 0
			ENDIF 
			
			lnidProvincia 	= CsrProvEmpresa.id
			lcnombre 		= CsrProvEmpresa.nombre
		
		    thisform.unitariofac.Acumulaimpuesto(@loObjpercepcion,"IBTO2",lnBaseIBTO,lnTasa,lnPerceibto,LEFT(Csrplancue.nombre,11),0)
		
			SELECT CsrAuxPlancue
			LOCATE FOR idcuenta=lnidctaperce AND tasa=lntasa AND idprovincia=lnidprovincia
			IF idcuenta#lnidctaperce OR tasa#lntasa OR idprovincia#lnidprovincia
				APPEND BLANK
				thisform.totPlancue = thisform.totPlancue + 1
				REPLACE id WITH 0,idcuenta WITH lnidctaperce,cuenta WITH Csrplancue.cuenta;
				,nombre WITH ALLTRIM(Csrplancue.nombre)+' '+lcnombre;
				,detalle WITH "",tasa WITH lntasa,idprovincia WITH lnidprovincia,nomprov WITH lcnombre;
				,tipoconce WITH 'PB',origen WITH "A",nombreobjeto WITH "IBTO2" IN CsrAuxPlancue
			ENDIF 
			
			SELECT CsrClaseCta
			LOCATE FOR cnumero=csrauxplancue.tipoconce
			replace idclase WITH CsrClaseCta.id IN CsrauxPlanCue
			thisform.grid1.column3.combo1.Value = CsrClaseCta.id
			thisform.grid1.column3.combo1.DisplayValue = CsrClaseCta.cnombre
		
			REPLACE importe WITH importe + lnBaseIBTO,impuesto WITH impuesto + lnPerceibto IN CsrAuxPlancue
		ENDSCAN 
		
	ENDPROC

	PROCEDURE totalcomproba_perceiva
		PARAMETERS lnOpcion,loObjTotales,loObjPercepcion
		
		STORE 0 TO lnPerceibto,lnIdCtaPerce
		
		lndecimaluni = This.ndecimaluni
		lndecimaltot = This.ndecimaltot
		
		IF !(lnopcion = 1 OR lnopcion=3)
			RETURN 
		ENDIF 
		IF !this.totalizaperceiva
			RETURN 
		ENDIF 
		
		lnBaseIBTO = loObjTotales.lnBaseGra+loObjTotales.lnBaseExe
		
		lntasaib   = CsrCateCtacte.porperce
		IF lntasaib<=0
		   lntasaib = Csrprovincia.alicuota2
		ENDIF 
		
		lnidprovincia = CsrAuxCabefac.idprovincia
		SELECT CsrProvincia
		LOCATE FOR id = lnidprovincia
		
		SELECT CsrParaConta
		LOCATE FOR numero = 6
		IF numero=6
			SELECT CsrPlanCue
			LOCATE FOR id = CsrParaConta.idcuenta
			IF id = CsrParaConta.idcuenta
				lnidctaperce = CsrPlanCue.id		
			ENDIF 
		ENDIF 	
		IF id#lnidctaperce
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			Select Csrplancue.*,isnull(Csrclasecta.cnumero,' ') as clasecta
			from plancue as Csrplancue
			left join clasecta as Csrclasecta on Csrplancue.idclase = Csrclasecta.id
			where (Csrplancue.id = <<lnidctaperce>> or CsrPlanCue.id >0) 
			and CsrPlanCue.idejercicio = <<goapp.idejercicio>> and imputable=1
			ENDTEXT 
		
			IF !thisform.obtenerdatos('CsrPlancue',lccmd)
			   thisform.Release 
			ENDIF
			SELECT CsrPlanCue
			LOCATE FOR id =  lnidctaperce  
			lnIdCtaPerce = CsrPlanCue.id 
		ENDIF 
		
		IF lnIdCtaPerce=0
			RETURN 
		ENDIF 
		
		lnTasaIVA	= 3
		lnPerceibto = lnBaseIBTO*lnTasaIVA/100
		thisform.unitariofac.Acumulaimpuesto(@loObjpercepcion,"PI",lnBaseIBTO,lnTasaIVA,lnPerceibto,LEFT(Csrplancue.nombre,11),0)
		
		SELECT CsrAuxPlancue
		LOCATE FOR idcuenta=lnidctaperce AND tasa=lnTasaIVA
		IF idcuenta#lnidctaperce OR tasa#lnTasaIVA
			APPEND BLANK
			thisform.totPlancue = thisform.totPlancue + 1
			REPLACE id WITH 0,idcuenta WITH lnidctaperce,cuenta WITH Csrplancue.cuenta,nombre WITH Csrplancue.nombre;
			,detalle WITH "",tasa WITH lnTasaIVA,idprovincia WITH lnidprovincia,nomprov WITH CsrProvincia.nombre;
			,tipoconce WITH 'PI',origen WITH "A",nombreobjeto WITH "PI" IN CsrAuxPlancue
		ENDIF 
		
		SELECT CsrClaseCta
		LOCATE FOR cnumero=csrauxplancue.tipoconce
		replace idclase WITH CsrClaseCta.id IN CsrauxPlanCue
		thisform.grid1.column3.combo1.Value = CsrClaseCta.id
		thisform.grid1.column3.combo1.DisplayValue = CsrClaseCta.cnombre
			
		lnPercepcion = IIF(loObjpercepcion.nombre1='PI',loObjpercepcion.impuesto1,0)
		lnPercepcion = lnPerceibto + IIF(loObjpercepcion.nombre2='PI',loObjpercepcion.impuesto2,0)
		lnPercepcion = lnPerceibto + IIF(loObjpercepcion.nombre3='PI',loObjpercepcion.impuesto3,0)
		lnPercepcion = lnPerceibto + IIF(loObjpercepcion.nombre4='PI',loObjpercepcion.impuesto4,0)
		lnPercepcion = lnPerceibto + IIF(loObjpercepcion.nombre5='PI',loObjpercepcion.impuesto5,0)
		
		lnPercepcion = ROUND(lnPercepcion,lndecimaltot)
		REPLACE importe WITH importe + lnBaseIBTO,impuesto WITH impuesto + lnPercepcion IN CsrAuxPlancue
		
		
	ENDPROC

	PROCEDURE totalregistracion
		LOCAL lnBaseiva, LnBaseExe, lnBaseGra, lnTotalFac, lnTotalInterno, lntotalFac, lntotalFac, lntotalPerGan
		LOCAL lntotalPerIVA, lnTotalPerRN, lntotalPerBA 
		LOCAL lnEntregados
		
		STORE 0 TO lnBaseiva, nBaseExe, lnBaseGra, lnTotalFac, lnTotalInterno, lntotalFac, lntotalFac, lntotalPerGan
		STORE 0 TO lntotalPerIVA, lnTotalPerRN, lntotalPerBA ,lnEntregados
		
		WITH thisform
			lndecimaluni = .ndecimaluni
			lndecimaltot = .ndecimaltot
		ENDWITH 
		
		*!*	*Provincia BsAs
		*!*	SELECT CsrParavario
		*!*	LOCATE FOR nombre="CATEIBBA"
		*!*	SELECT CsrProvincia
		*!*	LOCATE FOR id=CsrParaVario.idorigen
		*!*	lnidprovBA = CsrProvincia.id
		*!*	*Provincia RioNegro
		*!*	SELECT CsrParavario
		*!*	LOCATE FOR nombre="CATEIBRN"
		*!*	SELECT CsrProvincia
		*!*	LOCATE FOR id=CsrParaVario.idorigen
		*!*	lnidprovRN = CsrProvincia.id
		
		
		SELECT CsrAuxPlanCue
		
		lnpos = RECNO()
		&&cargamos NGravado
		SUM ALL importe FOR tipoconce='NG' TO lnBaseGra
		*SUM ALL tasa FOR tipoconce='IG' TO lnBaseIva
		*LOCATE FOR numero = 13
		*lnBaseIva = (lnBaseGra*lnBaseIva)/100
		
		&&cargamos internos
		SUM ALL importe FOR tipoconce='II' TO lnTotalInterno
		&&Cargamos iva modificable	
		SUM ALL importe FOR tipoconce='IG' TO lnBaseIva
		&&Cargamos otro iva
		SUM ALL importe FOR tipoconce='OI' TO lnBaseOtroIva
		&&Cargamos Perc IVA
		SUM ALL importe FOR tipoconce='PI' TO lnTotalPerIVA 
		&&Cargamos Perc Ganancia
		SUM ALL importe FOR tipoconce='PG' TO lnTotalPerGan
		*!*	&&Cargamos Perc. IB RN
		*!*	SUM ALL importe FOR tipoconce='PB' AND idprovincia = lnidprovRN TO lnTotalPerRN
		*!*	&&Cargamos Perc. IB BA
		*!*	SUM ALL importe FOR tipoconce='PB' AND idprovincia = lnidprovBA TO lnTotalPerBA 
		&&Cargamos Exento
		SUM ALL importe FOR tipoconce='EX' TO lnBaseExe
		&&Cargamos total de perc ibto general
		SUM ALL importe FOR tipoconce='PB'  TO lnTotalPerGral
		
		SUM ALL importe FOR !tipoconce$('NG-II-IG-PI-PG-PB-EX-OI') TO lnTotalOtros
		
		IF lnBaseIva#0 AND lnBaseGra=0
			oavisar.usuario('No se debe cargar IVA sin GRAVADO')
			RETURN .f.
		ENDIF 
		
		&&Cargamos los totales de los valores ingresados
		IF USED('CsrPago')
			SELECT CsrPAgo
			SCAN 
				IF importe = 0
					LOOP 
				ENDIF 
				SELECT CsrValor
				LOCATE FOR id = CsrPago.idvalor
				IF 'C'$CsrValor.clasevalor
					LOOP 
				ENDIF 
				SELECT CsrPAgo
				lnEntregados  = lnEntregados  + CsrPago.importe
			ENDSCAN 
		ENDIF 
		
		SELECT CsrAuxPlanCue
		GO lnpos
		
			
		lntotalFac = lnBaseiva + lnBaseExe + lnBaseGra + lnTotalInterno + lnBaseOtroIva + lnTotalOtros
		lntotalFac = lntotalFac + lntotalPerGan + lntotalPerIVA + lnTotalPerRN	+ lntotalPerBA  + lnTotalPerGral
		
		WITH thisform.containertotales
			._txtiva.Value			 = ROUND(lnBaseiva,lndecimaltot)
			._txtnetoexento.Value	 = ROUND(lnBaseExe,lndecimaltot)
			._txtnetogravado.Value	 = ROUND(lnBaseGra,lndecimaltot)
			._txttotal.Value		 = ROUND(lnTotalFac,lndecimaltot)
			._txt01.value			 = ROUND(lnTotalInterno,lndecimaltot)
			._txt02.value			 = ROUND(lntotalPerGan,lndecimaltot)
			._txt03.value			 = ROUND(lntotalPerIVA,lndecimaltot)
		*!*		._txt04.value			 = ROUND(lnTotalPerRN,lndecimaltot)
		*!*		._txt05.value			 = ROUND(lntotalPerBA,lndecimaltot)
			._txt04.value			 = ROUND(lnTotalPerGral,lndecimaltot)
			._txt06.value			 = ROUND(lnBaseOtroIva+lnTotalOtros,lndecimaltot)
			._txtaccion.Value		 = ROUND(lnEntregados,lndecimaltot)
			._txtctacte.Value		 = ROUND(lntotalfac - lnEntregados,lndecimaltot)
			.refresh
		ENDWITH 
		
		REPLACE total WITH lnTotalFac IN CsrAuxCabefac
	ENDPROC

	PROCEDURE traerdatosextra
		PARAMETERS lnidproducto
		
		LOCAL lok,lcCmd
		WITH thisform
			.containervariedad.grid3.RecordSource = ""
		
			TEXT TO lcCmd TEXTMERGE NOSHOW 
			SELECT id, idarticulo, numero, subnumero,(convert(char(3),subnumero)+' '+ nombre) as nombre, nofactura,idvariedad,estado
			,000000.00 as cantidad,000000.000 as kilos,000000.000 as volumen, <<RECNO('CsrAuxCuerFac')>> as pos
			,CAST(0 AS numeric(12,3)) as cantreal 
			FROM subProducto as Csrsubproducto
			where Csrsubproducto.idarticulo = <<lnidproducto>> AND nofactura=0 and estado = 0
			ORDER BY subnumero
			ENDTEXT 
		
			IF !.obtenerdatos('Csrsubproducto',lccmd)
			   .Release 
			ENDIF    
		
			SELECT CsrSubproducto
			GO top
			lnpos=RECNO('CsrAuxCuerfac')
			SCAN FOR !EOF()
				SELECT CsrAuxCuerVari
				LOCATE FOR idsubarti = CsrSubproducto.id AND idarticulo = lnidproducto AND pos = lnpos
				IF !EOF() AND idsubarti = CsrSubproducto.id AND idarticulo = lnidproducto AND pos = lnpos
				   REPLACE cantidad WITH CsrAuxCuervari.cantidad,cantreal WITH CsrAuxCuerVari.cantreal IN CsrSubproducto
				ENDIF 					
				SELECT Csrsubproducto
				REPLACE kilos WITH Csrproducto.peso,volumen WITH Csrproducto.volumen
			ENDSCAN 	
		
			SELECT CsrSubproducto
			.lhayvariedad = IIF(RECCOUNT("CsrSubproducto")#0,.t.,.f.)
			GO top
		
			.containervariedad.grid3.RecordSource = "Csrsubproducto"
			.containervariedad.grid3.column1.ControlSource = "nombre"
			.containervariedad.grid3.column2.ControlSource = "cantidad"
			.containervariedad.grid3.column3.ControlSource = "cantreal"
		ENDWITH 
		
	ENDPROC

	PROCEDURE ultimodiamesanterior		&& Fecha sugerida: ultimo dia del mes anterior a la fecha del servidor
		LOCAL ldhoy
		ldhoy = IIF(VARTYPE(CsrParaConfig.fechaserver)='T',TTOD(CsrParaConfig.fechaserver),CsrParaConfig.fechaserver)
		IF EMPTY(ldhoy)
			ldhoy = DATE()
		ENDIF
		RETURN DATE(YEAR(ldhoy),MONTH(ldhoy),1)-1
	ENDPROC

	PROCEDURE validarcomproba
		LOCAL lntotalcomp,lcerror,llok
		
		llok= .t.
		lntotalcomp = thisform.containertotales._txtctacte.Value
		this.cadenaerrores = ""
		
		LOCAL ldfecha
		WITH thisform.containerencabeza
			IF NOT (ALLTRIM(._txtletra.Value)$"ABCME")
				oavisar.usuario('La letra no corresponde')
				RETURN .f.
			ENDIF 
			
			ldfecha= STR(YEAR(._txtfecha.value),4)+STRZERO(MONTH(._txtfecha.value),2)
			IF LTRIM(ldfecha)>ltrim(._txtperiodo.value)
				oavisar.usuario('La fecha de emisión es MAYOR al PERIODO FISCAL')
				RETURN .f.
			ENDIF 
			IF LEN(ALLTRIM(._txtperiodo.value))<6
				oavisar.usuario('Perido fiscal NO VALIDO.')
				RETURN .f.
			ENDIF 
			IF VAL(right(ALLTRIM(._txtperiodo.value),2))>12
				oavisar.usuario('Perido fiscal NO VALIDO.')
				RETURN .f.
			ENDIF 
			
			SELECT CsrParaVario
			LOCATE FOR nombre='PFISCALPRE'
			ldpefiscal = CsrParaVario.fecha
			ldpeconfig = CTOD("01-"+RIGHT(CsrParaConfig.pefiscal,2)+"-"+LEFT(CsrParaConfig.pefiscal,4))
		
		        && gabriel ( no se que está chequeando, no deja cargar facturas 12-01-12 )
		*!*		IF (GOMONTH(ldpeconfig,-1)<ldpefiscal) OR (GOMONTH(ldpefiscal,2)<ldpeconfig)
		*!*			=Oavisar.usuario("ERROR"+CHR(13)+"GRABACIÓN CANCELADA"+CHR(13)+"El ultimo período presentado difiere en mas de dos mes con el actual",0)
		*!*			RETURN .f.
		*!*		ENDIF 
			
			ldfecha = CTOD("01-"+RIGHT(CsrAuxMaopera.pefiscal,2)+"-"+LEFT(CsrAuxMaopera.pefiscal,4))
		    
			IF (GOMONTH(ldfecha,-1)<ldpefiscal) OR (GOMONTH(ldpefiscal,2)<ldfecha)
				=Oavisar.usuario("ERROR"+CHR(13)+"GRABACIÓN CANCELADA"+CHR(13)+"El período facturado es menor o igual al ultimo periodo presentado ";
				+CHR(13)+'ó el período facturado difiere de mas de dos meses con el presentado',0)
				RETURN .f.
			ENDIF 
		    	
		ENDWITH

		&& NC / ND: debe indicar la liquidacion original (existente, misma cuenta, no anulada)
		IF CsrComprobante.clase$'BC' AND LiqDatos.idmaoperaliq=0
			oavisar.usuario('Debe indicar la liquidación original (punto de venta y número) de la nota de crédito / débito.')
			RETURN .f.
		ENDIF
		IF CsrComprobante.clase$'BC' AND EMPTY(LiqDatos.tipoajuste)
			oavisar.usuario('Debe indicar el tipo de ajuste de la nota de crédito / débito.')
			RETURN .f.
		ENDIF 

		&& M = MANUAL: la LUM ya fue emitida en el portal de ARCA (Comprobantes en linea); se registra con su CAE
		IF thisform.tipoform = 'M'
			IF LEN(ALLTRIM(LiqDatos.cae))<>14 OR LEN(CHRTRAN(ALLTRIM(LiqDatos.cae),'0123456789',''))>0 OR VAL(LiqDatos.cae)=0
				oavisar.usuario('Debe cargar el CAE de la liquidación (14 dígitos), tal como figura en el impreso.')
				RETURN .f.
			ENDIF
			IF EMPTY(LiqDatos.vtocae)
				oavisar.usuario('Debe cargar el vencimiento del CAE, tal como figura en el impreso.')
				RETURN .f.
			ENDIF
		ENDIF

		&& LUM: los importes estan en LiqDatos (no en totales/cuerpo); el resto lo controla el SP al grabar
		IF thisform.tipoform$'FM'
			IF thisform.existenumliq()
				oavisar.usuario("Ya existe el comprobante "+TRIM(Csrcomprobante.cnombre)+" "+LEFT(thisform.proximonro,1)+" ";
								+SUBSTR(thisform.proximonro,2,4)+"-"+RIGHT(thisform.proximonro,8)+" grabado. No se puede grabar otro igual.")
				RETURN .f.
			ENDIF
			IF LiqDatos.total<=0
				oavisar.usuario('El total de la liquidación debe ser mayor a cero.')
				RETURN .f.
			ENDIF
			WITH thisform.containerencabeza
				IF STR(YEAR(._txtfecha.value),4)+STRZERO(MONTH(._txtfecha.value),2)<>ALLTRIM(._txtperiodo.value)
					oavisar.usuario('La fecha del comprobante debe pertenecer al período de la liquidación.')
					RETURN .f.
				ENDIF
			ENDWITH
			RETURN .t.
		ENDIF

		IF lntotalcomp=0
		   Oavisar.usuario("Va a cargar una factura en cero",0)
		   llok=.f.
		ENDIF
		
		IF RECCOUNT('CsrAuxPlanCue')=0 AND RECCOUNT('CsrAuxCuerfac')=0 AND llok
			*nose generaron asientos (servicos) o asientos y cuerpo (noraml)
			 Oavisar.usuario("No se puede facturar en cero",0)
			llok = .f.
		ENDIF  
		
		
		IF llok and RECCOUNT('CsrAuxCuerfac')#0 AND thisform.tipoform#'R'
			SELECT CsrAuxcuerfac
			GO TOP 
			lncambio = 0
			SCAN 
				IF CsrAuxCuerfac.pesable=CsrAuxCuerfac.vtakilos
				  IF thisform.incluyeiva
					IF CsrAuxCuerfac.preunita#CsrAuxCuerfac.preorig .OR. bonif1#obonif1 .or. bonif2#obonif2 .or. bonif3#obonif3 .or. bonif4#obonif4
						lncambio=1
						EXIT 
					ENDIF
				  ELSE
					IF CsrAuxCuerfac.preunitasiva#CsrAuxCuerfac.preorig .OR. bonif1#obonif1 .or. bonif2#obonif2 .or. bonif3#obonif3 .or. bonif4#obonif4
						lncambio=1
						EXIT 
					ENDIF 	
				  endif 
				ENDIF 
			ENDSCAN 
			thisform.cambioprecio =  IIF(lncambio=1,Oavisar.usuario('Hay cambio de precios, Desea actualizar cambio de precios? ',36),0)	
		ENDIF 
			
		IIF(thisform.tipoform$"R",llok,thisform.actualizafac.controlimpuesto(@llok))
		
		RETURN llok
	ENDPROC

	PROCEDURE validarimpuestos
		&&Validamos algunos impuestos
		
		LOCAL cCadena,nBaseImpIVA,nBaseGravado
		STORE 0 TO nBaseImpIVA,nBaseGravado
		cCadena = ""
		&&iva.
		SELECT CsrAuxPlanCue
		GO TOP 
		SCAN 
			IF importe=0
				LOOP 
			ENDIF 
			IF tipoconce$"IG-OI"
				IF tasa=0
					cCadena = cCadena + "Existen Impuestos IVA con tasa 0."+CHR(13)
				ENDIF 
				nImpuesto	= importe
				IF tasa#0 &&Impuestos de iva solo tienen tasas
					nBaseImpIVA = nBaseImpIVA + (nimpuesto*100/tasa)
				ENDIF
			ENDIF 
			IF tipoconce$"NG"
				nBaseGravado = nBaseGravado + importe
			ENDIF 
		ENDSCAN 
		
		nPorce		= 0.01
		cCadPorce	= "El NETO GRAVADO no es aproximado en un +/-1% con la base del iva."
		&&Si la parada esta en "1". Pedimos validacion para cambiar el porcentaje a 10%
		IF "1"$this.containerencabeza._txtparada.Value
			&&Si ingresa la clave de acceso correcto.
			LOCAL loObjeto
			DO FORM frmterminal name LobjForm linked
			llok = lobjform.encontrokey
			RELEASE lobjform
			IF llok
				nPorce = 100
				cCadPorce	= "El NETO GRAVADO no es aproximado en un +/-10% con la base del iva."
			ENDIF 
		ENDIF 
		IF NOT this.containerencabeza._txtletra.Value$"C" AND nBaseGravado >0.01 AND nPorce <> 100
			&&Validar Neto y BaseImp
			IF NOT (((nBaseGravado*(1+nPorce)) >= nBaseImpIVA) AND ((nBaseGravado - (nBaseGravado*nPorce)) <= nBaseImpIVA))
				cCadena = cCadena + cCadPorce +CHR(13)
			ENDIF 
		ENDIF 
		
		
		
		IF lentrim(cCadena)>0
			oavisar.usuario(cCadena)
			RETURN .f.
		ENDIF 
		
		RETURN .t.
	ENDPROC

	PROCEDURE validarnrocaja
		LOCAL nNroCaja,nNroCajaActiva,llok
		&&Validamos que la caja editada, este abierta, pertenezca al ejercicio fiscal.
		nNroCaja = CsrAuxMaopera.nrocaja
		
		nNroCajaActiva = CsrParaConfig.nrocaja
		
		&&Controlamos que la caja este abierta
		&&Controlamos que la caja pertenezca al ejercicio fiscal
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrDetaNroCaja.* FROM DetaNroCaja as CsrDetaNroCaja WHERE nrocaja = <<nNroCaja>>
		ENDTEXT 
		IF NOT CrearCursorAdapter("FsrNroCaja",lccmd)
			thisform.Release
		ENDIF 
		llok = .t.
		thisform.cadenaerrores = "CAMBIO DE CAJA."+CHR(13)
		IF RECCOUNT('FsrNroCaja')=0
			this.cadenaerrores = this.cadenaerrores + CHR(13)+"No se encontro ninguna caja en el sistema para "+strzero(nNroCaja,8)+"."
			llok = .f.
		ELSE 
			SELECT FsrNroCaja
			IF LEFT(FsrNroCaja.switch,1)="1"
				this.cadenaerrores = this.cadenaerrores + CHR(13)+"La caja "+strzero(nNroCaja,8)+" se encuentra CERRADA."
				llok = .f.
			ENDIF 
			IF FsrNroCaja.idejercicio != goapp.idejercicio
				this.cadenaerrores = this.cadenaerrores + CHR(13)+"La caja "+strzero(nNroCaja,8)+" no pertenece al ejercicio fiscal actual."
				llok = .f.
			ENDIF 
		ENDIF 
		
		&&Si se valido la nueva caja. Actualizamos los campos correspondientes.
		IF llok
			replace iddetanrocaja WITH FsrNroCaja.id IN CsrAuxMaopera
		ELSE
			oavisar.usuario(this.cadenaerrores,0)
			replace nrocaja WITH nNroCajaActiva IN CsrAuxMaopera
			thisform.Refresh()
			
		ENDIF 
		
	ENDPROC

	PROCEDURE vercomprobante		&& Circula sobre CsrCurConsulta, para mostrar los comprobante con tecla + -
		PARAMETERS lnKeyCode
		
		LOCAL lcIdretorno
		
		IF USED("CsrCurConsulta")
			IF !EOF("CsrCurConsulta") AND lnKeyCode=43
				SKIP 1 IN CsrCurConsulta
			ENDIF 		
			IF !BOF("CsrCurConsulta") AND lnKeyCode#43
				SKIP -1 IN CsrCurConsulta
			ENDIF 		
			IF EOF()
				GO BOTTOM 
			ENDIF 	
			IF BOF()
				GO TOP 
			ENDIF 
			lcidretorno = STRID(CsrCurConsulta.idmaopera)
			thisform.muestracomprobante(lcidretorno)	
		ENDIF 
		
		RETURN .t.
	ENDPROC

	PROCEDURE verestadovalores
		parameters lcidmaopera
		local lcCmd,lccheques,llOK
		store .f. to llOK
		
		lccheques  = 'Los siguientes Cheques'
		
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrMovbcocar.* from Movbcocar as CsrMovbcocar where CsrMovbcocar.idmaopera = <<lcidmaopera>>
		ENDTEXT 
		
		=thisform.obtenerdatos("CsrMovbcocar",lcCmd)
		
		Sele CsrMovbcocar
		Scan for !EOF()
		     IF LEFT(switch,1)="1" AND origen="3RO"
		        lccheques = lccheques + chr(13) + 'Nº '+transform(numcomp,'9999999999')
		        llOK = .t.
		     endif
		endscan
		if llok
		   this.CadenaErrores= this.CadenaErrores+CHR(13)+lccheques + chr(13) +  '// FUERON DEPOSITADOS O ENTREGADOS'
		ENDIF 
		
			
		&&Comprobante afectado
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT CsrAfeCtacte.* FROM AfeCtacte as CsrAfeCtacte WHERE CsrAfeCtacte.idmaoperad = <<lcidmaopera>>
		ENDTEXT 
		IF !thisform.obtenerdatos("CsrAfeCtacte",lcCmd)
			thisform.Release
		ENDIF 
		IF RECCOUNT('CsrAfeCtacte')#0
			this.CadenaErrores= this.CadenaErrores+CHR(13)+'EL COMPROBANTE ESTA AFECTADO A OTRO'	
			llOK = .T.
		ENDIF 
		
		
		&&Cierre ejercicio
		IF !this.oCONTABILIDAD.Validar()
			this.CadenaErrores= this.CadenaErrores+CHR(13)+this.oCONTABILIDAD.Cadenaerror
			LLOK = .t.
		ENDIF 
		
		return iif(llok,.f.,.t.)
	ENDPROC

	PROCEDURE zapfile
		PARAMETERS lcalias,lcOrderActual
		
		LOCAL i
		
		IF 'NATIVE'$LcDataSourceType
			SELECT(lcAlias)
		    FOR i=1 TO 20
			    IF !EMPTY(TAG(i))
		   	       IF UPPER(TAG(i))=UPPER(LcorderActual)
		              SET ORDER TO &LcorderActual
		              GO TOP 
		              EXIT 
		           ENDIF    
		        ENDIF  
		    NEXT
		ENDIF
		
		RETURN .t.
	ENDPROC

