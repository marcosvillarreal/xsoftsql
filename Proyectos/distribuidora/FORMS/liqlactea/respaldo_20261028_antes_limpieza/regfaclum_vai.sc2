	PROCEDURE Grid2.AfterRowColChange
		LPARAMETERS nColIndex
		
		DODEFAULT(nColIndex)
		
		* si codigo #0 or (codigo=0 y nombre=0) si paso codigo con 0 cuando digito algo en el nombre es para buscar
		WITH thisform
			.kitbuscarProd.ltextodigitado = .t.
			IF LEN(TRIM(.grid2.column1.text1.Value))#0 OR (LEN(TRIM(.grid2.column1.text1.Value))=0 AND LEN(TRIM(.grid2.column2.text1.Value))=0)
				.kitbuscarProd.ltextodigitado = .f.
			ENDIF 
		ENDWITH 
	ENDPROC

	PROCEDURE Grid2.Column1.Text1.GotFocus
		WITH thisform
			.prodanterior	 	 = this.Value
			.lblayudapie.Caption = "[Esc]Retrocede a Proveedor     [F10]Confirma - Modifica totales"   
			.ultimocontainer     = "THISFORM.GRID2" 
			.lpidocodigo 	 	 = .f.
			.lpidocantidad       = .t.
			.cmdSalvar.Visible   = .t.
			.datocargado 		 = .f.
		ENDWITH 
	ENDPROC

	PROCEDURE Grid2.Column1.Text1.InteractiveChange
		thisform.lpidocodigo = .t.
		thisform.bloqueocodigo = .f.
	ENDPROC

	PROCEDURE Grid2.Column1.Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		thisform.bloqueocodigo = .f.
	ENDPROC

	PROCEDURE Grid2.Column1.Text1.LostFocus
		thisform.ultimocontainer ="THISFORM.GRID2" 
		
		IF  VAL(this.Value)#0  AND strzero(thisform.lnkeycode,3)$"013-009-004" AND !thisform.editarprecio
		
			IF thisform.kitbuscarProd.fc_lostfocus(VAL(this.Value))
				thisform.kitbuscarProd.f_lostfocusSay()
				IF thisform.repetircodigo
					NODEFAULT 
					thisform.repetircodigo = .f.
				ENDIF 
		        IF CsrAuxCuerfac.idarticulo#0 AND CsrAuxCuerfac.preunita # 0
		   	      *KEYBOARD '{ENTER}'
		   	      thisform.datocargado= .f.
		        ENDIF 		
			ELSE
				IF VAL(this.Value)#0
					=Oavisar.usuario("El articulo no existe",0)
					this.SelectOnEntry=.t.
					this.SelStart=0
					this.SelLength=LEN(ALLTRIM(this.Text))
					NODEFAULT 
				ENDIF
				REPLACE idarticulo WITH 0 IN CsrAuxcuerfac		
			ENDIF
		ENDIF 	 	
		
	ENDPROC

