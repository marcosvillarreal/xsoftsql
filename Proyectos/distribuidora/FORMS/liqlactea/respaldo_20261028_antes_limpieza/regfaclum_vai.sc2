	PROCEDURE Containerencabeza.KitbuscaoaltaenCtacte.lostfocosay
		LOCAL lok
		
		WITH thisform
			IF thisform.consultando
				.HayEscape = .t.
			ENDIF 
			IF .ctacteanterior#CsrCtacte.id
				.HayEscape = .f.
			ENDIF 
			
			IF !.Hayescape
				.lnkeycode = 0
				lok = .cargarcabefac()
				IF !this.lprocesogrillabusqueda AND lok
					.cmdconsulta.Enabled = .t.
					.containerencabeza.Refresh()
					IF thisform.tipoform$'R'
							.containerencabeza._cboprovincia.SetFocus()
					ELSE 
							.containerencabeza._cbocomprobante.SetFocus()
					ENDIF 
					IF CsrAuxCabefac.idctacte#0 OR ALLTRIM(CsrAuxCabefac.cnombre)=ALLTRIM(this.lctxtamovernombre)
						IF thisform.tipoform$'R'
							.containerencabeza._cboprovincia.Click()
						ELSE 
							.containerencabeza._cbocomprobante.click()
						ENDIF 
						IF .consultando &&AND !.pulseborrar
							.containerencabeza._txtparada.SetFocus()
						ENDIF 
					ELSE
						IF thisform.tipoform$'R'
							.containerencabeza._cboprovincia.Click()
						ELSE 
							.containerencabeza._cbocomprobante.click()
						ENDIF 
					ENDIF 			
				ENDIF 
				
			    .containerencabeza.kitbuscaoaltaenCtacte.lrecargatxtnombre = .t.			     
			    
				IF !lok
				 	.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
				 	.containerencabeza.kitbuscaoaltaenCtacte.txtexiste1.Click()
				ENDIF 	
			ELSE
				.Hayescape = .f.
			ENDIF 
			
			SELECT CsrParaVario
			thisform.lnrecodevol = 0
			LOCATE FOR nombre='RECODEVOLUCION'
			IF nombre='RECODEVOLUCION' AND thisform.esrecodevol
				thisform.lnrecodevol = CsrParaVario.porce
			ENDIF 
		
			replace recodevol WITH thisform.lnrecodevol IN CsrAuxCabefac
		
		ENDWITH 
		
		
	ENDPROC

	PROCEDURE Containerencabeza.KitbuscaoaltaenCtacte.Txtexiste1.GotFocus
		thisform.cmdconsulta.Enabled = .f.
		DODEFAULT()
	ENDPROC

