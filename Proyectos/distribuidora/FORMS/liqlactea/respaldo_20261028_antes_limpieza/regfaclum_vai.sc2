			 	.containerencabeza._txtcuit.SetFocus
		    endif	
		ENDWITH 
	ENDPROC

	PROCEDURE Containerencabeza._chkpidovalor.LostFocus
		&&Marcos 06/01/2014
		&&Si se esta pasando una registracion de contado con pefiscal de un ejercicio anterior al actual
		&&No dejamos registrarla. Debe pasarla de cuenta corriente y cobrar con una orden de pago
		DODEFAULT()
		IF !thisform.consultando 
			*STOP()
			IF NOT thisform.controlcajacontable()
				oavisar.usuario('CONTROL'+CHR(13)+'NO SE PERMITE REGISTRAR COMPROBANTES DE CONTADO EN UN PERIODO QUE NO PERTENEZCA AL EJERCICIO DE LA CAJA ACTIVA.';
								+CHR(13)+'REGISTRE EL COMPROBANTE COMO CUENTA CORRIENTE Y GENERE EL PAGO DEL MISMO EN UNA ORDEN DE PAGO.')
				this.Parent._txtfecha.SetFocus()
				this.Parent._txtfecha.Click()
				*RETURN 
			ENDIF 
		ENDIF
	ENDPROC

	PROCEDURE Containerencabeza._txtcuit.Valid
		LOCAL lok,lccuit
		
		lccuit = this.Value
		lok = .t.
		DO case
			CASE Csrcategoiva.fiscal='I'		&& RI
				lok = vericuit(lccuit)
			CASE Csrcategoiva.fiscal='N'		&& RNI
				lok = vericuit(lccuit)
			CASE Csrcategoiva.fiscal='E'		&& exento
				lok = vericuit(lccuit)
			CASE Csrcategoiva.fiscal='M'		&& monotributo
				lok = vericuit(lccuit)		
		ENDCASE
		
		lnidtipoiva   = thisform.containerencabeza._cbotipoiva.Value 
		lnidcategoria = IIF(CsrAuxCabefac.idctacte=0,1,CsrCtacte.idcategoria)
		lnidlocalidad = CsrLocalidad.id
		lnidprovincia = CsrProvincia.id
		lccuit        = IIF(CsrAuxCabefac.idctacte=0,"",this.value)
					  = thisform.controlctacte(CsrAuxCabefac.idctacte,lcCuit,lnidcategoria,lnidprovincia,lnidlocalidad)
		
		RETURN lok
	ENDPROC

