	ADD OBJECT 'paraconfig' AS cursoradapter WITH ;
		Alias = "Csrparaconfig", ;
		CursorSchema = <fb2p_value>ID I, IDEJERCICIO I, TIPOCAJA C(1), PEFISCAL C(6), PIDODOLAR C(20), PIDOCOSTO C(20), IDDEPOSITO I, IDLOCALIDAD I, IDVENDEDOR I, IDCOMPROBA1 I, IDCOMPROBA2 I, IDCOMPROBA3 I, IDCOMPROBA4 I, IDCOMPROBA5 I, IDCOMPROBA6 I, IDCOMPROBA7 I, IDCOMPROBA8 I, IDCOMPROBA9 I, TASA1 N(8, 2), SOBTASA1 N(8, 2), TASA2 N(8, 2), SOBTASA2 N(8, 2), TASA3 N(8, 2), SOBTASA3 N(8, 2), RETENCION1 N(8, 2), MINRETEN1 N(13, 3), RETENCION2 N(8, 2), MINRETEN2 N(13, 3), RETENCION3 N(8, 2), MINRETEN3 N(13, 3), RETENCION4 N(8, 2), MINRETEN4 N(13, 3), RETENCION5 N(8, 2), MINRETEN5 N(13, 3), TALONPC1 N(5, 0), TALONMA1 N(5, 0), TALONPC2 N(5, 0), TALONMA2 N(5, 0), TALONPC3 N(5, 0), TALONMA3 N(5, 0), TALONPC4 N(5, 0), TALONMA4 N(5, 0), TALONPC5 N(5, 0), TALONMA5 N(5, 0), LISTADEFECTO N(2, 0), IDPLANPAGO I, IDCTA01 I, IDCTA02 I, IDCTA03 I, IDCTA04 I, IDCTA05 I, SWITCH C(20), IDDETANROCAJA I, IDCOTIZADOLAR I, FECHASERVER T, FECHAFAC T, TURNO N(2, 0), IDDETAFAC I, DIASVTO N(4, 0), IDPROVINCIA I, IDEJERCICIOCAJA I, NROCAJA N(9, 0), FECDESDE T, FECHASTA T, PEFISCAL1 C(6), FECHACOTI T, PRECIOCPRA N(13, 3), PRECIOVTA N(13, 3)</fb2p_value>, ;
		Flags = 0, ;
		Height = 66, ;
		KeyFieldList = , ;
		Left = 630, ;
		Name = "paraconfig", ;
		SelectCmd = <fb2p_value>
Select Csrparaconfig.*,isnull(Csrlocalidad.idprovincia,0) as idprovincia
,isnull(Csrdetanrocaja.idejercicio,cast(0 as int)) as idejerciciocaja
,ISNULL(Csrdetanrocaja.nrocaja,0) as nrocaja,isnull(Csrdetanrocaja.fecdesde,'19000101') as fecdesde
,isnull(Csrdetanrocaja.fechasta,'19000101') as fechasta
,isnull(Csrdetanrocaja.pefiscal,0) as pefiscal,Csrcotizadolar.fechacoti as fechacoti,Csrcotizadolar.preciocpra as preciocpra
,Csrcotizadolar.preciovta as preciovta
from paraconfig as Csrparaconfig
left join detanrocaja as Csrdetanrocaja on Csrparaconfig.iddetanrocaja = CsrDetanrocaja.id
left join Cotizadolar as Csrcotizadolar on Csrparaconfig.idcotizadolar = Csrcotizadolar.id
left join localidad as Csrlocalidad on Csrparaconfig.idlocalidad = Csrlocalidad.id where csrparaconfig.id <0
</fb2p_value>, ;
		Tables = paraconfig,detanrocaja,Cotizadolar,localidad, ;
		Top = 110, ;
		UpdatableFieldList = , ;
		UpdateNameList = , ;
		UseDeDataSource = .T., ;
		Width = 99
		*< END OBJECT: BaseClass="cursoradapter" />

