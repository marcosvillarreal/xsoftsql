	PROCEDURE cmdSalvar.Click
		WITH thisform
			.bloqueocodigo = .f.
			.accion = "A"
			IF .ultimocontainer ="THISFORM.GRID2" 
			   .key_43(1)       									&& + a cuenta contable
			ELSE
				IF .tipoform <>'R'
					IF .tipoform$'FM' AND UPPER(.ultimocontainer)='CONTENEDORLIQ'
						.controlliqdatos()
					ENDIF
		       		.key_43(2)       									&& + Graba
		       	ELSE
		       		IF .ultimocontainer ="THISFORM.GRID1" 
		       			.key_43(4)	 			&& generamos cuotas por el auxplancue
		       		ENDIF 
		       		IF .ultimocontainer ="THISFORM.GRID4"
		       			.key_43(5)
		       		ENDIF 
		       	ENDIF 
		    ENDIF 
		ENDWITH 
	ENDPROC

