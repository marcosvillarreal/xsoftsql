		IF !CsrAuxPlanCue.cuenta#0
			thisform.contenedorRegistro.grid1.column2.text1.Value=''
		ENDIF  
		IF CsrAuxPlancue.idcuenta#0 and CsrAuxPlanCue.cuenta#0
			RETURN .f.
		ENDIF 
	ENDPROC

	PROCEDURE ContenedorRegistro.Grid1.Column3.Combo1.GotFocus
		SELECT CsrAuxPlanCue 
		
		SELECT CsrClaseCta
		LOCATE FOR cnumero = CsrAuxPlanCue.tipoconce
		
		this.Value = CsrClaseCta.id
		this.DisplayValue = CsrClaseCta.cnombre
		this.refresh()
		SELECT CsrAuxPlanCue
		
	ENDPROC

	PROCEDURE ContenedorRegistro.Grid1.Column3.Combo1.LostFocus
		REPLACE tipoconce WITH CsrClaseCta.cnumero,idclase WITH CsrClaseCta.id IN CsrAuxPlanCue
	ENDPROC

	PROCEDURE ContenedorRegistro.Grid1.Column5.Text1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		DO CASE 
			CASE nkeycode=13
				NODEFAULT 
			CASE nKeyCode=27
				NODEFAULT 
				thisform.k_escape()    
			CASE nkeyCode=4
				IF thisform.grid1b_keypress(nkeyCode)
					NODEFAULT 
				ENDIF 
			CASE nKeyCode=43
				NODEFAULT 
				thisform.key_43(4) && + Graba
		ENDCASE 
		
		
			
	ENDPROC

	PROCEDURE ContenedorRegistro.Grid1.Column5.Text1.Valid
		IF !thisform.consultando
			thisform.totalregistracion()
		ENDIF 
		RETURN .t.
	ENDPROC

