	PROCEDURE Containerencabeza._txtfecha.GotFocus
		WITH thisform
			.lblayudapie.Caption = "[Esc]Abandona formulario"
			.ultimocontainer = 'CONTAINERINGRESO'
			*.pulseborrar = .f.
			.controlinicial()
			.cmdconsulta.Enabled = .t.
		ENDWITH 
		DODEFAULT()
	ENDPROC

	PROCEDURE Containerencabeza._txtfecha.LostFocus
		LOCAL ldfecha
		WITH this.Parent
			ldfecha= STR(YEAR(._txtfecha.value),4)+STRZERO(MONTH(._txtfecha.value),2)
			
			SELECT CsrParaVario
			LOCATE FOR nombre='PFISCALPRE'
			lnpefiscal = IIF(nombre='PFISCALPRE',VAL(LEFT(DTOS(CsrParaVario.fecha),6)),190001)
			 
			 replace pefiscal WITH ldfecha IN CsrAuxMaopera
			IF VAL(ldfecha)-lnpefiscal<1
				replace pefiscal WITH STR(VAL(ldfecha)+1,6) IN CsrAuxMaopera
			ENDIF
		ENDWITH
		
		&& la caja es la ultima (abierta) del mes de la fecha
		IF NOT thisform.hayescape
			thisform.buscarcajames(this.Value)
		ENDIF
	ENDPROC

	PROCEDURE Containerencabeza._txtfecha.Valid
		* 02/07/19 Comentado por Marcos.
		*Se debe poder cargar facturas atrasadas en el ejercicio actual
		
		*!*	LOCAL oEjercicioActivo
		
		*!*	=LeerEjercicioActivo(@oEjercicioactivo)
		*!*	IF this.Value < oEjercicioActivo.fecdesde OR oEjercicioActivo.fechasta < this.Value
		*!*		=Oavisar.usuario("Contacte a un usuario con permiso para cambiar parametros diarios;"+CHR(13)+CHR(13);
		*!*					+"Fecha "+DTOC(this.Value)+" no pertenece al ejercicio activo / seleccionado"+CHR(13)+CHR(13);
		*!*					+"Ejercicio activo / seleccionado "+STR(oEjercicioActivo.ejercicio,3)+CHR(13);
		*!*					+"fecha desde "+DTOC(TTOD(oEjercicioActivo.fecdesde))+" fecha hasta "+DTOC(TTOD(oEjercicioActivo.fechasta))+CHR(13);
		*!*					+"caja desde   "+TRANSFORM(oEjercicioActivo.Nrocaja1,"99999999")+"    caja hasta   "+TRANSFORM(oEjercicioActivo.nrocaja2,"99999999"),0)
		*!*		RETURN .f.
		*!*	ELSE
		*!*		DODEFAULT()
		*!*	ENDIF 
	ENDPROC

	PROCEDURE Containerencabeza._txtletra.When
		&& F = NORMAL: la letra la asigna el sistema
		RETURN thisform.tipoform = 'M'
	ENDPROC

	PROCEDURE Containerencabeza._txtletra.Valid
		* Si entra en esta parte. Solo es editable si es RI.
		* Por lo tanto solo validamos las opciones de RI
		
		IF CsrCategoiva.abrevia='RI'
			IF !ALLTRIM(this.Value)$'AEM'
				oavisar.usuario('La Letra no corresponde a un RESPONSABLE INSCRIPTO')
				RETURN .F.
			ENDIF 
			IF ALLTRIM(thisform.lcletra) != ALLTRIM(this.Value) &&son distintas
				thisform.cambioletrari = .t.
			ENDIF 
			&&Rearmamos el numero
			thisform.lcletra = this.Value
		ENDIF 
		RETURN .t.
		
	ENDPROC

	PROCEDURE Containerencabeza._txtnrocaja.LostFocus
		thisform.validarnrocaja()
	ENDPROC

	PROCEDURE Containerencabeza._txtnumcomp.When
		&& F = NORMAL: el numero lo asigna el sistema (leerproximonro)
		RETURN thisform.tipoform = 'M'
	ENDPROC

	PROCEDURE Containerencabeza._txtnumcomp.LostFocus
		
		WITH thisform
			.proximonro  = LEFT(.containerencabeza._txtletra.value,1) + strzero(.talonario,4) + strzero(this.Value,8)
		ENDWITH

		&& LUM: el comprobante + numero no puede estar grabado
		IF thisform.tipoform$'FM'
			IF !thisform.hayescape AND this.Value#0 AND thisform.existenumliq()
				NODEFAULT
				=Oavisar.usuario("Ya existe el comprobante "+TRIM(Csrcomprobante.cnombre)+" "+LEFT(thisform.proximonro,1)+" ";
								+SUBSTR(thisform.proximonro,2,4)+"-"+RIGHT(thisform.proximonro,8)+" grabado.",0)
				RETURN
			ENDIF
			DODEFAULT()
			RETURN
		ENDIF

		LOCAL lccmd
		TEXT TO lcCmd TEXTMERGE NOSHOW 
		SELECT Csrmaopera.id FROM maopera as Csrmaopera
		LEFT JOIN cabecpra as Csrcabecpra ON Csrmaopera.id = Csrcabecpra.idmaopera
		where Csrmaopera.origen='CPR' and Csrmaopera.idcomproba=<<Csrcomprobante.id>>
		and Csrmaopera.numcomp='<<thisform.proximonro>>' and ISNULL(CsrCabecpra.cuit,'')='<<thisform.containerencabeza._txtcuit.Value>>'
		and Csrmaopera.estado<>'1'
		ENDTEXT 
		
		IF USED("CsrCursor")
			USE IN CsrCursor
		ENDIF 
		
		=CrearCursorAdapter("CsrCursor",lcCmd) 
		
		IF USED("Csrcursor")
			IF RECCOUNT("CsrCursor")>0
				NODEFAULT 
				=Oavisar.usuario("Ya existe ese número, para ese cuit",0)
				RETURN 
			ENDIF 
		ENDIF
		
		DODEFAULT()
		
		
	ENDPROC

	PROCEDURE Containerencabeza._txtparada.GotFocus
		thisform.ultimofocoen = UPPER(this.Name)
		DODEFAULT()
		*!*	IF thisform.pulseborrar
		*!*		this.Parent.kitbuscaoaltaenCtacte.txtexiste1.SetFocus()
		*!*	ENDIF 
	ENDPROC

	PROCEDURE Containerencabeza._txtparada.LostFocus
		WITH thisform
			cleartec()
			.ultimocontainer='THISFORM.GRID1'
			.lblayudapie.Caption = "[Esc]Retrocede a Proveedor   [ + ]Graba" 
			.REFRESH()
			IF !.consultando
				.limpiarpagos()
			ENDIF 
			IF 'P'$UPPER(this.Value) AND CsrComprobante.clase$'A'
				.permitemulticodigo = .t.
				lok = thisform.buscarorigen()
				this.value = IIF(!lok,0,this.Value)
			ENDIF 
			.cmdasiento.visible = .consultando
			IF !.consultando AND !.hayescape AND .tipoform$'FM'
				DO CASE 
					CASE .tipoform = 'F' AND NOT CsrComprobante.clase$'BC'
						&& F = NORMAL: los datos vienen de la liquidacion -> va a grabar (pide confirmacion)
						.key_43(2)
					CASE .tipoform = 'F'
						&& F, NC / ND: primero se indica la liquidacion original
						.ocultargrillasliq()
						.ultimocontainer = 'CONTENEDORLIQ'
						.lblayudapie.Caption = "[Esc]Retrocede a Parada   [ + ]Graba"
						.cmdSalvar.Visible = .t.
						.cmdSalvar.Enabled = .t.
						.ContenedorLiq._txtptovtaliq.SetFocus()
					OTHERWISE
						&& M = MANUAL: el operador carga los datos de la LUM impresa
						.ocultargrillasliq()
						.ultimocontainer = 'CONTENEDORLIQ'
						.lblayudapie.Caption = "[Esc]Retrocede a Parada   [ + ]Graba"
						.cmdSalvar.Visible = .t.
						.cmdSalvar.Enabled = .t.
						.cmdrecuperar.Visible = .t.
						.cmdrecuperar.Enabled = .t.
						.ContenedorLiq._txtlitros.SetFocus()
				ENDCASE 
				RETURN
			ENDIF
			IF .tipoform <> 'R' && si el form trabaja como facturador normal
				IF !.consultando
					IF SUBSTR(CsrCateCtacte.switch,2,1)="1"      && el proveedor pide productos
						.grid2_generarlinea()   && 22=insert
						.grid2.column1.text1.SetFocus 
					ELSE
						SET SAFETY OFF
						SELECT CsrAuxCuerfac
						ZAP
						SET SAFETY ON
				 
						.grid1.Visible = .t.
						.grid1_generarlinea()
						.grid1.column1.text1.SetFocus 
					ENDIF 
				ELSE 
					IF SUBSTR(CsrCateCtacte.switch,2,1)="1"      && el proveedor pide productos
						.grid2.column1.text1.SetFocus 
					ELSE
						.grid1.column1.text1.SetFocus 
					ENDIF 
				ENDIF 
			ELSE
				IF !.consultando
					
					.grid2.visible = .f. &&cuerfac
					.grid1.visible = .f. &&impuestos
					.cargarplancue()
					GO TOP IN CsrAuxPlanCue
					.grid3_show()
					.contenedorregistro.grid1.column5.text1.SetFocus 
				ELSE  
					.contenedorregistro.grid1.column1.text1.SetFocus 
					.contenedorregistro.grid1.column1.text1.Click()
				ENDIF  
			ENDIF 
		ENDWITH   
			
		
	ENDPROC

	PROCEDURE Containerencabeza._txtperiodo.Valid
		LOCAL ldfecha
		WITH this.Parent
			ldfecha= STR(YEAR(._txtfecha.value),4)+STRZERO(MONTH(._txtfecha.value),2)
			IF LTRIM(ldfecha)>ltrim(._txtperiodo.value)
				oavisar.usuario('La fecha de emisión es MAYOR al PERIODO FISCAL')
				RETURN .f.
			ENDIF 
			IF LEN(ALLTRIM(._txtperiodo.value))<6
				oavisar.usuario('Perido fiscal NO VALIDO.')
				RETURN .f.
			ENDIF 
			IF VAL(right(ALLTRIM(._txtperiodo.value),2))>12
				oavisar.usuario('Perido fiscal NO VALIDO.')
				RETURN .f.
			ENDIF 
			nPerCaja = VAL(LEFT(strtrim(CsrAuxMaopera.nrocaja),6))
			IF goapp.codempresa <> 7
				IF nPerCaja<>VAL(._txtperiodo.value)
					oavisar.usuario('Perido fiscal NO VALIDO '+._txtperiodo.value+CHR(13)+;
									'Difiere del Periodo de la Caja '+strtrim(nPerCaja)+CHR(13)+;
									'Cambie o Abra una caja del periodo a registrar')
					RETURN .f.
				ENDIF 
			ENDIF 
		ENDWITH 
		
	ENDPROC

