		IF strzero(thisform.lnkeycode,3)$"003-005-018-024" 
			RETURN .f.
		ELSE
			RETURN .t. 
		ENDIF 
	ENDPROC

	PROCEDURE Grid2.Column14.Text1.When
		llok = thisform.editarprecio 
		
		IF csrauxcuerfac.pesable=0 AND llok 
		   llok =  .f.
		ENDIF 
		RETURN llok
	ENDPROC

	PROCEDURE Grid2.Column2.TEXT1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nkeyCode < 0 
			NODEFAULT 
			RETURN .t.
		ENDIF 
		IF nkeycode=19 OR nkeycode=5
			thisform.kitbuscarProd.buscapornombre = .f.
		   	DODEFAULT()   
		   	RETURN .t.
		ENDIF
		IF ISALPHA(chr(nKeycode)) or ISDIGIT(chr(nKeycode)) OR nkeycode=32  OR CHR(nKeyCode)$'.,-*'
		   NODEFAULT      
		   this.Parent.Parent.column1.text1.value=SPACE(10)
		   thisform.kitbuscarProd.tecla=nkeycode   
		
		   IF !thisform.kitbuscarProd.ltextodigitado
		      thisform.kitbuscarProd.buscapornombre = .t. 	
		      this.LostFocus()
		   ELSE
		      dodefaul(nKeyCode, nShiftAltCtrl)         
		   ENDIF    
		ELSE
		   IF nKeyCode=13 AND EMPTY(this.Value)
		      thisform.kitbuscarProd.ltextodigitado = !thisform.kitbuscarProd.ltextodigitado
		      thisform.kitbuscarProd.buscapornombre = .f.
		      REPLACE univenta WITH 1 IN CsrAuxCuerfac
		      this.BackColor = RGB(240,243,247)
		      this.FontItalic = thisform.kitbuscarProd.ltextodigitado
		   ENDIF 
		   	IF nKeyCode=19 AND EMPTY(this.Value)
				thisform.grid2.column1.text1.SetFocus()
		    ELSE 
		    	dodefaul(nKeyCode, nShiftAltCtrl)  
		    ENDIF 
		ENDIF
	ENDPROC

	PROCEDURE Grid2.Column2.TEXT1.LostFocus
		IF thisform.editarprecio
			RETURN .t.
		ENDIF 
		
		IF thisform.kitbuscarProd.buscapornombre
			IF thisform.kitbuscarProd.fn_lostfocus(this.Value)
				thisform.kitbuscarProd.f_lostfocusSay()
		        IF CsrAuxCuerfac.idarticulo#0 AND CsrAuxCuerfac.preunita # 0
		   	      * KEYBOARD '{ENTER}'
		   	       DODEFAULT()
		        ENDIF 
			ENDIF 
		ELSE
			IF thisform.kitbuscarProd.ltextodigitado AND EMPTY(this.value)
				NODEFAULT 
			ELSE
				IF thisform.kitbuscarProd.ltextodigitado AND !EMPTY(this.Value)
		   	       *KEYBOARD '{ENTER}'
		   	       DODEFAULT()
				ENDIF  		
			ENDIF 
		ENDIF 	
	ENDPROC

	PROCEDURE Grid2.Column2.TEXT1.When
		IF VAL(CsrAuxCuerfac.codigo)=0
			thisform.grid2.column1.text1.Value = ''
		ENDIF 
		IF CsrAuxCuerfac.idarticulo#0
			RETURN .f.
		ENDIF  
	ENDPROC

	PROCEDURE Grid2.Column3.Combo1.When
		RETURN thisform.datocargado
	ENDPROC

	PROCEDURE Grid2.Column4.Text1.InteractiveChange
		thisform.lcsetfocus = "THISFORM.GRID2.COLUMN7.TEXT1"
		thisform.lcgotfocus = "THISFORM.GRID2.COLUMN4.TEXT1"
	ENDPROC

	PROCEDURE Grid2.Column4.Text1.LostFocus
		thisform.grid2_lostfocusimp()
	ENDPROC

	PROCEDURE Grid2.Column4.Text1.When
		RETURN thisform.editarprecio
	ENDPROC

	PROCEDURE Grid2.Column5.Text1.GotFocus
		thisform.datocargado = .t.
		 
		IF thisform.gridvariedad_when()
		   DODEFAULT()
		ENDIF
		
	ENDPROC

	PROCEDURE Grid2.Column5.Text1.InteractiveChange
		WITH thisform 
			.lcsetfocus            = ""
			.lcgotfocus            = "THISFORM.GRID2.COLUMN5.TEXT1"
		ENDWITH 	
	ENDPROC

	PROCEDURE Grid2.Column5.Text1.LostFocus
		WITH thisform
			IF .lhayvariedad AND !.lpidocantidad   &&this.Value = 0
				IF CsrauxCuerfac.pesable =0	
					IF !.grid2_lostfocuscant(1)	
					ENDIF 
					
					.grid2.column7.text1.SetFocus()
				ENDIF 
			ELSE 
				IF CsrauxCuerfac.pesable =0
					lctipo = IIF(.lhayvariedad,2,1)
					IF .lnkeycode<>19	
						IF !.grid2_lostfocuscant(lctipo)
						ENDIF 
					ELSE
						IF this.Value<>0
		 					.grid2.column4.enabled = .t.
					    	.grid2.column4.setfocus()
					    ENDIF 
					ENDIF 
				ELSE
					.lcsetfocus            = ""
					.lcgotfocus            = ""		
					.bloqueocodigo = .t.
					DODEFAULT()
				ENDIF 
			ENDIF					
		ENDWITH 
	ENDPROC

	PROCEDURE Grid2.Column5.Text1.Valid
		
		IF !thisform.editarprecio AND this.value#0
			thisform.grid2.column13.text1.Value = this.Value
		ENDIF 
		IF strzero(thisform.lnkeycode,3)$"003-005-018-024" 
			RETURN .f.
		ELSE
			RETURN .t. 
		ENDIF 
	ENDPROC

	PROCEDURE Grid2.Column6.Text1.When
		RETURN .f.
	ENDPROC

	PROCEDURE Grid2.Column7.Text1.LostFocus
		thisform.grid2_lostfocusbonif()
		
	ENDPROC

	PROCEDURE Grid2.Column7.Text1.When
		RETURN thisform.editarprecio
	ENDPROC

	PROCEDURE Grid2.Column8.Text1.When
		RETURN .f.
	ENDPROC

	PROCEDURE Grid2.Column9.Text1.When
		RETURN .f.
	ENDPROC

	PROCEDURE Grid2.Init
		DODEFAULT()
		THIS.Setall("DynamicBackColor","iif(thisform.editarprecio=.f.,RGB(222,229,235),RGB(255,252,196)","Column")
		
	ENDPROC

	PROCEDURE KitbuscarPlancue.f_lostfocussay
		SELECT CsrPlanCue
		IF !CsrAuxPlanCue.origen$'A-F'
			*stop()
			REPLACE cuenta WITH Csrplancue.cuenta,nombre WITH Csrplancue.nombre;
					,idprovincia WITH CsrAuxCabefac.idprovincia IN CsrAuxPlancue
			IF ALLTRIM(CsrAuxPlanCue.tipoconce)="" && ALLTRIM(Csrplancue.clasecta)
				replace nombreobjeto WITH Csrplancue.clasecta, idclase WITH CsrPlanCue.idclase IN CsrAuxPlanCue
				replace tipoconce WITH Csrplancue.clasecta IN CsrAuxPlanCue
			ENDIF 
		ENDIF 		
		IF thisform.tipoform = 'R'
			replace importe WITH 0 IN CsrauxPlanCue
		ELSE
			SELECT CsrClaseCta
			LOCATE FOR id = CsrauxPlanCue.idclase
			IF !id = CsrauxPlanCue.idclase
				GO BOTTOM IN CsrClaseCta
			ENDIF 
			thisform.grid1.column3.combo1.Value = CsrClaseCta.id
			thisform.grid1.column3.combo1.DisplayValue = CsrClaseCta.cnombre
		ENDIF 
		SELECT CsrAuxPlanCue
	ENDPROC

	PROCEDURE KitbuscarPlanGravado.f_lostfocussay
		REPLACE cuenta WITH Csrplancue.cuenta,nombre WITH Csrplancue.nombre;
		,tipoconce WITH Csrplancue.clasecta, idcuenta WITH CsrPlanCue.id;
		,nombreobjeto WITH Csrplancue.clasecta IN CsrAuxPlanGravado
	ENDPROC

	PROCEDURE KitbuscarProd.f_lostfocussay
		
		LOCAL lok,lnpreunita,lndecimaluni,lndecimaltot,lnuniventa,lObjproducto
		
		IF thisform.editarprecio
			RETURN .t.
		ENDIF 
		
		lndecimaluni = thisform.ndecimaluni
		lndecimaltot = thisform.ndecimaltot
		lnuniventa   = IIF(CsrAuxCuerfac.univenta=0,thisform.unibulto,CsrAuxCuerfac.univenta)
		
		*recuperamos la cuenta contable del producto
		thisform.Cargarctaconproducto(CsrProducto.id)
		lnidcuentavta = CsrAuxCuerfac.idctavta
		lnidcuentacpra = CsrAuxCuerfac.idctacpra
		
		IF lnidcuentavta=0 AND lnidcuentacpra = 0
		   SELECT CsrParaconta
		   LOCATE FOR numero=19
		   lnidcuentavta = Csrparaconta.idcuenta
		   lnidcuentacpra = CsrParaConta.idcuenta
		ENDIF
		
		lnCodprodanterior = thisform.prodanterior &&CsrAuxCuerfac.idarticulo
		
		
		REPLACE idarticulo WITH Csrproducto.id,codigo WITH LTRIM(STR(Csrproducto.numero)),nombre WITH Csrproducto.nombre;
				,univenta WITH lnuniventa,idctavta WITH lnidcuentavta,idctacpra WITH lnidcuentacpra,unibulto WITH Csrproducto.unibulto;
				,alcohol WITH Csrproducto.alcohol,nofactura WITH Csrproducto.nofactura,idenvase WITH Csrproducto.idenvase;
				,kilos WITH Csrproducto.peso,volumen WITH Csrproducto.volumen,vtakilos WITH CsrProducto.vtakilos;
				,pesable WITH Csrproducto.cprakilos,idfrio WITH CsrProducto.idfrio 	IN CsrAuxCuerFac
		
		IF lnCodprodanterior # CsrAuxCuerfac.codigo
			replace bonif1 WITH CsrProducto.bonif1, bonif2 WITH CsrProducto.bonif2,bonif3 WITH CsrProducto.bonif3;
			,bonif4 WITH CsrProducto.bonif4,obonif1 WITH CsrProducto.bonif1, obonif2 WITH CsrProducto.bonif2;
			,obonif3 WITH CsrProducto.bonif3, obonif4 WITH CsrProducto.bonif4 IN CsrAuxCuerfac
		ENDIF 
		
		IF LEN(TRIM(CsrAuxCuerfac.nombre))#0
			IF Csrproducto.id#0
				thisform.traerdatosextra(Csrproducto.id)
			ENDIF 	
			cleartec()
			thisform.lnkeycode = 0    
			lok = .f.
			IF thisform.grid2_controllinea(1)	
				SELECT CsrProducto
				SCATTER NAME lObjproducto
				
				thisform.precioprod1.calculaprecio(lObjproducto,@lObjprecio)
				RELEASE lObjproducto
		
			    REPLACE tasaiva WITH lObjprecio.ivari,precostosiva WITH lobjprecio.costo,interno WITH lObjprecio.interno;
						,precosto WITH lobjprecio.costo IN CsrAuxCuerfac
						
				lnpreunita = lObjprecio.costo + lObjPrecio.interno
			    
				IF lnCodprodanterior # CsrAuxCuerfac.codigo
					IF thisform.incluyeiva
						REPLACE preunita WITH lnpreunita, preorig WITH lnpreunita,preunitasiva WITH lnpreunita IN CsrAuxCuerfac
					ELSE
					    REPLACE preunita WITH lnpreunita, preorig WITH lnpreunita,preunitasiva WITH lnpreunita IN CsrAuxCuerfac
					ENDIF    
		   		ENDIF 	       		    
				  		    
				lok = thisform.grid2_controllinea(2) &&opcion2 siempre devuelve true
				thisform.Grid2.Refresh
			ENDIF     
			IF !lok
				lccodigo =IIF (thisform.Repetircodigo,CsrAuxCuerfac.codigo,'')
				
				REPLACE idarticulo WITH 0,codigo WITH "",nombre WITH "",unibulto WITH 0,precosto WITH 0,precostosiva WITH 0;
				,interno WITH 0,idctavta WITH 0,tasaiva WITH 0,alcohol WITH " ",univenta WITH 0,idenvase WITH 0,kilos WITH 0;
				,volumen WITH 0, preorig WITH 0,bonif1 WITH 0, bonif2 WITH 0,bonif3 WITH 0, bonif4 WITH 0,obonif1 WITH 0;
				,obonif2 WITH 0,obonif3 WITH 0, obonif4 WITH 0,cantreal WITH 0, kilosreal WITH 0 IN CsrAuxCuerfac					
				thisform.grid2.Refresh()
						
				IF (thisform.RepetirCodigo AND LEN(LTRIM(lccodigo))#0) AND !thisform.permitemulticodigo
					&&Sino se permiten multi lineas por codigo, nos posicionamos en el codigo para que edite.
					SELECT CsrAuxCuerfac
					LOCATE FOR codigo=lccodigo
					llson = beepFP(1)
				ENDIF 
					
				thisform.grid2.column1.text1.SetFocus()
			ENDIF		
		ENDIF 		
		
	ENDPROC

ENDDEFINE
