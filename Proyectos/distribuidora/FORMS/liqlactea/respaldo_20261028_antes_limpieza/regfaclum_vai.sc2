	PROCEDURE ContenedorRegistro.Grid1.Column1.Text1.GotFocus
		WITH thisform
		    .prodanterior=this.Value
			.lblayudapie.Caption = "[Esc]Retrocede a Proveedor   [ + ]Graba" 	 
			.ultimocontainer     ="THISFORM.GRID1" 
			.lpidocodigoCta	 	 = .f.
			.cmdSalvar.Visible   = .t.
